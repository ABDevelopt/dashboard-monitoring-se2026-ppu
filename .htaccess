# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/bpsppuco/monitoring.bpsppu.com"
PassengerBaseURI "/"
PassengerNodejs "/home/bpsppuco/nodevenv/monitoring.bpsppu.com/24/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# ─────────────────────────────────────────────────────────────
#  LiteSpeed & cPanel Proxy Optimization for Node.js Streaming
# ─────────────────────────────────────────────────────────────
<IfModule Litespeed>
  # Mencegah pemutusan koneksi saat script/AI stream berjalan
  RewriteEngine On
  RewriteRule .* - [E=noabort:1,E=noconntimeout:1,E=dont-vary:1]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pastikan header Authorization & CSRF diteruskan ke Node.js
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Pastikan proxy buffer dimatikan untuk SSE stream
<IfModule mod_headers.c>
  Header set X-Accel-Buffering "no"
</IfModule>
