<script>
  // Immediate restore of sidebar scroll position on initial HTML parse to prevent jump/flicker
  (function() {
    try {
      var saved = sessionStorage.getItem('sidebar_nav_scroll_top');
      if (saved) {
        var sNav = document.querySelector('.sidebar-nav');
        if (sNav) sNav.scrollTop = parseInt(saved, 10);
      }
    } catch (_) {}
  })();
</script>
<script>
  window.toggleUploadSubMenu = function(e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    const wrapper = document.getElementById('uploadNavSubWrapper');
    const content = document.getElementById('uploadSubContent');
    const chevron = document.getElementById('uploadSubChevron');
    if (!wrapper || !content) return;
    
    const isCollapsed = content.style.display === 'none' || wrapper.classList.contains('is-collapsed');
    if (isCollapsed) {
      wrapper.classList.remove('is-collapsed');
      wrapper.classList.add('is-open');
      content.style.display = 'block';
      if (chevron) chevron.style.transform = 'rotate(0deg)';
    } else {
      wrapper.classList.add('is-collapsed');
      wrapper.classList.remove('is-open');
      content.style.display = 'none';
      if (chevron) chevron.style.transform = 'rotate(-90deg)';
    }
  };
</script>

