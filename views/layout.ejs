              <span class="fw-bold">${totalUsaha.toLocaleString('id-ID')} / ${totalMuatan.toLocaleString('id-ID')} (${donePct}%)</span>
            </div>
            <div class="progress-bar-target-wrap" style="position: relative; height: 6px; margin-top: 16px; margin-bottom: 8px;">
              <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                <div class="progress-bar ${parseFloat(donePct) >= 100 ? 'green' : (parseFloat(donePct) < activeTargetPct ? 'red' : 'blue')}" style="width: ${donePct}%; height: 100%; border-radius: 99px;"></div>
              </div>
              <!-- Marker 25% (Juni) -->
              <div style="position: absolute; left: 25%; top: -3px; height: 12px; border-left: 1px dashed ${activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)'}; opacity: ${activeTargetPct === 25 ? '1' : '0.5'}; z-index: 2; pointer-events: none;">
                <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: ${activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)'}; white-space: nowrap;">Jun: 25%</span>
              </div>
              <!-- Marker 50% (Juli) -->
              <div style="position: absolute; left: 50%; top: -3px; height: 12px; border-left: 1px dashed ${activeTargetPct === 50 ? 'var(--accent-cyan)' : 'var(--text-muted)'}; opacity: ${activeTargetPct === 50 ? '1' : '0.5'}; z-index: 2; pointer-events: none;">
                <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: ${activeTargetPct === 50 ? 'var(--accent-cyan)' : 'var(--text-muted)'}; white-space: nowrap;">Jul: 50%</span>
              </div>
            </div>
          </div>
          ` : ''}

          <!-- Progress FASIH -->
          <div style="margin-bottom: 12px; text-align: left;">
            <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 4px; color: var(--text-secondary);">
              <span><i class="bi bi-phone"></i> Progres FASIH (Submit + Approve + Reject)</span>
              <span class="fw-bold">${totalFasihAll.toLocaleString('id-ID')} / ${totalFasihTarget.toLocaleString('id-ID')} (${fasihPct}%)</span>
            </div>
            <div class="progress-bar-wrap" style="height: 6px;">
              <div class="progress-bar ${parseFloat(fasihPct) >= 100 ? 'green' : (parseFloat(fasihPct) < 25 ? 'red' : 'purple')}" style="width: ${fasihPct}%;"></div>
            </div>
          </div>

          <!-- Mini Grid Status FASIH -->
          <div class="status-mini-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 14px; text-align: center;">
            <div class="fasih-grid-item fasih-item-draft">
              <div class="fasih-grid-item-label">Draft</div>
              <div class="fasih-grid-item-value">${totalDraft}</div>
            </div>
            <div class="fasih-grid-item fasih-item-submit">
              <div class="fasih-grid-item-label">Submit</div>
              <div class="fasih-grid-item-value">${totalSubmit}</div>
            </div>
            <div class="fasih-grid-item fasih-item-approve">
              <div class="fasih-grid-item-label">Approve</div>
              <div class="fasih-grid-item-value">${totalApprove}</div>
            </div>
            <div class="fasih-grid-item fasih-item-reject">
              <div class="fasih-grid-item-label">Reject</div>
              <div class="fasih-grid-item-value">${totalReject}</div>
            </div>
          </div>

          <!-- Analisis Kecepatan & Estimasi Pendataan -->
          <div style="margin-top: 18px; padding: 14px; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; text-align: left;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-cyan); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
              <i class="bi bi-speedometer2" style="font-size: 14px;"></i> Analisis Kecepatan & Sisa Waktu
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
              <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 8px; text-align: center;">
                <div style="font-size: 10px; color: var(--text-muted); font-weight: 500;">Kecepatan Saat Ini</div>
                <div style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-top: 2px;">${currentSpeedText} <span style="font-size: 10px; font-weight: 500; color: var(--text-muted);">dok/hari</span></div>
              </div>
              <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 8px; text-align: center;">
                <div style="font-size: 10px; color: var(--text-muted); font-weight: 500;">Status Target</div>
                <div style="font-size: 12px; font-weight: 700; margin-top: 4px;">
                  ${remainingFasih === 0 ? `
                    <span class="badge badge-green" style="font-size: 10px; padding: 3px 8px;">Selesai 100%</span>
                  ` : isOfftrack ? `
                    <span class="badge badge-red" style="font-size: 10px; padding: 3px 8px;"><i class="bi bi-exclamation-triangle-fill"></i> Off-Track</span>
                  ` : `
                    <span class="badge badge-blue" style="font-size: 10px; padding: 3px 8px;"><i class="bi bi-check-circle-fill"></i> On-Track</span>
                  `}
                </div>
              </div>
            </div>
            
            <div style="font-size: 11px; line-height: 1.5; color: var(--text-secondary);">
              ${remainingFasih === 0 ? `
                Petugas <strong>${name}</strong> telah menyelesaikan seluruh target pengisian dokumen FASIH sebanyak <strong>${totalFasihTarget}</strong> dokumen. Kinerja luar biasa!
              ` : `
                Hari berjalan pendataan: <strong>${diffDays} hari</strong> (sejak 15 Juni). Sisa hari menuju deadline (31 Agustus): <strong>${daysRemaining} hari</strong>.<br>
                Sisa beban kerja: <strong>${remainingFasih} dokumen</strong>. 
                Dengan kecepatan saat ini (<strong>${currentSpeedText} dok/hari</strong>), 
                ${currentSpeed === 0 ? `
                  petugas belum merealisasikan dokumen FASIH sama sekali sehingga estimasi hari selesai tidak dapat diprediksi.
                ` : `
                  petugas diprediksi akan menyelesaikan sisa dokumen dalam waktu sekitar <strong>${Math.ceil(estDaysToFinish)} hari</strong>.
                `}
                
                ${isOfftrack ? `
                  <div style="margin-top: 8px; padding: 8px; background: rgba(239, 68, 68, 0.08); border-left: 3px solid var(--accent-red); border-radius: 4px; color: var(--text-primary); display: flex; align-items: flex-start; gap: 6px;">
                    <i class="bi bi-exclamation-triangle-fill" style="color: var(--accent-red); font-size: 13px; margin-top: 1px;"></i>
                    <div><strong>Off-Track:</strong> Petugas diprediksi terlambat/tidak selesai tepat waktu. Diperlukan peningkatan kecepatan kerja minimal menjadi <strong>${reqSpeed.toFixed(2)} dok/hari</strong> agar selesai sesuai target pada 31 Agustus 2026.</div>
                  </div>
                ` : `
                  <div style="margin-top: 8px; padding: 8px; background: rgba(34, 197, 94, 0.08); border-left: 3px solid var(--accent-green); border-radius: 4px; color: var(--text-primary); display: flex; align-items: flex-start; gap: 6px;">
                    <i class="bi bi-check-circle-fill" style="color: var(--accent-green); font-size: 13px; margin-top: 1px;"></i>
                    <div><strong>On-Track:</strong> Kecepatan petugas sudah memadai untuk menyelesaikan seluruh beban kerja sebelum deadline (estimasi selesai sebelum 31 Agustus 2026).</div>
                  </div>
                `}
              `}
            </div>
          </div>
        </div>

        <!-- Search box for SLS -->
        <div class="search-wrap mb-4" style="max-width: 100%; margin-bottom: 12px; margin-top: 16px;">
          <input type="search" id="modalSubslsSearch" placeholder="Cari nama SLS/kode..." aria-label="Cari nama SLS atau kode wilayah">
        </div>

        <!-- List of SLS -->
        <div id="modalSubslsList" style="max-height: 250px; overflow-y: auto; padding-right: 4px; text-align: left;">
          ${rows.map(s => `
            <div class="detail-item" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 5px 8px; margin-bottom: 4px; font-size: 11px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                <div style="font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 80%;">
                  <span class="td-code" style="font-size: 9px; padding: 1px 3px; font-weight: normal; margin-right: 4px;">${s.kode}</span>
                  ${s.nama_sls}
                </div>
                ${s.sudah_diisi ? `
                  <span class="badge badge-green btn-xs" style="font-size: 8px; padding: 1px 4px;">Selesai</span>
                ` : `
                  <span class="badge badge-red btn-xs" style="font-size: 8px; padding: 1px 4px;">Belum</span>
                `}
              </div>
              
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: var(--text-muted); flex-wrap: wrap; gap: 4px;">
                <div>${s.desa}</div>
                <div style="display: flex; gap: 6px; align-items: center;">
                  ${showMuatan ? `
                  <span class="muatan-col" style="color: var(--accent-cyan);">
                    Muatan: <strong>${s.usaha_total}</strong>/${s.muatan}
                  </span>
                  ` : ''}
                  <span style="color: var(--accent-purple);">
                    FASIH: <strong>${(s.submitted_by_pcl || 0) + (s.approved || 0) + (s.rejected || 0)}</strong>/${s.target_fasih} 
                    <span style="font-size: 9px; color: var(--text-muted);">(D${s.draft} S${s.submitted_by_pcl} A${s.approved} R${s.rejected})</span>
                  </span>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      `;

      // Set timeout to initialize search filtering on modal list load
      setTimeout(() => {
        if (typeof makeListSearchable === 'function') {
          makeListSearchable('modalSubslsSearch', 'modalSubslsList', '.detail-item');
        }
      }, 50);

      return html;
    };

    // Intercept click on PML/PCL/Korlap links — works inside expanded table or any table on page
    function openDetailModal(type, name) {
      const modal = document.getElementById('globalDetailModal');
      const modalTitle = document.getElementById('globalDetailModalTitle');
      const modalSubtitle = document.getElementById('globalDetailModalSubtitle');
      const modalBody = document.getElementById('globalDetailModalBody');

      const typeLabel = type === 'korlap' ? 'Korlap' : type === 'pml' ? 'PML' : 'PCL';
      modalTitle.innerHTML = `<i class="bi bi-person-bounding-box"></i> Rincian Tugas SLS: <mark class="highlight-name">${name}</mark>`;
      if (modalSubtitle) modalSubtitle.textContent = 'Memuat data...';
      modalBody.innerHTML = `
        <div style="display:flex; justify-content:center; align-items:center; padding:40px; gap:12px; color:var(--text-muted);">
          <div style="border:3px solid var(--border); border-top:3px solid var(--accent-blue); border-radius:50%; width:24px; height:24px; animation:gdm-spin 0.8s linear infinite;"></div>
          <span>Memuat rincian data...</span>
        </div>
        <style>@keyframes gdm-spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}</style>
      `;
      modal.style.display = 'flex';

      fetch(`/api/detail/${type}?name=${encodeURIComponent(name)}`)
        .then(res => res.json())
        .then(data => {
          if (data.error) {
            modalBody.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
            return;
          }
          if (data.length === 0) {
            modalBody.innerHTML = `<div style="padding:40px; text-align:center; color:var(--text-muted);"><i class="bi bi-inbox" style="font-size:32px;"></i><br><br>Tidak ada data yang ditemukan untuk <strong>${name}</strong>.</div>`;
            return;
          }
          if (type === 'korlap') {
            modalBody.innerHTML = renderKorlapDetails(data, name);
          } else if (type === 'pml') {
            modalBody.innerHTML = renderPmlDetails(data, name);
          } else if (type === 'pcl') {
            modalBody.innerHTML = renderPclDetails(data, name);
          }
          if (window.initTableExport) {
            window.initTableExport(modalBody);
          }
        })
        .catch(err => {
          console.error(err);
          modalBody.innerHTML = `<div class="alert alert-error">Gagal memuat data: ${err.message}</div>`;
        });
    }

    document.addEventListener('click', (e) => {
      const a = e.target.closest('a');
      if (!a) return;

      // Works inside expanded table cards
      const card = a.closest('.card.card-expanded');
      if (!card) return;

      const href = a.getAttribute('href');
      if (!href) return;

      let type = '';
      let name = '';

      // Use URL parsing for robust multi-param extraction
      try {
        const url = new URL(href, window.location.origin);
        const path = url.pathname;
        if (path === '/korlap' && url.searchParams.has('korlap')) {
          type = 'korlap';
          name = url.searchParams.get('korlap');
        } else if (path === '/pml' && url.searchParams.has('pml')) {
          type = 'pml';
          name = url.searchParams.get('pml');
        } else if (path === '/pcl' && url.searchParams.has('pcl')) {
          type = 'pcl';
          name = url.searchParams.get('pcl');
        }
      } catch (_) {
        // Fallback: ignore malformed URLs
      }

      if (type && name) {
        e.preventDefault();
        openDetailModal(type, name);
      }
    });

    // Close Modal Events
    const detailModal = document.getElementById('globalDetailModal');
    const closeDetailModalBtn = document.getElementById('btnCloseGlobalDetailModal');
    if (detailModal && closeDetailModalBtn) {
      const closeDetailModal = () => {
        detailModal.style.display = 'none';
      };
      closeDetailModalBtn.addEventListener('click', closeDetailModal);
      detailModal.addEventListener('click', (e) => {
        if (e.target === detailModal) closeDetailModal();
      });
    }

    // Close expanded table on ESC key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const modal = document.getElementById('globalDetailModal');
        if (modal && modal.style.display === 'flex') {
          modal.style.display = 'none';
          e.stopPropagation();
          e.preventDefault();
          return;
        }

        const expandedCard = document.querySelector('.card.card-expanded');
        if (expandedCard) {
          const btn = expandedCard.querySelector('.btn-expand-table');
          if (btn) {
            toggleCardExpand(expandedCard, btn);
          }
        }
      }
    }, true);

    window.shareElementAsImage = async (elementId, event) => {
      const element = document.getElementById(elementId);
      if (!element) return;

      const btn = event ? event.currentTarget : null;
      const originalHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 10px; height: 10px; border-width: 1.5px; margin-right: 4px;"></span>...';
      }

      Swal.fire({
        title: 'Menyiapkan Gambar...',
        text: 'Sedang merender data tugas SLS untuk dibagikan.',
        allowOutsideClick: false,
        showConfirmButton: false,
        didOpen: () => {
          Swal.showLoading();
        }
      });

      try {
        await loadScript('https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js');
        const canvas = await html2canvas(element, {
          backgroundColor: window.getComputedStyle(document.body).getPropertyValue('--bg-card') || '#ffffff',
          scale: 1.3,
          useCORS: true,
          logging: false,
          allowTaint: true,
          removeContainer: true,
          onclone: (clonedDoc) => {
            const clonedEl = clonedDoc.getElementById(elementId);
            if (clonedEl) {
              const elementsToHide = clonedEl.querySelectorAll(
                '.table-export-buttons, .btn-secondary, .btn-expand-table, .search-wrap, input, button, .btn'
              );
              elementsToHide.forEach(el => el.style.display = 'none');

              const scrollContainers = clonedEl.querySelectorAll(
                '#detailSubslsList, #detailPclList, #detailPmlList'
              );
              scrollContainers.forEach(container => {
                container.style.maxHeight = 'none';
                container.style.overflowY = 'visible';
                container.style.overflow = 'visible';
                container.style.height = 'auto';
              });
            }
          }
        });

        canvas.toBlob(async (blob) => {
          if (!blob) {
            throw new Error('Gagal membuat blob gambar.');
          }

          const file = new File([blob], `${elementId}.jpg`, { type: 'image/jpeg' });

          const resetBtn = (status, btnClass) => {
            if (btn) {
              btn.innerHTML = status;
              btn.classList.remove('btn-secondary');
              btn.classList.add(btnClass);
              setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.classList.remove(btnClass);
                btn.classList.add('btn-secondary');
                btn.disabled = false;
              }, 2000);
            }
          };

          try {
            if (navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
              await navigator.share({
                files: [file],
                title: 'Kinerja Petugas SE2026 PPU',
                text: 'Berikut laporan progres kinerja petugas SE2026 PPU.'
              });
              Swal.close();
              resetBtn('<i class="bi bi-share"></i> Bagikan!', 'btn-success');
            } else {
              const link = document.createElement('a');
              link.download = `${elementId}.jpg`;
              link.href = canvas.toDataURL('image/jpeg', 0.85);
              link.click();
              Swal.fire({
                icon: 'success',
                title: 'Berhasil!',
                text: 'Gambar rincian tugas berhasil diunduh.',
                timer: 1500,
                showConfirmButton: false
              });
              resetBtn('<i class="bi bi-download"></i> Unduh!', 'btn-warning');
            }
          } catch (err) {
            console.error('Share failed, downloading instead:', err);
            const link = document.createElement('a');
            link.download = `${elementId}.jpg`;
            link.href = canvas.toDataURL('image/jpeg', 0.85);
            link.click();
            Swal.fire({
              icon: 'success',
              title: 'Berhasil!',
              text: 'Gambar rincian tugas berhasil diunduh.',
              timer: 1500,
              showConfirmButton: false
            });
            resetBtn('<i class="bi bi-download"></i> Unduh!', 'btn-warning');
          }
        }, 'image/jpeg', 0.85);
      } catch (error) {
        console.error('Error sharing element as image:', error);
        Swal.fire({
          icon: 'error',
          title: 'Gagal!',
          text: 'Terjadi kesalahan saat menyiapkan gambar.',
          confirmButtonText: 'Tutup'
        });
        if (btn) {
          btn.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Gagal';
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-danger');
          setTimeout(() => {
            btn.innerHTML = originalHtml;
            btn.classList.remove('btn-danger');
            btn.classList.add('btn-secondary');
            btn.disabled = false;
          }, 2000);
        }
      }
    };

    window.copyElementAsImage = async (elementId, event) => {
      const element = document.getElementById(elementId);
      if (!element) return;

      const btn = event ? event.currentTarget : null;
      const originalHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 10px; height: 10px; border-width: 1.5px; margin-right: 4px;"></span>...';
      }

      Swal.fire({
        title: 'Menyiapkan Gambar...',
        text: 'Sedang merender data tugas SLS untuk disalin.',
        allowOutsideClick: false,
        showConfirmButton: false,
        didOpen: () => {
          Swal.showLoading();
        }
      });

      try {
        await loadScript('https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js');
        const canvas = await html2canvas(element, {
          backgroundColor: window.getComputedStyle(document.body).getPropertyValue('--bg-card') || '#ffffff',
          scale: 1.3,
          useCORS: true,
          logging: false,
          allowTaint: true,
          removeContainer: true,
          onclone: (clonedDoc) => {
            const clonedEl = clonedDoc.getElementById(elementId);
            if (clonedEl) {
              const elementsToHide = clonedEl.querySelectorAll(
                '.table-export-buttons, .btn-secondary, .btn-expand-table, .search-wrap, input, button, .btn'
              );
              elementsToHide.forEach(el => el.style.display = 'none');

              const scrollContainers = clonedEl.querySelectorAll(
                '#detailSubslsList, #detailPclList, #detailPmlList'
              );
              scrollContainers.forEach(container => {
                container.style.maxHeight = 'none';
                container.style.overflowY = 'visible';
                container.style.overflow = 'visible';
                container.style.height = 'auto';
              });
            }
          }
        });

        canvas.toBlob(async (blob) => {
          if (!blob) {
            throw new Error('Gagal membuat blob gambar.');
          }

          const resetBtn = (status, btnClass) => {
            if (btn) {
              btn.innerHTML = status;
              btn.classList.remove('btn-secondary');
              btn.classList.add(btnClass);
              setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.classList.remove(btnClass);
                btn.classList.add('btn-secondary');
                btn.disabled = false;
              }, 2000);
            }
          };

          try {
            const item = new ClipboardItem({ 'image/png': blob });
            await navigator.clipboard.write([item]);
            Swal.fire({
              icon: 'success',
              title: 'Tersalin!',
              text: 'Gambar rincian tugas disalin ke clipboard.',
              timer: 1500,
              showConfirmButton: false
            });
            resetBtn('<i class="bi bi-check-lg"></i> Disalin!', 'btn-success');
          } catch (err) {
            console.error('Clipboard copy failed, downloading instead:', err);
            const link = document.createElement('a');
            link.download = `${elementId}.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
            Swal.fire({
              icon: 'success',
              title: 'Berhasil!',
              text: 'Gambar rincian tugas berhasil diunduh.',
              timer: 1500,
              showConfirmButton: false
            });
            resetBtn('<i class="bi bi-download"></i> Unduh!', 'btn-warning');
          }
        }, 'image/png');
      } catch (error) {
        console.error('Error copying element as image:', error);
        Swal.fire({
          icon: 'error',
          title: 'Gagal!',
          text: 'Terjadi kesalahan saat menyalin gambar.',
          confirmButtonText: 'Tutup'
        });
        if (btn) {
          btn.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Gagal';
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-danger');
          setTimeout(() => {
            btn.innerHTML = originalHtml;
            btn.classList.remove('btn-danger');
            btn.classList.add('btn-secondary');
            btn.disabled = false;
          }, 2000);
        }
      }
    };

    // PJAX router for seamless AJAX page transitions without reloading the sidebar
    async function loadPage(url, pushState = true) {
      const loader = document.getElementById('topLoadingBar');
      if (loader) {
        loader.classList.remove('finished');
        loader.classList.remove('loading');
        void loader.offsetWidth;
        loader.classList.add('loading');
      }
      const overlay = document.getElementById('pjax-loading-overlay');
      if (overlay) overlay.classList.add('active');

      try {
        const response = await fetch(url);
        if (!response.ok) {
          window.location.href = url;
          return;
        }

        const htmlText = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(htmlText, 'text/html');

        // Swap body container
        const newContent = doc.getElementById('pjax-container');
        const oldContent = document.getElementById('pjax-container');
        if (newContent && oldContent) {
          // Clean up page-specific popstate event listeners before swapping content
          if (window._pjaxCleanups && window._pjaxCleanups.length) {
            window._pjaxCleanups.forEach(item => {
              window.removeEventListener(item.type, item.listener, item.options);
            });
            window._pjaxCleanups = [];
          }

          oldContent.innerHTML = newContent.innerHTML;
        } else {
          // Fallback if pjax container structure is missing in the target page
          window.location.href = url;
          return;
        }

        // Update document title
        document.title = doc.title || document.title;

        // Update Topbar Title
        const newTopbarTitle = doc.querySelector('.topbar-title');
        const oldTopbarTitle = document.querySelector('.topbar-title');
        if (newTopbarTitle && oldTopbarTitle) {
          oldTopbarTitle.innerHTML = newTopbarTitle.innerHTML;
        }

        // Update Topbar Subtitle
        const newTopbarSubtitle = doc.querySelector('.topbar-subtitle');
        const oldTopbarSubtitle = document.querySelector('.topbar-subtitle');
        if (newTopbarSubtitle && oldTopbarSubtitle) {
          oldTopbarSubtitle.innerHTML = newTopbarSubtitle.innerHTML;
        }

        // Update Topbar Actions (e.g. Upload Data button visibility)
        const newTopbarActions = doc.querySelector('.topbar-actions');
        const oldTopbarActions = document.querySelector('.topbar-actions');
        if (newTopbarActions && oldTopbarActions) {
          oldTopbarActions.innerHTML = newTopbarActions.innerHTML;
        }

        // Update Sidebar/Bottomnav Active Classes
        const targetPath = new URL(url, window.location.origin).pathname;
        
        // Sidebar items
        document.querySelectorAll('.sidebar .nav-item').forEach(item => {
          const itemHref = item.getAttribute('href');
          if (itemHref) {
            const itemPath = new URL(itemHref, window.location.origin).pathname;
            if (itemPath === targetPath || (targetPath === '/' && itemPath === '/')) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          }
        });

        // Bottom nav items
        document.querySelectorAll('.bottom-nav .bottom-nav-item').forEach(item => {
          const itemHref = item.getAttribute('href');
          if (itemHref) {
            const itemPath = new URL(itemHref, window.location.origin).pathname;
            if (itemPath === targetPath || (targetPath === '/' && itemPath === '/')) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          }
        });

        // Update browser URL
        if (pushState) {
          history.pushState({ url }, '', url);
        }

        // Close sidebar drawer overlay on mobile after clicking
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        if (sidebar && sidebar.classList.contains('active')) {
          sidebar.classList.remove('active');
          if (overlay) overlay.classList.remove('active');
        }

        // Execute script elements inside the new content sequentially
        if (oldContent) {
          const scripts = Array.from(oldContent.querySelectorAll('script'));
          
          // Temporary proxy for document.addEventListener during PJAX script execution
          const originalDocAddEventListener = document.addEventListener;
          document.addEventListener = function(type, listener, options) {
            if (type === 'DOMContentLoaded') {
              try {
                listener();
              } catch (err) {
                console.error('Error executing DOMContentLoaded listener immediately:', err);
              }
              return;
            }
            return originalDocAddEventListener.call(this, type, listener, options);
          };

          async function executeScriptsSequentially(index) {
            if (index >= scripts.length) return;
            const script = scripts[index];
            const newScript = document.createElement('script');
            
            // Copy attributes
            for (let attr of script.attributes) {
              newScript.setAttribute(attr.name, attr.value);
            }
            newScript.textContent = script.textContent;

            const promise = new Promise((resolve) => {
              if (newScript.src) {
                newScript.onload = () => resolve();
                newScript.onerror = () => resolve(); // continue on error
              } else {
                resolve();
              }
            });

            script.parentNode.insertBefore(newScript, script.nextSibling);
            script.remove();

            await promise;
            await executeScriptsSequentially(index + 1);
          }

          try {
            await executeScriptsSequentially(0);
          } finally {
            // Always restore original addEventListener
            document.addEventListener = originalDocAddEventListener;
          }
        }

        // Complete loading bar progress
        if (loader) {
          loader.classList.remove('loading');
          loader.classList.add('finished');
        }

      } catch (err) {
        console.error('AJAX page navigation error:', err);
        window.location.href = url;
      } finally {
        const overlay = document.getElementById('pjax-loading-overlay');
        if (overlay) {
          overlay.classList.remove('active');
        }
      }
    }

    // Intercept clicks on internal links
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented) return;
      const a = e.target.closest('a');
      if (!a) return;

      const href = a.getAttribute('href');
      // Skip hashes, JS calls, blank target, external targets
      if (!href || href.startsWith('#') || href.startsWith('javascript:') || a.getAttribute('target') === '_blank') {
        return;
      }
      
      // Ignore click handlers that open modals or are custom triggers
      if (a.getAttribute('onclick') || a.dataset.bsToggle || a.dataset.toggle) {
        return;
      }

      // Check if it is an internal page
      const isInternal = href.startsWith('/') || href.startsWith(window.location.origin);
      if (!isInternal) return;

      e.preventDefault();
      loadPage(href);
    });

    // Handle browser back/forward buttons
    window.addEventListener('popstate', (e) => {
      const url = (e.state && e.state.url) ? e.state.url : window.location.pathname + window.location.search;
      loadPage(url, false);
    });
  });
</script>
<%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
