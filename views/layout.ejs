<%
  var navPrefix = (typeof locals !== 'undefined' && typeof locals.navPrefix !== 'undefined') ? locals.navPrefix : (typeof navPrefix !== 'undefined' ? navPrefix : '');
  var routePrefix = (typeof locals !== 'undefined' && typeof locals.routePrefix !== 'undefined') ? locals.routePrefix : (typeof routePrefix !== 'undefined' ? routePrefix : '');
  var activeSurvey = (typeof locals !== 'undefined' && typeof locals.activeSurvey !== 'undefined') ? locals.activeSurvey : (typeof activeSurvey !== 'undefined' ? activeSurvey : 'se2026');
  var surveyConfig = (typeof locals !== 'undefined' && typeof locals.surveyConfig !== 'undefined') ? locals.surveyConfig : (typeof surveyConfig !== 'undefined' ? surveyConfig : { id: 'se2026', name: 'Sensus Ekonomi 2026', shortName: 'SE2026 PPU', theme: 'orange', themeColor: '#f97316', showUsahaColumns: true });

  var surveyLogoSrc = '/images/logo-pananyo-taka-flow.svg';
  if (activeSurvey === 'sakernas-pemutakhiran') {
    surveyLogoSrc = '/images/logo-sakernas-pemutakhiran.svg';
  } else if (activeSurvey === 'sakernas-pendataan') {
    surveyLogoSrc = '/images/logo-sakernas-pendataan.svg';
  } else if (activeSurvey && activeSurvey.startsWith('sakernas')) {
    surveyLogoSrc = '/images/logo-sakernas-mark.svg';
  }
%>
