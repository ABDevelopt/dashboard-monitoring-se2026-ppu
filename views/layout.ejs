            <div class="topbar-dropdown-section-label"><i class="bi bi-box-seam" style="color:var(--accent-cyan)"></i> Target Muatan</div>
            <select id="publicTargetMuatanMode" class="topbar-select" aria-label="Mode Target Muatan">
