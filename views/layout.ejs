      // Calculations for Speed Analysis
      const remainingFasih = Math.max(0, totalFasihTarget - totalFasihAll);
      const currentSpeed = diffDays > 0 ? (totalFasihAll / diffDays) : 0;
      const currentSpeedText = currentSpeed.toFixed(2);
      const estDaysToFinish = currentSpeed > 0 ? (remainingFasih / currentSpeed) : null;
      const isOfftrack = (currentSpeed === 0 && remainingFasih > 0) || (estDaysToFinish !== null && estDaysToFinish > daysRemaining);
      const reqSpeed = daysRemaining > 0 ? (remainingFasih / daysRemaining) : remainingFasih;

      const donePct = totalMuatan ? ((totalUsaha / totalMuatan) * 100).toFixed(2) : '0.00';
      const fasihPct = totalFasihTarget ? ((totalFasihAll / totalFasihTarget) * 100).toFixed(2) : '0.00';

      const showMuatan = typeof globalSettings !== 'undefined' && globalSettings.show_progres_muatan !== '0';

      let html = `
        <div class="mb-4">
