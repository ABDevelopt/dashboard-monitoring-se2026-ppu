        btnXlsx.className = 'btn btn-secondary btn-xs';
        btnXlsx.type = 'button';
        btnXlsx.style.padding = '3px 8px';
        btnXlsx.style.fontSize = '11px';
        btnXlsx.innerHTML = '<i class="bi bi-file-earmark-excel"></i><span class="btn-text-desktop"> XLSX</span>';
        btnXlsx.onclick = (e) => {
          e.preventDefault();
          window.exportTableToXLSX(table.id, title);
        };

        const btnPdf = document.createElement('button');
        btnPdf.className = 'btn btn-secondary btn-xs';
        btnPdf.type = 'button';
        btnPdf.style.padding = '3px 8px';
