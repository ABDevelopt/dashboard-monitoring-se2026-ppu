<%
  let activeTargetPct = 25;
  let targetMonthName = '30 Juni';
  const currentDate = typeof latestUpload !== 'undefined' && latestUpload ? new Date(latestUpload.tanggal) : new Date();
  if (currentDate >= new Date('2026-07-01')) {
    activeTargetPct = 40;
    targetMonthName = '15 Juli';
  }
%>
<div class="fade-in">
  <% if (!uploadId) { %>
    <div class="card empty-state">
      <div class="empty-state-icon"><i class="bi bi-diagram-3"></i></div>
      <div class="empty-state-title">Belum Ada Data Korlap</div>
      <div class="empty-state-text">Upload file Excel untuk mulai memantau struktur koordinasi lapangan dan kinerja tim Koordinator Lapangan.</div>
      <a href="<%= navPrefix %>/admin/upload" class="empty-state-action"><i class="bi bi-cloud-arrow-up-fill"></i> Upload Data Sekarang</a>
    </div>
  <% } else { %>
    <!-- PETUGAS NAVIGATION TABS -->
    <div class="petugas-tabs-wrapper">
      <a href="<%= navPrefix %>/pcl" class="petugas-tab-item <%= activePage === 'pcl' ? 'active' : '' %>">
        <i class="bi bi-person-gear"></i>
        <span><%= (typeof isSakernas !== 'undefined' && isSakernas) ? 'PPL' : 'PCL' %></span>
      </a>
      <a href="<%= navPrefix %>/pml" class="petugas-tab-item <%= activePage === 'pml' ? 'active' : '' %>">
        <i class="bi bi-clipboard2-data"></i>
        <span>PML</span>
      </a>
      <% if (typeof settings === 'undefined' || settings.page_korlap !== '0') { %>
      <a href="<%= navPrefix %>/korlap" class="petugas-tab-item <%= activePage === 'korlap' ? 'active' : '' %>">
        <i class="bi bi-person-workspace"></i>
        <span>Korlap</span>
      </a>
      <% } %>
      <% if (typeof settings === 'undefined' || settings.page_performa !== '0') { %>
      <a href="<%= navPrefix %>/performa" class="petugas-tab-item <%= activePage === 'performa' ? 'active' : '' %>">
        <i class="bi bi-speedometer2"></i>
        <span>Performa</span>
      </a>
      <% } %>
      <% if (typeof settings === 'undefined' || settings.page_leaderboard !== '0') { %>
      <a href="<%= navPrefix %>/leaderboard" class="petugas-tab-item <%= activePage === 'leaderboard' ? 'active' : '' %>">
        <i class="bi bi-trophy"></i>
        <span>Leaderboard</span>
      </a>
      <% } %>
    </div>

    <!-- TWO-COLUMN GRID FOR DRILLDOWN -->
    <div class="drilldown-grid <%= filterKorlap ? 'has-selection' : 'no-selection' %> mt-2">
      
      <!-- KORLAP LIST TABLE -->
      <div class="card" style="margin-bottom: 0;">
        <div class="card-header flex-between" style="gap: 8px;">
          <div class="card-title" style="margin-bottom: 0;"><i class="bi bi-person-workspace"></i> Progres Kinerja per Korlap (Koordinator Lapangan) <span class="badge badge-blue"><%= korlapStats.length %> Korlap</span></div>
          <div class="card-actions flex-start" style="gap: 6px;"></div>
        </div>

        <div class="search-wrap mb-4">
          <input type="search" id="korlapSearch" placeholder="Cari nama Korlap..." aria-label="Cari nama Koordinator Lapangan Korlap" style="width: 100%; max-width: 280px;">
        </div>

        <% if (korlapStats && korlapStats.length > 0) { %>
          <div class="table-wrap" style="max-height: 600px; overflow-y: auto; overflow-x: auto;">
            <table id="korlapTable">
              <thead class="hide-sm">
                <tr>
                  <th rowspan="2" class="text-center" style="font-weight: 600; width: 40px;">No</th>
                  <th rowspan="2">Nama Korlap</th>
                  <th rowspan="2" class="text-right bg-purple-soft" style="min-width: 140px;">FASIH %</th>
                  <th rowspan="2" class="text-right bg-cyan-soft muatan-col" style="min-width: 140px;">Muatan %</th>
                  <th rowspan="2" class="text-right">Jumlah PML</th>
                  <th rowspan="2" class="text-right">Jumlah PCL</th>
                  <!-- <th colspan="2" class="text-center" style="border-bottom: 1px solid var(--border);">SubSLS</th> -->
                  <th colspan="6" class="text-center bg-purple-soft" style="border-bottom: 1px solid var(--border);">Assignment FASIH</th>
                  <th colspan="2" class="text-center bg-cyan-soft muatan-col" style="border-bottom: 1px solid var(--border);">Beban Muatan</th>
                </tr>
                <tr>
                  <th class="text-right bg-gray-soft status-open-text">Open</th>
                  <th class="text-right bg-yellow-soft">Draft</th>
                  <th class="text-right bg-blue-soft">Submitted</th>
                  <th class="text-right bg-red-soft">Rejected</th>
                  <th class="text-right bg-green-soft">Approved</th>
                  <th class="text-right bg-purple-soft"><%= settings.target_fasih_mode === 'fasih-sm' ? 'Tgt FASIH-SM' : 'Tgt Statis' %></th>
                  <th class="text-right bg-cyan-soft muatan-col">Usaha Total</th>
                  <th class="text-right bg-cyan-soft muatan-col">Target Muatan</th>
                </tr>
              </thead>
              <thead class="show-sm-table-header">
                <tr>
                  <th class="text-center" style="width: 40px;">No</th>
                  <th>Nama Korlap</th>
                  <!-- <th class="text-right">Selesai</th> -->
                  <th class="text-right bg-purple-soft" data-column-idx="2">FASIH %</th>
                  <th class="text-right bg-cyan-soft muatan-col" data-column-idx="3">Muatan %</th>
                </tr>
              </thead>
              <tbody>
                <% korlapStats.forEach((k, index) => { %>
                  <% let fasihPct = k.fasih_pct_str; %>
                  <% let muatanPct = k.muatan_pct_str; %>
                  <% const kOpen = Math.max(0, (k.target_fasih_total || 0) - ((k.draft_total || 0) + (k.submitted_total || 0) + (k.approved_total || 0) + (k.rejected_total || 0))); %>
                  <tr class="<%= filterKorlap === k.korlap ? 'active' : '' %>" style="<%= filterKorlap === k.korlap ? 'background: var(--bg-card-hover); font-weight: 500;' : '' %>">
                    <td class="text-center" style="font-weight: 600; background: var(--bg-subtle);"><%= index + 1 %></td>
                    <td class="td-primary">
                      <a href="<%= navPrefix %>/korlap?korlap=<%= encodeURIComponent(k.korlap) %>" style="color: inherit; text-decoration: none; display: inline-block;">
                        <i class="bi bi-person-workspace"></i> <%= k.korlap %>
                      </a>
                      <% if (kippKorlaps.includes(k.korlap.toUpperCase())) { %>
                        <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 4px;">KIPP</span>
                      <% } %>
                    </td>
                    <td class="bg-purple-soft" data-sort="<%= parseFloat(fasihPct) %>" style="min-width: 160px; padding: 6px 10px; vertical-align: middle;">
                      <%
                        const fReal = (k.submitted_total || 0) + (k.approved_total || 0) + (k.rejected_total || 0);
                        const fTgt = k.target_fasih_total || 0;
                        const fW = Math.min(parseFloat(fasihPct), 100);
                        const fColor = fW >= 100 ? 'var(--accent-green)' : (fW < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= fColor %>"><%= fasihPct %>%</span>
                        <span><%= fReal.toLocaleString('id-ID') %> / <%= fTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= fW >= 100 ? 'green' : (fW < 40 ? 'red' : 'purple') %>" data-width="<%= fW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <td class="text-right bg-cyan-soft muatan-col" data-sort="<%= parseFloat(muatanPct) %>" style="min-width: 160px; padding: 6px 10px;">
                      <%
                        const muatanReal = k.muatan_selesai !== undefined ? k.muatan_selesai : (k.usaha_total + k.keluarga_total);
                        const muatanTgt  = k.total_muatan || 0;
                        const muatanW    = Math.min(parseFloat(muatanPct), 100);
                        const muatanColor = muatanW >= 100 ? 'var(--accent-green)' : (muatanW < 40 ? 'var(--accent-red)' : 'var(--accent-cyan)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= muatanColor %>"><%= muatanPct %>%</span>
                        <span><%= muatanReal.toLocaleString('id-ID') %> / <%= muatanTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= muatanW >= 100 ? 'green' : (muatanW < 40 ? 'red' : 'blue') %>" data-width="<%= muatanW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <td class="text-right hide-sm" data-sort="<%= k.jumlah_pml %>"><%= k.jumlah_pml %> PML</td>
                    <td class="text-right hide-sm" data-sort="<%= k.jumlah_pcl %>"><%= k.jumlah_pcl %> PCL</td>
                    <!-- <td class="text-right hide-sm" data-sort="<%= k.total_subsls %>"><%= k.total_subsls %></td> -->
                    <!-- <td class="text-right fw-bold" data-sort="<%= k.selesai %>" style="<%= k.selesai === 0 ? 'color: var(--accent-red)' : '' %>"><%= k.selesai %></td> -->
                    <td class="text-right bg-gray-soft hide-sm status-open-text" data-sort="<%= kOpen %>"><%= kOpen.toLocaleString('id-ID') %></td>
                    <td class="text-right bg-yellow-soft hide-sm status-draft-text" data-sort="<%= k.draft_total %>"><%= (k.draft_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-blue-soft hide-sm status-submit-text" data-sort="<%= k.submitted_total %>"><%= (k.submitted_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-red-soft hide-sm status-reject-text" data-sort="<%= k.rejected_total %>" style="font-weight: 600;"><%= (k.rejected_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm status-approve-text" data-sort="<%= k.approved_total %>" style="font-weight: 600;"><%= (k.approved_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-purple-soft hide-sm" data-sort="<%= k.target_fasih_total %>"><%= (k.target_fasih_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right fw-bold bg-cyan-soft hide-sm muatan-col" data-sort="<%= k.usaha_total %>"><%= k.usaha_total.toLocaleString('id-ID') %></td>
                    <td class="text-right bg-cyan-soft hide-sm muatan-col" data-sort="<%= k.total_muatan %>"><%= k.total_muatan.toLocaleString('id-ID') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="no-data">Tidak ada Korlap yang cocok.</div>
        <% } %>
      </div>

      <!-- KORLAP'S PML TEAM DETAILS -->
      <div id="korlapDetailContainer">
        <% if (filterKorlap) { %>
          <div class="card" id="korlapDetailCard" style="margin-bottom: 0; position: sticky; top: 80px;">
            <div class="card-header flex-between" style="gap: 8px;">
              <div class="card-title" style="margin-bottom: 0;"><i class="bi bi-clipboard2-data"></i> Anggota Tim PML: <mark class="highlight-name"><%= filterKorlap %></mark></div>
              <div class="card-actions flex-start" style="gap: 6px; margin-left: auto;">
                <button onclick="window.shareElementAsImage('korlapDetailCard', event)" class="btn btn-secondary btn-xs" title="Bagikan gambar detail card"><i class="bi bi-share"></i><span class="btn-text-desktop"> Bagikan</span></button>
                <button onclick="window.copyElementAsImage('korlapDetailCard', event)" class="btn btn-secondary btn-xs" title="Salin gambar detail card ke clipboard"><i class="bi bi-copy"></i><span class="btn-text-desktop"> Salin</span></button>
                <a href="<%= navPrefix %>/korlap" class="btn btn-secondary btn-xs btn-close-detail" title="Tutup detail card"><i class="bi bi-x-lg"></i><span class="btn-text-desktop"> Tutup</span></a>
              </div>
            </div>

            <% if (detailData && detailData.length > 0) { %>
              <div class="mb-4">
                <% 
                  let totalBeban = selectedKorlapStats ? selectedKorlapStats.total_muatan : 0;
                  let totalUsaha = selectedKorlapStats ? (selectedKorlapStats.muatan_selesai !== undefined ? selectedKorlapStats.muatan_selesai : (selectedKorlapStats.usaha_total + selectedKorlapStats.keluarga_total)) : 0;
                  let totalPct = selectedKorlapStats ? selectedKorlapStats.muatan_pct_str : '0.00';

                  let totalFasihTgt = selectedKorlapStats ? selectedKorlapStats.target_fasih_total : 0;
                  let totalFasihDone = selectedKorlapStats ? ((selectedKorlapStats.submitted_total || 0) + (selectedKorlapStats.approved_total || 0) + (selectedKorlapStats.rejected_total || 0)) : 0;
                  let totalFasihPct = selectedKorlapStats ? selectedKorlapStats.fasih_pct_str : '0.00';
                  let totalFasihDraft = selectedKorlapStats ? (selectedKorlapStats.draft_total || 0) : 0;
                  let totalFasihOpen = Math.max(0, totalFasihTgt - (totalFasihDraft + totalFasihDone));
                  let totalFasihSubmit = selectedKorlapStats ? (selectedKorlapStats.submitted_total || 0) : 0;
                  let totalFasihApprove = selectedKorlapStats ? (selectedKorlapStats.approved_total || 0) : 0;
                  let totalFasihReject = selectedKorlapStats ? (selectedKorlapStats.rejected_total || 0) : 0;
                %>
                <!-- Progress FASIH -->
                <div style="margin-bottom: 12px;">
                  <div class="bar-label">
                    <span><i class="bi bi-phone"></i> Progres FASIH Tim (Submit + Approve + Reject)</span>
                    <span class="fw-bold"><%= totalFasihDone.toLocaleString('id-ID') %> / <%= totalFasihTgt.toLocaleString('id-ID') %> (<%= totalFasihPct %>%)</span>
                  </div>
                  <div class="progress-bar-wrap" style="height: 6px;">
                    <div class="progress-bar <%= parseFloat(totalFasihPct) >= 100 ? 'green' : (parseFloat(totalFasihPct) < 40 ? 'red' : 'purple') %>" data-width="<%= totalFasihPct %>" style="width: 0%;"></div>
                  </div>
                </div>

                <!-- Rincian Status Dokumen FASIH Tim Korlap -->
                <div class="fasih-grid-container" style="margin-bottom: 14px;">
                  <div class="fasih-grid" style="grid-template-columns: repeat(5, 1fr); gap: 4px;">
                    <div class="fasih-grid-item fasih-item-open" title="Open: Alokasi FASIH yang belum disentuh/draft">
                      <div class="fasih-grid-item-label" style="font-size: 8.5px;">Open</div>
                      <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihOpen.toLocaleString('id-ID') %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-draft" title="Draft: Sedang Diisi PCL">
                      <div class="fasih-grid-item-label" style="font-size: 8.5px;">Draft</div>
                      <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihDraft.toLocaleString('id-ID') %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-submit" title="Submitted: Dikirim ke PML">
                      <div class="fasih-grid-item-label" style="font-size: 8.5px;">Submit</div>
                      <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihSubmit.toLocaleString('id-ID') %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-approve" title="Approved: Disetujui PML">
                      <div class="fasih-grid-item-label" style="font-size: 8.5px;">Approve</div>
                      <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihApprove.toLocaleString('id-ID') %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-reject" title="Rejected: Ditolak / Perlu Perbaikan">
                      <div class="fasih-grid-item-label" style="font-size: 8.5px;">Reject</div>
                      <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihReject.toLocaleString('id-ID') %></div>
                    </div>
                  </div>
                </div>

                <!-- Progress Muatan -->
                <div style="margin-bottom: 12px;" class="muatan-col">
                  <div class="bar-label">
                    <span><i class="bi bi-briefcase"></i> Progres Muatan Tim</span>
                    <span class="fw-bold"><%= totalUsaha.toLocaleString('id-ID') %> / <%= totalBeban.toLocaleString('id-ID') %> (<%= totalPct %>%)</span>
                  </div>
                  <div class="progress-bar-target-wrap" style="position: relative; height: 6px; margin-top: 16px; margin-bottom: 8px;">
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                      <div class="progress-bar <%= parseFloat(totalPct) >= 100 ? 'green' : (parseFloat(totalPct) < 40 ? 'red' : 'blue') %>" data-width="<%= totalPct %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                    </div>
                    
                    <!-- Marker 25% (30 Juni) -->
                    <div style="position: absolute; left: 25%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 25 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                      <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">30 Jun: 25%</span>
                    </div>

                    <!-- Marker 40% (15 Juli) -->
                    <div style="position: absolute; left: 40%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 40 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                      <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">15 Jul: 40%</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="search-wrap mb-4" style="max-width: 100%; margin-bottom: 12px;">
                <input type="search" id="detailPmlSearch" placeholder="Cari nama PML dalam tim..." aria-label="Cari nama Pengawas PML dalam tim">
              </div>

              <div id="detailPmlList" style="max-height: 420px; overflow-y: auto; padding-right: 4px;">
                <% detailData.forEach(item => { %>
                  <% 
                    const doneFasih = (item.submitted_total || 0) + (item.approved_total || 0) + (item.rejected_total || 0);
                    const totalFasih = item.target_fasih_total || 0;
                    const fasihPctVal = totalFasih ? parseFloat(((doneFasih / totalFasih) * 100).toFixed(2)) : 0;
                    const fasihPctStr = fasihPctVal.toFixed(2);
                    const fasihModeLabel = (typeof settings !== 'undefined' && settings.target_fasih_mode === 'fasih-sm') ? 'FASIH-SM' : 'FASIH';
                    const itemOpen = Math.max(0, totalFasih - ((item.draft_total || 0) + doneFasih));

                    const doneMuatan = (item.usaha_total || 0) + (item.keluarga_total || 0);
                    const totalMuatan = item.total_muatan || 0;
                    const muatanPctVal = totalMuatan ? parseFloat(((doneMuatan / totalMuatan) * 100).toFixed(2)) : 0;
                    const muatanPctStr = muatanPctVal.toFixed(2);
                  %>
                  <div class="detail-item" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 7px 9px; margin-bottom: 6px; font-size: 11px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                      <div style="font-weight: 600; color: var(--text-primary); max-width: 65%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        <a href="<%= navPrefix %>/pml?pml=<%= encodeURIComponent(item.pml) %>" style="color: var(--accent-cyan); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                          <i class="bi bi-clipboard2-data"></i> <%= item.pml %>
                        </a>
                        <% if (kippPmls.includes(item.pml.toUpperCase())) { %>
                          <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 2px;">KIPP</span>
                        <% } %>
                      </div>
                      <div style="font-size: 10px; color: var(--text-muted);">
                        Petugas: <%= item.jumlah_pcl %> PCL &middot; <%= item.selesai %>/<%= item.total_subsls %> SLS
                      </div>
                    </div>
                    
                    <!-- 1. FASIH Progress Bar (DI ATAS) -->
                    <div style="display: flex; justify-content: space-between; font-size: 9.5px; color: var(--text-muted); margin-top: 4px;">
                      <span style="font-weight: 600;"><i class="bi bi-phone"></i> <%= fasihModeLabel %>: <span style="color: var(--accent-purple);"><%= fasihPctStr %>%</span></span>
                      <span><%= doneFasih.toLocaleString('id-ID') %> / <%= totalFasih.toLocaleString('id-ID') %></span>
                    </div>
                    <div class="progress-bar-target-wrap" style="position: relative; height: 5px; margin-top: 2px; margin-bottom: 6px;">
                      <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                        <div class="progress-bar <%= fasihPctVal >= 100 ? 'green' : (fasihPctVal < 40 ? 'red' : 'purple') %>" data-width="<%= fasihPctVal %>" style="width: <%= Math.min(100, fasihPctVal) %>%; height: 100%; border-radius: 99px;"></div>
                      </div>
                      <div style="position: absolute; left: <%= activeTargetPct %>%; top: -2px; height: 9px; border-left: 1.5px dashed var(--accent-cyan); z-index: 2; opacity: 0.8; pointer-events: none;" title="Target: <%= activeTargetPct %>%"></div>
                    </div>

                    <!-- 2. Muatan Progress Bar (DI BAWAH FASIH) -->
                    <div style="display: flex; justify-content: space-between; font-size: 9.5px; color: var(--text-muted); margin-top: 4px;" class="muatan-col">
                      <span style="font-weight: 600;"><i class="bi bi-briefcase"></i> Muatan: <span style="color: var(--accent-cyan);"><%= muatanPctStr %>%</span></span>
                      <span><%= doneMuatan.toLocaleString('id-ID') %> / <%= totalMuatan.toLocaleString('id-ID') %></span>
                    </div>
                    <div class="progress-bar-target-wrap muatan-col" style="position: relative; height: 5px; margin-top: 2px; margin-bottom: 6px;">
                      <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                        <div class="progress-bar <%= muatanPctVal >= 100 ? 'green' : (muatanPctVal < 40 ? 'red' : 'blue') %>" data-width="<%= muatanPctVal %>" style="width: <%= Math.min(100, muatanPctVal) %>%; height: 100%; border-radius: 99px;"></div>
                      </div>
                      <div style="position: absolute; left: <%= activeTargetPct %>%; top: -2px; height: 9px; border-left: 1.5px dashed var(--accent-cyan); z-index: 2; opacity: 0.8; pointer-events: none;" title="Target: <%= activeTargetPct %>%"></div>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 9px; color: var(--text-muted); margin-top: 4px;">
                      <span>Open: <strong style="color: #94a3b8;"><%= itemOpen.toLocaleString('id-ID') %></strong></span>
                      <span>(D<%= item.draft_total || 0 %> S<%= item.submitted_total || 0 %> A<%= item.approved_total || 0 %> R<%= item.rejected_total || 0 %>)</span>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="no-data">Tidak ada detail PML.</div>
            <% } %>
          </div>
        <% } else { %>
          <div class="card empty-state text-center" style="height: 100%; min-height: 300px; display: flex; flex-direction: column; justify-content: center; border-style: dashed;">
            <div class="empty-state-icon"><i class="bi bi-arrow-left-circle"></i></div>
            <div class="empty-state-title">Pilih Korlap</div>
            <div class="empty-state-text">Klik nama Korlap di tabel sebelah kiri untuk melihat rincian PML yang diawasi beserta progres kinerjanya.</div>
          </div>
        <% } %>
      </div>

    </div>

  <% } %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    makeTableSortable('korlapTable');
    makeTableSearchable('korlapSearch', 'korlapTable');
    
    // Initial searchable bind
    <% if (filterKorlap) { %>
      makeListSearchable('detailPmlSearch', 'detailPmlList', '.detail-item');
    <% } %>

    // AJAX Drilldown logic for Korlap
    const detailContainer = document.getElementById('korlapDetailContainer');
    const table = document.getElementById('korlapTable');

    if (table && detailContainer) {
      // Intercept row clicks
      table.querySelector('tbody').addEventListener('click', (e) => {
        const link = e.target.closest('td.td-primary a');
        if (!link) return;

        e.preventDefault();
        const url = link.getAttribute('href');
        const row = link.closest('tr');

        // Update active row visual indicator
        table.querySelectorAll('tbody tr').forEach(r => {
          r.classList.remove('active');
          r.style.background = '';
          r.style.fontWeight = '';
        });
        row.classList.add('active');
        row.style.background = 'var(--bg-card-hover)';
        row.style.fontWeight = '500';

        // Opacity transition
        detailContainer.style.opacity = '0.5';

        fetch(url)
          .then(res => res.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newDetail = doc.getElementById('korlapDetailContainer');
            if (newDetail) {
              detailContainer.innerHTML = newDetail.innerHTML;
              detailContainer.style.opacity = '1';
              detailContainer.classList.remove('smooth-detail-animate');
              void detailContainer.offsetWidth;
              detailContainer.classList.add('smooth-detail-animate');

              // Toggle grid selection classes
              const grid = document.querySelector('.drilldown-grid');
              if (grid) {
                grid.classList.remove('no-selection');
                grid.classList.add('has-selection');
              }

              // Update URL path without refresh
              window.history.pushState(null, '', url);

              // Re-bind list search utility
              makeListSearchable('detailPmlSearch', 'detailPmlList', '.detail-item');

              // Re-bind close handler
              bindCloseDetail();
              if (window.initProgressBars) window.initProgressBars(detailContainer);
            }
          })
          .catch(err => {
            console.error(err);
            detailContainer.style.opacity = '1';
          });
      });
    }

    // AJAX Tutup Detail handler
    function bindCloseDetail() {
      const closeBtn = detailContainer.querySelector('a[href*="/korlap"]');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const url = closeBtn.getAttribute('href') || '/korlap';

          // Reset active rows
          if (table) {
            table.querySelectorAll('tbody tr').forEach(r => {
              r.classList.remove('active');
              r.style.background = '';
              r.style.fontWeight = '';
            });
          }

          detailContainer.style.opacity = '0.5';
          fetch(url)
            .then(res => res.text())
            .then(html => {
              const parser = new DOMParser();
              const doc = parser.parseFromString(html, 'text/html');
              const newDetail = doc.getElementById('korlapDetailContainer');
              if (newDetail) {
                detailContainer.innerHTML = newDetail.innerHTML;
                detailContainer.style.opacity = '1';
                detailContainer.classList.remove('smooth-detail-animate');
                void detailContainer.offsetWidth;
                detailContainer.classList.add('smooth-detail-animate');
                window.history.pushState(null, '', url);

                // Toggle grid selection classes
                const grid = document.querySelector('.drilldown-grid');
                if (grid) {
                  grid.classList.remove('has-selection');
                  grid.classList.add('no-selection');
                }
                if (window.initProgressBars) window.initProgressBars(detailContainer);
                bindCloseDetail();
              }
            })
            .catch(err => {
              console.error(err);
              detailContainer.style.opacity = '1';
            });
        });
      }
    }

    bindCloseDetail();
  });
</script>
