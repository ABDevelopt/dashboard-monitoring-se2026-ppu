<%
  const isSakernas = typeof surveyConfig !== 'undefined' && surveyConfig.id && surveyConfig.id.startsWith('sakernas');
  const isSe2026Pcl = (typeof activeSurvey !== 'undefined' ? activeSurvey === 'se2026' : (typeof surveyConfig !== 'undefined' ? surveyConfig.id === 'se2026' : true));
  const hideMuatanPcl = !isSe2026Pcl || (typeof settings !== 'undefined' && settings.show_progres_muatan === '0');
  const officerLabel = isSakernas ? 'PPL' : 'PCL';

  let activeTargetPct = 25;
  let targetMonthName = '30 Juni';
  const currentDate = typeof latestUpload !== 'undefined' && latestUpload ? new Date(latestUpload.tanggal) : new Date();
  if (isSe2026Pcl && currentDate >= new Date('2026-07-01')) {
    activeTargetPct = 40;
    targetMonthName = '15 Juli';
  }
  
  let activeStatusCols = 1;
  if (settings.show_status_open === '1' || settings.show_status_open === undefined) activeStatusCols++;
  if (settings.show_status_draft === '1' || settings.show_status_draft === undefined) activeStatusCols++;
  if (settings.show_status_submitted === '1' || settings.show_status_submitted === undefined) activeStatusCols++;
  if (settings.show_status_rejected === '1' || settings.show_status_rejected === undefined) activeStatusCols++;
  if (settings.show_status_approved === '1' || settings.show_status_approved === undefined) activeStatusCols++;
%>
<div class="fade-in">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" integrity="sha384-e6nUZLBkQ86NJ6TVVKAeSaK8jWa3NhkYWZFomE39AvDbQWeie9PlQqM3pmYW5d1g" crossorigin="anonymous"></script>
  <% if (!uploadId) { %>
    <div class="card empty-state">
      <div class="empty-state-icon"><i class="bi bi-person-vcard"></i></div>
      <div class="empty-state-title">Belum Ada Data Petugas</div>
      <div class="empty-state-text">Upload file data untuk mulai memantau performa dan progres setiap <%= isSakernas ? 'Petugas Pendataan Lapangan (PPL)' : 'Petugas Cacah Lapangan (PCL)' %>.</div>
      <a href="<%= navPrefix %>/admin/upload" class="empty-state-action"><i class="bi bi-cloud-arrow-up-fill"></i> Upload Data Sekarang</a>
    </div>
  <% } else { %>
    <div id="ajax-container">
      <!-- PETUGAS NAVIGATION TABS -->
      <div class="petugas-tabs-wrapper">
        <a href="<%= navPrefix %>/pcl" class="petugas-tab-item <%= activePage === 'pcl' ? 'active' : '' %>">
          <i class="bi bi-person-gear"></i>
          <span><%= isSakernas ? 'PPL' : 'PCL' %></span>
        </a>
        <a href="<%= navPrefix %>/pml" class="petugas-tab-item <%= activePage === 'pml' ? 'active' : '' %>">
          <i class="bi bi-clipboard2-data"></i>
          <span>PML</span>
        </a>
        <% if (!isSakernas) { %>
          <% if (typeof settings === 'undefined' || settings.page_korlap !== '0') { %>
          <a href="<%= navPrefix %>/korlap" class="petugas-tab-item <%= activePage === 'korlap' ? 'active' : '' %>">
            <i class="bi bi-person-workspace"></i>
            <span>Korlap</span>
          </a>
          <% } %>
        <% } %>
        <% if (typeof settings === 'undefined' || settings.page_performa !== '0') { %>
        <a href="<%= navPrefix %>/performa" class="petugas-tab-item <%= activePage === 'performa' ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i>
          <span>Performa</span>
        </a>
        <% } %>
        <% if (typeof settings === 'undefined' || settings.page_leaderboard !== '0') { %>
        <a href="<%= navPrefix %>/leaderboard" class="petugas-tab-item <%= activePage === 'leaderboard' ? 'active' : '' %>">
          <i class="bi bi-trophy"></i>
          <span>Leaderboard</span>
        </a>
        <% } %>
      </div>


    <% if (pclStats && pclStats.length > 0) { %>
      <%
        let totalPclCount = pclStats.length;
        let sumTargetFasih = 0;
        let sumRealFasih = 0;
        let sumTotalSubsls = 0;
        let sumSelesaiSubsls = 0;
        let sumRealMuatan = 0;
        let activePclCount = 0;

        pclStats.forEach(p => {
          let pFasihReal = (p.submitted_total || 0) + (p.approved_total || 0) + (p.rejected_total || 0);
          sumTargetFasih += (p.target_fasih_total || 0);
          sumRealFasih += pFasihReal;
          sumTotalSubsls += (p.total_subsls || 0);
          sumSelesaiSubsls += (p.selesai || 0);
          sumRealMuatan += (p.muatan_selesai || 0);
          if (pFasihReal > 0 || (p.draft_total || 0) > 0) activePclCount++;
        });

        let avgTargetFasihPcl = totalPclCount > 0 ? (sumTargetFasih / totalPclCount).toFixed(1) : 0;
        let avgRealFasihPcl = totalPclCount > 0 ? (sumRealFasih / totalPclCount).toFixed(1) : 0;
        let avgSubslsPcl = totalPclCount > 0 ? (sumTotalSubsls / totalPclCount).toFixed(2) : 0;
        let avgRealMuatanPcl = totalPclCount > 0 ? (sumRealMuatan / totalPclCount).toFixed(1) : 0;
      %>

    <% } %>

    <script>
      window.submitPclFilter = function() {
        const filterForm = document.getElementById('filterForm');
        if (!filterForm) return;
        const formData = new FormData(filterForm);
        const params = new URLSearchParams();
        for (const [k, v] of formData.entries()) {
          if (v) params.append(k, v);
        }
        const targetUrl = '<%= navPrefix %>/pcl' + (params.toString() ? '?' + params.toString() : '');
        if (typeof window.loadPage === 'function') {
          window.loadPage(targetUrl);
        } else {
          filterForm.submit();
        }
      };
    </script>

    <!-- FILTER BAR -->
    <div class="card" style="margin-bottom: 20px;">
      <div class="card-header" style="margin-bottom: 8px; padding-bottom: 8px;">
        <div class="card-title"><i class="bi bi-search"></i> Filter Petugas</div>
        <a href="<%= navPrefix %>/pcl" class="btn btn-secondary btn-xs"><i class="bi bi-arrow-repeat"></i> Reset</a>
      </div>
      <form action="<%= navPrefix %>/pcl" method="GET" id="filterForm" onsubmit="event.preventDefault(); submitPclFilter();">
        <div class="filter-form-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: 10px;">
          <div>
            <label for="filterKec" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">Kecamatan</label>
            <select id="filterKec" name="kec" onchange="submitPclFilter();" style="width:100%;">
              <option value="">-- Semua --</option>
              <% kecList.forEach(k => { %>
                <option value="<%= k.kecamatan %>" <%= (filterKec && filterKec.toUpperCase() === k.kecamatan.toUpperCase()) ? 'selected' : '' %>><%= k.kecamatan %></option>
              <% }) %>
            </select>
          </div>
          <% if (!isSakernas) { %>
          <div>
            <label for="filterKorlap" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">Koordinator Lapangan</label>
            <select id="filterKorlap" name="korlap" onchange="submitPclFilter();" style="width:100%;">
              <option value="">-- Semua --</option>
              <% korlapList.forEach(k => { %>
                <option value="<%= k.korlap %>" <%= (filterKorlap && filterKorlap.toUpperCase() === k.korlap.toUpperCase()) ? 'selected' : '' %>><%= k.korlap %></option>
              <% }) %>
            </select>
          </div>
          <% } %>
          <div>
            <label for="filterPml" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">PML (Pengawas)</label>
            <select id="filterPml" name="pml" onchange="submitPclFilter();" style="width:100%;">
              <option value="">-- Semua --</option>
              <% pmlList.forEach(p => { %>
                <option value="<%= p.pml %>" <%= (filterPml && filterPml.toUpperCase() === p.pml.toUpperCase()) ? 'selected' : '' %>><%= p.pml %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </form>
    </div>

    <!-- TWO-COLUMN GRID FOR DRILLDOWN -->
    <div class="drilldown-grid <%= filterPcl ? 'has-selection' : 'no-selection' %> mt-3">
      
      <!-- PCL LIST TABLE -->
      <div class="card" style="margin-bottom: 0;">
        <div class="card-header flex-between" style="gap: 8px;">
          <div class="card-title"><i class="bi bi-person-gear"></i> Progres Kinerja per <%= officerLabel %> (<%= isSakernas ? 'Petugas Pendataan' : 'Pencacah' %>) <span class="badge badge-blue" id="pclCountBadge"><%= pclStats.length %> <%= officerLabel %></span></div>
        </div>

        <div class="search-wrap mb-4">
          <input type="search" id="pclSearch" placeholder="Cari nama <%= officerLabel %>, PML, Kecamatan..." aria-label="Cari nama <%= officerLabel %>" style="width: 100%; max-width: 280px;">
        </div>

        <% if (pclStats && pclStats.length > 0) { %>
          <div class="table-wrap" style="max-height: 600px; overflow-y: auto; overflow-x: auto;">
            <table id="pclTable">
              <thead class="hide-sm">
                <tr>
                  <th rowspan="2" class="text-center th-no" title="Nomor Ranking (Peringkat FASIH tertinggi)">No</th>
                  <th rowspan="2">Nama <%= officerLabel %></th>
                  <th rowspan="2" class="text-right bg-purple-soft" style="min-width: 140px;">FASIH %</th>
                  <% if (!hideMuatanPcl) { %>
                  <th rowspan="2" class="text-right bg-cyan-soft muatan-col" style="min-width: 140px;">Muatan %</th>
                  <% } %>
                  <th rowspan="2" class="hide-md">PML</th>
                  <% if (!isSakernas) { %>
                  <th rowspan="2" class="hide-md">Korlap</th>
                  <% } %>
                  <th rowspan="2" class="hide-md">Kecamatan</th>
                  <!-- <th colspan="2" class="text-center" style="border-bottom: 1px solid var(--border);">SubSLS</th> -->
                  <th colspan="<%= activeStatusCols %>" class="text-center bg-purple-soft" style="border-bottom: 1px solid var(--border);">Assignment FASIH</th>
                  <% if (!hideMuatanPcl) { %>
                  <th colspan="2" class="text-center bg-cyan-soft muatan-col" style="border-bottom: 1px solid var(--border);">Progres Muatan</th>
                  <th colspan="6" class="text-center bg-green-soft muatan-col" style="border-bottom: 1px solid var(--border);">Temuan Keberadaan Usaha</th>
                  <% } %>
                  <th colspan="4" class="text-center bg-blue-soft hide-sm" style="border-bottom: 1px solid var(--border);">Proyeksi (Deadline: 31 Agt)</th>
                </tr>
                <tr>
                  <% if (settings.show_status_open === '1' || settings.show_status_open === undefined) { %>
                    <th class="text-right bg-gray-soft status-open-text">Open</th>
                  <% } %>
                  <% if (settings.show_status_draft === '1' || settings.show_status_draft === undefined) { %>
                    <th class="text-right bg-yellow-soft">Draft</th>
                  <% } %>
                  <% if (settings.show_status_submitted === '1' || settings.show_status_submitted === undefined) { %>
                    <th class="text-right bg-blue-soft">Submitted</th>
                  <% } %>
                  <% if (settings.show_status_rejected === '1' || settings.show_status_rejected === undefined) { %>
                    <th class="text-right bg-red-soft">Rejected</th>
                  <% } %>
                  <% if (settings.show_status_approved === '1' || settings.show_status_approved === undefined) { %>
                    <th class="text-right bg-green-soft">Approved</th>
                  <% } %>
                  <th class="text-right bg-purple-soft"><%= settings.target_fasih_mode === 'fasih-sm' ? 'Tgt FASIH-SM' : 'Tgt Statis' %></th>
                  <% if (!hideMuatanPcl) { %>
                  <th class="text-right bg-cyan-soft hide-sm muatan-col">Realisasi</th>
                  <th class="text-right bg-cyan-soft hide-sm muatan-col">Target</th>
                  <th class="text-right bg-green-soft hide-sm muatan-col">Total Usaha</th>
                  <th class="text-right bg-green-soft hide-sm muatan-col">Ditemukan</th>
                  <th class="text-right bg-green-soft hide-sm muatan-col">Baru</th>
                  <th class="text-right bg-green-soft hide-sm muatan-col">Tdk Ditemukan</th>
                  <th class="text-right bg-green-soft hide-sm muatan-col">Tutup</th>
                  <th class="text-right bg-green-soft hide-sm muatan-col">Ganda</th>
                  <% } %>
                  <th class="text-right bg-blue-soft hide-sm">Laju Saat Ini</th>
                  <th class="text-right bg-orange-soft hide-sm" style="min-width: 90px;">Kec. Perlu/Hr</th>
                  <th class="text-right bg-orange-soft hide-sm" style="min-width: 80px;">Perlu (Hari)</th>
                  <th class="text-center bg-blue-soft hide-sm" style="min-width: 90px;">Status</th>
                </tr>
              </thead>
              <thead class="show-sm-table-header">
                <tr>
                  <th class="text-center th-no" title="Nomor Ranking (Peringkat FASIH tertinggi)">No</th>
                  <th>Nama <%= officerLabel %></th>
                  <!-- <th class="text-right">Selesai</th> -->
                  <th class="text-right bg-purple-soft" data-column-idx="2">FASIH %</th>
                  <% if (!hideMuatanPcl) { %>
                  <th class="text-right bg-cyan-soft muatan-col" data-column-idx="3">Muatan %</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% pclStats.forEach((p, index) => { %>
                  <% 
                    let fasihPct = p.fasih_pct_str;
                    let muatanPct = p.muatan_pct_str;
                    const fRealNum = (p.submitted_total || 0) + (p.approved_total || 0) + (p.rejected_total || 0);
                    const fTgtNum = p.target_fasih_total || 0;
                    const isKippPcl = kippPcls.includes(p.pcl.toUpperCase());
                    const isSelesaiPcl = fTgtNum > 0 && fRealNum >= fTgtNum;
                    const isOntrackPcl = parseFloat(fasihPct) >= activeTargetPct;
                    const isCriticalPcl = parseFloat(fasihPct) < 40;
                    const isZeroPcl = parseFloat(fasihPct) === 0;
                    const searchKeywords = `${p.pcl} ${p.pml || ''} ${p.korlap || ''} ${p.kecamatan || ''} ${p.email || ''}`.toLowerCase();
                  %>
                  <tr class="<%= filterPcl === p.pcl ? 'active' : '' %>" 
                      data-search="<%= searchKeywords %>"
                      data-pct="<%= parseFloat(fasihPct) || 0 %>"
                      data-kipp="<%= isKippPcl ? '1' : '0' %>"
                      data-selesai="<%= isSelesaiPcl ? '1' : '0' %>"
                      data-ontrack="<%= isOntrackPcl ? '1' : '0' %>"
                      data-critical="<%= isCriticalPcl ? '1' : '0' %>"
                      data-zero="<%= isZeroPcl ? '1' : '0' %>"
                      style="<%= filterPcl === p.pcl ? 'background: var(--bg-card-hover); font-weight: 500;' : '' %>">
                    <td class="text-center td-index" data-sort="<%= index + 1 %>">
                      <% if (index === 0) { %>
                        <span style="color: #fbbf24; font-weight: 700;" title="Peringkat 1 (Tertinggi)"><%= index + 1 %></span>
                      <% } else if (index === 1) { %>
                        <span style="color: #cbd5e1; font-weight: 700;" title="Peringkat 2"><%= index + 1 %></span>
                      <% } else if (index === 2) { %>
                        <span style="color: #f97316; font-weight: 700;" title="Peringkat 3"><%= index + 1 %></span>
                      <% } else { %>
                        <%= index + 1 %>
                      <% } %>
                    </td>
                    <td class="td-primary">
                      <a href="<%= navPrefix %>/pcl?pcl=<%= encodeURIComponent(p.pcl) %>&kec=<%= filterKec %>&korlap=<%= filterKorlap %>&pml=<%= filterPml %>" class="link-plain" style="display: inline-block;">
                        <i class="bi bi-person"></i> <%= p.pcl %>
                      </a>
                      <% if (kippPcls.includes(p.pcl.toUpperCase())) { %>
                        <span class="badge badge-orange badge-xs" style="vertical-align: middle; margin-left: 4px;">KIPP</span>
                      <% } %>
                      <% if (p.email && isAdmin) { %>
                        <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                          <a href="mailto:<%= p.email %>" style="color: var(--text-muted); text-decoration: none;" title="Kirim Email: <%= p.email %>">
                            <i class="bi bi-envelope" style="font-size: 10px;"></i> <%= p.email %>
                          </a>
                        </div>
                      <% } else if (p.email) { %>
                        <% 
                          let maskedEmail = '';
                          const parts = p.email.split('@');
                          if (parts.length === 2) {
                            const namePart = parts[0];
                            const domainPart = parts[1];
                            maskedEmail = namePart.substring(0, Math.min(2, namePart.length)) + '***@' + domainPart;
                          } else {
                            maskedEmail = '***';
                          }
                        %>
                        <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                          <span title="Hanya Administrator yang dapat melihat email lengkap">
                            <i class="bi bi-envelope" style="font-size: 10px;"></i> <%= maskedEmail %>
                          </span>
                        </div>
                      <% } %>
                    </td>
                    <td class="bg-purple-soft" data-sort="<%= parseFloat(fasihPct) %>" style="min-width: 160px; padding: 6px 10px;">
                      <%
                        const fasihRealPcl = (p.submitted_total || 0) + (p.approved_total || 0) + (p.rejected_total || 0);
                        const fasihTgtPcl  = p.target_fasih_total || 0;
                        const fasihWPcl    = Math.min(parseFloat(fasihPct), 100);
                        const fasihColorPcl = fasihWPcl >= 100 ? 'var(--accent-green)' : (fasihWPcl < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= fasihColorPcl %>"><%= fasihPct %>%</span>
                        <span><%= fasihRealPcl.toLocaleString('id-ID') %> / <%= fasihTgtPcl.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= fasihWPcl >= 100 ? 'green' : (fasihWPcl < 40 ? 'red' : 'purple') %>" data-width="<%= fasihWPcl %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <% if (!hideMuatanPcl) { %>
                    <td class="bg-cyan-soft muatan-col" data-sort="<%= parseFloat(muatanPct) %>" style="min-width: 160px; padding: 6px 10px;">
                      <%
                        const muatanRealPcl = p.muatan_selesai !== undefined ? p.muatan_selesai : (p.usaha_total + p.keluarga_total);
                        const muatanTgtPcl  = p.total_muatan || 0;
                        const muatanWPcl    = Math.min(parseFloat(muatanPct), 100);
                        const muatanColorPcl = muatanWPcl >= 100 ? 'var(--accent-green)' : (muatanWPcl < 40 ? 'var(--accent-red)' : 'var(--accent-cyan)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= muatanColorPcl %>"><%= muatanPct %>%</span>
                        <span><%= muatanRealPcl.toLocaleString('id-ID') %> / <%= muatanTgtPcl.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= muatanWPcl >= 100 ? 'green' : (muatanWPcl < 40 ? 'red' : 'blue') %>" data-width="<%= muatanWPcl %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <% } %>
                    <td class="hide-md">
                      <%= p.pml %>
                      <% if (kippPmls.includes(p.pml.toUpperCase())) { %>
                        <span class="badge badge-orange badge-xs" style="vertical-align: middle; margin-left: 2px;">KIPP</span>
                      <% } %>
                    </td>
                    <% if (!isSakernas) { %>
                    <td class="hide-md">
                      <%= p.korlap %>
                      <% if (p.korlap && kippKorlaps.includes(p.korlap.toUpperCase())) { %>
                        <span class="badge badge-orange badge-xs" style="vertical-align: middle; margin-left: 2px;">KIPP</span>
                      <% } %>
                    </td>
                    <% } %>
                    <td class="hide-md"><%= p.kecamatan %></td>
                    <!-- <td class="text-right hide-sm" data-sort="<%= p.total_subsls %>"><%= p.total_subsls %></td> -->
                    <!-- <td class="text-right fw-bold" data-sort="<%= p.selesai %>" style="<%= p.selesai === 0 ? 'color: var(--accent-red)' : '' %>"><%= p.selesai %></td> -->
                     <% if (settings.show_status_open === '1' || settings.show_status_open === undefined) { %>
                       <td class="text-right bg-gray-soft hide-sm status-open-text" data-sort="<%= p.open_total %>"><%= (p.open_total || 0).toLocaleString('id-ID') %></td>
                     <% } %>
                     <% if (settings.show_status_draft === '1' || settings.show_status_draft === undefined) { %>
                       <td class="text-right bg-yellow-soft hide-sm status-draft-text" data-sort="<%= p.draft_total %>"><%= (p.draft_total || 0).toLocaleString('id-ID') %></td>
                     <% } %>
                     <% if (settings.show_status_submitted === '1' || settings.show_status_submitted === undefined) { %>
                       <td class="text-right bg-blue-soft hide-sm status-submit-text" data-sort="<%= p.submitted_total %>"><%= (p.submitted_total || 0).toLocaleString('id-ID') %></td>
                     <% } %>
                     <% if (settings.show_status_rejected === '1' || settings.show_status_rejected === undefined) { %>
                       <td class="text-right bg-red-soft hide-sm status-reject-text" data-sort="<%= p.rejected_total %>" style="font-weight: 600;"><%= (p.rejected_total || 0).toLocaleString('id-ID') %></td>
                     <% } %>
                     <% if (settings.show_status_approved === '1' || settings.show_status_approved === undefined) { %>
                       <td class="text-right bg-green-soft hide-sm status-approve-text" data-sort="<%= p.approved_total %>" style="font-weight: 600;"><%= (p.approved_total || 0).toLocaleString('id-ID') %></td>
                     <% } %>
                     <td class="text-right bg-purple-soft hide-sm" data-sort="<%= p.target_fasih_total %>"><%= (p.target_fasih_total || 0).toLocaleString('id-ID') %></td>
                     <% if (!hideMuatanPcl) { %>
                     <td class="text-right fw-bold bg-cyan-soft hide-sm muatan-col" data-sort="<%= p.muatan_selesai %>"><%= (p.muatan_selesai || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-cyan-soft hide-sm muatan-col" data-sort="<%= p.total_muatan %>"><%= p.total_muatan.toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm muatan-col" data-sort="<%= p.usaha_total %>"><%= p.usaha_total.toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm muatan-col" data-sort="<%= p.usaha_ditemukan_total %>"><%= (p.usaha_ditemukan_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm muatan-col" data-sort="<%= p.usaha_baru_total %>"><%= (p.usaha_baru_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm muatan-col" data-sort="<%= p.usaha_tidak_ditemukan_total %>"><%= (p.usaha_tidak_ditemukan_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm muatan-col" data-sort="<%= p.usaha_tutup_total %>"><%= (p.usaha_tutup_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm muatan-col" data-sort="<%= p.usaha_ganda_total %>"><%= (p.usaha_ganda_total || 0).toLocaleString('id-ID') %></td>
                     <% } %>
                    <%
                      let fasihSelesaiPcl = (p.submitted_total || 0) + (p.approved_total || 0) + (p.rejected_total || 0);
                      let totalFasihProgress = (p.draft_total || 0) + fasihSelesaiPcl;
                      let runrate = diffDays > 0 ? parseFloat((fasihSelesaiPcl / diffDays).toFixed(2)) : 0;
                      let remainingFasih = (p.target_fasih_total || 0) - fasihSelesaiPcl;

                      // Kecepatan yang perlu dicapai agar selesai tepat waktu
                      let requiredRatePcl = (remainingFasih > 0 && daysRemaining > 0)
                        ? parseFloat((remainingFasih / daysRemaining).toFixed(2))
                        : (remainingFasih <= 0 ? 0 : null);

                      // Perkiraan hari selesai dengan laju saat ini
                      let daysNeededPcl = null;
                      if (remainingFasih <= 0) {
                        daysNeededPcl = 0;
                      } else if (runrate > 0) {
                        daysNeededPcl = Math.ceil(remainingFasih / runrate);
                      }

                      let statusBadge = '';
                      let statusText = '';
                      let sortValue = 9999;

                      if (remainingFasih <= 0) {
                        statusBadge = 'badge-green';
                        statusText = 'Selesai';
                        sortValue = 0;
                      } else if (runrate <= 0) {
                        statusBadge = 'badge-red';
                        statusText = 'Stagnan';
                        sortValue = 999999;
                      } else if (daysNeededPcl <= daysRemaining) {
                        statusBadge = 'badge-blue';
                        statusText = 'On Track';
                        sortValue = daysNeededPcl;
                      } else {
                        statusBadge = 'badge-red';
                        statusText = 'Off Track';
                        sortValue = daysNeededPcl;
                      }
                    %>
                    <td class="text-right bg-blue-soft hide-sm" data-sort="<%= runrate %>" style="font-weight: 500;"><%= runrate.toFixed(2) %></td>
                    <td class="text-right bg-orange-soft hide-sm" data-sort="<%= requiredRatePcl !== null ? requiredRatePcl : 9999 %>" style="font-weight: 500;">
                      <% if (remainingFasih <= 0) { %>
                        <span style="color: var(--accent-green);">—</span>
                      <% } else if (daysRemaining <= 0) { %>
                        <span style="color: var(--accent-red); font-weight:700;">∞</span>
                      <% } else { %>
                        <span style="color: <%= requiredRatePcl > runrate ? 'var(--accent-red)' : 'var(--accent-cyan)' %>; font-weight: 600;">
                          <%= requiredRatePcl.toFixed(2) %>
                        </span>
                      <% } %>
                    </td>
                    <td class="text-right bg-orange-soft hide-sm" data-sort="<%= daysNeededPcl !== null ? daysNeededPcl : 9999 %>">
                      <% if (remainingFasih <= 0) { %>
                        <span style="color: var(--accent-green);">—</span>
                      <% } else if (daysNeededPcl === null) { %>
                        <span style="color: var(--accent-red); font-weight:700;">∞</span>
                      <% } else { %>
                        <span style="color: <%= daysNeededPcl > daysRemaining ? 'var(--accent-red)' : 'var(--text-primary)' %>; font-weight: 500;">
                          <%= daysNeededPcl %>
                        </span>
                      <% } %>
                    </td>
                    <td class="text-center bg-blue-soft hide-sm" data-sort="<%= sortValue %>">
                      <span class="badge <%= statusBadge %>"><%= statusText %></span>
                    </td>

                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <%
            let countOver40 = 0;
            let countUnder40 = 0;
            let totalShortfall = 0;

            pclStats.forEach(p => {
              const pct = parseFloat(p.fasih_pct_str || 0);
              if (pct >= 40.0) {
                countOver40++;
              } else {
                countUnder40++;
                const realisasi = (p.submitted_total || 0) + (p.approved_total || 0) + (p.rejected_total || 0);
                const targetFasih = p.target_fasih_total || 0;
                const target40 = Math.ceil(targetFasih * 0.4);
                const shortfall = Math.max(0, target40 - realisasi);
                totalShortfall += shortfall;
              }
            });
          %>
          

        <% } else { %>
          <div class="no-data">Tidak ada PCL yang cocok dengan filter.</div>
        <% } %>
      </div>

      <!-- DETAIL OF CHOSEN PCL -->
      <div id="pclDetailContainer">
        <% if (filterPcl) { %>
          <div class="card" id="pclDetailCard" style="margin-bottom: 0; position: sticky; top: 80px;">
            <div class="card-header flex-between" style="gap: 8px;">
              <div class="card-title mb-0 flex-start" style="flex-wrap: wrap; gap: 4px;">
                <i class="bi bi-search"></i> Rincian Tugas SLS: <mark class="highlight-name"><%= filterPcl %></mark>
                <button class="pin-btn" data-type="pcl" data-name="<%= filterPcl %>" data-href="<%= navPrefix %>/pcl?pcl=<%= encodeURIComponent(filterPcl) %>" title="Sematkan Petugas ke Favorit">
                  <i class="bi bi-star"></i>
                </button>
                <% if (kippPcls.includes(filterPcl.toUpperCase())) { %>
                  <span class="badge badge-orange badge-xs" style="vertical-align: middle; margin-left: 6px;">KIPP</span>
                <% } %>
              </div>
              <div class="card-actions flex-start" style="gap: 6px; margin-left: auto;">
                <button onclick="window.shareElementAsImage('pclDetailCard', event)" class="btn btn-secondary btn-xs" title="Bagikan gambar detail card"><i class="bi bi-share"></i><span class="btn-text-desktop"> Bagikan</span></button>
                <button onclick="window.copyElementAsImage('pclDetailCard', event)" class="btn btn-secondary btn-xs" title="Salin gambar detail card ke clipboard"><i class="bi bi-copy"></i><span class="btn-text-desktop"> Salin</span></button>
                <a href="<%= navPrefix %>/pcl?kec=<%= filterKec %>&korlap=<%= filterKorlap %>&pml=<%= filterPml %>" class="btn btn-secondary btn-xs btn-close-detail" title="Tutup detail card"><i class="bi bi-x-lg"></i><span class="btn-text-desktop"> Tutup</span></a>
              </div>
            </div>

            <% if (detailSubsls && detailSubsls.length > 0) { %>
              <div class="mb-4">
                <div class="text-base text-secondary mb-2">
                  PML: <strong><%= detailSubsls[0].pml %></strong><% if (kippPmls.includes(detailSubsls[0].pml.toUpperCase())) { %> <span class="badge badge-orange badge-xs" style="vertical-align: middle;">KIPP</span><% } %>
                  <% if (!isSakernas) { %>
                   · Korlap: <strong><%= detailSubsls[0].korlap %></strong><% if (kippKorlaps.includes(detailSubsls[0].korlap.toUpperCase())) { %> <span class="badge badge-orange badge-xs" style="vertical-align: middle;">KIPP</span><% } %>
                  <% } %>
                </div>
                <% 
                  let doneMuatan = selectedPclStats ? (selectedPclStats.muatan_selesai !== undefined ? selectedPclStats.muatan_selesai : (selectedPclStats.usaha_total + selectedPclStats.keluarga_total)) : 0;
                  let totalMuatan = selectedPclStats ? selectedPclStats.total_muatan : 0;
                  let donePct = selectedPclStats ? selectedPclStats.muatan_pct_str : '0.00';

                  let doneFasih = selectedPclStats ? ((selectedPclStats.submitted_total || 0) + (selectedPclStats.approved_total || 0) + (selectedPclStats.rejected_total || 0)) : 0;
                  let totalFasih = selectedPclStats ? selectedPclStats.target_fasih_total : 0;
                  let fasihPct = selectedPclStats ? selectedPclStats.fasih_pct_str : '0.00';

                  let openFasih = selectedPclStats ? (selectedPclStats.open_total || 0) : 0;
                  let draftFasih = selectedPclStats ? (selectedPclStats.draft_total || 0) : 0;
                  let submittedFasih = selectedPclStats ? (selectedPclStats.submitted_total || 0) : 0;
                  let rejectedFasih = selectedPclStats ? (selectedPclStats.rejected_total || 0) : 0;
                  let approvedFasih = selectedPclStats ? (selectedPclStats.approved_total || 0) : 0;
                %>
                <!-- Progress FASIH -->
                <div class="mb-3">
                  <div class="bar-label">
                    <span><i class="bi bi-phone"></i> Progres FASIH (Submit + Approve + Reject)</span>
                    <span class="fw-bold"><%= doneFasih.toLocaleString('id-ID') %> / <%= totalFasih.toLocaleString('id-ID') %> (<%= fasihPct %>%)</span>
                  </div>
                  <div class="progress-bar-target-wrap" style="position: relative; height: 6px; margin-top: 16px; margin-bottom: 8px;">
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                      <div class="progress-bar <%= parseFloat(fasihPct) >= 100 ? 'green' : (parseFloat(fasihPct) < 40 ? 'red' : 'blue') %>" data-width="<%= fasihPct %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                    </div>
                    
                    <!-- Marker 25% (30 Juni) -->
                    <div style="position: absolute; left: 25%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 25 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                      <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">30 Jun: 25%</span>
                    </div>

                    <!-- Marker 40% (15 Juli) -->
                    <div style="position: absolute; left: 40%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 40 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                      <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">15 Jul: 40%</span>
                    </div>
                  </div>
                </div>

                <!-- Progress Muatan -->
                <% if (!hideMuatanPcl) { %>
                <div class="mb-3 muatan-col">
                  <div class="bar-label">
                    <span><i class="bi bi-briefcase"></i> Progres Muatan</span>
                    <span class="fw-bold"><%= doneMuatan.toLocaleString('id-ID') %> / <%= totalMuatan.toLocaleString('id-ID') %> (<%= donePct %>%)</span>
                  </div>
                  <div class="progress-bar-target-wrap" style="position: relative; height: 6px; margin-top: 16px; margin-bottom: 8px;">
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                      <div class="progress-bar <%= parseFloat(donePct) >= 100 ? 'green' : (parseFloat(donePct) < 40 ? 'red' : 'blue') %>" data-width="<%= donePct %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                    </div>
                    
                    <!-- Marker 25% (30 Juni) -->
                    <div style="position: absolute; left: 25%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 25 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                      <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">30 Jun: 25%</span>
                    </div>

                    <!-- Marker 40% (15 Juli) -->
                    <div style="position: absolute; left: 40%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 40 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                      <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">15 Jul: 40%</span>
                    </div>
                  </div>
                </div>
                <% } %>

                <!-- Mini Grid Status FASIH -->
                <div class="status-mini-grid" style="display: grid; grid-template-columns: repeat(<%= activeStatusCols - 1 %>, 1fr); gap: 6px; margin-top: 14px; text-align: center;">
                  <% if (settings.show_status_open === '1' || settings.show_status_open === undefined) { %>
                    <div class="fasih-grid-item status-open-bg">
                      <div class="fasih-grid-item-label status-open-text">Open</div>
                      <div class="fasih-grid-item-value status-open-text"><%= openFasih %></div>
                    </div>
                  <% } %>
                  <% if (settings.show_status_draft === '1' || settings.show_status_draft === undefined) { %>
                    <div class="fasih-grid-item fasih-item-draft">
                      <div class="fasih-grid-item-label">Draft</div>
                      <div class="fasih-grid-item-value"><%= draftFasih %></div>
                    </div>
                  <% } %>
                  <% if (settings.show_status_submitted === '1' || settings.show_status_submitted === undefined) { %>
                    <div class="fasih-grid-item fasih-item-submit">
                      <div class="fasih-grid-item-label">Submit</div>
                      <div class="fasih-grid-item-value"><%= submittedFasih %></div>
                    </div>
                  <% } %>
                  <% if (settings.show_status_approved === '1' || settings.show_status_approved === undefined) { %>
                    <div class="fasih-grid-item fasih-item-approve">
                      <div class="fasih-grid-item-label">Approve</div>
                      <div class="fasih-grid-item-value"><%= approvedFasih %></div>
                    </div>
                  <% } %>
                  <% if (settings.show_status_rejected === '1' || settings.show_status_rejected === undefined) { %>
                    <div class="fasih-grid-item fasih-item-reject">
                      <div class="fasih-grid-item-label">Reject</div>
                      <div class="fasih-grid-item-value"><%= rejectedFasih %></div>
                    </div>
                  <% } %>
                </div>

                <!-- Daily Progress Chart -->
                <div style="margin-top: 20px; margin-bottom: 20px; border-top: 1px solid var(--border); padding-top: 16px; margin-left: -20px; margin-right: -20px;">
                  <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 8px; padding-left: 20px; padding-right: 20px;">
                    <i class="bi bi-graph-up"></i> Tren Progres Harian (FASIH)
                  </div>
                  <div style="height: 180px; position: relative; width: 100%; padding-left: 10px; padding-right: 10px;">
                    <canvas id="pclHistoryChartCanvas"></canvas>
                  </div>
                </div>

                <!-- Analisis Kecepatan & Estimasi Pendataan -->
                <%
                  let remainingFasih = Math.max(0, totalFasih - doneFasih);
                  let currentSpeed = doneFasih / diffDays; // dokumen per hari
                  let currentSpeedText = currentSpeed.toFixed(2);
                  
                  let estDaysToFinish = currentSpeed > 0 ? (remainingFasih / currentSpeed) : null;
                  let isOfftrack = (currentSpeed === 0 && remainingFasih > 0) || (estDaysToFinish !== null && estDaysToFinish > daysRemaining);
                  
                  let reqSpeed = daysRemaining > 0 ? (remainingFasih / daysRemaining) : remainingFasih;
                %>
                <div style="margin-top: 18px; padding: 14px; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px;">
                  <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-cyan); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                    <i class="bi bi-speedometer2" style="font-size: 14px;"></i> Analisis Kecepatan & Sisa Waktu
                  </div>
                  
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                    <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 8px; text-align: center;">
                      <div style="font-size: 10px; color: var(--text-muted); font-weight: 500;">Kecepatan Saat Ini</div>
                      <div style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-top: 2px;"><%= currentSpeedText %> <span style="font-size: 10px; font-weight: 500; color: var(--text-muted);">dok/hari</span></div>
                    </div>
                    <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 8px; text-align: center;">
                      <div style="font-size: 10px; color: var(--text-muted); font-weight: 500;">Status Target</div>
                      <div style="font-size: 12px; font-weight: 700; margin-top: 4px;">
                        <% if (remainingFasih === 0) { %>
                          <span class="badge badge-green" style="font-size: 10px; padding: 3px 8px;">Selesai 100%</span>
                        <% } else if (isOfftrack) { %>
                          <span class="badge badge-red" style="font-size: 10px; padding: 3px 8px;"><i class="bi bi-exclamation-triangle-fill"></i> Off-Track</span>
                        <% } else { %>
                          <span class="badge badge-green" style="font-size: 10px; padding: 3px 8px;"><i class="bi bi-check-circle-fill"></i> On-Track</span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                  
                  <div style="font-size: 11px; line-height: 1.5; color: var(--text-secondary);">
                    <% if (remainingFasih === 0) { %>
                      Petugas <strong><%= filterPcl %></strong> telah menyelesaikan seluruh target pengisian dokumen FASIH sebanyak <strong><%= totalFasih %></strong> dokumen. Kinerja luar biasa!
                    <% } else { %>
                      Hari berjalan pendataan: <strong><%= diffDays %> hari</strong> (sejak <%= formatIndonesianDate(settings.speedometer_start_date || '2026-06-15') %>). Sisa hari menuju deadline (<%= formatIndonesianDate(settings.speedometer_target_date || '2026-08-31') %>): <strong><%= daysRemaining %> hari</strong>.<br>
                      Sisa beban kerja: <strong><%= remainingFasih %> dokumen</strong>. 
                      Dengan kecepatan saat ini (<strong><%= currentSpeedText %> dok/hari</strong>), 
                      <% if (currentSpeed === 0) { %>
                        petugas belum merealisasikan dokumen FASIH sama sekali sehingga estimasi hari selesai tidak dapat diprediksi.
                      <% } else { %>
                        petugas diprediksi akan menyelesaikan sisa dokumen dalam waktu sekitar <strong><%= Math.ceil(estDaysToFinish) %> hari</strong>.
                      <% } %>
                      
                      <% if (isOfftrack) { %>
                        <div style="margin-top: 8px; padding: 8px; background: rgba(239, 68, 68, 0.08); border-left: 3px solid var(--accent-red); border-radius: 4px; color: var(--text-primary); display: flex; align-items: flex-start; gap: 6px;">
                          <i class="bi bi-exclamation-triangle-fill" style="color: var(--accent-red); font-size: 13px; margin-top: 1px;"></i>
                          <div><strong>Off-Track:</strong> Petugas diprediksi terlambat/tidak selesai tepat waktu. Diperlukan peningkatan kecepatan kerja minimal menjadi <strong><%= reqSpeed.toFixed(2) %> dok/hari</strong> agar selesai sesuai target pada <%= formatIndonesianDate(settings.speedometer_target_date || '2026-08-31') %>.</div>
                        </div>
                      <% } else { %>
                        <div style="margin-top: 8px; padding: 8px; background: rgba(34, 197, 94, 0.08); border-left: 3px solid var(--accent-green); border-radius: 4px; color: var(--text-primary); display: flex; align-items: flex-start; gap: 6px;">
                          <i class="bi bi-check-circle-fill" style="color: var(--accent-green); font-size: 13px; margin-top: 1px;"></i>
                          <div><strong>On-Track:</strong> Kecepatan petugas sudah memadai untuk menyelesaikan seluruh beban kerja sebelum deadline (estimasi selesai sebelum <%= formatIndonesianDate(settings.speedometer_target_date || '2026-08-31') %>).</div>
                        </div>
                      <% } %>
                    <% } %>
                  </div>
                </div>

                <!-- JSON data script tag -->
                <script id="pclHistoryData" type="application/json">
                  <%- JSON.stringify(pclHistory) %>
                </script>
              </div>

              <div class="search-wrap mb-4" style="max-width: 100%; margin-bottom: 12px;">
                <input type="search" id="detailSubslsSearch" placeholder="Cari nama SLS/kode..." aria-label="Cari nama SLS atau kode wilayah">
              </div>

              <div id="detailSubslsList" style="max-height: 420px; overflow-y: auto; padding-right: 4px;">
                <% detailSubsls.forEach(s => { %>
                  <div class="detail-item" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 5px 8px; margin-bottom: 4px; font-size: 11px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                      <div style="font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 80%;">
                        <span class="td-code" style="font-size: 9px; padding: 1px 3px; font-weight: normal; margin-right: 4px;"><%= s.kode %></span>
                        <%= s.nama_sls %>
                      </div>
                      <% if (s.sudah_diisi === 'belum_mulai') { %>
                        <span class="badge badge-gray btn-xs" style="font-size: 8px; padding: 1px 4px;">Belum Mulai</span>
                      <% } else if (s.sudah_diisi === 'sedang_didata') { %>
                        <span class="badge badge-orange btn-xs" style="font-size: 8px; padding: 1px 4px;">Sedang Didata</span>
                      <% } else if (s.sudah_diisi === 'memenuhi_target') { %>
                        <span class="badge badge-purple btn-xs" style="font-size: 8px; padding: 1px 4px;">Memenuhi Target</span>
                      <% } else if (s.sudah_diisi === 'selesai') { %>
                        <span class="badge badge-green btn-xs" style="font-size: 8px; padding: 1px 4px;">Selesai</span>
                      <% } else { %>
                        <span class="badge badge-gray btn-xs" style="font-size: 8px; padding: 1px 4px;">-</span>
                      <% } %>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: var(--text-muted); flex-wrap: wrap; gap: 4px;">
                      <div><%= s.desa %></div>
                      <div style="display: flex; gap: 6px; align-items: center;">
                        <% if (!hideMuatanPcl) { %>
                        <span class="muatan-col" style="color: var(--accent-cyan);">
                          Muatan: <strong><%= s.usaha_total %></strong>/<%= Math.round(s.muatan) %>
                        </span>
                        <% } %>
                        <span style="color: var(--accent-purple);">
                          FASIH: <strong><%= (s.submitted_by_pcl || 0) + (s.approved || 0) + (s.rejected || 0) %></strong>/<%= Math.round(s.target_fasih) %> 
                          <span style="font-size: 9px; color: var(--text-muted);">(D<%= s.draft %> S<%= s.submitted_by_pcl %> A<%= s.approved %> R<%= s.rejected %>)</span>
                        </span>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="no-data">Tidak ada rincian tugas.</div>
            <% } %>
          </div>
        <% } else { %>
          <div class="card empty-state text-center" style="height: 100%; min-height: 300px; display: flex; flex-direction: column; justify-content: center; border-style: dashed;">
            <div class="empty-state-icon"><i class="bi bi-arrow-left-circle"></i></div>
            <div class="empty-state-title">Pilih PCL</div>
            <div class="empty-state-text">Klik nama PCL di tabel sebelah kiri untuk melihat rincian alokasi SubSLS dan progres pencacahan secara detail.</div>
          </div>
        <% } %>
      </div>

    </div>

  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('ajax-container');
  if (!container) return;

  function initPclHistoryChart() {
    const dataEl = document.getElementById('pclHistoryData');
    if (!dataEl) return;
    try {
      const data = JSON.parse(dataEl.textContent);
      if (data && data.length) {
        if (typeof Chart !== 'undefined') {
          const existingChart = Chart.getChart("pclHistoryChartCanvas");
          if (existingChart) {
            existingChart.destroy();
          }
        }
        if (typeof createPclHistoryChart === 'function') {
          createPclHistoryChart('pclHistoryChartCanvas', data);
        }
      }
    } catch (e) {
      console.error('Failed to init PCL history chart:', e);
    }
  }

  function attachListeners() {
    // Initialize expand buttons for AJAX loaded content
    if (window.initExpandButtons) {
      window.initExpandButtons(container);
    }

    // 1. Re-bind sorting and searching on the table
    makeTableSortable('pclTable');
    makeTableSearchable('pclSearch', 'pclTable');

    // 2. Re-bind search utility for detail items
    makeListSearchable('detailSubslsSearch', 'detailSubslsList', '.detail-item');
    initPclHistoryChart();

    // 3. Filter form submits (updates smoothly via PJAX without full page reload or sidebar shift)
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
      filterForm.addEventListener('submit', (e) => {
        e.preventDefault();
        window.submitPclFilter();
      });
      
      const resetBtn = filterForm.closest('.card')?.querySelector('a[href*="/pcl"]');
      if (resetBtn) {
        resetBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (typeof window.loadPage === 'function') {
            window.loadPage('<%= navPrefix %>/pcl');
          } else {
            window.location.href = '<%= navPrefix %>/pcl';
          }
        });
      }
    }

    // 4. AJAX Drilldown logic for PCL (updates only the detail segment with Caching & Loading Spinner)
    const detailContainer = document.getElementById('pclDetailContainer');
    const table = document.getElementById('pclTable');

    function renderDetail(html, url) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const newDetail = doc.getElementById('pclDetailContainer');
      if (newDetail) {
        detailContainer.innerHTML = newDetail.innerHTML;
        detailContainer.style.opacity = '1';
        detailContainer.classList.remove('smooth-detail-animate');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            detailContainer.classList.add('smooth-detail-animate');
          });
        });

        // Toggle grid selection classes
        const grid = document.querySelector('.drilldown-grid');
        if (grid) {
          grid.classList.remove('no-selection');
          grid.classList.add('has-selection');
        }

        // Update URL path without refresh
        window.history.pushState(null, '', url);

        // Re-bind list search utility
        makeListSearchable('detailSubslsSearch', 'detailSubslsList', '.detail-item');

        // Re-bind close handler
        bindCloseDetail();
        if (window.initProgressBars) window.initProgressBars(detailContainer);
        initPclHistoryChart();
      }
    }

    function bindCloseDetail() {
      if (!detailContainer) return;
      const closeBtn = detailContainer.querySelector('a[href*="/pcl"]');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const url = closeBtn.getAttribute('href');

          // Reset active rows (optimized)
          if (table) {
            const activeRow = table.querySelector('tbody tr.active');
            if (activeRow) {
              activeRow.classList.remove('active');
              activeRow.style.background = '';
              activeRow.style.fontWeight = '';
            }
          }

          if (window.detailHtmlCache && window.detailHtmlCache[url]) {
            renderDetail(window.detailHtmlCache[url], url);
            const grid = document.querySelector('.drilldown-grid');
            if (grid) {
              grid.classList.remove('has-selection');
              grid.classList.add('no-selection');
            }
          } else {
            detailContainer.innerHTML = `
              <div class="card skeleton-card" style="border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); padding: 20px; position: sticky; top: 80px; display: flex; flex-direction: column; gap: 16px; min-height: 350px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <div class="skeleton-block" style="height: 18px; width: 60%; border-radius: 6px;"></div>
                  <div class="skeleton-block" style="height: 20px; width: 20px; border-radius: 50%;"></div>
                </div>
                <div class="skeleton-block" style="height: 12px; width: 40%; border-radius: 4px; margin-top: -4px;"></div>
                
                <div style="border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-top: 10px; display: flex; flex-direction: column; gap: 10px;">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div class="skeleton-block" style="height: 12px; width: 50%; border-radius: 4px;"></div>
                    <div class="skeleton-block" style="height: 12px; width: 25%; border-radius: 4px;"></div>
                  </div>
                  <div class="skeleton-block" style="height: 8px; width: 100%; border-radius: 99px;"></div>
                  
                  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-top: 4px;">
                    <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                    <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                    <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                    <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                  </div>
                </div>

                <div style="border: 1px solid var(--border); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div class="skeleton-block" style="height: 12px; width: 40%; border-radius: 4px;"></div>
                    <div class="skeleton-block" style="height: 12px; width: 20%; border-radius: 4px;"></div>
                  </div>
                  <div class="skeleton-block" style="height: 8px; width: 100%; border-radius: 99px;"></div>
                </div>

                <div style="border-top: 1px solid var(--border); padding-top: 16px; display: flex; flex-direction: column; gap: 10px;">
                  <div class="skeleton-block" style="height: 12px; width: 50%; border-radius: 4px;"></div>
                  <div class="skeleton-block" style="height: 120px; width: 100%; border-radius: 8px;"></div>
                </div>
              </div>
            `;
            detailContainer.style.opacity = '1';

            fetch(url)
              .then(res => res.text())
              .then(html => {
                if (!window.detailHtmlCache) window.detailHtmlCache = {};
                window.detailHtmlCache[url] = html;
                renderDetail(html, url);
                const grid = document.querySelector('.drilldown-grid');
                if (grid) {
                  grid.classList.remove('has-selection');
                  grid.classList.add('no-selection');
                }
              })
              .catch(err => {
                console.error(err);
                detailContainer.style.opacity = '1';
              });
          }
        });
      }
    }

    if (table && detailContainer) {
      table.querySelector('tbody').addEventListener('click', (e) => {
        const link = e.target.closest('td.td-primary a');
        if (!link) return;

        e.preventDefault();
        const url = link.getAttribute('href');
        const row = link.closest('tr');

        // Update active row visual indicator (optimized)
        const activeRow = table.querySelector('tbody tr.active');
        if (activeRow) {
          activeRow.classList.remove('active');
          activeRow.style.background = '';
          activeRow.style.fontWeight = '';
        }
        row.classList.add('active');
        row.style.background = 'var(--bg-card-hover)';
        row.style.fontWeight = '500';

        if (window.detailHtmlCache && window.detailHtmlCache[url]) {
          renderDetail(window.detailHtmlCache[url], url);
        } else {
          // Loading spinner animation card
          detailContainer.innerHTML = `
            <div class="card skeleton-card" style="border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); padding: 20px; position: sticky; top: 80px; display: flex; flex-direction: column; gap: 16px; min-height: 350px;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <div class="skeleton-block" style="height: 18px; width: 60%; border-radius: 6px;"></div>
                <div class="skeleton-block" style="height: 20px; width: 20px; border-radius: 50%;"></div>
              </div>
              <div class="skeleton-block" style="height: 12px; width: 40%; border-radius: 4px; margin-top: -4px;"></div>
              
              <div style="border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-top: 10px; display: flex; flex-direction: column; gap: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <div class="skeleton-block" style="height: 12px; width: 50%; border-radius: 4px;"></div>
                  <div class="skeleton-block" style="height: 12px; width: 25%; border-radius: 4px;"></div>
                </div>
                <div class="skeleton-block" style="height: 8px; width: 100%; border-radius: 99px;"></div>
                
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-top: 4px;">
                  <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                  <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                  <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                  <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                </div>
              </div>

              <div style="border: 1px solid var(--border); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <div class="skeleton-block" style="height: 12px; width: 40%; border-radius: 4px;"></div>
                  <div class="skeleton-block" style="height: 12px; width: 20%; border-radius: 4px;"></div>
                </div>
                <div class="skeleton-block" style="height: 8px; width: 100%; border-radius: 99px;"></div>
              </div>

              <div style="border-top: 1px solid var(--border); padding-top: 16px; display: flex; flex-direction: column; gap: 10px;">
                <div class="skeleton-block" style="height: 12px; width: 50%; border-radius: 4px;"></div>
                <div class="skeleton-block" style="height: 120px; width: 100%; border-radius: 8px;"></div>
              </div>
            </div>
          `;
          detailContainer.style.opacity = '1';

          fetch(url)
            .then(res => res.text())
            .then(html => {
              if (!window.detailHtmlCache) window.detailHtmlCache = {};
              window.detailHtmlCache[url] = html;
              renderDetail(html, url);
            })
            .catch(err => {
              console.error(err);
              detailContainer.style.opacity = '1';
            });
        }
      });
    }

    bindCloseDetail();
  }

  window.submitPclFilter = function() {
    const filterForm = document.getElementById('filterForm');
    if (!filterForm) return;
    const formData = new FormData(filterForm);
    const params = new URLSearchParams();
    for (const [k, v] of formData.entries()) {
      if (v) params.append(k, v);
    }
    const targetUrl = '<%= navPrefix %>/pcl' + (params.toString() ? '?' + params.toString() : '');
    if (typeof window.loadPage === 'function') {
      window.loadPage(targetUrl);
    } else {
      filterForm.submit();
    }
  };

  function fetchAndReplace(queryString) {
    if (window.detailHtmlCache) {
      for (let key in window.detailHtmlCache) delete window.detailHtmlCache[key];
    }
    const url = '<%= navPrefix %>/pcl' + (queryString ? (queryString.startsWith('?') ? queryString : '?' + queryString) : '');
    if (typeof window.loadPage === 'function') {
      window.loadPage(url);
    } else {
      window.location.href = url;
    }
  }

  attachListeners();
});
</script>
