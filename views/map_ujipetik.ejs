      </div>
      <button type="button" class="gmaps-icon-btn" id="btnCollapseDrawer" onclick="toggleDrawerCollapse(event)" title="Buka / Tutup Panel">
        <i class="bi bi-chevron-up" id="drawerCollapseIcon"></i>
      </button>
    </div>

    <!-- Drawer Content: Detail Info -->
    <div class="gmaps-drawer-content" id="drawerContentInfo">
      <div id="drawerPlaceholder" style="text-align: center; color: var(--text-muted); padding: 24px 10px;">
        <i class="bi bi-pin-map" style="font-size: 28px; color: var(--accent-cyan); display: block; margin-bottom: 8px;"></i>
        <strong style="font-size: 13px; color: var(--text-primary); display: block;">Pilih Titik atau Wilayah</strong>
        <span style="font-size: 11.5px;">Klik salah satu titik bangunan atau polygon desa untuk melihat rincian uji petik lengkap.</span>
      </div>
      <div id="drawerDetailsBody" style="display: none;"></div>
    </div>

    <!-- Drawer Content: Legenda -->
    <div class="gmaps-drawer-content" id="drawerContentLegend" style="display: none;">
      <div style="font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">
        <i class="bi bi-palette-fill" style="color: var(--accent-cyan);"></i> Klasifikasi Bangunan Fisik
      </div>
      <div class="category-legend-chip" onclick="filterByCategoryCode(1)">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="category-color-dot" style="background: #f59e0b;"></span>
          <span>1. Bangunan Khusus Usaha</span>
        </div>
        <strong id="legendCountUsaha">0</strong>
      </div>
      <div class="category-legend-chip" onclick="filterByCategoryCode(2)">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="category-color-dot" style="background: #8b5cf6;"></span>
          <span>2. Bangunan Campuran</span>
        </div>
        <strong id="legendCountCampuran">0</strong>
      </div>
      <div class="category-legend-chip" onclick="filterByCategoryCode(3)">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="category-color-dot" style="background: #0284c7;"></span>
          <span>3. Bangunan Tempat Tinggal</span>
        </div>
        <strong id="legendCountTinggal">0</strong>
      </div>
      <div class="category-legend-chip" onclick="filterByCategoryCode(4)">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="category-color-dot" style="background: #10b981;"></span>
          <span>4. Tempat Ibadah &amp; Organisasi</span>
        </div>
        <strong id="legendCountIbadah">0</strong>
      </div>
      <div class="category-legend-chip" onclick="filterByCategoryCode(5)">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="category-color-dot" style="background: #3b82f6;"></span>
          <span>5. Kantor Pemerintah / Dinas</span>
        </div>
        <strong id="legendCountPemerintah">0</strong>
      </div>
      <div class="category-legend-chip" onclick="filterByCategoryCode(6)">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="category-color-dot" style="background: #64748b;"></span>
          <span>6. Bangunan Lainnya / Kosong / Rusak</span>
        </div>
        <strong id="legendCountLainnya">0</strong>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initUjiPetikMapPage() {
      if (typeof L === 'undefined') {
        setTimeout(initUjiPetikMapPage, 50);
        return;
      }

      const mapContainerEl = document.getElementById('map');
      if (!mapContainerEl) return;

      // Clean previous map instance
      if (window._leafletUjiPetikMapInstance) {
        try { window._leafletUjiPetikMapInstance.remove(); } catch (_) {}
        window._leafletUjiPetikMapInstance = null;
      }

      const centerCoords = [-1.30, 116.65];
      const defaultZoom = 10;

      if (mapContainerEl._leaflet_id) {
        mapContainerEl._leaflet_id = null;
      }
      mapContainerEl.innerHTML = '';

      const map = L.map('map', {
        zoomControl: false,
        maxZoom: 19,
        minZoom: 9
      }).setView(centerCoords, defaultZoom);
      window._leafletUjiPetikMapInstance = map;

      L.control.zoom({ position: 'bottomright' }).addTo(map);

      // Basemap layers
      const osmBasemap = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19
      });

      const satelliteBasemap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community',
        maxZoom: 19
      });

      const satelliteLabels = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19
      });

      let currentBasemapType = 'satellite';

      function updateBasemap() {
        let targetLayer = null;

        if (currentBasemapType === 'satellite') {
          targetLayer = satelliteBasemap;
          if (!map.hasLayer(satelliteLabels)) satelliteLabels.addTo(map);
          if (map.hasLayer(osmBasemap)) map.removeLayer(osmBasemap);
        } else {
          if (map.hasLayer(satelliteLabels)) map.removeLayer(satelliteLabels);
          if (map.hasLayer(satelliteBasemap)) map.removeLayer(satelliteBasemap);
          targetLayer = osmBasemap;
        }

        if (!map.hasLayer(targetLayer)) targetLayer.addTo(map);
        targetLayer.bringToBack();
      }
      updateBasemap();

      window.addEventListener('themechange', updateBasemap);

      // Basemap buttons
      const btnBasemapDefault = document.getElementById('btnBasemapDefault');
      const btnBasemapSatellite = document.getElementById('btnBasemapSatellite');

      if (btnBasemapDefault && btnBasemapSatellite) {
        btnBasemapDefault.addEventListener('click', () => {
          btnBasemapSatellite.classList.remove('active');
          btnBasemapDefault.classList.add('active');
          currentBasemapType = 'default';
          updateBasemap();
        });
        btnBasemapSatellite.addEventListener('click', () => {
          btnBasemapDefault.classList.remove('active');
          btnBasemapSatellite.classList.add('active');
          currentBasemapType = 'satellite';
          updateBasemap();
        });
      }

      // Invalidate map size
      const invalidateSize = () => {
        try { if (map) map.invalidateSize(); } catch (_) {}
      };
      [50, 150, 300, 600].forEach(d => setTimeout(invalidateSize, d));
      window.addEventListener('resize', invalidateSize);

      // Data holders
      let allPoints = [];
      let filteredPoints = [];
      let summaryStats = null;
      let desaGeoJson = null;
      let kecGeoJson = null;
      let desaLayer = null;
      let kecLayer = null;

      // Color mapping
      const categoryColors = {
        1: '#f59e0b', // Usaha
        2: '#8b5cf6', // Campuran
        3: '#0284c7', // Tempat Tinggal
        4: '#10b981', // Ibadah / Organisasi
        5: '#3b82f6', // Pemerintah / Dinas
        6: '#64748b', // Bangunan Kosong / Rusak / Lainnya
        8: '#a855f7', // Panti / Lapas
        9: '#ef4444', // Non Respon
        0: '#94a3b8'  // Lainnya
      };

      const categoryLabels = {
        1: '1. Bangunan Khusus Usaha',
        2: '2. Bangunan Campuran',
        3: '3. Bangunan Tempat Tinggal',
        4: '4. Tempat Ibadah & Organisasi',
        5: '5. Kantor Pemerintah / Dinas',
        6: '6. Bangunan Kosong / Rusak / Lainnya',
        8: '8. Panti / Lapas / Barak',
        9: '9. Non Respon',
        0: 'Lainnya'
      };

      // ── ULTRA-FAST HARDWARE-ACCELERATED HTML5 CANVAS LAYER ─────────
      // Dedicated Leaflet Pane (z-index 450): Guaranteed strictly BELOW popups (z-index 1100) and markers
      map.createPane('ujipetikPointsPane');
      const pointsPane = map.getPane('ujipetikPointsPane');
      pointsPane.style.zIndex = '450';
      pointsPane.style.pointerEvents = 'none';

      const canvas = document.createElement('canvas');
      canvas.className = 'ujipetik-canvas-layer';
      pointsPane.appendChild(canvas);
      const ctx = canvas.getContext('2d', { alpha: true });

      // Floating Tooltip for Hover Visual Cue
      const hoverTooltipEl = document.createElement('div');
      hoverTooltipEl.id = 'mapPointHoverTooltip';
      hoverTooltipEl.className = 'map-point-hover-tooltip';
      hoverTooltipEl.style.display = 'none';
      map.getContainer().appendChild(hoverTooltipEl);

      const CLUSTER_ZOOM_THRESHOLD = 14; // Zoom < 14: Macro Clusters, Zoom >= 14: Direct Clean Individual Building Points
      let cachedClusters = [];
      let cachedClusterZoom = -1;
      let cachedClusterPointsRef = null;
      let currentClusters = [];
      let hoveredPoint = null;
      let hoveredCluster = null;

      // Fixed World-Projection Geographical Grid Clustering (Zero movement/jumping during pan)
      function getClustersForCurrentView(pts, zoom) {
        if (!pts || pts.length === 0) {
          cachedClusters = [];
          cachedClusterZoom = -1;
          cachedClusterPointsRef = null;
          return [];
        }

        const intZoom = Math.round(zoom);
        // Only recompute when points array or integer zoom changes
        if (cachedClusterZoom === intZoom && cachedClusterPointsRef === pts && cachedClusters.length > 0) {
          return cachedClusters;
        }

        cachedClusterZoom = intZoom;
        cachedClusterPointsRef = pts;

        let gridSize = 75;
        if (intZoom <= 10) gridSize = 110;
        else if (intZoom <= 12) gridSize = 90;
        else if (intZoom === 13) gridSize = 75;

        const cells = {};

        for (let i = 0; i < pts.length; i++) {
          const p = pts[i];
          const lat = p[1];
          const lng = p[2];
          // Pure world Mercator projection: 100% stable regardless of map pan position
          const worldPt = map.project([lat, lng], intZoom);
          const gx = Math.floor(worldPt.x / gridSize);
          const gy = Math.floor(worldPt.y / gridSize);
          const key = gx + '_' + gy;

          if (!cells[key]) {
            cells[key] = {
              points: [],
              sumLat: 0,
              sumLng: 0,
              catCounts: {}
            };
          }
          cells[key].points.push(p);
          cells[key].sumLat += lat;
          cells[key].sumLng += lng;
          const cat = p[3] || 0;
          cells[key].catCounts[cat] = (cells[key].catCounts[cat] || 0) + 1;
        }

        const clusters = [];
        for (const k in cells) {
          const c = cells[k];
          const count = c.points.length;
          const avgLat = c.sumLat / count;
          const avgLng = c.sumLng / count;

          // Dominant category in cluster
          let maxCat = 0;
          let maxCatCount = -1;
          for (const cat in c.catCounts) {
            if (c.catCounts[cat] > maxCatCount) {
              maxCatCount = c.catCounts[cat];
              maxCat = cat;
            }
          }

          clusters.push({
            lat: avgLat,
            lng: avgLng,
            latLng: L.latLng(avgLat, avgLng),
            count: count,
            points: c.points,
            dominantCat: maxCat,
            dominantColor: categoryColors[maxCat] || '#0284c7'
          });
        }

        cachedClusters = clusters;
        return clusters;
      }

      function drawClusterBubble(c, cx, cy, isHovered) {
        const count = c.count;

        let r = 14;
        if (count >= 500) r = 24;
        else if (count >= 100) r = 20;
        else if (count >= 30) r = 17;
        else if (count >= 10) r = 15;

        if (isHovered) r += 3;

        const baseColor = c.dominantColor || '#0284c7';

        // Outer glow halo
        ctx.beginPath();
        ctx.arc(cx, cy, r + 5, 0, Math.PI * 2);
        ctx.fillStyle = isHovered ? 'rgba(255, 255, 255, 0.40)' : 'rgba(2, 132, 199, 0.22)';
        ctx.fill();

        // Main solid circle with dominant category color
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.fillStyle = baseColor;
        ctx.fill();
        ctx.lineWidth = isHovered ? 2.5 : 1.8;
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();

        // Count Text
        ctx.fillStyle = '#ffffff';
        ctx.font = `700 ${r >= 20 ? 11.5 : (r >= 15 ? 10.5 : 9.5)}px 'Inter', sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        let displayCount = count.toString();
        if (count >= 1000) {
          displayCount = (count / 1000).toFixed(1).replace('.0', '') + 'K';
        }
        ctx.fillText(displayCount, cx, cy);
      }

      function renderCanvas() {
        if (!map || !filteredPoints) return;
        const size = map.getSize();
        if (size.x === 0 || size.y === 0) return;

        const dpr = window.devicePixelRatio || 1;
        const w = size.x;
        const h = size.y;

        if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
          canvas.style.width = w + 'px';
          canvas.style.height = h + 'px';
        }

        const topLeft = map.containerPointToLayerPoint([0, 0]);
        L.DomUtil.setPosition(canvas, topLeft);

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, w, h);

        const zoom = map.getZoom();

        if (zoom < CLUSTER_ZOOM_THRESHOLD) {
          // ── MACRO CLUSTER MODE (Clean, Grouped & 100% Pan-Stable) ──
          currentClusters = getClustersForCurrentView(filteredPoints, zoom);

          for (let i = 0; i < currentClusters.length; i++) {
            const c = currentClusters[i];
            const pt = map.latLngToContainerPoint(c.latLng);
            if (pt.x < -35 || pt.x > w + 35 || pt.y < -35 || pt.y > h + 35) continue;
            const isHovered = hoveredCluster === c;

            if (c.count === 1) {
              const p = c.points[0];
              const cat = p[3] || 0;
              const col = categoryColors[cat] || '#94a3b8';
              ctx.beginPath();
              ctx.arc(pt.x, pt.y, isHovered ? 6 : 4, 0, Math.PI * 2);
              ctx.fillStyle = col;
              ctx.fill();
              ctx.lineWidth = 1.5;
              ctx.strokeStyle = '#ffffff';
              ctx.stroke();
            } else {
              drawClusterBubble(c, pt.x, pt.y, isHovered);
            }
          }
        } else {
          // ── INDIVIDUAL BUILDING POINTS MODE (Clean & Direct) ──
          currentClusters = [];
          let radius = 3.5;
          if (zoom >= 17) radius = 6.0;
          else if (zoom >= 16) radius = 5.0;
          else if (zoom >= 15) radius = 4.2;
          else if (zoom >= 14) radius = 3.4;

          const twoPi = Math.PI * 2;
          const len = filteredPoints.length;
          const buckets = { 1: [], 2: [], 3: [], 4: [], 5: [], 6: [], 8: [], 9: [], 0: [] };

          for (let i = 0; i < len; i++) {
            const p = filteredPoints[i];
            const pt = map.latLngToContainerPoint([p[1], p[2]]);
            if (pt.x < -15 || pt.x > w + 15 || pt.y < -15 || pt.y > h + 15) continue;

            const cat = p[3] || 0;
            if (!buckets[cat]) buckets[cat] = [];
            buckets[cat].push(pt.x, pt.y);
          }

          for (const cat in buckets) {
            const coords = buckets[cat];
            if (!coords || coords.length === 0) continue;

            ctx.fillStyle = categoryColors[cat] || '#94a3b8';
            ctx.beginPath();
            const clen = coords.length;
            for (let j = 0; j < clen; j += 2) {
              const cx = coords[j];
              const cy = coords[j + 1];
              ctx.moveTo(cx + radius, cy);
              ctx.arc(cx, cy, radius, 0, twoPi);
            }
            ctx.fill();
          }

          if (hoveredPoint) {
            const hpt = map.latLngToContainerPoint([hoveredPoint[1], hoveredPoint[2]]);
            if (hpt.x >= -20 && hpt.x <= w + 20 && hpt.y >= -20 && hpt.y <= h + 20) {
              const hCat = hoveredPoint[3] || 0;
              const hColor = categoryColors[hCat] || '#0284c7';
              const hRad = radius + 3;

              ctx.beginPath();
              ctx.arc(hpt.x, hpt.y, hRad + 5, 0, twoPi);
              ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
              ctx.fill();

              ctx.beginPath();
              ctx.arc(hpt.x, hpt.y, hRad + 2, 0, twoPi);
              ctx.lineWidth = 2.5;
              ctx.strokeStyle = '#ffffff';
              ctx.stroke();

              ctx.beginPath();
              ctx.arc(hpt.x, hpt.y, hRad, 0, twoPi);
              ctx.fillStyle = hColor;
              ctx.fill();
            }
          }
        }

        ctx.restore();
      }

      // Continuous Real-Time Animation Rendering during Zoom
      function onZoomAnim(e) {
        if (!map || !filteredPoints || filteredPoints.length === 0) return;
        const size = map.getSize();
        const dpr = window.devicePixelRatio || 1;
        const w = size.x;
        const h = size.y;

        const newTopLeft = map._latLngToNewLayerPoint(map.containerPointToLatLng([0, 0]), e.zoom, e.center);
        L.DomUtil.setPosition(canvas, newTopLeft);

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, w, h);

        const zoom = e.zoom;
        if (zoom < CLUSTER_ZOOM_THRESHOLD) {
          const clusters = getClustersForCurrentView(filteredPoints, zoom);
          for (let i = 0; i < clusters.length; i++) {
            const c = clusters[i];
            const layerPt = map._latLngToNewLayerPoint(c.latLng, e.zoom, e.center);
            const containerPt = map.layerPointToContainerPoint(layerPt);
            if (containerPt.x < -35 || containerPt.x > w + 35 || containerPt.y < -35 || containerPt.y > h + 35) continue;
            if (c.count === 1) {
              const p = c.points[0];
              const cat = p[3] || 0;
              const col = categoryColors[cat] || '#94a3b8';
              ctx.beginPath();
              ctx.arc(containerPt.x, containerPt.y, 4, 0, Math.PI * 2);
              ctx.fillStyle = col;
              ctx.fill();
              ctx.lineWidth = 1.5;
              ctx.strokeStyle = '#ffffff';
              ctx.stroke();
            } else {
              drawClusterBubble(c, containerPt.x, containerPt.y, false);
            }
          }
        } else {
          let radius = 3.5;
          if (zoom >= 17) radius = 6.0;
          else if (zoom >= 16) radius = 5.0;
          else if (zoom >= 15) radius = 4.2;
          else if (zoom >= 14) radius = 3.4;

          const twoPi = Math.PI * 2;
          const len = filteredPoints.length;
          const buckets = { 1: [], 2: [], 3: [], 4: [], 5: [], 6: [], 8: [], 9: [], 0: [] };

          for (let i = 0; i < len; i++) {
            const p = filteredPoints[i];
            const latLng = L.latLng(p[1], p[2]);
            const layerPt = map._latLngToNewLayerPoint(latLng, e.zoom, e.center);
            const containerPt = map.layerPointToContainerPoint(layerPt);
            if (containerPt.x < -15 || containerPt.x > w + 15 || containerPt.y < -15 || containerPt.y > h + 15) continue;

            const cat = p[3] || 0;
            if (!buckets[cat]) buckets[cat] = [];
            buckets[cat].push(containerPt.x, containerPt.y);
          }

          for (const cat in buckets) {
            const coords = buckets[cat];
            if (!coords || coords.length === 0) continue;

            ctx.fillStyle = categoryColors[cat] || '#94a3b8';
            ctx.beginPath();
            const clen = coords.length;
            for (let j = 0; j < clen; j += 2) {
              const cx = coords[j];
              const cy = coords[j + 1];
              ctx.moveTo(cx + radius, cy);
              ctx.arc(cx, cy, radius, 0, twoPi);
            }
            ctx.fill();
          }
        }

        ctx.restore();
      }

      map.on('move viewreset resize zoom', renderCanvas);
      map.on('zoomanim', onZoomAnim);

      // Smart Click Detection: Click on Cluster = Smooth Fly-To Zoom, Click on Point = Details Drawer
      map.on('click', (e) => {
        if (!filteredPoints || filteredPoints.length === 0) return;
        const clickPt = e.containerPoint;
        const zoom = map.getZoom();

        if (zoom < CLUSTER_ZOOM_THRESHOLD) {
          let clickedCluster = null;
          let minClusterDistSq = Infinity;

          for (let i = 0; i < currentClusters.length; i++) {
            const c = currentClusters[i];
            const pt = map.latLngToContainerPoint(c.latLng);
            const dx = pt.x - clickPt.x;
            const dy = pt.y - clickPt.y;
            const distSq = dx * dx + dy * dy;
            let hitR = c.count >= 100 ? 26 : (c.count >= 30 ? 22 : 18);
            if (distSq <= hitR * hitR && distSq < minClusterDistSq) {
              minClusterDistSq = distSq;
              clickedCluster = c;
            }
          }

          if (clickedCluster) {
            if (clickedCluster.count === 1) {
              showPointDetails(clickedCluster.points[0]);
            } else {
              const bounds = L.latLngBounds(clickedCluster.points.map(p => [p[1], p[2]]));
              if (bounds.isValid() && bounds.getNorthEast().distanceTo(bounds.getSouthWest()) > 10) {
                map.flyToBounds(bounds, { maxZoom: 18, padding: [60, 60], duration: 0.8 });
              } else {
                map.flyTo([clickedCluster.points[0][1], clickedCluster.points[0][2]], Math.min(zoom + 3, 18), { duration: 0.8 });
              }
            }
            return;
          }
        } else {
          // Individual Point Click Detection
          const clickRadius = zoom >= 16 ? 24 : (zoom >= 14 ? 18 : 14);
          const clickRadiusSq = clickRadius * clickRadius;

          let closest = null;
          let minDistSq = clickRadiusSq;

          for (let i = 0; i < filteredPoints.length; i++) {
            const p = filteredPoints[i];
            const pt = map.latLngToContainerPoint([p[1], p[2]]);
            const dx = pt.x - clickPt.x;
            const dy = pt.y - clickPt.y;
            const distSq = dx * dx + dy * dy;
            if (distSq <= minDistSq) {
              minDistSq = distSq;
              closest = p;
            }
          }

          if (closest) {
            showPointDetails(closest);
          }
        }
      });

      // Interactive Hover Visual Cue & Instant Floating Tooltip
      let hoverTimer = null;
      map.on('mousemove', (e) => {
        if (hoverTimer) return;
        hoverTimer = setTimeout(() => {
          hoverTimer = null;
          if (!filteredPoints || filteredPoints.length === 0) {
            if (hoveredPoint || hoveredCluster) {
              hoveredPoint = null;
              hoveredCluster = null;
              hoverTooltipEl.style.display = 'none';
              map.getContainer().style.cursor = '';
              renderCanvas();
            }
            return;
          }

          const mousePt = e.containerPoint;
          const zoom = map.getZoom();

          if (zoom < CLUSTER_ZOOM_THRESHOLD) {
            let closestCluster = null;
            let minClusterDistSq = Infinity;

            for (let i = 0; i < currentClusters.length; i++) {
              const c = currentClusters[i];
              const pt = map.latLngToContainerPoint(c.latLng);
              const dx = pt.x - mousePt.x;
              const dy = pt.y - mousePt.y;
              const distSq = dx * dx + dy * dy;
              let hitR = c.count >= 100 ? 24 : (c.count >= 30 ? 20 : 16);
              if (distSq <= hitR * hitR && distSq < minClusterDistSq) {
                minClusterDistSq = distSq;
                closestCluster = c;
              }
            }

            if (closestCluster !== hoveredCluster) {
              hoveredCluster = closestCluster;
              renderCanvas();
            }

            if (hoveredCluster) {
              map.getContainer().style.cursor = 'pointer';
              if (hoveredCluster.count === 1) {
                const p = hoveredCluster.points[0];
                const catCode = p[3] || 0;
                const catName = categoryLabels[catCode] || 'Lainnya';
                const color = categoryColors[catCode] || '#94a3b8';
                const noBang = p[6] ? `No. ${p[6]}` : 'Bangunan';
                const label = p[5] || '';
                hoverTooltipEl.innerHTML = `
                  <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: ${color}; margin-right: 6px; flex-shrink: 0;"></span>
                  <strong>${noBang}</strong> ${label ? '&bull; ' + label : ''} <span style="opacity: 0.8; font-size: 10px; margin-left: 4px;">(${catName})</span>
                `;
              } else {
                hoverTooltipEl.innerHTML = `
                  <i class="bi bi-grid-fill text-cyan" style="margin-right: 6px;"></i>
                  <strong>${hoveredCluster.count.toLocaleString('id-ID')} Titik Uji Petik</strong>
                  <span style="opacity: 0.8; font-size: 10px; margin-left: 6px;">(Klik untuk perbesar wilayah)</span>
                `;
              }
              hoverTooltipEl.style.display = 'flex';
              hoverTooltipEl.style.left = (mousePt.x + 14) + 'px';
              hoverTooltipEl.style.top = (mousePt.y - 12) + 'px';
            } else {
              map.getContainer().style.cursor = '';
              hoverTooltipEl.style.display = 'none';
            }
          } else {
            // Individual points hover testing
            const hoverRadius = zoom >= 16 ? 22 : (zoom >= 14 ? 16 : 12);
            const hoverRadiusSq = hoverRadius * hoverRadius;

            let closest = null;
            let minDistSq = hoverRadiusSq;

            for (let i = 0; i < filteredPoints.length; i++) {
              const p = filteredPoints[i];
              const pt = map.latLngToContainerPoint([p[1], p[2]]);
              const dx = pt.x - mousePt.x;
              const dy = pt.y - mousePt.y;
              const distSq = dx * dx + dy * dy;
              if (distSq <= minDistSq) {
                minDistSq = distSq;
                closest = p;
              }
            }

            if (closest !== hoveredPoint) {
              hoveredPoint = closest;
              renderCanvas();
            }

            if (hoveredPoint) {
              map.getContainer().style.cursor = 'pointer';
              const catCode = hoveredPoint[3] || 0;
              const catName = categoryLabels[catCode] || 'Lainnya';
              const color = categoryColors[catCode] || '#94a3b8';
              const noBang = hoveredPoint[6] ? `No. ${hoveredPoint[6]}` : 'Bangunan';
              const label = hoveredPoint[5] || '';

              hoverTooltipEl.innerHTML = `
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: ${color}; margin-right: 6px; flex-shrink: 0;"></span>
                <strong>${noBang}</strong> ${label ? '&bull; ' + label : ''} <span style="opacity: 0.8; font-size: 10px; margin-left: 4px;">(${catName})</span>
              `;
              hoverTooltipEl.style.display = 'flex';
              hoverTooltipEl.style.left = (mousePt.x + 14) + 'px';
              hoverTooltipEl.style.top = (mousePt.y - 12) + 'px';
            } else {
              map.getContainer().style.cursor = '';
              hoverTooltipEl.style.display = 'none';
            }
          }
        }, 16);
      });

      map.on('mouseout', () => {
        if (hoveredPoint || hoveredCluster) {
          hoveredPoint = null;
          hoveredCluster = null;
          hoverTooltipEl.style.display = 'none';
          map.getContainer().style.cursor = '';
          renderCanvas();
        }
      });

      // Show Point Details in Drawer & Popup
      function showPointDetails(p) {
