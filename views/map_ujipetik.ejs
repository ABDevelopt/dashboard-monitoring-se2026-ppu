            setVal('legendCountPanti', panti);
            setVal('legendCountNonRespon', nonRespon);
            setVal('legendCountMisc', lainnya);
          }

          // Handle Empty Database State
          if (!summaryStats || summaryStats.total === 0) {
            const placeholder = document.getElementById('drawerPlaceholder');
            if (placeholder) {
              placeholder.innerHTML = `
                <div style="padding: 10px 4px; text-align: center;">
                  <i class="bi bi-inbox" style="font-size: 32px; color: var(--accent-amber); display: block; margin-bottom: 8px;"></i>
                  <strong style="font-size: 14px; color: var(--text-primary); display: block; margin-bottom: 4px;">Belum Ada Data Titik Uji Petik</strong>
                  <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 14px; line-height: 1.5;">
                    Peta ini secara default kosong. Admin dapat mengunggah file data CSV/Excel Titik Uji Petik melalui halaman Upload Data.
                  </span>
                  <a href="/admin/upload?tab=ujipetik" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; font-weight: 600; text-decoration: none; border-radius: 8px; font-size: 12px;">
                    <i class="bi bi-upload"></i> Upload Data Titik Uji Petik
                  </a>
                </div>
              `;
            }
          }
          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => loading.style.display = 'none', 300);
          }

          // Check URL query parameters (e.g. ?desa=WARU or ?kec=BABULU)
          const urlParams = new URLSearchParams(window.location.search);
          const initialKec = urlParams.get('kec');
          const initialDesa = urlParams.get('desa');

          if (initialDesa) {
            selectScopeDesaDirect(initialDesa, initialKec || '');
          } else if (initialKec) {
            currentKec = initialKec;
            const kecSelect = document.getElementById('kecFilter');
            if (kecSelect) kecSelect.value = initialKec;
            populateDesaDropdown(initialKec);
            zoomToKecamatan(initialKec);
            updateScopeButtonLabel();
            ensureScopeDataLoaded(initialKec, '').then(() => {
              applyFilters();
            });
          } else {
            // Default: do NOT draw all points automatically (prevents initial lag)
            filteredPoints = [];
            renderCanvas();
            updateScopeButtonLabel();

            if (summaryStats && summaryStats.total > 0) {
              setTimeout(openScopeModal, 200);
            }
          }

          // Phase 2: Asynchronous Background Loading (IndexedDB / Gzip Points & SLS Boundaries)
          loadPointsInBackground();
          lazyLoadSlsGeoJSON();

        } catch (err) {
          console.error('Error bootstrapping Uji Petik Map:', err);
          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => loading.style.display = 'none', 300);
          }
        }
      }

      bootstrap();
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initUjiPetikMapPage();
    } else {
      document.addEventListener('DOMContentLoaded', initUjiPetikMapPage);
    }
  })();
</script>
