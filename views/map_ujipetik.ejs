      // Filter Logic
      let currentKec = '';
      let currentDesa = '';
      let currentPcl = '';
      let currentPml = '';
      let currentCatCode = '';
      let currentSearch = '';

      function applyFilters() {
        let scoped = allPoints || [];

        if (currentKec) {
          const kecUpper = currentKec.toUpperCase();
          scoped = scoped.filter(p => p[12] && p[12].toUpperCase() === kecUpper);
        }

        if (currentDesa) {
          const desaUpper = currentDesa.toUpperCase();
          scoped = scoped.filter(p => (p[11] && p[11].toUpperCase() === desaUpper) || (p[13] && p[13].startsWith(currentDesa)));
        }

        if (currentPcl) {
          const pclLower = currentPcl.toLowerCase().trim();
          scoped = scoped.filter(p => p[7] && p[7].toLowerCase().trim() === pclLower);
        }

        if (currentPml) {
          const pmlLower = currentPml.toLowerCase().trim();
          scoped = scoped.filter(p => p[8] && p[8].toLowerCase().trim() === pmlLower);
        }

        if (currentSearch) {
          const q = currentSearch.toLowerCase().trim();
          scoped = scoped.filter(p => {
            return (p[5] && p[5].toLowerCase().includes(q)) ||
                   (p[6] && p[6].toLowerCase().includes(q)) ||
                   (p[7] && p[7].toLowerCase().includes(q)) ||
                   (p[8] && p[8].toLowerCase().includes(q)) ||
                   (p[10] && p[10].toLowerCase().includes(q)) ||
                   (p[11] && p[11].toLowerCase().includes(q));
          });
        }

        // Update category counts on panel pills based on currently scoped region
        updateCategoryPillCounts(scoped);

        // Apply category filter to get final points to render
        let res = scoped;
        if (currentCatCode !== '') {
          if (currentCatCode === 'lainnya') {
            res = res.filter(p => [4, 5, 8, 9, 0].includes(p[3]));
          } else {
            const cCode = parseInt(currentCatCode, 10);
            res = res.filter(p => p[3] === cCode);
          }
        }

        filteredPoints = res;
        renderCanvas();
      }

      function updateCategoryPillCounts(pts) {
        const total = pts ? pts.length : 0;
        const usaha = pts ? pts.filter(p => p[3] === 1).length : 0;
        const campuran = pts ? pts.filter(p => p[3] === 2).length : 0;
        const tinggal = pts ? pts.filter(p => p[3] === 3).length : 0;
        const kosong = pts ? pts.filter(p => p[4] === 1 || p[3] === 6).length : 0;
        const lainnya = pts ? pts.filter(p => [4, 5, 8, 9, 0].includes(p[3])).length : 0;

        const elAll = document.getElementById('countCatAll');
        const elUsaha = document.getElementById('countCatUsaha');
        const elCampuran = document.getElementById('countCatCampuran');
        const elTinggal = document.getElementById('countCatTinggal');
        const elKosong = document.getElementById('countCatKosong');
        const elLainnya = document.getElementById('countCatLainnya');

        if (elAll) elAll.textContent = total.toLocaleString('id-ID');
        if (elUsaha) elUsaha.textContent = usaha.toLocaleString('id-ID');
        if (elCampuran) elCampuran.textContent = campuran.toLocaleString('id-ID');
        if (elTinggal) elTinggal.textContent = tinggal.toLocaleString('id-ID');
        if (elKosong) elKosong.textContent = kosong.toLocaleString('id-ID');
        if (elLainnya) elLainnya.textContent = lainnya.toLocaleString('id-ID');
      }

      // Scope Selector Modal Logic (Desa / Kelurahan Level)
      let modalActiveKec = '';
      let modalDesaSearchQuery = '';

      window.openScopeModal = function() {
        const modal = document.getElementById('ujipetikScopeModal');
        const searchInput = document.getElementById('modalDesaSearchInput');
        if (searchInput) searchInput.value = '';
        modalDesaSearchQuery = '';
        renderModalDesaGrid();
        if (modal) modal.style.display = 'flex';
      };

      window.closeScopeModal = function() {
        const modal = document.getElementById('ujipetikScopeModal');
        if (modal) modal.style.display = 'none';
      };

      function updateScopeButtonLabel() {
        const btnText = document.getElementById('currentScopeBtnText');
        if (!btnText) return;
        if (currentDesa) {
          btnText.textContent = `Desa: ${currentDesa}`;
        } else if (currentKec) {
          btnText.textContent = `Kec. ${currentKec}`;
        } else if (filteredPoints && filteredPoints.length === allPoints.length && allPoints.length > 0) {
          btnText.textContent = `Seluruh PPU (${Math.round(allPoints.length / 1000)}K)`;
        } else {
          btnText.textContent = 'Pilih Desa';
        }
      }

      function zoomToKecamatan(kecName) {
        let matchedBounds = null;
        if (kecLayer) {
          kecLayer.eachLayer(l => {
            if (l.feature && l.feature.properties) {
              const p = l.feature.properties;
              const name = (p.nmkec || p.kecamatan || p.WADMKC || p.nama || '').toUpperCase();
              if (name === kecName.toUpperCase() || name.includes(kecName.toUpperCase())) {
                if (l.getBounds) matchedBounds = l.getBounds();
              }
            }
          });
        }
        if (matchedBounds) {
          map.fitBounds(matchedBounds, { padding: [35, 35] });
        } else if (filteredPoints && filteredPoints.length > 0) {
          const lats = filteredPoints.map(p => p[1]);
          const lngs = filteredPoints.map(p => p[2]);
          const minLat = Math.min(...lats), maxLat = Math.max(...lats);
          const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);
          map.fitBounds([[minLat, minLng], [maxLat, maxLng]], { padding: [35, 35] });
        }
      }

      function zoomToDesa(desaName) {
        let matchedBounds = null;
        if (desaLayer) {
          desaLayer.eachLayer(l => {
            if (l.feature && l.feature.properties) {
              const p = l.feature.properties;
              const name = (p.nmdesa || p.desa || p.NAMOBJ || p.WADMKD || p.nama || '').toUpperCase();
              if (name === desaName.toUpperCase() || name.includes(desaName.toUpperCase())) {
                if (l.getBounds) matchedBounds = l.getBounds();
              }
            }
          });
        }
        if (matchedBounds) {
          map.fitBounds(matchedBounds, { padding: [35, 35] });
        } else if (filteredPoints && filteredPoints.length > 0) {
          const lats = filteredPoints.map(p => p[1]);
          const lngs = filteredPoints.map(p => p[2]);
          const minLat = Math.min(...lats), maxLat = Math.max(...lats);
          const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);
          map.fitBounds([[minLat, minLng], [maxLat, maxLng]], { padding: [35, 35] });
        }
      }

      window.filterModalDesaByKec = function(kecName, btnEl) {
        modalActiveKec = kecName;
        document.querySelectorAll('#modalKecTabs .modal-kec-tab').forEach(b => b.classList.remove('active'));
        if (btnEl) btnEl.classList.add('active');
        renderModalDesaGrid();
      };

      function renderModalDesaGrid() {
        const grid = document.getElementById('modalDesaGrid');
        if (!grid || !summaryStats || !summaryStats.desaStats) return;

        let desas = summaryStats.desaStats;
        if (modalActiveKec) {
          desas = desas.filter(d => d.kecamatan && d.kecamatan.toUpperCase() === modalActiveKec.toUpperCase());
        }
        if (modalDesaSearchQuery) {
          const q = modalDesaSearchQuery.toLowerCase().trim();
          desas = desas.filter(d => (d.desa && d.desa.toLowerCase().includes(q)) || (d.kecamatan && d.kecamatan.toLowerCase().includes(q)));
        }

        if (desas.length === 0) {
          grid.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 24px 10px; color: var(--text-muted);">
              <i class="bi bi-search" style="font-size: 20px; display: block; margin-bottom: 6px; opacity: 0.6;"></i>
              <span style="font-size: 12px;">Tidak ditemukan desa yang sesuai pencarian.</span>
            </div>
          `;
          return;
        }

        let html = '';
        desas.forEach(d => {
          const count = d.total_titik !== undefined ? d.total_titik : (d.count || 0);
          const safeDesa = (d.desa || '').replace(/'/g, "\\'");
          const safeKec = (d.kecamatan || '').replace(/'/g, "\\'");
          html += `
            <div class="modal-desa-card" onclick="selectScopeDesaDirect('${safeDesa}', '${safeKec}')">
              <div class="modal-desa-title">
                <i class="bi bi-geo-alt-fill text-cyan" style="font-size: 11px;"></i>
                <span>${d.desa}</span>
              </div>
              <div class="modal-desa-subtitle">Kec. ${d.kecamatan || '-'}</div>
              <div>
                <span class="modal-desa-count">${count.toLocaleString('id-ID')} Titik</span>
              </div>
            </div>
          `;
        });
        grid.innerHTML = html;
      }

      window.selectScopeDesaDirect = function(desaName, kecName) {
        currentDesa = desaName;
        if (!kecName && summaryStats && summaryStats.desaStats) {
          const match = summaryStats.desaStats.find(d => d.desa && d.desa.toUpperCase() === desaName.toUpperCase());
          if (match && match.kecamatan) kecName = match.kecamatan;
        }
        currentKec = kecName || '';

        const kecSelect = document.getElementById('kecFilter');
        const desaSelect = document.getElementById('desaFilter');

        if (kecSelect) {
          const targetKec = (currentKec || '').toUpperCase();
          let matched = false;
          for (let i = 0; i < kecSelect.options.length; i++) {
            if (kecSelect.options[i].value.toUpperCase() === targetKec) {
              kecSelect.selectedIndex = i;
              matched = true;
              break;
            }
          }
          if (!matched) kecSelect.value = '';
        }

        if (desaSelect) {
          populateDesaDropdown(currentKec || '');
          desaSelect.value = desaName;
        }

        populateOfficerDropdowns(currentKec, currentDesa, '');
        applyFilters();
        zoomToDesa(desaName);
        updateScopeButtonLabel();
        closeScopeModal();
      };

      window.selectAllPoints = function() {
        currentKec = '';
        currentDesa = '';
        currentPcl = '';
        currentPml = '';
        const kecSelect = document.getElementById('kecFilter');
        const desaSelect = document.getElementById('desaFilter');
        if (kecSelect) kecSelect.value = '';
        if (desaSelect) {
          populateDesaDropdown('');
          desaSelect.value = '';
        }
        populateOfficerDropdowns('', '', '');
        filteredPoints = allPoints || [];
        renderCanvas();
        updateCategoryPillCounts(filteredPoints);
        map.setView(centerCoords, defaultZoom);
        updateScopeButtonLabel();
        closeScopeModal();
      };

      // Populate Desa dropdown based on selected Kecamatan
      function populateDesaDropdown(kecName) {
        const desaSelect = document.getElementById('desaFilter');
        const modalDesaSelect = document.getElementById('modalDesaSelect');
        if (!summaryStats || !summaryStats.desaStats) return;

        let desas = summaryStats.desaStats;
        if (kecName) {
          desas = desas.filter(d => d.kecamatan && d.kecamatan.toUpperCase() === kecName.toUpperCase());
        }

        let html = '<option value="">-- Semua Desa / Kel --</option>';
        desas.forEach(d => {
          const countVal = d.total_titik !== undefined ? d.total_titik : (d.count || 0);
          const label = kecName ? `${d.desa} (${countVal.toLocaleString('id-ID')})` : `${d.desa} [${d.kecamatan}] (${countVal.toLocaleString('id-ID')})`;
          html += `<option value="${d.desa}">${label}</option>`;
        });
        if (desaSelect) desaSelect.innerHTML = html;

        if (modalDesaSelect) {
          let mHtml = '<option value="">-- Pilih Desa / Kelurahan --</option>';
          summaryStats.desaStats.forEach(d => {
            const countVal = d.total_titik !== undefined ? d.total_titik : (d.count || 0);
            mHtml += `<option value="${d.desa}">${d.desa} [Kec. ${d.kecamatan}] (${countVal.toLocaleString('id-ID')} titik)</option>`;
          });
          modalDesaSelect.innerHTML = mHtml;
        }
      }

      // Populate PCL & PML dropdowns with dynamic cascading scope filtering
      function populateOfficerDropdowns(scopedKec, scopedDesa, scopedPml) {
        const pclSelect = document.getElementById('pclFilter');
        const pmlSelect = document.getElementById('pmlFilter');
        if (!allPoints || allPoints.length === 0) return;

        let pts = allPoints;
        if (scopedKec) {
          const kUpper = scopedKec.toUpperCase();
          pts = pts.filter(p => p[12] && p[12].toUpperCase() === kUpper);
        }
        if (scopedDesa) {
          const dUpper = scopedDesa.toUpperCase();
          pts = pts.filter(p => (p[11] && p[11].toUpperCase() === dUpper) || (p[13] && p[13].startsWith(scopedDesa)));
        }

        // Extract unique PMLs in this area
        const pmlsInScope = new Set();
        pts.forEach(p => {
          if (p[8] && p[8].trim() !== '') pmlsInScope.add(p[8].trim());
        });
        const sortedPmls = Array.from(pmlsInScope).sort((a, b) => a.localeCompare(b));

        // If a specific PML is selected, narrow PCLs to that PML's points
        let pclPts = pts;
        if (scopedPml) {
          const pmlLower = scopedPml.toLowerCase().trim();
          pclPts = pclPts.filter(p => p[8] && p[8].toLowerCase().trim() === pmlLower);
        }

        // Extract unique PCLs in this area (and under this PML if selected)
        const pclsInScope = new Set();
        pclPts.forEach(p => {
          if (p[7] && p[7].trim() !== '') pclsInScope.add(p[7].trim());
        });
        const sortedPcls = Array.from(pclsInScope).sort((a, b) => a.localeCompare(b));

        // Rebuild PML dropdown
        if (pmlSelect) {
          const prevPml = pmlSelect.value;
          let html = '<option value="">-- Semua Pengawas PML --</option>';
          sortedPmls.forEach(p => {
            html += `<option value="${p}">${p}</option>`;
          });
          pmlSelect.innerHTML = html;
          if (prevPml && pmlsInScope.has(prevPml)) {
            pmlSelect.value = prevPml;
          } else {
            pmlSelect.value = '';
            currentPml = '';
          }
        }

        // Rebuild PCL dropdown
        if (pclSelect) {
          const prevPcl = pclSelect.value;
          let html = '<option value="">-- Semua Petugas PCL --</option>';
          sortedPcls.forEach(p => {
            html += `<option value="${p}">${p}</option>`;
          });
          pclSelect.innerHTML = html;
          if (prevPcl && pclsInScope.has(prevPcl)) {
            pclSelect.value = prevPcl;
          } else {
            pclSelect.value = '';
            currentPcl = '';
          }
        }
      }

      // Setup Boundary Layers (Kecamatan & Desa)
      function setupBoundaryLayers() {
        if (kecGeoJson) {
          kecLayer = L.geoJSON(kecGeoJson, {
            interactive: false,
            style: {
              color: '#0284c7',
              weight: 1.2,
              opacity: 0.6,
              fillColor: 'transparent',
              fillOpacity: 0
            }
          }).addTo(map);
        }

        if (desaGeoJson) {
          desaLayer = L.geoJSON(desaGeoJson, {
            interactive: false,
            style: {
              color: '#64748b',
              weight: 0.7,
              opacity: 0.45,
              fillColor: 'transparent',
              fillOpacity: 0
            }
          }).addTo(map);
        }
      }

      function showDesaSummaryDrawer(nmdesa, nmkec, iddesa) {
        const ptsInDesa = allPoints.filter(p => (p[11] && p[11].toUpperCase() === (nmdesa || '').toUpperCase()) || (p[13] && p[13].startsWith(iddesa || '')));
        const total = ptsInDesa.length;
        const usaha = ptsInDesa.filter(p => p[3] === 1 || p[3] === 2).length;
        const tinggal = ptsInDesa.filter(p => p[3] === 3).length;
        const kosong = ptsInDesa.filter(p => p[4] === 1 || p[3] === 6).length;

        const html = `
          <div style="background: rgba(2, 132, 199, 0.12); border: 1px solid rgba(2, 132, 199, 0.3); padding: 10px 12px; border-radius: 10px; margin-bottom: 10px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
              <div>
                <span style="font-size: 10px; font-weight: 700; color: var(--accent-cyan); text-transform: uppercase;">Ringkasan Wilayah Uji Petik</span>
                <strong style="font-size: 14.5px; color: var(--text-primary); display: block;"><i class="bi bi-geo-alt-fill" style="color: #0284c7;"></i> Desa ${nmdesa}</strong>
                <span style="font-size: 11px; color: var(--text-secondary);">Kecamatan ${nmkec}</span>
              </div>
              <span class="badge" style="background: rgba(2,132,199,0.2); color: #0284c7; font-size: 11px; font-weight: 700; padding: 3px 8px;">
                ${total.toLocaleString('id-ID')} Titik
              </span>
            </div>
          </div>

          <div class="map-card-stat-grid">
            <div class="map-card-stat-item">
              <span class="map-card-stat-label"><i class="bi bi-shop"></i> Usaha &amp; Campuran</span>
              <span class="map-card-stat-value" style="color: #f59e0b;">${usaha.toLocaleString('id-ID')}</span>
            </div>
            <div class="map-card-stat-item">
              <span class="map-card-stat-label"><i class="bi bi-house"></i> Tempat Tinggal</span>
              <span class="map-card-stat-value" style="color: #0284c7;">${tinggal.toLocaleString('id-ID')}</span>
            </div>
            <div class="map-card-stat-item">
              <span class="map-card-stat-label"><i class="bi bi-door-closed"></i> Bangunan Kosong</span>
              <span class="map-card-stat-value" style="color: #64748b;">${kosong.toLocaleString('id-ID')}</span>
            </div>
            <div class="map-card-stat-item">
              <span class="map-card-stat-label"><i class="bi bi-building"></i> Fasum &amp; Lainnya</span>
              <span class="map-card-stat-value" style="color: #10b981;">${(total - usaha - tinggal - kosong).toLocaleString('id-ID')}</span>
            </div>
          </div>

          <div style="margin-top: 8px;">
            <button type="button" class="btn btn-primary btn-sm" onclick="filterByDesaDirect('${nmdesa}')" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px; font-weight: 700; border-radius: 8px;">
              <i class="bi bi-funnel-fill"></i> Tampilkan Titik Desa Ini Saja
            </button>
          </div>
        `;

        const placeholder = document.getElementById('drawerPlaceholder');
        const body = document.getElementById('drawerDetailsBody');
        if (placeholder) placeholder.style.display = 'none';
        if (body) {
          body.style.display = 'block';
          body.innerHTML = html;
        }
      }

      window.filterByDesaDirect = function(desaName) {
        const desaSelect = document.getElementById('desaFilter');
        if (desaSelect) desaSelect.value = desaName;
        currentDesa = desaName;
        applyFilters();
        zoomToDesa(desaName);
        updateScopeButtonLabel();
      };

      // Category filter buttons listener
      document.querySelectorAll('#categoryFilterGroup .gmaps-pill-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#categoryFilterGroup .gmaps-pill-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCatCode = btn.getAttribute('data-cat') || '';
          applyFilters();
        });
      });

      // KPI Pills Filter Listener
      document.querySelectorAll('.gmaps-floating-kpi-bar .gmaps-kpi-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.gmaps-floating-kpi-bar .gmaps-kpi-pill').forEach(p => p.classList.remove('active-filter'));
          pill.classList.add('active-filter');
          const kpi = pill.getAttribute('data-kpi');
          if (!kpi) currentCatCode = '';
          else if (kpi === 'usaha') currentCatCode = '1';
          else if (kpi === 'tinggal') currentCatCode = '3';
          else if (kpi === 'kosong') currentCatCode = '6';
          applyFilters();
        });
      });

      // Kecamatan Filter Listener
      const kecFilter = document.getElementById('kecFilter');
      if (kecFilter) {
        kecFilter.addEventListener('change', (e) => {
          currentKec = e.target.value;
          currentDesa = '';
          currentPcl = '';
          currentPml = '';
          populateDesaDropdown(currentKec);
          populateOfficerDropdowns(currentKec, '', '');
          applyFilters();

          if (currentKec) {
            zoomToKecamatan(currentKec);
          } else {
            map.setView(centerCoords, defaultZoom);
          }
          updateScopeButtonLabel();
        });
      }

      // Desa Filter Listener
      const desaFilter = document.getElementById('desaFilter');
      if (desaFilter) {
        desaFilter.addEventListener('change', (e) => {
          currentDesa = e.target.value;
          currentPcl = '';
          currentPml = '';
          if (currentDesa && summaryStats && summaryStats.desaStats) {
            const match = summaryStats.desaStats.find(d => d.desa && d.desa.toUpperCase() === currentDesa.toUpperCase());
            if (match && match.kecamatan) {
              currentKec = match.kecamatan;
              if (kecFilter) {
                const targetKec = match.kecamatan.toUpperCase();
                for (let i = 0; i < kecFilter.options.length; i++) {
                  if (kecFilter.options[i].value.toUpperCase() === targetKec) {
                    kecFilter.selectedIndex = i;
                    break;
                  }
                }
              }
            }
          }
          populateOfficerDropdowns(currentKec, currentDesa, '');
          applyFilters();

          if (currentDesa) {
            zoomToDesa(currentDesa);
          }
          updateScopeButtonLabel();
        });
      }

      // PCL Filter Listener
      const pclFilter = document.getElementById('pclFilter');
      if (pclFilter) {
        pclFilter.addEventListener('change', (e) => {
          currentPcl = e.target.value;
          if (currentPcl && allPoints) {
            const pMatch = allPoints.find(p => p[7] && p[7].toLowerCase().trim() === currentPcl.toLowerCase().trim());
            if (pMatch && pMatch[8]) {
              const pmlVal = pMatch[8].trim();
              if (pmlFilter && (!currentPml || currentPml !== pmlVal)) {
                currentPml = pmlVal;
                pmlFilter.value = pmlVal;
              }
            }
          }
          applyFilters();
        });
      }

      // PML Filter Listener
      const pmlFilter = document.getElementById('pmlFilter');
      if (pmlFilter) {
        pmlFilter.addEventListener('change', (e) => {
          currentPml = e.target.value;
          populateOfficerDropdowns(currentKec, currentDesa, currentPml);
          applyFilters();
        });
      }

      // Search Input Listener
      const mapSearchInput = document.getElementById('mapSearchInput');
      let searchTimer = null;
      if (mapSearchInput) {
        mapSearchInput.addEventListener('input', (e) => {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(() => {
            currentSearch = e.target.value;
            applyFilters();
          }, 150);
        });
      }

      // Reset View Button
      const btnResetView = document.getElementById('btnResetView');
      if (btnResetView) {
        btnResetView.addEventListener('click', () => {
          currentKec = '';
          currentDesa = '';
          currentPcl = '';
          currentPml = '';
          currentCatCode = '';
          currentSearch = '';
          if (kecFilter) kecFilter.value = '';
          if (desaFilter) {
            populateDesaDropdown('');
            desaFilter.value = '';
          }
          populateOfficerDropdowns('', '', '');
          if (mapSearchInput) mapSearchInput.value = '';
          document.querySelectorAll('#categoryFilterGroup .gmaps-pill-btn').forEach((b, i) => {
            if (i === 0) b.classList.add('active');
            else b.classList.remove('active');
          });
          map.setView(centerCoords, defaultZoom);
          updateScopeButtonLabel();
          openScopeModal();
        });
      }

      // GPS Live Locator
      let userGpsMarker = null;
      const btnLocateMe = document.getElementById('btnLocateMe');
      const gpsToast = document.getElementById('gpsToast');
      const gpsToastText = document.getElementById('gpsToastText');
      const gpsToastSpinner = document.getElementById('gpsToastSpinner');

      function locateUserGPS() {
        if (!navigator.geolocation) {
          alert('Perangkat Anda tidak mendukung geolokasi GPS.');
          return;
        }

        if (btnLocateMe) btnLocateMe.innerHTML = '<span class="spinner-border spinner-border-sm" style="width: 13px; height: 13px;"></span>';
        if (gpsToast && gpsToastText && gpsToastSpinner) {
          gpsToastSpinner.style.display = 'inline-block';
          gpsToastText.textContent = 'Mengunci koordinat GPS presisi tinggi...';
          gpsToast.classList.add('show');
        }

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            const accuracy = pos.coords.accuracy;

            if (btnLocateMe) btnLocateMe.innerHTML = '<i class="bi bi-crosshair text-cyan"></i>';
            if (gpsToast && gpsToastText && gpsToastSpinner) {
              gpsToastSpinner.style.display = 'none';
              gpsToastText.innerHTML = `<i class="bi bi-check-circle-fill text-green"></i> GPS Terkunci (Akurasi: ±${Math.round(accuracy)}m)`;
              setTimeout(() => gpsToast.classList.remove('show'), 2500);
            }

            if (userGpsMarker) map.removeLayer(userGpsMarker);

            const gpsIcon = L.divIcon({
              className: 'custom-gps-icon',
              html: `
                <div style="position: relative; width: 16px; height: 16px;">
                  <div style="position: absolute; inset: 0; background: #0284c7; border-radius: 50%; border: 2.5px solid white; box-shadow: 0 0 10px rgba(2,132,199,0.8);"></div>
                  <div style="position: absolute; inset: -6px; border: 2px solid #0284c7; border-radius: 50%; animation: pingGps 1.5s cubic-bezier(0,0,0.2,1) infinite; opacity: 0.75;"></div>
                </div>
              `,
              iconSize: [16, 16],
              iconAnchor: [8, 8]
            });

            userGpsMarker = L.marker([lat, lng], { icon: gpsIcon }).addTo(map);
            userGpsMarker.bindPopup(`
              <div style="font-family: 'Inter', sans-serif; padding: 2px;">
                <strong style="color: #0284c7;"><i class="bi bi-crosshair"></i> Posisi Anda Saat Ini</strong><br>
                <span style="font-size: 11px; color: var(--text-muted);">Akurasi: ±${Math.round(accuracy)} meter</span>
              </div>
            `).openPopup();

            map.flyTo([lat, lng], 16, { animate: true, duration: 1.2 });
          },
          (err) => {
            if (btnLocateMe) btnLocateMe.innerHTML = '<i class="bi bi-crosshair"></i>';
            if (gpsToast && gpsToastText && gpsToastSpinner) {
              gpsToastSpinner.style.display = 'none';
              gpsToastText.innerHTML = `<i class="bi bi-exclamation-circle-fill" style="color: #ef4444;"></i> Gagal Mengunci GPS (${err.message || 'Izin ditolak'})`;
              setTimeout(() => gpsToast.classList.remove('show'), 3000);
            }
          },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
      }

      if (btnLocateMe) btnLocateMe.addEventListener('click', locateUserGPS);

      // Fullscreen Presentation Mode
      const btnFullscreenMap = document.getElementById('btnFullscreenMap');
      if (btnFullscreenMap) {
        btnFullscreenMap.addEventListener('click', () => {
          const wrapper = document.getElementById('gmapsWrapper');
          if (!wrapper) return;
          wrapper.classList.toggle('is-fullscreen');
          const isFull = wrapper.classList.contains('is-fullscreen');
          btnFullscreenMap.innerHTML = isFull ? '<i class="bi bi-fullscreen-exit"></i>' : '<i class="bi bi-arrows-fullscreen"></i>';
          setTimeout(invalidateSize, 150);
        });
      }

      // Drawer Tab & Collapse Functions (Manual user control only)
      window.switchDrawerTab = function(tabName, e) {
        if (e) e.stopPropagation();

        const card = document.getElementById('gmapsDrawerCard');
        const icon = document.getElementById('drawerCollapseIcon');
        
        // If user manually clicks a tab while the drawer is collapsed, expand it
        if (card && card.classList.contains('collapsed')) {
          card.classList.remove('collapsed');
          if (icon) icon.className = 'bi bi-chevron-down';
        }

        const tabInfo = document.getElementById('tabBtnInfo');
        const tabLegend = document.getElementById('tabBtnLegend');
        const contentInfo = document.getElementById('drawerContentInfo');
        const contentLegend = document.getElementById('drawerContentLegend');

        if (tabName === 'info') {
          if (tabInfo) tabInfo.classList.add('active');
          if (tabLegend) tabLegend.classList.remove('active');
          if (contentInfo) contentInfo.style.display = 'block';
          if (contentLegend) contentLegend.style.display = 'none';
        } else {
          if (tabLegend) tabLegend.classList.add('active');
          if (tabInfo) tabInfo.classList.remove('active');
          if (contentLegend) contentLegend.style.display = 'block';
          if (contentInfo) contentInfo.style.display = 'none';
        }
      };

      window.toggleDrawerCollapse = function(e) {
        if (e) e.stopPropagation();
        const card = document.getElementById('gmapsDrawerCard');
        const icon = document.getElementById('drawerCollapseIcon');
        if (!card) return;
        card.classList.toggle('collapsed');
        if (icon) {
          icon.className = card.classList.contains('collapsed') ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
        }
      };

      window.filterByCategoryCode = function(catCode) {
        currentCatCode = String(catCode);
        document.querySelectorAll('#categoryFilterGroup .gmaps-pill-btn').forEach(b => {
          if (b.getAttribute('data-cat') === String(catCode)) b.classList.add('active');
          else b.classList.remove('active');
        });
        applyFilters();
      };

      // Toggle Tools Expand / Collapse
      const btnToggleToolsExpand = document.getElementById('btnToggleToolsExpand');
      const gmapsToolsPanel = document.getElementById('gmapsToolsPanel');
      const toolsExpandIcon = document.getElementById('toolsExpandIcon');

      if (gmapsToolsPanel && window.innerWidth <= 768) {
        gmapsToolsPanel.classList.add('is-collapsed');
        if (toolsExpandIcon) toolsExpandIcon.className = 'bi bi-sliders';
      }

      if (btnToggleToolsExpand && gmapsToolsPanel) {
        btnToggleToolsExpand.addEventListener('click', () => {
          gmapsToolsPanel.classList.toggle('is-collapsed');
          if (toolsExpandIcon) {
            toolsExpandIcon.className = gmapsToolsPanel.classList.contains('is-collapsed') ? 'bi bi-sliders' : 'bi bi-chevron-bar-up';
          }
        });
      }

      // Bootstrap & Load Data
      async function bootstrap() {
        const loading = document.getElementById('mapLoading');
        try {
          const [statsRes, pointsRes, desaGeoRes, kecGeoRes] = await Promise.all([
            fetch('/api/ujipetik-stats'),
            fetch('/api/ujipetik-points'),
            fetch('/data/desa_boundaries.geojson'),
            fetch('/data/kecamatan_boundaries.geojson')
          ]);

          summaryStats = await statsRes.json();
          allPoints = await pointsRes.json();
          desaGeoJson = await desaGeoRes.json();
          kecGeoJson = await kecGeoRes.json();

          populateDesaDropdown('');
          populateOfficerDropdowns('', '', '');
          setupBoundaryLayers();
          renderModalDesaGrid();

          // Setup Modal Live Search Listener
          const modalSearchInput = document.getElementById('modalDesaSearchInput');
          if (modalSearchInput) {
            modalSearchInput.addEventListener('input', (e) => {
              modalDesaSearchQuery = e.target.value;
              renderModalDesaGrid();
            });
          }

          // Check URL query parameters (e.g. ?desa=WARU or ?kec=BABULU)
          const urlParams = new URLSearchParams(window.location.search);
          const initialKec = urlParams.get('kec');
          const initialDesa = urlParams.get('desa');

          if (initialDesa) {
            selectScopeDesaDirect(initialDesa, initialKec || '');
          } else if (initialKec) {
            currentKec = initialKec;
            const kecSelect = document.getElementById('kecFilter');
            if (kecSelect) kecSelect.value = initialKec;
            populateDesaDropdown(initialKec);
            populateOfficerDropdowns(initialKec, '', '');
            applyFilters();
            zoomToKecamatan(initialKec);
            updateScopeButtonLabel();
          } else {
            // Default: do NOT draw all 69k points automatically (prevents initial lag)
            filteredPoints = [];
            renderCanvas();
            updateCategoryPillCounts(allPoints || []);
            updateScopeButtonLabel();

            if (allPoints && allPoints.length > 0) {
              setTimeout(openScopeModal, 300);
            }
          }

          // Update dynamic legend numbers
          if (summaryStats) {
            const findCatCount = (keyword) => {
              if (!summaryStats.kategoriStats) return 0;
              const found = summaryStats.kategoriStats.find(k => (k.kategori || '').toLowerCase().includes(keyword.toLowerCase()));
              return found ? found.count : 0;
            };

            const elUsaha = document.getElementById('legendCountUsaha');
            const elCampuran = document.getElementById('legendCountCampuran');
            const elTinggal = document.getElementById('legendCountTinggal');
            const elIbadah = document.getElementById('legendCountIbadah');
            const elPem = document.getElementById('legendCountPemerintah');
            const elLainnya = document.getElementById('legendCountLainnya');

            if (elUsaha) elUsaha.textContent = findCatCount('Khusus Usaha').toLocaleString('id-ID');
            if (elCampuran) elCampuran.textContent = findCatCount('Campuran').toLocaleString('id-ID');
            if (elTinggal) elTinggal.textContent = findCatCount('Tempat Tinggal').toLocaleString('id-ID');
            if (elIbadah) elIbadah.textContent = findCatCount('Ibadah').toLocaleString('id-ID');
            if (elPem) elPem.textContent = findCatCount('Pemerintah').toLocaleString('id-ID');
            if (elLainnya) elLainnya.textContent = (summaryStats.kosong || findCatCount('Kosong') || findCatCount('Lainnya')).toLocaleString('id-ID');
          }

          // Handle Empty Database State
          if (!allPoints || allPoints.length === 0) {
            const placeholder = document.getElementById('drawerPlaceholder');
            if (placeholder) {
              placeholder.innerHTML = `
                <div style="padding: 10px 4px;">
                  <i class="bi bi-inbox" style="font-size: 32px; color: var(--accent-amber); display: block; margin-bottom: 8px;"></i>
                  <strong style="font-size: 13.5px; color: var(--text-primary); display: block; margin-bottom: 4px;">Belum Ada Data Titik Uji Petik</strong>
                  <span style="font-size: 11.5px; color: var(--text-muted); display: block; margin-bottom: 14px; line-height: 1.4;">
                    Peta ini secara default kosong. Admin dapat mengunggah file data CSV Titik Uji Petik melalui halaman Upload Data.
                  </span>
                  <a href="/admin/upload?tab=ujipetik" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; font-weight: 600; text-decoration: none; border-radius: 8px; font-size: 11.5px;">
                    <i class="bi bi-upload"></i> Upload File CSV Titik Uji Petik
                  </a>
                </div>
              `;
            }
          }

          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => loading.style.display = 'none', 300);
          }
        } catch (err) {
          console.error('Error bootstrapping Uji Petik Map:', err);
          if (loading) {
            loading.style.opacity = '0';
            setTimeout(() => loading.style.display = 'none', 300);
          }
        }
      }

      bootstrap();
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initUjiPetikMapPage();
    } else {
      document.addEventListener('DOMContentLoaded', initUjiPetikMapPage);
    }
  })();
</script>
