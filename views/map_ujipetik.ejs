      // Draggable Tools Panel Setup
      function setupDraggableToolsPanel() {
        const panel = document.getElementById('gmapsToolsPanel');
        const handle = document.getElementById('toolsPanelDragHandle');
        const container = document.getElementById('gmapsWrapper') || document.body;
        if (!panel || !handle) return;

        if (typeof L !== 'undefined' && L.DomEvent) {
          L.DomEvent.disableClickPropagation(panel);
          L.DomEvent.disableScrollPropagation(panel);
        }

        let isDragging = false;
        let startX = 0, startY = 0;
        let initialLeft = 0, initialTop = 0;

        function startDrag(e) {
          // Disable free dragging on mobile screens where panel is pinned to top
          if (window.innerWidth <= 768) return;

          // Strictly require dragging to initiate from the designated drag handle
          if (!e.target.closest('#toolsPanelDragHandle')) return;

          isDragging = true;
          panel.classList.add('is-dragging');

          const clientX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
          const clientY = e.type.startsWith('touch') ? e.touches[0].clientY : e.clientY;

          startX = clientX;
          startY = clientY;

          const rect = panel.getBoundingClientRect();
          const containerRect = container.getBoundingClientRect();

          initialLeft = rect.left - containerRect.left;
          initialTop = rect.top - containerRect.top;

          panel.style.left = initialLeft + 'px';
          panel.style.top = initialTop + 'px';
          panel.style.right = 'auto';
          panel.style.bottom = 'auto';

          if (e.type.startsWith('touch')) {
            window.addEventListener('touchmove', moveDrag, { passive: false });
            window.addEventListener('touchend', endDrag);
          } else {
            window.addEventListener('mousemove', moveDrag);
            window.addEventListener('mouseup', endDrag);
          }
        }

        function moveDrag(e) {
          if (!isDragging) return;
          if (e.cancelable) e.preventDefault();

          const clientX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
          const clientY = e.type.startsWith('touch') ? e.touches[0].clientY : e.clientY;

          const dx = clientX - startX;
          const dy = clientY - startY;

          const containerRect = container.getBoundingClientRect();
          const panelWidth = panel.offsetWidth;
          const panelHeight = panel.offsetHeight;

          let newLeft = initialLeft + dx;
          let newTop = initialTop + dy;

          const minLeft = 10;
          const maxLeft = containerRect.width - panelWidth - 10;
          const minTop = 10;
          const maxTop = containerRect.height - panelHeight - 10;

          newLeft = Math.max(minLeft, Math.min(maxLeft, newLeft));
          newTop = Math.max(minTop, Math.min(maxTop, newTop));

          panel.style.left = newLeft + 'px';
          panel.style.top = newTop + 'px';
        }

        function endDrag() {
          if (!isDragging) return;
          isDragging = false;
          panel.classList.remove('is-dragging');

          window.removeEventListener('mousemove', moveDrag);
          window.removeEventListener('mouseup', endDrag);
          window.removeEventListener('touchmove', moveDrag);
          window.removeEventListener('touchend', endDrag);
        }

        handle.addEventListener('mousedown', startDrag);
        handle.addEventListener('touchstart', startDrag, { passive: true });
      }

      setupDraggableToolsPanel();


      // ── EXPORT DATA TITIK UJI PETIK (CSV & GeoJSON) ─────────────
      function exportPointsCsv() {
        const pts = (filteredPoints && filteredPoints.length > 0) ? filteredPoints : ((allPoints && allPoints.length > 0) ? allPoints : (currentScopedPoints || []));
        if (!pts || pts.length === 0) {
          if (typeof alert !== 'undefined') {
            alert('Tidak ada data titik uji petik untuk diekspor.');
          } else {
            console.warn('Tidak ada data titik uji petik untuk diekspor.');
          }
          return;
        }

        const escapeCsv = (str) => {
          if (str === null || str === undefined) return '""';
          const s = String(str).replace(/"/g, '""');
          return `"${s}"`;
        };

        const headers = [
          'ID', 'Latitude', 'Longitude', 'Kode Kategori', 'Kategori Bangunan',
          'Status Kosong', 'Label / Nama Bangunan', 'No Bangunan', 'Petugas PCL',
          'Pengawas PML', 'Koordinator Lapangan', 'Nama SLS', 'Desa / Kelurahan',
          'Kecamatan', 'Kode SLS'
        ];

        const rows = [headers.join(',')];
        const len = pts.length;
        for (let i = 0; i < len; i++) {
          const p = pts[i];
          const catCode = p[3] || 0;
          const catName = categoryLabels[catCode] || 'Lainnya';
          const isKosongText = p[4] === 1 ? 'Kosong' : 'Berpenghuni';
          const cleanNb = p[6] ? String(p[6]).trim() : '';
          const cleanLabel = getCleanBuildingLabel(cleanNb, p[5], catName);

          const row = [
            p[0],
            p[1],
            p[2],
            catCode,
            escapeCsv(catName),
            escapeCsv(isKosongText),
            escapeCsv(cleanLabel),
            escapeCsv(cleanNb),
            escapeCsv(p[7] || ''),
            escapeCsv(p[8] || ''),
            escapeCsv(p[9] || ''),
            escapeCsv(p[10] || ''),
            escapeCsv(p[11] || ''),
            escapeCsv(p[12] || ''),
            escapeCsv(p[13] || '')
          ];
          rows.push(row.join(','));
        }

        const csvString = '\uFEFF' + rows.join('\r\n');
        const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const scopeSlug = (currentDesa || currentKec || 'ppu').toLowerCase().replace(/[^a-z0-9]+/g, '_');
        const dateStr = new Date().toISOString().slice(0, 10);
        a.href = url;
        a.download = `titik_uji_petik_${scopeSlug}_${dateStr}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      function exportPointsGeoJson() {
        const pts = (filteredPoints && filteredPoints.length > 0) ? filteredPoints : ((allPoints && allPoints.length > 0) ? allPoints : (currentScopedPoints || []));
        if (!pts || pts.length === 0) {
          if (typeof alert !== 'undefined') {
            alert('Tidak ada data titik uji petik untuk diekspor.');
          } else {
            console.warn('Tidak ada data titik uji petik untuk diekspor.');
          }
          return;
        }

        const features = pts.map(p => {
          const catCode = p[3] || 0;
          const catName = categoryLabels[catCode] || 'Lainnya';
          const cleanNb = p[6] ? String(p[6]).trim() : '';
          const cleanLabel = getCleanBuildingLabel(cleanNb, p[5], catName);
          return {
            type: 'Feature',
            geometry: {
              type: 'Point',
              coordinates: [p[2], p[1]]
            },
            properties: {
              id: p[0],
              latitude: p[1],
              longitude: p[2],
              kode_kategori: catCode,
              kategori: catName,
              is_kosong: p[4],
              status_kosong: p[4] === 1 ? 'Kosong' : 'Berpenghuni',
              label: cleanLabel,
              no_bang: cleanNb,
              pcl: p[7] || '',
              pml: p[8] || '',
              korlap: p[9] || '',
              nama_sls: p[10] || '',
              desa: p[11] || '',
              kecamatan: p[12] || '',
              kode_sls: p[13] || ''
            }
          };
        });

        const geoJsonData = {
          type: 'FeatureCollection',
          features: features
        };

        const jsonString = JSON.stringify(geoJsonData, null, 2);
        const blob = new Blob([jsonString], { type: 'application/geo+json;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const scopeSlug = (currentDesa || currentKec || 'ppu').toLowerCase().replace(/[^a-z0-9]+/g, '_');
        const dateStr = new Date().toISOString().slice(0, 10);
        a.href = url;
        a.download = `titik_uji_petik_${scopeSlug}_${dateStr}.geojson`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      };
