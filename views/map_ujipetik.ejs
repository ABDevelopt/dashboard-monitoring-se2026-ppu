      }

      // Filter Logic
      function applyFilters() {
        const base = (allPoints && allPoints.length > 0) ? allPoints : (currentScopedPoints || []);
        let scoped = base;

        if (currentKec) {
          const kecUpper = currentKec.toUpperCase().trim();
          const kecNorm = kecUpper.replace(/[\s\-_]/g, '');
          scoped = scoped.filter(p => {
            const k = (p[12] || '').toUpperCase();
            return k === kecUpper || k.replace(/[\s\-_]/g, '') === kecNorm;
          });
        }

        if (currentDesa) {
          const desaUpper = currentDesa.toUpperCase().trim();
          const desaNorm = desaUpper.replace(/[\s\-_]/g, '');
          const isCode = /^\d{7,10}$/.test(desaUpper);
          scoped = scoped.filter(p => {
            const d = (p[11] || '').toUpperCase();
            return d === desaUpper || d.replace(/[\s\-_]/g, '') === desaNorm || (isCode && (p[13] || '').startsWith(desaUpper));
          });
        }

        if (currentPcl) {
          const pclLower = currentPcl.toLowerCase().trim();
          scoped = scoped.filter(p => p[7] && p[7].toLowerCase().trim() === pclLower);
        }

        if (currentPml) {
          const pmlLower = currentPml.toLowerCase().trim();
          scoped = scoped.filter(p => p[8] && p[8].toLowerCase().trim() === pmlLower);
        }

        if (currentSearch) {
          const q = currentSearch.toLowerCase().trim();
          scoped = scoped.filter(p => {
            const catName = (categoryLabels[p[3]] || '').toLowerCase();
            return (p[5] && p[5].toLowerCase().includes(q)) ||
                   (p[6] && String(p[6]).toLowerCase().includes(q)) ||
                   (p[7] && p[7].toLowerCase().includes(q)) ||
                   (p[8] && p[8].toLowerCase().includes(q)) ||
                   (p[9] && p[9].toLowerCase().includes(q)) ||
                   (p[10] && p[10].toLowerCase().includes(q)) ||
                   (p[11] && p[11].toLowerCase().includes(q)) ||
                   (p[12] && p[12].toLowerCase().includes(q)) ||
                   (p[13] && String(p[13]).toLowerCase().includes(q)) ||
                   catName.includes(q);
          });
        }

        updateCategoryPillCounts(scoped);

        let res = scoped;
        if (currentCatCode !== '') {
          if (currentCatCode === 'lainnya') {
            res = res.filter(p => p[3] === 0);
          } else {
            const cCode = parseInt(currentCatCode, 10);
            res = res.filter(p => p[3] === cCode);
          }
        }

        filteredPoints = res;
        renderCanvas();
        refreshBoundaryStyles();
      }

      function updateCategoryPillCounts(pts) {
        const total = pts ? pts.length : 0;
        const usaha = pts ? pts.filter(p => p[3] === 1).length : 0;
        const campuran = pts ? pts.filter(p => p[3] === 2).length : 0;
        const tinggal = pts ? pts.filter(p => p[3] === 3).length : 0;
        const ibadah = pts ? pts.filter(p => p[3] === 4).length : 0;
        const pemerintah = pts ? pts.filter(p => p[3] === 5).length : 0;
        const kosong = pts ? pts.filter(p => p[3] === 6).length : 0;
        const panti = pts ? pts.filter(p => p[3] === 8).length : 0;
        const nonRespon = pts ? pts.filter(p => p[3] === 9).length : 0;
        const lainnya = pts ? pts.filter(p => p[3] === 0).length : 0;

        const setVal = (id, val) => {
          const el = document.getElementById(id);
          if (el) el.textContent = (val || 0).toLocaleString('id-ID');
        };

        setVal('countCatAll', total);
        setVal('countCatUsaha', usaha);
        setVal('countCatCampuran', campuran);
        setVal('countCatTinggal', tinggal);
        setVal('countCatIbadah', ibadah);
        setVal('countCatPemerintah', pemerintah);
        setVal('countCatKosong', kosong);
        setVal('countCatPanti', panti);
        setVal('countCatNonRespon', nonRespon);
        setVal('countCatLainnya', lainnya);

        // Update Top Floating KPI Bar
        setVal('kpiTotalTitik', total);
        setVal('kpiTitikUsaha', usaha);
        setVal('kpiTitikCampuran', campuran);
        setVal('kpiTitikTinggal', tinggal);
        setVal('kpiTitikKosong', kosong);
        setVal('kpiTitikNonRespon', nonRespon);

        // Update Legend Drawer counts
        setVal('legendCountUsaha', usaha);
        setVal('legendCountCampuran', campuran);
        setVal('legendCountTinggal', tinggal);
        setVal('legendCountIbadah', ibadah);
        setVal('legendCountPemerintah', pemerintah);
        setVal('legendCountLainnya', kosong);
        setVal('legendCountPanti', panti);
        setVal('legendCountNonRespon', nonRespon);
        setVal('legendCountMisc', lainnya);
      }

      // Scope Selector Modal
      let modalActiveKec = '';
      let modalDesaSearchQuery = '';

      function openScopeModal() {
        const modal = document.getElementById('ujipetikScopeModal');
        const searchInput = document.getElementById('modalDesaSearchInput');
        if (searchInput) searchInput.value = '';
        modalDesaSearchQuery = '';
        renderModalDesaGrid();
        if (modal) modal.style.display = 'flex';
      };

      function closeScopeModal() {
        const modal = document.getElementById('ujipetikScopeModal');
        if (modal) modal.style.display = 'none';
      };

      function updateScopeButtonLabel() {
        const btnText = document.getElementById('currentScopeBtnText');
        if (!btnText) return;
        if (currentDesa) {
          btnText.textContent = `Desa: ${currentDesa}`;
        } else if (currentKec) {
          btnText.textContent = `Kecamatan: ${currentKec}`;
        } else if (filteredPoints && filteredPoints.length === allPoints.length && allPoints.length > 0) {
          btnText.textContent = `Seluruh PPU (${(allPoints.length).toLocaleString('id-ID')} Titik)`;
        } else {
          btnText.textContent = 'Pilih Wilayah Terfokus';
