            <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-secondary); margin-top: 4px;">
              <span class="category-color-dot" style="background: ${color}; width: 8px; height: 8px;"></span>
              <strong style="color: var(--text-primary);">${catName}</strong>
            </div>
          </div>

          <div class="map-card-stat-grid">
            <div class="map-card-stat-item full-width">
              <span class="map-card-stat-label"><i class="bi bi-pin-map text-cyan"></i> Wilayah SLS</span>
              <span class="map-card-stat-value">${namaSls ? namaSls : 'SLS ' + (kodeSls || '')}</span>
            </div>
            <div class="map-card-stat-item">
              <span class="map-card-stat-label"><i class="bi bi-geo-alt text-cyan"></i> Desa / Kel</span>
              <span class="map-card-stat-value">${desa || '-'}</span>
            </div>
            <div class="map-card-stat-item">
              <span class="map-card-stat-label"><i class="bi bi-diagram-3 text-cyan"></i> Kecamatan</span>
              <span class="map-card-stat-value">${kec || '-'}</span>
            </div>
            <div class="map-card-stat-item">
              <span class="map-card-stat-label"><i class="bi bi-person-badge text-cyan"></i> Petugas PCL</span>
              <span class="map-card-stat-value" title="${pcl || '-'}">${pcl || '-'}</span>
            </div>
            <div class="map-card-stat-item">
              <span class="map-card-stat-label"><i class="bi bi-person-check text-cyan"></i> Pengawas PML</span>
              <span class="map-card-stat-value" title="${pml || '-'}">${pml || '-'}</span>
            </div>
            <div class="map-card-stat-item full-width">
              <span class="map-card-stat-label"><i class="bi bi-crosshair text-cyan"></i> Koordinat GPS</span>
              <span class="map-card-stat-value" style="font-family: monospace; font-size: 12px;">${lat.toFixed(6)}, ${lng.toFixed(6)}</span>
            </div>
          </div>

          <div style="margin-top: 10px; display: flex; flex-direction: column; gap: 6px;">
            <a href="${gmapsUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 7px; padding: 8px 12px; font-size: 12px; font-weight: 700; border-radius: 8px; text-decoration: none;">
              <i class="bi bi-compass"></i> Buka Navigasi Rute (Google Maps)
            </a>
          </div>
        `;

        selectedPoint = p;
        renderCanvas();

        const placeholder = document.getElementById('drawerPlaceholder');
        const body = document.getElementById('drawerDetailsBody');
        if (placeholder) placeholder.style.display = 'none';
        if (body) {
          body.style.display = 'block';
          body.innerHTML = detailsHtml;
        }

        // Switch to Info Tab & ensure visible
        if (typeof window.switchDrawerTab === 'function') {
          window.switchDrawerTab('info');
        }

        // Update breadcrumb
        updateMapBreadcrumbs('point', kec, desa, namaSls, cleanNoBang || cleanLabel);

        const drawerContentInfo = document.getElementById('drawerContentInfo');
        if (drawerContentInfo) drawerContentInfo.scrollTop = 0;

        // Auto ensure drawer open on mobile and desktop
        ensureGmapsDrawerOpen();

        const headerColor = catCode === 6 ? '#cbd5e1' : color;
        const popupHtml = `
          <div style="font-family: 'Inter', sans-serif; min-width: 220px; padding: 2px;">
