            <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-bottom: 6px;">
              <i class="bi bi-geo-alt-fill" style="color: var(--accent-cyan);"></i> ${desa || ''}, Kec. ${kec || ''}
            </span>
            <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 9px; line-height: 1.4;">
              PCL: <strong style="color: var(--text-primary);">${pcl || '-'}</strong> | PML: <strong style="color: var(--text-primary);">${pml || '-'}</strong>
            </div>
            <a href="${gmapsUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 5px; padding: 7px; font-size: 12px; font-weight: 700; border-radius: 8px; text-decoration: none;">
              <i class="bi bi-compass"></i> Petunjuk Rute Google Maps
            </a>
          </div>
        `;

        L.popup({
          autoClose: true,
          closeOnClick: true,
          offset: [0, -8]
        })
        .setLatLng([lat, lng])
        .setContent(popupHtml)
        .openOn(map);
      }

      // Breadcrumb Manager
      function updateMapBreadcrumbs(level, nmkec, nmdesa, nmsls, extra) {
        const bar = document.getElementById('mapBreadcrumbs');
        if (!bar) return;

        if (level === 'kab' || !nmkec) {
          bar.innerHTML = '<span class="gmaps-breadcrumb-item active" onclick="selectAllPoints()"><i class="bi bi-geo-alt"></i> Kab. Penajam Paser Utara</span>';
        } else if (level === 'kec') {
          bar.innerHTML = `
            <span class="gmaps-breadcrumb-item" onclick="selectAllPoints()"><i class="bi bi-geo-alt"></i> PPU</span>
            <i class="bi bi-chevron-right" style="font-size: 11px; opacity: 0.6;"></i>
            <span class="gmaps-breadcrumb-item active" onclick="if(window.zoomToKecamatan) window.zoomToKecamatan('${nmkec}')">Kec. ${nmkec}</span>
          `;
        } else if (level === 'desa') {
          bar.innerHTML = `
            <span class="gmaps-breadcrumb-item" onclick="selectAllPoints()"><i class="bi bi-geo-alt"></i> PPU</span>
            <i class="bi bi-chevron-right" style="font-size: 11px; opacity: 0.6;"></i>
            <span class="gmaps-breadcrumb-item" onclick="if(window.zoomToKecamatan) window.zoomToKecamatan('${nmkec}')">Kec. ${nmkec}</span>
            <i class="bi bi-chevron-right" style="font-size: 11px; opacity: 0.6;"></i>
            <span class="gmaps-breadcrumb-item active" onclick="if(window.zoomToDesa) window.zoomToDesa('${nmdesa}')">Desa ${nmdesa}</span>
          `;
        } else if (level === 'point') {
          bar.innerHTML = `
            <span class="gmaps-breadcrumb-item" onclick="selectAllPoints()"><i class="bi bi-geo-alt"></i> PPU</span>
            <i class="bi bi-chevron-right" style="font-size: 11px; opacity: 0.6;"></i>
            <span class="gmaps-breadcrumb-item" onclick="if(window.zoomToKecamatan) window.zoomToKecamatan('${nmkec}')">Kec. ${nmkec}</span>
            <i class="bi bi-chevron-right" style="font-size: 11px; opacity: 0.6;"></i>
            <span class="gmaps-breadcrumb-item" onclick="if(window.zoomToDesa) window.zoomToDesa('${nmdesa}')">Desa ${nmdesa}</span>
            <i class="bi bi-chevron-right" style="font-size: 11px; opacity: 0.6;"></i>
            <span class="gmaps-breadcrumb-item active">${extra || 'Titik'}</span>
