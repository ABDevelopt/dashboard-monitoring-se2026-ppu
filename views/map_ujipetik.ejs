      // GPS Live Locator with Point-in-Polygon Administrative Detection
      function isPointInPolygonCoords(point, vs) {
        const x = point[0], y = point[1];
        let inside = false;
        for (let i = 0, j = vs.length - 1; i < vs.length; j = i++) {
          const xi = vs[i][0], yi = vs[i][1];
          const xj = vs[j][0], yj = vs[j][1];
          const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi);
          if (intersect) inside = !inside;
        }
        return inside;
      }

      function isCoordinateInsideFeature(lng, lat, feature) {
        if (!feature || !feature.geometry) return false;
        const pt = [lng, lat];
        const geom = feature.geometry;
        if (geom.type === 'Polygon') {
          if (!isPointInPolygonCoords(pt, geom.coordinates[0])) return false;
          for (let h = 1; h < geom.coordinates.length; h++) {
            if (isPointInPolygonCoords(pt, geom.coordinates[h])) return false;
          }
          return true;
        } else if (geom.type === 'MultiPolygon') {
          for (let p = 0; p < geom.coordinates.length; p++) {
            const poly = geom.coordinates[p];
            if (isPointInPolygonCoords(pt, poly[0])) {
              let inHole = false;
              for (let h = 1; h < poly.length; h++) {
                if (isPointInPolygonCoords(pt, poly[h])) {
                  inHole = true;
                  break;
                }
              }
              if (!inHole) return true;
            }
          }
          return false;
        }
        return false;
      }

      function findLocationSpatialHierarchy(lng, lat) {
        let matchedSls = null;
        let matchedDesa = null;
        let matchedKec = null;

        if (slsGeoJson && slsGeoJson.features) {
          for (const f of slsGeoJson.features) {
            if (isCoordinateInsideFeature(lng, lat, f)) {
              matchedSls = f;
              break;
            }
          }
        }

        if (desaGeoJson && desaGeoJson.features) {
          for (const f of desaGeoJson.features) {
            if (isCoordinateInsideFeature(lng, lat, f)) {
              matchedDesa = f;
              break;
            }
          }
        }

        if (kecGeoJson && kecGeoJson.features) {
          for (const f of kecGeoJson.features) {
            if (isCoordinateInsideFeature(lng, lat, f)) {
              matchedKec = f;
              break;
            }
          }
        }

        return { matchedSls, matchedDesa, matchedKec };
      }

      function locateUserGPS() {
        if (!navigator.geolocation) {
          if (typeof alert !== 'undefined') {
            alert('Fitur Geolocation tidak didukung di peramban Anda.');
          } else {
            console.warn('Fitur Geolocation tidak didukung di peramban Anda.');
          }
          return;
        }

        // On mobile, collapse panels to give full view of user GPS location
        if (window.innerWidth <= 768) {
          const toolsPanel = document.getElementById('gmapsToolsPanel');
          const toolsExpandIcon = document.getElementById('toolsExpandIcon');
          if (toolsPanel) {
            toolsPanel.classList.add('is-collapsed');
            if (toolsExpandIcon) toolsExpandIcon.className = 'bi bi-sliders';
          }
          const drawerCard = document.getElementById('gmapsDrawerCard');
          const drawerIcon = document.getElementById('drawerCollapseIcon');
          if (drawerCard) {
            drawerCard.classList.add('collapsed');
            if (drawerIcon) drawerIcon.className = 'bi bi-chevron-up';
          }
        }

        const btnLocateMe = document.getElementById('btnLocateMe');
        const gpsToast = document.getElementById('gpsToast');
        const gpsToastText = document.getElementById('gpsToastText');
        const gpsToastSpinner = document.getElementById('gpsToastSpinner');

        if (btnLocateMe) {
          btnLocateMe.classList.add('is-locating');
          btnLocateMe.innerHTML = '<span class="spinner-border spinner-border-sm" style="width: 13px; height: 13px; border-width: 2px;"></span>';
        }

        if (gpsToast && gpsToastText && gpsToastSpinner) {
          gpsToastSpinner.style.display = 'inline-block';
          gpsToastText.textContent = 'Mengunci titik koordinat GPS presisi tinggi...';
          gpsToast.classList.add('show');
        }

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            const accuracy = pos.coords.accuracy;

            if (btnLocateMe) {
              btnLocateMe.classList.remove('is-locating');
              btnLocateMe.innerHTML = '<i class="bi bi-crosshair"></i>';
              btnLocateMe.style.color = 'var(--accent-cyan)';
            }

            const { matchedSls, matchedDesa, matchedKec } = findLocationSpatialHierarchy(lng, lat);

            let locationDesc = 'Posisi GPS Terkunci';
            const nmsls = matchedSls ? (matchedSls.properties.nmsls || matchedSls.properties.nama || ('SLS ' + matchedSls.properties.kode)) : '';
            const nmdesa = matchedDesa ? matchedDesa.properties.nmdesa : (matchedSls ? matchedSls.properties.nmdesa : '');
            const nmkec = matchedKec ? matchedKec.properties.nmkec : (matchedSls ? matchedSls.properties.nmkec : (matchedDesa ? matchedDesa.properties.nmkec : ''));

            if (nmsls && nmdesa) {
              locationDesc = `Desa ${nmdesa} &bull; ${nmsls}`;
            } else if (nmdesa) {
              locationDesc = `Desa ${nmdesa}, Kec. ${nmkec || ''}`;
            }

            if (gpsToast && gpsToastText && gpsToastSpinner) {
              gpsToastSpinner.style.display = 'none';
              gpsToastText.innerHTML = `<i class="bi bi-geo-alt-fill" style="color: #10b981;"></i> <strong>${locationDesc}</strong> (±${Math.round(accuracy)}m)`;
              setTimeout(() => {
                gpsToast.classList.remove('show');
              }, 4000);
            }

            if (userLocationMarker) map.removeLayer(userLocationMarker);
            if (userAccuracyCircle) map.removeLayer(userAccuracyCircle);

            const gpsIcon = L.divIcon({
              className: 'gps-user-marker',
              iconSize: [16, 16],
              iconAnchor: [8, 8]
            });

            const ptsInDesa = allPoints.filter(p => (p[11] && p[11].toUpperCase() === (nmdesa || '').toUpperCase()));
            let popupContent = `
              <div style="font-family: 'Inter', sans-serif; min-width: 220px; padding: 2px;">
                <div style="font-size: 12px; font-weight: 700; color: var(--accent-cyan); text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.03em;">
                  <i class="bi bi-crosshair"></i> Lokasi GPS Anda
                </div>
                <strong style="font-size: 14px; color: var(--text-primary); display: block; line-height: 1.4;">
                  ${nmsls ? nmsls : (nmdesa ? 'Desa ' + nmdesa : 'Kab. Penajam Paser Utara')}
                </strong>
                <span style="font-size: 12px; color: var(--text-secondary); display: block; margin-bottom: 4px; line-height: 1.4;">
                  ${nmdesa ? nmdesa + ', ' : ''}Kec. ${nmkec || 'PPU'}
                </span>
                <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 8px; line-height: 1.4;">
                  Akurasi: ±${Math.round(accuracy)}m | Uji Petik: <strong style="color: var(--text-primary);">${ptsInDesa.length.toLocaleString('id-ID')} titik</strong>
                </span>
                ${nmdesa ? `<button type="button" class="btn btn-primary btn-sm" onclick="selectScopeDesaDirect('${nmdesa}', '${nmkec || ''}')" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 5px; padding: 6px; font-size: 12px; font-weight: 700; border-radius: 8px;">
                  <i class="bi bi-geo-alt"></i> Fokus Titik Desa Ini
                </button>` : ''}
              </div>
            `;

            userLocationMarker = L.marker([lat, lng], { icon: gpsIcon }).addTo(map);
            if (window.innerWidth > 768) {
              userLocationMarker.bindPopup(popupContent).openPopup();
            }

            userAccuracyCircle = L.circle([lat, lng], {
              radius: accuracy,
              color: '#0284c7',
              fillColor: '#0284c7',
              fillOpacity: 0.12,
              weight: 1.5
            }).addTo(map);

            map.flyTo([lat, lng], 16, { animate: true, duration: 1.2 });
          },
          (err) => {
            if (btnLocateMe) {
              btnLocateMe.classList.remove('is-locating');
              btnLocateMe.innerHTML = '<i class="bi bi-crosshair"></i>';
            }
            if (gpsToast && gpsToastText && gpsToastSpinner) {
              gpsToastSpinner.style.display = 'none';
              gpsToastText.innerHTML = `<i class="bi bi-exclamation-circle-fill" style="color: #ef4444;"></i> Gagal Mengunci GPS (${err.message || 'Izin ditolak'})`;
              setTimeout(() => {
                gpsToast.classList.remove('show');
              }, 2600);
            }
          },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
      }

      const btnLocateMe = document.getElementById('btnLocateMe');
      if (btnLocateMe) btnLocateMe.addEventListener('click', locateUserGPS);

      // Fullscreen Command Center Mode
      function toggleFullscreenMap() {
        const wrapper = document.getElementById('gmapsWrapper');
        if (!wrapper) return;

        const isCurrentlyFullscreen = !!document.fullscreenElement || wrapper.classList.contains('is-fullscreen');

        if (!isCurrentlyFullscreen) {
          localStorage.setItem('se2026_ujipetik_fullscreen', 'true');
          if (wrapper.requestFullscreen) {
            wrapper.requestFullscreen().catch(() => {
              wrapper.classList.add('is-fullscreen');
            });
          } else if (wrapper.webkitRequestFullscreen) {
            wrapper.webkitRequestFullscreen();
          } else if (wrapper.msRequestFullscreen) {
            wrapper.msRequestFullscreen();
          } else {
            wrapper.classList.add('is-fullscreen');
          }
          if (btnFullscreenMap) {
            btnFullscreenMap.innerHTML = '<i class="bi bi-fullscreen-exit"></i>';
          }
        } else {
          localStorage.setItem('se2026_ujipetik_fullscreen', 'false');
