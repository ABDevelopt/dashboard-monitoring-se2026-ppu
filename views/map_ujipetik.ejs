        if (kecSelect && currentKec) {
          const targetKec = currentKec.toUpperCase();
          for (let i = 0; i < kecSelect.options.length; i++) {
            if (kecSelect.options[i].value.toUpperCase() === targetKec) {
              kecSelect.selectedIndex = i;
              break;
            }
          }
        }
        if (desaSelect) {
          populateDesaDropdown(currentKec || '');
