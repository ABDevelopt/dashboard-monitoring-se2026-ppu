      let loadFullPointsPromise = null;

      function loadPointsInBackground() {
        if (loadFullPointsPromise) return loadFullPointsPromise;

        loadFullPointsPromise = (async () => {
          try {
            const expectedTotal = summaryStats ? summaryStats.total : 0;
            let cached = null;

            if (expectedTotal > 0) {
              try {
                cached = await UjiPetikStorage.get('ujipetik_points_data');
              } catch (e) {
                console.warn('[UjiPetik] IndexedDB read error:', e);
              }
            }

            // If cached points exist and count matches current server total, load immediately from IndexedDB
            if (cached && cached.total === expectedTotal && Array.isArray(cached.points) && cached.points.length === expectedTotal) {
              allPoints = cached.points;
              console.log(`[UjiPetik] Loaded ${allPoints.length} points from IndexedDB cache (0ms network)`);
            } else if (expectedTotal > 0) {
              console.log('[UjiPetik] Fetching compressed points from /api/ujipetik-points...');
              const res = await fetch('/api/ujipetik-points');
              allPoints = await res.json();
              if (allPoints && allPoints.length > 0) {
                UjiPetikStorage.set('ujipetik_points_data', {
                  total: allPoints.length,
                  timestamp: Date.now(),
                  points: allPoints
                }).catch(err => console.warn('[UjiPetik] IndexedDB write error:', err));
              }
            } else {
              allPoints = [];
            }

            // Clear temporary scoped points once allPoints is ready
            currentScopedPoints = null;

            // Populate officers dropdown based on loaded allPoints
            populateOfficerDropdowns(currentKec, currentDesa, currentPml);

            // If a scope is currently active or points are displayed, refresh filters
            if (currentDesa || currentKec || currentPcl || currentPml || currentSearch || currentCatCode) {
              applyFilters();
            } else if (filteredPoints && filteredPoints.length > 0) {
              filteredPoints = allPoints;
              renderCanvas();
              updateCategoryPillCounts(filteredPoints);
            }

            // Handle Empty Database State
            if (!allPoints || allPoints.length === 0) {
              const placeholder = document.getElementById('drawerPlaceholder');
              if (placeholder) {
                placeholder.innerHTML = `
                  <div style="padding: 10px 4px; text-align: center;">
                    <i class="bi bi-inbox" style="font-size: 32px; color: var(--accent-amber); display: block; margin-bottom: 8px;"></i>
                    <strong style="font-size: 14px; color: var(--text-primary); display: block; margin-bottom: 4px;">Belum Ada Data Titik Uji Petik</strong>
                    <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 14px; line-height: 1.4;">
                      Peta ini secara default kosong. Admin dapat mengunggah file data CSV Titik Uji Petik melalui halaman Upload Data.
                    </span>
                    <a href="/admin/upload?tab=ujipetik" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; font-weight: 600; text-decoration: none; border-radius: 8px; font-size: 12px;">
                      <i class="bi bi-upload"></i> Upload File CSV Titik Uji Petik
                    </a>
                  </div>
                `;
              }
            }
          } catch (err) {
            console.error('[UjiPetik] Error loading points in background:', err);
          }
        })();

        return loadFullPointsPromise;
      }

      // Bootstrap & Load Data (Progressive: UI & Boundaries in <500ms, Points in Background)
      async function bootstrap() {
        const loading = document.getElementById('mapLoading');
        try {
          // Phase 1: Fast Critical Data (Stats + Kecamatan & Desa GeoJSON boundaries: ~550 KB gzip total)
          const [statsRes, desaGeoRes, kecGeoRes] = await Promise.all([
            fetch('/api/ujipetik-stats'),
            fetch('/data/desa_boundaries.geojson'),
            fetch('/data/kecamatan_boundaries.geojson')
          ]);

          summaryStats = await statsRes.json();
          desaGeoJson = await desaGeoRes.json();
          kecGeoJson = await kecGeoRes.json();

          // Guard against unmounted/destroyed map after async fetches
          if (!map || !map._container || !map._mapPane) return;
          populateDesaDropdown('');
          populateOfficerDropdowns('', '', '');
          setupBoundaryLayers();
          renderModalDesaGrid();

