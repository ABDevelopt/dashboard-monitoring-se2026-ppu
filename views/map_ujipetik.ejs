      function populateDesaDropdown(kecName) {
        const desaSelect = document.getElementById('desaFilter');
        if (!summaryStats || !summaryStats.desaStats || !desaSelect) return;

        let desas = summaryStats.desaStats;
        if (kecName) {
          desas = desas.filter(d => d.kecamatan && d.kecamatan.toUpperCase() === kecName.toUpperCase());
        }

        let html = '<option value="">-- Semua Desa / Kel --</option>';
        desas.forEach(d => {
          const countVal = d.total_titik !== undefined ? d.total_titik : (d.count || 0);
          const label = kecName ? `${d.desa} (${countVal.toLocaleString('id-ID')})` : `${d.desa} [${d.kecamatan}] (${countVal.toLocaleString('id-ID')})`;
          html += `<option value="${d.desa}">${label}</option>`;
        });
        desaSelect.innerHTML = html;
      }

      function populateOfficerDropdowns(scopedKec, scopedDesa, scopedPml) {
        const pclSelect = document.getElementById('pclFilter');
        const pmlSelect = document.getElementById('pmlFilter');

        const pts = (allPoints && allPoints.length > 0) ? allPoints : currentScopedPoints;

        let sortedPmls = [];
        let sortedPcls = [];

        if (pts && pts.length > 0) {
          let pList = pts;
          if (scopedKec) {
            const kUpper = scopedKec.toUpperCase().trim();
            const kNorm = kUpper.replace(/[\s\-_]/g, '');
            pList = pList.filter(p => {
              const k = (p[12] || '').toUpperCase();
              return k === kUpper || k.replace(/[\s\-_]/g, '') === kNorm;
            });
          }
          if (scopedDesa) {
            const dUpper = scopedDesa.toUpperCase().trim();
            const dNorm = dUpper.replace(/[\s\-_]/g, '');
            const isCode = /^\d{7,10}$/.test(dUpper);
            pList = pList.filter(p => {
              const d = (p[11] || '').toUpperCase();
              return d === dUpper || d.replace(/[\s\-_]/g, '') === dNorm || (isCode && (p[13] || '').startsWith(dUpper));
            });
          }

          // Extract unique PMLs in this area
          const pmlsInScope = new Set();
          pList.forEach(p => {
            if (p[8] && p[8].trim() !== '') pmlsInScope.add(p[8].trim());
          });
          sortedPmls = Array.from(pmlsInScope).sort((a, b) => a.localeCompare(b));

          // If a specific PML is selected, narrow PCLs to that PML's points
          let pclPts = pList;
          if (scopedPml) {
            const pmlLower = scopedPml.toLowerCase().trim();
            pclPts = pclPts.filter(p => p[8] && p[8].toLowerCase().trim() === pmlLower);
          }

          // Extract unique PCLs in this area (and under this PML if selected)
          const pclsInScope = new Set();
          pclPts.forEach(p => {
            if (p[7] && p[7].trim() !== '') pclsInScope.add(p[7].trim());
          });
          sortedPcls = Array.from(pclsInScope).sort((a, b) => a.localeCompare(b));
        } else if (summaryStats) {
          if (Array.isArray(summaryStats.pmls)) {
            sortedPmls = [...summaryStats.pmls].sort((a, b) => a.localeCompare(b));
          }
          if (Array.isArray(summaryStats.pcls)) {
            sortedPcls = [...summaryStats.pcls].sort((a, b) => a.localeCompare(b));
          }
        }


        if (pmlSelect) {
          const prevPml = pmlSelect.value;
          let html = '<option value="">-- Semua Pengawas PML --</option>';
          sortedPmls.forEach(p => {
            html += `<option value="${p}">${p}</option>`;
          });
          pmlSelect.innerHTML = html;
          if (prevPml && sortedPmls.includes(prevPml)) {
            pmlSelect.value = prevPml;
          } else {
            pmlSelect.value = '';
            currentPml = '';
          }
        }

        if (pclSelect) {
          const prevPcl = pclSelect.value;
          let html = '<option value="">-- Semua Petugas PCL --</option>';
          sortedPcls.forEach(p => {
            html += `<option value="${p}">${p}</option>`;
          });
          pclSelect.innerHTML = html;
          if (prevPcl && sortedPcls.includes(prevPcl)) {
            pclSelect.value = prevPcl;
          } else {
            pclSelect.value = '';
            currentPcl = '';
          }
        }
      }

      // Glowing Neon Boundary Style Functions
      function kecBoundaryStyle(feature) {
        const isSat = currentBasemapType === 'satellite';
        const isLight = document.body.classList.contains('light-mode');
        const p = (feature && feature.properties) || {};
        const name = (p.nmkec || p.kecamatan || p.WADMKC || p.nama || '').toUpperCase();
        const isSelected = !currentKec || name === currentKec.toUpperCase();

        const baseColor = isSat ? '#38bdf8' : (isLight ? '#0284c7' : '#38bdf8');
        const activeColor = isSat ? '#ffffff' : (isLight ? '#0f172a' : '#ffffff');

        return {
          fillColor: 'transparent',
          fillOpacity: 0,
          color: (isSelected && currentKec) ? activeColor : baseColor,
          weight: isSelected ? (currentKec ? 2.8 : 1.8) : 0.8,
          opacity: isSelected ? 0.95 : 0.40,
          fillRule: 'nonzero'
        };
      }

      function desaBoundaryStyle(feature) {
        const isSat = currentBasemapType === 'satellite';
        const isLight = document.body.classList.contains('light-mode');
        const p = (feature && feature.properties) || {};
        const dName = (p.nmdesa || p.desa || p.NAMOBJ || p.WADMKD || p.nama || '').toUpperCase();
        const kName = (p.nmkec || p.kecamatan || p.WADMKC || '').toUpperCase();
        const idDesa = p.iddesa || '';

        const isSelectedKec = !currentKec || kName === currentKec.toUpperCase();
        const isSelectedDesa = !currentDesa || dName === currentDesa.toUpperCase() || idDesa === currentDesa;
        const isMatch = isSelectedKec && isSelectedDesa;

        const baseColor = isSat ? '#38bdf8' : (isLight ? '#0284c7' : '#38bdf8');
        const activeColor = isSat ? '#ffffff' : (isLight ? '#0f172a' : '#ffffff');

        return {
          fillColor: 'transparent',
          fillOpacity: 0,
          color: (isMatch && currentDesa) ? activeColor : baseColor,
          weight: isMatch ? (currentDesa ? 2.5 : 1.3) : 0.6,
          opacity: isMatch ? 0.95 : 0.35,
          fillRule: 'nonzero'
        };
      }

      function slsBoundaryStyle(feature) {
        const isSat = currentBasemapType === 'satellite';
        const isLight = document.body.classList.contains('light-mode');
        const p = (feature && feature.properties) || {};
        const kName = (p.nmkec || '').toUpperCase();
        const dName = (p.nmdesa || '').toUpperCase();

        const isSelectedKec = !currentKec || kName === currentKec.toUpperCase();
        const isSelectedDesa = !currentDesa || dName === currentDesa.toUpperCase();
        const isMatch = isSelectedKec && isSelectedDesa;

        const baseColor = isSat ? '#38bdf8' : (isLight ? '#0284c7' : '#38bdf8');

        return {
          fillColor: 'transparent',
          fillOpacity: 0,
          color: baseColor,
          weight: isMatch ? 1.4 : 0.6,
          opacity: isMatch ? 0.90 : 0.30,
          fillRule: 'nonzero'
        };
      }

      function setupBoundaryLayers() {
        if (kecGeoJson && !kecLayer) {
          kecLayer = L.geoJSON(kecGeoJson, {
            renderer: boundaryCanvasRenderer,
            interactive: false,
            style: kecBoundaryStyle
          });
        }
        if (desaGeoJson && !desaLayer) {
          desaLayer = L.geoJSON(desaGeoJson, {
            renderer: boundaryCanvasRenderer,
            interactive: false,
            style: desaBoundaryStyle
          });
        }
        updateBoundaryLayerVisibility();
      }

      function setupSlsLayer() {
        if (slsGeoJson && !slsLayer) {
          slsLayer = L.geoJSON(slsGeoJson, {
            renderer: boundaryCanvasRenderer,
            interactive: false,
            style: slsBoundaryStyle
          });
        }
      }

      async function lazyLoadSlsGeoJSON() {
        if (slsGeoJson) {
          if (!slsLayer) setupSlsLayer();
          if (activeBoundaryLayer === 'sls' && slsLayer && !map.hasLayer(slsLayer)) {
            slsLayer.addTo(map);
            slsLayer.setStyle(slsBoundaryStyle);
          }
          return;
        }

        if (isSlsLoading) return;
        isSlsLoading = true;

        const btnLayerSls = document.getElementById('btnLayerSls');
        if (btnLayerSls) btnLayerSls.innerHTML = '<span class="spinner-border spinner-border-sm" style="width: 11px; height: 11px;"></span> SLS...';

        try {
          const res = await fetch('/data/sls_boundaries.geojson');
          slsGeoJson = await res.json();
          setupSlsLayer();
          if (activeBoundaryLayer === 'sls' && slsLayer && !map.hasLayer(slsLayer)) {
            slsLayer.addTo(map);
            slsLayer.setStyle(slsBoundaryStyle);
          }
        } catch (err) {
          console.error('Error loading SLS geojson:', err);
        } finally {
          isSlsLoading = false;
          if (btnLayerSls) btnLayerSls.innerHTML = '<i class="bi bi-pin-map"></i> SLS';
        }
      }

      function updateBoundaryLayerVisibility() {
        if (!map) return;
        if (kecLayer && map.hasLayer(kecLayer)) map.removeLayer(kecLayer);
        if (desaLayer && map.hasLayer(desaLayer)) map.removeLayer(desaLayer);
        if (slsLayer && map.hasLayer(slsLayer)) map.removeLayer(slsLayer);

        if (activeBoundaryLayer === 'kec') {
          if (kecLayer) {
            kecLayer.addTo(map);
            kecLayer.setStyle(kecBoundaryStyle);
          }
        } else if (activeBoundaryLayer === 'sls') {
          if (slsLayer) {
            slsLayer.addTo(map);
            slsLayer.setStyle(slsBoundaryStyle);
          } else {
            lazyLoadSlsGeoJSON();
          }
        } else {
          if (desaLayer) {
            desaLayer.addTo(map);
            desaLayer.setStyle(desaBoundaryStyle);
          }
        }
      }

