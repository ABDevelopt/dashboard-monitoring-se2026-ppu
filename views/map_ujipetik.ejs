      function zoomToKecamatan(kecName) {
        if (!kecName) return;
        currentKec = kecName;
        currentDesa = '';
        selectedPoint = null;
        if (map) map.closePopup();

        const kecSelect = document.getElementById('kecFilter');
        const desaSelect = document.getElementById('desaFilter');

        if (kecSelect) {
          const targetKec = kecName.toUpperCase();
          for (let i = 0; i < kecSelect.options.length; i++) {
            if (kecSelect.options[i].value.toUpperCase() === targetKec) {
              kecSelect.selectedIndex = i;
              break;
            }
          }
        }
        if (desaSelect) {
          populateDesaDropdown(currentKec);
          desaSelect.value = '';
        }

        populateOfficerDropdowns(currentKec, '', '');
        applyFilters();

        let matchedBounds = null;
        if (kecLayer) {
          kecLayer.eachLayer(l => {
            if (l.feature && l.feature.properties) {
              const p = l.feature.properties;
              const name = (p.nmkec || p.kecamatan || p.WADMKC || p.nama || '').toUpperCase();
              if (name === kecName.toUpperCase() || name.includes(kecName.toUpperCase())) {
                if (l.getBounds) matchedBounds = l.getBounds();
              }
            }
          });
        }
        if (matchedBounds) {
          map.fitBounds(matchedBounds, { padding: [35, 35] });
        } else if (filteredPoints && filteredPoints.length > 0) {
          const lats = filteredPoints.map(p => p[1]);
          const lngs = filteredPoints.map(p => p[2]);
          map.fitBounds([[Math.min(...lats), Math.min(...lngs)], [Math.max(...lats), Math.max(...lngs)]], { padding: [35, 35] });
        }
        updateScopeButtonLabel();
        updateMapBreadcrumbs('kec', kecName);
      };

      function zoomToDesa(desaName, kecName) {
