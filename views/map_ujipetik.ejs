              <span class="map-card-stat-label"><i class="bi bi-crosshair"></i> Koordinat GPS</span>
              <span class="map-card-stat-value" style="font-family: monospace; font-size: 11.5px;">${lat.toFixed(6)}, ${lng.toFixed(6)}</span>
