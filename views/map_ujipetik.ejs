<script>
  (function() {
    // Lightweight, promise-based IndexedDB Storage Helper for client-side caching of Uji Petik points
    const UjiPetikStorage = {
      DB_NAME: 'SE2026_UjiPetik_Cache',
      DB_VERSION: 1,
      STORE_NAME: 'points_store',
      _dbPromise: null,

      getDb() {
        if (this._dbPromise) return this._dbPromise;
        this._dbPromise = new Promise((resolve, reject) => {
          if (typeof window === 'undefined' || !window.indexedDB) {
            return reject(new Error('IndexedDB not supported'));
          }
          const req = indexedDB.open(this.DB_NAME, this.DB_VERSION);
          req.onupgradeneeded = (e) => {
            const db = e.target.result;
            if (!db.objectStoreNames.contains(this.STORE_NAME)) {
              db.createObjectStore(this.STORE_NAME);
            }
          };
          req.onsuccess = (e) => resolve(e.target.result);
          req.onerror = (e) => {
            this._dbPromise = null;
            reject(e.target.error || new Error('Failed to open IndexedDB'));
          };
          req.onblocked = () => {
            this._dbPromise = null;
            reject(new Error('IndexedDB open blocked'));
          };
        });
        return this._dbPromise;
      },

      async get(key) {
        try {
          const db = await this.getDb();
          return new Promise((resolve, reject) => {
            const tx = db.transaction(this.STORE_NAME, 'readonly');
            const store = tx.objectStore(this.STORE_NAME);
            const req = store.get(key);
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => reject(req.error);
            tx.onerror = () => reject(tx.error);
            tx.onabort = () => reject(tx.error);
          });
        } catch (err) {
          console.warn('[UjiPetikStorage] read error:', err);
          return null;
        }
      },

      async set(key, value) {
        try {
          const db = await this.getDb();
          return new Promise((resolve, reject) => {
            const tx = db.transaction(this.STORE_NAME, 'readwrite');
            const store = tx.objectStore(this.STORE_NAME);
            const req = store.put(value, key);
            req.onsuccess = () => resolve(true);
            req.onerror = () => reject(req.error);
            tx.oncomplete = () => resolve(true);
            tx.onerror = () => reject(tx.error);
            tx.onabort = () => reject(tx.error);
          });
        } catch (err) {
          console.warn('[UjiPetikStorage] write error:', err);
          return false;
        }
      },

      async clear() {
        try {
          const db = await this.getDb();
          return new Promise((resolve, reject) => {
            const tx = db.transaction(this.STORE_NAME, 'readwrite');
            const store = tx.objectStore(this.STORE_NAME);
            const req = store.clear();
            req.onsuccess = () => resolve(true);
            req.onerror = () => reject(req.error);
            tx.oncomplete = () => resolve(true);
            tx.onerror = () => reject(tx.error);
            tx.onabort = () => reject(tx.error);
          });
        } catch (err) {
          console.warn('[UjiPetikStorage] clear error:', err);
          return false;
        }
      }
    };

    function initUjiPetikMapPage() {
      if (typeof L === 'undefined') {
        setTimeout(initUjiPetikMapPage, 50);
        return;
      }

      const mapContainerEl = document.getElementById('map');
      if (!mapContainerEl) return;

      // State & Data holders
      let allPoints = [];
      let currentScopedPoints = null;
      let filteredPoints = [];
      let summaryStats = null;
      let desaGeoJson = null;
      let kecGeoJson = null;
      let slsGeoJson = null;
      let desaLayer = null;
      let kecLayer = null;
      let slsLayer = null;
      let activeBoundaryLayer = 'sls';
      let isSlsLoading = false;
      let selectedPoint = null;
      let currentBasemapType = 'satellite';
      let currentKec = '';
      let currentDesa = '';
      let currentPcl = '';
      let currentPml = '';
      let currentCatCode = '';
      let currentSearch = '';

      // GPS Live Tracker Holders
      let userLocationMarker = null;
      let userAccuracyCircle = null;

      function getCleanBuildingLabel(noBang, rawLabel, catName) {
        let l = String(rawLabel || '').trim();
        const nb = String(noBang || '').trim();

        if (nb && l) {
          if (l === nb) {
            return catName || 'Bangunan Fisik';
          }
          if (l.startsWith(nb)) {
            l = l.slice(nb.length).replace(/^[\s\-_:.)/\\]+/, '').trim();
          }
        }

        // Clean redundant prefixes
        l = l.replace(/^\(?(?:kode\s*\d+|non\s*respon)[^)]*\)?[\s\-_:.]*/i, '').trim();

        if (!l) {
          return catName || 'Bangunan Fisik';
        }
        return l;
      }

      // Clean previous map instance
      if (window._leafletUjiPetikMapInstance) {
        try { window._leafletUjiPetikMapInstance.remove(); } catch (_) {}
        window._leafletUjiPetikMapInstance = null;
      }

      const centerCoords = [-1.30, 116.65];
      const defaultZoom = 10;
      window._defaultUjiPetikCenter = centerCoords;
      window._defaultUjiPetikZoom = defaultZoom;

      if (mapContainerEl._leaflet_id) {
        mapContainerEl._leaflet_id = null;
      }
      mapContainerEl.innerHTML = '';

      const map = L.map('map', {
        zoomControl: false,
        maxZoom: 20,
        minZoom: 9
      }).setView(centerCoords, defaultZoom);
      window._leafletUjiPetikMapInstance = map;

      // Dedicated Canvas Renderer for vector boundary layers (SLS, Desa, Kecamatan)
      // Renders 1,042 SLS polygons onto an off-screen Canvas rather than creating 1,042 SVG DOM elements
      const boundaryCanvasRenderer = L.canvas({ padding: 0.5 });

      L.control.zoom({ position: 'bottomright' }).addTo(map);

      // Robust tile creation helper with fallback and overzoom protection
      const createRobustTileLayer = (primaryUrl, options = {}, fallbackUrl = null, fallbackMaxNativeZoom = 18) => {
        const layer = L.tileLayer(primaryUrl, options);
        if (fallbackUrl) {
          layer.on('tileerror', (e) => {
            if (e.tile && !e.tile.dataset.fallbackTried) {
              e.tile.dataset.fallbackTried = 'true';
              const coords = e.coords;
              if (coords) {
                let z = coords.z;
                let x = coords.x;
                let y = coords.y;
                if (z > fallbackMaxNativeZoom) {
                  const factor = Math.pow(2, z - fallbackMaxNativeZoom);
                  x = Math.floor(x / factor);
                  y = Math.floor(y / factor);
                  z = fallbackMaxNativeZoom;
                }
                e.tile.src = fallbackUrl
                  .replace('{z}', z)
                  .replace('{x}', x)
                  .replace('{y}', y);
              }
            }
          });
        }
        return layer;
      };

      const cartoKey = (typeof window.CARTO_API_KEY !== 'undefined' && window.CARTO_API_KEY) ? window.CARTO_API_KEY : ('<%= typeof cartoApiKey !== "undefined" ? cartoApiKey : "" %>');
      const cartoParam = cartoKey ? `?key=${encodeURIComponent(cartoKey)}` : '';

      const lightBasemap = createRobustTileLayer(
        `https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png${cartoParam}`,
        {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
          subdomains: 'abcd',
          maxZoom: 20,
          maxNativeZoom: 19,
          keepBuffer: 6,
          crossOrigin: true
        },
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        19
      );

      const darkBasemap = createRobustTileLayer(
        `https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png${cartoParam}`,
        {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
          subdomains: 'abcd',
          maxZoom: 20,
          maxNativeZoom: 19,
          keepBuffer: 6,
          crossOrigin: true
        },
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        19
      );

      const satelliteBasemap = createRobustTileLayer(
        'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
        {
          attribution: 'Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community',
          maxZoom: 20,
          maxNativeZoom: 18,
          keepBuffer: 6,
          crossOrigin: true
        }
      );

      const satelliteLabels = L.tileLayer(
        'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
        {
          maxZoom: 20,
          maxNativeZoom: 18,
          keepBuffer: 6,
          crossOrigin: true
        }
      );

      function updateBasemap() {
        const isLight = (document.body && document.body.classList.contains('light-mode')) || (document.documentElement && document.documentElement.classList.contains('light-mode'));
        let targetLayer = null;

        if (currentBasemapType === 'satellite') {
          targetLayer = satelliteBasemap;
          if (!map.hasLayer(satelliteLabels)) satelliteLabels.addTo(map);
          if (map.hasLayer(lightBasemap)) map.removeLayer(lightBasemap);
          if (map.hasLayer(darkBasemap)) map.removeLayer(darkBasemap);
        } else {
          if (map.hasLayer(satelliteLabels)) map.removeLayer(satelliteLabels);
          if (map.hasLayer(satelliteBasemap)) map.removeLayer(satelliteBasemap);

          if (isLight) {
            targetLayer = lightBasemap;
            if (map.hasLayer(darkBasemap)) map.removeLayer(darkBasemap);
          } else {
            targetLayer = darkBasemap;
            if (map.hasLayer(lightBasemap)) map.removeLayer(lightBasemap);
          }
        }

        if (!map.hasLayer(targetLayer)) targetLayer.addTo(map);
        targetLayer.bringToBack();
        if (typeof refreshBoundaryStyles === 'function') refreshBoundaryStyles();
      }
      updateBasemap();

      window.addEventListener('themechange', updateBasemap);

      // Basemap Buttons
      const btnBasemapDefault = document.getElementById('btnBasemapDefault');
      const btnBasemapSatellite = document.getElementById('btnBasemapSatellite');

      if (btnBasemapDefault && btnBasemapSatellite) {
        btnBasemapDefault.addEventListener('click', () => {
          btnBasemapSatellite.classList.remove('active');
          btnBasemapDefault.classList.add('active');
          currentBasemapType = 'default';
          updateBasemap();
        });
        btnBasemapSatellite.addEventListener('click', () => {
          btnBasemapDefault.classList.remove('active');
          btnBasemapSatellite.classList.add('active');
          currentBasemapType = 'satellite';
          updateBasemap();
        });
      }

      // Recalculate Map Size
      const invalidateSize = () => {
        try { if (map) map.invalidateSize(); } catch (_) {}
      };
      [50, 150, 300, 600].forEach(d => setTimeout(invalidateSize, d));
      window.addEventListener('resize', invalidateSize);

      // Color mapping
      const categoryColors = {
        1: '#f59e0b', // Usaha
        2: '#8b5cf6', // Campuran
        3: '#0284c7', // Tempat Tinggal
        4: '#10b981', // Ibadah / Organisasi
        5: '#3b82f6', // Pemerintah / Dinas
        6: '#64748b', // Bangunan Kosong / Rusak / Lainnya
        8: '#a855f7', // Panti / Lapas
        9: '#ef4444', // Non Respon
        0: '#94a3b8'  // Lainnya
      };

      const categoryLabels = {
        1: '1. Bangunan Khusus Usaha',
        2: '2. Bangunan Campuran',
        3: '3. Bangunan Tempat Tinggal',
        4: '4. Tempat Ibadah & Organisasi',
        5: '5. Kantor Pemerintah / Dinas',
        6: '6. Bangunan Kosong / Rusak / Lainnya',
        8: '8. Panti / Lapas / Barak',
        9: '9. Non Respon',
        0: 'Lainnya'
      };

      // ── ULTRA-FAST HARDWARE-ACCELERATED HTML5 CANVAS LAYER ─────────
      map.createPane('ujipetikPointsPane');
      const pointsPane = map.getPane('ujipetikPointsPane');
      pointsPane.style.zIndex = '450';
      pointsPane.style.pointerEvents = 'none';

      const canvas = document.createElement('canvas');
      canvas.className = 'leaflet-zoom-animated ujipetik-canvas-layer';
      pointsPane.appendChild(canvas);
      const ctx = canvas.getContext('2d', { alpha: true });

      // Floating Tooltip for Hover Visual Cue
      const hoverTooltipEl = document.createElement('div');
      hoverTooltipEl.id = 'mapPointHoverTooltip';
      hoverTooltipEl.className = 'map-point-hover-tooltip';
      hoverTooltipEl.style.display = 'none';
      map.getContainer().appendChild(hoverTooltipEl);

      const CLUSTER_ZOOM_THRESHOLD = 14;
      let cachedClusters = [];
      let cachedClusterZoom = -1;
      let cachedClusterPointsRef = null;
      let currentClusters = [];
      let visiblePointsCache = [];
      let hoveredPoint = null;
      let hoveredCluster = null;

      function getClustersForCurrentView(pts, zoom) {
        if (!pts || pts.length === 0) {
          cachedClusters = [];
          cachedClusterZoom = -1;
          cachedClusterPointsRef = null;
          return [];
        }

        const intZoom = Math.round(zoom);
        if (cachedClusterZoom === intZoom && cachedClusterPointsRef === pts && cachedClusters.length > 0) {
          return cachedClusters;
        }

        cachedClusterZoom = intZoom;
        cachedClusterPointsRef = pts;

        let gridSize = 75;
        if (intZoom <= 10) gridSize = 110;
        else if (intZoom <= 12) gridSize = 90;
        else if (intZoom === 13) gridSize = 75;

        const cells = {};

        for (let i = 0; i < pts.length; i++) {
          const p = pts[i];
          const lat = p[1];
          const lng = p[2];
          const worldPt = map.project([lat, lng], intZoom);
          const gx = Math.floor(worldPt.x / gridSize);
          const gy = Math.floor(worldPt.y / gridSize);
          const key = gx + '_' + gy;

          if (!cells[key]) {
            cells[key] = {
              points: [],
              sumLat: 0,
              sumLng: 0,
              catCounts: {}
            };
          }
          cells[key].points.push(p);
          cells[key].sumLat += lat;
          cells[key].sumLng += lng;
          const cat = p[3] || 0;
          cells[key].catCounts[cat] = (cells[key].catCounts[cat] || 0) + 1;
        }

        const clusters = [];
        for (const k in cells) {
          const c = cells[k];
          const count = c.points.length;
          const avgLat = c.sumLat / count;
          const avgLng = c.sumLng / count;

          let maxCat = 0;
          let maxCatCount = -1;
          for (const cat in c.catCounts) {
            if (c.catCounts[cat] > maxCatCount) {
              maxCatCount = c.catCounts[cat];
              maxCat = cat;
            }
          }

          clusters.push({
            lat: avgLat,
            lng: avgLng,
            latLng: L.latLng(avgLat, avgLng),
            count: count,
            points: c.points,
            dominantCat: maxCat,
            dominantColor: categoryColors[maxCat] || '#0284c7'
          });
        }

        cachedClusters = clusters;
        return clusters;
      }

      function drawClusterBubble(c, cx, cy, isHovered) {
        const count = c.count;

        let r = 14;
        if (count >= 500) r = 24;
        else if (count >= 100) r = 20;
        else if (count >= 30) r = 17;
        else if (count >= 10) r = 15;

        if (isHovered) r += 3;

        const baseColor = c.dominantColor || '#0284c7';

        // Outer glow halo
        ctx.beginPath();
        ctx.arc(cx, cy, r + 5, 0, Math.PI * 2);
        ctx.fillStyle = isHovered ? 'rgba(255, 255, 255, 0.40)' : 'rgba(2, 132, 199, 0.22)';
        ctx.fill();

        // Main circle
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.fillStyle = baseColor;
        ctx.fill();
        ctx.lineWidth = isHovered ? 2.5 : 1.8;
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();

        // Count Text
        ctx.fillStyle = '#ffffff';
        ctx.font = `700 ${r >= 20 ? 11.5 : (r >= 15 ? 10.5 : 9.5)}px 'Inter', sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        let displayCount = count.toString();
        if (count >= 1000) {
          displayCount = (count / 1000).toFixed(1).replace('.0', '') + 'K';
        }
        ctx.fillText(displayCount, cx, cy);
      }

      function renderCanvas() {
        if (!map || !filteredPoints) return;
        const size = map.getSize();
        if (size.x === 0 || size.y === 0) return;

        const dpr = window.devicePixelRatio || 1;
        const w = size.x;
        const h = size.y;

        if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
          canvas.style.width = w + 'px';
          canvas.style.height = h + 'px';
        }

        const topLeft = map.containerPointToLayerPoint([0, 0]);
        L.DomUtil.setPosition(canvas, topLeft);
        L.DomUtil.setTransform(canvas, topLeft, 1);

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, w, h);

        const zoom = map.getZoom();

        const b = map.getBounds().pad(0.08);
        const minLat = b.getSouth();
        const maxLat = b.getNorth();
        const minLng = b.getWest();
        const maxLng = b.getEast();

        if (zoom < CLUSTER_ZOOM_THRESHOLD) {
          visiblePointsCache = [];
          currentClusters = getClustersForCurrentView(filteredPoints, zoom);

          for (let i = 0; i < currentClusters.length; i++) {
            const c = currentClusters[i];
            if (c.lat < minLat || c.lat > maxLat || c.lng < minLng || c.lng > maxLng) continue;

            const pt = map.latLngToContainerPoint(c.latLng);
            if (pt.x < -35 || pt.x > w + 35 || pt.y < -35 || pt.y > h + 35) continue;
            const isHovered = hoveredCluster === c;

            if (c.count === 1) {
              const p = c.points[0];
              const cat = p[3] || 0;
              const col = categoryColors[cat] || '#94a3b8';
              ctx.beginPath();
              ctx.arc(pt.x, pt.y, isHovered ? 6 : 4, 0, Math.PI * 2);
              ctx.fillStyle = col;
              ctx.fill();
              ctx.lineWidth = 1.5;
              ctx.strokeStyle = '#ffffff';
              ctx.stroke();
            } else {
              drawClusterBubble(c, pt.x, pt.y, isHovered);
            }
          }
        } else {
          currentClusters = [];
          visiblePointsCache = [];

          let radius = 3.5;
          if (zoom >= 17) radius = 6.0;
          else if (zoom >= 16) radius = 5.0;
          else if (zoom >= 15) radius = 4.2;
          else if (zoom >= 14) radius = 3.4;

          const twoPi = Math.PI * 2;
          const len = filteredPoints.length;
          const buckets = { 1: [], 2: [], 3: [], 4: [], 5: [], 6: [], 8: [], 9: [], 0: [] };

          for (let i = 0; i < len; i++) {
            const p = filteredPoints[i];
            const lat = p[1];
            const lng = p[2];

            if (lat < minLat || lat > maxLat || lng < minLng || lng > maxLng) continue;

            const pt = map.latLngToContainerPoint([lat, lng]);
            if (pt.x < -15 || pt.x > w + 15 || pt.y < -15 || pt.y > h + 15) continue;

            visiblePointsCache.push(p);

            const cat = p[3] || 0;
            if (!buckets[cat]) buckets[cat] = [];
            buckets[cat].push(pt.x, pt.y);
          }

          for (const cat in buckets) {
            const coords = buckets[cat];
            if (!coords || coords.length === 0) continue;

            ctx.fillStyle = categoryColors[cat] || '#94a3b8';
            ctx.beginPath();
            const clen = coords.length;
            for (let j = 0; j < clen; j += 2) {
              const cx = coords[j];
              const cy = coords[j + 1];
              ctx.moveTo(cx + radius, cy);
              ctx.arc(cx, cy, radius, 0, twoPi);
            }
            ctx.fill();
          }

          const highlightPt = selectedPoint || hoveredPoint;
          if (highlightPt) {
            const hpt = map.latLngToContainerPoint([highlightPt[1], highlightPt[2]]);
            if (hpt.x >= -25 && hpt.x <= w + 25 && hpt.y >= -25 && hpt.y <= h + 25) {
              const hCat = highlightPt[3] || 0;
              const hColor = categoryColors[hCat] || '#0284c7';
              const hRad = radius + 3;

              ctx.beginPath();
              ctx.arc(hpt.x, hpt.y, hRad + 6, 0, twoPi);
              ctx.fillStyle = 'rgba(255, 255, 255, 0.40)';
              ctx.fill();

              ctx.beginPath();
              ctx.arc(hpt.x, hpt.y, hRad + 2.5, 0, twoPi);
              ctx.lineWidth = 3;
              ctx.strokeStyle = '#ffffff';
              ctx.stroke();

              ctx.beginPath();
              ctx.arc(hpt.x, hpt.y, hRad, 0, twoPi);
              ctx.fillStyle = hColor;
              ctx.fill();
            }
          }
        }

        ctx.restore();
      }

      map.on('zoomanim', (e) => {
        if (!map || !canvas) return;
        const scale = map.getZoomScale(e.zoom, map.getZoom());
        const originLatLng = map.containerPointToLatLng([0, 0]);
        const offset = map._latLngToNewLayerPoint(originLatLng, e.zoom, e.center);
        L.DomUtil.setTransform(canvas, offset, scale);
      });

      map.on('move viewreset resize zoom zoomend', renderCanvas);

      const hideHoverTooltip = () => {
        if (hoverTooltipEl) hoverTooltipEl.style.display = 'none';
        if (hoveredPoint || hoveredCluster) {
          hoveredPoint = null;
          hoveredCluster = null;
          if (map) map.getContainer().style.cursor = '';
          renderCanvas();
        }
      };

      map.on('movestart zoomstart dragstart', hideHoverTooltip);
      map.on('mouseout', hideHoverTooltip);

      // Fast Click & Tap Detection
      map.on('click', (e) => {
        hideHoverTooltip();
        if (!filteredPoints || filteredPoints.length === 0) return;

        const clickPt = e.containerPoint;
        const zoom = map.getZoom();
        const isTouch = (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) || ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);

        if (zoom < CLUSTER_ZOOM_THRESHOLD) {
          let clickedCluster = null;
          let minClusterDistSq = Infinity;
          const touchPadding = isTouch ? 10 : 0;

          for (let i = 0; i < currentClusters.length; i++) {
            const c = currentClusters[i];
            const pt = map.latLngToContainerPoint(c.latLng);
            const dx = pt.x - clickPt.x;
            const dy = pt.y - clickPt.y;
            const distSq = dx * dx + dy * dy;
            let hitR = (c.count >= 100 ? 26 : (c.count >= 30 ? 22 : 18)) + touchPadding;
            if (distSq <= hitR * hitR && distSq < minClusterDistSq) {
              minClusterDistSq = distSq;
              clickedCluster = c;
            }
          }

          if (clickedCluster) {
            if (clickedCluster.count === 1) {
              showPointDetails(clickedCluster.points[0]);
            } else {
              const bounds = L.latLngBounds(clickedCluster.points.map(p => [p[1], p[2]]));
              if (bounds.isValid() && bounds.getNorthEast().distanceTo(bounds.getSouthWest()) > 10) {
                map.flyToBounds(bounds, { maxZoom: 18, padding: [60, 60], duration: 0.8 });
              } else {
                map.flyTo([clickedCluster.points[0][1], clickedCluster.points[0][2]], Math.min(zoom + 3, 18), { duration: 0.8 });
              }
            }
            return;
          } else {
            selectedPoint = null;
            renderCanvas();
          }
        } else {
          const clickRadius = isTouch ? (zoom >= 16 ? 36 : (zoom >= 14 ? 28 : 22)) : (zoom >= 16 ? 24 : (zoom >= 14 ? 18 : 14));
          const clickRadiusSq = clickRadius * clickRadius;

          let closest = null;
          let minDistSq = clickRadiusSq;

          const ptsToTest = visiblePointsCache.length > 0 ? visiblePointsCache : filteredPoints;
          for (let i = 0; i < ptsToTest.length; i++) {
            const p = ptsToTest[i];
            const pt = map.latLngToContainerPoint([p[1], p[2]]);
            const dx = pt.x - clickPt.x;
            const dy = pt.y - clickPt.y;
            const distSq = dx * dx + dy * dy;
            if (distSq <= minDistSq) {
              minDistSq = distSq;
              closest = p;
            }
          }

          if (closest) {
            showPointDetails(closest);
          } else {
            selectedPoint = null;
            renderCanvas();
          }
        }
      });

      // Hover Visual Cue Tooltip (Desktop)
      let hoverTimer = null;
      map.on('mousemove', (e) => {
        if (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) return;
        if (hoverTimer) return;
        hoverTimer = setTimeout(() => {
          hoverTimer = null;
          if (!filteredPoints || filteredPoints.length === 0) {
            hideHoverTooltip();
            return;
          }

          const mousePt = e.containerPoint;
          const zoom = map.getZoom();

          if (zoom < CLUSTER_ZOOM_THRESHOLD) {
            let closestCluster = null;
            let minClusterDistSq = Infinity;

            for (let i = 0; i < currentClusters.length; i++) {
              const c = currentClusters[i];
              const pt = map.latLngToContainerPoint(c.latLng);
              const dx = pt.x - mousePt.x;
              const dy = pt.y - mousePt.y;
              const distSq = dx * dx + dy * dy;
              let hitR = c.count >= 100 ? 24 : (c.count >= 30 ? 20 : 16);
              if (distSq <= hitR * hitR && distSq < minClusterDistSq) {
                minClusterDistSq = distSq;
                closestCluster = c;
              }
            }

            if (closestCluster !== hoveredCluster) {
              hoveredCluster = closestCluster;
              renderCanvas();
            }

            if (hoveredCluster) {
              map.getContainer().style.cursor = 'pointer';
              if (hoveredCluster.count === 1) {
                const p = hoveredCluster.points[0];
                const catCode = p[3] || 0;
                const catName = categoryLabels[catCode] || 'Lainnya';
                const color = categoryColors[catCode] || '#94a3b8';
                const rawNb = p[6] ? String(p[6]).trim() : '';
                const cleanLabel = getCleanBuildingLabel(rawNb, p[5], catName);
                const title = rawNb ? `No. ${rawNb}` : '';
                hoverTooltipEl.innerHTML = `
                  <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: ${color}; margin-right: 6px; flex-shrink: 0;"></span>
                  ${title ? `<strong>${title}</strong> &bull; ` : ''}<span>${cleanLabel}</span> <span style="opacity: 0.85; font-size: 12px; margin-left: 4px;">(${catName})</span>
                `;
              } else {
                hoverTooltipEl.innerHTML = `
                  <i class="bi bi-grid-fill text-cyan" style="margin-right: 6px;"></i>
                  <strong>${hoveredCluster.count.toLocaleString('id-ID')} Titik Uji Petik</strong>
                  <span style="opacity: 0.85; font-size: 12px; margin-left: 6px;">(Klik untuk zoom)</span>
                `;
              }
              hoverTooltipEl.style.display = 'flex';
              const tipW = hoverTooltipEl.offsetWidth || 180;
              const mapW = map.getContainer().offsetWidth;
              const mapH = map.getContainer().offsetHeight;
              let posX = mousePt.x + 14;
              let posY = mousePt.y - 12;
              if (posX + tipW > mapW - 14) posX = mousePt.x - tipW - 14;
              if (posY < 10) posY = 10;
              if (posY > mapH - 45) posY = mapH - 45;
              hoverTooltipEl.style.left = posX + 'px';
              hoverTooltipEl.style.top = posY + 'px';
            } else {
              map.getContainer().style.cursor = '';
              hoverTooltipEl.style.display = 'none';
            }
          } else {
            const hoverRadius = zoom >= 16 ? 22 : (zoom >= 14 ? 16 : 12);
            const hoverRadiusSq = hoverRadius * hoverRadius;

            let closest = null;
            let minDistSq = hoverRadiusSq;

            const ptsToTest = visiblePointsCache.length > 0 ? visiblePointsCache : filteredPoints;
            for (let i = 0; i < ptsToTest.length; i++) {
              const p = ptsToTest[i];
              const pt = map.latLngToContainerPoint([p[1], p[2]]);
              const dx = pt.x - mousePt.x;
              const dy = pt.y - mousePt.y;
              const distSq = dx * dx + dy * dy;
              if (distSq <= minDistSq) {
                minDistSq = distSq;
                closest = p;
              }
            }

            if (closest !== hoveredPoint) {
              hoveredPoint = closest;
              renderCanvas();
            }

            if (hoveredPoint) {
              map.getContainer().style.cursor = 'pointer';
              const catCode = hoveredPoint[3] || 0;
              const catName = categoryLabels[catCode] || 'Lainnya';
              const color = categoryColors[catCode] || '#94a3b8';
              const rawNb = hoveredPoint[6] ? String(hoveredPoint[6]).trim() : '';
              const cleanLabel = getCleanBuildingLabel(rawNb, hoveredPoint[5], catName);
              const title = rawNb ? `No. ${rawNb}` : '';

              hoverTooltipEl.innerHTML = `
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: ${color}; margin-right: 6px; flex-shrink: 0;"></span>
                ${title ? `<strong>${title}</strong> &bull; ` : ''}<span>${cleanLabel}</span> <span style="opacity: 0.85; font-size: 12px; margin-left: 4px;">(${catName})</span>
              `;
              hoverTooltipEl.style.display = 'flex';
              const tipW = hoverTooltipEl.offsetWidth || 180;
              const mapW = map.getContainer().offsetWidth;
              const mapH = map.getContainer().offsetHeight;
              let posX = mousePt.x + 14;
              let posY = mousePt.y - 12;
              if (posX + tipW > mapW - 14) posX = mousePt.x - tipW - 14;
              if (posY < 10) posY = 10;
              if (posY > mapH - 45) posY = mapH - 45;
              hoverTooltipEl.style.left = posX + 'px';
              hoverTooltipEl.style.top = posY + 'px';
            } else {
              map.getContainer().style.cursor = '';
              hoverTooltipEl.style.display = 'none';
            }
          }
        }, 16);
      });

      // Show Point Details in Drawer & Popup
      function showPointDetails(p) {
        const id = p[0];
        const lat = p[1];
        const lng = p[2];
        const catCode = p[3];
        const isKosong = p[4];
        const label = p[5];
        const noBang = p[6];
        const pcl = p[7];
        const pml = p[8];
        const korlap = p[9];
