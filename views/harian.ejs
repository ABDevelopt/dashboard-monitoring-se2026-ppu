<div class="fade-in">
  <% if (!uploadId) { %>
    <div class="card empty-state">
      <div class="empty-state-icon"><i class="bi bi-calendar2-week"></i></div>
      <div class="empty-state-title">Belum Ada Data Progres Harian</div>
      <div class="empty-state-text">Upload file Excel hasil pendataan untuk mulai memantau perkembangan progres harian setiap petugas lapangan.</div>
      <a href="/admin/upload" class="empty-state-action"><i class="bi bi-cloud-arrow-up-fill"></i> Upload Data Sekarang</a>
    </div>
  <% } else { %>
    <div id="ajax-container">

    <!-- FILTER BAR -->
    <div class="card">
      <div class="card-header" style="margin-bottom: 8px; padding-bottom: 8px;">
        <div class="card-title"><i class="bi bi-search"></i> Filter Pencarian Progres Harian</div>
        <a href="/harian" class="btn btn-secondary btn-xs"><i class="bi bi-arrow-repeat"></i> Reset Filter</a>
      </div>
      
      <form action="/harian" method="GET" id="filterForm">
        <div class="filter-form-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: 10px;">
          
          <div>
            <label for="filterKec" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">Kecamatan</label>
            <select id="filterKec" name="kec" style="width:100%;">
              <option value="">-- Semua Kecamatan --</option>
              <% kecList.forEach(k => { %>
                <option value="<%= k.kecamatan %>" <%= filterKec === k.kecamatan ? 'selected' : '' %>><%= k.kecamatan %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="filterKorlap" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">Koordinator Lapangan</label>
            <select id="filterKorlap" name="korlap" style="width:100%;">
              <option value="">-- Semua Korlap --</option>
              <% korlapList.forEach(k => { %>
                <option value="<%= k.korlap %>" <%= filterKorlap === k.korlap ? 'selected' : '' %>><%= k.korlap %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="filterPml" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">PML (Pengawas)</label>
            <select id="filterPml" name="pml" style="width:100%;">
              <option value="">-- Semua PML --</option>
              <% pmlList.forEach(p => { %>
                <option value="<%= p.pml %>" <%= filterPml === p.pml ? 'selected' : '' %>><%= p.pml %></option>
              <% }) %>
            </select>
          </div>

        </div>
      </form>
    </div>

    <!-- TABEL PROGRES HARIAN PETUGAS (5 HARI TERAKHIR) -->
    <div class="card mt-4">
      <div class="card-header">
        <div class="card-title"><i class="bi bi-calendar3"></i> Progres Harian Petugas (5 Hari Terakhir)</div>
      </div>

      <div class="search-wrap mb-4" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <input type="search" id="harianSearch" placeholder="Cari nama petugas/PML..." aria-label="Cari nama petugas atau PML" style="width: 100%; max-width: 280px;">
        <div style="font-size: 11px; color: var(--text-muted); font-weight: 500;">
          <span class="badge badge-purple-soft" style="font-size: 9px; padding: 2px 6px;"><i class="bi bi-file-earmark-plus-fill"></i> Penambahan Dokumen / Hari (Akumulasi)</span>
        </div>
      </div>

      <% if (typeof harianStats !== 'undefined' && harianStats && harianStats.length > 0 && typeof recentUploads !== 'undefined' && recentUploads && recentUploads.length > 0) { %>
        <div class="table-wrap" style="max-height: 600px; overflow-y: auto;">
          <table id="harianTable">
            <thead>
              <tr>
                <th class="text-center" style="width: 40px;">No</th>
                <th>Nama Petugas</th>
                <th>Nama PML</th>
                <th>Kecamatan</th>
                <th>Desa</th>
                <th>Wilayah Kerja SLS</th>
                <% recentUploads.forEach(u => { %>
                  <th class="text-right" style="width: 125px; vertical-align: top;">
                    <div style="font-weight: 700; display: flex; align-items: center; justify-content: flex-end; gap: 4px;">
                      <%= new Date(u.tanggal).toLocaleDateString('id-ID', {day: 'numeric', month: 'short'}) %>
                      <% if (u.session_count && u.session_count > 1) { %>
                        <span class="badge badge-blue" onclick="openIntradayModal('<%= u.tanggal %>')" style="cursor: pointer; font-size: 8px; padding: 1px 4px; border-radius: 4px;" title="Ada <%= u.session_count %> kali upload di tanggal ini. Klik untuk lihat rincian intra-day."><i class="bi bi-clock-history"></i> <%= u.session_count %>x</span>
                      <% } %>
                    </div>
                    <% if (u.weather) { %>
                      <div style="font-size: 10px; font-weight: 500; color: var(--text-muted); margin-top: 4px; display: flex; align-items: center; justify-content: flex-end; gap: 4px;" class="weather-th-badge">
                        <% 
                          let iconHTML = '';
                          let desc = '';
                          switch (u.weather.code) {
                            case 0:
                              iconHTML = '<i class="bi bi-sun-fill" style="color: #fbbf24;" title="Cerah"></i>'; break;
                            case 1:
                            case 2:
                              iconHTML = '<i class="bi bi-cloud-sun-fill" style="color: #f59e0b;" title="Cerah Berawan"></i>'; break;
                            case 3:
                              iconHTML = '<i class="bi bi-cloud-fill" style="color: #94a3b8;" title="Berawan"></i>'; break;
                            case 45: case 48:
                              iconHTML = '<i class="bi bi-cloud-fog2-fill" style="color: #cbd5e1;" title="Kabut"></i>'; break;
                            case 51: case 53: case 55: case 56: case 57:
                              iconHTML = '<i class="bi bi-cloud-drizzle-fill" style="color: #60a5fa;" title="Gerimis"></i>'; break;
                            case 61: case 63:
                              iconHTML = '<i class="bi bi-cloud-rain-fill" style="color: #3b82f6;" title="Hujan Ringan"></i>'; break;
                            case 65: case 80: case 81: case 82:
                              iconHTML = '<i class="bi bi-cloud-rain-heavy-fill" style="color: #2563eb;" title="Hujan"></i>'; break;
                            case 95: case 96: case 99:
                              iconHTML = '<i class="bi bi-cloud-lightning-rain-fill" style="color: #ef4444;" title="Hujan Badai"></i>'; break;
                            default:
                              iconHTML = '<i class="bi bi-cloud-sun-fill" style="color: #f59e0b;" title="Cerah Berawan"></i>';
                          }
                        %>
                        <%- iconHTML %>
                        <span style="font-size: 9px;"><%= Math.round(u.weather.temp) %>°C</span>
                      </div>
                    <% } %>
                  </th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
              <% harianStats.forEach((row, idx) => { %>
                <tr>
                  <td class="text-center" style="font-weight: 600; background: var(--bg-subtle);"><%= idx + 1 %></td>
                  <td class="td-primary"><a href="/pcl?pcl=<%= encodeURIComponent(row.nama_petugas) %>"><%= row.nama_petugas %></a></td>
                  <td><%= row.nama_pml %></td>
                  <td><%= row.kecamatan %></td>
                  <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= row.desa %>">
                    <%= row.desa %>
                  </td>
                  <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= row.wilayah_kerja %>">
                    <%= row.wilayah_kerja %>
                  </td>
                  <% recentUploads.forEach((u, i) => { %>
                    <% 
                      const inc = row['inc_' + i] || 0;
                      const real = row['real_' + i] || 0;
                    %>
                    <td class="text-right fw-bold" data-sort="<%= inc %>" style="color: <%= inc > 0 ? 'var(--accent-green)' : 'var(--text-muted)' %>">
                      <% if (inc > 0) { %>
                        +<%= inc.toLocaleString('id-ID') %> <span style="font-size: 9px; font-weight: 500; color: var(--text-secondary); opacity: 0.85;">(<%= real.toLocaleString('id-ID') %>)</span>
                      <% } else if (real > 0) { %>
                        0 <span style="font-size: 9px; font-weight: 500; color: var(--text-secondary); opacity: 0.85;">(<%= real.toLocaleString('id-ID') %>)</span>
                      <% } else { %>
                        <span style="color: var(--text-muted); font-weight: 400;">0</span>
                      <% } %>
                    </td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state compact">
          <div class="empty-state-icon"><i class="bi bi-calendar-x"></i></div>
          <div class="empty-state-title">Tidak Ada Data Progres</div>
          <div class="empty-state-text">Tidak ada data yang cocok dengan filter yang dipilih. Coba ubah rentang tanggal atau filter lainnya.</div>
        </div>
      <% } %>
    </div>

    </div>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('ajax-container');
  if (!container) return;

  function attachListeners() {
    // 1. Initialize sorting and searching on the table
    makeTableSortable('harianTable');
    makeTableSearchable('harianSearch', 'harianTable');

    // 2. Initialize table export buttons
    if (window.initTableExport) {
      window.initTableExport(container);
    }

    // 3. Filter form submits (updates the whole container)
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
      const selects = filterForm.querySelectorAll('select');
      selects.forEach(sel => {
        sel.addEventListener('change', () => {
          fetchAndReplace(new URLSearchParams(new FormData(filterForm)).toString());
        });
      });
      
      const resetBtn = container.querySelector('a[href="/harian"]');
      if (resetBtn) {
        resetBtn.addEventListener('click', (e) => {
          e.preventDefault();
          fetchAndReplace('');
        });
      }
    }
  }

  function fetchAndReplace(queryString) {
    const url = '/harian' + (queryString ? (queryString.startsWith('?') ? queryString : '?' + queryString) : '');
    const ajaxContainer = document.getElementById('ajax-container');
    ajaxContainer.style.opacity = '0.5';
    ajaxContainer.style.pointerEvents = 'none';
    
    fetch(url)
      .then(res => res.text())
      .then(html => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const newContainer = doc.getElementById('ajax-container');
        if (newContainer) {
          ajaxContainer.innerHTML = newContainer.innerHTML;
          history.pushState(null, '', url);
          attachListeners();
        }
      })
      .catch(err => console.error(err))
      .finally(() => {
        ajaxContainer.style.opacity = '1';
        ajaxContainer.style.pointerEvents = 'auto';
      });
  }

  attachListeners();
  
  window.addEventListener('popstate', () => {
    fetchAndReplace(window.location.search);
  });
});

function openIntradayModal(tanggal) {
  const modal = document.getElementById('intradayModal');
  if (!modal) return;
  modal.style.display = 'flex';
  document.getElementById('intradayModalDate').textContent = tanggal;

  fetch(`/api/detail/intraday-candlestick?tanggal=${encodeURIComponent(tanggal)}`)
    .then(res => res.json())
    .then(res => {
      if (!res.success || !res.data) return;
      const data = res.data;
      
      const firstSessionDelta = data.sessions && data.sessions.length > 0 ? (data.sessions[0].delta || 0) : 0;
      const peakDelta = data.sessions && data.sessions.length > 0 ? Math.max(...data.sessions.map(s => s.delta || 0)) : 0;
      const lastSessionDelta = data.sessions && data.sessions.length > 0 ? (data.sessions[data.sessions.length - 1].delta || 0) : 0;

      document.getElementById('ohlcOpen').textContent = `+${firstSessionDelta.toLocaleString('id-ID')}`;
      document.getElementById('ohlcHigh').textContent = `+${peakDelta.toLocaleString('id-ID')}`;
      document.getElementById('ohlcLow').textContent = `+${lastSessionDelta.toLocaleString('id-ID')}`;
      document.getElementById('ohlcClose').textContent = (data.ohlc.close || 0).toLocaleString('id-ID');

      if (typeof createIntradayCandlestickChart === 'function') {
        createIntradayCandlestickChart('intradayChartCanvas', data);
      }

      const tbody = document.getElementById('intradayTableBody');
      tbody.innerHTML = data.sessions.map(s => `
        <tr>
          <td><strong style="color: var(--accent-cyan);"><i class="bi bi-clock"></i> ${s.time} WIB</strong></td>
          <td><span class="badge badge-gray">#${s.upload_id}</span></td>
          <td class="text-right">${s.submitted_total.toLocaleString('id-ID')}</td>
          <td class="text-right">${s.approved_total.toLocaleString('id-ID')}</td>
          <td class="text-right">${s.rejected_total.toLocaleString('id-ID')}</td>
          <td class="text-right">${s.draft_total.toLocaleString('id-ID')}</td>
          <td class="text-right fw-bold">${s.selesai_total.toLocaleString('id-ID')}</td>
          <td class="text-right fw-bold" style="color: ${s.delta > 0 ? 'var(--accent-green)' : 'var(--text-muted)'};">+${s.delta.toLocaleString('id-ID')}</td>
        </tr>
      `).join('');
    })
    .catch(err => console.error(err));
}

function closeIntradayModal() {
  const modal = document.getElementById('intradayModal');
  if (modal) modal.style.display = 'none';
}
</script>

<!-- MODAL INTRADAY DRILLDOWN LINE CHART -->
<div id="intradayModal" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
  <div class="card" style="width: 100%; max-width: 860px; max-height: 90vh; overflow-y: auto; margin: 0; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); border-radius: 12px; background: var(--bg-card);">
    <div class="card-header flex-between" style="border-bottom: 1px solid var(--border); padding-bottom: 12px;">
      <div class="card-title" style="font-size: 14px; font-weight: 700;">
        <i class="bi bi-graph-up-arrow" style="color: var(--accent-cyan);"></i> Tren Penambahan Intra-Day Sesi Upload (<span id="intradayModalDate">-</span>)
      </div>
      <button type="button" onclick="closeIntradayModal()" style="background: none; border: none; font-size: 22px; color: var(--text-muted); cursor: pointer; line-height: 1;">&times;</button>
    </div>

    <!-- Summary Metrics Line Chart -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 14px; margin-bottom: 14px;" id="intradayOhlcCards">
      <div style="background: var(--bg-subtle); padding: 10px; border-radius: 8px; border: 1px solid var(--border);">
        <div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">Sesi Pertama</div>
        <div id="ohlcOpen" style="font-size: 15px; font-weight: 700; color: #3b82f6;">-</div>
      </div>
      <div style="background: var(--bg-subtle); padding: 10px; border-radius: 8px; border: 1px solid var(--border);">
        <div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">Penambahan Puncak</div>
        <div id="ohlcHigh" style="font-size: 15px; font-weight: 700; color: #10b981;">-</div>
      </div>
      <div style="background: var(--bg-subtle); padding: 10px; border-radius: 8px; border: 1px solid var(--border);">
        <div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">Sesi Terakhir</div>
        <div id="ohlcLow" style="font-size: 15px; font-weight: 700; color: #f59e0b;">-</div>
      </div>
      <div style="background: var(--bg-subtle); padding: 10px; border-radius: 8px; border: 1px solid var(--border);">
        <div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">Total Akumulasi</div>
        <div id="ohlcClose" style="font-size: 15px; font-weight: 700; color: #06b6d4;">-</div>
      </div>
    </div>

    <!-- Intra-Day Chart Container -->
    <div style="height: 260px; position: relative; margin-bottom: 16px;">
      <canvas id="intradayChartCanvas"></canvas>
    </div>

    <!-- Table Details per Session -->
    <div class="table-wrap" style="max-height: 220px; overflow-y: auto;">
      <table>
        <thead>
          <tr>
            <th>Jam Upload</th>
            <th>ID Upload</th>
            <th class="text-right">Submitted</th>
            <th class="text-right">Approved</th>
            <th class="text-right">Rejected</th>
            <th class="text-right">Draft</th>
            <th class="text-right">Total Selesai</th>
            <th class="text-right">Penambahan (+Delta)</th>
          </tr>
        </thead>
        <tbody id="intradayTableBody">
          <!-- Dynamic JS -->
        </tbody>
      </table>
    </div>
  </div>
</div>
