      box-shadow: 0 12px 28px -8px rgba(66, 133, 244, 0.25);
    }

    .gemini-card-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .gemini-card-icon.blue { background: rgba(66, 133, 244, 0.12); color: #4285F4; }
    .gemini-card-icon.red { background: rgba(239, 68, 68, 0.12); color: #ef4444; }
    .gemini-card-icon.purple { background: rgba(155, 114, 203, 0.12); color: #9b72cb; }
    .gemini-card-icon.green { background: rgba(16, 185, 129, 0.12); color: #10b981; }

    .gemini-card-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .gemini-card-desc {
      font-size: 11px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Gemini Pill Input Box */
    .gemini-input-bar {
      background: var(--bg-secondary);
      border: 1.5px solid var(--border);
      border-radius: 30px;
      padding: 4px 6px 4px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-sizing: border-box;
      max-width: 860px;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .gemini-input-bar:focus-within {
      border-color: #4285F4;
      box-shadow: 0 0 0 3px rgba(66, 133, 244, 0.2), 0 8px 24px rgba(0, 0, 0, 0.18);
      background: var(--bg-card);
    }

    .gemini-input {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--text-primary);
      padding: 9px 0 7px 0;
      margin: 0;
      font-size: 14px;
      line-height: 1.35;
      outline: none;
      resize: none;
      height: 38px;
      min-height: 38px;
      max-height: 120px;
      font-family: inherit;
      box-sizing: border-box;
    }

    .gemini-input::placeholder {
      color: var(--text-muted);
    }

    .gemini-send-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(135deg, #4285F4 0%, #9b72cb 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 12px rgba(66, 133, 244, 0.3);
      padding: 0;
    }

    .gemini-send-btn i {
      font-size: 15px;
      line-height: 1;
      display: inline-block;
      margin-top: 2px;
      margin-left: -1px;
    }

    .gemini-send-btn:hover {
      transform: scale(1.06);
      box-shadow: 0 6px 18px rgba(66, 133, 244, 0.45);
    }

    .gemini-send-btn:active {
      transform: scale(0.94);
    }
    .chat-input::placeholder {
      color: var(--text-muted);
    }
    .chat-input-area button {
      height: 40px;
      padding: 0 18px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }
    
    /* Typing Loader */
    .typing-loader {
      display: flex;
      gap: 5px;
      padding: 4px 0;
      align-items: center;
      height: 24px;
    }
    .typing-dot {
      width: 7px;
      height: 7px;
      background: var(--text-muted);
      border-radius: 50%;
      animation: typing-bounce 1.4s infinite ease-in-out both;
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.2);
    }
    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }
    @keyframes typing-bounce {
      0%, 80%, 100% { 
        transform: scale(0.8);
        opacity: 0.5;
      }
      40% { 
        transform: scale(1.2);
        opacity: 1;
      }
    }
    
    /* Loading indicator */
    .loading-spinner {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-top-color: var(--accent-blue);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-right: 8px;
      vertical-align: middle;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
