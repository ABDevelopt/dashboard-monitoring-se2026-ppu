  window.copyChatMessage = function(btn) {
    const messageDiv = btn.closest('.message');
    if (!messageDiv) return;
    const bubble = messageDiv.querySelector('.message-bubble');
    if (!bubble) return;

    const textToCopy = bubble.innerText || bubble.textContent;
    if (!textToCopy) return;

    const showCopiedFeedback = () => {
      const icon = btn.querySelector('i');
      if (icon) {
        const origClass = icon.className;
        icon.className = 'bi bi-check2 text-green';
        btn.title = 'Tersalin!';
        setTimeout(() => {
          icon.className = origClass;
          btn.title = 'Salin Pesan';
        }, 1800);
      }
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(textToCopy.trim()).then(showCopiedFeedback).catch(() => {
        fallbackCopyText(textToCopy.trim());
        showCopiedFeedback();
      });
    } else {
      fallbackCopyText(textToCopy.trim());
      showCopiedFeedback();
    }
  };

  function fallbackCopyText(text) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try { document.execCommand('copy'); } catch (_) {}
    document.body.removeChild(textarea);
  }

  window.resendUserMessage = function(btn) {
    const messageDiv = btn.closest('.message.user');
    if (!messageDiv) return;
    const bubble = messageDiv.querySelector('.message-bubble');
    if (!bubble) return;
    
    const text = bubble.innerText || bubble.textContent;
    const chatInput = document.getElementById('chatInput');
    
    if (chatInput) {
      chatInput.value = text.trim();
      chatInput.style.height = 'auto';
      chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
      chatInput.focus();
      chatInput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  };

  function appendMessage(sender, content, isHtml = false) {
    const container = document.getElementById('chatMessages');
    const msgDiv = document.createElement('div');
    msgDiv.className = `message ${sender}`;
    
    const bodyDiv = document.createElement('div');
    bodyDiv.className = 'message-body';
    
    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    
    if (isHtml) {
      bubble.innerHTML = content;
    } else {
      bubble.textContent = content;
    }
    
    bodyDiv.appendChild(bubble);
    msgDiv.appendChild(bodyDiv);

    if (sender === 'user') {
      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'user-message-actions';
      actionsDiv.innerHTML = `
        <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Pesan">
          <i class="bi bi-copy"></i>
        </button>
        <button type="button" class="chat-action-icon-btn" onclick="window.resendUserMessage(this)" title="Kirim Ulang Pesan">
          <i class="bi bi-arrow-repeat"></i>
        </button>
      `;
      msgDiv.appendChild(actionsDiv);
    } else {
      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'agent-message-actions';
      actionsDiv.innerHTML = `
        <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Jawaban">
          <i class="bi bi-copy"></i>
        </button>
      `;
      msgDiv.appendChild(actionsDiv);
    }

    container.appendChild(msgDiv);
    container.scrollTop = container.scrollHeight;
    return msgDiv;
  }

  // Synchronous append message helper to prevent thread paint delays
  function appendMessageAsync(sender, replyText) {
    return new Promise((resolve) => {
      const container = document.getElementById('chatMessages');
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${sender}`;

      const bodyDiv = document.createElement('div');
      bodyDiv.className = 'message-body';

      const bubble = document.createElement('div');
      bubble.className = 'message-bubble';

      bodyDiv.appendChild(bubble);
      msgDiv.appendChild(bodyDiv);

      if (sender === 'user') {
        bubble.innerHTML = renderMarkdown(replyText);
        
        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'user-message-actions';
        actionsDiv.innerHTML = `
          <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Pesan">
            <i class="bi bi-copy"></i>
          </button>
          <button type="button" class="chat-action-icon-btn" onclick="window.resendUserMessage(this)" title="Kirim Ulang Pesan">
            <i class="bi bi-arrow-repeat"></i>
          </button>
        `;
        msgDiv.appendChild(actionsDiv);

        container.appendChild(msgDiv);
        container.scrollTop = container.scrollHeight;
        resolve(msgDiv);
        return;
      }

      container.appendChild(msgDiv);
      container.scrollTop = container.scrollHeight;

      // Pre-render blocks to avoid repeating O(N^2) Markdown parsing in animation frames
      const blocksHtml = renderMarkdownBlocks(replyText);
      let blockIndex = 0;

      // Append blocks progressively with a smooth transition, completely lag-free
      function appendNextBlock() {
        if (blockIndex < blocksHtml.length) {
          const block = document.createElement('div');
          block.style.opacity = '0';
          block.style.transition = 'opacity 0.15s ease-out';
          block.innerHTML = blocksHtml[blockIndex];
          
          bubble.appendChild(block);
          
          // Trigger reflow
          block.offsetHeight;
          block.style.opacity = '1';
          
          container.scrollTop = container.scrollHeight;
          blockIndex++;
          
          // Dynamic delay (shorter if there are many blocks to complete in reasonable time)
          const delay = Math.max(30, Math.min(100, Math.ceil(800 / blocksHtml.length)));
          setTimeout(appendNextBlock, delay);
        } else {
          const actionsDiv = document.createElement('div');
          actionsDiv.className = 'agent-message-actions';
          actionsDiv.innerHTML = `
            <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Jawaban">
              <i class="bi bi-copy"></i>
            </button>
          `;
          msgDiv.appendChild(actionsDiv);
          resolve(msgDiv);
        }
      }

      appendNextBlock();
    });
  }

  let activeAbortController = null;

  function stopCurrentGeneration() {
    if (activeAbortController) {
      activeAbortController.abort();
      activeAbortController = null;
    }
  }
  window.stopCurrentGeneration = stopCurrentGeneration;

  function createStreamingAgentMessage() {
    const container = document.getElementById('chatMessages');
    const hero = document.getElementById('geminiWelcomeHero');
    if (hero) hero.style.display = 'none';

    const msgDiv = document.createElement('div');
    msgDiv.className = 'message agent';
    
    const bodyDiv = document.createElement('div');
    bodyDiv.className = 'message-body';
    
    const avatar = document.createElement('div');
    avatar.className = 'message-avatar';
    avatar.innerHTML = '<i class="bi bi-robot"></i>';
    bodyDiv.appendChild(avatar);

    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    
    const statusCard = document.createElement('div');
    statusCard.className = 'agent-thinking-card';
    statusCard.innerHTML = `
      <span class="agent-pulse-dot"></span>
      <span class="agent-thinking-text">Pananyo Taka sedang berpikir...</span>
    `;
    bubble.appendChild(statusCard);

    const stepsContainer = document.createElement('div');
    stepsContainer.className = 'agent-steps-container';
    bubble.appendChild(stepsContainer);

    const streamContentEl = document.createElement('div');
    streamContentEl.className = 'agent-stream-content';
    bubble.appendChild(streamContentEl);

    const cursorEl = document.createElement('span');
    cursorEl.className = 'streaming-cursor';
    bubble.appendChild(cursorEl);

    bodyDiv.appendChild(bubble);
    msgDiv.appendChild(bodyDiv);
    container.appendChild(msgDiv);
    container.scrollTop = container.scrollHeight;

    let accumulatedText = '';
    const activeStepBadges = {};

    return {
      element: msgDiv,
      bubble,
      updateStatus(text) {
        const textEl = statusCard.querySelector('.agent-thinking-text');
        if (textEl && text) {
          textEl.textContent = text;
        }
      },
      addStep(tool, message) {
        statusCard.style.display = 'inline-flex';
        this.updateStatus(message || `Menjalankan: ${tool}`);
        const badge = document.createElement('div');
        badge.className = 'agent-step-badge active';
        badge.innerHTML = `<i class="bi bi-arrow-repeat spin"></i> <span>${escapeHtml(message || tool)}</span>`;
        stepsContainer.appendChild(badge);
        activeStepBadges[tool] = badge;
        container.scrollTop = container.scrollHeight;
      },
      completeStep(tool, message) {
        const badge = activeStepBadges[tool];
        if (badge) {
          badge.className = 'agent-step-badge done';
          badge.innerHTML = `<i class="bi bi-check-circle-fill text-success" style="color: #22c55e;"></i> <span>${escapeHtml(message || tool)}</span>`;
        }
        container.scrollTop = container.scrollHeight;
      },
      appendChunk(chunk) {
        if (!accumulatedText && chunk) {
          statusCard.classList.add('is-streaming');
        }
        accumulatedText += chunk;
        streamContentEl.innerHTML = renderMarkdown(accumulatedText);
        
        // Auto scroll if user is near the bottom
        const isNearBottom = container.scrollHeight - container.clientHeight - container.scrollTop < 140;
        if (isNearBottom) {
          container.scrollTop = container.scrollHeight;
        }
      },
      getText() {
        return accumulatedText;
      },
      finalize(finalText, isSimulation = false) {
        const textToRender = finalText || accumulatedText || 'Tidak ada respons yang diterima.';
        accumulatedText = textToRender;
        if (cursorEl.parentElement) cursorEl.remove();
        if (statusCard.parentElement) statusCard.remove();

        streamContentEl.innerHTML = renderMarkdown(textToRender);

        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'agent-message-actions';
        actionsDiv.style.display = 'flex';
        actionsDiv.style.alignItems = 'center';
        actionsDiv.style.gap = '8px';
        actionsDiv.style.marginTop = '8px';
        actionsDiv.innerHTML = `
          <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Jawaban" style="font-size: 13px;">
            <i class="bi bi-copy"></i>
          </button>
        `;
        msgDiv.appendChild(actionsDiv);
        container.scrollTop = container.scrollHeight;
      },
      showError(errorMsg) {
        if (cursorEl.parentElement) cursorEl.remove();
        if (statusCard.parentElement) statusCard.remove();
        streamContentEl.innerHTML = `<div class="alert alert-error" style="font-size: 13px; line-height: 1.5;"><i class="bi bi-exclamation-triangle"></i> <strong>Kesalahan:</strong> ${escapeHtml(errorMsg)}</div>`;
        container.scrollTop = container.scrollHeight;
      },
      abortNotice() {
        if (cursorEl.parentElement) cursorEl.remove();
        if (statusCard.parentElement) statusCard.remove();
        if (accumulatedText.trim()) {
          streamContentEl.innerHTML = renderMarkdown(accumulatedText) + 
            `<div class="text-muted" style="font-size: 12px; margin-top: 6px; font-style: italic; color: var(--text-muted); line-height: 1.5;"><i class="bi bi-stop-circle"></i> Jawaban dihentikan.</div>`;
          const actionsDiv = document.createElement('div');
          actionsDiv.className = 'agent-message-actions';
          actionsDiv.style.display = 'flex';
          actionsDiv.style.alignItems = 'center';
          actionsDiv.style.gap = '8px';
          actionsDiv.style.marginTop = '8px';
          actionsDiv.innerHTML = `
            <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Jawaban" style="font-size: 13px;">
              <i class="bi bi-copy"></i>
            </button>
          `;
          msgDiv.appendChild(actionsDiv);
        } else {
          streamContentEl.innerHTML = `<div class="alert alert-info" style="font-size: 13px; line-height: 1.5;"><i class="bi bi-info-circle"></i> Permintaan dihentikan oleh pengguna.</div>`;
        }
        container.scrollTop = container.scrollHeight;
      }

    };
  }

  // Set UI Busy / Free with stop button toggle
  function setUIBusy(input, submitBtn) {
    _isProcessing = true;
    input.disabled = true;
    if (submitBtn) submitBtn.style.display = 'none';
    const stopBtn = document.getElementById('chatStopBtn');
    if (stopBtn) stopBtn.style.display = 'inline-flex';
    document.querySelectorAll('.prompt-btn').forEach(btn => btn.disabled = true);
  }

  function setUIFree(input, submitBtn) {
    _isProcessing = false;
    input.disabled = false;
    const stopBtn = document.getElementById('chatStopBtn');
    if (stopBtn) stopBtn.style.display = 'none';
    if (submitBtn) submitBtn.style.display = 'inline-flex';
    document.querySelectorAll('.prompt-btn').forEach(btn => btn.disabled = false);
    input.focus();
  }

  async function handleChatSubmit(e) {
    e.preventDefault();
    if (_isProcessing) return;

    const input = document.getElementById('chatInput');
    const submitBtn = document.getElementById('chatSendBtn') || document.querySelector('#chatForm button[type="submit"]');
    const text = input.value.trim();
    if (!text) return;

    setUIBusy(input, submitBtn);

    // Pastikan tidak ada pesan 'user' gantung dari turn sebelumnya yang gagal
    while (chatHistory.length > 0 && chatHistory[chatHistory.length - 1].role === 'user') {
      chatHistory.pop();
    }

    appendMessage('user', text);
    chatHistory.push({ role: 'user', content: text });
    saveChatHistory();
    input.value = '';
    input.style.height = 'auto';

    const streamingMsg = createStreamingAgentMessage();
    startAgentWaitIndicator();

    const controller = new AbortController();
    activeAbortController = controller;

    const browserTimeout = setTimeout(() => {
      controller.abort();
    }, 180000); // 3 menit — memberi ruang untuk SmartSwitch multi-provider fallback

    const startTime = Date.now();
    const reqProvider = document.getElementById('agentProvider')?.value || 'gemini';
    const reqModel = document.getElementById('agentModel')?.value || '';
    const safePayloadHistory = chatHistory.slice(Math.max(0, chatHistory.length - 11), -1);

    const navPrefix = window.navPrefix || '<%= typeof navPrefix !== "undefined" ? navPrefix : "" %>';
    const streamUrl = (navPrefix ? navPrefix : '') + '/agent/chat/stream';
    const normalUrl = (navPrefix ? navPrefix : '') + '/agent/chat';

    console.group('%c[PANANYO AI - STREAM START]%c ' + (text.length > 50 ? text.slice(0, 50) + '...' : text), 'background: #2563eb; color: #fff; padding: 2px 6px; border-radius: 3px; font-weight: bold;', 'color: inherit;');
    console.log('📝 Prompt:', text);
    console.log('🤖 Provider / Model:', reqProvider, '/', reqModel || 'default');
    console.log('📚 Riwayat yang dikirim (' + safePayloadHistory.length + ' pesan):', safePayloadHistory);
    console.log('⏱️ Waktu mulai:', new Date().toLocaleTimeString());

    let chunkCount = 0;
    let hasReceivedError = false;

    try {
      const res = await fetch(streamUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'text/event-stream',
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
        },
        signal: controller.signal,
        body: JSON.stringify({
          message: text,
          history: safePayloadHistory,
          provider: reqProvider,
          model: reqModel
        })
      });

      console.log('📡 HTTP Response Status:', res.status, res.statusText);

      if (!res.ok) {
        let errBody;
        try {
          errBody = await res.json();
        } catch (_) {}
        const errorMsg = errBody?.error || `HTTP ${res.status}: ${res.statusText}`;
        console.error('❌ HTTP Error dari Server:', errorMsg, errBody);
        throw new Error(errorMsg);
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder('utf-8');
      let buffer = '';
      let currentEvent = 'message';
      let firstChunkTime = null;

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop(); // Keep incomplete line

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed) continue;

          if (trimmed.startsWith('event:')) {
            currentEvent = trimmed.slice(6).trim();
          } else if (trimmed.startsWith('data:')) {
            const rawData = trimmed.slice(5).trim();
            try {
              const data = JSON.parse(rawData);
              
              if (currentEvent === 'status') {
                console.info('%c[AI STATUS]%c ' + data.text, 'color: #06b6d4; font-weight: bold;', 'color: inherit;', data);
                streamingMsg.updateStatus(data.text);
              } else if (currentEvent === 'tool_start') {
                console.group('%c[AI TOOL START]%c ' + (data.tool || 'Tool') + ' — ' + (data.message || ''), 'background: #8b5cf6; color: white; padding: 2px 6px; border-radius: 3px;', 'color: inherit;');
                console.log('Tool parameters / message:', data);
                streamingMsg.addStep(data.tool, data.message);
              } else if (currentEvent === 'tool_end') {
                console.log('%c[AI TOOL END]%c Selesai: ' + (data.tool || '') + ' (' + (data.message || '') + ')', 'color: #10b981; font-weight: bold;', 'color: inherit;', data);
                console.groupEnd();
                streamingMsg.completeStep(data.tool, data.message);
              } else if (currentEvent === 'chunk') {
                chunkCount++;
                if (!firstChunkTime) {
                  firstChunkTime = Date.now();
                  console.log(`⚡ First Token TTFT: ${firstChunkTime - startTime}ms`);
                }
                streamingMsg.appendChunk(data.text || '');
              } else if (currentEvent === 'done') {
                const totalDuration = Date.now() - startTime;
                console.log('%c[AI DONE]%c Respons selesai dalam ' + totalDuration + 'ms (' + chunkCount + ' chunks)', 'background: #22c55e; color: white; padding: 2px 6px; border-radius: 3px; font-weight: bold;', 'color: inherit;', data);
                console.groupEnd();
                streamingMsg.finalize(data.reply || streamingMsg.getText(), data.isSimulation);
                const finalContent = streamingMsg.getText();
                if (finalContent.trim()) {
                  chatHistory.push({ role: 'model', content: finalContent });
                  saveChatHistory();
                }
              } else if (currentEvent === 'error') {
                hasReceivedError = true;
                const totalDuration = Date.now() - startTime;
                console.error('%c[AI ERROR]%c ' + (data.error || 'Terjadi kesalahan pada AI') + ' (' + totalDuration + 'ms)', 'background: #ef4444; color: white; padding: 2px 6px; border-radius: 3px; font-weight: bold;', 'color: inherit;', data);
                console.groupEnd();
                streamingMsg.showError(data.error || 'Terjadi kesalahan pada AI.');
                if (chatHistory.length > 0 && chatHistory[chatHistory.length - 1].role === 'user') {
                  chatHistory.pop();
                  saveChatHistory();
                }
              }
            } catch (jsonErr) {
              console.warn('[AGENT:STREAM] Parse error:', jsonErr, rawData);
            }
          }
        }
      }

      // If finished stream without explicit done event or error
      if (!hasReceivedError && !streamingMsg.element.querySelector('.agent-message-actions')) {
        const totalDuration = Date.now() - startTime;
        console.log(`%c[AI STREAM COMPLETE]%c Stream reader selesai (${totalDuration}ms, ${chunkCount} chunks)`, 'color: #22c55e; font-weight: bold;', 'color: inherit;');
        console.groupEnd();
        streamingMsg.finalize(streamingMsg.getText());
        const finalContent = streamingMsg.getText();
        if (finalContent.trim() && !finalContent.includes('Tidak ada respons yang diterima.')) {
          chatHistory.push({ role: 'model', content: finalContent });
          saveChatHistory();
        }
      }

    } catch (err) {
      const totalDuration = Date.now() - startTime;
      if (err.name === 'AbortError') {
        console.warn('%c[AI ABORT]%c Permintaan dihentikan (' + totalDuration + 'ms)', 'color: #f59e0b; font-weight: bold;', 'color: inherit;', err);
        console.groupEnd();
        streamingMsg.abortNotice();
        const partial = streamingMsg.getText();
        if (partial.trim()) {
          chatHistory.push({ role: 'model', content: partial });
          saveChatHistory();
        } else if (chatHistory.length > 0 && chatHistory[chatHistory.length - 1].role === 'user') {
          chatHistory.pop();
          saveChatHistory();
        }
      } else if (chunkCount === 0 && !hasReceivedError) {
        // Fallback ke endpoint reguler jika stream gagal terhubung (misal diblokir proxy web server)
        console.warn('%c[AI STREAM FALLBACK]%c Mengalihkan ke mode reguler POST karena stream terganggu...', 'color: #f59e0b; font-weight: bold;', 'color: inherit;', err);
        streamingMsg.updateStatus('Menganalisis data (mode langsung)...');
        try {
          const fbRes = await fetch(normalUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
            },
            signal: controller.signal,
            body: JSON.stringify({
              message: text,
              history: safePayloadHistory,
              provider: reqProvider,
              model: reqModel
            })
          });
          const fbData = await fbRes.json();
          if (fbRes.ok && fbData.reply) {
            console.log('%c[AI FALLBACK SUCCESS]%c Mendapat balasan dari server', 'color: #22c55e; font-weight: bold;', 'color: inherit;');
            console.groupEnd();
            streamingMsg.finalize(fbData.reply, fbData.isSimulation);
            chatHistory.push({ role: 'model', content: fbData.reply });
            saveChatHistory();
            return;
          }
          throw new Error(fbData.error || `HTTP ${fbRes.status}`);
        } catch (fbErr) {
          console.error('%c[AI CONNECTION ERROR]%c ' + (fbErr.message || 'Gagal menghubungi server') + ' (' + totalDuration + 'ms)', 'background: #b91c1c; color: white; padding: 2px 6px; border-radius: 3px; font-weight: bold;', 'color: inherit;', fbErr);
          console.groupEnd();
          streamingMsg.showError(fbErr.message || 'Gagal menghubungi server.');
          if (chatHistory.length > 0 && chatHistory[chatHistory.length - 1].role === 'user') {
            chatHistory.pop();
            saveChatHistory();
          }
        }
      } else {
        console.error('%c[AI CONNECTION ERROR]%c ' + (err.message || 'Gagal menghubungi server') + ' (' + totalDuration + 'ms)', 'background: #b91c1c; color: white; padding: 2px 6px; border-radius: 3px; font-weight: bold;', 'color: inherit;', err);
        console.groupEnd();
        streamingMsg.showError(err.message || 'Gagal menghubungi server.');
        if (chatHistory.length > 0 && chatHistory[chatHistory.length - 1].role === 'user') {
          chatHistory.pop();
          saveChatHistory();
        }
      }
    } finally {
      clearTimeout(browserTimeout);
      activeAbortController = null;
      clearAgentWaitIndicator();
      setUIFree(input, submitBtn);
    }
  }

  function triggerChatSubmit() {
    const chatForm = document.getElementById('chatForm');
    if (!chatForm) return;
    if (typeof chatForm.requestSubmit === 'function') {
      chatForm.requestSubmit();
    } else {
      chatForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
    }
  }

  function sendQuickPrompt(promptText) {
    if (_isProcessing) return;
    const input = document.getElementById('chatInput');
    if (!input || input.disabled) return;
    input.value = promptText;
    triggerChatSubmit();
  }

  // Load chat history immediately (handles PJAX page transitions where DOMContentLoaded won't fire)
  loadChatHistory();

  document.addEventListener('DOMContentLoaded', () => {
    const providerSelect = document.getElementById('agentProvider');
    const modelSelect = document.getElementById('agentModel');
    refreshModelSelect();
    updateAgentStatus();
    loadChatHistory();

    if (providerSelect) {
      providerSelect.addEventListener('change', () => {
        refreshModelSelect();
        updateAgentStatus();
      });
    }

    if (modelSelect) {
      modelSelect.addEventListener('change', () => {
        const provider = providerSelect ? providerSelect.value : 'gemini';
        selectedModels[provider] = modelSelect.value;
        syncSelectedAIToStorage();
      });
    }
    const chatInput = document.getElementById('chatInput');
    if (chatInput) {
      chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          triggerChatSubmit();
        }
      });
      chatInput.addEventListener('input', () => {
        chatInput.style.height = 'auto';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 140) + 'px';
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && _isProcessing) {
        stopCurrentGeneration();
      }
    });
  });

  // Expose functions globally to HTML handlers
  window.clearChatHistory = clearChatHistory;
  window.handleChatSubmit = handleChatSubmit;
  window.sendQuickPrompt = sendQuickPrompt;
  window.copyCodeToClipboard = copyCodeToClipboard;
})();
</script>
