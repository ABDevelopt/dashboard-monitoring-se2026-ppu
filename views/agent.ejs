    <div class="log-panel-header-left">
      <i class="bi bi-terminal-fill"></i>
      <span>Log Sistem Chatbot</span>
      <span id="lpLiveBadge" style="display: inline-flex; align-items: center; gap: 4px; background: rgba(34,197,94,0.15); color: #22c55e; padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 600;">
        <span class="lp-live-dot"></span> Live
      </span>
    </div>
    <div class="log-panel-actions">
      <select id="lpFilterLevel" onchange="lpRenderLogs()">
        <option value="ALL">📋 Semua</option>
        <option value="AI" selected>🤖 AI</option>
        <option value="ERROR">🚨 Error</option>
        <option value="INFO">ℹ️ Info</option>
      </select>
      <input type="text" id="lpSearch" oninput="lpRenderLogs()" placeholder="Cari log...">
      <span id="lpCounter" style="font-size: 10px; color: #8b949e;"></span>
      <button onclick="lpRefresh()" title="Refresh"><i class="bi bi-arrow-clockwise"></i></button>
      <button onclick="lpDownload()" title="Unduh Log"><i class="bi bi-download"></i></button>
      <button onclick="lpClearLogs()" title="Bersihkan Log" style="color: #f85149;"><i class="bi bi-trash"></i></button>
      <button class="btn-close-panel" onclick="toggleLogPanel()" title="Tutup">✕</button>
    </div>
  </div>
  <div class="log-panel-body" id="lpTerminal">
    <div style="color: #8b949e; text-align: center; padding: 30px 0;">
      <i class="bi bi-arrow-repeat spin" style="font-size: 16px;"></i>
      <div style="margin-top: 6px;">Memuat log...</div>
    </div>
  </div>
  <div class="log-panel-footer">
    <span id="lpFooterInfo">Menunggu data...</span>
    <span>Tekan <kbd style="background:#21262d; padding:1px 4px; border-radius:3px; font-size:10px;">ESC</kbd> untuk menutup</span>
  </div>
</div>

<script>
// ─────────────────────────────────────────────────────────────
//  FLOATING LOG PANEL CONTROLLER
// ─────────────────────────────────────────────────────────────
(function() {
  let _lpLogs = [];
  let _lpAutoRefreshId = null;
  let _lpOpen = false;
  const LP_REFRESH_MS = 3500;

  window.toggleLogPanel = function() {
    const panel = document.getElementById('logPanelOverlay');
    if (!panel) return;
    _lpOpen = !_lpOpen;
    panel.classList.toggle('active', _lpOpen);
    if (_lpOpen) {
      lpRefresh();
      _lpStartAutoRefresh();
    } else {
      _lpStopAutoRefresh();
    }
  };

  window.lpRefresh = async function() {
    const navPrefix = window.navPrefix || '<%= typeof navPrefix !== "undefined" ? navPrefix : "" %>';
    try {
      let res = await fetch(navPrefix + '/agent/logs', {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      if (!res.ok) {
        res = await fetch(navPrefix + '/admin/settings/chatbot-logs', {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
      }
      const data = await res.json();
      if (data.success && Array.isArray(data.logs)) {
        _lpLogs = data.logs;
        lpRenderLogs();
        // Error dot indicator
        const hasRecentError = _lpLogs.slice(-20).some(l => (l.level || '').toLowerCase() === 'error');
        const dot = document.getElementById('logErrorDot');
        if (dot) dot.style.display = hasRecentError ? 'block' : 'none';
      }
    } catch (e) {
      const terminal = document.getElementById('lpTerminal');
      if (terminal) terminal.innerHTML = `<div style="color:#f85149; text-align:center; padding:20px;">Gagal mengambil log: ${e.message}</div>`;
    }
  };

  window.lpRenderLogs = function() {
    const terminal = document.getElementById('lpTerminal');
    const filterLevel = document.getElementById('lpFilterLevel')?.value || 'ALL';
    const keyword = (document.getElementById('lpSearch')?.value || '').toLowerCase().trim();
    const counterEl = document.getElementById('lpCounter');
    const footerEl = document.getElementById('lpFooterInfo');
    if (!terminal) return;

    let filtered = _lpLogs.filter(item => {
      const msg = String(item.message || item.msg || '').toLowerCase();
      const lvl = String(item.level || 'info').toLowerCase();
      const stack = String(item.stack || '').toLowerCase();

      if (filterLevel === 'ERROR' && lvl !== 'error' && lvl !== 'warn') return false;
      if (filterLevel === 'INFO' && lvl !== 'info') return false;
      if (filterLevel === 'AI') {
        const isAi = msg.includes('[llm_gw') || msg.includes('[orch') || msg.includes('[tool_registry') ||
                     msg.includes('[agent:') || msg.includes('[key_pool') || msg.includes('[contextbuilder') ||
                     msg.includes('[memorymanager') || msg.includes('gemini') || msg.includes('smart_switch') ||
                     msg.includes('smartswitch') || msg.includes('[stream:gemini');
        if (!isAi) return false;
      }
      if (keyword) {
        const combined = `${msg} ${lvl} ${stack} ${item.timestamp || ''}`.toLowerCase();
        if (!combined.includes(keyword)) return false;
      }
      return true;
    });

    if (counterEl) counterEl.textContent = `${filtered.length}/${_lpLogs.length}`;
    if (footerEl) footerEl.textContent = `${filtered.length} entri ditampilkan dari ${_lpLogs.length} total • Terakhir diperbarui ${new Date().toLocaleTimeString('id-ID')}`;

    if (filtered.length === 0) {
      terminal.innerHTML = '<div style="color:#8b949e; text-align:center; padding:30px 0;"><i class="bi bi-inbox"></i> Tidak ada log yang cocok.</div>';
      return;
    }

    const isNearBottom = terminal.scrollHeight - terminal.clientHeight - terminal.scrollTop < 60;
    let html = '';

    filtered.forEach(item => {
      const lvl = String(item.level || 'info').toLowerCase();
      const time = item.timestamp || '';
      let msg = _lpEscape(String(item.message || item.msg || ''));
      const stack = item.stack ? `<div style="color:#f85149; font-size:10px; margin-left:18px; opacity:0.8;">${_lpEscape(item.stack)}</div>` : '';

      let badge = '<span class="lp-badge lp-badge-info">INFO</span>';
      if (lvl === 'warn')  badge = '<span class="lp-badge lp-badge-warn">WARN</span>';
      if (lvl === 'error') badge = '<span class="lp-badge lp-badge-error">ERR</span>';

      // Highlight AI tags
      msg = msg.replace(/(\[LLM_GW[^\]]*\])/gi,        '<span class="lp-badge-ai">$1</span>');
      msg = msg.replace(/(\[ORCH[^\]]*\])/gi,           '<span class="lp-badge-ai" style="background:rgba(6,182,212,0.15);color:#06b6d4;">$1</span>');
      msg = msg.replace(/(\[TOOL_REGISTRY[^\]]*\])/gi,  '<span class="lp-badge-ai" style="background:rgba(34,197,94,0.15);color:#22c55e;">$1</span>');
      msg = msg.replace(/(\[AGENT:[^\]]*\])/gi,         '<span class="lp-badge-ai" style="background:rgba(59,130,246,0.15);color:#3b82f6;">$1</span>');
      msg = msg.replace(/(\[KEY_POOL[^\]]*\])/gi,       '<span class="lp-badge-ai" style="background:rgba(245,158,11,0.15);color:#f59e0b;">$1</span>');
      msg = msg.replace(/(\[contextBuilder[^\]]*\])/gi,  '<span class="lp-badge-ai" style="background:rgba(16,185,129,0.15);color:#10b981;">$1</span>');
      msg = msg.replace(/(\[MemoryManager[^\]]*\])/gi,   '<span class="lp-badge-ai" style="background:rgba(236,72,153,0.15);color:#ec4899;">$1</span>');
      msg = msg.replace(/(\[STREAM:GEMINI[^\]]*\])/gi,   '<span class="lp-badge-ai" style="background:rgba(139,92,246,0.15);color:#a78bfa;">$1</span>');

      // Status code highlight
      msg = msg.replace(/\b(200 OK|200)\b/g,         '<span style="color:#22c55e;font-weight:bold;">$1</span>');
      msg = msg.replace(/\b(429|Rate.?Limit)\b/gi,   '<span style="color:#f59e0b;font-weight:bold;">$1</span>');
      msg = msg.replace(/\b(503|500|401|403|400|ETIMEDOUT|ECONNREFUSED|TIMEOUT)\b/gi, '<span style="color:#ef4444;font-weight:bold;">$1</span>');

      html += `<div class="log-line log-${lvl}">
        <span style="color:#8b949e; flex-shrink:0; font-size:10px;">[${time}]</span>
        ${badge}
        <span style="flex:1;">${msg}${stack}</span>
      </div>`;
    });

    terminal.innerHTML = html;
    if (isNearBottom) terminal.scrollTop = terminal.scrollHeight;
  };

  window.lpDownload = function() {
    if (_lpLogs.length === 0) return alert('Tidak ada log.');
    const lines = _lpLogs.map(l => `[${l.timestamp || ''}] [${(l.level || 'INFO').toUpperCase()}] ${l.message || ''}${l.stack ? '\n' + l.stack : ''}`).join('\n');
    const blob = new Blob([lines], { type: 'text/plain;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `chatbot_log_${new Date().toISOString().slice(0,10)}.log`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(a.href);
  };

  window.lpClearLogs = async function() {
    if (!confirm('Bersihkan semua log sistem di server?')) return;
    const navPrefix = window.navPrefix || '<%= typeof navPrefix !== "undefined" ? navPrefix : "" %>';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    try {
      let res = await fetch(navPrefix + '/agent/logs/clear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken, 'X-Requested-With': 'XMLHttpRequest' }
      });
      if (!res.ok) {
        res = await fetch(navPrefix + '/admin/settings/chatbot-logs/clear', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken, 'X-Requested-With': 'XMLHttpRequest' }
        });
      }
      const d = await res.json();
      if (d.success) {
        _lpLogs = [];
        lpRenderLogs();
        const dot = document.getElementById('logErrorDot');
        if (dot) dot.style.display = 'none';
      } else { alert('Gagal: ' + (d.error || 'Unknown')); }
    } catch (e) { alert('Gagal: ' + e.message); }
  };

  function _lpStartAutoRefresh() {
    _lpStopAutoRefresh();
    _lpAutoRefreshId = setInterval(() => { if (_lpOpen) lpRefresh(); }, LP_REFRESH_MS);
  }
  function _lpStopAutoRefresh() {
    if (_lpAutoRefreshId) { clearInterval(_lpAutoRefreshId); _lpAutoRefreshId = null; }
  }

  function _lpEscape(text) {
    return String(text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
  }

  // Close panel on ESC (only if panel is open and not processing chat)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && _lpOpen) {
      toggleLogPanel();
      e.stopPropagation();
    }
  });
})();
</script>

<script>
(function() {
  const chatHistory = [];
  const modelOptions = {
    gemini: <%- JSON.stringify(geminiModels || ['gemini-3.5-flash', 'gemini-2.5-flash', 'gemini-3.1-flash-lite', 'gemini-2.5-pro']) %>
  };
  const selectedModels = {
    gemini: <%- JSON.stringify(selectedGeminiModel || 'gemini-3.5-flash') %>
  };

  // FIX #1 — Guard global: pastikan hanya ada SATU request aktif dalam satu waktu.
  // Semua jalur entry (form submit, sendQuickPrompt, keyboard shortcut) diperiksa di sini.
  let _isProcessing = false;

  function refreshModelSelect() {
    const providerSelect = document.getElementById('agentProvider');
    const modelSelect = document.getElementById('agentModel');
    if (!providerSelect || !modelSelect || modelSelect.tagName !== 'SELECT') return;

    const provider = providerSelect.value;
    const models = modelOptions[provider] || [];
    modelSelect.innerHTML = '';
    models.forEach(model => {
      const option = document.createElement('option');
      option.value = model;
      option.textContent = model;
      option.selected = model === selectedModels[provider];
      modelSelect.appendChild(option);
    });

    if (modelSelect.options.length === 0) {
      const option = document.createElement('option');
      option.value = '';
      option.textContent = 'Model belum tersedia';
      modelSelect.appendChild(option);
      modelSelect.disabled = true;
    } else {
      modelSelect.disabled = false;
    }
    updateAgentStatus();
    syncSelectedAIToStorage();
  }

  function syncSelectedAIToStorage() {
    const providerSelect = document.getElementById('agentProvider');
    const modelSelect = document.getElementById('agentModel');
    if (providerSelect && modelSelect) {
      const provider = providerSelect.value;
      const model = modelSelect.value;
      if (provider && model) {
        localStorage.setItem('se2026_selected_ai', JSON.stringify({ provider, model }));
        if (typeof window.updateAiWidgetModelDisplay === 'function') {
          window.updateAiWidgetModelDisplay();
        }
      }
    }
  }

  function escapeHtml(text) {
    return String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatInline(text) {
    const navPrefix = '<%= typeof navPrefix !== "undefined" ? navPrefix : "" %>';
    return escapeHtml(text)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*]+)\*/g, '<em>$1</em>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (match, label, href) => {
        let finalHref = href;
        if (finalHref.startsWith('/') && !finalHref.startsWith('//') && navPrefix && !finalHref.startsWith(navPrefix + '/') && finalHref !== navPrefix) {
          finalHref = navPrefix + (finalHref === '/' ? '' : finalHref);
        }
        const isInternal = finalHref.startsWith('/') || finalHref.startsWith('#');
        const targetAttr = isInternal ? '' : ' target="_blank" rel="noopener"';
        return `<a href="${finalHref}" class="ai-chat-link"${targetAttr}>${label} <i class="bi bi-arrow-right-short" style="font-size: 1.1em; margin-left: 1px;"></i></a>`;
      })
      .replace(/&lt;br&gt;/g, '<br>');
  }
  
  function copyCodeToClipboard(btn) {
    const codeBlock = btn.closest('pre');
    const codeElement = codeBlock.querySelector('code');
    const text = codeElement.textContent;
    
    navigator.clipboard.writeText(text).then(() => {
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i class="bi bi-check"></i> Tersalin!';
      btn.style.background = 'rgba(40, 167, 69, 0.3)';
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.style.background = '';
      }, 2000);
    }).catch(() => {
      btn.innerHTML = '<i class="bi bi-exclamation-circle"></i> Gagal salin';
    });
  }

  // Synchronous Markdown Renderer for instant, non-blocking UI updates
  function renderMarkdownBlocks(text) {
    text = String(text || '').replace(/🤖\s*\*Smart Switch:[^*]*\*\s*/gi, '').trim();
    const lines = text.split(/\r?\n/);
    const blocks = [];
    let i = 0;

    while (i < lines.length) {
      const line = lines[i];

      // Headers (# ## ###)
      if (/^#+\s+/.test(line)) {
        const level = line.match(/^#+/)[0].length;
        const content = line.replace(/^#+\s+/, '');
        blocks.push(`<h${level}>${formatInline(content)}</h${level}>`);
        i++; continue;
      }

      // Code blocks (```)
      if (line.trim().startsWith('```')) {
        const codeLanguage = line.trim().slice(3).trim() || 'code';
        i++;
        const codeLines = [];
        while (i < lines.length && !lines[i].trim().startsWith('```')) {
          codeLines.push(lines[i]);
          i++;
        }
        if (i < lines.length) i++;
        const codeContent = escapeHtml(codeLines.join('\n'));
        blocks.push(`<pre><div class="code-block-header"><span>${escapeHtml(codeLanguage)}</span><button class="copy-code-btn" onclick="copyCodeToClipboard(this)"><i class="bi bi-clipboard"></i> Copy</button></div><code>${codeContent}</code></pre>`);
        continue;
      }

      // Blockquotes (>)
      if (/^>\s+/.test(line)) {
        const quotes = [];
        while (i < lines.length && /^>\s+/.test(lines[i])) {
          quotes.push(lines[i].replace(/^>\s+/, ''));
          i++;
        }
        blocks.push(`<blockquote>${formatInline(quotes.join('<br>'))}</blockquote>`);
        continue;
      }

      // Tables
      if (/^\s*\|.+\|\s*$/.test(line) && i + 1 < lines.length && /^\s*\|(?:\s*[:-]+\s*\|)+\s*$/.test(lines[i + 1])) {
        const headers = line.trim().slice(1, -1).split('|').map(c => c.trim());
        i += 2;
        const rows = [];
        while (i < lines.length && /^\s*\|.+\|\s*$/.test(lines[i])) {
          rows.push(lines[i].trim().slice(1, -1).split('|').map(c => c.trim()));
          i++;
        }
        blocks.push(`<div class="table-container"><table><thead><tr>${headers.map(h => `<th>${formatInline(h)}</th>`).join('')}</tr></thead><tbody>${rows.map(row => `<tr>${row.map(c => `<td>${formatInline(c)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`);
        continue;
      }

      // Unordered lists
      if (/^\s*[-*]\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^\s*[-*]\s+/.test(lines[i])) {
          items.push(lines[i].replace(/^\s*[-*]\s+/, ''));
          i++;
        }
        blocks.push(`<ul>${items.map(item => `<li>${formatInline(item)}</li>`).join('')}</ul>`);
        continue;
      }

      // Ordered lists
      if (/^\s*\d+\.\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^\s*\d+\.\s+/.test(lines[i])) {
          items.push(lines[i].replace(/^\s*\d+\.\s+/, ''));
          i++;
        }
        blocks.push(`<ol>${items.map(item => `<li>${formatInline(item)}</li>`).join('')}</ol>`);
        continue;
      }

      // Empty lines
      if (line.trim() === '') { i++; continue; }

      // Paragraphs
      const paragraph = [];
      paragraph.push(lines[i]);
      i++;
      while (
        i < lines.length &&
        lines[i].trim() !== '' &&
        !/^#+\s+/.test(lines[i]) &&
        !/^\s*\|.+\|\s*$/.test(lines[i]) &&
        !/^\s*[-*]\s+/.test(lines[i]) &&
        !/^\s*\d+\.\s+/.test(lines[i]) &&
        !/^>\s+/.test(lines[i]) &&
        !lines[i].trim().startsWith('```')
      ) {
        paragraph.push(lines[i]);
        i++;
      }
      if (paragraph.length > 0) {
        blocks.push(`<p>${formatInline(paragraph.join('<br>'))}</p>`);
      }
    }

    return blocks;
  }

  // Synchronous Markdown Renderer for instant, non-blocking UI updates
  function renderMarkdown(text) {
    return renderMarkdownBlocks(text).join('');
  }

  const providerKeyStatus = {
    gemini: <%= hasGeminiKey ? 'true' : 'false' %>
  };

  let agentStatusTimer = null;

  function updateAgentStatus() {
    const providerSelect = document.getElementById('agentProvider');
    const statusBadge = document.getElementById('agentStatus');
    if (!providerSelect || !statusBadge) return;

    const provider = providerSelect.value;
    const isReady = !!providerKeyStatus[provider];
    statusBadge.classList.remove('processing');
    statusBadge.classList.toggle('ready', isReady);
    statusBadge.classList.toggle('not-ready', !isReady);
    statusBadge.querySelector('.status-text').textContent = isReady
      ? `Ready (${provider.toUpperCase()})`
      : `Tidak siap (${provider.toUpperCase()})`;
  }

  function setAgentStatusProcessing() {
    const statusBadge = document.getElementById('agentStatus');
    if (!statusBadge) return;
    statusBadge.classList.remove('ready', 'not-ready');
    statusBadge.classList.add('processing');
    statusBadge.querySelector('.status-text').textContent = 'Sedang memproses...';
  }

  function startAgentWaitIndicator() {
    clearAgentWaitIndicator();
    setAgentStatusProcessing();
  }

  function clearAgentWaitIndicator() {
    if (agentStatusTimer) {
      clearTimeout(agentStatusTimer);
      agentStatusTimer = null;
    }
    updateAgentStatus();
  }

  // ─────────────────────────────────────────────────────────────────
  //  CHAT HISTORY PERSISTENCE (LocalStorage)
  // ─────────────────────────────────────────────────────────────────
  const HISTORY_STORAGE_KEY = 'se2026_agent_chat_history';

  function saveChatHistory() {
    try {
      localStorage.setItem(HISTORY_STORAGE_KEY, JSON.stringify(chatHistory));
      window.dispatchEvent(new CustomEvent('ai_chat_history_updated', { detail: { source: 'agent' } }));
    } catch (e) {
      console.error('Failed to save chat history:', e);
    }
  }

  function loadChatHistory() {
    try {
      chatHistory.length = 0;
      const container = document.getElementById('chatMessages');
      if (container) {
        const messages = container.querySelectorAll('.message');
        for (let i = 1; i < messages.length; i++) {
          messages[i].remove();
        }
      }

      const saved = localStorage.getItem(HISTORY_STORAGE_KEY);
      if (!saved) return;
      
      const parsed = JSON.parse(saved);
      if (!Array.isArray(parsed)) return;

      parsed.forEach(msg => {
        chatHistory.push(msg);
        if (msg.role === 'user') {
          appendMessage('user', msg.content, false);
        } else {
          appendMessage('agent', renderMarkdown(msg.content), true);
        }
      });
    } catch (e) {
      console.error('Failed to load chat history:', e);
    }
  }

  function clearChatHistory() {
    if (confirm('Apakah Anda yakin ingin menghapus seluruh riwayat obrolan?')) {
      localStorage.removeItem(HISTORY_STORAGE_KEY);
      chatHistory.length = 0;
      
      // Remove all chat messages except the first greeting message
      const container = document.getElementById('chatMessages');
      if (container) {
        const messages = container.querySelectorAll('.message');
        for (let i = 1; i < messages.length; i++) {
          messages[i].remove();
        }
      }
      window.dispatchEvent(new CustomEvent('ai_chat_history_updated', { detail: { source: 'agent' } }));
    }
  }

  function handleExternalHistorySync(e) {
    if (e.type === 'storage' && e.key !== HISTORY_STORAGE_KEY) return;
    if (e.detail && e.detail.source === 'agent') return;
    loadChatHistory();
  }

  window.addEventListener('storage', handleExternalHistorySync);
  window.addEventListener('ai_chat_history_updated', handleExternalHistorySync);

  if (Array.isArray(window._pjaxCleanups)) {
    window._pjaxCleanups.push({ type: 'storage', listener: handleExternalHistorySync });
    window._pjaxCleanups.push({ type: 'ai_chat_history_updated', listener: handleExternalHistorySync });
  }

