  </style>

  <div class="chat-wrapper">
    <div class="chat-header">
      <div class="chat-header-title">
        <button class="btn btn-secondary btn-sm" id="sidebarToggleAgent" onclick="document.body.classList.toggle('sidebar-collapsed'); if(typeof window.dispatchEvent==='function') window.dispatchEvent(new Event('resize'));" style="padding: 4px 8px; font-size: 13px; margin-right: 6px; display: inline-flex; align-items: center; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); cursor: pointer;" title="Sembunyikan / Tampilkan Sidebar">
          <i class="bi bi-layout-sidebar-inset"></i>
        </button>
        <div style="display: flex; align-items: center; gap: 6px;">
          <i class="bi bi-robot" style="font-size: 20px; color: var(--accent-cyan);"></i>
          <i class="bi bi-sparkles gemini-sparkle-icon" style="font-size: 18px;"></i>
        </div>
        <div>
          <span style="font-weight: 700; font-size: 15.5px;" class="gemini-gradient-text">Pananyo Taka</span>
          <p style="margin: 2px 0 0 0; font-size: 10px; font-weight: 500; color: var(--text-muted);">Asisten AI Pintar <%= (typeof surveyConfig !== 'undefined' ? surveyConfig.name : 'Sensus Ekonomi 2026') %> Penajam Paser Utara</p>
        </div>
      </div>
      <div class="chat-header-actions">
        <button class="btn btn-secondary btn-sm" onclick="clearChatHistory()" style="padding: 6px 12px; font-size: 11px; height: 32px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); cursor: pointer; border-radius: 99px;" title="Hapus riwayat obrolan">
          <i class="bi bi-plus-lg"></i> Percakapan Baru
        </button>

        <!-- Notification Bell -->
        <div class="topbar-dropdown-wrapper" id="bellWrapperAgent">
          <button class="btn btn-secondary topbar-action-btn notification-bell-btn" id="notificationBellBtnAgent" title="Notifikasi Update Data" aria-label="Notifikasi Update Data" style="height: 32px; width: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary);">
            <i class="bi bi-bell-fill notification-bell-icon" id="notificationBellIconAgent" style="font-size: 13px;"></i>
            <span id="notificationBellBadgeAgent" class="topbar-badge notification-bell-badge"></span>
          </button>
          <div id="notificationBellDropdownAgent" class="topbar-dropdown topbar-dropdown--right notification-bell-dropdown">
            <div class="topbar-dropdown-header">
              <span>Riwayat Update Data</span>
              <span id="clearNotificationBadgeAgent" class="topbar-dropdown-action clear-notification-badge">Tandai Terbaca</span>
            </div>
            <div id="notificationBellListAgent" class="topbar-dropdown-list notification-bell-list">
              <!-- content injected by JS -->
            </div>
          </div>
        </div>

        <!-- Theme Toggle -->
        <button class="btn btn-secondary topbar-action-btn theme-toggle-btn" id="themeToggleAgent" title="Ubah Tema" aria-label="Ubah Tema" onclick="window.toggleTheme(event)" style="height: 32px; width: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary);">
          <i class="bi bi-moon-fill theme-icon" style="font-size: 13px;"></i>
        </button>

        <span id="agentStatus" class="status-badge ready" style="border-radius: 99px;"><span class="status-dot"></span><span class="status-text">Pananyo Taka Active</span></span>
        <input type="hidden" id="agentProvider" value="<%= typeof provider !== 'undefined' && provider ? provider : 'gemini' %>">
        <input type="hidden" id="agentModel" value="<%= typeof selectedGeminiModel !== 'undefined' && selectedGeminiModel ? selectedGeminiModel : (typeof model !== 'undefined' && model ? model : 'gemini-3.5-flash') %>">
      </div>
    </div>
    
    <div class="chat-messages" id="chatMessages">
      <!-- Gemini Welcome Hero Screen -->
      <div class="gemini-welcome-container" id="geminiWelcomeHero">
        <div class="gemini-hero-header">
          <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 10px;">
            <i class="bi bi-robot" style="font-size: 38px; color: var(--accent-cyan);"></i>
            <i class="bi bi-sparkles gemini-hero-sparkle" style="font-size: 34px; margin-bottom: 0;"></i>
          </div>
          <h1 class="gemini-hero-title">Halo, <span class="gemini-gradient-text">Saya Pananyo Taka</span></h1>
          <p class="gemini-hero-subtitle">Asisten Pintar <%= (typeof surveyConfig !== 'undefined' ? surveyConfig.name : 'Sensus Ekonomi 2026') %> Penajam Paser Utara. Apa yang ingin Anda analisis atau tanyakan hari ini?</p>
        </div>

        <div class="gemini-suggestion-grid">
          <div class="gemini-card" onclick="sendQuickPrompt('Bagaimana ringkasan progres <%= (typeof surveyConfig !== 'undefined' ? surveyConfig.shortName : 'SE2026') %> Kabupaten Penajam Paser Utara saat ini?')">
            <div class="gemini-card-icon blue"><i class="bi bi-bar-chart-line-fill"></i></div>
            <div class="gemini-card-title">Ringkasan Progres <%= (typeof surveyConfig !== 'undefined' ? surveyConfig.shortName : 'SE2026') %></div>
            <div class="gemini-card-desc"><%= (typeof surveyConfig !== 'undefined' && surveyConfig.id && surveyConfig.id.startsWith('sakernas')) ? 'Cek capaian realisasi dokumen FASIH per kecamatan secara otomatis' : 'Cek capaian realisasi muatan & FASIH per kecamatan secara otomatis' %></div>
          </div>

          <div class="gemini-card" onclick="sendQuickPrompt('Identifikasi <%= (typeof surveyConfig !== 'undefined' && surveyConfig.id && surveyConfig.id.startsWith('sakernas')) ? 'PPL' : 'PCL' %> dan PML dengan performa terendah atau membutuhkan evaluasi')">
            <div class="gemini-card-icon red"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div class="gemini-card-title">Evaluasi Kinerja Petugas</div>
            <div class="gemini-card-desc">Temukan <%= (typeof surveyConfig !== 'undefined' && surveyConfig.id && surveyConfig.id.startsWith('sakernas')) ? 'PPL/PML' : 'PCL/PML' %> dengan tingkat reject tinggi atau progres terlambat</div>
          </div>

          <div class="gemini-card" onclick="sendQuickPrompt('Tampilkan deteksi anomali data, petugas tidak aktif, dan potensi data ganda')">
            <div class="gemini-card-icon purple"><i class="bi bi-shield-exclamation"></i></div>
            <div class="gemini-card-title">Deteksi Anomali Data</div>
            <div class="gemini-card-desc">Analisis potensi kesalahan entri data dan beban SLS tidak seimbang</div>
          </div>

          <div class="gemini-card" onclick="sendQuickPrompt('Berapa rincian target prelist SLS dan realisasi per kecamatan?')">
            <div class="gemini-card-icon green"><i class="bi bi-geo-alt-fill"></i></div>
            <div class="gemini-card-title">Analisis Drilldown Wilayah</div>
            <div class="gemini-card-desc"><%= (typeof surveyConfig !== 'undefined' && surveyConfig.id && surveyConfig.id.startsWith('sakernas')) ? 'Bandingkan statistik SLS dan progres FASIH antar kecamatan di PPU' : 'Bandingkan statistik SLS dan muatan antar 4 kecamatan di PPU' %></div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="chat-footer-wrapper">
      <form id="chatForm" class="gemini-input-bar" onsubmit="handleChatSubmit(event)">
        <textarea id="chatInput" class="gemini-input" rows="1" placeholder="Tanyakan sesuatu pada Pananyo Taka..." required autocomplete="off"></textarea>
        <button type="button" id="chatStopBtn" class="gemini-stop-btn" title="Hentikan Jawaban (Esc)" style="display: none;" onclick="stopCurrentGeneration()">
          <i class="bi bi-stop-fill" style="font-size: 15px;"></i>
        </button>
        <button type="submit" id="chatSendBtn" class="gemini-send-btn" title="Kirim Pesan">
          <i class="bi bi-send-fill" style="font-size: 15px;"></i>
        </button>
      </form>
    </div>
  </div>
</div>

