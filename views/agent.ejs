<div class="fade-in">
  <style>
    /* Lock layout to viewport height specifically for the chatbot page */
    html, body {
      height: 100% !important;
      overflow: hidden !important;
    }
    .main-wrapper {
      height: 100vh !important;
      overflow: hidden !important;
    }
    .page-content {
      height: 100vh !important;
      display: flex !important;
      flex-direction: column !important;
      overflow: hidden !important;
      padding: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    
    @media (max-width: 768px) {
      body.page-agent .page-content {
        height: calc(100dvh - 56px - env(safe-area-inset-bottom, 0px)) !important;
        max-height: calc(100dvh - 56px - env(safe-area-inset-bottom, 0px)) !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }
    }
    
    #pjax-container, .fade-in {
      flex: 1 !important;
      display: flex !important;
      flex-direction: column !important;
      overflow: hidden !important;
      min-height: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    
    .chat-wrapper {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
      min-width: 0;
      background: var(--bg-card);
      border: none !important;
      border-radius: 0 !important;
      overflow: hidden;
      box-shadow: none !important;
    }
    
    .chat-header {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255, 255, 255, 0.01);
    }
    .chat-header-title {
      font-size: 15px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text-primary);
    }
    .chat-header-title i {
      color: var(--accent-blue);
      font-size: 20px;
    }
    .chat-header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .agent-select {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      color: var(--text-primary);
      border-radius: var(--radius-sm);
      padding: 6px 10px;
      font-size: 12px;
      outline: none;
      min-width: 130px;
    }
    .agent-select:focus {
      border-color: var(--accent-blue);
      box-shadow: 0 0 0 2px rgba(var(--accent-rgb), 0.15);
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      border: 1px solid transparent;
      transition: var(--transition);
    }

    .status-badge.ready {
      color: var(--success);
      background: rgba(40, 167, 69, 0.08);
      border-color: rgba(40, 167, 69, 0.16);
    }

    .status-badge.not-ready {
      color: var(--danger);
      background: rgba(220, 53, 69, 0.08);
      border-color: rgba(220, 53, 69, 0.16);
    }

    .status-badge.processing {
      color: #b45309;
      background: rgba(245, 158, 11, 0.12);
      border-color: rgba(245, 158, 11, 0.24);
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 0 2px rgba(255,255,255,0.2);
      flex-shrink: 0;
    }
    
    .chat-messages {
      flex: 1;
      padding: 16px;
      overflow-y: auto;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: rgba(0, 0, 0, 0.1);
      min-width: 0;
    }
    body.light-mode .chat-messages {
      background: rgba(0, 0, 0, 0.02);
    }
    
    .message {
      display: flex;
      flex-direction: column;
      max-width: 85%;
      min-width: 0;
      animation: msg-slide 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes msg-slide {
      from { 
        opacity: 0; 
        transform: translateY(16px);
      }
      to { 
        opacity: 1; 
        transform: translateY(0);
      }
    }
    .message.user {
      align-self: flex-end;
      align-items: flex-end;
    }
    .message.agent {
      align-self: flex-start;
      align-items: flex-start;
    }

    .message-body {
      display: flex;
      gap: 10px;
      align-items: flex-end;
      max-width: 100%;
    }
    .message.user .message-body {
      flex-direction: row-reverse;
    }
    .message.agent .message-body {
      flex-direction: row;
    }
    
    .message-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
      font-weight: 600;
    }
    .message.user .message-avatar {
      background: linear-gradient(135deg, var(--accent-blue), rgba(var(--accent-rgb), 0.7));
      color: white;
      border: 2px solid rgba(var(--accent-rgb), 0.3);
    }
    .message.agent .message-avatar {
      background: linear-gradient(135deg, var(--accent-cyan), rgba(6, 182, 212, 0.7));
      color: white;
      border: 2px solid rgba(6, 182, 212, 0.3);
    }
    
    .message-bubble {
      padding: 12px 18px;
      border-radius: 22px;
      font-size: 13.5px;
      line-height: 1.6;
      max-width: 100%;
      width: fit-content;
      box-sizing: border-box;
      word-break: break-word;
      overflow-wrap: break-word;
    }
    
    /* Code blocks */
    .message-bubble code {
      background: rgba(0, 0, 0, 0.1);
      padding: 2px 6px;
      border-radius: 3px;
      font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
      font-size: 11.5px;
    }
    body.light-mode .message-bubble code {
      background: rgba(0, 0, 0, 0.05);
    }
    
    .message-bubble pre {
      background: rgba(0, 0, 0, 0.15);
      border: 1px solid rgba(0, 0, 0, 0.1);
      padding: 10px 12px;
      border-radius: 6px;
      overflow-x: auto;
      max-width: 100%;
      box-sizing: border-box;
      margin: 10px 0;
      position: relative;
      -webkit-overflow-scrolling: touch;
    }
    body.light-mode .message-bubble pre {
      background: #f5f5f5;
      border-color: #e5e5e5;
    }
    
    .message-bubble pre code {
      background: none;
      padding: 0;
      color: inherit;
      font-size: 11.5px;
    }
    
    .code-block-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0, 0, 0, 0.2);
      padding: 6px 10px;
      border-radius: 4px 4px 0 0;
      margin: -10px -12px 10px -12px;
      font-size: 10.5px;
      color: rgba(255, 255, 255, 0.7);
      font-weight: 600;
      font-family: monospace;
    }
    body.light-mode .code-block-header {
      background: #efefef;
      color: #666;
    }
    
    .copy-code-btn {
      background: rgba(255, 255, 255, 0.15);
      border: none;
      color: white;
      padding: 3px 7px;
      border-radius: 3px;
      font-size: 10.5px;
      cursor: pointer;
      transition: all 0.2s;
      font-weight: 500;
    }
    body.light-mode .copy-code-btn {
      color: #333;
      background: rgba(0, 0, 0, 0.08);
    }
    .copy-code-btn:hover {
      background: rgba(255, 255, 255, 0.25);
    }
    body.light-mode .copy-code-btn:hover {
      background: rgba(0, 0, 0, 0.12);
    }
    
    /* Markdown elements */
    .message-bubble h1, .message-bubble h2, .message-bubble h3 {
      margin: 12px 0 6px 0;
      font-weight: 700;
      line-height: 1.3;
    }
    .message-bubble h1 {
      font-size: 15px;
      border-bottom: 2px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 6px;
    }
    .message-bubble h2 {
      font-size: 13.5px;
      color: var(--accent-blue);
    }
    .message-bubble h3 {
      font-size: 12.5px;
    }
    
    .message-bubble blockquote {
      border-left: 3px solid var(--accent-blue);
      padding-left: 10px;
      margin: 10px 0;
      color: var(--text-secondary);
      font-style: italic;
    }
    
    .message-bubble ul, .message-bubble ol {
      margin: 8px 0;
      padding-left: 20px;
    }
    .message-bubble li {
      margin: 4px 0;
    }
    
    .message-bubble strong {
      font-weight: 700;
      color: var(--accent-blue);
    }
    .message-bubble em {
      font-style: italic;
    }
    
    .message-bubble a {
      color: var(--accent-blue);
      text-decoration: none;
      font-weight: 500;
      border-bottom: 1px solid rgba(var(--accent-rgb), 0.3);
      transition: all 0.2s;
    }
    .message-bubble a:hover {
      border-bottom-color: var(--accent-blue);
      opacity: 0.8;
    }
    
    .message-bubble p {
      margin: 6px 0;
    }
    .message-bubble p:first-child {
      margin-top: 0;
    }
    .message-bubble p:last-child {
      margin-bottom: 0;
    }
    
    .alert {
      padding: 10px 12px;
      border-radius: var(--radius-md);
      border: 1px solid;
      margin: 8px 0;
      font-size: 12px;
    }
    .alert-error {
      background: rgba(220, 53, 69, 0.1);
      border-color: rgba(220, 53, 69, 0.3);
      color: #dc3545;
    }
    .alert-success {
      background: rgba(40, 167, 69, 0.1);
      border-color: rgba(40, 167, 69, 0.3);
      color: #28a745;
    }
    .alert-info {
      background: rgba(23, 162, 184, 0.1);
      border-color: rgba(23, 162, 184, 0.3);
      color: #17a2b8;
    }
    .message.user .message-bubble {
      background: rgba(66, 133, 244, 0.12);
      color: var(--text-primary);
      border: 1px solid rgba(66, 133, 244, 0.25);
      border-radius: 22px 22px 4px 22px;
      box-shadow: var(--shadow-sm);
    }
    
    body.light-mode .message.user .message-bubble {
      background: #e8f0fe;
      color: #1e293b;
      border-color: #d2e3fc;
    }

    .message.agent .message-bubble {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-primary);
      border-radius: 4px 22px 22px 22px;
      box-shadow: var(--shadow-sm);
    }

    /* Google Gemini Style Action Buttons (Icon-only & Below Chat Bubble) */
    .user-message-actions,
    .agent-message-actions {
      display: flex;
      align-items: center;
      gap: 2px;
      margin-top: 4px;
      opacity: 0.75;
      transition: opacity 0.2s ease;
    }

    .user-message-actions {
      justify-content: flex-end;
      padding-right: 4px;
    }

    .agent-message-actions {
      justify-content: flex-start;
      padding-left: 4px;
    }

    .message:hover .user-message-actions,
    .message:hover .agent-message-actions {
      opacity: 1;
    }

    .chat-action-icon-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      padding: 0;
    }

    .chat-action-icon-btn:hover {
      color: var(--text-primary);
      background: var(--bg-secondary);
      transform: scale(1.08);
    }

    .chat-action-icon-btn:active {
      transform: scale(0.92);
    }
    
    .table-container {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 10px 0;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.05);
      box-sizing: border-box;
      display: block;
    }
    .table-container::-webkit-scrollbar {
      height: 4px;
    }
    .table-container::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.1);
      border-radius: 2px;
    }
    .table-container::-webkit-scrollbar-thumb {
      background: var(--accent-blue);
      border-radius: 2px;
    }
    body.light-mode .table-container {
      background: rgba(0, 0, 0, 0.01);
    }
    .message-bubble table {
      width: 100%;
      min-width: 480px;
      border-collapse: collapse;
      margin: 0;
      font-size: 11.5px;
    }
    .message-bubble > table {
      display: block;
      overflow-x: auto;
      max-width: 100%;
      -webkit-overflow-scrolling: touch;
    }
    .message-bubble th, .message-bubble td {
      border: none;
      border-bottom: 1px solid var(--border-light);
      padding: 8px 10px;
      text-align: left;
      white-space: nowrap;
    }
    .message-bubble tr:last-child td {
      border-bottom: none;
    }
    .message-bubble th {
      background: rgba(255, 255, 255, 0.03);
      font-weight: 600;
    }
    body.light-mode .message-bubble th {
      background: rgba(0, 0, 0, 0.02);
    }
    
    .quick-prompts {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 10px 16px;
      border-top: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.005);
    }
    .prompt-btn {
      background: rgba(var(--accent-rgb), 0.05);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11.5px;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .prompt-btn:hover {
      background: rgba(var(--accent-rgb), 0.15);
      border-color: var(--accent-blue);
      color: var(--text-primary);
      transform: translateY(-1px);
    }
    
    .chat-footer-wrapper {
      padding: 12px 20px 16px 20px;
      background: var(--bg-card);
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 20;
      flex-shrink: 0;
    }

    .quick-prompts-bar {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }
    .quick-prompts-bar::-webkit-scrollbar {
      display: none;
    }

    .prompt-pill {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      border-radius: 99px;
      padding: 5px 12px;
      font-size: 11.5px;
      font-weight: 500;
      white-space: nowrap;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .prompt-pill:hover {
      border-color: var(--accent-blue);
      color: var(--text-primary);
      background: rgba(var(--accent-rgb), 0.08);
      transform: translateY(-1px);
    }
    
    /* Google Gemini Gradient Text & Iconic Sparkle */
    .gemini-gradient-text {
      background: linear-gradient(135deg, #4285F4 0%, #9b72cb 45%, #d96570 75%, #d97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    
    .gemini-sparkle-icon {
      color: #4285F4;
      animation: geminiSparkle 3s ease-in-out infinite alternate;
    }

    @keyframes geminiSparkle {
      0% { transform: scale(1) rotate(0deg); filter: hue-rotate(0deg); }
      100% { transform: scale(1.15) rotate(15deg); filter: hue-rotate(90deg); }
    }

    /* Gemini Hero & Suggestion Cards */
    .gemini-welcome-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 36px 20px 20px 20px;
      max-width: 860px;
      margin: 0 auto;
      text-align: center;
      animation: msg-slide 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .gemini-hero-sparkle {
      font-size: 38px;
      color: #4285F4;
      margin-bottom: 12px;
      animation: geminiSparkle 3s ease-in-out infinite alternate;
    }

    .gemini-hero-title {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 8px;
      letter-spacing: -0.02em;
    }

    .gemini-hero-subtitle {
      font-size: 13.5px;
      color: var(--text-secondary);
      margin-bottom: 28px;
      max-width: 620px;
      line-height: 1.5;
    }

    .gemini-suggestion-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 12px;
      width: 100%;
    }

    .gemini-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      text-align: left;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .gemini-card:hover {
      border-color: #4285F4;
      background: var(--bg-card-hover);
      transform: translateY(-3px);
      box-shadow: 0 12px 28px -8px rgba(66, 133, 244, 0.25);
    }

    .gemini-card-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .gemini-card-icon.blue { background: rgba(66, 133, 244, 0.12); color: #4285F4; }
    .gemini-card-icon.red { background: rgba(239, 68, 68, 0.12); color: #ef4444; }
    .gemini-card-icon.purple { background: rgba(155, 114, 203, 0.12); color: #9b72cb; }
    .gemini-card-icon.green { background: rgba(16, 185, 129, 0.12); color: #10b981; }

    .gemini-card-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .gemini-card-desc {
      font-size: 11px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Gemini Pill Input Box */
    .gemini-input-bar {
      background: var(--bg-secondary);
      border: 1.5px solid var(--border);
      border-radius: 30px;
      padding: 4px 6px 4px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-sizing: border-box;
    }

    .gemini-input-bar:focus-within {
      border-color: #4285F4;
      box-shadow: 0 0 0 3px rgba(66, 133, 244, 0.2), 0 8px 24px rgba(0, 0, 0, 0.18);
      background: var(--bg-card);
    }

    .gemini-input {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--text-primary);
      padding: 9px 0 7px 0;
      margin: 0;
      font-size: 14px;
      line-height: 1.35;
      outline: none;
      resize: none;
      height: 38px;
      min-height: 38px;
      max-height: 120px;
      font-family: inherit;
      box-sizing: border-box;
    }

    .gemini-input::placeholder {
      color: var(--text-muted);
    }

    .gemini-send-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(135deg, #4285F4 0%, #9b72cb 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 12px rgba(66, 133, 244, 0.3);
      padding: 0;
    }

    .gemini-send-btn i {
      font-size: 15px;
      line-height: 1;
      display: inline-block;
      margin-top: 2px;
      margin-left: -1px;
    }

    .gemini-send-btn:hover {
      transform: scale(1.06);
      box-shadow: 0 6px 18px rgba(66, 133, 244, 0.45);
    }

    .gemini-send-btn:active {
      transform: scale(0.94);
    }
    .chat-input::placeholder {
      color: var(--text-muted);
    }
    .chat-input-area button {
      height: 40px;
      padding: 0 18px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }
    
    /* Typing Loader */
    .typing-loader {
      display: flex;
      gap: 5px;
      padding: 4px 0;
      align-items: center;
      height: 24px;
    }
    .typing-dot {
      width: 7px;
      height: 7px;
      background: var(--text-muted);
      border-radius: 50%;
      animation: typing-bounce 1.4s infinite ease-in-out both;
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.2);
    }
    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }
    @keyframes typing-bounce {
      0%, 80%, 100% { 
        transform: scale(0.8);
        opacity: 0.5;
      }
      40% { 
        transform: scale(1.2);
        opacity: 1;
      }
    }
    
    /* Loading indicator */
    .loading-spinner {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-top-color: var(--accent-blue);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-right: 8px;
      vertical-align: middle;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    @media (max-width: 768px) {
      .chat-messages {
        padding: 10px 8px !important;
        gap: 10px !important;
      }
      .message {
        max-width: 98% !important;
        gap: 6px !important;
      }
      .message-avatar {
        width: 24px !important;
        height: 24px !important;
