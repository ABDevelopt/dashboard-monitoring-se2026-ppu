  const defaultAnswer = `🤖 **Menganalisis database SQLite...**<br>Saya telah membaca skema tabel <code>subsls_master</code> and <code>progres</code>. Pertanyaan Anda berkaitan dengan analisis data sensus harian.<br><br>Untuk memberikan informasi real-time, saya dapat menjalankan query pembacaan data. Namun, saat ini fitur AI Agent berjalan dalam **Mode Simulasi (Preview)**.<br><br>**Menu yang Terdeteksi pada Database:**<br><ul><li>Jumlah SLS Terisi: <strong>1.042 SLS</strong></li><li>Jumlah Kecamatan: <strong>4 Kecamatan</strong> (Penajam, Waru, Babulu, Sepaku)</li></ul><br>Apabila integrasi Gemini API key telah selesai dikonfigurasi di file <code>.env</code> server, saya akan dapat menjawab kueri dinamis apa pun secara langsung dari SQLite.`;

  window.copyChatMessage = function(btn) {
    const messageDiv = btn.closest('.message');
    if (!messageDiv) return;
    const bubble = messageDiv.querySelector('.message-bubble');
    if (!bubble) return;

    const textToCopy = bubble.innerText || bubble.textContent;
    if (!textToCopy) return;

    const showCopiedFeedback = () => {
      const icon = btn.querySelector('i');
      if (icon) {
        const origClass = icon.className;
        icon.className = 'bi bi-check2 text-green';
        btn.title = 'Tersalin!';
        setTimeout(() => {
          icon.className = origClass;
          btn.title = 'Salin Pesan';
        }, 1800);
      }
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(textToCopy.trim()).then(showCopiedFeedback).catch(() => {
        fallbackCopyText(textToCopy.trim());
        showCopiedFeedback();
      });
    } else {
      fallbackCopyText(textToCopy.trim());
      showCopiedFeedback();
    }
  };

  function fallbackCopyText(text) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try { document.execCommand('copy'); } catch (_) {}
    document.body.removeChild(textarea);
  }

  window.resendUserMessage = function(btn) {
    const messageDiv = btn.closest('.message.user');
    if (!messageDiv) return;
    const bubble = messageDiv.querySelector('.message-bubble');
    if (!bubble) return;
    
    const text = bubble.innerText || bubble.textContent;
    const chatInput = document.getElementById('chatInput');
    
    if (chatInput) {
      chatInput.value = text.trim();
      chatInput.style.height = 'auto';
      chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
      chatInput.focus();
      chatInput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  };

  function appendMessage(sender, content, isHtml = false) {
    const container = document.getElementById('chatMessages');
    const msgDiv = document.createElement('div');
    msgDiv.className = `message ${sender}`;
    
    const bodyDiv = document.createElement('div');
    bodyDiv.className = 'message-body';
    
    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    
    if (isHtml) {
      bubble.innerHTML = content;
    } else {
      bubble.textContent = content;
    }
    
    bodyDiv.appendChild(bubble);
    msgDiv.appendChild(bodyDiv);

    if (sender === 'user') {
      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'user-message-actions';
      actionsDiv.innerHTML = `
        <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Pesan">
          <i class="bi bi-copy"></i>
        </button>
        <button type="button" class="chat-action-icon-btn" onclick="window.resendUserMessage(this)" title="Kirim Ulang Pesan">
          <i class="bi bi-arrow-repeat"></i>
        </button>
      `;
      msgDiv.appendChild(actionsDiv);
    } else {
      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'agent-message-actions';
      actionsDiv.innerHTML = `
        <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Jawaban">
          <i class="bi bi-copy"></i>
        </button>
      `;
      msgDiv.appendChild(actionsDiv);
    }

    container.appendChild(msgDiv);
    container.scrollTop = container.scrollHeight;
    return msgDiv;
  }

  // Synchronous append message helper to prevent thread paint delays
  function appendMessageAsync(sender, replyText) {
    return new Promise((resolve) => {
      const container = document.getElementById('chatMessages');
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${sender}`;

      const bodyDiv = document.createElement('div');
      bodyDiv.className = 'message-body';

      const bubble = document.createElement('div');
      bubble.className = 'message-bubble';

      bodyDiv.appendChild(bubble);
      msgDiv.appendChild(bodyDiv);

      if (sender === 'user') {
        bubble.innerHTML = renderMarkdown(replyText);
        
        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'user-message-actions';
        actionsDiv.innerHTML = `
          <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Pesan">
            <i class="bi bi-copy"></i>
          </button>
          <button type="button" class="chat-action-icon-btn" onclick="window.resendUserMessage(this)" title="Kirim Ulang Pesan">
            <i class="bi bi-arrow-repeat"></i>
          </button>
        `;
        msgDiv.appendChild(actionsDiv);

        container.appendChild(msgDiv);
        container.scrollTop = container.scrollHeight;
        resolve(msgDiv);
        return;
      }

      container.appendChild(msgDiv);
      container.scrollTop = container.scrollHeight;

      // Pre-render blocks to avoid repeating O(N^2) Markdown parsing in animation frames
      const blocksHtml = renderMarkdownBlocks(replyText);
      let blockIndex = 0;

      // Append blocks progressively with a smooth transition, completely lag-free
      function appendNextBlock() {
        if (blockIndex < blocksHtml.length) {
          const block = document.createElement('div');
          block.style.opacity = '0';
          block.style.transition = 'opacity 0.15s ease-out';
          block.innerHTML = blocksHtml[blockIndex];
          
          bubble.appendChild(block);
          
          // Trigger reflow
          block.offsetHeight;
          block.style.opacity = '1';
          
          container.scrollTop = container.scrollHeight;
          blockIndex++;
          
          // Dynamic delay (shorter if there are many blocks to complete in reasonable time)
          const delay = Math.max(30, Math.min(100, Math.ceil(800 / blocksHtml.length)));
          setTimeout(appendNextBlock, delay);
        } else {
          const actionsDiv = document.createElement('div');
          actionsDiv.className = 'agent-message-actions';
          actionsDiv.innerHTML = `
            <button type="button" class="chat-action-icon-btn" onclick="window.copyChatMessage(this)" title="Salin Jawaban">
              <i class="bi bi-copy"></i>
            </button>
          `;
          msgDiv.appendChild(actionsDiv);
          resolve(msgDiv);
        }
      }

      appendNextBlock();
    });
  }

  function showTypingLoader() {
    const container = document.getElementById('chatMessages');
    const loaderDiv = document.createElement('div');
    loaderDiv.className = 'message agent temp-loader';
    
    const bodyDiv = document.createElement('div');
    bodyDiv.className = 'message-body';
    
    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    bubble.innerHTML = `
      <div class="typing-loader-container" style="display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 12px; padding: 4px 0;">
          <div class="typing-loader" style="flex-shrink: 0;">
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
          </div>
          <span class="typing-loader-text" style="font-size: 11.5px; font-weight: 600; color: var(--accent-cyan); display: flex; align-items: center; gap: 6px;">
            <i class="bi bi-robot" style="font-size: 13px;"></i> Pananyo Taka berpikir...
          </span>
        </div>
      </div>
    `;
    bodyDiv.appendChild(bubble);
    loaderDiv.appendChild(bodyDiv);
    container.appendChild(loaderDiv);
    container.scrollTop = container.scrollHeight;

    const timers = [];
    const steps = [
      { delay: 3000, text: '⚙️ Menghubungkan ke basis data SQLite...' },
      { delay: 8000, text: '📊 Mengambil data progres kabupaten...' },
      { delay: 15000, text: '🧠 Melakukan penalaran & perbandingan data...' },
      { delay: 25000, text: '📋 Memeriksa target alokasi & realisasi...' },
      { delay: 35000, text: '🔍 Mencari potensi anomali & kualitas data...' },
      { delay: 50000, text: '✍️ Memformat tabel laporan akhir...' }
    ];
    
    steps.forEach(step => {
      const t = setTimeout(() => {
        const textEl = loaderDiv.querySelector('.agent-step-text');
        if (textEl) {
          textEl.style.opacity = '0';
          setTimeout(() => {
            textEl.textContent = step.text;
            textEl.style.opacity = '1';
          }, 300);
        }
      }, step.delay);
      timers.push(t);
    });

    loaderDiv.cleanup = () => {
      timers.forEach(t => clearTimeout(t));
    };
    
    return loaderDiv;
  }

  function removeLoader(loader) {
    if (loader) {
      if (typeof loader.cleanup === 'function') {
        try { loader.cleanup(); } catch (e) {}
      }
      if (loader.parentElement) loader.remove();
    }
  }

  // FIX #1 + #4 — handleChatSubmit dengan _isProcessing guard yang benar
  // Semua state (input, button, flag) dikelola lewat setUIBusy/setUIFree
  // untuk memastikan tidak ada celah double-request.
  function setUIBusy(input, submitBtn) {
    _isProcessing = true;
    input.disabled = true;
    submitBtn.disabled = true;
    // Disable semua quick-prompt buttons juga
    document.querySelectorAll('.prompt-btn').forEach(btn => btn.disabled = true);
  }

  function setUIFree(input, submitBtn) {
    _isProcessing = false;
    input.disabled = false;
    submitBtn.disabled = false;
    document.querySelectorAll('.prompt-btn').forEach(btn => btn.disabled = false);
    input.focus();
  }

  async function handleChatSubmit(e) {
    e.preventDefault();

    // FIX #1 — Guard: tolak submit jika masih ada request aktif
    if (_isProcessing) return;

    const input = document.getElementById('chatInput');
    const submitBtn = document.querySelector('#chatForm button[type="submit"]');
    const text = input.value.trim();
    if (!text) return;

    // Kunci UI segera sebelum operasi async apapun
    setUIBusy(input, submitBtn);

    appendMessage('user', text);
    chatHistory.push({ role: 'user', content: text });
    saveChatHistory();
    input.value = '';

    const loader = showTypingLoader();
    startAgentWaitIndicator();

    // FIX #2 — Timeout browser 60 000 ms (lebih lama dari server outer total tries worst-case 54 000 ms)
    // agar server selalu selesai (atau timeout) lebih dulu, mencegah write ke koneksi mati.
    const controller = new AbortController();
    let timeoutFired = false;

    const browserTimeout = setTimeout(() => {
      timeoutFired = true;
      controller.abort();
      removeLoader(loader);
      appendMessage('agent', `<div class="alert alert-error"><i class="bi bi-exclamation-triangle"></i> <strong>Permintaan terlalu lama.</strong> Server sedang sibuk atau jaringan lambat. Coba lagi atau gunakan pertanyaan yang lebih spesifik.</div>`, true);
      clearAgentWaitIndicator();
      setUIFree(input, submitBtn);
    }, 60000);

    try {
      const res = await fetch('/agent/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: controller.signal,
        body: JSON.stringify({
          message: text,
          history: chatHistory.slice(Math.max(0, chatHistory.length - 11), -1),
          provider: document.getElementById('agentProvider')?.value || 'gemini',
          model: document.getElementById('agentModel')?.value || ''
        })
      });

      clearTimeout(browserTimeout);

      // Jika timeout sudah tembak duluan, hentikan — UI sudah di-free oleh timeout handler
      if (timeoutFired) return;

      removeLoader(loader);

      let data;
      try {
        data = await res.json();
      } catch (jsonErr) {
        throw new Error('Respons server tidak valid.');
      }

      if (!res.ok || data.error) {
        throw new Error(data.error || 'Gagal memproses pesan.');
      }

      const reply = data.reply || 'Maaf, tidak ada jawaban dari agent.';

      // FIX #5 — Gunakan appendMessageAsync agar render tidak blokir UI thread
      await appendMessageAsync('agent', reply);
      
      // Do not save technical error messages to chat history to prevent polluting AI context
      const isErrorReply = reply.includes('Model tidak mengembalikan teks') || 
                           reply.includes('API Provider Error') || 
                           reply.includes('Kesalahan:') || 
                           reply.includes('dibatalkan');
      if (!isErrorReply) {
        chatHistory.push({ role: 'model', content: reply });
        saveChatHistory();
      }

    } catch (err) {
      clearTimeout(browserTimeout);
      if (timeoutFired) return; // Sudah ditangani oleh timeout handler

      removeLoader(loader);

      if (err.name === 'AbortError') {
        // AbortError karena timeout sudah ditangani di atas — ini tidak seharusnya tercapai
        appendMessage('agent', `<div class="alert alert-error"><i class="bi bi-exclamation-triangle"></i> <strong>Permintaan dibatalkan karena waktu tunggu habis.</strong> Silakan coba lagi.</div>`, true);
      } else {
        appendMessage('agent', `<div class="alert alert-error"><i class="bi bi-exclamation-triangle"></i> <strong>Kesalahan:</strong> ${escapeHtml(err.message)}</div>`, true);
      }
    } finally {
      clearTimeout(browserTimeout);
      // Hapus loader jika masih ada — bisa terjadi jika exception terlempar sebelum loader.remove() di try
      removeLoader(loader);
      clearAgentWaitIndicator();
      // Bebaskan UI: panggil setUIFree SELALU kecuali timeout handler sudah menanganinya.
      // timeoutFired diset true HANYA di dalam setTimeout callback, jadi jika kita tiba
      // di sini karena alasan lain (error, success), _isProcessing masih true dan perlu dibebaskan.
      if (!timeoutFired) {
        setUIFree(input, submitBtn);
      }
    }
  }

  // FIX #3 — sendQuickPrompt: cek _isProcessing sebelum dispatch
  // dispatchEvent melewati attribute `disabled` pada elemen, jadi butuh guard manual ini.
  function sendQuickPrompt(promptText) {
    if (_isProcessing) return; // Tolak jika sedang ada request aktif
    const input = document.getElementById('chatInput');
    if (!input || input.disabled) return;
    input.value = promptText;
    document.getElementById('chatForm').dispatchEvent(new Event('submit'));
  }

  document.addEventListener('DOMContentLoaded', () => {
    const providerSelect = document.getElementById('agentProvider');
    const modelSelect = document.getElementById('agentModel');
    refreshModelSelect();
    updateAgentStatus();
    loadChatHistory();

    if (providerSelect) {
      providerSelect.addEventListener('change', () => {
        refreshModelSelect();
        updateAgentStatus();
      });
    }

    if (modelSelect) {
      modelSelect.addEventListener('change', () => {
        const provider = providerSelect ? providerSelect.value : 'gemini';
        selectedModels[provider] = modelSelect.value;
      });
    }
    const chatInput = document.getElementById('chatInput');
    if (chatInput) {
      chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          document.getElementById('chatForm').dispatchEvent(new Event('submit'));
        }
      });
      chatInput.addEventListener('input', () => {
        chatInput.style.height = 'auto';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 140) + 'px';
      });
    }
  });

  // Expose functions globally to HTML handlers
  window.clearChatHistory = clearChatHistory;
  window.handleChatSubmit = handleChatSubmit;
  window.sendQuickPrompt = sendQuickPrompt;
  window.copyCodeToClipboard = copyCodeToClipboard;
})();
</script>
