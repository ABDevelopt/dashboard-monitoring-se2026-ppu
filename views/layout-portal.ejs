<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Portal Pananyo Taka — BPS Kab. Penajam Paser Utara' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/logo-pananyo-taka-flow.svg">
  <link rel="apple-touch-icon" href="/images/logo-pananyo-taka-flow.svg">
  <meta name="theme-color" content="#0b0f19">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+=" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/style.min.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '1' %>">
  <link rel="stylesheet" href="/css/framework.min.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '1' %>">
  <link rel="stylesheet" href="/css/survey-themes.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '1' %>">

  <style>
    /* =========================================================================
       PANANYO TAKA PORTAL DESIGN SYSTEM — LUXURY, MODERN, ULTRA-CLEAN
       ========================================================================= */
    :root {
      --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

      --bg-portal: #080c14;
      --bg-portal-card: rgba(15, 23, 42, 0.75);
      --bg-portal-card-hover: rgba(22, 33, 62, 0.85);
      --bg-portal-glass: rgba(11, 17, 32, 0.82);
      
      --border-portal: rgba(255, 255, 255, 0.08);
      --border-portal-hover: rgba(255, 255, 255, 0.18);

      --text-portal-1: #f8fafc;
      --text-portal-2: #cbd5e1;
      --text-portal-3: #64748b;

      --accent-orange: #f97316;
      --accent-orange-rgb: 249, 115, 22;
      --accent-cyan: #06b6d4;
      --accent-cyan-rgb: 6, 182, 212;
      --accent-purple: #8b5cf6;
      --accent-purple-rgb: 139, 92, 246;
      --accent-green: #10b981;
      --accent-green-rgb: 16, 185, 129;
      
      --glow-orange: 0 10px 30px -10px rgba(249, 115, 22, 0.35);
      --glow-cyan: 0 10px 30px -10px rgba(6, 182, 212, 0.35);
      --glow-purple: 0 10px 30px -10px rgba(139, 92, 246, 0.35);
    }

    html.light-mode {
      --bg-portal: #f8fafc;
      --bg-portal-card: #ffffff;
      --bg-portal-card-hover: #f1f5f9;
      --bg-portal-glass: rgba(255, 255, 255, 0.88);
      --border-portal: #e2e8f0;
      --border-portal-hover: #cbd5e1;
      --text-portal-1: #0f172a;
      --text-portal-2: #334155;
      --text-portal-3: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--bg-portal);
      color: var(--text-portal-1);
      min-height: 100vh;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Ambient Background Glow */
    .portal-ambient {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .portal-ambient::before {
      content: '';
      position: absolute;
      top: -200px;
      left: 20%;
      width: 700px;
      height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(var(--accent-orange-rgb), 0.07) 0%, transparent 70%);
      filter: blur(80px);
    }

    .portal-ambient::after {
      content: '';
      position: absolute;
      bottom: -150px;
      right: 15%;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(var(--accent-cyan-rgb), 0.06) 0%, transparent 70%);
      filter: blur(80px);
    }

    .portal-wrapper {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* ── FLOATING LOGO BRAND (POJOK KIRI ATAS SEJAJAR TOMBOL THEME) ── */
    .portal-floating-brand {
      position: fixed;
      top: 18px;
      left: 22px;
      z-index: 1000;
      height: 42px;
      padding: 0 14px 0 8px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--bg-portal-card);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1.5px solid var(--border-portal);
      color: var(--text-portal-1);
      text-decoration: none;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .portal-floating-brand:hover {
      border-color: var(--accent-orange, #f97316);
      transform: scale(1.04);
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.15);
    }

    .portal-floating-brand img {
      width: 28px;
      height: 28px;
      object-fit: contain;
      filter: drop-shadow(0 2px 6px rgba(249, 115, 22, 0.3));
    }

    .portal-floating-brand-text {
      font-family: var(--font-display, inherit);
      font-weight: 800;
      font-size: 13.5px;
      letter-spacing: 0.02em;
      color: var(--text-portal-1);
    }

    /* ── FLOATING THEME TOGGLE BUTTON (TANPA PORTAL-NAV) ── */
    .portal-floating-theme-btn {
      position: fixed;
      top: 18px;
      right: 22px;
      z-index: 1000;
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-portal-card);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1.5px solid var(--border-portal);
      color: var(--text-portal-1);
      cursor: pointer;
      font-size: 16px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .portal-floating-theme-btn:hover {
      border-color: var(--accent-orange);
      color: var(--accent-orange);
      transform: scale(1.06);
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.15);
    }

    /* ── MAIN CONTENT CONTAINER ── */
    .portal-main-content {
      flex: 1;
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 24px 20px 64px;
    }

    /* ── FOOTER ── */
    .portal-foot {
      border-top: 1px solid var(--border-portal);
      background: var(--bg-portal-glass);
      backdrop-filter: blur(12px);
      padding: 20px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 12px;
      color: var(--text-portal-3);
    }

    .portal-foot-brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    @media (max-width: 768px) {
      .portal-floating-brand { top: 12px; left: 14px; height: 38px; padding: 0 8px; width: 38px; justify-content: center; border-radius: 12px; }
      .portal-floating-brand-text { display: none; }
      .portal-floating-brand img { width: 22px; height: 22px; }
      .portal-floating-theme-btn { top: 12px; right: 14px; width: 38px; height: 38px; }
      .portal-main-content { padding: 16px 12px 48px; }
      .portal-foot { padding: 16px; flex-direction: column; text-align: center; }
    }
  </style>
</head>
<body>

  <div class="portal-ambient"></div>

  <!-- Floating Brand Logo (Top-Left Corner, Sejajar Tombol Theme) -->
  <a href="/surveys" class="portal-floating-brand" title="Portal Pananyo Taka — BPS Kab. Penajam Paser Utara" aria-label="Logo Portal Pananyo Taka">
    <img src="/images/logo-pananyo-taka-flow.svg" alt="Logo Pananyo Taka">
    <span class="portal-floating-brand-text">Pananyo Taka</span>
  </a>

  <!-- Floating Theme Button (Top-Right Corner) -->
  <button type="button" class="portal-floating-theme-btn" id="themeToggleBtn" title="Ganti Mode Gelap / Terang" aria-label="Ganti Mode Tema">
    <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
  </button>

  <div class="portal-wrapper">
    <!-- Main View Body -->
    <main class="portal-main-content">
      <%- body %>
    </main>

    <!-- Footer -->
    <footer class="portal-foot">
      <div class="portal-foot-brand">
        <img src="/images/logo-pananyo-taka-flow.svg" alt="Logo Pananyo Taka" width="22" height="22" style="object-fit: contain; vertical-align: middle; filter: drop-shadow(0 2px 6px rgba(249, 115, 22, 0.25));">
        <span>Badan Pusat Statistik Kabupaten Penajam Paser Utara &bull; Jl. Propinsi Km. 9, Nipah-Nipah</span>
      </div>
      <div>
        <span>&copy; 2026 BPS Kab. Penajam Paser Utara &bull; v<%= typeof packageVersion !== 'undefined' ? packageVersion : '2.5.0' %></span>
      </div>
    </footer>
  </div>

  <script>
    // Theme Switcher Sync with Dashboard
    const themeBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');

    function applyTheme(theme) {
      if (theme === 'light') {
        document.documentElement.classList.add('light-mode');
        if (themeIcon) {
          themeIcon.classList.remove('bi-moon-stars-fill');
          themeIcon.classList.add('bi-sun-fill');
        }
      } else {
        document.documentElement.classList.remove('light-mode');
        if (themeIcon) {
          themeIcon.classList.remove('bi-sun-fill');
          themeIcon.classList.add('bi-moon-stars-fill');
        }
      }
    }

    // Init Theme from LocalStorage
    const savedTheme = localStorage.getItem('theme') || 'dark';
    applyTheme(savedTheme);

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isLight = document.documentElement.classList.contains('light-mode');
        const nextTheme = isLight ? 'dark' : 'light';
        localStorage.setItem('theme', nextTheme);
        applyTheme(nextTheme);
      });
    }
  </script>
</body>
</html>
