<div class="fade-in">
  <% if (!uploadId) { %>
    <div class="card empty-state">
      <div class="empty-state-icon"><i class="bi bi-bell-slash"></i></div>
      <div class="empty-state-title">Belum Ada Peringatan Dini</div>
      <div class="empty-state-text">Upload file Excel untuk mulai mendeteksi petugas yang berisiko tidak mencapai target dan memerlukan perhatian khusus.</div>
      <a href="/admin/upload" class="empty-state-action"><i class="bi bi-cloud-arrow-up-fill"></i> Upload Data Sekarang</a>
    </div>
  <% } else { %>
    <!-- FILTER BAR -->
    <div class="card" style="margin-bottom: 20px;">
      <div class="card-header" style="margin-bottom: 8px; padding-bottom: 8px;">
        <div class="card-title"><i class="bi bi-search"></i> Filter Pencarian Early Warning</div>
        <a href="/early-warning" class="btn btn-secondary btn-xs"><i class="bi bi-arrow-repeat"></i> Reset Filter</a>
      </div>
      
      <form action="/early-warning" method="GET" id="filterForm">
        <div class="filter-form-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: 10px;">
          
          <div>
            <label for="filterKec" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">Kecamatan</label>
            <select id="filterKec" name="kec" onchange="this.form.submit();" style="width:100%;">
              <option value="">-- Semua Kecamatan --</option>
              <% kecList.forEach(k => { %>
                <option value="<%= k.kecamatan %>" <%= filterKec === k.kecamatan ? 'selected' : '' %>><%= k.kecamatan %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="filterKorlap" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">Koordinator Lapangan</label>
            <select id="filterKorlap" name="korlap" onchange="this.form.submit();" style="width:100%;">
              <option value="">-- Semua Korlap --</option>
              <% korlapList.forEach(k => { %>
                <option value="<%= k.korlap %>" <%= filterKorlap === k.korlap ? 'selected' : '' %>><%= k.korlap %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="filterPml" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">PML (Pengawas)</label>
            <select id="filterPml" name="pml" onchange="this.form.submit();" style="width:100%;">
              <option value="">-- Semua PML --</option>
              <% pmlList.forEach(p => { %>
                <option value="<%= p.pml %>" <%= filterPml === p.pml ? 'selected' : '' %>><%= p.pml %></option>
              <% }) %>
            </select>
          </div>
          
        </div>
      </form>
    </div>

    <!-- HEADER RINGKASAN EARLY WARNING -->
    <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
      <div class="stat-card yellow">
        <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
        <div class="stat-label">PCL Progres Lambat</div>
        <div class="stat-value"><%= warning.slowPcl.length %></div>
        <div class="stat-sub">Pencacah < 5.0 dokumen/hari</div>
      </div>
      <div class="stat-card orange">
        <div class="stat-icon"><i class="bi bi-pause-circle"></i></div>
        <div class="stat-label">PCL Stagnan 2 Hari</div>
        <div class="stat-value"><%= warning.stagnanPcl.length %></div>
        <div class="stat-sub">Tidak ada penambahan dokumen FASIH</div>
      </div>
      <div class="stat-card red" style="background: linear-gradient(135deg, var(--bg-card) 0%, rgba(239, 68, 68, 0.05) 100%);">
        <div class="stat-icon" style="color: var(--accent-red); background: rgba(239, 68, 68, 0.1);"><i class="bi bi-graph-down"></i></div>
        <div class="stat-label">PCL Berisiko Tinggi</div>
        <div class="stat-value" style="color: var(--accent-red);"><%= (warning.lowProjectedPcl || []).length %></div>
        <div class="stat-sub">Prediksi < 40% (15 Jul) / < 100% (<%= formatIndonesianDateShort(settings.speedometer_target_date || '2026-08-31') %>)</div>
      </div>
    </div>

    <!-- PENGUMUMAN EARLY WARNING -->
     <!-- PCL STAGNAN (TIDAK ADA PENAMBAHAN SELAMA 2 HARI) -->
    <div class="card mt-4">
      <div class="card-header">
        <div class="card-title">
          <span class="text-orange"><i class="bi bi-pause-circle"></i> PCL Stagnan — Tidak Ada Penambahan Dokumen FASIH selama 2 Hari</span>
        </div>
        <span class="badge badge-orange"><%= warning.stagnanPcl.length %> Petugas</span>
      </div>

      <% if (warning.stagnanPcl.length > 0) { %>
        <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px;">
          PCL berikut tidak memiliki penambahan dokumen FASIH (Submit + Approve + Reject) selama 2 hari terakhir.
          <% if (warning.stagnanPcl[0] && warning.stagnanPcl[0].tanggal_prev) { %>
            Pembanding: upload tanggal <strong><%= warning.stagnanPcl[0].tanggal_prev %></strong> vs upload sekarang.
          <% } %>
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 12px; max-height: 500px; overflow-y: auto; padding-right: 4px;">
          <% warning.stagnanPcl.forEach(item => { %>
            <div class="warning-card stagnan">
              <div class="warning-icon"><i class="bi bi-pause-circle-fill text-orange"></i></div>
              <div class="warning-body">
                <div class="warning-name">
                  <a href="/pcl?pcl=<%= encodeURIComponent(item.pcl) %>" style="color: inherit; text-decoration: none;"><%= item.pcl %></a>
                  <% if (kippPcls.includes(item.pcl.toUpperCase())) { %>
                    <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 4px;">KIPP</span>
                  <% } %>
                </div>
                <div class="warning-meta">
                  Kec. <strong><%= item.kecamatan %></strong> · PML: <strong><%= item.pml %></strong> · Korlap: <strong><%= item.korlap %></strong>
                </div>
                <div class="warning-stats">
                  <span class="warning-stat"><%= settings.target_fasih_mode === 'fasih-sm' ? 'Target FASIH-SM' : 'Target Statis' %>: <strong><%= item.target_fasih_total %></strong></span>
                  <span class="warning-stat">Selesai saat ini: <strong class="text-orange"><%= item.selesai_sekarang %></strong></span>
                  <span class="warning-stat">Selesai 2 hari lalu: <strong><%= item.selesai_lama %></strong></span>
                  <span class="warning-stat text-orange">Δ Penambahan: <strong><%= item.delta_selesai %></strong> dokumen (stagnan)</span>
                </div>
                <div class="fasih-grid-container">
                  <div class="fasih-grid-header">
                    <span class="fasih-grid-title"><i class="bi bi-phone"></i> Status FASIH Sekarang</span>
                    <span class="badge badge-blue">Target: <%= item.target_fasih_total %></span>
                  </div>
                  <div class="fasih-grid">
                    <div class="fasih-grid-item fasih-item-draft">
                      <div class="fasih-grid-item-label">Draft</div>
                      <div class="fasih-grid-item-value"><%= item.draft_total %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-submit">
                      <div class="fasih-grid-item-label">Submit</div>
                      <div class="fasih-grid-item-value"><%= item.submitted_total %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-approve">
                      <div class="fasih-grid-item-label">Approve</div>
                      <div class="fasih-grid-item-value"><%= item.approved_total %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-reject">
                      <div class="fasih-grid-item-label">Reject</div>
                      <div class="fasih-grid-item-value"><%= item.rejected_total %></div>
                    </div>
                  </div>
                </div>
                <% const pctStagnan = item.target_fasih_total > 0 ? Math.round(100 * item.selesai_sekarang / item.target_fasih_total) : 0; %>
                <div class="progress-bar-wrap" style="height: 6px; margin-top: 10px;">
                  <div class="progress-bar orange" data-width="<%= pctStagnan %>" style="width: 0%;"></div>
                </div>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px; text-align: right;"><%= pctStagnan %>%</div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <% if (warning.stagnanPcl !== undefined && warning.stagnanPcl.length === 0) { %>
          <div class="no-data">
            <i class="bi bi-check-circle-fill text-green" style="font-size: 18px; margin-right: 6px;"></i>
            Semua PCL memiliki penambahan dokumen FASIH dalam 2 hari terakhir.
            <% if (warning.diffDays < 2) { %>
              <em style="margin-left: 4px; color: var(--text-muted);">(Data < 2 hari, deteksi stagnan belum aktif)</em>
            <% } %>
          </div>
        <% } else { %>
          <div class="no-data">
            <i class="bi bi-info-circle text-yellow" style="font-size: 18px; margin-right: 6px;"></i> Tidak cukup data historis untuk mendeteksi petugas stagnan.
          </div>
        <% } %>
      <% } %>


    <!-- PCL DENGAN PROGRES LAMBAT (< 5.0 dokumen/hari) -->
    <div class="card mt-4">
      <div class="card-header">
        <div class="card-title">
          <span class="text-yellow"><i class="bi bi-hourglass-split"></i> PCL dengan Progres Lambat (< 5.0 dokumen/hari)</span>
        </div>
        <span class="badge badge-yellow"><%= warning.slowPcl.length %> Petugas</span>
      </div>

      <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px;">Daftar PCL dengan rata-rata progres di bawah 5.0 dokumen FASIH per hari sejak awal sensus (Sensus berjalan: <strong><%= warning.diffDays %></strong> hari).</p>

      <% if (warning.slowPcl.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 12px; max-height: 500px; overflow-y: auto; padding-right: 4px;">
          <% warning.slowPcl.forEach(item => { %>
            <div class="warning-card caution">
              <div class="warning-icon"><i class="bi bi-exclamation-triangle-fill text-yellow"></i></div>
              <div class="warning-body">
                <div class="warning-name">
                  <a href="/pcl?pcl=<%= encodeURIComponent(item.pcl) %>" style="color: inherit; text-decoration: none;"><%= item.pcl %></a>
                  <% if (kippPcls.includes(item.pcl.toUpperCase())) { %>
                    <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 4px;">KIPP</span>
                  <% } %>
                </div>
                <div class="warning-meta">
                  Kec. <strong><%= item.kecamatan %></strong> · PML: <strong><%= item.pml %></strong> · Korlap: <strong><%= item.korlap %></strong>
                </div>
                <div class="warning-stats">
                  <span class="warning-stat">SLS: <strong><%= item.total_subsls %></strong> (<%= settings.target_fasih_mode === 'fasih-sm' ? 'Target FASIH-SM' : 'Target Statis' %>: <strong><%= item.target_fasih_total %></strong>)</span>
                  <span class="warning-stat">Selesai: <strong class="text-yellow"><%= item.selesai %> SLS</strong> (FASIH dikerjakan: <strong><%= item.muatan_realisasi %></strong>)</span>
                  <span class="warning-stat text-yellow">Rata-rata: <strong><%= item.rata_rata %> dokumen/hari</strong> (Progres: <%= item.pct %>%)</span>
                </div>
                    <div class="fasih-grid-container">
                      <div class="fasih-grid-header">
                        <span class="fasih-grid-title"><i class="bi bi-phone"></i> FASIH</span>
                        <span class="badge badge-blue">Target: <%= item.target_fasih_total %></span>
                      </div>
                      <div class="fasih-grid">
                        <div class="fasih-grid-item fasih-item-draft">
                          <div class="fasih-grid-item-label">Draft</div>
                          <div class="fasih-grid-item-value"><%= item.draft_total %></div>
                        </div>
                        <div class="fasih-grid-item fasih-item-submit">
                          <div class="fasih-grid-item-label">Submit</div>
                          <div class="fasih-grid-item-value"><%= item.submitted_total %></div>
                        </div>
                        <div class="fasih-grid-item fasih-item-approve">
                          <div class="fasih-grid-item-label">Approve</div>
                          <div class="fasih-grid-item-value"><%= item.approved_total %></div>
                        </div>
                        <div class="fasih-grid-item fasih-item-reject">
                          <div class="fasih-grid-item-label">Reject</div>
                          <div class="fasih-grid-item-value"><%= item.rejected_total %></div>
                        </div>
                      </div>
                    </div>
                <div class="progress-bar-wrap" style="height: 6px; margin-top: 10px;">
                  <div class="progress-bar yellow" data-width="<%= item.pct %>" style="width: 0%;"></div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="no-data">
          <i class="bi bi-check-circle-fill text-green" style="font-size: 18px; margin-right: 6px;"></i> Tidak ada PCL dengan progres lambat (semua di atas 5.0 dokumen/hari). Kerja bagus!
        </div>
      <% } %>
    </div>

    <!-- PCL DENGAN PREDIKSI CAPAIAN AKHIR BERISIKO TINGGI -->
    <div class="card mt-4">
      <div class="card-header">
        <div class="card-title">
          <span class="text-red"><i class="bi bi-graph-down"></i> PCL Berisiko Tinggi (Proyeksi < 40% per 15 Jul atau < 100% per <%= formatIndonesianDateShort(settings.speedometer_target_date || '2026-08-31') %>)</span>
        </div>
        <span class="badge badge-red"><%= (warning.lowProjectedPcl || []).length %> Petugas</span>
      </div>

      <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px;">
        Daftar PCL yang berdasarkan kecepatan kerja saat ini (runrate) diprediksi akan menyelesaikan <strong>kurang dari 40% target FASIH pada 15 Juli 2026</strong> atau <strong>kurang dari 100% target pada akhir kegiatan (<%= formatIndonesianDate(settings.speedometer_target_date || '2026-08-31') %>)</strong>.
      </p>

      <% if (warning.lowProjectedPcl && warning.lowProjectedPcl.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 12px; max-height: 500px; overflow-y: auto; padding-right: 4px;">
          <% warning.lowProjectedPcl.forEach(item => { %>
            <div class="warning-card danger">
              <div class="warning-icon"><i class="bi-exclamation-triangle-fill text-red"></i></div>
              <div class="warning-body">
                <div class="warning-name">
                  <a href="/pcl?pcl=<%= encodeURIComponent(item.pcl) %>" style="color: inherit; text-decoration: none;"><%= item.pcl %></a>
                  <% if (kippPcls.includes(item.pcl.toUpperCase())) { %>
                    <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 4px;">KIPP</span>
                  <% } %>
                </div>
                <div class="warning-meta">
                  Kec. <strong><%= item.kecamatan %></strong> · PML: <strong><%= item.pml %></strong> · Korlap: <strong><%= item.korlap %></strong>
                </div>
                <div class="warning-stats" style="flex-wrap: wrap; gap: 8px;">
                  <span class="warning-stat">Target: <strong><%= item.target_fasih_total %></strong></span>
                  <span class="warning-stat">Realisasi: <strong><%= item.selesai_sekarang %></strong></span>
                  <span class="warning-stat text-yellow">Proyeksi 15 Jul (40%): <strong class="<%= item.projected_pct_july15 < 40 ? 'text-red' : '' %>"><%= item.projected_final_july15 %> dok (<%= item.projected_pct_july15 %>%)</strong></span>
                  <span class="warning-stat text-red">Proyeksi <%= formatIndonesianDateShort(settings.speedometer_target_date || '2026-08-31') %> (100%): <strong class="<%= item.projected_pct < 100 ? 'text-red' : '' %>"><%= item.projected_final %> dok (<%= item.projected_pct %>%)</strong></span>
                </div>
                <div class="fasih-grid-container">
                  <div class="fasih-grid-header">
                    <span class="fasih-grid-title"><i class="bi bi-phone"></i> FASIH</span>
                    <span class="badge badge-blue">Target: <%= item.target_fasih_total %></span>
                  </div>
                  <div class="fasih-grid">
                    <div class="fasih-grid-item fasih-item-draft">
                      <div class="fasih-grid-item-label">Draft</div>
                      <div class="fasih-grid-item-value"><%= item.draft_total %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-submit">
                      <div class="fasih-grid-item-label">Submit</div>
                      <div class="fasih-grid-item-value"><%= item.submitted_total %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-approve">
                      <div class="fasih-grid-item-label">Approve</div>
                      <div class="fasih-grid-item-value"><%= item.approved_total %></div>
                    </div>
                    <div class="fasih-grid-item fasih-item-reject">
                      <div class="fasih-grid-item-label">Reject</div>
                      <div class="fasih-grid-item-value"><%= item.rejected_total %></div>
                    </div>
                  </div>
                </div>
                <div class="progress-bar-wrap" style="height: 6px; margin-top: 10px;">
                  <div class="progress-bar red" data-width="<%= Math.min(100, item.projected_pct) %>" style="width: 0%;"></div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="no-data">
          <i class="bi bi-check-circle-fill text-green" style="font-size: 18px; margin-right: 6px;"></i> Tidak ada PCL dengan risiko keterlambatan proyeksi. Semua berjalan dengan baik!
        </div>
      <% } %>
    </div>
  <% } %>
</div>
