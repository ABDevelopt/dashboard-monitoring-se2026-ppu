<%
  const isSakernas = typeof surveyConfig !== 'undefined' && surveyConfig.id && surveyConfig.id.startsWith('sakernas');
  const isSe2026Pml = (typeof activeSurvey !== 'undefined' ? activeSurvey === 'se2026' : (typeof surveyConfig !== 'undefined' ? surveyConfig.id === 'se2026' : true));
  const hideMuatanPml = !isSe2026Pml || (typeof settings !== 'undefined' && settings.show_progres_muatan === '0');
  const officerLabel = isSakernas ? 'PPL' : 'PCL';

  let activeTargetPct = 25;
  let targetMonthName = '30 Juni';
  const currentDate = typeof latestUpload !== 'undefined' && latestUpload ? new Date(latestUpload.tanggal) : new Date();
  if (isSe2026Pml && currentDate >= new Date('2026-07-01')) {
    activeTargetPct = 40;
    targetMonthName = '15 Juli';
  }
%>
<div class="fade-in">
  <% if (!uploadId) { %>
    <div class="card empty-state text-center">
      <div class="empty-state-icon"><i class="bi bi-bar-chart-steps"></i></div>
      <div class="empty-state-title">Belum Ada Data Terupload</div>
      <div class="empty-state-text">Silakan upload data terlebih dahulu di menu <a href="<%= navPrefix %>/admin/upload">Upload Data</a>.</div>
    </div>
  <% } else { %>
    <!-- PETUGAS NAVIGATION TABS -->
    <div class="petugas-tabs-wrapper">
      <a href="<%= navPrefix %>/pcl" class="petugas-tab-item <%= activePage === 'pcl' ? 'active' : '' %>">
        <i class="bi bi-person-gear"></i>
        <span><%= isSakernas ? 'PPL' : 'PCL' %></span>
      </a>
      <a href="<%= navPrefix %>/pml" class="petugas-tab-item <%= activePage === 'pml' ? 'active' : '' %>">
        <i class="bi bi-clipboard2-data"></i>
        <span>PML</span>
      </a>
      <% if (!isSakernas) { %>
        <% if (typeof settings === 'undefined' || settings.page_korlap !== '0') { %>
        <a href="<%= navPrefix %>/korlap" class="petugas-tab-item <%= activePage === 'korlap' ? 'active' : '' %>">
          <i class="bi bi-person-workspace"></i>
          <span>Korlap</span>
        </a>
        <% } %>
      <% } %>
      <% if (typeof settings === 'undefined' || settings.page_performa !== '0') { %>
      <a href="<%= navPrefix %>/performa" class="petugas-tab-item <%= activePage === 'performa' ? 'active' : '' %>">
        <i class="bi bi-speedometer2"></i>
        <span>Performa</span>
      </a>
      <% } %>
      <% if (typeof settings === 'undefined' || settings.page_leaderboard !== '0') { %>
      <a href="<%= navPrefix %>/leaderboard" class="petugas-tab-item <%= activePage === 'leaderboard' ? 'active' : '' %>">
        <i class="bi bi-trophy"></i>
        <span>Leaderboard</span>
      </a>
      <% } %>
    </div>

    <!-- TWO-COLUMN GRID FOR DRILLDOWN -->
    <div class="drilldown-grid <%= filterPml ? 'has-selection' : 'no-selection' %> mt-2">
      
      <!-- PML LIST TABLE -->
      <div class="card" style="margin-bottom: 0;">
        <div class="card-header flex-between" style="gap: 8px; flex-wrap: wrap;">
          <div class="card-title" style="margin-bottom: 0;"><i class="bi bi-clipboard2-data"></i> Progres Kinerja per PML (Pengawas) <span class="badge badge-blue"><%= pmlStats.length %> PML</span></div>
          <div class="card-actions flex-start" style="gap: 8px; align-items: center; flex-wrap: wrap;">
            <div class="stacked-legend-wrap d-none d-lg-flex hide-md">
              <span class="legend-item"><span class="legend-dot" style="background:#10b981;"></span>App</span>
              <span class="legend-item"><span class="legend-dot" style="background:#3b82f6;"></span>Sub</span>
              <span class="legend-item"><span class="legend-dot" style="background:#ef4444;"></span>Rej</span>
              <span class="legend-item"><span class="legend-dot" style="background:#f59e0b;"></span>Dft</span>
              <span class="legend-item"><span class="legend-dot" style="background:#64748b;"></span>Opn</span>
            </div>
            <div class="btn-group progress-mode-toggle" role="group" aria-label="Mode Tampilan Progress Bar">
              <button type="button" class="btn btn-mode-stacked active" data-mode="stacked" onclick="window.setProgressBarMode('stacked')" title="Tampilkan Stacked Bar (Open, Draft, Submit, Approved, Rejected)" aria-label="Tampilan Stacked Bar">
                <i class="bi bi-segmented-nav"></i><span class="hide-xs"> Stacked</span>
              </button>
              <button type="button" class="btn btn-mode-standard" data-mode="standard" onclick="window.setProgressBarMode('standard')" title="Tampilkan Progres Bar Tunggal Standar" aria-label="Tampilan Progres Bar Standar">
                <i class="bi bi-distribute-horizontal"></i><span class="hide-xs"> Standar</span>
              </button>
            </div>
          </div>
        </div>

        <div class="search-wrap" style="margin-bottom: 10px;">
          <input type="search" id="pmlSearch" placeholder="Cari nama PML..." aria-label="Cari nama Pengawas PML">
        </div>

        <% if (pmlStats && pmlStats.length > 0) { %>
          <div class="table-wrap" style="max-height: 600px; overflow-y: auto; overflow-x: auto;">
            <table id="pmlTable">
              <thead class="hide-sm">
                <tr>
                  <th rowspan="2" class="text-center" style="font-weight: 600; width: 40px;">No</th>
                  <th rowspan="2">Nama PML</th>
                  <th rowspan="2" class="text-right bg-purple-soft" style="min-width: 155px;">
                    <div>FASIH %</div>
                    <div class="stacked-header-legend hide-sm">
                      <span class="legend-text-app">App</span> &bull;
                      <span class="legend-text-sub">Sub</span> &bull;
                      <span class="legend-text-rej">Rej</span> &bull;
                      <span class="legend-text-draft">Dft</span> &bull;
                      <span class="legend-text-open">Opn</span>
                    </div>
                  </th>
                  <th rowspan="2" class="text-right bg-purple-soft" style="min-width: 140px;">Verifikasi %</th>
                  <% if (!hideMuatanPml) { %>
                  <th rowspan="2" class="text-right bg-cyan-soft muatan-col" style="min-width: 140px;">Muatan %</th>
                  <% } %>
                  <% if (!isSakernas) { %>
                  <th rowspan="2" class="hide-md">Korlap</th>
                  <% } %>
                  <th rowspan="2" class="text-right">Jumlah <%= officerLabel %></th>
                  <!-- <th colspan="2" class="text-center" style="border-bottom: 1px solid var(--border);">SubSLS</th> -->
                  <th colspan="6" class="text-center bg-purple-soft" style="border-bottom: 1px solid var(--border);">Assignment FASIH</th>
                  <% if (!hideMuatanPml) { %>
                  <th colspan="2" class="text-center bg-cyan-soft muatan-col" style="border-bottom: 1px solid var(--border);">Progres Muatan</th>
                  <% } %>
                </tr>
                <tr>
                  <th class="text-right bg-gray-soft status-open-text">Open</th>
                  <th class="text-right bg-yellow-soft">Draft</th>
                  <th class="text-right bg-blue-soft">Submitted</th>
                  <th class="text-right bg-red-soft">Rejected</th>
                  <th class="text-right bg-green-soft">Approved</th>
                  <th class="text-right bg-purple-soft"><%= settings.target_fasih_mode === 'fasih-sm' ? 'Tgt FASIH-SM' : 'Tgt Statis' %></th>
                  <% if (!hideMuatanPml) { %>
                  <th class="text-right bg-cyan-soft hide-sm muatan-col">Realisasi</th>
                  <th class="text-right bg-cyan-soft hide-sm muatan-col">Target</th>
                  <% } %>
                </tr>
              </thead>
              <thead class="show-sm-table-header">
                <tr>
                  <th class="text-center" style="width: 40px;">No</th>
                  <th>Nama PML</th>
                  <!-- <th class="text-right">Selesai</th> -->
                  <th class="text-right bg-purple-soft" data-column-idx="2">FASIH %</th>
                  <th class="text-right bg-purple-soft" data-column-idx="3">Verif %</th>
                  <% if (!hideMuatanPml) { %>
                  <th class="text-right bg-cyan-soft muatan-col" data-column-idx="4">Muatan %</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% pmlStats.forEach((p, index) => { %>
                  <% 
                    let fasihPct = p.fasih_pct_str;
                    let muatanPct = p.muatan_pct_str;
                    const fReal = (p.submitted_total || 0) + (p.approved_total || 0) + (p.rejected_total || 0);
                    const fTgt = p.target_fasih_total || 0;
                    const pmlApp = p.approved_total || 0;
                    const pmlSub = p.submitted_total || 0;
                    const pmlRej = p.rejected_total || 0;
                    const pmlDft = p.draft_total || 0;
                    const pmlOpn = p.open_total !== undefined ? p.open_total : Math.max(0, fTgt - (pmlDft + fReal));
                  %>
                  <tr class="<%= filterPml === p.pml ? 'active' : '' %>" style="<%= filterPml === p.pml ? 'background: var(--bg-card-hover); font-weight: 500;' : '' %>">
                    <td class="text-center" style="font-weight: 600; background: var(--bg-subtle);"><%= index + 1 %></td>
                    <td class="td-primary">
                      <a href="<%= navPrefix %>/pml?pml=<%= encodeURIComponent(p.pml) %>" style="color: inherit; text-decoration: none; display: inline-block;">
                        <i class="bi bi-clipboard2-data"></i> <%= p.pml %>
                      </a>
                      <% if (kippPmls.includes(p.pml.toUpperCase())) { %>
                        <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 4px;">KIPP</span>
                      <% } %>
                    </td>
                    <td class="bg-purple-soft"
                        data-sort="<%= parseFloat(fasihPct) || 0 %>"
                        data-sort-pct="<%= parseFloat(fasihPct) || 0 %>"
                        data-sort-app="<%= pmlApp %>"
                        data-sort-sub="<%= pmlSub %>"
                        data-sort-rej="<%= pmlRej %>"
                        data-sort-draft="<%= pmlDft %>"
                        data-sort-open="<%= pmlOpn %>"
                        style="min-width: 160px; padding: 6px 10px; vertical-align: middle;">
                      <%
                        const fW = Math.min(parseFloat(fasihPct), 100);
                        const fColor = fW >= 100 ? 'var(--accent-green)' : (fW < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');

                        const pmlActiveTotal = pmlApp + pmlSub + pmlRej + pmlDft + pmlOpn;
                        const pmlBase = Math.max(fTgt, pmlActiveTotal, 1);

                        const wApp = Math.max(0, (pmlApp / pmlBase * 100));
                        const wSub = Math.max(0, (pmlSub / pmlBase * 100));
                        const wRej = Math.max(0, (pmlRej / pmlBase * 100));
                        const wDft = Math.max(0, (pmlDft / pmlBase * 100));
                        const wOpn = Math.max(0, (pmlOpn / pmlBase * 100));
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px; display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-weight:700; color:<%= fColor %>"><%= fasihPct %>%<% if (fTgt > 0 && fReal > fTgt) { %> <span class="badge badge-green badge-xs">&gt;100%</span><% } %></span>
                        <span><%= fReal.toLocaleString('id-ID') %> / <%= fTgt.toLocaleString('id-ID') %></span>
                      </div>
                      
                      <!-- Stacked Bar (Default) -->
                      <div class="progress-track-stacked"
                           data-name="<%= p.pml %>"
                           data-target="<%= fTgt %>"
                           data-app="<%= pmlApp %>"
                           data-sub="<%= pmlSub %>"
                           data-rej="<%= pmlRej %>"
                           data-draft="<%= pmlDft %>"
                           data-open="<%= pmlOpn %>"
                           tabindex="0"
                           role="progressbar"
                           aria-label="Progres FASIH <%= p.pml %>">
                        <% if (wApp > 0) { %><div class="stacked-segment seg-approved" style="width: <%= wApp %>%;"></div><% } %>
                        <% if (wSub > 0) { %><div class="stacked-segment seg-submitted" style="width: <%= wSub %>%;"></div><% } %>
                        <% if (wRej > 0) { %><div class="stacked-segment seg-rejected" style="width: <%= wRej %>%;"></div><% } %>
                        <% if (wDft > 0) { %><div class="stacked-segment seg-draft" style="width: <%= wDft %>%;"></div><% } %>
                        <% if (wOpn > 0) { %><div class="stacked-segment seg-open" style="width: <%= wOpn %>%;"></div><% } %>
                      </div>

                      <!-- Standard Single Bar (When Toggled) -->
                      <div class="progress-track-standard">
                        <div class="progress-track-sm">
                          <div class="progress-bar <%= fW >= 100 ? 'green' : (fW < 40 ? 'red' : 'purple') %>" data-width="<%= fW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                        </div>
                      </div>
                    </td>
                    <td class="bg-purple-soft" data-sort="<%= parseFloat(p.fasih_verified_pct_str) %>" style="min-width: 160px; padding: 6px 10px; vertical-align: middle;">
                      <%
                        const fVerifReal = (p.approved_total || 0) + (p.rejected_total || 0);
                        const fVerifTgt = p.target_fasih_total || 0;
                        const fVerifW = Math.min(parseFloat(p.fasih_verified_pct_str), 100);
                        const fVerifColor = fVerifW >= 100 ? 'var(--accent-green)' : (fVerifW < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= fVerifColor %>"><%= p.fasih_verified_pct_str %>%</span>
                        <span><%= fVerifReal.toLocaleString('id-ID') %> / <%= fVerifTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= fVerifW >= 100 ? 'green' : (fVerifW < 40 ? 'red' : 'purple') %>" data-width="<%= fVerifW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <% if (!hideMuatanPml) { %>
                    <td class="bg-cyan-soft muatan-col" data-sort="<%= parseFloat(muatanPct) %>" style="min-width: 160px; padding: 6px 10px;">
                      <%
                        const muatanReal = p.muatan_selesai !== undefined ? p.muatan_selesai : (p.usaha_total + p.keluarga_total);
                        const muatanTgt  = p.total_muatan || 0;
                        const muatanW    = Math.min(parseFloat(muatanPct), 100);
                        const muatanColor = muatanW >= 100 ? 'var(--accent-green)' : (muatanW < 40 ? 'var(--accent-red)' : 'var(--accent-cyan)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= muatanColor %>"><%= muatanPct %>%</span>
                        <span><%= muatanReal.toLocaleString('id-ID') %> / <%= muatanTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= muatanW >= 100 ? 'green' : (muatanW < 40 ? 'red' : 'blue') %>" data-width="<%= muatanW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <% } %>
                    <% if (!isSakernas) { %>
                    <td class="hide-md"><%= p.korlap %></td>
                    <% } %>
                    <td class="text-right hide-sm" data-sort="<%= p.jumlah_pcl %>"><%= p.jumlah_pcl %> <%= officerLabel %></td>
                    <!-- <td class="text-right hide-sm" data-sort="<%= p.total_subsls %>"><%= p.total_subsls %></td> -->
                    <!-- <td class="text-right fw-bold" data-sort="<%= p.selesai %>" style="<%= p.selesai === 0 ? 'color: var(--accent-red)' : '' %>"><%= p.selesai %></td> -->
                    <% 
                      const pDone = (p.submitted_total || 0) + (p.approved_total || 0) + (p.rejected_total || 0);
                      const pOpen = p.open_total !== undefined ? p.open_total : Math.max(0, (p.target_fasih_total || 0) - ((p.draft_total || 0) + pDone));
                    %>
                    <td class="text-right bg-gray-soft hide-sm status-open-text" data-sort="<%= pOpen %>"><%= pOpen.toLocaleString('id-ID') %></td>
                    <td class="text-right bg-yellow-soft hide-sm status-draft-text" data-sort="<%= p.draft_total %>"><%= (p.draft_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-blue-soft hide-sm status-submit-text" data-sort="<%= p.submitted_total %>"><%= (p.submitted_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-red-soft hide-sm status-reject-text" data-sort="<%= p.rejected_total %>" style="font-weight: 600;"><%= (p.rejected_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm status-approve-text" data-sort="<%= p.approved_total %>" style="font-weight: 600;"><%= (p.approved_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-purple-soft hide-sm" data-sort="<%= p.target_fasih_total %>"><%= (p.target_fasih_total || 0).toLocaleString('id-ID') %></td>
                    <% if (!hideMuatanPml) { %>
                    <td class="text-right fw-bold bg-cyan-soft hide-sm muatan-col" data-sort="<%= p.muatan_selesai !== undefined ? p.muatan_selesai : (p.usaha_total + p.keluarga_total) %>"><%= (p.muatan_selesai !== undefined ? p.muatan_selesai : (p.usaha_total + p.keluarga_total)).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-cyan-soft hide-sm muatan-col" data-sort="<%= p.total_muatan %>"><%= p.total_muatan.toLocaleString('id-ID') %></td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="no-data">Tidak ada PML yang cocok.</div>
        <% } %>
      </div>

      <!-- PML'S PCL TEAM DETAILS -->
      <div id="pmlDetailContainer">
        <%- include('partials/pml_detail') %>
      </div>

    </div>

  <% } %>
</div>

<script>
  window.togglePmlChart = function() {
    const body = document.getElementById('pmlChartBody');
    const chevron = document.getElementById('pmlChartChevron');
    if (!body) return;
    const isHidden = body.style.display === 'none' || !body.style.display;
    if (isHidden) {
      body.style.display = 'block';
      if (chevron) chevron.style.transform = 'rotate(180deg)';
      if (typeof window.initPmlHistoryChart === 'function') {
        window.initPmlHistoryChart();
      }
    } else {
      body.style.display = 'none';
      if (chevron) chevron.style.transform = 'rotate(0deg)';
    }
  };

  window.initPmlHistoryChart = function() {
    requestAnimationFrame(() => {
      const dataEl = document.getElementById('pmlHistoryData');
      if (!dataEl) return;
      try {
        const data = JSON.parse(dataEl.textContent);
        if (!data || !data.length) return;

        // Retry if Chart.js / createPclHistoryChart not ready yet
        if (typeof Chart === 'undefined' || typeof createPclHistoryChart !== 'function') {
          setTimeout(window.initPmlHistoryChart, 150);
          return;
        }

        const existingChart = Chart.getChart('pmlHistoryChartCanvas');
        if (existingChart) existingChart.destroy();

        createPclHistoryChart('pmlHistoryChartCanvas', data);
      } catch (e) {
        console.error('Failed to init PML history chart:', e);
      }
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    makeTableSortable('pmlTable');
    makeTableSearchable('pmlSearch', 'pmlTable');
    
    // Initial searchable bind
    <% if (filterPml) { %>
      makeListSearchable('detailPclSearch', 'detailPclList', '.detail-item');
    <% } %>

    // AJAX Drilldown logic for PML
    const detailContainer = document.getElementById('pmlDetailContainer');
    const table = document.getElementById('pmlTable');

    function renderPmlDetail(html, url) {
      if (!html.includes('<!DOCTYPE') && !html.includes('<html')) {
        detailContainer.innerHTML = html;
      } else {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newDetail = doc.getElementById('pmlDetailContainer');
        if (newDetail) detailContainer.innerHTML = newDetail.innerHTML;
      }
      detailContainer.style.opacity = '1';
      detailContainer.classList.remove('smooth-detail-animate');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          detailContainer.classList.add('smooth-detail-animate');
        });
      });

      // Toggle grid selection classes
      const grid = document.querySelector('.drilldown-grid');
      if (grid) {
        const hasSel = url.includes('pml=');
        if (hasSel) {
          grid.classList.remove('no-selection');
          grid.classList.add('has-selection');
        } else {
          grid.classList.remove('has-selection');
          grid.classList.add('no-selection');
        }
      }

      // Update URL path without refresh
      window.history.pushState(null, '', url);

      // Re-bind list search utility
      makeListSearchable('detailPclSearch', 'detailPclList', '.detail-item');

      // Re-bind close handler
      bindCloseDetail();
      if (window.initProgressBars) window.initProgressBars(detailContainer);
      initPmlHistoryChart();
    }

    if (table && detailContainer) {
      // Intercept row clicks
      table.querySelector('tbody').addEventListener('click', (e) => {
        const link = e.target.closest('td.td-primary a') || e.target.closest('td.td-primary')?.querySelector('a');
        if (!link) return;

        e.preventDefault();
        const url = link.getAttribute('href');
        const row = link.closest('tr');

        // Update active row visual indicator
        const activeRow = table.querySelector('tbody tr.active');
        if (activeRow) {
          activeRow.classList.remove('active');
          activeRow.style.background = '';
          activeRow.style.fontWeight = '';
        }
        row.classList.add('active');
        row.style.background = 'var(--bg-card-hover)';
        row.style.fontWeight = '500';

        if (window.pmlDetailCache && window.pmlDetailCache[url]) {
          renderPmlDetail(window.pmlDetailCache[url], url);
          return;
        }

        // Opacity transition
        detailContainer.style.opacity = '0.5';

        fetch(url, { headers: { 'X-Partial-Drilldown': '1' } })
          .then(res => res.text())
          .then(html => {
            if (!window.pmlDetailCache) window.pmlDetailCache = {};
            window.pmlDetailCache[url] = html;
            renderPmlDetail(html, url);
          })
          .catch(err => {
            console.error(err);
            detailContainer.style.opacity = '1';
          });
      });
    }

    // AJAX Tutup Detail handler
    function bindCloseDetail() {
      const closeBtn = detailContainer.querySelector('.btn-close-detail') || detailContainer.querySelector('a[href*="/pml"]');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const url = closeBtn.getAttribute('href') || '/pml';

          // Reset active rows
          if (table) {
            const activeRow = table.querySelector('tbody tr.active');
            if (activeRow) {
              activeRow.classList.remove('active');
              activeRow.style.background = '';
              activeRow.style.fontWeight = '';
            }
          }

          if (window.pmlDetailCache && window.pmlDetailCache[url]) {
            renderPmlDetail(window.pmlDetailCache[url], url);
            return;
          }

          detailContainer.style.opacity = '0.5';
          fetch(url, { headers: { 'X-Partial-Drilldown': '1' } })
            .then(res => res.text())
            .then(html => {
              if (!window.pmlDetailCache) window.pmlDetailCache = {};
              window.pmlDetailCache[url] = html;
              renderPmlDetail(html, url);
            })
            .catch(err => {
              console.error(err);
              detailContainer.style.opacity = '1';
            });
        });
      }
    }

    bindCloseDetail();
    initPmlHistoryChart();
  });
</script>
