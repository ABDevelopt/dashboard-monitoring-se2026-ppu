<%
  let activeTargetPct = 25;
  let targetMonthName = '30 Juni';
  const currentDate = typeof latestUpload !== 'undefined' && latestUpload ? new Date(latestUpload.tanggal) : new Date();
  if (currentDate >= new Date('2026-07-01')) {
    activeTargetPct = 40;
    targetMonthName = '15 Juli';
  }
%>
<div class="fade-in">
  <% if (!uploadId) { %>
    <div class="card empty-state text-center">
      <div class="empty-state-icon"><i class="bi bi-bar-chart-steps"></i></div>
      <div class="empty-state-title">Belum Ada Data Terupload</div>
      <div class="empty-state-text">Silakan upload data terlebih dahulu di menu <a href="/admin/upload">Upload Data</a>.</div>
    </div>
  <% } else { %>

    <!-- TWO-COLUMN GRID FOR DRILLDOWN -->
    <div class="drilldown-grid <%= filterPml ? 'has-selection' : 'no-selection' %> mt-4">
      
      <!-- PML LIST TABLE -->
      <div class="card" style="margin-bottom: 0;">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <div class="card-title" style="margin-bottom: 0;"><i class="bi bi-clipboard2-data"></i> Progres Kinerja per PML (Pengawas)</div>
            <span class="badge badge-blue"><%= pmlStats.length %> PML</span>
          </div>
          <a href="/pml/laporan" class="btn btn-primary btn-xs" style="text-decoration: none;"><i class="bi bi-file-earmark-pdf"></i> Pembuat Laporan (PDF/Excel)</a>
        </div>

        <div class="search-wrap mb-4">
          <input type="search" id="pmlSearch" placeholder="Cari nama PML..." aria-label="Cari nama Pengawas PML" style="width: 100%; max-width: 280px;">
        </div>

        <% if (pmlStats && pmlStats.length > 0) { %>
          <div class="table-wrap" style="max-height: 600px; overflow-y: auto; overflow-x: auto;">
            <table id="pmlTable">
              <thead class="hide-sm">
                <tr>
                  <th rowspan="2" class="text-center" style="font-weight: 600; width: 40px;">No</th>
                  <th rowspan="2">Nama PML</th>
                  <th rowspan="2" class="text-right bg-purple-soft" style="min-width: 140px;">FASIH %</th>
                  <th rowspan="2" class="text-right bg-purple-soft" style="min-width: 140px;">Verifikasi %</th>
                  <th rowspan="2" class="text-right bg-cyan-soft muatan-col" style="min-width: 140px;">Muatan %</th>
                  <th rowspan="2" class="hide-md">Korlap</th>
                  <th rowspan="2" class="text-right">Jumlah PCL</th>
                  <!-- <th colspan="2" class="text-center" style="border-bottom: 1px solid var(--border);">SubSLS</th> -->
                  <th colspan="5" class="text-center bg-purple-soft" style="border-bottom: 1px solid var(--border);">Assignment FASIH</th>
                  <th colspan="2" class="text-center bg-cyan-soft muatan-col" style="border-bottom: 1px solid var(--border);">Progres Muatan</th>
                </tr>
                <tr>
                  <th class="text-right bg-yellow-soft">Draft</th>
                  <th class="text-right bg-blue-soft">Submitted</th>
                  <th class="text-right bg-red-soft">Rejected</th>
                  <th class="text-right bg-green-soft">Approved</th>
                  <th class="text-right bg-purple-soft"><%= settings.target_fasih_mode === 'fasih-sm' ? 'Tgt FASIH-SM' : 'Tgt Statis' %></th>
                   <th class="text-right bg-cyan-soft hide-sm muatan-col">Realisasi</th>
                  <th class="text-right bg-cyan-soft hide-sm muatan-col">Target</th>
                </tr>
              </thead>
              <thead class="show-sm-table-header">
                <tr>
                  <th class="text-center" style="width: 40px;">No</th>
                  <th>Nama PML</th>
                  <!-- <th class="text-right">Selesai</th> -->
                  <th class="text-right bg-purple-soft" data-column-idx="2">FASIH %</th>
                  <th class="text-right bg-purple-soft" data-column-idx="3">Verif %</th>
                  <th class="text-right bg-cyan-soft muatan-col" data-column-idx="4">Muatan %</th>
                </tr>
              </thead>
              <tbody>
                <% pmlStats.forEach((p, index) => { %>
                  <% let fasihPct = p.fasih_pct_str; %>
                  <% let muatanPct = p.muatan_pct_str; %>
                  <tr class="<%= filterPml === p.pml ? 'active' : '' %>" style="<%= filterPml === p.pml ? 'background: var(--bg-card-hover); font-weight: 500;' : '' %>">
                    <td class="text-center" style="font-weight: 600; background: var(--bg-subtle);"><%= index + 1 %></td>
                    <td class="td-primary">
                      <a href="/pml?pml=<%= encodeURIComponent(p.pml) %>" style="color: inherit; text-decoration: none; display: inline-block;">
                        <i class="bi bi-clipboard2-data"></i> <%= p.pml %>
                      </a>
                      <% if (kippPmls.includes(p.pml.toUpperCase())) { %>
                        <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 4px;">KIPP</span>
                      <% } %>
                    </td>
                    <td class="bg-purple-soft" data-sort="<%= parseFloat(fasihPct) %>" style="min-width: 160px; padding: 6px 10px; vertical-align: middle;">
                      <%
                        const fReal = (p.submitted_total || 0) + (p.approved_total || 0) + (p.rejected_total || 0);
                        const fTgt = p.target_fasih_total || 0;
                        const fW = Math.min(parseFloat(fasihPct), 100);
                        const fColor = fW >= 100 ? 'var(--accent-green)' : (fW < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= fColor %>"><%= fasihPct %>%</span>
                        <span><%= fReal.toLocaleString('id-ID') %> / <%= fTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= fW >= 100 ? 'green' : (fW < 40 ? 'red' : 'purple') %>" data-width="<%= fW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <td class="bg-purple-soft" data-sort="<%= parseFloat(p.fasih_verified_pct_str) %>" style="min-width: 160px; padding: 6px 10px; vertical-align: middle;">
                      <%
                        const fVerifReal = (p.approved_total || 0) + (p.rejected_total || 0);
                        const fVerifTgt = p.target_fasih_total || 0;
                        const fVerifW = Math.min(parseFloat(p.fasih_verified_pct_str), 100);
                        const fVerifColor = fVerifW >= 100 ? 'var(--accent-green)' : (fVerifW < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= fVerifColor %>"><%= p.fasih_verified_pct_str %>%</span>
                        <span><%= fVerifReal.toLocaleString('id-ID') %> / <%= fVerifTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= fVerifW >= 100 ? 'green' : (fVerifW < 40 ? 'red' : 'purple') %>" data-width="<%= fVerifW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <td class="bg-cyan-soft muatan-col" data-sort="<%= parseFloat(muatanPct) %>" style="min-width: 160px; padding: 6px 10px;">
                      <%
                        const muatanReal = p.muatan_selesai !== undefined ? p.muatan_selesai : (p.usaha_total + p.keluarga_total);
                        const muatanTgt  = p.total_muatan || 0;
                        const muatanW    = Math.min(parseFloat(muatanPct), 100);
                        const muatanColor = muatanW >= 100 ? 'var(--accent-green)' : (muatanW < 40 ? 'var(--accent-red)' : 'var(--accent-cyan)');
                      %>
                      <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                        <span style="font-weight:700; color:<%= muatanColor %>"><%= muatanPct %>%</span>
                        <span><%= muatanReal.toLocaleString('id-ID') %> / <%= muatanTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div class="progress-track-sm">
                        <div class="progress-bar <%= muatanW >= 100 ? 'green' : (muatanW < 40 ? 'red' : 'blue') %>" data-width="<%= muatanW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <td class="hide-md"><%= p.korlap %></td>
                    <td class="text-right hide-sm" data-sort="<%= p.jumlah_pcl %>"><%= p.jumlah_pcl %> PCL</td>
                    <!-- <td class="text-right hide-sm" data-sort="<%= p.total_subsls %>"><%= p.total_subsls %></td> -->
                    <!-- <td class="text-right fw-bold" data-sort="<%= p.selesai %>" style="<%= p.selesai === 0 ? 'color: var(--accent-red)' : '' %>"><%= p.selesai %></td> -->
                    <td class="text-right bg-yellow-soft hide-sm status-draft-text" data-sort="<%= p.draft_total %>"><%= (p.draft_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-blue-soft hide-sm status-submit-text" data-sort="<%= p.submitted_total %>"><%= (p.submitted_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-red-soft hide-sm status-reject-text" data-sort="<%= p.rejected_total %>" style="font-weight: 600;"><%= (p.rejected_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft hide-sm status-approve-text" data-sort="<%= p.approved_total %>" style="font-weight: 600;"><%= (p.approved_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-purple-soft hide-sm" data-sort="<%= p.target_fasih_total %>"><%= (p.target_fasih_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right fw-bold bg-cyan-soft hide-sm muatan-col" data-sort="<%= p.muatan_selesai !== undefined ? p.muatan_selesai : (p.usaha_total + p.keluarga_total) %>"><%= (p.muatan_selesai !== undefined ? p.muatan_selesai : (p.usaha_total + p.keluarga_total)).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-cyan-soft hide-sm muatan-col" data-sort="<%= p.total_muatan %>"><%= p.total_muatan.toLocaleString('id-ID') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="no-data">Tidak ada PML yang cocok.</div>
        <% } %>
      </div>

      <!-- PML'S PCL TEAM DETAILS -->
      <div id="pmlDetailContainer">
        <% if (filterPml) { %>
          <div class="card" id="pmlDetailCard" style="margin-bottom: 0; position: sticky; top: 80px;">
            <div class="card-header" style="display: flex; align-items: center; justify-content: space-between;">
              <div class="card-title" style="margin-bottom: 0;"><i class="bi bi-people"></i> Anggota Tim PCL: <mark class="highlight-name"><%= filterPml %></mark></div>
              <div style="display: flex; gap: 6px; align-items: center; margin-left: auto;">
                <button onclick="window.shareElementAsImage('pmlDetailCard', event)" class="btn btn-secondary btn-xs" title="Bagikan gambar detail card"><i class="bi bi-share"></i><span class="btn-text-desktop"> Bagikan</span></button>
                <button onclick="window.copyElementAsImage('pmlDetailCard', event)" class="btn btn-secondary btn-xs" title="Salin gambar detail card ke clipboard"><i class="bi bi-copy"></i><span class="btn-text-desktop"> Salin</span></button>
                <a href="/pml" class="btn btn-secondary btn-xs" title="Tutup detail card"><i class="bi bi-x-lg"></i><span class="btn-text-desktop"> Tutup</span></a>
              </div>
            </div>

            <% if (detailPcl && detailPcl.length > 0) { %>
              <div class="mb-4">
                <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 8px;">
                  Korlap Atasan: <strong><%= detailPcl[0].korlap %></strong>
                </div>
                <% 
                  let totalBeban = selectedPmlStats ? selectedPmlStats.total_muatan : 0;
                  let totalUsaha = selectedPmlStats ? (selectedPmlStats.muatan_selesai !== undefined ? selectedPmlStats.muatan_selesai : (selectedPmlStats.usaha_total + selectedPmlStats.keluarga_total)) : 0;
                  let totalPct = selectedPmlStats ? selectedPmlStats.muatan_pct_str : '0.00';

                  let totalFasihTgt = selectedPmlStats ? selectedPmlStats.target_fasih_total : 0;
                  let totalFasihDone = selectedPmlStats ? ((selectedPmlStats.submitted_total || 0) + (selectedPmlStats.approved_total || 0) + (selectedPmlStats.rejected_total || 0)) : 0;
                  let totalFasihPct = selectedPmlStats ? selectedPmlStats.fasih_pct_str : '0.00';

                  let totalFasihVerifDone = selectedPmlStats ? ((selectedPmlStats.approved_total || 0) + (selectedPmlStats.rejected_total || 0)) : 0;
                  let totalFasihVerifPct = selectedPmlStats ? selectedPmlStats.fasih_verified_pct_str : '0.00';
                %>
                <!-- Progress FASIH -->
                <div style="margin-bottom: 16px;">
                  <div class="bar-label">
                    <span><i class="bi bi-phone"></i> Progres FASIH Tim (Submit + Approve + Reject)</span>
                    <span class="fw-bold"><%= totalFasihDone.toLocaleString('id-ID') %> / <%= totalFasihTgt.toLocaleString('id-ID') %> (<%= totalFasihPct %>%)</span>
                  </div>
                  <div class="progress-bar-wrap" style="height: 6px;">
                    <div class="progress-bar <%= parseFloat(totalFasihPct) >= 100 ? 'green' : (parseFloat(totalFasihPct) < 40 ? 'red' : 'purple') %>" data-width="<%= totalFasihPct %>" style="width: 0%;"></div>
                  </div>
                </div>

                <!-- Progress Verifikasi PML -->
                <div style="margin-bottom: 16px;">
                  <div class="bar-label">
                    <span><i class="bi bi-shield-check"></i> Progres Verifikasi PML (Approve + Reject)</span>
                    <span class="fw-bold"><%= totalFasihVerifDone.toLocaleString('id-ID') %> / <%= totalFasihTgt.toLocaleString('id-ID') %> (<%= totalFasihVerifPct %>%)</span>
                  </div>
                  <div class="progress-bar-wrap" style="height: 6px;">
                    <div class="progress-bar <%= parseFloat(totalFasihVerifPct) >= 100 ? 'green' : (parseFloat(totalFasihVerifPct) < 40 ? 'red' : 'purple') %>" data-width="<%= totalFasihVerifPct %>" style="width: 0%;"></div>
                  </div>
                </div>

                <!-- Progress Muatan -->
                <div style="margin-bottom: 12px;" class="muatan-col">
                  <div class="bar-label">
                    <span><i class="bi bi-briefcase"></i> Progres Muatan Tim</span>
                    <span class="fw-bold"><%= totalUsaha.toLocaleString('id-ID') %> / <%= totalBeban.toLocaleString('id-ID') %> (<%= totalPct %>%)</span>
                  </div>
                  <div class="progress-bar-target-wrap" style="position: relative; height: 6px; margin-top: 16px; margin-bottom: 8px;">
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                      <div class="progress-bar <%= parseFloat(totalPct) >= 100 ? 'green' : (parseFloat(totalPct) < 40 ? 'red' : 'blue') %>" data-width="<%= totalPct %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                    </div>
                    
                    <!-- Marker 25% (30 Juni) -->
                    <div style="position: absolute; left: 25%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 25 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                      <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">30 Jun: 25%</span>
                    </div>

                    <!-- Marker 40% (15 Juli) -->
                    <div style="position: absolute; left: 40%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 40 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                      <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">15 Jul: 40%</span>
                    </div>
                  </div>
                </div>

                <!-- Daily Progress Chart (PML Team Trend) -->
                <div style="margin-top: 18px; margin-bottom: 18px; border-top: 1px solid var(--border); padding-top: 14px; margin-left: -20px; margin-right: -20px;">
                  <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 8px; padding-left: 20px; padding-right: 20px;">
                    <i class="bi bi-graph-up"></i> Tren Progres Harian Tim PML (FASIH)
                  </div>
                  <div style="height: 180px; position: relative; width: 100%; padding-left: 10px; padding-right: 10px;">
                    <canvas id="pmlHistoryChartCanvas"></canvas>
                  </div>
                </div>

                <!-- JSON data script tag -->
                <script id="pmlHistoryData" type="application/json">
                  <%- JSON.stringify(pmlHistory) %>
                </script>
              </div>

              <div class="search-wrap mb-4" style="max-width: 100%; margin-bottom: 12px;">
                <input type="search" id="detailPclSearch" placeholder="Cari nama PCL dalam tim..." aria-label="Cari nama Pencacah PCL dalam tim">
              </div>

              <div id="detailPclList" style="max-height: 420px; overflow-y: auto; padding-right: 4px;">
                <% detailPcl.forEach(item => { %>
                  <div class="detail-item" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 5px 8px; margin-bottom: 4px; font-size: 11px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                      <div style="font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 75%;">
                        <a href="/pcl?pcl=<%= encodeURIComponent(item.pcl) %>" style="color: var(--accent-cyan); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                          <i class="bi bi-person"></i> <%= item.pcl %>
                        </a>
                        <% if (kippPcls.includes(item.pcl.toUpperCase())) { %>
                          <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 2px;">KIPP</span>
                        <% } %>
                      </div>
                    </div>
                    
                    <!-- FASIH Progress Bar -->
                    <% const pctVal = parseFloat(item.pct) || 0; %>
                    <div style="display: flex; justify-content: space-between; font-size: 9px; color: var(--text-muted); margin-top: 6px;">
                      <span style="font-weight: 600;"><i class="bi bi-phone"></i> FASIH: <span style="color: var(--accent-purple);"><%= pctVal.toFixed(2) %>%</span></span>
                      <span><%= ((item.submitted_total || 0) + (item.approved_total || 0) + (item.rejected_total || 0)).toLocaleString('id-ID') %> / <%= item.target_fasih_total.toLocaleString('id-ID') %></span>
                    </div>
                    <div class="progress-bar-target-wrap" style="position: relative; height: 5px; margin-top: 2px; margin-bottom: 6px;">
                      <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                        <div class="progress-bar <%= pctVal >= 100 ? 'green' : (pctVal < 40 ? 'red' : 'blue') %>" data-width="<%= pctVal %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                      </div>
                      <div style="position: absolute; left: <%= activeTargetPct %>%; top: -2px; height: 9px; border-left: 1.5px dashed var(--accent-cyan); z-index: 2; opacity: 0.8; pointer-events: none;" title="Target: <%= activeTargetPct %>%"></div>
                    </div>

                    <!-- Muatan Progress Bar -->
                    <% const muatanPctVal = parseFloat(item.muatan_pct) || 0; %>
                    <div style="display: flex; justify-content: space-between; font-size: 9px; color: var(--text-muted); margin-top: 4px;" class="muatan-col">
                      <span style="font-weight: 600;"><i class="bi bi-briefcase"></i> Muatan: <span style="color: var(--accent-cyan);"><%= item.muatan_pct_str %>%</span></span>
                      <span><%= (item.muatan_selesai !== undefined ? item.muatan_selesai : (item.usaha_total + item.keluarga_total)).toLocaleString('id-ID') %> / <%= item.total_muatan.toLocaleString('id-ID') %></span>
                    </div>
                    <div class="progress-bar-target-wrap muatan-col" style="position: relative; height: 5px; margin-top: 2px; margin-bottom: 6px;">
                      <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                        <div class="progress-bar <%= muatanPctVal >= 100 ? 'green' : (muatanPctVal < 40 ? 'red' : 'cyan') %>" data-width="<%= muatanPctVal %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                      </div>
                      <div style="position: absolute; left: <%= activeTargetPct %>%; top: -2px; height: 9px; border-left: 1.5px dashed var(--accent-cyan); z-index: 2; opacity: 0.8; pointer-events: none;" title="Target: <%= activeTargetPct %>%"></div>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: var(--text-muted); flex-wrap: wrap; gap: 4px; margin-top: 8px;">
                      <div>Kec. <%= item.kecamatan %></div>
                      <div style="font-size: 9px; color: var(--text-muted);">
                        (D<%= item.draft_total %> S<%= item.submitted_total %> A<%= item.approved_total %> R<%= item.rejected_total %>)
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="no-data">Tidak ada detail PCL.</div>
            <% } %>
          </div>
        <% } else { %>
          <div class="card empty-state text-center" style="height: 100%; min-height: 300px; display: flex; flex-direction: column; justify-content: center; border-style: dashed;">
            <div class="empty-state-icon"><i class="bi bi-arrow-left-circle"></i></div>
            <div class="empty-state-title">Pilih PML</div>
            <div class="empty-state-text">Klik nama PML di tabel sebelah kiri untuk melihat rincian PCL yang diawasi beserta progres kinerja per PCL.</div>
          </div>
        <% } %>
      </div>

    </div>

  <% } %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    makeTableSortable('pmlTable');
    makeTableSearchable('pmlSearch', 'pmlTable');
    
    // Initial searchable bind
    <% if (filterPml) { %>
      makeListSearchable('detailPclSearch', 'detailPclList', '.detail-item');
    <% } %>

    function initPmlHistoryChart() {
      const dataEl = document.getElementById('pmlHistoryData');
      if (!dataEl) return;
      try {
        const data = JSON.parse(dataEl.textContent);
        if (data && data.length) {
          if (typeof Chart !== 'undefined') {
            const existingChart = Chart.getChart("pmlHistoryChartCanvas");
            if (existingChart) {
              existingChart.destroy();
            }
          }
          if (typeof createPclHistoryChart === 'function') {
            createPclHistoryChart('pmlHistoryChartCanvas', data);
          }
        }
      } catch (e) {
        console.error('Failed to init PML history chart:', e);
      }
    }

    // AJAX Drilldown logic for PML
    const detailContainer = document.getElementById('pmlDetailContainer');
    const table = document.getElementById('pmlTable');

    if (table && detailContainer) {
      // Intercept row clicks
      table.querySelector('tbody').addEventListener('click', (e) => {
        const link = e.target.closest('td.td-primary a');
        if (!link) return;

        e.preventDefault();
        const url = link.getAttribute('href');
        const row = link.closest('tr');

        // Update active row visual indicator
        table.querySelectorAll('tbody tr').forEach(r => {
          r.classList.remove('active');
          r.removeAttribute('style');
        });
        row.classList.add('active');
        row.style.background = 'var(--bg-card-hover)';
        row.style.fontWeight = '500';

        // Opacity transition
        detailContainer.style.opacity = '0.5';

        fetch(url)
          .then(res => res.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newDetail = doc.getElementById('pmlDetailContainer');
            if (newDetail) {
              detailContainer.innerHTML = newDetail.innerHTML;
              detailContainer.style.opacity = '1';

              // Toggle grid selection classes
              const grid = document.querySelector('.drilldown-grid');
              if (grid) {
                grid.classList.remove('no-selection');
                grid.classList.add('has-selection');
              }

              // Update URL path without refresh
              window.history.pushState(null, '', url);

              // Re-bind list search utility
              makeListSearchable('detailPclSearch', 'detailPclList', '.detail-item');

              // Re-bind close handler
              bindCloseDetail();
              if (window.initProgressBars) window.initProgressBars(detailContainer);
              initPmlHistoryChart();
            }
          })
          .catch(err => {
            console.error(err);
            detailContainer.style.opacity = '1';
          });
      });
    }

    // AJAX Tutup Detail handler
    function bindCloseDetail() {
      const closeBtn = detailContainer.querySelector('.btn-secondary');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const url = closeBtn.getAttribute('href');

          // Reset active rows
          if (table) {
            table.querySelectorAll('tbody tr').forEach(r => {
              r.classList.remove('active');
              r.removeAttribute('style');
            });
          }

          detailContainer.style.opacity = '0.5';
          fetch(url)
            .then(res => res.text())
            .then(html => {
              const parser = new DOMParser();
              const doc = parser.parseFromString(html, 'text/html');
              const newDetail = doc.getElementById('pmlDetailContainer');
              if (newDetail) {
                detailContainer.innerHTML = newDetail.innerHTML;
                detailContainer.style.opacity = '1';
                window.history.pushState(null, '', url);

                // Toggle grid selection classes
                const grid = document.querySelector('.drilldown-grid');
                if (grid) {
                  grid.classList.remove('has-selection');
                  grid.classList.add('no-selection');
                }
                if (window.initProgressBars) window.initProgressBars(detailContainer);
              }
            })
            .catch(err => {
              console.error(err);
              detailContainer.style.opacity = '1';
            });
        });
      }
    }

    bindCloseDetail();
    initPmlHistoryChart();
  });
</script>
