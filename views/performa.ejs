<div class="fade-in">
  <% if (!uploadId) { %>
    <div class="card empty-state text-center">
      <div class="empty-state-icon"><i class="bi bi-bar-chart-steps"></i></div>
      <div class="empty-state-title">Belum Ada Data Terupload</div>
      <div class="empty-state-text">Silakan upload data terlebih dahulu di menu <a href="<%= navPrefix %>/admin/upload">Upload Data</a>.</div>
    </div>
  <% } else { %>
    <!-- PETUGAS NAVIGATION TABS -->
    <div class="petugas-tabs-wrapper">
      <a href="<%= navPrefix %>/pcl" class="petugas-tab-item <%= activePage === 'pcl' ? 'active' : '' %>">
        <i class="bi bi-person-gear"></i>
        <span><%= (typeof isSakernas !== 'undefined' && isSakernas) ? 'PPL' : 'PCL' %></span>
      </a>
      <a href="<%= navPrefix %>/pml" class="petugas-tab-item <%= activePage === 'pml' ? 'active' : '' %>">
        <i class="bi bi-clipboard2-data"></i>
        <span>PML</span>
      </a>
      <% if (typeof settings === 'undefined' || settings.page_korlap !== '0') { %>
      <a href="<%= navPrefix %>/korlap" class="petugas-tab-item <%= activePage === 'korlap' ? 'active' : '' %>">
        <i class="bi bi-person-workspace"></i>
        <span>Korlap</span>
      </a>
      <% } %>
      <% if (typeof settings === 'undefined' || settings.page_performa !== '0') { %>
      <a href="<%= navPrefix %>/performa" class="petugas-tab-item <%= activePage === 'performa' ? 'active' : '' %>">
        <i class="bi bi-speedometer2"></i>
        <span>Performa</span>
      </a>
      <% } %>
      <% if (typeof settings === 'undefined' || settings.page_leaderboard !== '0') { %>
      <a href="<%= navPrefix %>/leaderboard" class="petugas-tab-item <%= activePage === 'leaderboard' ? 'active' : '' %>">
        <i class="bi bi-trophy"></i>
        <span>Leaderboard</span>
      </a>
      <% } %>
    </div>

    <!-- FILTER BAR -->
    <div class="card" style="margin-bottom: 20px;">
      <div class="card-header" style="margin-bottom: 8px; padding-bottom: 8px;">
        <div class="card-title"><i class="bi bi-search"></i> Filter Performa Petugas</div>
        <a href="<%= navPrefix %>/performa" class="btn btn-secondary btn-xs"><i class="bi bi-arrow-repeat"></i> Reset</a>
      </div>
      <form action="<%= navPrefix %>/performa" method="GET" id="filterForm">
        <div class="filter-form-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: 10px;">
          <div>
            <label for="performaKec" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">Kecamatan</label>
            <select id="performaKec" name="kec" onchange="this.form.submit();" style="width:100%;">
              <option value="">-- Semua --</option>
              <% kecList.forEach(k => { %>
                <option value="<%= k.kecamatan %>" <%= filterKec === k.kecamatan ? 'selected' : '' %>><%= k.kecamatan %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="performaKorlap" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">Koordinator Lapangan</label>
            <select id="performaKorlap" name="korlap" onchange="this.form.submit();" style="width:100%;">
              <option value="">-- Semua --</option>
              <% korlapList.forEach(k => { %>
                <option value="<%= k.korlap %>" <%= filterKorlap === k.korlap ? 'selected' : '' %>><%= k.korlap %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="performaPml" style="display:block; font-size:11px; margin-bottom:4px; color:var(--text-muted);">PML (Pengawas)</label>
            <select id="performaPml" name="pml" onchange="this.form.submit();" style="width:100%;">
              <option value="">-- Semua --</option>
              <% pmlList.forEach(p => { %>
                <option value="<%= p.pml %>" <%= filterPml === p.pml ? 'selected' : '' %>><%= p.pml %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </form>
    </div>

    <!-- TABEL PCL -->
    <div class="card">
      <div class="card-header" style="border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 0;">
        <div class="card-title"><i class="bi bi-speedometer2"></i> Performa Petugas Pencacah Lapangan (PCL)</div>
        <span class="badge badge-green" style="font-size: 11px;"><%= performers.topPcl ? performers.topPcl.length : 0 %> PCL</span>
      </div>
      <p style="font-size: 11px; color: var(--text-muted); padding: 10px 16px 0; margin: 0;">
        Progres dihitung dari: <strong>(Submitted + Approved + Rejected) / Target Assignment FASIH</strong> &mdash; tanpa menghitung status Open dan Draft.
        Klik header kolom untuk mengurutkan.
      </p>
      <div class="table-wrap" style="overflow-x: auto;">
        <table id="performa-pcl-table" class="sortable-table" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border);">
              <th class="text-center" style="padding: 10px 8px; width: 44px;">No</th>
              <th style="padding: 10px 8px; min-width: 140px;">Nama PCL</th>
              <th style="padding: 10px 8px; min-width: 100px;">Kecamatan</th>
              <th style="padding: 10px 8px; min-width: 120px;">PML</th>
              <th style="padding: 10px 8px; min-width: 110px;">Korlap</th>
              <th class="text-right bg-purple-soft" style="padding: 10px 8px; width: 72px;">Target</th>
              <th class="text-right bg-blue-soft" style="padding: 10px 8px; width: 80px;">Laju Saat Ini</th>
              <th class="text-right bg-orange-soft" style="padding: 10px 8px; width: 90px;">Kec. Perlu/Hr</th>
              <th class="text-right bg-orange-soft" style="padding: 10px 8px; width: 80px;">Perlu (Hari)</th>
              <th class="text-center bg-blue-soft" style="padding: 10px 8px; width: 110px;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (performers.topPcl && performers.topPcl.length > 0) { %>
              <% performers.topPcl.forEach((item, index) => { %>
                <%
                  // Progres: semua status kecuali open & draft
                  let fasihSelesai = (item.submitted_total || 0) + (item.approved_total || 0) + (item.rejected_total || 0);
                  let pct = item.target_fasih_total > 0 ? Math.min(100, parseFloat((100 * fasihSelesai / item.target_fasih_total).toFixed(2))) : 0;

                  // Laju saat ini (berdasarkan progres nyata: submit+approve+reject / hari berjalan)
                  let runrate = diffDays > 0 ? parseFloat((fasihSelesai / diffDays).toFixed(2)) : 0;
                  let remainingFasih = (item.target_fasih_total || 0) - fasihSelesai;

                  // Kecepatan yang perlu dicapai agar selesai tepat waktu
                  let requiredRate = (remainingFasih > 0 && daysRemaining > 0)
                    ? parseFloat((remainingFasih / daysRemaining).toFixed(2))
                    : (remainingFasih <= 0 ? 0 : null);

                  // Perkiraan hari selesai dengan laju saat ini
                  let daysNeededVal = null;
                  if (remainingFasih <= 0) {
                    daysNeededVal = 0;
                  } else if (runrate > 0) {
                    daysNeededVal = Math.ceil(remainingFasih / runrate);
                  }

                  let statusBadge = '';
                  let statusText = '';
                  let statusSortVal = 9999;

                  if (remainingFasih <= 0) {
                    statusBadge = 'badge-green';
                    statusText = 'Selesai';
                    statusSortVal = 0;
                  } else if (runrate <= 0) {
                    statusBadge = 'badge-red';
                    statusText = 'Stagnan';
                    statusSortVal = 9999;
                  } else if (daysNeededVal <= daysRemaining) {
                    statusBadge = 'badge-blue';
                    statusText = 'On Track';
                    statusSortVal = daysNeededVal;
                  } else {
                    statusBadge = 'badge-red';
                    statusText = 'Off Track';
                    statusSortVal = daysNeededVal;
                  }

                  // Narasi Kecepatan & Estimasi Selesai (Tooltip Hover)
                  let hoverNarrative = '';
                  if (remainingFasih <= 0) {
                    hoverNarrative = `Petugas ${item.pcl} telah menyelesaikan seluruh target pendataan (${item.target_fasih_total} dokumen). Status: Selesai 100%!`;
                  } else {
                    let speedText = runrate.toFixed(2);
                    let estText = runrate > 0 ? `${daysNeededVal} hari` : 'Tidak dapat diprediksi (stagnan)';
                    let trackText = (runrate <= 0 || daysNeededVal > daysRemaining) ? 'Off-Track' : 'On-Track';
                    
                    hoverNarrative = `Petugas: ${item.pcl}\n` +
                      `Kecepatan Saat Ini: ${speedText} dok/hari\n` +
                      `Prediksi Selesai: ${estText} (Sisa target: ${remainingFasih} dok)\n` +
                      `Sisa Hari Tersedia: ${daysRemaining} hari\n` +
                      `Status Kinerja: ${trackText}`;

                    if (runrate <= 0 || daysNeededVal > daysRemaining) {
                      let speedNeed = requiredRate !== null ? requiredRate.toFixed(2) : remainingFasih;
                      hoverNarrative += `\n[Off-Track] Diperlukan peningkatan kecepatan minimal ${speedNeed} dok/hari agar selesai tepat waktu pada 31 Agustus 2026.`;
                    } else {
                      hoverNarrative += `\n[On-Track] Kecepatan kerja sudah memadai untuk selesai tepat waktu sebelum 31 Agustus 2026.`;
                    }
                  }
                %>
                <tr style="border-bottom: 1px solid var(--border);" title="<%= hoverNarrative %>">
                  <td class="text-center" data-sort="<%= index + 1 %>" style="padding: 10px 8px; font-size: 12px; color: var(--text-muted);">
                    <%= index + 1 %>
                  </td>
                  <td data-sort="<%= item.pcl %>" style="padding: 10px 8px; font-weight: 600; font-size: 13px;">
                    <a href="<%= navPrefix %>/pcl?pcl=<%= encodeURIComponent(item.pcl) %>" style="text-decoration: none; color: inherit; cursor: help;" title="<%= hoverNarrative %>">
                      <%= item.pcl %> <i class="bi bi-info-circle text-muted" style="font-size: 10px; margin-left: 2px;"></i>
                    </a>
                    <% if (kippPcls.includes(item.pcl.toUpperCase())) { %>
                      <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 4px;">KIPP</span>
                    <% } %>
                  </td>
                  <td data-sort="<%= item.kecamatan %>" style="padding: 10px 8px; font-size: 12px;">
                    <%= item.kecamatan %>
                  </td>
                  <td data-sort="<%= item.pml %>" style="padding: 10px 8px; font-size: 12px;">
                    <%= item.pml %>
                    <% if (kippPmls.includes(item.pml.toUpperCase())) { %>
                      <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 2px;">KIPP</span>
                    <% } %>
                  </td>
                  <td data-sort="<%= item.korlap %>" style="padding: 10px 8px; font-size: 12px;">
                    <%= item.korlap %>
                  </td>
                  <td class="text-right bg-purple-soft" data-sort="<%= item.target_fasih_total || 0 %>" style="padding: 10px 8px;">
                    <%= (item.target_fasih_total || 0).toLocaleString('id-ID') %>
                  </td>
                  <td class="text-right bg-blue-soft" data-sort="<%= runrate %>" style="padding: 10px 8px; font-weight: 500;">
                    <%= runrate.toFixed(2) %>
                  </td>
                  <td class="text-right bg-orange-soft" data-sort="<%= requiredRate !== null ? requiredRate : 9999 %>" style="padding: 10px 8px; font-weight: 500;">
                    <% if (remainingFasih <= 0) { %>
                      <span style="color: var(--accent-green);">—</span>
                    <% } else if (daysRemaining <= 0) { %>
                      <span style="color: var(--accent-red); font-weight:700;">∞</span>
                    <% } else { %>
                      <span style="color: <%= requiredRate > runrate ? 'var(--accent-red)' : 'var(--accent-cyan)' %>; font-weight: 600;">
                        <%= requiredRate.toFixed(2) %>
                      </span>
                    <% } %>
                  </td>
                  <td class="text-right bg-orange-soft" data-sort="<%= daysNeededVal !== null ? daysNeededVal : 9999 %>" style="padding: 10px 8px;">
                    <% if (remainingFasih <= 0) { %>
                      <span style="color: var(--accent-green);">—</span>
                    <% } else if (daysNeededVal === null) { %>
                      <span style="color: var(--accent-red); font-weight:700;">∞</span>
                    <% } else { %>
                      <span style="color: <%= daysNeededVal > daysRemaining ? 'var(--accent-red)' : 'var(--text-primary)' %>; font-weight: 500;">
                        <%= daysNeededVal %>
                      </span>
                    <% } %>
                  </td>
                  <td class="text-center bg-blue-soft" data-sort="<%= statusSortVal %>" style="padding: 10px 8px;">
                    <span class="badge <%= statusBadge %>" style="font-size: 10px; padding: 3px 8px;"><%= statusText %></span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="10" class="text-center" style="padding: 24px; color: var(--text-muted);">
                  <i class="bi bi-inbox" style="font-size: 24px; display: block; margin-bottom: 8px;"></i>
                  Tidak ada data PCL ditemukan.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  if (typeof makeTableSortable === 'function') {
    makeTableSortable('performa-pcl-table');
  }
});
</script>
