<%
  const isSakernas = typeof surveyConfig !== 'undefined' && surveyConfig.id && surveyConfig.id.startsWith('sakernas');
  const isSe2026Pml = (typeof activeSurvey !== 'undefined' ? activeSurvey === 'se2026' : (typeof surveyConfig !== 'undefined' ? surveyConfig.id === 'se2026' : true));
  const hideMuatanPml = !isSe2026Pml || (typeof settings !== 'undefined' && settings.show_progres_muatan === '0');
  const officerLabel = isSakernas ? 'PPL' : 'PCL';

  let activeTargetPct = 25;
  const currentDate = typeof latestUpload !== 'undefined' && latestUpload ? new Date(latestUpload.tanggal) : new Date();
  if (isSe2026Pml && currentDate >= new Date('2026-07-01')) {
    activeTargetPct = 40;
  }
%>
<% if (filterPml) { %>
  <div class="card" id="pmlDetailCard" style="margin-bottom: 0; position: sticky; top: 80px;">
    <div class="card-header flex-between" style="gap: 8px;">
      <div class="card-title" style="margin-bottom: 0;"><i class="bi bi-people"></i> Anggota Tim PML: <mark class="highlight-name"><%= filterPml %></mark></div>
      <div class="card-actions flex-start" style="gap: 6px; margin-left: auto;">
        <button onclick="window.shareElementAsImage('pmlDetailCard', event)" class="btn btn-secondary btn-xs" title="Bagikan gambar detail card"><i class="bi bi-share"></i><span class="btn-text-desktop"> Bagikan</span></button>
        <button onclick="window.copyElementAsImage('pmlDetailCard', event)" class="btn btn-secondary btn-xs" title="Salin gambar detail card ke clipboard"><i class="bi bi-copy"></i><span class="btn-text-desktop"> Salin</span></button>
        <a href="<%= navPrefix %>/pml" class="btn btn-secondary btn-xs btn-close-detail" title="Tutup detail card"><i class="bi bi-x-lg"></i><span class="btn-text-desktop"> Tutup</span></a>
      </div>
    </div>

    <% if (detailPcl && detailPcl.length > 0) { %>
      <div class="mb-3">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--text-secondary); margin-bottom: 12px; flex-wrap: wrap; gap: 6px;">
          <% if (!isSakernas) { %>
            <div>Korlap Atasan: <strong><%= (selectedPmlStats && selectedPmlStats.korlap) || detailPcl[0].korlap %></strong></div>
          <% } else { %>
            <div></div>
          <% } %>
          <div>SubSLS Selesai: <strong style="color: var(--accent-green);"><%= selectedPmlStats ? selectedPmlStats.selesai : 0 %></strong> SubSLS</div>
        </div>
        <% 
          let totalBeban = selectedPmlStats ? selectedPmlStats.total_muatan : 0;
          let totalUsaha = selectedPmlStats ? (selectedPmlStats.muatan_selesai !== undefined ? selectedPmlStats.muatan_selesai : (selectedPmlStats.usaha_total + selectedPmlStats.keluarga_total)) : 0;
          let totalPct = selectedPmlStats ? selectedPmlStats.muatan_pct_str : '0.00';

          let totalFasihTgt = selectedPmlStats ? selectedPmlStats.target_fasih_total : 0;
          let totalFasihDone = selectedPmlStats ? ((selectedPmlStats.submitted_total || 0) + (selectedPmlStats.approved_total || 0) + (selectedPmlStats.rejected_total || 0)) : 0;
          let totalFasihPct = selectedPmlStats ? selectedPmlStats.fasih_pct_str : '0.00';

          let totalFasihVerifDone = selectedPmlStats ? ((selectedPmlStats.approved_total || 0) + (selectedPmlStats.rejected_total || 0)) : 0;
          let totalFasihVerifPct = selectedPmlStats ? selectedPmlStats.fasih_verified_pct_str : '0.00';

          let totalFasihOpen = selectedPmlStats ? Math.max(0, (selectedPmlStats.target_fasih_total || 0) - ((selectedPmlStats.draft_total || 0) + (selectedPmlStats.submitted_total || 0) + (selectedPmlStats.approved_total || 0) + (selectedPmlStats.rejected_total || 0))) : 0;
          let totalFasihDraft = selectedPmlStats ? (selectedPmlStats.draft_total || 0) : 0;
          let totalFasihSubmit = selectedPmlStats ? (selectedPmlStats.submitted_total || 0) : 0;
          let totalFasihApprove = selectedPmlStats ? (selectedPmlStats.approved_total || 0) : 0;
          let totalFasihReject = selectedPmlStats ? (selectedPmlStats.rejected_total || 0) : 0;
        %>
        <!-- Progress FASIH -->
        <div style="margin-bottom: 12px;">
          <div class="bar-label" style="font-size: 11.5px; margin-bottom: 4px;">
            <span><i class="bi bi-phone"></i> Progres FASIH Tim (Submit + Approve + Reject)</span>
            <span class="fw-bold" style="color: var(--accent-purple);"><%= totalFasihDone.toLocaleString('id-ID') %> / <%= totalFasihTgt.toLocaleString('id-ID') %> (<%= totalFasihPct %>%)</span>
          </div>
          <div class="progress-bar-wrap" style="height: 6px;">
            <div class="progress-bar <%= parseFloat(totalFasihPct) >= 100 ? 'green' : (parseFloat(totalFasihPct) < 40 ? 'red' : 'purple') %>" data-width="<%= totalFasihPct %>" style="width: 0%;"></div>
          </div>
        </div>

        <!-- Progress Verifikasi PML -->
        <div style="margin-bottom: 12px;">
          <div class="bar-label" style="font-size: 11.5px; margin-bottom: 4px;">
            <span><i class="bi bi-shield-check"></i> Progres Verifikasi PML (Approve + Reject)</span>
            <span class="fw-bold" style="color: var(--accent-purple);"><%= totalFasihVerifDone.toLocaleString('id-ID') %> / <%= totalFasihTgt.toLocaleString('id-ID') %> (<%= totalFasihVerifPct %>%)</span>
          </div>
          <div class="progress-bar-wrap" style="height: 6px;">
            <div class="progress-bar <%= parseFloat(totalFasihVerifPct) >= 100 ? 'green' : (parseFloat(totalFasihVerifPct) < 40 ? 'red' : 'purple') %>" data-width="<%= totalFasihVerifPct %>" style="width: 0%;"></div>
          </div>
        </div>

        <!-- Rincian Status Dokumen FASIH Tim PML -->
        <div class="fasih-grid-container" style="margin-bottom: 14px;">
          <div class="fasih-grid" style="grid-template-columns: repeat(5, 1fr); gap: 4px;">
            <div class="fasih-grid-item fasih-item-open" title="Open: Alokasi FASIH yang belum disentuh/draft">
              <div class="fasih-grid-item-label" style="font-size: 8.5px;">Open</div>
              <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihOpen.toLocaleString('id-ID') %></div>
            </div>
            <div class="fasih-grid-item fasih-item-draft" title="Draft: Sedang Diisi <%= officerLabel %>">
              <div class="fasih-grid-item-label" style="font-size: 8.5px;">Draft</div>
              <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihDraft.toLocaleString('id-ID') %></div>
            </div>
            <div class="fasih-grid-item fasih-item-submit" title="Submitted: Dikirim ke PML">
              <div class="fasih-grid-item-label" style="font-size: 8.5px;">Submit</div>
              <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihSubmit.toLocaleString('id-ID') %></div>
            </div>
            <div class="fasih-grid-item fasih-item-approve" title="Approved: Disetujui PML">
              <div class="fasih-grid-item-label" style="font-size: 8.5px;">Approve</div>
              <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihApprove.toLocaleString('id-ID') %></div>
            </div>
            <div class="fasih-grid-item fasih-item-reject" title="Rejected: Ditolak / Perlu Perbaikan">
              <div class="fasih-grid-item-label" style="font-size: 8.5px;">Reject</div>
              <div class="fasih-grid-item-value" style="font-size: 11px;"><%= totalFasihReject.toLocaleString('id-ID') %></div>
            </div>
          </div>
        </div>

        <% if (!hideMuatanPml) { %>
        <div style="margin-bottom: 14px;" class="muatan-col">
          <div class="bar-label" style="font-size: 11.5px; margin-bottom: 4px;">
            <span><i class="bi bi-briefcase"></i> Progres Muatan Tim</span>
            <span class="fw-bold" style="color: var(--accent-cyan);"><%= totalUsaha.toLocaleString('id-ID') %> / <%= totalBeban.toLocaleString('id-ID') %> (<%= totalPct %>%)</span>
          </div>
          <div class="progress-bar-wrap" style="height: 6px;">
            <div class="progress-bar <%= parseFloat(totalPct) >= 100 ? 'green' : (parseFloat(totalPct) < 40 ? 'red' : 'cyan') %>" data-width="<%= totalPct %>" style="width: 0%;"></div>
          </div>
        </div>
        <% } %>
      </div>

        <!-- PML HISTORICAL CHART ACCORDION -->
        <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 12px; overflow: hidden;">
          <div class="pml-chart-header flex-between" onclick="togglePmlChart()" style="padding: 8px 12px; cursor: pointer; background: rgba(0,0,0,0.1); user-select: none;">
            <div style="font-size: 12px; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 6px;">
              <i class="bi bi-graph-up-arrow" style="color: var(--accent-cyan);"></i> Tren Kinerja Tim PML (Antar Waktu)
            </div>
            <i class="bi bi-chevron-down" id="pmlChartChevron" style="font-size: 11px; transition: transform 0.2s ease;"></i>
          </div>
          <div id="pmlChartBody" style="display: none; padding: 10px 4px 6px 4px;">
            <div style="height: 180px; position: relative; width: 100%; padding-left: 10px; padding-right: 10px;">
              <canvas id="pmlHistoryChartCanvas"></canvas>
            </div>
          </div>

          <!-- JSON data script tag -->
          <script id="pmlHistoryData" type="application/json">
            <%- JSON.stringify(pmlHistory || []) %>
          </script>
        </div>

        <div class="search-wrap mb-4" style="max-width: 100%; margin-bottom: 12px;">
          <input type="search" id="detailPclSearch" placeholder="Cari nama <%= officerLabel %> dalam tim..." aria-label="Cari nama <%= officerLabel %> dalam tim">
        </div>

        <div id="detailPclList" style="max-height: 420px; overflow-y: auto; padding-right: 4px;">
          <% detailPcl.forEach(item => { %>
            <div class="detail-item" style="background: rgba(255,255,255,0.01); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 5px 8px; margin-bottom: 4px; font-size: 11px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                <div style="font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 75%;">
                  <a href="<%= navPrefix %>/pcl?pcl=<%= encodeURIComponent(item.pcl) %>" style="color: var(--accent-cyan); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                    <i class="bi bi-person"></i> <%= item.pcl %>
                  </a>
                <% if (kippPcls.includes(item.pcl.toUpperCase())) { %>
                  <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 2px;">KIPP</span>
                <% } %>
              </div>
            </div>
            
            <!-- FASIH Progress Bar -->
            <%
              const itemDone = (item.submitted_total || 0) + (item.approved_total || 0) + (item.rejected_total || 0);
              const itemTgt = (item.target_fasih_total !== undefined ? item.target_fasih_total : item.target_fasih) || 0;
              const itemOpen = item.open_total !== undefined ? item.open_total : Math.max(0, itemTgt - ((item.draft_total || 0) + itemDone));
              const itemApp = item.approved_total || 0;
              const itemSub = item.submitted_total || 0;
              const itemRej = item.rejected_total || 0;
              const itemDft = item.draft_total || 0;
              const itemActiveTotal = itemApp + itemSub + itemRej + itemDft + itemOpen;
              const itemBase = Math.max(itemTgt, itemActiveTotal, 1);

              const wApp = Math.max(0, (itemApp / itemBase * 100));
              const wSub = Math.max(0, (itemSub / itemBase * 100));
              const wRej = Math.max(0, (itemRej / itemBase * 100));
              const wDft = Math.max(0, (itemDft / itemBase * 100));
              const wOpn = Math.max(0, (itemOpen / itemBase * 100));

              const pctVal = parseFloat(item.fasih_pct) || 0;
            %>
            <div style="display: flex; justify-content: space-between; font-size: 9.5px; color: var(--text-muted); margin-top: 4px;">
              <span style="font-weight: 600;"><i class="bi bi-phone"></i> FASIH: <span style="color: var(--accent-purple);"><%= pctVal.toFixed(2) %>%</span></span>
              <span><%= itemDone.toLocaleString('id-ID') %> / <%= itemTgt.toLocaleString('id-ID') %></span>
            </div>

            <!-- Stacked Bar (Default) -->
            <div class="progress-track-stacked"
                 style="height: 6px; margin-top: 2px; margin-bottom: 6px;"
                 data-name="<%= item.pcl %>"
                 data-target="<%= itemTgt %>"
                 data-app="<%= itemApp %>"
                 data-sub="<%= itemSub %>"
                 data-rej="<%= itemRej %>"
                 data-draft="<%= itemDft %>"
                 data-open="<%= itemOpen %>"
                 tabindex="0"
                 role="progressbar"
                 aria-label="Progres FASIH <%= item.pcl %>">
              <% if (wApp > 0) { %><div class="stacked-segment seg-approved" style="width: <%= wApp %>%;"></div><% } %>
              <% if (wSub > 0) { %><div class="stacked-segment seg-submitted" style="width: <%= wSub %>%;"></div><% } %>
              <% if (wRej > 0) { %><div class="stacked-segment seg-rejected" style="width: <%= wRej %>%;"></div><% } %>
              <% if (wDft > 0) { %><div class="stacked-segment seg-draft" style="width: <%= wDft %>%;"></div><% } %>
              <% if (wOpn > 0) { %><div class="stacked-segment seg-open" style="width: <%= wOpn %>%;"></div><% } %>
            </div>

            <!-- Standard Bar (When Toggled) -->
            <div class="progress-track-standard">
              <div class="progress-bar-target-wrap" style="position: relative; height: 5px; margin-top: 2px; margin-bottom: 6px;">
                <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                  <div class="progress-bar <%= pctVal >= 100 ? 'green' : (pctVal < 40 ? 'red' : 'blue') %>" data-width="<%= pctVal %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                </div>
                <div style="position: absolute; left: <%= activeTargetPct %>%; top: -2px; height: 9px; border-left: 1.5px dashed var(--accent-cyan); z-index: 2; opacity: 0.8; pointer-events: none;" title="Target: <%= activeTargetPct %>%"></div>
              </div>
            </div>

            <!-- Muatan Progress Bar -->
            <% if (!hideMuatanPml) { %>
            <% const muatanPctVal = parseFloat(item.muatan_pct) || 0; %>
            <div style="display: flex; justify-content: space-between; font-size: 9px; color: var(--text-muted); margin-top: 4px;" class="muatan-col">
              <span style="font-weight: 600;"><i class="bi bi-briefcase"></i> Muatan: <span style="color: var(--accent-cyan);"><%= item.muatan_pct_str %>%</span></span>
              <span><%= (item.muatan_selesai !== undefined ? item.muatan_selesai : (item.usaha_total + item.keluarga_total)).toLocaleString('id-ID') %> / <%= ((item.total_muatan !== undefined ? item.total_muatan : item.muatan) || 0).toLocaleString('id-ID') %></span>
            </div>
            <div class="progress-bar-target-wrap muatan-col" style="position: relative; height: 5px; margin-top: 2px; margin-bottom: 6px;">
              <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                <div class="progress-bar <%= muatanPctVal >= 100 ? 'green' : (muatanPctVal < 40 ? 'red' : 'cyan') %>" data-width="<%= muatanPctVal %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
              </div>
              <div style="position: absolute; left: <%= activeTargetPct %>%; top: -2px; height: 9px; border-left: 1.5px dashed var(--accent-cyan); z-index: 2; opacity: 0.8; pointer-events: none;" title="Target: <%= activeTargetPct %>%"></div>
            </div>
            <% } %>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: var(--text-muted); flex-wrap: wrap; gap: 4px; margin-top: 8px;">
              <div>Kec. <%= item.kecamatan %></div>
              <div style="display: flex; gap: 8px; font-size: 9px; color: var(--text-muted);">
                <span>Open: <strong style="color: #94a3b8;"><%= itemOpen.toLocaleString('id-ID') %></strong></span>
                <span>(D<%= item.draft_total %> S<%= item.submitted_total %> A<%= item.approved_total %> R<%= item.rejected_total %>)</span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="no-data">Tidak ada detail PCL.</div>
    <% } %>
  </div>
<% } else { %>
  <div class="card empty-state text-center" style="height: 100%; min-height: 300px; display: flex; flex-direction: column; justify-content: center; border-style: dashed;">
    <div class="empty-state-icon"><i class="bi bi-arrow-left-circle"></i></div>
    <div class="empty-state-title">Pilih PML</div>
    <div class="empty-state-text">Klik nama PML di tabel sebelah kiri untuk melihat rincian PCL yang diawasi beserta progres kinerja per PCL.</div>
  </div>
<% } %>
