<div class="fade-in" id="help-page">

<%
/* ─── SECTION DATA ─────────────────────────────────────────── */
const sections = [
  { id: 'getting-started', icon: 'bi-rocket-takeoff-fill', label: 'Mulai Menggunakan', color: 'var(--accent-blue)' },
  { id: 'badges',          icon: 'bi-patch-check-fill',    label: 'Badge & Status',    color: 'var(--accent-green)' },
  { id: 'excel-format',    icon: 'bi-file-earmark-excel-fill', label: 'Format File Excel', color: '#22c55e' },
  { id: 'columns',         icon: 'bi-table',               label: 'Arti Kolom Data',   color: 'var(--accent-cyan)' },
  { id: 'navigation',      icon: 'bi-map-fill',            label: 'Navigasi & Filter', color: 'var(--accent-purple)' },
  { id: 'faq',             icon: 'bi-question-circle-fill', label: 'FAQ',               color: 'var(--accent-yellow)' },
];
%>

<!-- ══════════════════════════════════════════════════
     HERO
═══════════════════════════════════════════════════ -->
<div style="background: linear-gradient(135deg, rgba(var(--accent-rgb),0.12) 0%, rgba(var(--accent-rgb),0.03) 100%); border: 1px solid rgba(var(--accent-rgb),0.2); border-radius: 16px; padding: 32px 28px; margin-bottom: 24px; position: relative; overflow: hidden;">
  <div style="position: absolute; right: -20px; top: -20px; font-size: 120px; opacity: 0.04; line-height: 1; pointer-events: none;">
    <i class="bi bi-question-circle-fill"></i>
  </div>
  <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
    <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(var(--accent-rgb),0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <i class="bi bi-life-preserver" style="font-size: 26px; color: var(--accent-blue);"></i>
    </div>
    <div>
      <h1 style="font-size: 22px; font-weight: 800; color: var(--text-primary); margin: 0 0 4px 0;">Panduan & Bantuan</h1>
      <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">Semua yang perlu Anda ketahui tentang Dashboard Monitoring SE2026 PPU</p>
    </div>
  </div>

  <!-- Quick nav chips -->
  <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px;">
    <% sections.forEach(s => { %>
    <a href="#<%= s.id %>" class="help-chip" style="--chip-color: <%= s.color %>;">
      <i class="bi <%= s.icon %>"></i> <%= s.label %>
    </a>
    <% }); %>
  </div>
</div>

<!-- ══════════════════════════════════════════════════
     1. MULAI MENGGUNAKAN
═══════════════════════════════════════════════════ -->
<div class="help-section" id="getting-started">
  <div class="help-section-header">
    <div class="help-section-icon" style="background: rgba(var(--accent-rgb),0.12);">
      <i class="bi bi-rocket-takeoff-fill" style="color: var(--accent-blue);"></i>
    </div>
    <div>
      <h2 class="help-section-title">Mulai Menggunakan</h2>
      <p class="help-section-sub">Panduan cepat untuk pengguna baru</p>
    </div>
  </div>

  <div class="help-grid-2">
    <div class="help-card">
      <div class="help-card-icon" style="background: rgba(var(--accent-rgb),0.1);">
        <i class="bi bi-display" style="color: var(--accent-blue);"></i>
      </div>
      <h3 class="help-card-title">Overview</h3>
      <p class="help-card-body">Halaman utama berisi ringkasan progres pendataan SE2026 seluruh kabupaten — jumlah selesai, target, dan persentase pencapaian secara keseluruhan.</p>
    </div>
    <div class="help-card">
      <div class="help-card-icon" style="background: rgba(52,211,153,0.1);">
        <i class="bi bi-layers-fill" style="color: var(--accent-green);"></i>
      </div>
      <h3 class="help-card-title">Navigasi Drilldown</h3>
      <p class="help-card-body">Sistem navigasi berlapis: <strong>Overview → Kecamatan → Korlap → PML → PCL → SubSLS</strong>. Klik nama petugas untuk melihat detail tugas mereka.</p>
    </div>
    <div class="help-card">
      <div class="help-card-icon" style="background: rgba(251,191,36,0.1);">
        <i class="bi bi-upload" style="color: var(--accent-yellow);"></i>
      </div>
      <h3 class="help-card-title">Upload Data</h3>
      <p class="help-card-body">Data diperbarui dengan mengupload file Excel dari FASIH. Hanya Admin yang memiliki akses upload. Data terbaru otomatis terpilih sebagai basis tampilan.</p>
    </div>
    <div class="help-card">
      <div class="help-card-icon" style="background: rgba(167,139,250,0.1);">
        <i class="bi bi-clock-history" style="color: var(--accent-purple);"></i>
      </div>
      <h3 class="help-card-title">Data Historis</h3>
      <p class="help-card-body">Grafik tren menampilkan perkembangan pendataan dari hari ke hari. Gunakan halaman <strong>Progres Harian</strong> untuk melihat kenaikan tiap periode.</p>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════
     2. BADGE & STATUS
═══════════════════════════════════════════════════ -->
<div class="help-section" id="badges">
  <div class="help-section-header">
    <div class="help-section-icon" style="background: rgba(52,211,153,0.12);">
      <i class="bi bi-patch-check-fill" style="color: var(--accent-green);"></i>
    </div>
    <div>
      <h2 class="help-section-title">Badge & Status</h2>
      <p class="help-section-sub">Cara membaca label dan indikator warna di dashboard</p>
    </div>
  </div>

  <!-- Progress Status Badges -->
  <div class="help-subsection-title"><i class="bi bi-circle-fill" style="font-size: 8px; color: var(--accent-blue);"></i> Status Progres Pendataan (SubSLS)</div>
  <div class="help-badge-grid">
    <div class="help-badge-item">
      <span class="badge" style="background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); padding: 4px 10px; font-size: 12px; border-radius: 6px; font-weight: 600;">Belum Mulai</span>
      <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0;">Tidak ada aktivitas apapun. PCL belum membuka atau memulai pendataan di SubSLS ini.</p>
    </div>
    <div class="help-badge-item">
      <span class="badge" style="background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); padding: 4px 10px; font-size: 12px; border-radius: 6px; font-weight: 600;">Sedang Didata</span>
      <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0;">Proses pendataan sudah dimulai, namun jumlah usaha/keluarga yang ditemukan belum memenuhi target muatan.</p>
    </div>
    <div class="help-badge-item">
      <span class="badge" style="background: rgba(249,115,22,0.15); color: var(--accent-blue); border: 1px solid rgba(249,115,22,0.3); padding: 4px 10px; font-size: 12px; border-radius: 6px; font-weight: 600;">Memenuhi Target</span>
      <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0;">Jumlah usaha/keluarga yang ditemukan sudah mencapai target muatan yang ditetapkan.</p>
    </div>
    <div class="help-badge-item">
      <span class="badge" style="background: rgba(52,211,153,0.15); color: var(--accent-green); border: 1px solid rgba(52,211,153,0.3); padding: 4px 10px; font-size: 12px; border-radius: 6px; font-weight: 600;">Melebihi Target</span>
      <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0;">Jumlah yang ditemukan melebihi target muatan awal — ini normal karena ada usaha/keluarga baru yang ditemukan di lapangan.</p>
    </div>
  </div>

  <!-- FASIH Status -->
  <div class="help-subsection-title" style="margin-top: 20px;"><i class="bi bi-circle-fill" style="font-size: 8px; color: var(--accent-purple);"></i> Status Dokumen FASIH</div>
  <div class="help-badge-grid">
    <div class="help-badge-item">
      <span class="badge" style="background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); padding: 4px 10px; font-size: 12px; border-radius: 6px; font-weight: 600;"><i class="bi bi-pencil-fill"></i> Draft</span>
      <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0;">Dokumen sudah dibuat oleh PCL namun belum dikirim ke PML untuk diverifikasi.</p>
    </div>
    <div class="help-badge-item">
      <span class="badge" style="background: rgba(59,130,246,0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); padding: 4px 10px; font-size: 12px; border-radius: 6px; font-weight: 600;"><i class="bi bi-send-fill"></i> Dikirim</span>
      <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0;">PCL sudah submit dokumen ke PML, menunggu verifikasi / approval dari PML atau Korlap.</p>
    </div>
    <div class="help-badge-item">
      <span class="badge" style="background: rgba(52,211,153,0.15); color: var(--accent-green); border: 1px solid rgba(52,211,153,0.3); padding: 4px 10px; font-size: 12px; border-radius: 6px; font-weight: 600;"><i class="bi bi-check-circle-fill"></i> Disetujui</span>
      <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0;">Dokumen sudah diverifikasi dan disetujui oleh PML/Korlap. Ini adalah status final yang valid.</p>
    </div>
    <div class="help-badge-item">
      <span class="badge" style="background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); padding: 4px 10px; font-size: 12px; border-radius: 6px; font-weight: 600;"><i class="bi bi-x-circle-fill"></i> Ditolak</span>
      <p style="font-size: 12px; color: var(--text-secondary); margin: 8px 0 0 0;">Dokumen ditolak dan dikembalikan ke PCL untuk diperbaiki. PCL harus melakukan koreksi data.</p>
    </div>
  </div>

  <!-- On-Track / Off-Track -->
  <div class="help-subsection-title" style="margin-top: 20px;"><i class="bi bi-circle-fill" style="font-size: 8px; color: var(--accent-green);"></i> Indikator Ketercapaian Target</div>
  <div class="help-callout" style="--callout-color: 52,211,153;">
    <div style="display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 220px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
          <span style="background: rgba(52,211,153,0.15); color: var(--accent-green); border: 1px solid rgba(52,211,153,0.3); padding: 3px 10px; font-size: 11px; border-radius: 6px; font-weight: 700;">✓ On-Track</span>
          <span style="font-size: 12px; color: var(--text-secondary);">Progres ≥ Target Kumulatif</span>
        </div>
        <p style="font-size: 12px; color: var(--text-secondary); margin: 0;">Persentase progres PCL/PML sudah mencapai atau melampaui target kumulatif berdasarkan tanggal data terkini.</p>
      </div>
      <div style="flex: 1; min-width: 220px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
          <span style="background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); padding: 3px 10px; font-size: 11px; border-radius: 6px; font-weight: 700;">✗ Off-Track</span>
          <span style="font-size: 12px; color: var(--text-secondary);">Progres &lt; Target Kumulatif</span>
        </div>
        <p style="font-size: 12px; color: var(--text-secondary); margin: 0;">Progres tertinggal dari target kumulatif. Petugas ini perlu mendapat perhatian atau intervensi.</p>
      </div>
    </div>
    <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 11px; color: var(--text-muted);">
      <i class="bi bi-info-circle"></i> <strong>Target kumulatif</strong> = persentase yang seharusnya tercapai pada tanggal data terkini, dihitung proporsional dari total waktu pendataan (15 Jun – 31 Agu 2026). Saat ini sistem menggunakan nilai <strong>25%</strong> (fase awal) atau <strong>40%</strong> (setelah 1 Juli).
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════
     3. FORMAT FILE EXCEL
═══════════════════════════════════════════════════ -->
<div class="help-section" id="excel-format">
  <div class="help-section-header">
    <div class="help-section-icon" style="background: rgba(34,197,94,0.12);">
      <i class="bi bi-file-earmark-excel-fill" style="color: #22c55e;"></i>
    </div>
    <div>
      <h2 class="help-section-title">Format File Excel</h2>
      <p class="help-section-sub">Spesifikasi file yang dapat diproses oleh sistem</p>
    </div>
  </div>

  <div class="help-grid-2">
    <!-- File 1 -->
    <div class="help-card" style="border-left: 3px solid #22c55e;">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
        <i class="bi bi-file-earmark-excel-fill" style="font-size: 22px; color: #22c55e;"></i>
        <div>
          <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">File 1: Rekap Progres Pencacahan</div>
          <div style="font-size: 11px; color: var(--text-muted);">Sumber: Export FASIH → Rekap Progres</div>
        </div>
      </div>
      <div class="help-tag-row">
        <span class="help-tag"><i class="bi bi-file-earmark"></i> .xlsx / .xls</span>
        <span class="help-tag"><i class="bi bi-arrows-expand"></i> Maks. 50 MB</span>
        <span class="help-tag help-tag-optional">Opsional</span>
      </div>
      <div style="margin-top: 14px;">
        <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 8px;">Kolom yang Dibutuhkan:</div>
        <div class="help-col-list">
          <div class="help-col-item"><code>Kode SLS</code> <span>Kode unik SubSLS</span></div>
          <div class="help-col-item"><code>PCL</code> <span>Nama petugas pencacah lapangan</span></div>
          <div class="help-col-item"><code>PML</code> <span>Nama pengawas PCL</span></div>
          <div class="help-col-item"><code>Korlap</code> <span>Koordinator lapangan</span></div>
          <div class="help-col-item"><code>Kecamatan</code> <span>Nama kecamatan</span></div>
          <div class="help-col-item"><code>Draft</code> <span>Jumlah dokumen draft</span></div>
          <div class="help-col-item"><code>Dikirim</code> <span>Jumlah dokumen terkirim</span></div>
          <div class="help-col-item"><code>Disetujui</code> <span>Jumlah dokumen disetujui</span></div>
          <div class="help-col-item"><code>Ditolak</code> <span>Jumlah dokumen ditolak</span></div>
          <div class="help-col-item"><code>Usaha Ditemukan</code> <span>Usaha ditemukan di lapangan</span></div>
          <div class="help-col-item"><code>Usaha Baru</code> <span>Usaha baru di luar muatan</span></div>
          <div class="help-col-item"><code>Usaha Tutup</code> <span>Usaha yang tutup/tidak ada</span></div>
        </div>
      </div>
    </div>

    <!-- File 2 -->
    <div class="help-card" style="border-left: 3px solid var(--accent-purple);">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
        <i class="bi bi-file-earmark-excel-fill" style="font-size: 22px; color: var(--accent-purple);"></i>
        <div>
          <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">File 2: Rekap Status Assignment FASIH</div>
          <div style="font-size: 11px; color: var(--text-muted);">Sumber: Export FASIH → Status Assignment</div>
        </div>
      </div>
      <div class="help-tag-row">
        <span class="help-tag"><i class="bi bi-file-earmark"></i> .xlsx / .xls</span>
        <span class="help-tag"><i class="bi bi-arrows-expand"></i> Maks. 50 MB</span>
        <span class="help-tag help-tag-optional">Opsional</span>
      </div>
      <div style="margin-top: 14px;">
        <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 8px;">Kolom yang Dibutuhkan:</div>
        <div class="help-col-list">
          <div class="help-col-item"><code>Kode SLS</code> <span>Kode unik SubSLS</span></div>
          <div class="help-col-item"><code>PCL</code> <span>Nama petugas yang di-assign</span></div>
          <div class="help-col-item"><code>Status FASIH</code> <span>Status assignment di aplikasi</span></div>
          <div class="help-col-item"><code>Target FASIH</code> <span>Jumlah target dokumen FASIH</span></div>
        </div>
      </div>
      <div class="help-callout" style="--callout-color: 167,139,250; margin-top: 14px; padding: 10px 12px;">
        <div style="font-size: 12px; color: var(--text-secondary);">
          <i class="bi bi-lightbulb-fill" style="color: var(--accent-purple);"></i>
          File ini melengkapi File 1 dengan informasi target FASIH per-SubSLS yang digunakan untuk menghitung persentase ketercapaian.
        </div>
      </div>
    </div>
  </div>

  <!-- Tips -->
  <div class="help-callout" style="--callout-color: 249,115,22; margin-top: 16px;">
    <div style="font-size: 13px; font-weight: 600; color: var(--accent-blue); margin-bottom: 8px;"><i class="bi bi-exclamation-triangle-fill"></i> Tips Upload yang Benar</div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px;">
      <div style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: flex-start; gap: 6px;">
        <i class="bi bi-check-circle-fill" style="color: var(--accent-green); margin-top: 1px; flex-shrink: 0;"></i>
        Pastikan nama kolom <strong>persis sama</strong> dengan yang diharapkan (termasuk spasi)
      </div>
      <div style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: flex-start; gap: 6px;">
        <i class="bi bi-check-circle-fill" style="color: var(--accent-green); margin-top: 1px; flex-shrink: 0;"></i>
        File tidak boleh terlindungi password / terenkripsi
      </div>
      <div style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: flex-start; gap: 6px;">
        <i class="bi bi-check-circle-fill" style="color: var(--accent-green); margin-top: 1px; flex-shrink: 0;"></i>
        Bisa upload beberapa file sekaligus dalam satu sesi
      </div>
      <div style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: flex-start; gap: 6px;">
        <i class="bi bi-check-circle-fill" style="color: var(--accent-green); margin-top: 1px; flex-shrink: 0;"></i>
        Pilih tanggal data yang tepat sesuai data di file Excel
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════
     4. ARTI KOLOM DATA
═══════════════════════════════════════════════════ -->
<div class="help-section" id="columns">
  <div class="help-section-header">
    <div class="help-section-icon" style="background: rgba(var(--accent-rgb),0.12);">
      <i class="bi bi-table" style="color: var(--accent-cyan);"></i>
    </div>
    <div>
      <h2 class="help-section-title">Arti Kolom Data</h2>
      <p class="help-section-sub">Penjelasan setiap metrik yang ditampilkan di tabel dan kartu</p>
    </div>
  </div>

  <!-- Tabel Definisi Kolom -->
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="min-width: 140px;">Kolom / Metrik</th>
          <th>Penjelasan</th>
          <th style="min-width: 80px; text-align: center;">Sumber</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="td-primary"><code>Total SLS</code></td>
          <td>Jumlah total SubSLS (Satuan Lingkungan Setempat) yang ditugaskan kepada petugas/wilayah ini</td>
          <td style="text-align: center;"><span class="help-tag" style="font-size: 10px;">Master</span></td>
        </tr>
        <tr>
          <td class="td-primary"><code>Selesai</code></td>
          <td>Jumlah SubSLS yang sudah selesai didata — artinya jumlah <em>Dikirim + Disetujui + Ditolak</em> ≥ target FASIH</td>
          <td style="text-align: center;"><span class="help-tag" style="font-size: 10px;">FASIH</span></td>
        </tr>
        <tr>
          <td class="td-primary"><code>Draft</code></td>
          <td>Dokumen yang sudah dibuat PCL tapi belum dikirim ke PML. Ini belum dihitung sebagai "selesai"</td>
          <td style="text-align: center;"><span class="help-tag" style="font-size: 10px;">FASIH</span></td>
        </tr>
        <tr>
          <td class="td-primary"><code>Dikirim</code></td>
          <td>Dokumen yang sudah di-submit oleh PCL ke PML untuk diverifikasi. Dihitung dalam progres</td>
          <td style="text-align: center;"><span class="help-tag" style="font-size: 10px;">FASIH</span></td>
        </tr>
        <tr>
          <td class="td-primary"><code>Disetujui</code></td>
          <td>Dokumen yang sudah divalidasi oleh PML/Korlap. Status final terbaik</td>
          <td style="text-align: center;"><span class="help-tag" style="font-size: 10px;">FASIH</span></td>
        </tr>
        <tr>
          <td class="td-primary"><code>Ditolak</code></td>
          <td>Dokumen yang dikembalikan karena ada kesalahan. PCL perlu merevisi dan mengirim ulang</td>
          <td style="text-align: center;"><span class="help-tag" style="font-size: 10px;">FASIH</span></td>
        </tr>
        <tr>
          <td class="td-primary"><code>Target FASIH</code></td>
          <td>Jumlah dokumen FASIH yang harus diselesaikan. Bisa berubah sesuai kondisi lapangan (usaha baru/tutup)</td>
          <td style="text-align: center;"><span class="help-tag" style="font-size: 10px;">Assignment</span></td>
        </tr>
        <tr>
          <td class="td-primary"><code>Muatan</code></td>
          <td>Jumlah usaha/keluarga yang tercatat dalam rancangan awal (muatan awal) untuk SubSLS tersebut</td>
          <td style="text-align: center;"><span class="help-tag" style="font-size: 10px;">Master</span></td>
        </tr>
        <tr>
