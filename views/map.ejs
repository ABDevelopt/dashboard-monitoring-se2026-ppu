<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  .map-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .map-kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .map-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .map-kpi-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .map-container-wrap {
    display: flex;
    gap: 20px;
    height: calc(100vh - var(--header-height) - 150px);
    min-height: 540px;
    margin-top: 4px;
  }
  
  .map-sidebar-panel {
    width: 350px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    max-height: 100%;
    overflow-y: auto !important;
    overflow-x: hidden;
    padding-right: 6px;
    flex-shrink: 0;
    box-sizing: border-box;
    scrollbar-width: thin;
    scrollbar-color: var(--border) var(--bg-secondary);
  }

  .map-sidebar-panel .card {
    min-height: 160px;
    max-height: 380px;
    overflow-y: auto !important;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .map-sidebar-panel .map-card-control {
    min-height: 240px;
  }

  .map-sidebar-panel .map-card-stats {
    min-height: 180px;
  }

  .map-sidebar-panel .map-card-legend {
    min-height: 170px;
  }

  .map-sidebar-panel::-webkit-scrollbar,
  .map-sidebar-panel .card::-webkit-scrollbar,
  #mapSummaryStats::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .map-sidebar-panel::-webkit-scrollbar-track,
  .map-sidebar-panel .card::-webkit-scrollbar-track,
  #mapSummaryStats::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.04);
    border-radius: 4px;
  }
  .map-sidebar-panel::-webkit-scrollbar-thumb,
  .map-sidebar-panel .card::-webkit-scrollbar-thumb,
  #mapSummaryStats::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }
  .map-sidebar-panel::-webkit-scrollbar-thumb:hover,
  .map-sidebar-panel .card::-webkit-scrollbar-thumb:hover,
  #mapSummaryStats::-webkit-scrollbar-thumb:hover {
    background: var(--accent-blue);
  }

  #mapSummaryStats {
    max-height: 280px;
    overflow-y: auto !important;
    padding-right: 4px;
  }

  .map-canvas-container {
    flex: 1;
    position: relative;
    height: 100%;
    min-height: 480px;
  }

  #map {
    width: 100%;
    height: 100%;
    min-height: 480px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    box-shadow: var(--shadow);
    z-index: 10;
  }

  .map-legend-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .map-legend-color {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(21, 21, 27, 0.75);
    backdrop-filter: blur(4px);
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius);
    transition: opacity 0.3s ease;
    pointer-events: none;
    opacity: 1;
    color: var(--text-primary);
  }

  body.light-mode .loading-overlay {
    background: rgba(245, 239, 230, 0.75);
  }

  .spinner {
    border: 4px solid rgba(255,255,255,0.1);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border-left-color: var(--accent-blue);
    animation: spin 1s linear infinite;
    margin-bottom: 12px;
  }

  body.light-mode .spinner {
    border-color: rgba(60, 51, 46, 0.1);
    border-left-color: var(--accent-blue);
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .info-table {
    width: 100%;
    margin-top: 8px;
    border-collapse: collapse;
    font-size: 12px;
  }

  .info-table td {
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .info-table td.label {
    font-weight: 500;
    color: var(--text-primary);
    width: 45%;
  }

  .info-table td.value {
    text-align: right;
    font-weight: 600;
  }

  .leaflet-popup-content-wrapper {
    background: var(--bg-card) !important;
    color: var(--text-primary) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius) !important;
    font-family: 'Inter', system-ui, sans-serif !important;
    box-shadow: var(--shadow-lg) !important;
    padding: 4px !important;
  }

  .leaflet-popup-tip {
    background: var(--bg-card) !important;
    border-left: 1px solid var(--border) !important;
    border-bottom: 1px solid var(--border) !important;
  }

  .leaflet-container a.leaflet-popup-close-button {
    color: var(--text-secondary) !important;
    padding: 6px !important;
  }

  .leaflet-popup-content-wrapper a.btn-primary,
  .leaflet-popup-content-wrapper .btn-primary {
    color: #ffffff !important;
    background: var(--accent-blue) !important;
    font-weight: 600 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .leaflet-popup-content-wrapper a.btn-primary:hover {
    background: #ea580c !important;
    color: #ffffff !important;
  }

  .leaflet-bar {
    border: 1px solid var(--border) !important;
    box-shadow: var(--shadow) !important;
    border-radius: var(--radius-sm) !important;
    overflow: hidden;
  }

  .leaflet-bar a {
    background-color: var(--bg-card) !important;
    color: var(--text-primary) !important;
    border-bottom: 1px solid var(--border) !important;
  }

  .leaflet-bar a:hover {
    background-color: var(--bg-card-hover) !important;
    color: var(--accent-blue) !important;
  }

  .map-layer-selector {
    display: flex;
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    padding: 3px;
    margin-top: 6px;
    border: 1px solid var(--border);
  }

  .map-layer-btn {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    padding: 7px 10px;
    font-size: 11px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: var(--transition);
  }

  .map-layer-btn.active {
    background: var(--bg-card);
    color: var(--accent-blue);
    box-shadow: var(--shadow-sm);
  }

  .map-card-stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .map-card-stat:last-child {
    border-bottom: none;
  }
  .map-card-label {
    font-size: 12px;
    color: var(--text-secondary);
  }
  .map-card-value {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .map-quick-tools {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1000;
    display: flex;
    gap: 8px;
  }

  .mobile-map-toggle-bar {
    display: none;
  }

  @media (max-width: 992px) {
    .map-kpi-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .mobile-map-toggle-bar {
      display: block !important;
      margin-bottom: 12px;
    }

    .map-container-wrap {
      flex-direction: column !important;
      height: auto !important;
      min-height: 0 !important;
    }

    .map-canvas-container {
      width: 100% !important;
      height: 480px !important;
      min-height: 480px !important;
    }

    #map {
      width: 100% !important;
      height: 480px !important;
      min-height: 480px !important;
    }

    .map-sidebar-panel {
      width: 100% !important;
      max-height: none !important;
    }

    .map-container-wrap.show-info-mobile .map-canvas-container {
      display: none !important;
    }

    .map-container-wrap.show-info-mobile .map-sidebar-panel {
      display: flex !important;
      width: 100% !important;
    }

    .map-container-wrap.show-map-mobile .map-sidebar-panel {
      display: none !important;
    }

    .map-container-wrap.show-map-mobile .map-canvas-container {
      display: block !important;
      width: 100% !important;
      height: 480px !important;
      min-height: 480px !important;
    }
  }

  @media (max-width: 576px) {
    .map-kpi-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .map-kpi-card {
      padding: 10px 12px;
      gap: 8px;
    }
    .map-kpi-icon {
      width: 32px;
      height: 32px;
      font-size: 16px;
    }
  }
</style>

<div class="fade-in">
    <!-- SUMMARY KPI CARDS -->
    <div class="map-kpi-grid">
      <!-- KPI 1: Total Wilayah -->
      <div class="map-kpi-card">
        <div class="map-kpi-icon" style="background: rgba(59, 130, 246, 0.12); color: var(--accent-blue);">
          <i class="bi bi-map-fill"></i>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--text-secondary); font-weight: 500;">Total Wilayah Desa</div>
          <div id="statTotalDesa" style="font-size: 16px; font-weight: 700; color: var(--text-primary);">-- Desa</div>
        </div>
      </div>

      <!-- KPI 2: 100% Selesai -->
      <div class="map-kpi-card">
        <div class="map-kpi-icon" style="background: rgba(34, 197, 94, 0.12); color: var(--accent-green);">
          <i class="bi bi-check-circle-fill"></i>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--text-secondary); font-weight: 500;">Target 100% FASIH</div>
          <div id="statDesa100" style="font-size: 16px; font-weight: 700; color: var(--accent-green);">-- Desa</div>
        </div>
      </div>

      <!-- KPI 3: Progres 25%-99% -->
      <div class="map-kpi-card">
        <div class="map-kpi-icon" style="background: rgba(234, 179, 8, 0.12); color: var(--accent-yellow);">
          <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--text-secondary); font-weight: 500;">Progres On Track (25-99%)</div>
          <div id="statDesaHigh" style="font-size: 16px; font-weight: 700; color: var(--accent-yellow);">-- Desa</div>
        </div>
      </div>

      <!-- KPI 4: Perlu Perhatian (<25%) -->
      <div class="map-kpi-card">
        <div class="map-kpi-icon" style="background: rgba(239, 68, 68, 0.12); color: var(--accent-red);">
          <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--text-secondary); font-weight: 500;">Perlu Perhatian (&lt;25%)</div>
          <div id="statDesaLow" style="font-size: 16px; font-weight: 700; color: var(--accent-red);">-- Desa</div>
        </div>
      </div>
    </div>

    <!-- MOBILE VIEW TOGGLE BAR -->
    <div class="mobile-map-toggle-bar">
      <div class="map-layer-selector" style="margin: 0; background: var(--bg-card);">
        <button id="btnMobileMapTab" class="map-layer-btn active"><i class="bi bi-map"></i> Tampilan Peta Spasial</button>
        <button id="btnMobileInfoTab" class="map-layer-btn"><i class="bi bi-sliders"></i> Filter &amp; Detail Wilayah</button>
      </div>
    </div>

    <!-- MAIN MAP CONTENT CONTAINER -->
    <div id="mapContainerWrap" class="map-container-wrap show-map-mobile">
      
      <!-- SIDEBAR PANEL -->
      <div class="map-sidebar-panel">
        
        <!-- CONTROL CARD -->
        <div class="card map-card-control" style="margin-bottom: 0;">
          <div class="card-header" style="margin-bottom: 10px; padding-bottom: 0; display: flex; justify-content: space-between; align-items: center;">
            <div class="card-title"><i class="bi bi-sliders"></i> Kontrol &amp; Filter Peta</div>
            <button id="btnResetView" class="btn btn-secondary btn-xs" title="Reset Pandangan Peta">
              <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
          </div>
          
          <!-- SEARCH WILAYAH -->
          <div class="form-group" style="margin-bottom: 10px;">
            <label for="mapSearchInput" style="font-size: 11px; font-weight: 600; margin-bottom: 4px; display: block; color: var(--text-secondary);">Cari Nama Desa / SLS</label>
            <div style="position: relative;">
              <input type="text" id="mapSearchInput" placeholder="Ketik nama desa atau SLS..." style="width: 100%; padding: 7px 30px 7px 10px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-card); color: var(--text-primary); font-size: 12px;" />
              <i class="bi bi-search" style="position: absolute; right: 10px; top: 8px; color: var(--text-muted); font-size: 12px; pointer-events: none;"></i>
            </div>
          </div>

          <!-- KECAMATAN FILTER -->
          <div class="form-group" style="margin-bottom: 10px;">
            <label for="kecFilter" style="font-size: 11px; font-weight: 600; margin-bottom: 4px; display: block; color: var(--text-secondary);">Kecamatan</label>
            <select id="kecFilter" style="width: 100%; padding: 7px 10px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-card); color: var(--text-primary); font-size: 12px; cursor: pointer;">
              <option value="">-- Tampilkan Semua Kecamatan --</option>
              <option value="BABULU">Kec. Babulu</option>
              <option value="WARU">Kec. Waru</option>
              <option value="PENAJAM">Kec. Penajam</option>
              <option value="SEPAKU">Kec. Sepaku</option>
            </select>
          </div>

          <!-- TINGKAT WILAYAH -->
          <div class="form-group" style="margin-bottom: 10px;">
            <label style="font-size: 11px; font-weight: 600; margin-bottom: 4px; display: block; color: var(--text-secondary);">Tingkat Batas Wilayah</label>
            <div class="map-layer-selector">
              <button id="btnLayerDesa" class="map-layer-btn active" aria-pressed="true">Batas Desa</button>
              <button id="btnLayerSls" class="map-layer-btn" aria-pressed="false">Batas SLS</button>
            </div>
          </div>

          <!-- BASEMAP TYPE SELECTOR -->
          <div class="form-group">
            <label style="font-size: 11px; font-weight: 600; margin-bottom: 4px; display: block; color: var(--text-secondary);">Tipe Peta Dasar (Basemap)</label>
            <div class="map-layer-selector">
              <button id="btnBasemapDefault" class="map-layer-btn active">Vektor Standard</button>
              <button id="btnBasemapSatellite" class="map-layer-btn">Foto Satelit</button>
            </div>
          </div>
        </div>

        <!-- STATS CARD -->
        <div class="card map-card-stats" style="margin-bottom: 0;">
          <div class="card-header" style="margin-bottom: 8px; padding-bottom: 0;">
            <div class="card-title"><i class="bi bi-card-list"></i> Detail Wilayah Terpilih</div>
          </div>
          <div id="mapSummaryStats">
            <div style="font-size: 12px; color: var(--text-muted); text-align: center; padding: 24px 12px;">
              <i class="bi bi-geo-alt-fill" style="font-size: 28px; color: var(--accent-blue); display: block; margin-bottom: 8px; opacity: 0.7;"></i>
              Klik salah satu batas desa atau SLS pada peta untuk melihat rincian progres kinerja di sini.
            </div>
          </div>
        </div>

        <!-- LEGEND CARD -->
        <div class="card map-card-legend" style="margin-bottom: 0;">
          <div class="card-header" style="margin-bottom: 8px; padding-bottom: 0;">
            <div class="card-title"><i class="bi bi-info-circle"></i> Legenda Warna Capaian</div>
          </div>
          
          <div id="legendDesa">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">Persentase Realisasi FASIH Desa:</div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #10b981;"></div><span><strong>100%</strong> FASIH (Target Selesai)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #0284c7;"></div><span><strong>75% - 99%</strong> FASIH (Sangat Baik)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #eab308;"></div><span><strong>25% - 74%</strong> FASIH (Sedang)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #f97316;"></div><span><strong>1% - 24%</strong> FASIH (Awal Progres)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #ef4444;"></div><span><strong>0%</strong> FASIH (Belum Ada Progres)</span></div>
          </div>

          <div id="legendSls" style="display: none;">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">Status Target SLS:</div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #10b981;"></div><span>Target FASIH Tercapai (100%)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #ef4444;"></div><span>Target FASIH Belum Tercapai</span></div>
          </div>
        </div>

      </div>

      <!-- MAP CANVAS -->
      <div class="map-canvas-container">
        <div id="mapLoading" class="loading-overlay">
          <div class="spinner"></div>
          <div id="loadingStatusText" style="font-size: 13px; font-weight: 500;">Memuat Peta Spasial Penajam Paser Utara...</div>
        </div>
        <div id="map"></div>
      </div>

    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Initial setup
        const centerCoords = [-1.30, 116.65];
        const defaultZoom = 10;
        
        const map = L.map('map', {
          zoomControl: true,
          maxZoom: 18,
          minZoom: 9
        }).setView(centerCoords, defaultZoom);

        // Basemaps (CartoDB Light/Dark Vector + Esri Satellite)
        const lightBasemap = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO',
          subdomains: 'abcd'
        });

        const darkBasemap = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO',
          subdomains: 'abcd'
        });

        const satelliteBasemap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
          attribution: 'Tiles &copy; Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP'
        });

        let currentBasemapType = 'default'; // 'default' or 'satellite'

        function updateBasemap() {
          if (currentBasemapType === 'satellite') {
            if (map.hasLayer(lightBasemap)) map.removeLayer(lightBasemap);
            if (map.hasLayer(darkBasemap)) map.removeLayer(darkBasemap);
            satelliteBasemap.addTo(map);
          } else {
            if (map.hasLayer(satelliteBasemap)) map.removeLayer(satelliteBasemap);
            const isLight = document.body.classList.contains('light-mode');
            if (isLight) {
              if (map.hasLayer(darkBasemap)) map.removeLayer(darkBasemap);
              lightBasemap.addTo(map);
            } else {
              if (map.hasLayer(lightBasemap)) map.removeLayer(lightBasemap);
              darkBasemap.addTo(map);
            }
          }
        }
        updateBasemap();

        // Listen for theme toggle events
        window.addEventListener('themechange', () => {
          updateBasemap();
          if (desaLayer) desaLayer.setStyle(desaStyle);
          if (slsLayer) slsLayer.setStyle(slsStyle);
        });

        // Data holders
        let desaGeoJson = null;
        let slsGeoJson = null;
        let desaStats = [];
        let slsStats = [];
        
        let desaLayer = null;
        let slsLayer = null;
        let activeLayerName = 'desa'; // 'desa' or 'sls'
        let currentFilteredKec = '';

        // UI Selectors
        const loadingOverlay = document.getElementById('mapLoading');
        const loadingText = document.getElementById('loadingStatusText');
        const kecFilter = document.getElementById('kecFilter');
        const mapSearchInput = document.getElementById('mapSearchInput');
        const btnResetView = document.getElementById('btnResetView');
        const btnLayerDesa = document.getElementById('btnLayerDesa');
        const btnLayerSls = document.getElementById('btnLayerSls');
        const btnBasemapDefault = document.getElementById('btnBasemapDefault');
        const btnBasemapSatellite = document.getElementById('btnBasemapSatellite');
        const legendDesa = document.getElementById('legendDesa');
        const legendSls = document.getElementById('legendSls');
        const sidebarStats = document.getElementById('mapSummaryStats');
        const mapContainerWrap = document.getElementById('mapContainerWrap');
        const btnMobileMapTab = document.getElementById('btnMobileMapTab');
        const btnMobileInfoTab = document.getElementById('btnMobileInfoTab');

        // Mobile View Toggle Logic
        if (btnMobileMapTab && btnMobileInfoTab && mapContainerWrap) {
          btnMobileMapTab.addEventListener('click', () => {
            btnMobileInfoTab.classList.remove('active');
            btnMobileMapTab.classList.add('active');
            mapContainerWrap.classList.remove('show-info-mobile');
            mapContainerWrap.classList.add('show-map-mobile');
            map.invalidateSize();
            setTimeout(() => map.invalidateSize(), 150);
            setTimeout(() => map.invalidateSize(), 400);
          });

          btnMobileInfoTab.addEventListener('click', () => {
            btnMobileMapTab.classList.remove('active');
            btnMobileInfoTab.classList.add('active');
            mapContainerWrap.classList.remove('show-map-mobile');
            mapContainerWrap.classList.add('show-info-mobile');
          });
        }

        // Global resize and initial invalidate to ensure mobile map renders
        setTimeout(() => map.invalidateSize(), 200);
        setTimeout(() => map.invalidateSize(), 600);
        window.addEventListener('resize', () => map.invalidateSize());

        // Styles
        function getBorderColor() {
          if (currentBasemapType === 'satellite') return '#ffffff';
          return document.body.classList.contains('light-mode') ? '#ffffff' : '#1b1b24';
        }

        function getHoverBorderColor() {
          return 'var(--accent-cyan)';
        }

        // Color coding function for Desa
        function getDesaColor(iddesa) {
          const stat = desaStats.find(s => s.iddesa === iddesa);
          if (!stat) return '#94a3b8'; // gray for no data
          const pct = stat.target_fasih_total ? ((stat.submitted_total + stat.approved_total + stat.rejected_total) / stat.target_fasih_total) * 100 : 0;
          if (pct >= 100) return '#10b981'; // Green
          if (pct >= 75) return '#0284c7';  // Blue
          if (pct >= 25) return '#eab308';  // Yellow
          if (pct > 0) return '#f97316';    // Orange
          return '#ef4444';                 // Red
        }

        // Color coding function for SLS
        function getSlsColor(kode) {
          const stat = slsStats.find(s => s.kode === kode);
          if (!stat) return '#94a3b8'; // gray
          return stat.selesai === 1 ? '#10b981' : '#ef4444';
        }

        // Styles for layers
        function desaStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          return {
            fillColor: getDesaColor(feature.properties.iddesa),
            weight: 1.5,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.45 : 0.65) : 0.02
          };
        }

        function slsStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          return {
            fillColor: getSlsColor(feature.properties.kode),
            weight: 1.2,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.45 : 0.6) : 0.02
          };
        }

        // Highlight features on hover
        function highlightFeature(e) {
          const layer = e.target;
          layer.setStyle({
            weight: 3,
            color: getHoverBorderColor(),
            fillOpacity: 0.85
          });
          if (!L.Browser.ie && !L.Browser.opera && !L.Browser.edge) {
            layer.bringToFront();
          }
        }

        function resetHighlightDesa(e) {
          desaLayer.resetStyle(e.target);
        }

        function resetHighlightSls(e) {
          slsLayer.resetStyle(e.target);
        }

        // Top Statistics Calculator
        function updateTopStats(statsList) {
          if (!statsList || !statsList.length) return;
          let totalDesa = statsList.length;
          let count100 = 0;
          let countHigh = 0;
          let countLow = 0;

          statsList.forEach(s => {
            const totalFasih = s.target_fasih_total || 0;
            const realisasi = (s.submitted_total || 0) + (s.approved_total || 0) + (s.rejected_total || 0);
            const pct = totalFasih ? (realisasi / totalFasih) * 100 : 0;

            if (pct >= 100) count100++;
            else if (pct >= 25) countHigh++;
            else countLow++;
          });

          const statTotal = document.getElementById('statTotalDesa');
          const stat100 = document.getElementById('statDesa100');
          const statHigh = document.getElementById('statDesaHigh');
          const statLow = document.getElementById('statDesaLow');

          if (statTotal) statTotal.textContent = `${totalDesa} Desa`;
          if (stat100) stat100.textContent = `${count100} Desa`;
          if (statHigh) statHigh.textContent = `${countHigh} Desa`;
          if (statLow) statLow.textContent = `${countLow} Desa`;
        }

        // Fit map bounds to filtered subdistrict
        function fitBoundsToKecamatan(kecName) {
          if (!kecName) {
            map.setView(centerCoords, defaultZoom);
            return;
          }

          const bounds = L.latLngBounds();
          const targetLayer = activeLayerName === 'desa' ? desaLayer : slsLayer;
          
          if (targetLayer) {
            targetLayer.eachLayer(layer => {
              if (layer.feature.properties.nmkec === kecName) {
                if (layer.getBounds) {
                  bounds.extend(layer.getBounds());
                } else if (layer.getLatLng) {
                  bounds.extend(layer.getLatLng());
                }
              }
            });
            
            if (bounds.isValid()) {
              map.fitBounds(bounds, { padding: [30, 30] });
            }
          }
        }

        // Show details in Sidebar + Integrated Drilldown Links
        function showDesaDetails(properties) {
          const stat = desaStats.find(s => s.iddesa === properties.iddesa);
          const total = stat ? stat.total_subsls : 0;
          const selesai = stat ? stat.selesai : 0;
