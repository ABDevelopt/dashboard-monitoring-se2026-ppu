<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  .map-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .map-kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .map-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .map-kpi-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  /* Google Maps Style Floating Overlay Layout */
  .gmaps-container-wrap {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--header-height) - 30px);
    min-height: 580px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  .gmaps-container-wrap .map-canvas-container {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .gmaps-container-wrap #map {
    width: 100%;
    height: 100%;
    min-height: 100%;
    border-radius: 0;
    border: none;
    background: var(--bg-secondary);
    z-index: 10;
  }

  /* Floating Search & Filter Bar (Top Left) */
  .gmaps-floating-search-panel {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1000;
    width: 440px;
    max-width: calc(100% - 28px);
    background: rgba(var(--bg-card-rgb, 24, 24, 30), 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 10px 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  body.light-mode .gmaps-floating-search-panel {
    background: rgba(255, 255, 255, 0.92);
  }

  .gmaps-search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 99px;
    padding: 4px 12px;
  }

  .gmaps-search-box .search-icon {
    color: var(--text-muted);
    font-size: 13px;
  }

  .gmaps-search-box input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 12px;
  }

  .gmaps-icon-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
  }

  .gmaps-icon-btn:hover {
    color: var(--accent-blue);
  }

  .gmaps-filter-row {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  .gmaps-filter-row::-webkit-scrollbar {
    display: none;
  }

  .gmaps-select-pill {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: 11px;
    border-radius: 99px;
    padding: 4px 10px;
    cursor: pointer;
  }

  .gmaps-pill-group {
    display: inline-flex;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 99px;
    padding: 2px;
  }

  .gmaps-pill-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 10.5px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 99px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .gmaps-pill-btn.active {
    background: var(--accent-blue);
    color: white;
    font-weight: 600;
  }

  /* Floating KPI Bar (Top Right) */
  .gmaps-floating-kpi-bar {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .gmaps-kpi-pill {
    background: rgba(var(--bg-card-rgb, 24, 24, 30), 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 99px;
    padding: 5px 12px;
    font-size: 11px;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
  }

  body.light-mode .gmaps-kpi-pill {
    background: rgba(255, 255, 255, 0.92);
  }

  /* Floating Info & Legend Drawer Card (Bottom Left) */
  .gmaps-floating-drawer-card {
    position: absolute;
    bottom: 20px;
    left: 14px;
    z-index: 1000;
    width: 360px;
    max-width: calc(100% - 28px);
    background: rgba(var(--bg-card-rgb, 24, 24, 30), 0.90);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    transition: max-height 0.3s ease, transform 0.3s ease;
  }

  body.light-mode .gmaps-floating-drawer-card {
    background: rgba(255, 255, 255, 0.94);
  }

  .gmaps-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
  }

  .gmaps-drawer-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .gmaps-tab-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .gmaps-tab-btn.active {
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent-blue);
  }

  .gmaps-collapse-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gmaps-drawer-content {
    padding: 12px;
    max-height: 280px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .gmaps-floating-drawer-card.collapsed .gmaps-drawer-content {
    display: none;
  }

  .map-legend-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .map-legend-color {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(21, 21, 27, 0.75);
    backdrop-filter: blur(4px);
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius);
    transition: opacity 0.3s ease;
    pointer-events: none;
    opacity: 1;
    color: var(--text-primary);
  }

  body.light-mode .loading-overlay {
    background: rgba(245, 239, 230, 0.75);
  }

  .spinner {
    border: 4px solid rgba(255,255,255,0.1);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border-left-color: var(--accent-blue);
    animation: spin 1s linear infinite;
    margin-bottom: 12px;
  }

  body.light-mode .spinner {
    border-color: rgba(60, 51, 46, 0.1);
    border-left-color: var(--accent-blue);
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .info-table {
    width: 100%;
    margin-top: 8px;
    border-collapse: collapse;
    font-size: 12px;
  }

  .info-table td {
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .info-table td.label {
    font-weight: 500;
    color: var(--text-primary);
    width: 45%;
  }

  .info-table td.value {
    text-align: right;
    font-weight: 600;
  }

  .leaflet-popup-content-wrapper {
    background: var(--bg-card) !important;
    color: var(--text-primary) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius) !important;
    font-family: 'Inter', system-ui, sans-serif !important;
    box-shadow: var(--shadow-lg) !important;
    padding: 4px !important;
  }

  .leaflet-popup-tip {
    background: var(--bg-card) !important;
    border-left: 1px solid var(--border) !important;
    border-bottom: 1px solid var(--border) !important;
  }

  .leaflet-container a.leaflet-popup-close-button {
    color: var(--text-secondary) !important;
    padding: 6px !important;
  }

  .leaflet-popup-content-wrapper a.btn-primary,
  .leaflet-popup-content-wrapper .btn-primary {
    color: #ffffff !important;
    background: var(--accent-blue) !important;
    font-weight: 600 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .leaflet-popup-content-wrapper a.btn-primary:hover {
    background: #ea580c !important;
    color: #ffffff !important;
  }

  .leaflet-bar {
    border: 1px solid var(--border) !important;
    box-shadow: var(--shadow) !important;
    border-radius: var(--radius-sm) !important;
    overflow: hidden;
  }

  .leaflet-bar a {
    background-color: var(--bg-card) !important;
    color: var(--text-primary) !important;
    border-bottom: 1px solid var(--border) !important;
  }

  .leaflet-bar a:hover {
    background-color: var(--bg-card-hover) !important;
    color: var(--accent-blue) !important;
  }

  @media (max-width: 768px) {
    .gmaps-container-wrap {
      height: calc(100vh - var(--header-height) - 80px);
      min-height: 480px;
    }
    .gmaps-floating-search-panel {
      width: calc(100% - 24px);
      left: 12px;
      top: 12px;
    }
    .gmaps-floating-kpi-bar {
      top: auto;
      bottom: 210px;
      right: 12px;
      left: 12px;
      justify-content: space-between;
    }
    .gmaps-floating-drawer-card {
      left: 12px;
      bottom: 12px;
      width: calc(100% - 24px);
    }
  }
</style>

<div class="fade-in">
  <div id="gmapsWrapper" class="gmaps-container-wrap">
    
    <!-- 1. FULLSCREEN MAP CANVAS (PETA UTAMA SEBAGAI FOKUS LENGKAP) -->
    <div class="map-canvas-container">
      <div id="mapLoading" class="loading-overlay">
        <div class="spinner"></div>
        <div id="loadingStatusText" style="font-size: 13px; font-weight: 500;">Memuat Peta Spasial Penajam Paser Utara...</div>
      </div>
      <div id="map"></div>
    </div>

    <!-- 2. FLOATING TOP SEARCH & FILTER BAR (GOOGLE MAPS STYLE SEARCH PILL) -->
    <div class="gmaps-floating-search-panel">
      <div class="gmaps-search-box">
        <i class="bi bi-search search-icon"></i>
        <input type="text" id="mapSearchInput" placeholder="Cari nama desa atau SLS..." />
        <button id="btnResetView" class="gmaps-icon-btn" title="Reset Pandangan Peta">
          <i class="bi bi-arrow-counterclockwise"></i>
        </button>
      </div>
      
      <div class="gmaps-filter-row">
        <select id="kecFilter" class="gmaps-select-pill">
          <option value="">-- Semua Kecamatan --</option>
          <option value="BABULU">Kec. Babulu</option>
          <option value="WARU">Kec. Waru</option>
          <option value="PENAJAM">Kec. Penajam</option>
          <option value="SEPAKU">Kec. Sepaku</option>
        </select>
        
        <div class="gmaps-pill-group">
          <button id="btnLayerDesa" class="gmaps-pill-btn active"><i class="bi bi-geo"></i> Desa</button>
          <button id="btnLayerSls" class="gmaps-pill-btn"><i class="bi bi-pin-map"></i> SLS</button>
        </div>

        <div class="gmaps-pill-group">
          <button id="btnBasemapDefault" class="gmaps-pill-btn active"><i class="bi bi-map"></i> Vektor</button>
          <button id="btnBasemapSatellite" class="gmaps-pill-btn"><i class="bi bi-globe-americas"></i> Satelit</button>
        </div>
      </div>
    </div>

    <!-- 3. FLOATING KPI OVERLAY BAR (TOP RIGHT) -->
    <div class="gmaps-floating-kpi-bar">
      <div class="gmaps-kpi-pill">
        <i class="bi bi-map-fill" style="color: var(--accent-blue);"></i>
        <span class="label">Total:</span>
        <strong id="statTotalDesa">-- Desa</strong>
      </div>
      <div class="gmaps-kpi-pill">
        <i class="bi bi-check-circle-fill" style="color: var(--accent-green);"></i>
        <span class="label">100%:</span>
        <strong id="statDesa100" style="color: var(--accent-green);">-- Desa</strong>
      </div>
      <div class="gmaps-kpi-pill">
        <i class="bi bi-hourglass-split" style="color: var(--accent-yellow);"></i>
        <span class="label">25-99%:</span>
        <strong id="statDesaHigh" style="color: var(--accent-yellow);">-- Desa</strong>
      </div>
      <div class="gmaps-kpi-pill">
        <i class="bi bi-exclamation-triangle-fill" style="color: var(--accent-red);"></i>
        <span class="label">&lt;25%:</span>
        <strong id="statDesaLow" style="color: var(--accent-red);">-- Desa</strong>
      </div>
    </div>

    <!-- 4. FLOATING SIDE CARD DRAWER (LEFT SIDE) FOR STATS & LEGEND -->
    <div class="gmaps-floating-drawer-card" id="gmapsDrawerCard">
      <div class="gmaps-drawer-header">
        <div class="gmaps-drawer-tabs">
          <button type="button" class="gmaps-tab-btn active" id="tabBtnStats" onclick="switchGmapsTab('stats')">
            <i class="bi bi-card-list"></i> Detail Wilayah
          </button>
          <button type="button" class="gmaps-tab-btn" id="tabBtnLegend" onclick="switchGmapsTab('legend')">
            <i class="bi bi-palette"></i> Legenda
          </button>
        </div>
        <button type="button" class="gmaps-collapse-btn" onclick="toggleGmapsDrawer()" title="Sembunyikan / Tampilkan Panel">
          <i class="bi bi-chevron-down" id="drawerCollapseIcon"></i>
        </button>
      </div>

      <div class="gmaps-drawer-content" id="gmapsDrawerContent">
        <!-- TAB 1: STATS -->
        <div id="gmapsStatsTabContent">
          <div id="mapSummaryStats">
            <div style="font-size: 12px; color: var(--text-muted); text-align: center; padding: 20px 10px;">
              <i class="bi bi-geo-alt-fill" style="font-size: 26px; color: var(--accent-blue); display: block; margin-bottom: 6px; opacity: 0.8;"></i>
              Klik salah satu wilayah pada peta untuk melihat rincian progres di sini.
            </div>
          </div>
        </div>

        <!-- TAB 2: LEGEND -->
        <div id="gmapsLegendTabContent" style="display: none;">
          <div id="legendDesa">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">Persentase Realisasi FASIH Desa:</div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #10b981;"></div><span><strong>100%</strong> FASIH (Target Selesai)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #0284c7;"></div><span><strong>75% - 99%</strong> FASIH (Sangat Baik)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #eab308;"></div><span><strong>25% - 74%</strong> FASIH (Sedang)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #f97316;"></div><span><strong>1% - 24%</strong> FASIH (Awal Progres)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #ef4444;"></div><span><strong>0%</strong> FASIH (Belum Ada Progres)</span></div>
          </div>

          <div id="legendSls" style="display: none;">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">Status Target SLS:</div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #10b981;"></div><span>Target FASIH Tercapai (100%)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #ef4444;"></div><span>Target FASIH Belum Tercapai</span></div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
      window.switchGmapsTab = function(tabName) {
        const statsTab = document.getElementById('gmapsStatsTabContent');
        const legendTab = document.getElementById('gmapsLegendTabContent');
        const btnStats = document.getElementById('tabBtnStats');
        const btnLegend = document.getElementById('tabBtnLegend');
        
        if (tabName === 'stats') {
          if (statsTab) statsTab.style.display = 'block';
          if (legendTab) legendTab.style.display = 'none';
          if (btnStats) btnStats.classList.add('active');
          if (btnLegend) btnLegend.classList.remove('active');
        } else {
          if (statsTab) statsTab.style.display = 'none';
          if (legendTab) legendTab.style.display = 'block';
          if (btnStats) btnStats.classList.remove('active');
          if (btnLegend) btnLegend.classList.add('active');
        }
      };

      window.toggleGmapsDrawer = function() {
        const card = document.getElementById('gmapsDrawerCard');
        const icon = document.getElementById('drawerCollapseIcon');
        if (!card) return;
        card.classList.toggle('collapsed');
        if (icon) {
          if (card.classList.contains('collapsed')) {
            icon.className = 'bi bi-chevron-up';
          } else {
            icon.className = 'bi bi-chevron-down';
          }
        }
      };

      document.addEventListener('DOMContentLoaded', () => {
        // Initial setup
        const centerCoords = [-1.30, 116.65];
        const defaultZoom = 10;
        
        const map = L.map('map', {
          zoomControl: true,
          maxZoom: 18,
          minZoom: 9
        }).setView(centerCoords, defaultZoom);

        // Basemaps (CartoDB Light/Dark Vector + Esri Satellite)
        const lightBasemap = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO',
          subdomains: 'abcd'
        });

        const darkBasemap = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO',
          subdomains: 'abcd'
        });

        const satelliteBasemap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
          attribution: 'Tiles &copy; Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP'
        });

        let currentBasemapType = 'default'; // 'default' or 'satellite'

        function updateBasemap() {
          if (currentBasemapType === 'satellite') {
            if (map.hasLayer(lightBasemap)) map.removeLayer(lightBasemap);
            if (map.hasLayer(darkBasemap)) map.removeLayer(darkBasemap);
            satelliteBasemap.addTo(map);
          } else {
            if (map.hasLayer(satelliteBasemap)) map.removeLayer(satelliteBasemap);
            const isLight = document.body.classList.contains('light-mode');
            if (isLight) {
              if (map.hasLayer(darkBasemap)) map.removeLayer(darkBasemap);
              lightBasemap.addTo(map);
            } else {
              if (map.hasLayer(lightBasemap)) map.removeLayer(lightBasemap);
              darkBasemap.addTo(map);
            }
          }
        }
        updateBasemap();

        // Listen for theme toggle events
        window.addEventListener('themechange', () => {
          updateBasemap();
          if (desaLayer) desaLayer.setStyle(desaStyle);
          if (slsLayer) slsLayer.setStyle(slsStyle);
        });

        // Data holders
        let desaGeoJson = null;
        let slsGeoJson = null;
        let desaStats = [];
        let slsStats = [];
        
        let desaLayer = null;
        let slsLayer = null;
        let activeLayerName = 'desa'; // 'desa' or 'sls'
        let currentFilteredKec = '';

        // UI Selectors
        const loadingOverlay = document.getElementById('mapLoading');
        const loadingText = document.getElementById('loadingStatusText');
        const kecFilter = document.getElementById('kecFilter');
        const mapSearchInput = document.getElementById('mapSearchInput');
        const btnResetView = document.getElementById('btnResetView');
        const btnLayerDesa = document.getElementById('btnLayerDesa');
        const btnLayerSls = document.getElementById('btnLayerSls');
        const btnBasemapDefault = document.getElementById('btnBasemapDefault');
        const btnBasemapSatellite = document.getElementById('btnBasemapSatellite');
        const legendDesa = document.getElementById('legendDesa');
        const legendSls = document.getElementById('legendSls');
        const sidebarStats = document.getElementById('mapSummaryStats');
        const mapContainerWrap = document.getElementById('mapContainerWrap');
        const btnMobileMapTab = document.getElementById('btnMobileMapTab');
        const btnMobileInfoTab = document.getElementById('btnMobileInfoTab');

        // Mobile View Toggle Logic
        if (btnMobileMapTab && btnMobileInfoTab && mapContainerWrap) {
          btnMobileMapTab.addEventListener('click', () => {
            btnMobileInfoTab.classList.remove('active');
            btnMobileMapTab.classList.add('active');
            mapContainerWrap.classList.remove('show-info-mobile');
            mapContainerWrap.classList.add('show-map-mobile');
            map.invalidateSize();
            setTimeout(() => map.invalidateSize(), 150);
            setTimeout(() => map.invalidateSize(), 400);
          });

          btnMobileInfoTab.addEventListener('click', () => {
            btnMobileMapTab.classList.remove('active');
            btnMobileInfoTab.classList.add('active');
            mapContainerWrap.classList.remove('show-map-mobile');
            mapContainerWrap.classList.add('show-info-mobile');
          });
        }

        // Global resize and initial invalidate to ensure mobile map renders
        setTimeout(() => map.invalidateSize(), 200);
        setTimeout(() => map.invalidateSize(), 600);
        window.addEventListener('resize', () => map.invalidateSize());

        // Styles
        function getBorderColor() {
          if (currentBasemapType === 'satellite') return '#ffffff';
          return document.body.classList.contains('light-mode') ? '#ffffff' : '#1b1b24';
        }

        function getHoverBorderColor() {
          return 'var(--accent-cyan)';
        }

        // Color coding function for Desa
        function getDesaColor(iddesa) {
          const stat = desaStats.find(s => s.iddesa === iddesa);
          if (!stat) return '#94a3b8'; // gray for no data
          const pct = stat.target_fasih_total ? ((stat.submitted_total + stat.approved_total + stat.rejected_total) / stat.target_fasih_total) * 100 : 0;
          if (pct >= 100) return '#10b981'; // Green
          if (pct >= 75) return '#0284c7';  // Blue
          if (pct >= 25) return '#eab308';  // Yellow
          if (pct > 0) return '#f97316';    // Orange
          return '#ef4444';                 // Red
        }

        // Color coding function for SLS
        function getSlsColor(kode) {
          const stat = slsStats.find(s => s.kode === kode);
          if (!stat) return '#94a3b8'; // gray
          return stat.selesai === 1 ? '#10b981' : '#ef4444';
        }

        // Styles for layers
        function desaStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          return {
            fillColor: getDesaColor(feature.properties.iddesa),
            weight: 1.5,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.45 : 0.65) : 0.02
          };
        }

        function slsStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          return {
            fillColor: getSlsColor(feature.properties.kode),
            weight: 1.2,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.45 : 0.6) : 0.02
          };
        }

        // Highlight features on hover
        function highlightFeature(e) {
          const layer = e.target;
          layer.setStyle({
            weight: 3,
            color: getHoverBorderColor(),
            fillOpacity: 0.85
          });
          if (!L.Browser.ie && !L.Browser.opera && !L.Browser.edge) {
            layer.bringToFront();
          }
        }

        function resetHighlightDesa(e) {
          desaLayer.resetStyle(e.target);
        }

        function resetHighlightSls(e) {
          slsLayer.resetStyle(e.target);
        }

        // Top Statistics Calculator
        function updateTopStats(statsList) {
          if (!statsList || !statsList.length) return;
          let totalDesa = statsList.length;
          let count100 = 0;
          let countHigh = 0;
          let countLow = 0;

          statsList.forEach(s => {
            const totalFasih = s.target_fasih_total || 0;
            const realisasi = (s.submitted_total || 0) + (s.approved_total || 0) + (s.rejected_total || 0);
            const pct = totalFasih ? (realisasi / totalFasih) * 100 : 0;

            if (pct >= 100) count100++;
            else if (pct >= 25) countHigh++;
            else countLow++;
          });

          const statTotal = document.getElementById('statTotalDesa');
          const stat100 = document.getElementById('statDesa100');
          const statHigh = document.getElementById('statDesaHigh');
          const statLow = document.getElementById('statDesaLow');

          if (statTotal) statTotal.textContent = `${totalDesa} Desa`;
          if (stat100) stat100.textContent = `${count100} Desa`;
          if (statHigh) statHigh.textContent = `${countHigh} Desa`;
          if (statLow) statLow.textContent = `${countLow} Desa`;
        }

        // Fit map bounds to filtered subdistrict
        function fitBoundsToKecamatan(kecName) {
          if (!kecName) {
            map.setView(centerCoords, defaultZoom);
            return;
          }

          const bounds = L.latLngBounds();
          const targetLayer = activeLayerName === 'desa' ? desaLayer : slsLayer;
          
          if (targetLayer) {
            targetLayer.eachLayer(layer => {
              if (layer.feature.properties.nmkec === kecName) {
                if (layer.getBounds) {
                  bounds.extend(layer.getBounds());
                } else if (layer.getLatLng) {
                  bounds.extend(layer.getLatLng());
                }
              }
            });
            
            if (bounds.isValid()) {
              map.fitBounds(bounds, { padding: [30, 30] });
            }
          }
        }

        // Show details in Sidebar + Integrated Drilldown Links
        function showDesaDetails(properties) {
          const stat = desaStats.find(s => s.iddesa === properties.iddesa);
          const total = stat ? stat.total_subsls : 0;
          const selesai = stat ? stat.selesai : 0;
          const totalMuatan = stat ? stat.total_muatan : (properties.total_muatan || 0);
          const usaha = stat ? stat.usaha_total : 0;
          const pct = totalMuatan ? ((usaha / totalMuatan) * 100).toFixed(2) : '0.00';
          const keluarga = stat ? stat.keluarga_total : 0;

          // FASIH Capaian
          const targetFasih = stat ? stat.target_fasih_total : 0;
