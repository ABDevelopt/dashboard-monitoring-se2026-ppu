            <button id="btnLayerDesa" class="gmaps-pill-btn active" title="Tingkat Desa / Kelurahan" type="button" style="flex: 1; justify-content: center;"><i class="bi bi-geo"></i> Desa</button>
            <button id="btnLayerSls" class="gmaps-pill-btn" title="Tingkat SubSLS / RT" type="button" style="flex: 1; justify-content: center;"><i class="bi bi-pin-map"></i> SLS</button>
          </div>

          <div class="gmaps-pill-group" style="display: flex; width: 100%;">
            <button id="btnMetricFasih" class="gmaps-pill-btn active" title="Pewarnaan Capaian FASIH" type="button" style="flex: 1; justify-content: center;"><i class="bi bi-phone"></i> FASIH</button>
            <button id="btnMetricMuatan" class="gmaps-pill-btn" title="Pewarnaan Capaian Muatan" type="button" style="flex: 1; justify-content: center;"><i class="bi bi-pie-chart"></i> Muatan</button>
