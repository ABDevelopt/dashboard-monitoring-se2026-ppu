    <!-- 3. FLOATING TOP RIGHT KPI BAR (COMMAND CENTER STATUS CAPSULE) -->
    <div class="gmaps-floating-kpi-bar">
      <button type="button" class="gmaps-kpi-pill active-filter" id="kpiFilterAll" data-status="" title="Tampilkan Semua SLS">
