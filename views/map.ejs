            </div>
            <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 10px;">Kecamatan ${properties.nmkec}</div>
            
            <!-- Progress Bar Vis -->
            <div style="background: var(--bg-secondary); padding: 10px; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 10px;">
              <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 600; margin-bottom: 4px;">
                <span>Progres Realisasi FASIH</span>
                <span style="color: ${fasihColor};">${fasihPct}%</span>
              </div>
              <div class="progress-track-sm" style="height: 8px;">
                <div class="progress-bar ${fasihPct >= 100 ? 'green' : (fasihPct < 25 ? 'red' : 'purple')}" data-width="${fasihPct}" style="width: ${fasihPct}%; height: 100%; border-radius: 99px;"></div>
              </div>
              <div style="font-size: 10px; color: var(--text-muted); margin-top: 4px; text-align: right;">
                ${totalRealisasiFasih.toLocaleString('id-ID')} / ${targetFasih.toLocaleString('id-ID')} Dokumen
              </div>
            </div>

            <div class="map-card-stat">
              <span class="map-card-label">Jumlah SubSLS</span>
              <span class="map-card-value">${total} SLS</span>
            </div>
            <div class="map-card-stat">
              <span class="map-card-label">Target FASIH Selesai</span>
