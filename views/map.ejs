        // Initialize Map GeoJSON layers
        function setupKecLayer() {
          if (!kecGeoJson) return;
          kecLayer = L.geoJSON(kecGeoJson, {
            style: kecStyle,
            onEachFeature: (feature, layer) => {
              const stat = kecStats.find(k => k.kecamatan && k.kecamatan.toUpperCase() === feature.properties.nmkec.toUpperCase());
              const fasihPct = stat ? parseFloat(stat.fasih_pct_str || 0) : 0;
              const totalFasih = stat ? stat.target_fasih_total : 0;
              const realisasiFasih = stat ? ((stat.submitted_total || 0) + (stat.approved_total || 0) + (stat.rejected_total || 0)) : 0;
              const fasihColorClass = fasihPct >= 100 ? 'status-green' : (fasihPct >= 75 ? 'status-blue' : (fasihPct >= 25 ? 'status-yellow' : (fasihPct > 0 ? 'status-orange' : 'status-red')));

              // Bind Permanent On-Map Badge
              const labelHtml = `
                <div class="map-label-badge kec-label-badge ${showProgressLabels ? '' : 'd-none'}">
                  <span>${feature.properties.nmkec}</span>
                  <strong class="${fasihColorClass}">${fasihPct.toFixed(1)}%</strong>
                </div>
              `;
              layer.bindTooltip(labelHtml, {
                permanent: true,
                direction: 'center',
                className: 'map-polygon-label-tooltip'
              });

              layer.on({
                mouseover: highlightFeature,
                mouseout: resetHighlightKec,
                click: (e) => {
                  showKecDetails(feature.properties.nmkec);
                  
                  const popupHtml = `
                    <div style="font-family: 'Inter', sans-serif; min-width: 200px; padding: 2px;">
                      <strong style="font-size: 13.5px; color: var(--accent-blue);"><i class="bi bi-diagram-3-fill"></i> Kec. ${feature.properties.nmkec}</strong><br>
                      <span style="font-size: 11px; color: var(--text-secondary);">Kabupaten Penajam Paser Utara</span>
                      <table class="info-table">
                        <tr><td class="label">Progres FASIH</td><td class="value" style="color: ${fasihPct >= 100 ? 'var(--accent-green)' : 'var(--accent-blue)'};">${fasihPct}%</td></tr>
                        <tr><td class="label">Realisasi Dok.</td><td class="value">${realisasiFasih.toLocaleString('id-ID')} / ${totalFasih.toLocaleString('id-ID')}</td></tr>
                        <tr><td class="label">Total SLS</td><td class="value">${stat ? stat.total_subsls : 0} SLS</td></tr>
                      </table>
                      <div style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
                        <a href="<%= navPrefix %>/kecamatan?kec=${encodeURIComponent(feature.properties.nmkec)}" class="btn btn-primary btn-xs" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 4px 8px; font-size: 10px; text-decoration: none;">
                          <i class="bi bi-diagram-3"></i> Drilldown Kec. ${feature.properties.nmkec}
                        </a>
                      </div>
                    </div>
                  `;
                  layer.bindPopup(popupHtml).openPopup(e && e.latlng ? e.latlng : undefined);
                }
              });
            }
          });
        }

        function setupDesaLayer() {
          if (!desaGeoJson) return;
          desaLayer = L.geoJSON(desaGeoJson, {
            style: desaStyle,
            onEachFeature: (feature, layer) => {
              const stat = desaStats.find(s => s.iddesa === feature.properties.iddesa);
              const total = stat ? stat.total_subsls : 0;
              const selesai = stat ? stat.selesai : 0;
              const targetFasih = stat ? stat.target_fasih_total : 0;
              const submitted = stat ? stat.submitted_total : 0;
              const approved = stat ? stat.approved_total : 0;
              const rejected = stat ? stat.rejected_total : 0;
              const totalRealisasiFasih = submitted + approved + rejected;
              const fasihPct = targetFasih ? Math.min(parseFloat(((totalRealisasiFasih / targetFasih) * 100).toFixed(1)), 100) : 0;
              const totalMuatan = stat ? stat.total_muatan : 0;
              const usaha = stat ? stat.usaha_total : 0;
              const pct = totalMuatan ? ((usaha / totalMuatan) * 100).toFixed(1) : '0.0';
              const fasihColorClass = fasihPct >= 100 ? 'status-green' : (fasihPct >= 75 ? 'status-blue' : (fasihPct >= 25 ? 'status-yellow' : (fasihPct > 0 ? 'status-orange' : 'status-red')));

              // Bind Permanent On-Map Badge
              const labelHtml = `
                <div class="map-label-badge desa-label-badge ${showProgressLabels ? '' : 'd-none'}">
                  <span>${feature.properties.nmdesa}</span>
                  <strong class="${fasihColorClass}">${fasihPct.toFixed(1)}%</strong>
                </div>
              `;
              layer.bindTooltip(labelHtml, {
                permanent: true,
                direction: 'center',
                className: 'map-polygon-label-tooltip'
              });

              layer.on({
                mouseover: highlightFeature,
                mouseout: resetHighlightDesa,
                click: (e) => {
                  showDesaDetails(feature.properties);
                  
                  const popupHtml = `
                    <div style="font-family: 'Inter', sans-serif; min-width: 190px; padding: 2px;">
                      <strong style="font-size: 13px; color: var(--text-primary);">Desa ${feature.properties.nmdesa}</strong><br>
                      <span style="font-size: 11px; color: var(--text-secondary);">Kec. ${feature.properties.nmkec}</span>
                      <table class="info-table">
                        <tr><td class="label">SLS Selesai</td><td class="value">${selesai} / ${total} SLS</td></tr>
                        <tr><td class="label">Progres FASIH</td><td class="value" style="color: ${fasihPct >= 100 ? 'var(--accent-green)' : 'var(--accent-blue)'};">${fasihPct}%</td></tr>
                        <tr class="muatan-col"><td class="label">Progres Muatan</td><td class="value">${pct}%</td></tr>
                      </table>
                      <div style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
                        <a href="<%= navPrefix %>/subsls?kec=${encodeURIComponent(feature.properties.nmkec)}&desa=${encodeURIComponent(feature.properties.nmdesa)}" class="btn btn-primary btn-xs" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 4px 8px; font-size: 10px; text-decoration: none;">
                          <i class="bi bi-arrow-right-circle"></i> Buka Drilldown Wilayah
                        </a>
                      </div>
                    </div>
                  `;
                  layer.bindPopup(popupHtml).openPopup(e && e.latlng ? e.latlng : undefined);
                }
              });
            }
          });
        }

        function setupSlsLayer() {
          if (!slsGeoJson) return;
          slsLayer = L.geoJSON(slsGeoJson, {
            style: slsStyle,
            onEachFeature: (feature, layer) => {
              layer.on({
                mouseover: highlightFeature,
                mouseout: resetHighlightSls,
                click: (e) => {
                  showSlsDetails(feature.properties);
                  
                  const stat = slsStats.find(s => s.kode === feature.properties.kode);
                  const status = stat && stat.selesai === 1 ? 'Selesai' : 'Belum Selesai';
                  const targetFasih = stat ? stat.target_fasih : 0;
                  const submitted = stat ? stat.submitted_by_pcl : 0;
                  const approved = stat ? stat.approved : 0;
                  const rejected = stat ? stat.rejected : 0;
                  const realisasiFasih = submitted + approved + rejected;
                  const fasihPct = targetFasih ? Math.min(parseFloat(((realisasiFasih / targetFasih) * 100).toFixed(2)), 100) : 0;
                  
                  const popupHtml = `
                    <div style="font-family: 'Inter', sans-serif; min-width: 210px; padding: 2px;">
                      <strong style="font-size: 13px; color: var(--text-primary);">${feature.properties.nmsls}</strong><br>
                      <span style="font-size: 11px; color: var(--text-secondary);">${feature.properties.nmdesa}, ${feature.properties.nmkec}</span>
                      
                      <!-- Mini Progress Bar inside Popup -->
                      <div style="margin-top: 6px; margin-bottom: 6px; background: var(--bg-secondary); padding: 6px 8px; border-radius: 6px; border: 1px solid var(--border);">
                        <div style="display: flex; justify-content: space-between; font-size: 10px; margin-bottom: 3px;">
                          <span style="font-weight: 600;">Progres FASIH</span>
                          <span style="font-weight: 700; color: ${fasihPct >= 100 ? 'var(--accent-green)' : (fasihPct < 40 ? 'var(--accent-red)' : 'var(--accent-purple)')}">${fasihPct}%</span>
                        </div>
                        <div style="height: 5px; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden; margin-bottom: 4px;">
                          <div class="progress-bar ${fasihPct >= 100 ? 'green' : (fasihPct < 40 ? 'red' : 'purple')}" style="width: ${fasihPct}%; height: 100%; border-radius: 99px;"></div>
                        </div>
                        <div style="font-size: 9.5px; color: var(--text-muted); display: flex; justify-content: space-between;">
                          <span>Realisasi: ${realisasiFasih}</span>
                          <span>Target: ${targetFasih} Dok</span>
                        </div>
                      </div>

                      <table class="info-table">
                        <tr><td class="label">PCL</td><td class="value">${stat ? stat.pcl : '-'}</td></tr>
                        <tr><td class="label">Status Target</td><td class="value" style="color: ${status === 'Selesai' ? 'var(--accent-green)' : 'var(--accent-red)'}">${status}</td></tr>
                        <tr class="muatan-col"><td class="label">Usaha Terdata</td><td class="value">${stat ? stat.usaha_total : 0}</td></tr>
                      </table>
                      <div style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
                        <a href="<%= navPrefix %>/subsls?search=${encodeURIComponent(feature.properties.kode)}" class="btn btn-primary btn-xs" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 4px 8px; font-size: 10px; text-decoration: none;">
                          <i class="bi bi-arrow-right-circle"></i> Detail SubSLS (${feature.properties.kode})
                        </a>
                      </div>
                    </div>
                  `;
                  layer.bindPopup(popupHtml).openPopup(e && e.latlng ? e.latlng : undefined);
                }
              });
            }
          });
        }

        // Asynchronous bootstrap sequence
        async function bootstrap() {
          try {
            // Immediately render tile layer & recalculate canvas size
            updateBasemap();
            invalidateMapSize();

            // Step 1: load real-time stats, Desa geojson, and Kecamatan geojson in parallel
            const [statsRes, desaGeoRes, kecGeoRes] = await Promise.all([
              fetch('<%= typeof navPrefix !== "undefined" ? navPrefix : "" %>/api/map-stats'),
              fetch('/data/desa_boundaries.geojson'),
              fetch('/data/kecamatan_boundaries.geojson')
            ]);
            
            const stats = await statsRes.json();
            kecStats = stats.kecStats || [];
            desaStats = stats.desaStats || [];
            slsStats = stats.slsStats || [];
            desaGeoJson = await desaGeoRes.json();
            kecGeoJson = await kecGeoRes.json();

            // Update top KPI cards
            updateTopStats(desaStats);

            // Setup boundary mapping layers
            setupKecLayer();
            setupDesaLayer();

            if (activeLayerName === 'kec' && kecLayer) {
              kecLayer.addTo(map);
            } else if (desaLayer) {
              desaLayer.addTo(map);
            }

            // Position tile layer at back & recalculate map bounds
            updateBasemap();
            invalidateMapSize();

            // Hide initial loading screen
            if (loadingOverlay) {
              loadingOverlay.style.opacity = '0';
              setTimeout(() => { loadingOverlay.style.display = 'none'; }, 300);
            }

            // Lazy load high-detail SLS boundaries in background
            lazyLoadSlsGeoJSON();

          } catch (err) {
            console.error('Error bootstrapping map:', err);
            if (loadingOverlay) {
              loadingOverlay.style.opacity = '0';
              setTimeout(() => { loadingOverlay.style.display = 'none'; }, 300);
            }
            if (loadingText) {
              loadingText.innerHTML = '<span style="color: var(--accent-red);"><i class="bi bi-exclamation-triangle"></i> Gagal Memuat Data Spasial. Coba refresh halaman.</span>';
            }
          }
        }

        async function lazyLoadSlsGeoJSON() {
          try {
            const res = await fetch('/data/sls_boundaries.geojson');
            slsGeoJson = await res.json();
            setupSlsLayer();
          } catch (err) {
            console.error('Error lazy loading SLS geojson:', err);
          }
        }

        window.focusSubSlsOnMap = function(kode) {
          if (!slsGeoJson) {
            alert('Data peta SubSLS sedang dimuat. Harap tunggu sebentar...');
            return;
          }
          switchToSlsLayer();
          let targetLayer = null;
          if (slsLayer) {
            slsLayer.eachLayer(layer => {
              if (layer.feature && layer.feature.properties && layer.feature.properties.kode === kode) {
                targetLayer = layer;
              }
            });
          }
          if (targetLayer) {
            const bounds = targetLayer.getBounds ? targetLayer.getBounds() : null;
            if (bounds) map.fitBounds(bounds, { padding: [50, 50] });
            else if (targetLayer.getLatLng) map.setView(targetLayer.getLatLng(), 16);
            showSlsDetails(targetLayer.feature.properties);
            targetLayer.fire('click');
          }
        };

        window.focusDesaOnMap = function(iddesa) {
          switchToDesaLayer();
          let targetLayer = null;
          if (desaLayer) {
            desaLayer.eachLayer(layer => {
              if (layer.feature && layer.feature.properties && layer.feature.properties.iddesa === iddesa) {
                targetLayer = layer;
              }
            });
          }
          if (targetLayer) {
            const bounds = targetLayer.getBounds ? targetLayer.getBounds() : null;
            if (bounds) map.fitBounds(bounds, { padding: [40, 40] });
            showDesaDetails(targetLayer.feature.properties);
            targetLayer.fire('click');
          }
        };

        function updateActiveLayerStyles() {
          if (kecLayer && activeLayerName === 'kec') kecLayer.setStyle(kecStyle);
          if (desaLayer && activeLayerName === 'desa') desaLayer.setStyle(desaStyle);
          if (slsLayer && activeLayerName === 'sls') slsLayer.setStyle(slsStyle);
        }

        // Layer Toggling Logic
        function switchToKecLayer() {
          activeLayerName = 'kec';
          if (btnLayerSls) { btnLayerSls.classList.remove('active'); btnLayerSls.setAttribute('aria-pressed', 'false'); }
          if (btnLayerDesa) { btnLayerDesa.classList.remove('active'); btnLayerDesa.setAttribute('aria-pressed', 'false'); }
          if (btnLayerKec) { btnLayerKec.classList.add('active'); btnLayerKec.setAttribute('aria-pressed', 'true'); }
          
          if (legendDesa) legendDesa.style.display = 'none';
          if (legendSls) legendSls.style.display = 'none';
          if (legendKec) legendKec.style.display = 'block';

          if (slsLayer && map.hasLayer(slsLayer)) map.removeLayer(slsLayer);
          if (desaLayer && map.hasLayer(desaLayer)) map.removeLayer(desaLayer);
          if (kecLayer) {
            kecLayer.addTo(map);
            kecLayer.setStyle(kecStyle);
          }
        }

        function switchToDesaLayer() {
          activeLayerName = 'desa';
          if (btnLayerKec) { btnLayerKec.classList.remove('active'); btnLayerKec.setAttribute('aria-pressed', 'false'); }
          if (btnLayerSls) { btnLayerSls.classList.remove('active'); btnLayerSls.setAttribute('aria-pressed', 'false'); }
          if (btnLayerDesa) { btnLayerDesa.classList.add('active'); btnLayerDesa.setAttribute('aria-pressed', 'true'); }

          if (legendKec) legendKec.style.display = 'none';
          if (legendSls) legendSls.style.display = 'none';
          if (legendDesa) legendDesa.style.display = 'block';

          if (slsLayer && map.hasLayer(slsLayer)) map.removeLayer(slsLayer);
          if (kecLayer && map.hasLayer(kecLayer)) map.removeLayer(kecLayer);
          if (desaLayer) {
            desaLayer.addTo(map);
            desaLayer.setStyle(desaStyle);
          }
        }

        function switchToSlsLayer() {
          if (!slsGeoJson) {
            alert('Data batas SLS sedang diunduh di latar belakang. Silakan tunggu beberapa detik...');
            return;
          }
          activeLayerName = 'sls';
          if (btnLayerKec) { btnLayerKec.classList.remove('active'); btnLayerKec.setAttribute('aria-pressed', 'false'); }
          if (btnLayerDesa) { btnLayerDesa.classList.remove('active'); btnLayerDesa.setAttribute('aria-pressed', 'false'); }
          if (btnLayerSls) { btnLayerSls.classList.add('active'); btnLayerSls.setAttribute('aria-pressed', 'true'); }

          if (legendKec) legendKec.style.display = 'none';
          if (legendDesa) legendDesa.style.display = 'none';
          if (legendSls) legendSls.style.display = 'block';

          if (desaLayer && map.hasLayer(desaLayer)) map.removeLayer(desaLayer);
          if (kecLayer && map.hasLayer(kecLayer)) map.removeLayer(kecLayer);
          if (slsLayer) {
            slsLayer.addTo(map);
            slsLayer.setStyle(slsStyle);
          }
        }

        if (btnLayerKec) btnLayerKec.addEventListener('click', switchToKecLayer);
        if (btnLayerDesa) btnLayerDesa.addEventListener('click', switchToDesaLayer);
        if (btnLayerSls) btnLayerSls.addEventListener('click', switchToSlsLayer);

        if (btnOutlineOnly) {
          btnOutlineOnly.addEventListener('click', () => {
            isOutlineOnlyMode = !isOutlineOnlyMode;
            if (isOutlineOnlyMode) {
              btnOutlineOnly.classList.add('active');
              btnOutlineOnly.setAttribute('aria-pressed', 'true');
            } else {
              btnOutlineOnly.classList.remove('active');
              btnOutlineOnly.setAttribute('aria-pressed', 'false');
            }

            updateActiveLayerStyles();
          });
        }

        if (btnToggleLabels) {
          btnToggleLabels.addEventListener('click', () => {
            showProgressLabels = !showProgressLabels;
            if (showProgressLabels) {
              btnToggleLabels.classList.add('active');
              btnToggleLabels.setAttribute('aria-pressed', 'true');
              document.querySelectorAll('.map-label-badge').forEach(el => el.classList.remove('d-none'));
            } else {
              btnToggleLabels.classList.remove('active');
              btnToggleLabels.setAttribute('aria-pressed', 'false');
              document.querySelectorAll('.map-label-badge').forEach(el => el.classList.add('d-none'));
            }
          });
        }

        // Basemap Switcher Listeners
        btnBasemapDefault.addEventListener('click', () => {
          currentBasemapType = 'default';
          btnBasemapSatellite.classList.remove('active');
          btnBasemapDefault.classList.add('active');
          updateBasemap();
          updateActiveLayerStyles();
        });

        btnBasemapSatellite.addEventListener('click', () => {
          currentBasemapType = 'satellite';
          btnBasemapDefault.classList.remove('active');
          btnBasemapSatellite.classList.add('active');
          updateBasemap();
          updateActiveLayerStyles();
        });

        // Filter Dropdown Listener
        kecFilter.addEventListener('change', (e) => {
          currentFilteredKec = e.target.value;
          updateActiveLayerStyles();
          fitBoundsToKecamatan(currentFilteredKec);
        });

        const btnClearSearch = document.getElementById('btnClearSearch');

        // Reset View Button
        btnResetView.addEventListener('click', () => {
          kecFilter.value = '';
          currentFilteredKec = '';
          if (mapSearchInput) mapSearchInput.value = '';
          if (btnClearSearch) btnClearSearch.style.display = 'none';
          map.setView(centerCoords, defaultZoom);
          updateActiveLayerStyles();
        });

        if (btnClearSearch && mapSearchInput) {
          btnClearSearch.addEventListener('click', () => {
            mapSearchInput.value = '';
            btnClearSearch.style.display = 'none';
            mapSearchInput.focus();
            updateActiveLayerStyles();
          });
        }

        // Search Input Listener with auto-focus/highlight
        if (mapSearchInput) {
          mapSearchInput.addEventListener('input', (e) => {
            const q = e.target.value.toLowerCase().trim();
            if (btnClearSearch) {
              btnClearSearch.style.display = q ? 'flex' : 'none';
            }
            if (!q) {
              updateActiveLayerStyles();
              return;
            }

            let foundBounds = L.latLngBounds();
            let hasMatch = false;

            if (activeLayerName === 'kec' && kecLayer) {
              kecLayer.eachLayer(layer => {
                const nmkec = (layer.feature.properties.nmkec || '').toLowerCase();
                if (nmkec.includes(q)) {
                  layer.setStyle({ weight: 3, color: 'var(--accent-cyan)', fillOpacity: 0.85 });
                  if (layer.getBounds) foundBounds.extend(layer.getBounds());
                  hasMatch = true;
                } else {
                  layer.setStyle({ opacity: 0.1, fillOpacity: 0.05 });
                }
              });
            } else if (activeLayerName === 'desa' && desaLayer) {
              desaLayer.eachLayer(layer => {
                const nmdesa = (layer.feature.properties.nmdesa || '').toLowerCase();
                const nmkec = (layer.feature.properties.nmkec || '').toLowerCase();
                if (nmdesa.includes(q) || nmkec.includes(q)) {
                  layer.setStyle({ weight: 3, color: 'var(--accent-cyan)', fillOpacity: 0.85 });
                  if (layer.getBounds) foundBounds.extend(layer.getBounds());
                  hasMatch = true;
                } else {
                  layer.setStyle({ opacity: 0.1, fillOpacity: 0.05 });
                }
              });
            } else if (activeLayerName === 'sls' && slsLayer) {
              slsLayer.eachLayer(layer => {
                const nmsls = (layer.feature.properties.nmsls || '').toLowerCase();
                const nmdesa = (layer.feature.properties.nmdesa || '').toLowerCase();
                const kode = (layer.feature.properties.kode || '').toLowerCase();
                if (nmsls.includes(q) || nmdesa.includes(q) || kode.includes(q)) {
                  layer.setStyle({ weight: 3, color: 'var(--accent-cyan)', fillOpacity: 0.85 });
                  if (layer.getBounds) foundBounds.extend(layer.getBounds());
                  hasMatch = true;
                } else {
                  layer.setStyle({ opacity: 0.1, fillOpacity: 0.05 });
                }
              });
            }

            if (hasMatch && foundBounds.isValid()) {
              map.fitBounds(foundBounds, { padding: [40, 40] });
            }
          });
        }

        // Initialize map & load data!
        bootstrap();

        // Filter Drag-to-Scroll & Visual Scroll Indicator Setup
        const filterRow = document.getElementById('gmapsFilterRow');
        const scrollHintRight = document.getElementById('gmapsScrollHintRight');

        function checkFilterScrollIndicator() {
          if (!filterRow || !scrollHintRight) return;
          const maxScrollLeft = filterRow.scrollWidth - filterRow.clientWidth;
          const canScrollRight = maxScrollLeft - filterRow.scrollLeft > 6;

          if (canScrollRight) {
            scrollHintRight.classList.add('visible');
          } else {
            scrollHintRight.classList.remove('visible');
          }
        }

        if (filterRow) {
          checkFilterScrollIndicator();
          filterRow.addEventListener('scroll', checkFilterScrollIndicator, { passive: true });
          window.addEventListener('resize', checkFilterScrollIndicator, { passive: true });
          setTimeout(checkFilterScrollIndicator, 300);

          if (scrollHintRight) {
            scrollHintRight.addEventListener('click', () => {
              filterRow.scrollBy({ left: 140, behavior: 'smooth' });
            });
          }

          let isDown = false;
          let startX = 0;
          let startScrollLeft = 0;
          let hasDragged = false;

          filterRow.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            isDown = true;
            hasDragged = false;
            startX = e.pageX - filterRow.offsetLeft;
            startScrollLeft = filterRow.scrollLeft;
          });

          filterRow.addEventListener('mouseleave', () => {
            if (!isDown) return;
            isDown = false;
            filterRow.classList.remove('is-dragging');
          });

          filterRow.addEventListener('mouseup', () => {
            if (!isDown) return;
            isDown = false;
            filterRow.classList.remove('is-dragging');
            setTimeout(() => { hasDragged = false; }, 50);
          });

          filterRow.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            const currentX = e.pageX - filterRow.offsetLeft;
            const distance = currentX - startX;

            if (Math.abs(distance) > 5) {
              if (!hasDragged) {
                hasDragged = true;
                filterRow.classList.add('is-dragging');
              }
              e.preventDefault();
              filterRow.scrollLeft = startScrollLeft - distance * 1.4;
            }
          });

          filterRow.addEventListener('click', (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopPropagation();
            }
          }, true);
        }
      }

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initMapPage();
      } else {
        document.addEventListener('DOMContentLoaded', initMapPage);
      }
    </script>
</div>
