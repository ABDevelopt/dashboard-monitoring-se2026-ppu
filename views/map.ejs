    <!-- 4. FLOATING RIGHT VERTICAL ACTION STACK (FULLSCREEN, GPS, RESET) -->
    <div class="gmaps-floating-right-stack">
      <button id="btnFullscreenMap" class="gmaps-floating-square-btn" title="Mode Layar Penuh (Command Center)" type="button">
        <i class="bi bi-arrows-fullscreen"></i>
      </button>
      <button id="btnLocateMe" class="gmaps-floating-square-btn" title="Lokasi GPS Presisi Saya" type="button">
        <i class="bi bi-crosshair"></i>
