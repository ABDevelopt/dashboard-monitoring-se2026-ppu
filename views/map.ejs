        </select>
      </div>

      <!-- Collapsible Filter & Options Section -->
      <div class="gmaps-controls-collapsible" id="toolsExtraRows">
        <!-- Section 1: Filter Petugas PCL -->
        <div class="gmaps-section-label"><i class="bi bi-person-badge"></i> Filter Petugas PCL</div>
        <div class="gmaps-control-row" style="margin-bottom: 8px;">
          <select id="pclFilter" class="gmaps-select-pill" title="Filter Cepat Berdasarkan Petugas PCL" style="width: 100%;">
