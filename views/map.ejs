                <div class="progress-bar ${fasihPct >= 100 ? 'green' : (fasihPct < 25 ? 'red' : 'purple')}" data-width="${fasihPct}" style="width: ${fasihPct}%; height: 100%; border-radius: 99px;"></div>
              </div>
              <div style="font-size: 10px; color: var(--text-muted); margin-top: 4px; text-align: right;">
                ${totalRealisasiFasih.toLocaleString('id-ID')} / ${targetFasih.toLocaleString('id-ID')} Dokumen
