              // Otomatis beralih ke mode "Batas Saja" (Outline Only) agar posisi GPS di peta terlihat jelas tanpa terhalang warna fill
              if (!isOutlineOnlyMode) {
                isOutlineOnlyMode = true;
                updateOutlineToggleUi(true);
                updateActiveLayerStyles();
              }

              map.flyTo([lat, lng], 16, { animate: true, duration: 1.2 });
