        <!-- Section 2: Saklar Fitur Peta -->
        <div class="gmaps-section-label"><i class="bi bi-toggles"></i> Saklar Fitur Tambahan</div>
        <div class="gmaps-control-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 7px;">
          <button id="btnOutlineOnly" class="gmaps-toggle-btn" title="Aktifkan/Matikan Garis Batas Saja (Tanpa Warna Isi)" type="button" aria-pressed="false" style="width: 100%;">
            <span style="display: inline-flex; align-items: center; gap: 5px;">
              <i class="bi bi-bounding-box-circles"></i> Batas Saja
