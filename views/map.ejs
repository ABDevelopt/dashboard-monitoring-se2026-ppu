        function fitBoundsToDesa(desaNameOrId) {
          if (!desaNameOrId) return;
          let targetLayer = null;
          if (desaLayer) {
            desaLayer.eachLayer(layer => {
              if (layer.feature && layer.feature.properties &&
                  ((layer.feature.properties.nmdesa && layer.feature.properties.nmdesa.toUpperCase() === desaNameOrId.toUpperCase()) ||
                   layer.feature.properties.iddesa === desaNameOrId)) {
                targetLayer = layer;
              }
            });
          }
          if (targetLayer && targetLayer.getBounds) {
            const bounds = targetLayer.getBounds();
            if (bounds && bounds.isValid()) {
              map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
            }
          }
        }

        // Kecamatan Filter Dropdown Listener
        if (kecFilter) {
          kecFilter.addEventListener('change', (e) => {
            currentFilteredKec = e.target.value;
            populateDesaFilterList(currentFilteredKec);
            currentFilteredDesa = '';
            updateActiveLayerStyles();
            updateTopStats();
            if (currentFilteredKec) {
              fitBoundsToKecamatan(currentFilteredKec);
              if (typeof window.updateMapBreadcrumbs === 'function') {
                window.updateMapBreadcrumbs('kec', currentFilteredKec);
              }
            } else {
              if (typeof window.updateMapBreadcrumbs === 'function') {
                window.updateMapBreadcrumbs('kab');
              }
            }
          });
        }

        // Desa / Kelurahan Filter Dropdown Listener
        if (desaFilter) {
          desaFilter.addEventListener('change', (e) => {
            currentFilteredDesa = e.target.value;
            
            // Auto match kecamatan if desa selected without prior kecamatan
            if (currentFilteredDesa && !currentFilteredKec && desaStats) {
              const matchedDesa = desaStats.find(d => d.desa && d.desa.toUpperCase() === currentFilteredDesa.toUpperCase());
              if (matchedDesa && matchedDesa.kecamatan) {
                currentFilteredKec = matchedDesa.kecamatan;
                if (kecFilter) kecFilter.value = currentFilteredKec;
              }
            }

            updateActiveLayerStyles();
            updateTopStats();
            
            if (currentFilteredDesa) {
              fitBoundsToDesa(currentFilteredDesa);
              if (typeof window.updateMapBreadcrumbs === 'function') {
                window.updateMapBreadcrumbs('desa', currentFilteredKec, currentFilteredDesa);
              }
            } else if (currentFilteredKec) {
              fitBoundsToKecamatan(currentFilteredKec);
              if (typeof window.updateMapBreadcrumbs === 'function') {
                window.updateMapBreadcrumbs('kec', currentFilteredKec);
              }
            } else {
              if (typeof window.updateMapBreadcrumbs === 'function') {
                window.updateMapBreadcrumbs('kab');
              }
            }
          });
        }

        // Reset View Button
        if (btnResetView) {
          btnResetView.addEventListener('click', () => {
            if (kecFilter) kecFilter.value = '';
            if (desaFilter) desaFilter.value = '';
            if (pclFilter) pclFilter.value = '';
            currentFilteredKec = '';
            currentFilteredDesa = '';
            populateDesaFilterList('');
            currentStatusFilter = '';
            currentHighlightedPcl = '';
            currentThematicMetric = 'fasih';
            switchThematicMetric('fasih');
            filterByKpiStatus('');
            if (mapSearchInput) mapSearchInput.value = '';
            if (typeof window.updateMapBreadcrumbs === 'function') {
              window.updateMapBreadcrumbs('kab');
            }
            map.setView(centerCoords, defaultZoom);
            updateActiveLayerStyles();
            updateTopStats();
          });
        }

        // PCL Territory Highlight Helper
        window.highlightPclTerritory = function(pclName) {
          if (!pclName || pclName === 'Belum Ditentukan') return;
          currentHighlightedPcl = pclName.toLowerCase().trim();
          currentStatusFilter = ''; // Reset KPI status filter
          if (pclFilter && pclFilter.value !== pclName) {
            pclFilter.value = pclName;
          }

          document.querySelectorAll('.gmaps-kpi-pill').forEach(pill => {
            if (pill.getAttribute('data-status') === '') {
              pill.classList.add('active-filter');
            } else {
              pill.classList.remove('active-filter');
            }
          });

          if (activeLayerName !== 'sls') {
            switchToSlsLayer();
          } else {
            updateActiveLayerStyles();
          }

          setTimeout(() => {
            let foundBounds = L.latLngBounds();
            let count = 0;

            if (slsLayer) {
              slsLayer.eachLayer(layer => {
                const stat = getSlsStat(layer.feature.properties.kode);
                const layerPcl = stat ? stat.pcl : (layer.feature.properties.pcl || '');

                if (layerPcl && layerPcl.toLowerCase().trim() === currentHighlightedPcl) {
                  if (layer.getBounds) foundBounds.extend(layer.getBounds());
                  count++;
                }
              });
            }

            if (count > 0 && foundBounds.isValid()) {
              map.fitBounds(foundBounds, { padding: [50, 50] });
            }
          }, 120);
        };

        // -------------------------------------------------------------
        // ULTRA-LIGHTWEIGHT & FAST SPATIAL SEARCH ENGINE
        // -------------------------------------------------------------
        let currentSearchQuery = '';
        let isSearchActive = false;
        let searchDebounceTimer = null;

        function applySearchHighlightToLayer(layer, layerType) {
          if (!isSearchActive || !currentSearchQuery) {
            if (layerType === 'kec') layer.setStyle(kecStyle(layer.feature));
            else if (layerType === 'desa') layer.setStyle(desaStyle(layer.feature));
            else if (layerType === 'sls') layer.setStyle(slsStyle(layer.feature));
            return;
          }

          const terms = currentSearchQuery.split(/\s+/).filter(Boolean);
          const key = layer._searchKey || '';
          const isMatch = terms.every(term => key.includes(term));

          if (isMatch) {
            layer.setStyle({
              weight: 2.8,
              color: '#06b6d4',
              opacity: 1,
              fillOpacity: currentBasemapType === 'satellite' ? 0.70 : 0.60
            });
          } else {
            layer.setStyle({
              opacity: 0.12,
              fillOpacity: 0.02
            });
          }
        }

        function performMapSearch(query) {
          const q = (query || '').toLowerCase().trim();
          currentSearchQuery = q;
          isSearchActive = q.length > 0;

          if (!isSearchActive) {
            updateActiveLayerStyles();
            return;
          }

          const terms = q.split(/\s+/).filter(Boolean);
          const currentLayer = activeLayerName === 'kec' ? kecLayer : (activeLayerName === 'desa' ? desaLayer : slsLayer);
          if (!currentLayer) return;

          let foundBounds = L.latLngBounds();
          let matchCount = 0;

          currentLayer.eachLayer(layer => {
            const key = layer._searchKey || '';
            const isMatch = terms.every(term => key.includes(term));

            if (isMatch) {
              layer.setStyle({
                weight: 2.8,
                color: '#06b6d4',
                opacity: 1,
                fillOpacity: currentBasemapType === 'satellite' ? 0.70 : 0.60
              });
              if (layer.getBounds) foundBounds.extend(layer.getBounds());
              matchCount++;
            } else {
              layer.setStyle({
                opacity: 0.12,
                fillOpacity: 0.02
              });
            }
          });

          if (matchCount > 0 && foundBounds.isValid()) {
            map.fitBounds(foundBounds, { padding: [40, 40], maxZoom: 16 });
          }
        }

        if (mapSearchInput) {
          mapSearchInput.addEventListener('input', (e) => {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
              performMapSearch(e.target.value);
            }, 120);
          });
        }

        // Draggable Floating Tools Panel Setup
        function setupDraggableToolsPanel() {
          const panel = document.getElementById('gmapsToolsPanel');
          const handle = document.getElementById('toolsPanelDragHandle') || panel;
          const container = document.getElementById('gmapsWrapper') || document.body;
          if (!panel || !handle) return;

          // Prevent map dragging & zooming when interacting with the panel
          if (typeof L !== 'undefined' && L.DomEvent) {
            L.DomEvent.disableClickPropagation(panel);
            L.DomEvent.disableScrollPropagation(panel);
          }

          let isDragging = false;
          let startX = 0, startY = 0;
          let initialLeft = 0, initialTop = 0;

          function startDrag(e) {
            // Ignore if clicking interactive form controls
            if (['INPUT', 'BUTTON', 'SELECT', 'I', 'A', 'OPTION'].includes(e.target.tagName)) {
              return;
            }

            isDragging = true;
            panel.classList.add('is-dragging');

            const clientX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
            const clientY = e.type.startsWith('touch') ? e.touches[0].clientY : e.clientY;

            startX = clientX;
            startY = clientY;

            const rect = panel.getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();

            initialLeft = rect.left - containerRect.left;
            initialTop = rect.top - containerRect.top;

            // Set fixed left/top in pixel
            panel.style.left = initialLeft + 'px';
            panel.style.top = initialTop + 'px';
            panel.style.right = 'auto';
            panel.style.bottom = 'auto';

            if (e.type.startsWith('touch')) {
              window.addEventListener('touchmove', moveDrag, { passive: false });
              window.addEventListener('touchend', endDrag);
            } else {
              window.addEventListener('mousemove', moveDrag);
              window.addEventListener('mouseup', endDrag);
            }
          }

          function moveDrag(e) {
            if (!isDragging) return;
            if (e.cancelable) e.preventDefault();

            const clientX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
            const clientY = e.type.startsWith('touch') ? e.touches[0].clientY : e.clientY;

            const dx = clientX - startX;
            const dy = clientY - startY;

            const containerRect = container.getBoundingClientRect();
            const panelWidth = panel.offsetWidth;
            const panelHeight = panel.offsetHeight;

            let newLeft = initialLeft + dx;
            let newTop = initialTop + dy;

            // Constrain inside map bounds with 10px margin
            const minLeft = 10;
            const maxLeft = containerRect.width - panelWidth - 10;
            const minTop = 10;
            const maxTop = containerRect.height - panelHeight - 10;

            newLeft = Math.max(minLeft, Math.min(maxLeft, newLeft));
            newTop = Math.max(minTop, Math.min(maxTop, newTop));

            panel.style.left = newLeft + 'px';
            panel.style.top = newTop + 'px';
          }

          function endDrag() {
            if (!isDragging) return;
            isDragging = false;
            panel.classList.remove('is-dragging');

            window.removeEventListener('mousemove', moveDrag);
            window.removeEventListener('mouseup', endDrag);
            window.removeEventListener('touchmove', moveDrag);
            window.removeEventListener('touchend', endDrag);
          }

          handle.addEventListener('mousedown', startDrag);
          handle.addEventListener('touchstart', startDrag, { passive: true });
        }

        setupDraggableToolsPanel();

        // Initialize map & load data!
        bootstrap();

        // Filter Drag-to-Scroll & Visual Scroll Indicator Setup
        const filterRow = document.getElementById('gmapsFilterRow');
        const scrollHintRight = document.getElementById('gmapsScrollHintRight');

        function checkFilterScrollIndicator() {
          if (!filterRow || !scrollHintRight) return;
          const maxScrollLeft = filterRow.scrollWidth - filterRow.clientWidth;
          const canScrollRight = maxScrollLeft - filterRow.scrollLeft > 6;

          if (canScrollRight) {
            scrollHintRight.classList.add('visible');
          } else {
            scrollHintRight.classList.remove('visible');
          }
        }

        if (filterRow) {
          checkFilterScrollIndicator();
          filterRow.addEventListener('scroll', checkFilterScrollIndicator, { passive: true });
          window.addEventListener('resize', checkFilterScrollIndicator, { passive: true });
          setTimeout(checkFilterScrollIndicator, 300);

          if (scrollHintRight) {
            scrollHintRight.addEventListener('click', () => {
              filterRow.scrollBy({ left: 140, behavior: 'smooth' });
            });
          }

          let isDown = false;
          let startX = 0;
          let startScrollLeft = 0;
          let hasDragged = false;

          filterRow.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            isDown = true;
            hasDragged = false;
            startX = e.pageX - filterRow.offsetLeft;
            startScrollLeft = filterRow.scrollLeft;
          });

          filterRow.addEventListener('mouseleave', () => {
            if (!isDown) return;
            isDown = false;
            filterRow.classList.remove('is-dragging');
          });

          filterRow.addEventListener('mouseup', () => {
            if (!isDown) return;
            isDown = false;
            filterRow.classList.remove('is-dragging');
            setTimeout(() => { hasDragged = false; }, 50);
          });

          filterRow.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            const currentX = e.pageX - filterRow.offsetLeft;
            const distance = currentX - startX;

            if (Math.abs(distance) > 5) {
              if (!hasDragged) {
                hasDragged = true;
                filterRow.classList.add('is-dragging');
              }
              e.preventDefault();
              filterRow.scrollLeft = startScrollLeft - distance * 1.4;
            }
          });

          filterRow.addEventListener('click', (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopPropagation();
            }
          }, true);
        }
      }

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initMapPage();
      } else {
        document.addEventListener('DOMContentLoaded', initMapPage);
      }
    </script>
</div>
