  }

  body.light-mode .gmaps-kpi-pill {
    background: rgba(255, 255, 255, 0.92);
  }

  /* Floating Info & Legend Drawer Card (Bottom Left) */
  .gmaps-floating-drawer-card {
    position: absolute;
    bottom: 30px;
    left: 14px;
    z-index: 1000;
    width: 390px;
    max-width: calc(100% - 28px);
