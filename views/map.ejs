  .gmaps-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 13px;
    border-bottom: 1px solid var(--border);
  }

  .gmaps-drawer-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .gmaps-tab-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 12.5px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.15s ease;
  }

  .gmaps-tab-btn.active {
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent-blue);
  }

  .gmaps-collapse-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .gmaps-collapse-btn:hover {
    color: var(--accent-blue);
  }

  /* Fixed Height Drawer Content to Prevent Tab-Switch Height Jumps */
  .gmaps-drawer-content {
    padding: 14px;
    height: 330px;
    min-height: 330px;
    max-height: 330px;
    overflow-y: auto;
    scrollbar-width: thin;
    box-sizing: border-box;
  }

  .gmaps-floating-drawer-card.collapsed .gmaps-drawer-content {
    display: none;
  }

  /* Metric Cards Grid Inside Drawer */
  .map-card-stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 7px;
    margin-bottom: 10px;
  }

  .map-card-stat-item {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 7px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .map-card-stat-item.full-width {
    grid-column: span 2;
  }

  .map-card-stat-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 5px;
    line-height: 1.2;
  }

  .map-card-stat-value {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Status Pill Badges Row */
  .map-status-pills-row {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .map-status-pill {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .map-status-pill.approved { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .map-status-pill.submitted { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
  .map-status-pill.rejected { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
  .map-status-pill.draft { background: rgba(148, 163, 184, 0.15); color: #94a3b8; }

  /* Action Buttons Container */
  .map-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 10px;
    padding-top: 9px;
    border-top: 1px dashed var(--border);
  }

  .map-action-btn-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
  }

  .map-legend-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    padding: 7px 10px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 6px;
  }

  .map-legend-color {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .loading-overlay {
    position: absolute;
    top: 0;
