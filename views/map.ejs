          <div class="gmaps-pill-group">
            <button id="btnBasemapDefault" class="gmaps-pill-btn active"><i class="bi bi-map"></i> Vektor</button>
            <button id="btnBasemapSatellite" class="gmaps-pill-btn"><i class="bi bi-globe-americas"></i> Satelit</button>
          </div>

          <div class="gmaps-pill-group">
            <button id="btnOutlineOnly" class="gmaps-pill-btn" title="Tampilkan Garis Batas Wilayah Saja (Tanpa Warna Isi)"><i class="bi bi-bounding-box-circles"></i> Garis Batas Saja</button>
            <button id="btnToggleLabels" class="gmaps-pill-btn active" title="Tampilkan/Sembunyikan Label Persentase Progres di Peta"><i class="bi bi-percent"></i> Label Progres</button>
          </div>
        </div>

        <div class="gmaps-filter-scroll-hint" id="gmapsScrollHintRight" title="Geser ke kanan untuk opsi lainnya">
          <i class="bi bi-chevron-right"></i>
        </div>
      </div>
    </div>

    <!-- 3. FLOATING KPI OVERLAY BAR (TOP RIGHT) -->
    <div class="gmaps-floating-kpi-bar">
      <div class="gmaps-kpi-pill">
        <i class="bi bi-check2-circle" style="color: var(--accent-green);"></i>
        <span class="label">SLS Selesai:</span>
        <strong id="statSlsSelesai" style="color: var(--accent-green);">-- / -- SLS</strong>
      </div>
      <div class="gmaps-kpi-pill">
        <i class="bi bi-pie-chart-fill" style="color: var(--accent-blue);"></i>
        <span class="label">Progres FASIH:</span>
        <strong id="statProgresFasih" style="color: var(--accent-blue);">--%</strong>
      </div>
      <div class="gmaps-kpi-pill">
        <i class="bi bi-geo-alt-fill" style="color: var(--accent-cyan);"></i>
        <span class="label">Wilayah:</span>
        <strong id="statTotalWilayah">4 Kec / 54 Desa</strong>
      </div>
    </div>

    <!-- 4. FLOATING SIDE CARD DRAWER (LEFT SIDE) FOR STATS & LEGEND -->
    <div class="gmaps-floating-drawer-card collapsed" id="gmapsDrawerCard">
      <div class="gmaps-drawer-header">
        <div class="gmaps-drawer-tabs">
          <button type="button" class="gmaps-tab-btn active" id="tabBtnStats" onclick="switchGmapsTab('stats')">
            <i class="bi bi-card-list"></i> Detail Wilayah
          </button>
          <button type="button" class="gmaps-tab-btn" id="tabBtnLegend" onclick="switchGmapsTab('legend')">
            <i class="bi bi-palette"></i> Legenda
          </button>
        </div>
        <button type="button" class="gmaps-collapse-btn" onclick="toggleGmapsDrawer()" title="Sembunyikan / Tampilkan Panel">
          <i class="bi bi-chevron-up" id="drawerCollapseIcon"></i>
        </button>
      </div>

      <div class="gmaps-drawer-content" id="gmapsDrawerContent">
        <!-- TAB 1: STATS -->
        <div id="gmapsStatsTabContent">
          <div id="mapSummaryStats">
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 22px 10px; text-align: center;">
              <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(59, 130, 246, 0.12); display: flex; align-items: center; justify-content: center; margin-bottom: 10px; color: var(--accent-blue); font-size: 20px;">
                <i class="bi bi-geo-alt-fill"></i>
              </div>
              <div style="font-size: 12.5px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">Detail Wilayah Spasial</div>
              <div style="font-size: 11px; color: var(--text-muted); max-width: 260px; line-height: 1.4;">
                Klik salah satu wilayah desa atau SLS pada peta untuk menampilkan rincian progres di sini.
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 2: LEGEND -->
        <div id="gmapsLegendTabContent" style="display: none;">
          <div id="legendKec" style="display: none;">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">Progres Realisasi Kecamatan:</div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #10b981;"></div><span><strong>100%</strong> (Target Selesai)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #0284c7;"></div><span><strong>75% - 99%</strong> (Sangat Baik)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #eab308;"></div><span><strong>25% - 74%</strong> (Sedang)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #f97316;"></div><span><strong>1% - 24%</strong> (Awal Progres)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #ef4444;"></div><span><strong>0%</strong> (Belum Ada Progres)</span></div>
          </div>

          <div id="legendDesa">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">Persentase Realisasi FASIH Desa:</div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #10b981;"></div><span><strong>100%</strong> FASIH (Target Selesai)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #0284c7;"></div><span><strong>75% - 99%</strong> FASIH (Sangat Baik)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #eab308;"></div><span><strong>25% - 74%</strong> FASIH (Sedang)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #f97316;"></div><span><strong>1% - 24%</strong> FASIH (Awal Progres)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #ef4444;"></div><span><strong>0%</strong> FASIH (Belum Ada Progres)</span></div>
          </div>

          <div id="legendSls" style="display: none;">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">Legenda Progres SubSLS:</div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #10b981;"></div><span><strong>Selesai</strong> (Dinyatakan Selesai Resmi)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #1e40af;"></div><span><strong>Memenuhi Target</strong> (100% Progres)</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #2563eb;"></div><span><strong>75% - 99%</strong> Progres FASIH/Muatan</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #3b82f6;"></div><span><strong>50% - 74%</strong> Progres FASIH/Muatan</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #60a5fa;"></div><span><strong>25% - 49%</strong> Progres FASIH/Muatan</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #93c5fd;"></div><span><strong>1% - 24%</strong> Progres FASIH/Muatan</span></div>
            <div class="map-legend-item"><div class="map-legend-color" style="background: #cbd5e1;"></div><span><strong>0%</strong> (Belum Ada Isian)</span></div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

    <script>
      window.switchGmapsTab = function(tabName) {
        const statsTab = document.getElementById('gmapsStatsTabContent');
        const legendTab = document.getElementById('gmapsLegendTabContent');
        const btnStats = document.getElementById('tabBtnStats');
        const btnLegend = document.getElementById('tabBtnLegend');
        
        if (tabName === 'stats') {
          if (statsTab) statsTab.style.display = 'block';
          if (legendTab) legendTab.style.display = 'none';
          if (btnStats) btnStats.classList.add('active');
          if (btnLegend) btnLegend.classList.remove('active');
        } else {
          if (statsTab) statsTab.style.display = 'none';
          if (legendTab) legendTab.style.display = 'block';
          if (btnStats) btnStats.classList.remove('active');
          if (btnLegend) btnLegend.classList.add('active');
        }
      };

      window.toggleGmapsDrawer = function() {
        const card = document.getElementById('gmapsDrawerCard');
        const icon = document.getElementById('drawerCollapseIcon');
        if (!card) return;
        card.classList.toggle('collapsed');
        if (icon) {
          if (card.classList.contains('collapsed')) {
            icon.className = 'bi bi-chevron-up';
          } else {
            icon.className = 'bi bi-chevron-down';
          }
        }
      };

      window.ensureGmapsDrawerOpen = function() {
        const card = document.getElementById('gmapsDrawerCard');
        const icon = document.getElementById('drawerCollapseIcon');
        if (card && card.classList.contains('collapsed')) {
          card.classList.remove('collapsed');
          if (icon) icon.className = 'bi bi-chevron-down';
        }
      };

      function initMapPage() {
        if (typeof L === 'undefined') {
          setTimeout(initMapPage, 50);
          return;
        }

        const mapContainerEl = document.getElementById('map');
        if (!mapContainerEl) return;

        // Initial setup
        const centerCoords = [-1.30, 116.65];
        const defaultZoom = 10;
        
        // Clean container state to ensure clean re-initialization on PJAX swaps
        if (mapContainerEl._leaflet_id) {
          mapContainerEl._leaflet_id = null;
        }

        const map = L.map('map', {
          zoomControl: false,
          maxZoom: 18,
          minZoom: 9
        }).setView(centerCoords, defaultZoom);

        L.control.zoom({ position: 'bottomright' }).addTo(map);

        let currentBasemapLayer = null;

        // Helper to force Leaflet to recalculate canvas size and redraw tiles
        const invalidateMapSize = () => {
          if (map && typeof map.invalidateSize === 'function') {
            map.invalidateSize({ animate: false });
          }
          if (currentBasemapLayer && typeof currentBasemapLayer.redraw === 'function') {
            currentBasemapLayer.redraw();
          }
        };

        // Staggered invalidations to guarantee tile grid recalculation after load & PJAX enter animation
        invalidateMapSize();
        [50, 150, 300, 450, 800, 1200].forEach(delay => {
          setTimeout(invalidateMapSize, delay);
        });

        // Extra invalidation on window load to handle late CSS/font rendering
        window.addEventListener('load', invalidateMapSize);

        // Use ResizeObserver for automatic sizing adjustment when sidebar or window container resizes
        if (window.ResizeObserver && mapContainerEl) {
          const ro = new ResizeObserver(() => {
            invalidateMapSize();
          });
          ro.observe(mapContainerEl);
          if (window._pjaxCleanups) {
            window._pjaxCleanups.push({ type: 'pjax:start', listener: () => ro.disconnect() });
          }
        }

        // Clean up map instance safely when navigating away via PJAX
        const onPjaxStart = () => {
          try {
            if (map) map.remove();
          } catch (_) {}
        };
        window.addEventListener('pjax:start', onPjaxStart, { once: true });

        // Robust tile creation helper with smart fallback & zoom scaling protection
        const createRobustTileLayer = (primaryUrl, options = {}, fallbackUrl = null, fallbackMaxNativeZoom = 16) => {
          const layer = L.tileLayer(primaryUrl, options);
          if (fallbackUrl) {
            layer.on('tileerror', (e) => {
              if (e.tile && !e.tile.dataset.fallbackTried) {
                e.tile.dataset.fallbackTried = 'true';
                const coords = e.coords;
                if (coords) {
                  let z = coords.z;
                  let x = coords.x;
                  let y = coords.y;
                  if (z > fallbackMaxNativeZoom) {
                    const factor = Math.pow(2, z - fallbackMaxNativeZoom);
                    x = Math.floor(x / factor);
                    y = Math.floor(y / factor);
                    z = fallbackMaxNativeZoom;
                  }
                  e.tile.src = fallbackUrl
                    .replace('{z}', z)
                    .replace('{x}', x)
                    .replace('{y}', y);
                }
              }
            });
          }
          return layer;
        };

        // Basemaps using CARTO CDN with high-DPI support, buffer protection, and OSM fallbacks
        const lightBasemap = createRobustTileLayer(
          'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
          {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 20,
            maxNativeZoom: 19,
            keepBuffer: 6,
            updateWhenIdle: false,
            updateWhenZooming: false,
            crossOrigin: true
          },
          'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          19
        );

        const darkBasemap = createRobustTileLayer(
          'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
          {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 20,
            maxNativeZoom: 19,
            keepBuffer: 6,
            updateWhenIdle: false,
            updateWhenZooming: false,
            crossOrigin: true
          },
          'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          19
        );

        const satelliteBasemap = createRobustTileLayer(
          'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
          {
            attribution: 'Tiles &copy; Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP',
            maxZoom: 20,
            maxNativeZoom: 18,
            keepBuffer: 6,
            updateWhenIdle: false,
            updateWhenZooming: false,
            crossOrigin: true
          }
        );

        const satelliteLabels = L.tileLayer(
          'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
          {
            maxZoom: 20,
            maxNativeZoom: 18,
            keepBuffer: 6,
            crossOrigin: true
          }
        );

        let currentBasemapType = 'default'; // 'default' or 'satellite'

        function updateBasemap() {
          const isLight = document.body.classList.contains('light-mode');
          let targetLayer = null;

          if (currentBasemapType === 'satellite') {
            targetLayer = satelliteBasemap;
            if (!map.hasLayer(satelliteLabels)) {
              satelliteLabels.addTo(map);
            }
          } else {
            if (map.hasLayer(satelliteLabels)) {
              map.removeLayer(satelliteLabels);
            }
            if (isLight) {
              targetLayer = lightBasemap;
            } else {
              targetLayer = darkBasemap;
            }
          }

          [lightBasemap, darkBasemap, satelliteBasemap].forEach(l => {
            if (l !== targetLayer && map.hasLayer(l)) {
              map.removeLayer(l);
            }
          });

          if (!map.hasLayer(targetLayer)) {
            targetLayer.addTo(map);
          }
          
          targetLayer.bringToBack();
          currentBasemapLayer = targetLayer;
          invalidateMapSize();
        }
        updateBasemap();

        // Listen for theme toggle events & register cleanup
        const onThemeChange = () => {
          updateBasemap();
          if (desaLayer) desaLayer.setStyle(desaStyle);
          if (slsLayer) slsLayer.setStyle(slsStyle);
        };
        window.addEventListener('themechange', onThemeChange);

        const onWindowResize = () => invalidateMapSize();
        const onOrientationChange = () => setTimeout(invalidateMapSize, 200);
        window.addEventListener('resize', onWindowResize);
        window.addEventListener('orientationchange', onOrientationChange);
        if (window.visualViewport) {
          window.visualViewport.addEventListener('resize', onWindowResize);
        }

        if (window._pjaxCleanups) {
          window._pjaxCleanups.push(
            { type: 'themechange', listener: onThemeChange },
            { type: 'resize', listener: onWindowResize },
            { type: 'orientationchange', listener: onOrientationChange },
            { type: 'pjax:start', listener: onPjaxStart }
          );
        }

        // Data holders
        const settings = (typeof globalSettings !== 'undefined' ? globalSettings : (typeof settings !== 'undefined' ? settings : {}));
        const isSakernasMap = (typeof window !== 'undefined' && window.activeSurveyId && window.activeSurveyId.startsWith('sakernas'));

        let kecGeoJson = null;
        let desaGeoJson = null;
        let slsGeoJson = null;
        let desaStats = [];
        let slsStats = [];
        let kecStats = [];
        
        let kecLayer = null;
        let desaLayer = null;
        let slsLayer = null;
        let isOutlineOnlyMode = false;
        let showProgressLabels = true;
        let activeLayerName = 'desa'; // 'desa', 'sls', or 'kec'
        let currentFilteredKec = '';

        // UI Selectors
        const loadingOverlay = document.getElementById('mapLoading');
        const loadingText = document.getElementById('loadingStatusText');
        const kecFilter = document.getElementById('kecFilter');
        const mapSearchInput = document.getElementById('mapSearchInput');
        const btnResetView = document.getElementById('btnResetView');
        const btnLayerKec = document.getElementById('btnLayerKec');
        const btnLayerDesa = document.getElementById('btnLayerDesa');
        const btnLayerSls = document.getElementById('btnLayerSls');
        const btnBasemapDefault = document.getElementById('btnBasemapDefault');
        const btnBasemapSatellite = document.getElementById('btnBasemapSatellite');
        const btnOutlineOnly = document.getElementById('btnOutlineOnly');
        const btnToggleLabels = document.getElementById('btnToggleLabels');
        const legendKec = document.getElementById('legendKec');
        const legendDesa = document.getElementById('legendDesa');
        const legendSls = document.getElementById('legendSls');
        const sidebarStats = document.getElementById('mapSummaryStats');
        const mapContainerWrap = document.getElementById('mapContainerWrap');
        const btnMobileMapTab = document.getElementById('btnMobileMapTab');
        const btnMobileInfoTab = document.getElementById('btnMobileInfoTab');

        // Mobile View Toggle Logic
        if (btnMobileMapTab && btnMobileInfoTab && mapContainerWrap) {
          btnMobileMapTab.addEventListener('click', () => {
            btnMobileInfoTab.classList.remove('active');
            btnMobileMapTab.classList.add('active');
            mapContainerWrap.classList.remove('show-info-mobile');
            mapContainerWrap.classList.add('show-map-mobile');
            invalidateMapSize();
            setTimeout(invalidateMapSize, 150);
            setTimeout(invalidateMapSize, 400);
          });

          btnMobileInfoTab.addEventListener('click', () => {
            btnMobileMapTab.classList.remove('active');
            btnMobileInfoTab.classList.add('active');
            mapContainerWrap.classList.remove('show-map-mobile');
            mapContainerWrap.classList.add('show-info-mobile');
          });
        }

        // Styles
        function getBorderColor() {
          if (currentBasemapType === 'satellite') return '#ffffff';
          return document.body.classList.contains('light-mode') ? '#1e293b' : '#ffffff';
        }

        function getHoverBorderColor() {
          return 'var(--accent-cyan)';
        }

        // Color coding function for Desa
        function getDesaColor(iddesa) {
          const stat = desaStats.find(s => s.iddesa === iddesa);
          if (!stat) return '#94a3b8'; // gray for no data
          const pct = stat.target_fasih_total ? ((stat.submitted_total + stat.approved_total + stat.rejected_total) / stat.target_fasih_total) * 100 : 0;
          if (pct >= 100) return '#10b981'; // Green
          if (pct >= 75) return '#0284c7';  // Blue
          if (pct >= 25) return '#eab308';  // Yellow
          if (pct > 0) return '#f97316';    // Orange
          return '#ef4444';                 // Red
        }

        // Single-hue primary color gradient function for SLS
        function getSlsColor(kode) {
          const stat = slsStats.find(s => s.kode === kode);
          if (!stat) return '#cbd5e1'; // gray
          
          let pct = 0;
          if (!isSakernasMap && typeof settings !== 'undefined' && settings.show_progres_muatan === '1') {
            pct = parseFloat(stat.muatan_pct_str || 0);
          } else {
            pct = parseFloat(stat.fasih_pct_str || 0);
            if (!pct && stat.target_fasih) {
              const real = (stat.submitted_by_pcl || 0) + (stat.approved || 0) + (stat.rejected || 0);
              pct = (real / stat.target_fasih) * 100;
            }
          }

          if (stat.selesai === 1) return '#10b981'; // Green (Selesai)
          if (pct >= 100) return '#1e40af'; // Deep Primary Blue (100% Progres)
          if (pct >= 75) return '#2563eb';  // Primary Royal Blue (75-99%)
          if (pct >= 50) return '#3b82f6';  // Bright Blue (50-74%)
          if (pct >= 25) return '#60a5fa';  // Medium Blue (25-49%)
          if (pct > 0) return '#93c5fd';    // Soft Light Blue (1-24%)
          return '#cbd5e1';                 // Muted Gray (0% Belum Ada Isian)
        }

        // Color coding function for Kecamatan
        function getKecColor(nmkec) {
          const stat = kecStats.find(k => k.kecamatan && k.kecamatan.toUpperCase() === nmkec.toUpperCase());
          if (!stat) return '#94a3b8';
          const pct = parseFloat(stat.fasih_pct_str || 0);
          if (pct >= 100) return '#10b981'; // Green
          if (pct >= 75) return '#0284c7';  // Blue
          if (pct >= 25) return '#eab308';  // Yellow
          if (pct > 0) return '#f97316';    // Orange
          return '#ef4444';                 // Red
        }

        // Styles for layers with ultra-crisp reduced outline thickness & Outline Only mode
        function kecStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          if (isOutlineOnlyMode) {
            return {
              fillColor: 'transparent',
              weight: isSelectedKec ? 2.0 : 0.6,
              opacity: isSelectedKec ? 1 : 0.15,
              color: currentBasemapType === 'satellite' ? '#38bdf8' : 'var(--accent-blue)',
              fillOpacity: 0,
              fillRule: 'nonzero'
            };
          }
          return {
            fillColor: getKecColor(feature.properties.nmkec),
            weight: 1.5,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.50 : 0.42) : 0.02,
            fillRule: 'nonzero'
          };
        }

        function desaStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          if (isOutlineOnlyMode) {
            return {
              fillColor: 'transparent',
              weight: isSelectedKec ? 1.0 : 0.3,
              opacity: isSelectedKec ? 1 : 0.15,
              color: currentBasemapType === 'satellite' ? '#38bdf8' : 'var(--accent-blue)',
              fillOpacity: 0,
              fillRule: 'nonzero'
            };
          }
          return {
            fillColor: getDesaColor(feature.properties.iddesa),
            weight: 0.6,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.45 : 0.38) : 0.02,
            fillRule: 'nonzero'
          };
        }

        function slsStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          if (isOutlineOnlyMode) {
            return {
              fillColor: 'transparent',
              weight: isSelectedKec ? 0.7 : 0.2,
              opacity: isSelectedKec ? 1 : 0.15,
              color: currentBasemapType === 'satellite' ? '#a7f3d0' : '#059669',
              fillOpacity: 0,
              fillRule: 'nonzero'
            };
          }
          return {
            fillColor: getSlsColor(feature.properties.kode),
            weight: 0.35,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.45 : 0.38) : 0.02,
            fillRule: 'nonzero'
          };
        }

        // Highlight features on hover with refined border width
        function highlightFeature(e) {
          const layer = e.target;
          layer.setStyle({
            weight: 1.5,
            color: getHoverBorderColor(),
            fillOpacity: 0.85
          });
          // Note: We deliberately do NOT call layer.bringToFront() here because features are already
          // pre-sorted by area descending (largest first -> smallest last). Not calling bringToFront()
          // preserves the natural DOM stacking order where smaller enclosed SLS features remain on top
          // and receive all mouse click/hover events without being blocked by larger container features.
        }

        function resetHighlightKec(e) {
          if (kecLayer) kecLayer.resetStyle(e.target);
        }

        function resetHighlightDesa(e) {
          if (desaLayer) desaLayer.resetStyle(e.target);
        }

        function resetHighlightSls(e) {
          if (slsLayer) slsLayer.resetStyle(e.target);
        }

        // Top Statistics Calculator
        function updateTopStats(statsList) {
          if (!statsList || !statsList.length) return;
          const totalDesa = statsList.length;
          const totalSls = statsList.reduce((sum, d) => sum + (d.total_subsls || 0), 0);
          const selesaiSls = statsList.reduce((sum, d) => sum + (d.selesai || 0), 0);
          const pctSelesai = totalSls ? ((selesaiSls / totalSls) * 100).toFixed(1) : '0.0';

          const totalTargetFasih = statsList.reduce((sum, d) => sum + (d.target_fasih_total || 0), 0);
          const totalRealisasiFasih = statsList.reduce((sum, d) => sum + ((d.submitted_total || 0) + (d.approved_total || 0) + (d.rejected_total || 0)), 0);
          const pctFasih = totalTargetFasih ? ((totalRealisasiFasih / totalTargetFasih) * 100).toFixed(1) : '0.0';

          const statSls = document.getElementById('statSlsSelesai');
          const statFasih = document.getElementById('statProgresFasih');
          const statWilayah = document.getElementById('statTotalWilayah');

          if (statSls) statSls.textContent = `${selesaiSls.toLocaleString('id-ID')} / ${totalSls.toLocaleString('id-ID')} SLS (${pctSelesai}%)`;
          if (statFasih) statFasih.textContent = `${pctFasih}%`;
          if (statWilayah) statWilayah.textContent = `4 Kec / ${totalDesa} Desa`;
        }

        // Fit map bounds to filtered subdistrict
        function fitBoundsToKecamatan(kecName) {
          if (!kecName) {
            map.setView(centerCoords, defaultZoom);
            return;
          }

          const bounds = L.latLngBounds();
          const targetLayer = activeLayerName === 'kec' ? kecLayer : (activeLayerName === 'desa' ? desaLayer : slsLayer);
          
          if (targetLayer) {
            targetLayer.eachLayer(layer => {
              if (layer.feature.properties.nmkec === kecName) {
                if (layer.getBounds) {
                  bounds.extend(layer.getBounds());
                } else if (layer.getLatLng) {
                  bounds.extend(layer.getLatLng());
                }
              }
            });
            
            if (bounds.isValid()) {
              map.fitBounds(bounds, { padding: [30, 30] });
            }
          }
        }

