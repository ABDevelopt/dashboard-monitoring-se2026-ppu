            <!-- Progress Bar Vis -->
            <div style="background: var(--bg-secondary); padding: 10px; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 10px;">
              <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 600; margin-bottom: 4px;">
