                gpsToastText.innerHTML = `<i class="bi bi-exclamation-circle-fill" style="color: #ef4444;"></i> Gagal Mengunci GPS (${err.message || 'Izin ditolak'})`;
                setTimeout(() => {
                  gpsToast.classList.remove('show');
