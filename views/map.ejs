            </div>
            <div class="map-card-stat muatan-col">
              <span class="map-card-label">Progres Muatan</span>
              <span class="map-card-value">${pct}%</span>
            </div>
            <div class="map-card-stat muatan-col">
              <span class="map-card-label">Muatan Target</span>
              <span class="map-card-value">${totalMuatan.toLocaleString('id-ID')}</span>
            </div>
            <div class="map-card-stat muatan-col">
              <span class="map-card-label">Total Usaha Terdata</span>
              <span class="map-card-value">${usaha.toLocaleString('id-ID')}</span>
            </div>
            <div class="map-card-stat muatan-col">
              <span class="map-card-label">Total Keluarga Terdata</span>
              <span class="map-card-value">${keluarga.toLocaleString('id-ID')}</span>
            </div>

            <!-- Integrated Drilldown Navigation Links -->
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 14px;">
              <button class="btn btn-primary btn-xs" id="btnFocusDesa" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 6px; padding: 6px 10px;">
                <i class="bi bi-search"></i> Zoom &amp; Tampilkan Batas SLS
              </button>
              <a href="/subsls?kec=${encodeURIComponent(properties.nmkec)}&desa=${encodeURIComponent(properties.nmdesa)}" class="btn btn-secondary btn-xs" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 6px 10px; text-decoration: none;">
                <i class="bi bi-table"></i> Drilldown Tabel SLS Desa ${properties.nmdesa}
              </a>
              <a href="/kecamatan?kec=${encodeURIComponent(properties.nmkec)}" class="btn btn-secondary btn-xs" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 6px 10px; text-decoration: none;">
                <i class="bi bi-diagram-3"></i> Drilldown Kec. ${properties.nmkec}
              </a>
