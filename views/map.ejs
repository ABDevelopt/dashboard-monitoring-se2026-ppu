          const fasihPct = targetFasih ? Math.min(parseFloat(((realisasiFasih / targetFasih) * 100).toFixed(2)), 100) : 0;

          sidebarStats.innerHTML = `
            <div style="font-size: 13px; font-weight: 700; margin-bottom: 2px; color: var(--accent-blue); flex-wrap: wrap;"><i class="bi bi-box-seam"></i> SLS: ${properties.nmsls}</div>
            <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 10px;">Desa ${properties.nmdesa}, Kec. ${properties.nmkec}</div>
            
            <div class="map-card-stat">
              <span class="map-card-label">Kode SLS</span>
              <span class="map-card-value" style="font-family: monospace; font-size: 11px;">${properties.kode}</span>
            </div>
            <div class="map-card-stat">
              <span class="map-card-label">Status Target FASIH</span>
              <span class="map-card-value">${isSelesai ? '<span class="badge badge-green btn-xs">Tercapai</span>' : '<span class="badge badge-red btn-xs">Belum Tercapai</span>'}</span>
            </div>
            <div class="map-card-stat">
              <span class="map-card-label">Petugas PCL</span>
              <span class="map-card-value">${pcl}</span>
            </div>
            <div class="map-card-stat">
              <span class="map-card-label">Pengawas PML</span>
              <span class="map-card-value">${pml}</span>
            </div>
            <div class="map-card-stat">
              <span class="map-card-label">Atasan Korlap</span>
              <span class="map-card-value">${korlap}</span>
            </div>
            <div class="map-card-stat">
              <span class="map-card-label">Target FASIH</span>
              <span class="map-card-value">${targetFasih.toLocaleString('id-ID')}</span>
            </div>
            <div class="map-card-stat">
              <span class="map-card-label">Realisasi FASIH</span>
              <span class="map-card-value">${realisasiFasih.toLocaleString('id-ID')} (${fasihPct}%)</span>
            </div>
            <div class="map-card-stat">
              <span class="map-card-label">Rincian Status</span>
              <span class="map-card-value" style="font-size: 11px;">D: ${draft} | S: ${submitted} | A: ${approved} | R: ${rejected}</span>
            </div>
            <div class="map-card-stat muatan-col">
              <span class="map-card-label">Target Muatan</span>
              <span class="map-card-value">${muatan}</span>
            </div>
            <div class="map-card-stat muatan-col">
              <span class="map-card-label">Usaha Terdata</span>
              <span class="map-card-value">${usaha.toLocaleString('id-ID')}</span>
            </div>
            <div class="map-card-stat muatan-col">
              <span class="map-card-label">Keluarga Terdata</span>
              <span class="map-card-value">${keluarga.toLocaleString('id-ID')}</span>
            </div>

            <!-- Integrated Drilldown Action Links for SLS -->
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 14px;">
              <a href="/subsls?search=${encodeURIComponent(properties.kode)}" class="btn btn-secondary btn-xs" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 6px 10px; text-decoration: none;">
                <i class="bi bi-table"></i> Buka Tabel SLS (${properties.kode})
              </a>
              ${(pcl && pcl !== 'Belum Ditentukan') ? `
                <a href="/pcl?pcl=${encodeURIComponent(pcl)}" class="btn btn-secondary btn-xs" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 6px 10px; text-decoration: none;">
                  <i class="bi bi-person"></i> Drilldown PCL (${pcl})
                </a>
              ` : ''}
            </div>
          `;
        }

        // Initialize Map GeoJSON layers
        function setupDesaLayer() {
          desaLayer = L.geoJSON(desaGeoJson, {
            style: desaStyle,
            onEachFeature: (feature, layer) => {
              layer.on({
                mouseover: highlightFeature,
                mouseout: resetHighlightDesa,
                click: (e) => {
                  showDesaDetails(feature.properties);
                  
                  // Open popup
                  const stat = desaStats.find(s => s.iddesa === feature.properties.iddesa);
                  const total = stat ? stat.total_subsls : 0;
                  const selesai = stat ? stat.selesai : 0;
                  const targetFasih = stat ? stat.target_fasih_total : 0;
                  const submitted = stat ? stat.submitted_total : 0;
                  const approved = stat ? stat.approved_total : 0;
                  const rejected = stat ? stat.rejected_total : 0;
                  const totalRealisasiFasih = submitted + approved + rejected;
                  const fasihPct = targetFasih ? Math.min(parseFloat(((totalRealisasiFasih / targetFasih) * 100).toFixed(2)), 100) : 0;
                  const totalMuatan = stat ? stat.total_muatan : 0;
                  const usaha = stat ? stat.usaha_total : 0;
                  const pct = totalMuatan ? ((usaha / totalMuatan) * 100).toFixed(2) : '0.00';
                  
                  const popupHtml = `
                    <div style="font-family: 'Inter', sans-serif; min-width: 190px; padding: 2px;">
                      <strong style="font-size: 13px; color: var(--text-primary);">Desa ${feature.properties.nmdesa}</strong><br>
                      <span style="font-size: 11px; color: var(--text-secondary);">Kec. ${feature.properties.nmkec}</span>
                      <table class="info-table">
                        <tr><td class="label">SLS Selesai</td><td class="value">${selesai} / ${total} SLS</td></tr>
                        <tr><td class="label">Progres FASIH</td><td class="value" style="color: ${fasihPct >= 100 ? 'var(--accent-green)' : 'var(--accent-blue)'};">${fasihPct}%</td></tr>
                        <tr class="muatan-col"><td class="label">Progres Muatan</td><td class="value">${pct}%</td></tr>
                      </table>
                      <div style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
                        <a href="/subsls?kec=${encodeURIComponent(feature.properties.nmkec)}&desa=${encodeURIComponent(feature.properties.nmdesa)}" class="btn btn-primary btn-xs" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 4px 8px; font-size: 10px; text-decoration: none;">
                          <i class="bi bi-arrow-right-circle"></i> Buka Drilldown Wilayah
                        </a>
                      </div>
                    </div>
                  `;
                  layer.bindPopup(popupHtml).openPopup();
                }
              });
            }
          });
        }

        function setupSlsLayer() {
          slsLayer = L.geoJSON(slsGeoJson, {
            style: slsStyle,
            onEachFeature: (feature, layer) => {
              layer.on({
                mouseover: highlightFeature,
                mouseout: resetHighlightSls,
                click: (e) => {
                  showSlsDetails(feature.properties);
                  
                  const stat = slsStats.find(s => s.kode === feature.properties.kode);
                  const status = stat && stat.selesai === 1 ? 'Target Tercapai' : 'Belum Tercapai';
                  const targetFasih = stat ? stat.target_fasih : 0;
                  const submitted = stat ? stat.submitted_by_pcl : 0;
                  const approved = stat ? stat.approved : 0;
                  const rejected = stat ? stat.rejected : 0;
                  const realisasiFasih = submitted + approved + rejected;
                  const fasihPct = targetFasih ? Math.min(parseFloat(((realisasiFasih / targetFasih) * 100).toFixed(2)), 100) : 0;
                  
                  const popupHtml = `
                    <div style="font-family: 'Inter', sans-serif; min-width: 190px; padding: 2px;">
                      <strong style="font-size: 13px; color: var(--text-primary);">${feature.properties.nmsls}</strong><br>
                      <span style="font-size: 11px; color: var(--text-secondary);">${feature.properties.nmdesa}, ${feature.properties.nmkec}</span>
                      <table class="info-table">
                        <tr><td class="label">PCL</td><td class="value">${stat ? stat.pcl : '-'}</td></tr>
                        <tr><td class="label">Status Target</td><td class="value" style="color: ${status === 'Target Tercapai' ? 'var(--accent-green)' : 'var(--accent-red)'}">${status}</td></tr>
                        <tr><td class="label">FASIH %</td><td class="value">${fasihPct}% (${realisasiFasih}/${targetFasih})</td></tr>
                        <tr class="muatan-col"><td class="label">Usaha</td><td class="value">${stat ? stat.usaha_total : 0}</td></tr>
                      </table>
                      <div style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
                        <a href="/subsls?search=${encodeURIComponent(feature.properties.kode)}" class="btn btn-primary btn-xs" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 4px 8px; font-size: 10px; text-decoration: none;">
                          <i class="bi bi-arrow-right-circle"></i> Detail SubSLS (${feature.properties.kode})
                        </a>
                      </div>
                    </div>
                  `;
                  layer.bindPopup(popupHtml).openPopup();
                }
              });
            }
          });
        }

        // Asynchronous bootstrap sequence
        async function bootstrap() {
          try {
            // Step 1: load real-time stats and Desa geojson in parallel
            const [statsRes, desaGeoRes] = await Promise.all([
              fetch('/api/map-stats'),
              fetch('/data/desa_boundaries.geojson')
            ]);
            
            const stats = await statsRes.json();
            desaStats = stats.desaStats;
            slsStats = stats.slsStats;
            desaGeoJson = await desaGeoRes.json();

            // Update top KPI cards
            updateTopStats(desaStats);

            // Setup Desa boundary mapping layer
            setupDesaLayer();
            desaLayer.addTo(map);

            // Hide initial loading screen
            loadingOverlay.style.opacity = '0';
            setTimeout(() => { loadingOverlay.style.display = 'none'; }, 300);

            // Lazy load high-detail SLS boundaries in background
            lazyLoadSlsGeoJSON();

          } catch (err) {
            console.error('Error bootstrapping map:', err);
            loadingText.innerHTML = '<span style="color: var(--accent-red);"><i class="bi bi-exclamation-triangle"></i> Gagal Memuat Data Spasial. Coba refresh halaman.</span>';
          }
        }

        async function lazyLoadSlsGeoJSON() {
          try {
            const res = await fetch('/data/sls_boundaries.geojson');
            slsGeoJson = await res.json();
            setupSlsLayer();
          } catch (err) {
            console.error('Error lazy loading SLS geojson:', err);
          }
        }

        // Layer Toggling Logic
        function switchToDesaLayer() {
          activeLayerName = 'desa';
          btnLayerSls.classList.remove('active');
          btnLayerSls.setAttribute('aria-pressed', 'false');
          btnLayerDesa.classList.add('active');
          btnLayerDesa.setAttribute('aria-pressed', 'true');
          legendSls.style.display = 'none';
          legendDesa.style.display = 'block';

          if (slsLayer && map.hasLayer(slsLayer)) map.removeLayer(slsLayer);
          if (desaLayer) {
            desaLayer.addTo(map);
            desaLayer.setStyle(desaStyle);
          }
        }

        function switchToSlsLayer() {
          if (!slsGeoJson) {
            alert('Data batas SLS sedang diunduh di latar belakang. Silakan tunggu beberapa detik...');
            return;
          }
          activeLayerName = 'sls';
          btnLayerDesa.classList.remove('active');
          btnLayerDesa.setAttribute('aria-pressed', 'false');
          btnLayerSls.classList.add('active');
          btnLayerSls.setAttribute('aria-pressed', 'true');
          legendDesa.style.display = 'none';
          legendSls.style.display = 'block';

          if (desaLayer && map.hasLayer(desaLayer)) map.removeLayer(desaLayer);
          if (slsLayer) {
            slsLayer.addTo(map);
            slsLayer.setStyle(slsStyle);
          }
        }

        btnLayerDesa.addEventListener('click', switchToDesaLayer);
        btnLayerSls.addEventListener('click', switchToSlsLayer);

        // Basemap Switcher Listeners
        btnBasemapDefault.addEventListener('click', () => {
          currentBasemapType = 'default';
          btnBasemapSatellite.classList.remove('active');
          btnBasemapDefault.classList.add('active');
          updateBasemap();
          if (desaLayer) desaLayer.setStyle(desaStyle);
          if (slsLayer) slsLayer.setStyle(slsStyle);
        });

        btnBasemapSatellite.addEventListener('click', () => {
          currentBasemapType = 'satellite';
          btnBasemapDefault.classList.remove('active');
          btnBasemapSatellite.classList.add('active');
          updateBasemap();
          if (desaLayer) desaLayer.setStyle(desaStyle);
          if (slsLayer) slsLayer.setStyle(slsStyle);
        });

        // Filter Dropdown Listener
        kecFilter.addEventListener('change', (e) => {
          currentFilteredKec = e.target.value;
          
          if (desaLayer) desaLayer.setStyle(desaStyle);
          if (slsLayer) slsLayer.setStyle(slsStyle);

          fitBoundsToKecamatan(currentFilteredKec);
        });

        // Reset View Button
        btnResetView.addEventListener('click', () => {
          kecFilter.value = '';
          currentFilteredKec = '';
          if (mapSearchInput) mapSearchInput.value = '';
          map.setView(centerCoords, defaultZoom);
          if (desaLayer) desaLayer.setStyle(desaStyle);
          if (slsLayer) slsLayer.setStyle(slsStyle);
        });

        // Search Input Listener with auto-focus/highlight
        if (mapSearchInput) {
          mapSearchInput.addEventListener('input', (e) => {
            const q = e.target.value.toLowerCase().trim();
            if (!q) {
              if (desaLayer) desaLayer.setStyle(desaStyle);
              if (slsLayer) slsLayer.setStyle(slsStyle);
              return;
            }

            let foundBounds = L.latLngBounds();
            let hasMatch = false;

            if (activeLayerName === 'desa' && desaLayer) {
              desaLayer.eachLayer(layer => {
                const nmdesa = (layer.feature.properties.nmdesa || '').toLowerCase();
                const nmkec = (layer.feature.properties.nmkec || '').toLowerCase();
                if (nmdesa.includes(q) || nmkec.includes(q)) {
                  layer.bringToFront();
                  layer.setStyle({ weight: 3, color: 'var(--accent-cyan)', fillOpacity: 0.85 });
                  if (layer.getBounds) foundBounds.extend(layer.getBounds());
                  hasMatch = true;
                } else {
                  layer.setStyle({ opacity: 0.1, fillOpacity: 0.05 });
                }
              });
            } else if (activeLayerName === 'sls' && slsLayer) {
              slsLayer.eachLayer(layer => {
                const nmsls = (layer.feature.properties.nmsls || '').toLowerCase();
                const nmdesa = (layer.feature.properties.nmdesa || '').toLowerCase();
                const kode = (layer.feature.properties.kode || '').toLowerCase();
                if (nmsls.includes(q) || nmdesa.includes(q) || kode.includes(q)) {
                  layer.bringToFront();
                  layer.setStyle({ weight: 3, color: 'var(--accent-cyan)', fillOpacity: 0.85 });
                  if (layer.getBounds) foundBounds.extend(layer.getBounds());
                  hasMatch = true;
                } else {
                  layer.setStyle({ opacity: 0.1, fillOpacity: 0.05 });
                }
              });
            }

            if (hasMatch && foundBounds.isValid()) {
              map.fitBounds(foundBounds, { padding: [40, 40] });
            }
          });
        }

        // Initialize!
        bootstrap();
      });
    </script>
</div>
