              <div class="map-card-stat-item">
                <span class="map-card-stat-label"><i class="bi bi-check2-circle" style="color: var(--accent-green);"></i> Target Selesai</span>
                <span class="map-card-stat-value" style="color: var(--accent-green);">${stat.selesai || 0} SLS</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-pie-chart" style="color: var(--accent-cyan);"></i> Progres Muatan</span>
                <span class="map-card-stat-value">${stat.muatan_pct_str || '0.00'}%</span>
              </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="map-drawer-actions">
              <button class="btn btn-primary btn-sm" onclick="fitBoundsToKecamatan('${nmkec}')" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px; padding: 9px 14px; font-weight: 700; font-size: 13px; border-radius: 8px;">
                <i class="bi bi-search"></i> Zoom Wilayah Kecamatan
              </button>
              <div class="map-action-btn-group">
                <a href="<%= navPrefix %>/kecamatan?kec=${encodeURIComponent(nmkec)}" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 12px; text-decoration: none; font-size: 12.5px; font-weight: 600; border-radius: 8px;">
                  <i class="bi bi-diagram-3"></i> Halaman Drilldown Kec.
                </a>
              </div>
            </div>

            ${desaListHtml}
          `;
        }

        // Show details in Sidebar + Integrated Drilldown Links
        function showDesaDetails(properties) {
          if (!properties) return;
          const stat = desaStats.find(s => s.iddesa === properties.iddesa);
          const total = stat ? stat.total_subsls : 0;
          const selesai = stat ? stat.selesai : 0;
          const totalMuatan = stat ? (stat.total_muatan !== undefined ? stat.total_muatan : (properties.total_muatan || 0)) : (properties.total_muatan || 0);
          const muatanSelesai = stat ? (stat.muatan_selesai !== undefined ? stat.muatan_selesai : ((stat.usaha_total || 0) + (stat.keluarga_total || 0))) : 0;
          const pct = stat ? (stat.muatan_pct_str || '0.00') : (totalMuatan ? ((muatanSelesai / totalMuatan) * 100).toFixed(2) : '0.00');
          const usaha = stat ? (stat.usaha_total || 0) : 0;
          const keluarga = stat ? (stat.keluarga_total || 0) : 0;

          // FASIH Capaian
          const targetFasih = stat ? stat.target_fasih_total : 0;
          const submitted = stat ? stat.submitted_total : 0;
          const approved = stat ? stat.approved_total : 0;
          const rejected = stat ? stat.rejected_total : 0;
          const totalRealisasiFasih = submitted + approved + rejected;
          const fasihPct = targetFasih ? Math.min(parseFloat(((totalRealisasiFasih / targetFasih) * 100).toFixed(2)), 100) : 0;
          const fasihColor = fasihPct >= 100 ? '#10b981' : (fasihPct < 25 ? '#ef4444' : '#3b82f6');
          const isComplete = fasihPct >= 100;

          // Render SubSLS list for this Desa
          const desaSubslsList = slsStats.filter(s => s.desa && properties.nmdesa && String(s.desa).toUpperCase() === String(properties.nmdesa).toUpperCase());
          let subslsListHtml = '';

          if (desaSubslsList.length > 0) {
            subslsListHtml = `
              <div style="margin-top: 14px; border-top: 1px solid var(--border); padding-top: 12px;">
                <div style="font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
                  <span><i class="bi bi-grid-3x3-gap" style="color: var(--accent-purple);"></i> Visualisasi Progres ${desaSubslsList.length} SubSLS</span>
                </div>
                <div style="max-height: 280px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding-right: 4px;" id="detailSubslsList">
            `;

            desaSubslsList.forEach(item => {
              const fReal = (item.submitted_by_pcl || 0) + (item.approved || 0) + (item.rejected || 0);
              const fTgt = item.target_fasih || 0;
              const fPct = fTgt > 0 ? Math.min(parseFloat(((fReal / fTgt) * 100).toFixed(1)), 100) : 0;
              const fColor = fPct >= 100 ? '#10b981' : (fPct < 40 ? '#ef4444' : '#8b5cf6');

              const mReal = item.muatan_selesai || 0;
              const mTgt = item.total_muatan || item.muatan || 0;
              const mPct = mTgt > 0 ? Math.min(parseFloat(((mReal / mTgt) * 100).toFixed(1)), 100) : 0;

              let statusBadge = '<span class="badge badge-gray" style="font-size: 8px; padding: 1px 5px;">Belum Mulai</span>';
              if (item.sudah_diisi === 'sedang_didata') {
                statusBadge = '<span class="badge badge-orange" style="font-size: 8px; padding: 1px 5px;">Sedang Didata</span>';
              } else if (item.sudah_diisi === 'memenuhi_target') {
                statusBadge = '<span class="badge badge-purple" style="font-size: 8px; padding: 1px 5px;">Memenuhi Target</span>';
              } else if (item.sudah_diisi === 'selesai' || item.selesai === 1) {
                statusBadge = '<span class="badge badge-green" style="font-size: 8px; padding: 1px 5px;">Selesai</span>';
              }

              subslsListHtml += `
                <div class="subsls-map-item" data-kode="${item.kode}" onclick="if (window.focusSubSlsOnMap) window.focusSubSlsOnMap('${item.kode}')" style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; cursor: pointer; transition: all 0.15s ease;">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 6px; margin-bottom: 4px;">
                    <div>
                      <strong style="font-size: 11.5px; color: var(--text-primary); display: block;">${item.nama_sls}</strong>
                      <span style="font-size: 9.5px; color: var(--text-muted); font-family: monospace;">${item.kode} · PCL: ${item.pcl || '-'}</span>
                    </div>
                    ${statusBadge}
                  </div>
                  
                  <!-- FASIH Progress Track -->
                  <div style="margin-top: 4px;">
                    <div style="display: flex; justify-content: space-between; font-size: 9.5px; color: var(--text-secondary); margin-bottom: 2px;">
                      <span>FASIH: <strong>${fReal} / ${fTgt}</strong></span>
                      <strong style="color: ${fColor}">${fPct}%</strong>
                    </div>
                    <div style="height: 4px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden;">
                      <div style="width: ${fPct}%; height: 100%; background: ${fColor}; border-radius: 99px;"></div>
                    </div>
                  </div>

                  ${(!isSakernasMap && typeof settings !== 'undefined' && settings.show_progres_muatan === '1') ? `
                    <!-- Muatan Progress Track -->
                    <div style="margin-top: 4px;">
                      <div style="display: flex; justify-content: space-between; font-size: 9.5px; color: var(--text-secondary); margin-bottom: 2px;">
                        <span>Muatan: <strong>${mReal} / ${mTgt}</strong></span>
                        <strong style="color: var(--accent-cyan);">${mPct}%</strong>
                      </div>
                      <div style="height: 4px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden;">
                        <div style="width: ${mPct}%; height: 100%; background: var(--accent-cyan); border-radius: 99px;"></div>
                      </div>
                    </div>
                  ` : ''}
                </div>
              `;
            });

            subslsListHtml += `
                </div>
              </div>
            `;
          }

          sidebarStats.innerHTML = `
            <!-- Header Title Card -->
            <div style="background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2); padding: 10px 12px; border-radius: 10px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
              <div>
                <div style="font-size: 14.5px; font-weight: 800; color: var(--accent-blue); display: flex; align-items: center; gap: 6px;">
                  <i class="bi bi-geo-alt-fill"></i> Desa/Kel. ${properties.nmdesa}
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
                  Kecamatan ${properties.nmkec}
                </div>
              </div>
              <span class="badge ${isComplete ? 'badge-green' : 'badge-purple'}" style="font-size: 11px; padding: 4px 9px; flex-shrink: 0;">
                ${isComplete ? '<i class="bi bi-check-circle-fill"></i> 100% Selesai' : `${fasihPct}% FASIH`}
              </span>
            </div>

            <!-- Visual Progress Track -->
            <div style="background: var(--bg-secondary); padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border); margin-bottom: 12px;">
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 600; margin-bottom: 6px;">
                <span style="color: var(--text-primary);"><i class="bi bi-bar-chart-line" style="color: var(--accent-blue);"></i> Realisasi FASIH</span>
                <span style="color: ${fasihColor}; font-weight: 700;">${fasihPct}%</span>
              </div>
              <div class="progress-track-sm" style="height: 8px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden;">
                <div class="progress-bar ${fasihPct >= 100 ? 'green' : (fasihPct < 25 ? 'red' : 'purple')}" style="width: ${fasihPct}%; height: 100%; border-radius: 99px; transition: width 0.4s ease;"></div>
              </div>
              <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 6px; display: flex; justify-content: space-between;">
                <span>Realisasi: <strong style="color: var(--text-primary);">${totalRealisasiFasih.toLocaleString('id-ID')}</strong></span>
                <span>Target: <strong style="color: var(--text-primary);">${targetFasih.toLocaleString('id-ID')} Dok</strong></span>
              </div>
            </div>

            <!-- Metric Cards Grid -->
            <div class="map-card-stat-grid">
              <div class="map-card-stat-item">
                <span class="map-card-stat-label"><i class="bi bi-box-seam" style="color: var(--accent-blue);"></i> SubSLS</span>
                <span class="map-card-stat-value">${total} SLS</span>
              </div>
              <div class="map-card-stat-item">
                <span class="map-card-stat-label"><i class="bi bi-check2-circle" style="color: var(--accent-green);"></i> Target Selesai</span>
                <span class="map-card-stat-value" style="color: var(--accent-green);">${selesai} SLS</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-pie-chart" style="color: var(--accent-yellow);"></i> Progres Muatan</span>
                <span class="map-card-stat-value">${pct}%</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-flag" style="color: var(--accent-purple);"></i> Target Muatan</span>
                <span class="map-card-stat-value">${totalMuatan.toLocaleString('id-ID')}</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-shop" style="color: var(--accent-cyan);"></i> Usaha Terdata</span>
                <span class="map-card-stat-value">${usaha.toLocaleString('id-ID')}</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-people" style="color: var(--accent-green);"></i> Keluarga Terdata</span>
                <span class="map-card-stat-value">${keluarga.toLocaleString('id-ID')}</span>
              </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="map-drawer-actions">
              <button class="btn btn-primary btn-sm" id="btnFocusDesa" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px; padding: 9px 14px; font-weight: 700; font-size: 13px; border-radius: 8px;">
                <i class="bi bi-search"></i> Zoom &amp; Tampilkan Batas SLS
              </button>
              <div class="map-action-btn-group">
                <a href="<%= navPrefix %>/subsls?kec=${encodeURIComponent(properties.nmkec)}&desa=${encodeURIComponent(properties.nmdesa)}" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 12px; text-decoration: none; font-size: 12.5px; font-weight: 600; border-radius: 8px;">
                  <i class="bi bi-table"></i> Tabel SLS Desa
                </a>
                <a href="<%= navPrefix %>/kecamatan?kec=${encodeURIComponent(properties.nmkec)}" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 12px; text-decoration: none; font-size: 12.5px; font-weight: 600; border-radius: 8px;">
                  <i class="bi bi-diagram-3"></i> Detail Kec.
                </a>
              </div>
            </div>

            ${subslsListHtml}
          `;

          // Focus Desa Button Listener
          const focusBtn = document.getElementById('btnFocusDesa');
          if (focusBtn) {
            focusBtn.addEventListener('click', () => {
              fitBoundsToDesa(properties.iddesa);
            });
          }
        }

        function fitBoundsToDesa(iddesa) {
          let bounds = null;
          if (desaLayer) {
            desaLayer.eachLayer(layer => {
              if (layer.feature.properties.iddesa === iddesa) {
                bounds = layer.getBounds();
              }
            });
          }
          
          if (bounds) {
            map.fitBounds(bounds, { padding: [40, 40] });
            switchToSlsLayer();
          }
        }

        function showSlsDetails(properties) {
          if (!properties) return;
          const stat = slsStats.find(s => s.kode === properties.kode);
          const isSelesai = stat ? stat.selesai === 1 : false;
          const totalMuatan = stat ? (stat.total_muatan !== undefined ? stat.total_muatan : (stat.muatan || properties.muatan || 0)) : (properties.muatan || 0);
          const muatanSelesai = stat ? (stat.muatan_selesai !== undefined ? stat.muatan_selesai : ((stat.usaha_total || 0) + (stat.keluarga_total || 0))) : 0;
          const muatanPct = stat ? (stat.muatan_pct_str || '0.00') : (totalMuatan ? ((muatanSelesai / totalMuatan) * 100).toFixed(2) : '0.00');
          const usaha = stat ? (stat.usaha_total || 0) : 0;
          const keluarga = stat ? (stat.keluarga_total || 0) : 0;
          const pcl = stat ? stat.pcl : 'Belum Ditentukan';
          const pml = stat ? stat.pml : 'Belum Ditentukan';
          const korlap = stat ? stat.korlap : 'Belum Ditentukan';

          const targetFasih = stat ? stat.target_fasih : 0;
          const draft = stat ? stat.draft : 0;
          const submitted = stat ? stat.submitted_by_pcl : 0;
          const approved = stat ? stat.approved : 0;
          const rejected = stat ? stat.rejected : 0;
          const realisasiFasih = submitted + approved + rejected;
          const fasihPct = targetFasih ? Math.min(parseFloat(((realisasiFasih / targetFasih) * 100).toFixed(2)), 100) : 0;

          sidebarStats.innerHTML = `
            <!-- Header Title Card -->
            <div style="background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2); padding: 10px 12px; border-radius: 10px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
              <div>
                <div style="font-size: 14px; font-weight: 800; color: var(--accent-blue); display: flex; align-items: center; gap: 6px;">
                  <i class="bi bi-box-seam"></i> SLS: ${properties.nmsls}
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
                  Desa ${properties.nmdesa}, Kec. ${properties.nmkec}
                </div>
              </div>
              <span class="badge ${isSelesai ? 'badge-green' : 'badge-red'}" style="font-size: 11px; padding: 4px 9px; flex-shrink: 0;">
                ${isSelesai ? '<i class="bi bi-check-circle-fill"></i> Selesai' : '<i class="bi bi-hourglass-split"></i> Belum Selesai'}
              </span>
            </div>

            <!-- Status Breakdown Pills -->
            <div style="background: var(--bg-secondary); padding: 8px 10px; border-radius: 10px; border: 1px solid var(--border); margin-bottom: 12px;">
              <div style="font-size: 11.5px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; display: flex; justify-content: space-between;">
                <span>Rincian Status FASIH</span>
                <span style="color: var(--accent-blue); font-weight: 700;">${realisasiFasih} / ${targetFasih} Dok (${fasihPct}%)</span>
              </div>
              <div class="map-status-pills-row">
                <span class="map-status-pill approved" title="Approved / Di-approve"><i class="bi bi-check-lg"></i> App: ${approved}</span>
                <span class="map-status-pill submitted" title="Submitted by PCL"><i class="bi bi-send"></i> Sub: ${submitted}</span>
                <span class="map-status-pill rejected" title="Rejected"><i class="bi bi-x-lg"></i> Rej: ${rejected}</span>
                <span class="map-status-pill draft" title="Draft / Belum Di-submit"><i class="bi bi-file-earmark-text"></i> Draft: ${draft}</span>
              </div>
            </div>

            <!-- Metric Cards Grid -->
            <div class="map-card-stat-grid">
              <div class="map-card-stat-item full-width">
                <span class="map-card-stat-label"><i class="bi bi-qr-code" style="color: var(--accent-purple);"></i> Kode SLS</span>
                <span class="map-card-stat-value" style="font-family: monospace; font-size: 12px; color: var(--accent-cyan);">${properties.kode}</span>
              </div>
              <div class="map-card-stat-item">
                <span class="map-card-stat-label"><i class="bi bi-person-badge" style="color: var(--accent-blue);"></i> PCL</span>
                <span class="map-card-stat-value" title="${pcl}">${pcl}</span>
              </div>
              <div class="map-card-stat-item">
                <span class="map-card-stat-label"><i class="bi bi-person-check" style="color: var(--accent-green);"></i> PML</span>
                <span class="map-card-stat-value" title="${pml}">${pml}</span>
              </div>
              <div class="map-card-stat-item">
                <span class="map-card-stat-label"><i class="bi bi-person-workspace" style="color: var(--accent-yellow);"></i> Korlap</span>
                <span class="map-card-stat-value" title="${korlap}">${korlap}</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-pie-chart" style="color: var(--accent-yellow);"></i> Progres Muatan</span>
                <span class="map-card-stat-value">${muatanPct}%</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-target" style="color: var(--accent-red);"></i> Target Muatan</span>
                <span class="map-card-stat-value">${totalMuatan.toLocaleString('id-ID')}</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-shop" style="color: var(--accent-cyan);"></i> Usaha Terdata</span>
                <span class="map-card-stat-value">${usaha.toLocaleString('id-ID')}</span>
              </div>
              <div class="map-card-stat-item muatan-col">
                <span class="map-card-stat-label"><i class="bi bi-people" style="color: var(--accent-green);"></i> Keluarga Terdata</span>
                <span class="map-card-stat-value">${keluarga.toLocaleString('id-ID')}</span>
              </div>
            </div>

            <!-- Action Navigation Links -->
            <div class="map-drawer-actions">
              <div class="map-action-btn-group" style="grid-template-columns: ${(pcl && pcl !== 'Belum Ditentukan') ? '1fr 1fr' : '1fr'}; margin-bottom: 6px;">
                <a href="<%= navPrefix %>/subsls?search=${encodeURIComponent(properties.kode)}" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 10px; text-decoration: none; font-size: 11.5px; font-weight: 600; border-radius: 8px;">
                  <i class="bi bi-table"></i> Tabel SLS
                </a>
                ${(pcl && pcl !== 'Belum Ditentukan') ? `
                  <a href="<%= navPrefix %>/pcl?pcl=${encodeURIComponent(pcl)}" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 10px; text-decoration: none; font-size: 11.5px; font-weight: 600; border-radius: 8px;">
                    <i class="bi bi-person"></i> Detail PCL
                  </a>
                ` : ''}
              </div>
              ${(pcl && pcl !== 'Belum Ditentukan') ? `
                <button type="button" class="btn btn-primary btn-sm" onclick="highlightPclTerritory('${pcl.replace(/'/g, "\\'")}')" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 10px; font-size: 11.5px; font-weight: 600; border-radius: 8px; border: 1px solid rgba(59, 130, 246, 0.4); background: rgba(59, 130, 246, 0.15); color: var(--accent-blue); cursor: pointer;">
                  <i class="bi bi-funnel-fill"></i> Sorot Wilayah PCL (${pcl})
                </button>
              ` : ''}
            </div>
          `;
        }

        // Initialize Map GeoJSON layers
        function setupKecLayer() {
          if (!kecGeoJson) return;
          kecLayer = L.geoJSON(kecGeoJson, {
            style: kecStyle,
            onEachFeature: (feature, layer) => {
              layer._searchKey = (feature.properties.nmkec || '').toLowerCase();
              const stat = kecStats.find(k => k.kecamatan && k.kecamatan.toUpperCase() === feature.properties.nmkec.toUpperCase());
              const fasihPct = stat ? parseFloat(stat.fasih_pct_str || 0) : 0;
              const totalFasih = stat ? stat.target_fasih_total : 0;
              const realisasiFasih = stat ? ((stat.submitted_total || 0) + (stat.approved_total || 0) + (stat.rejected_total || 0)) : 0;
              const fasihColorClass = getFasihBadgeClass(fasihPct);

              // Bind Permanent On-Map Badge
              const labelHtml = `
                <div class="map-label-badge kec-label-badge ${showProgressLabels ? '' : 'd-none'}">
                  <div class="badge-pct-hero ${fasihColorClass}">${fasihPct.toFixed(1)}%</div>
                  <div class="badge-progress-track">
                    <div class="badge-progress-fill ${fasihColorClass}" style="width: ${Math.min(fasihPct, 100)}%;"></div>
                  </div>
                  <div class="badge-subname">${feature.properties.nmkec}</div>
                </div>
              `;
              layer.bindTooltip(labelHtml, {
                permanent: true,
                direction: 'center',
                className: 'map-polygon-label-tooltip'
              });

              layer.on({
                mouseover: highlightFeature,
                mouseout: resetHighlightKec,
                click: (e) => {
                  showKecDetails(feature.properties.nmkec);
                  
                  const popupHtml = `
                    <div style="font-family: 'Inter', sans-serif; min-width: 200px; padding: 2px;">
                      <strong style="font-size: 13.5px; color: var(--accent-blue);"><i class="bi bi-diagram-3-fill"></i> Kec. ${feature.properties.nmkec}</strong><br>
                      <span style="font-size: 11px; color: var(--text-secondary);">Kabupaten Penajam Paser Utara</span>
                      <table class="info-table">
                        <tr><td class="label">Progres FASIH</td><td class="value" style="color: ${fasihPct >= 100 ? 'var(--accent-green)' : 'var(--accent-blue)'};">${fasihPct}%</td></tr>
                        <tr><td class="label">Realisasi Dok.</td><td class="value">${realisasiFasih.toLocaleString('id-ID')} / ${totalFasih.toLocaleString('id-ID')}</td></tr>
                        <tr><td class="label">Total SLS</td><td class="value">${stat ? stat.total_subsls : 0} SLS</td></tr>
                      </table>
                      <div style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
                        <a href="<%= navPrefix %>/kecamatan?kec=${encodeURIComponent(feature.properties.nmkec)}" class="btn btn-primary btn-xs" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 4px 8px; font-size: 10px; text-decoration: none;">
                          <i class="bi bi-diagram-3"></i> Drilldown Kec. ${feature.properties.nmkec}
                        </a>
                      </div>
                    </div>
                  `;
                  layer.bindPopup(popupHtml).openPopup(e && e.latlng ? e.latlng : undefined);
                }
              });
            }
          });
        }

        function setupDesaLayer() {
          if (!desaGeoJson) return;
          desaLayer = L.geoJSON(desaGeoJson, {
            style: desaStyle,
            onEachFeature: (feature, layer) => {
              layer._searchKey = `${feature.properties.nmdesa || ''} ${feature.properties.nmkec || ''} ${feature.properties.iddesa || ''}`.toLowerCase();
              const stat = desaStats.find(s => s.iddesa === feature.properties.iddesa);
              const total = stat ? stat.total_subsls : 0;
              const selesai = stat ? stat.selesai : 0;
              const targetFasih = stat ? stat.target_fasih_total : 0;
              const submitted = stat ? stat.submitted_total : 0;
              const approved = stat ? stat.approved_total : 0;
              const rejected = stat ? stat.rejected_total : 0;
              const totalRealisasiFasih = submitted + approved + rejected;
              const fasihPct = targetFasih ? Math.min(parseFloat(((totalRealisasiFasih / targetFasih) * 100).toFixed(1)), 100) : 0;
              const totalMuatan = stat ? (stat.total_muatan !== undefined ? stat.total_muatan : 0) : 0;
              const muatanPct = stat ? (stat.muatan_pct_str || '0.00') : '0.00';
              const fasihColorClass = getFasihBadgeClass(fasihPct);

              // Bind Permanent On-Map Badge
              const labelHtml = `
                <div class="map-label-badge desa-label-badge ${showProgressLabels ? '' : 'd-none'}">
                  <div class="badge-pct-hero ${fasihColorClass}">${fasihPct.toFixed(1)}%</div>
                  <div class="badge-progress-track">
                    <div class="badge-progress-fill ${fasihColorClass}" style="width: ${Math.min(fasihPct, 100)}%;"></div>
                  </div>
                  <div class="badge-subname">${feature.properties.nmdesa}</div>
                </div>
              `;
              layer.bindTooltip(labelHtml, {
                permanent: true,
                direction: 'center',
                className: 'map-polygon-label-tooltip'
              });

              layer.on({
                mouseover: highlightFeature,
                mouseout: resetHighlightDesa,
                click: (e) => {
                  showDesaDetails(feature.properties);
                  
                  const popupHtml = `
                    <div style="font-family: 'Inter', sans-serif; min-width: 190px; padding: 2px;">
                      <strong style="font-size: 13px; color: var(--text-primary);">Desa ${feature.properties.nmdesa}</strong><br>
                      <span style="font-size: 11px; color: var(--text-secondary);">Kec. ${feature.properties.nmkec}</span>
                      <table class="info-table">
                        <tr><td class="label">SLS Selesai</td><td class="value">${selesai} / ${total} SLS</td></tr>
                        <tr><td class="label">Progres FASIH</td><td class="value" style="color: ${fasihPct >= 100 ? 'var(--accent-green)' : 'var(--accent-blue)'};">${fasihPct}%</td></tr>
                        <tr class="muatan-col"><td class="label">Progres Muatan</td><td class="value">${muatanPct}%</td></tr>
                      </table>
                      <div style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
                        <a href="<%= navPrefix %>/subsls?kec=${encodeURIComponent(feature.properties.nmkec)}&desa=${encodeURIComponent(feature.properties.nmdesa)}" class="btn btn-primary btn-xs" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 4px 8px; font-size: 10px; text-decoration: none;">
                          <i class="bi bi-arrow-right-circle"></i> Buka Drilldown Wilayah
                        </a>
                      </div>
                    </div>
                  `;
                  layer.bindPopup(popupHtml).openPopup(e && e.latlng ? e.latlng : undefined);
                }
              });
            }
          });
        }

        function setupSlsLayer() {
          if (!slsGeoJson) return;
          slsLayer = L.geoJSON(slsGeoJson, {
            style: slsStyle,
            onEachFeature: (feature, layer) => {
              const stat = slsStats.find(s => s.kode === feature.properties.kode);
              layer._searchKey = `${feature.properties.nmsls || ''} ${feature.properties.nmdesa || ''} ${feature.properties.nmkec || ''} ${feature.properties.kode || ''} ${stat ? stat.pcl || '' : ''} ${stat ? stat.pml || '' : ''}`.toLowerCase();
              layer.on({
                mouseover: highlightFeature,
                mouseout: resetHighlightSls,
                click: (e) => {
                  showSlsDetails(feature.properties);
                  
                  const stat = slsStats.find(s => s.kode === feature.properties.kode);
                  const status = stat && stat.selesai === 1 ? 'Selesai' : 'Belum Selesai';
                  const targetFasih = stat ? stat.target_fasih : 0;
                  const submitted = stat ? stat.submitted_by_pcl : 0;
                  const approved = stat ? stat.approved : 0;
                  const rejected = stat ? stat.rejected : 0;
                  const realisasiFasih = submitted + approved + rejected;
                  const fasihPct = targetFasih ? Math.min(parseFloat(((realisasiFasih / targetFasih) * 100).toFixed(2)), 100) : 0;
                  
                  const popupHtml = `
                    <div style="font-family: 'Inter', sans-serif; min-width: 210px; padding: 2px;">
                      <strong style="font-size: 13px; color: var(--text-primary);">${feature.properties.nmsls}</strong><br>
                      <span style="font-size: 11px; color: var(--text-secondary);">${feature.properties.nmdesa}, ${feature.properties.nmkec}</span>
                      
                      <!-- Mini Progress Bar inside Popup -->
                      <div style="margin-top: 6px; margin-bottom: 6px; background: var(--bg-secondary); padding: 6px 8px; border-radius: 6px; border: 1px solid var(--border);">
                        <div style="display: flex; justify-content: space-between; font-size: 10px; margin-bottom: 3px;">
                          <span style="font-weight: 600;">Progres FASIH</span>
                          <span style="font-weight: 700; color: ${fasihPct >= 100 ? 'var(--accent-green)' : (fasihPct < 40 ? 'var(--accent-red)' : 'var(--accent-purple)')}">${fasihPct}%</span>
                        </div>
                        <div style="height: 5px; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden; margin-bottom: 4px;">
                          <div class="progress-bar ${fasihPct >= 100 ? 'green' : (fasihPct < 40 ? 'red' : 'purple')}" style="width: ${fasihPct}%; height: 100%; border-radius: 99px;"></div>
                        </div>
                        <div style="font-size: 9.5px; color: var(--text-muted); display: flex; justify-content: space-between;">
                          <span>Realisasi: ${realisasiFasih}</span>
                          <span>Target: ${targetFasih} Dok</span>
                        </div>
                      </div>

                      <table class="info-table">
                        <tr><td class="label">PCL</td><td class="value">${stat ? stat.pcl : '-'}</td></tr>
                        <tr><td class="label">Status Target</td><td class="value" style="color: ${status === 'Selesai' ? 'var(--accent-green)' : 'var(--accent-red)'}">${status}</td></tr>
                        <tr class="muatan-col"><td class="label">Progres Muatan</td><td class="value">${stat ? (stat.muatan_pct_str || '0.00') : '0.00'}%</td></tr>
                        <tr class="muatan-col"><td class="label">Usaha / Keluarga</td><td class="value">${stat ? (stat.usaha_total || 0).toLocaleString('id-ID') : 0} / ${stat ? (stat.keluarga_total || 0).toLocaleString('id-ID') : 0}</td></tr>
                      </table>
                      <div style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 6px;">
                        <a href="<%= navPrefix %>/subsls?search=${encodeURIComponent(feature.properties.kode)}" class="btn btn-primary btn-xs" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 4px 8px; font-size: 10px; text-decoration: none;">
                          <i class="bi bi-arrow-right-circle"></i> Detail SubSLS (${feature.properties.kode})
                        </a>
                      </div>
                    </div>
                  `;
                  layer.bindPopup(popupHtml).openPopup(e && e.latlng ? e.latlng : undefined);
                }
              });
            }
          });
        }

        // Asynchronous bootstrap sequence
        async function bootstrap() {
          try {
            // Immediately render tile layer & recalculate canvas size
            updateBasemap();
            invalidateMapSize();

            // Step 1: load real-time stats, Desa geojson, and Kecamatan geojson in parallel
            const [statsRes, desaGeoRes, kecGeoRes] = await Promise.all([
              fetch('<%= typeof navPrefix !== "undefined" ? navPrefix : "" %>/api/map-stats'),
              fetch('/data/desa_boundaries.geojson'),
              fetch('/data/kecamatan_boundaries.geojson')
            ]);
            
            const stats = await statsRes.json();
            kecStats = stats.kecStats || [];
            desaStats = stats.desaStats || [];
            slsStats = stats.slsStats || [];
            desaGeoJson = await desaGeoRes.json();
            kecGeoJson = await kecGeoRes.json();

            // Update top KPI cards
            updateTopStats(desaStats);

            // Setup boundary mapping layers
            setupKecLayer();
            setupDesaLayer();

            if (activeLayerName === 'kec' && kecLayer) {
              kecLayer.addTo(map);
            } else if (desaLayer) {
              desaLayer.addTo(map);
            }

            // Position tile layer at back & recalculate map bounds
            updateBasemap();
            invalidateMapSize();

            // Hide initial loading screen
            if (loadingOverlay) {
              loadingOverlay.style.opacity = '0';
              setTimeout(() => { loadingOverlay.style.display = 'none'; }, 300);
            }

            // Lazy load high-detail SLS boundaries in background
            lazyLoadSlsGeoJSON();

          } catch (err) {
            console.error('Error bootstrapping map:', err);
            if (loadingOverlay) {
              loadingOverlay.style.opacity = '0';
              setTimeout(() => { loadingOverlay.style.display = 'none'; }, 300);
            }
            if (loadingText) {
              loadingText.innerHTML = '<span style="color: var(--accent-red);"><i class="bi bi-exclamation-triangle"></i> Gagal Memuat Data Spasial. Coba refresh halaman.</span>';
            }
          }
        }

        async function lazyLoadSlsGeoJSON() {
          try {
            const res = await fetch('/data/sls_boundaries.geojson');
            slsGeoJson = await res.json();
            setupSlsLayer();
          } catch (err) {
            console.error('Error lazy loading SLS geojson:', err);
          }
        }

        window.focusSubSlsOnMap = function(kode) {
          if (!slsGeoJson) {
            alert('Data peta SubSLS sedang dimuat. Harap tunggu sebentar...');
            return;
          }
          switchToSlsLayer();
          let targetLayer = null;
          if (slsLayer) {
            slsLayer.eachLayer(layer => {
              if (layer.feature && layer.feature.properties && layer.feature.properties.kode === kode) {
                targetLayer = layer;
              }
            });
          }
          if (targetLayer) {
            const bounds = targetLayer.getBounds ? targetLayer.getBounds() : null;
            if (bounds) map.fitBounds(bounds, { padding: [50, 50] });
            else if (targetLayer.getLatLng) map.setView(targetLayer.getLatLng(), 16);
            showSlsDetails(targetLayer.feature.properties);
            targetLayer.fire('click');
          }
        };

        window.focusDesaOnMap = function(iddesa) {
          switchToDesaLayer();
          let targetLayer = null;
          if (desaLayer) {
            desaLayer.eachLayer(layer => {
              if (layer.feature && layer.feature.properties && layer.feature.properties.iddesa === iddesa) {
                targetLayer = layer;
              }
            });
          }
          if (targetLayer) {
            const bounds = targetLayer.getBounds ? targetLayer.getBounds() : null;
            if (bounds) map.fitBounds(bounds, { padding: [40, 40] });
            showDesaDetails(targetLayer.feature.properties);
            targetLayer.fire('click');
          }
        };

        function updateActiveLayerStyles() {
          if (kecLayer && activeLayerName === 'kec') kecLayer.setStyle(kecStyle);
          if (desaLayer && activeLayerName === 'desa') desaLayer.setStyle(desaStyle);
          if (slsLayer && activeLayerName === 'sls') slsLayer.setStyle(slsStyle);
        }

        // Layer Toggling Logic
        function switchToKecLayer() {
          activeLayerName = 'kec';
          if (btnLayerSls) { btnLayerSls.classList.remove('active'); btnLayerSls.setAttribute('aria-pressed', 'false'); }
          if (btnLayerDesa) { btnLayerDesa.classList.remove('active'); btnLayerDesa.setAttribute('aria-pressed', 'false'); }
          if (btnLayerKec) { btnLayerKec.classList.add('active'); btnLayerKec.setAttribute('aria-pressed', 'true'); }
          
          if (legendDesa) legendDesa.style.display = 'none';
          if (legendSls) legendSls.style.display = 'none';
          if (legendKec) legendKec.style.display = 'block';

          if (slsLayer && map.hasLayer(slsLayer)) map.removeLayer(slsLayer);
          if (desaLayer && map.hasLayer(desaLayer)) map.removeLayer(desaLayer);
          if (kecLayer) {
            kecLayer.addTo(map);
            kecLayer.setStyle(kecStyle);
          }
        }

        function switchToDesaLayer() {
          activeLayerName = 'desa';
          if (btnLayerKec) { btnLayerKec.classList.remove('active'); btnLayerKec.setAttribute('aria-pressed', 'false'); }
          if (btnLayerSls) { btnLayerSls.classList.remove('active'); btnLayerSls.setAttribute('aria-pressed', 'false'); }
          if (btnLayerDesa) { btnLayerDesa.classList.add('active'); btnLayerDesa.setAttribute('aria-pressed', 'true'); }

          if (legendKec) legendKec.style.display = 'none';
          if (legendSls) legendSls.style.display = 'none';
          if (legendDesa) legendDesa.style.display = 'block';

          if (slsLayer && map.hasLayer(slsLayer)) map.removeLayer(slsLayer);
          if (kecLayer && map.hasLayer(kecLayer)) map.removeLayer(kecLayer);
          if (desaLayer) {
            desaLayer.addTo(map);
            desaLayer.setStyle(desaStyle);
          }
        }

        function switchToSlsLayer() {
          if (!slsGeoJson) {
            alert('Data batas SLS sedang diunduh di latar belakang. Silakan tunggu beberapa detik...');
            return;
          }
          activeLayerName = 'sls';
          if (btnLayerKec) { btnLayerKec.classList.remove('active'); btnLayerKec.setAttribute('aria-pressed', 'false'); }
          if (btnLayerDesa) { btnLayerDesa.classList.remove('active'); btnLayerDesa.setAttribute('aria-pressed', 'false'); }
          if (btnLayerSls) { btnLayerSls.classList.add('active'); btnLayerSls.setAttribute('aria-pressed', 'true'); }

          if (legendKec) legendKec.style.display = 'none';
          if (legendDesa) legendDesa.style.display = 'none';
          if (legendSls) legendSls.style.display = 'block';

          if (desaLayer && map.hasLayer(desaLayer)) map.removeLayer(desaLayer);
          if (kecLayer && map.hasLayer(kecLayer)) map.removeLayer(kecLayer);
          if (slsLayer) {
            slsLayer.addTo(map);
            slsLayer.setStyle(slsStyle);
          }
        }

        if (btnLayerKec) btnLayerKec.addEventListener('click', switchToKecLayer);
        if (btnLayerDesa) btnLayerDesa.addEventListener('click', switchToDesaLayer);
        if (btnLayerSls) btnLayerSls.addEventListener('click', switchToSlsLayer);

        if (btnOutlineOnly) {
          btnOutlineOnly.addEventListener('click', () => {
            isOutlineOnlyMode = !isOutlineOnlyMode;
            if (isOutlineOnlyMode) {
              btnOutlineOnly.classList.add('active');
              btnOutlineOnly.setAttribute('aria-pressed', 'true');
            } else {
              btnOutlineOnly.classList.remove('active');
              btnOutlineOnly.setAttribute('aria-pressed', 'false');
            }

            updateActiveLayerStyles();
          });
        }

        if (btnToggleLabels) {
          btnToggleLabels.addEventListener('click', () => {
            showProgressLabels = !showProgressLabels;
            if (showProgressLabels) {
              btnToggleLabels.classList.add('active');
              btnToggleLabels.setAttribute('aria-pressed', 'true');
              document.querySelectorAll('.map-label-badge').forEach(el => el.classList.remove('d-none'));
            } else {
              btnToggleLabels.classList.remove('active');
              btnToggleLabels.setAttribute('aria-pressed', 'false');
              document.querySelectorAll('.map-label-badge').forEach(el => el.classList.add('d-none'));
            }
          });
        }

        // Basemap Switcher Listeners
        btnBasemapDefault.addEventListener('click', () => {
          currentBasemapType = 'default';
          btnBasemapSatellite.classList.remove('active');
          btnBasemapDefault.classList.add('active');
          updateBasemap();
          updateActiveLayerStyles();
        });

        btnBasemapSatellite.addEventListener('click', () => {
          currentBasemapType = 'satellite';
          btnBasemapDefault.classList.remove('active');
          btnBasemapSatellite.classList.add('active');
          updateBasemap();
          updateActiveLayerStyles();
        });

        // Thematic Metric Switcher Listeners
        function switchThematicMetric(metric) {
          currentThematicMetric = metric;
          [btnMetricFasih, btnMetricMuatan, btnMetricReject].forEach(btn => {
            if (btn) btn.classList.remove('active');
          });

          if (metric === 'fasih' && btnMetricFasih) btnMetricFasih.classList.add('active');
          else if (metric === 'muatan' && btnMetricMuatan) btnMetricMuatan.classList.add('active');
          else if (metric === 'reject' && btnMetricReject) btnMetricReject.classList.add('active');

          updateActiveLayerStyles();
        }

        if (btnMetricFasih) btnMetricFasih.addEventListener('click', () => switchThematicMetric('fasih'));
        if (btnMetricMuatan) btnMetricMuatan.addEventListener('click', () => switchThematicMetric('muatan'));
        if (btnMetricReject) btnMetricReject.addEventListener('click', () => switchThematicMetric('reject'));

        // GPS Geolocation Listener
        function locateUserGPS() {
          if (!navigator.geolocation) {
            alert('Perangkat atau browser Anda tidak mendukung Geolocation GPS.');
            return;
          }

          if (btnLocateMe) {
            btnLocateMe.innerHTML = '<span class="spinner-border spinner-border-sm" style="width: 11px; height: 11px; border-width: 2px;"></span>';
          }

          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const lat = pos.coords.latitude;
              const lng = pos.coords.longitude;
              const accuracy = pos.coords.accuracy;

              if (btnLocateMe) {
                btnLocateMe.innerHTML = '<i class="bi bi-crosshair"></i>';
                btnLocateMe.style.color = 'var(--accent-cyan)';
              }

              if (userLocationMarker) map.removeLayer(userLocationMarker);
              if (userAccuracyCircle) map.removeLayer(userAccuracyCircle);

              const gpsIcon = L.divIcon({
                className: 'gps-user-marker',
                iconSize: [16, 16],
                iconAnchor: [8, 8]
              });

              userLocationMarker = L.marker([lat, lng], { icon: gpsIcon }).addTo(map);
              userLocationMarker.bindPopup(`
                <div style="font-family: 'Inter', sans-serif; padding: 2px;">
                  <strong style="color: var(--accent-blue);"><i class="bi bi-geo-alt-fill"></i> Posisi GPS Anda</strong><br>
                  <span style="font-size: 11px; color: var(--text-muted);">Akurasi: ±${Math.round(accuracy)} meter</span>
                </div>
              `).openPopup();

              userAccuracyCircle = L.circle([lat, lng], {
                radius: accuracy,
                color: '#0284c7',
                fillColor: '#0284c7',
                fillOpacity: 0.12,
                weight: 1.5
              }).addTo(map);

              map.setView([lat, lng], 16, { animate: true });
            },
            (err) => {
              if (btnLocateMe) btnLocateMe.innerHTML = '<i class="bi bi-crosshair"></i>';
              alert('Gagal mendapatkan lokasi GPS: ' + (err.message || 'Izin lokasi tidak diberikan.'));
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
          );
        }

        if (btnLocateMe) btnLocateMe.addEventListener('click', locateUserGPS);

        // Fullscreen / Command Center Presentation Mode
        function toggleFullscreenMap() {
          const wrapper = document.getElementById('gmapsWrapper');
          if (!wrapper) return;

          if (!document.fullscreenElement) {
            if (wrapper.requestFullscreen) wrapper.requestFullscreen();
            else if (wrapper.webkitRequestFullscreen) wrapper.webkitRequestFullscreen();
            else if (wrapper.msRequestFullscreen) wrapper.msRequestFullscreen();
            else wrapper.classList.toggle('is-fullscreen');
          } else {
            if (document.exitFullscreen) document.exitFullscreen();
            else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
          }

          setTimeout(() => { map.invalidateSize(); }, 200);
        }

        if (btnFullscreenMap) btnFullscreenMap.addEventListener('click', toggleFullscreenMap);

        document.addEventListener('fullscreenchange', () => {
          const isFull = !!document.fullscreenElement;
          if (btnFullscreenMap) {
            btnFullscreenMap.innerHTML = isFull ? '<i class="bi bi-fullscreen-exit"></i>' : '<i class="bi bi-arrows-fullscreen"></i>';
          }
          map.invalidateSize();
        });

        // Interactive KPI Bar Status Filter Listeners
        document.querySelectorAll('.gmaps-kpi-pill').forEach(pill => {
          pill.addEventListener('click', () => {
            const statusKey = pill.getAttribute('data-status') || '';
            filterByKpiStatus(statusKey);
          });
        });

        // Filter Dropdown Listener
        kecFilter.addEventListener('change', (e) => {
          currentFilteredKec = e.target.value;
          updateActiveLayerStyles();
          updateTopStats();
          fitBoundsToKecamatan(currentFilteredKec);
        });

        // Reset View Button
        btnResetView.addEventListener('click', () => {
          kecFilter.value = '';
          currentFilteredKec = '';
          currentStatusFilter = '';
          currentThematicMetric = 'fasih';
          switchThematicMetric('fasih');
          filterByKpiStatus('');
          if (mapSearchInput) mapSearchInput.value = '';
          map.setView(centerCoords, defaultZoom);
          updateActiveLayerStyles();
          updateTopStats();
        });

        // PCL Territory Highlight Helper
        window.highlightPclTerritory = function(pclName) {
          if (!pclName || pclName === 'Belum Ditentukan') return;
          if (activeLayerName !== 'sls') {
            switchToSlsLayer();
          }

          setTimeout(() => {
            let foundBounds = L.latLngBounds();
            let count = 0;

            if (slsLayer) {
              slsLayer.eachLayer(layer => {
                const stat = slsStats.find(s => s.kode === layer.feature.properties.kode);
                const layerPcl = stat ? stat.pcl : (layer.feature.properties.pcl || '');

                if (layerPcl && layerPcl.toLowerCase().trim() === pclName.toLowerCase().trim()) {
                  layer.setStyle({
                    weight: 2.8,
                    color: '#f59e0b',
                    fillColor: '#f59e0b',
                    fillOpacity: 0.70,
                    opacity: 1
                  });
                  if (layer.getBounds) foundBounds.extend(layer.getBounds());
                  count++;
                } else {
                  layer.setStyle({
                    opacity: 0.10,
                    fillOpacity: 0.02
                  });
                }
              });
            }

            if (count > 0 && foundBounds.isValid()) {
              map.fitBounds(foundBounds, { padding: [50, 50] });
            }
          }, 120);
        };

        // -------------------------------------------------------------
        // ULTRA-LIGHTWEIGHT & FAST SPATIAL SEARCH ENGINE
        // -------------------------------------------------------------
        let currentSearchQuery = '';
        let isSearchActive = false;
        let searchDebounceTimer = null;

        function applySearchHighlightToLayer(layer, layerType) {
          if (!isSearchActive || !currentSearchQuery) {
            if (layerType === 'kec') layer.setStyle(kecStyle(layer.feature));
            else if (layerType === 'desa') layer.setStyle(desaStyle(layer.feature));
            else if (layerType === 'sls') layer.setStyle(slsStyle(layer.feature));
            return;
          }

          const terms = currentSearchQuery.split(/\s+/).filter(Boolean);
          const key = layer._searchKey || '';
          const isMatch = terms.every(term => key.includes(term));

          if (isMatch) {
            layer.setStyle({
              weight: 2.8,
              color: '#06b6d4',
              opacity: 1,
              fillOpacity: currentBasemapType === 'satellite' ? 0.70 : 0.60
            });
          } else {
            layer.setStyle({
              opacity: 0.12,
              fillOpacity: 0.02
            });
          }
        }

        function performMapSearch(query) {
          const q = (query || '').toLowerCase().trim();
          currentSearchQuery = q;
          isSearchActive = q.length > 0;

          if (!isSearchActive) {
            updateActiveLayerStyles();
            return;
          }

          const terms = q.split(/\s+/).filter(Boolean);
          const currentLayer = activeLayerName === 'kec' ? kecLayer : (activeLayerName === 'desa' ? desaLayer : slsLayer);
          if (!currentLayer) return;

          let foundBounds = L.latLngBounds();
          let matchCount = 0;

          currentLayer.eachLayer(layer => {
            const key = layer._searchKey || '';
            const isMatch = terms.every(term => key.includes(term));

            if (isMatch) {
              layer.setStyle({
                weight: 2.8,
                color: '#06b6d4',
                opacity: 1,
                fillOpacity: currentBasemapType === 'satellite' ? 0.70 : 0.60
              });
              if (layer.getBounds) foundBounds.extend(layer.getBounds());
              matchCount++;
            } else {
              layer.setStyle({
                opacity: 0.12,
                fillOpacity: 0.02
              });
            }
          });

          if (matchCount > 0 && foundBounds.isValid()) {
            map.fitBounds(foundBounds, { padding: [40, 40], maxZoom: 16 });
          }
        }

        if (mapSearchInput) {
          mapSearchInput.addEventListener('input', (e) => {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
              performMapSearch(e.target.value);
            }, 120);
          });
        }

        // Initialize map & load data!
        bootstrap();

        // Filter Drag-to-Scroll & Visual Scroll Indicator Setup
        const filterRow = document.getElementById('gmapsFilterRow');
        const scrollHintRight = document.getElementById('gmapsScrollHintRight');

        function checkFilterScrollIndicator() {
          if (!filterRow || !scrollHintRight) return;
          const maxScrollLeft = filterRow.scrollWidth - filterRow.clientWidth;
          const canScrollRight = maxScrollLeft - filterRow.scrollLeft > 6;

          if (canScrollRight) {
            scrollHintRight.classList.add('visible');
          } else {
            scrollHintRight.classList.remove('visible');
          }
        }

        if (filterRow) {
          checkFilterScrollIndicator();
          filterRow.addEventListener('scroll', checkFilterScrollIndicator, { passive: true });
          window.addEventListener('resize', checkFilterScrollIndicator, { passive: true });
          setTimeout(checkFilterScrollIndicator, 300);

          if (scrollHintRight) {
            scrollHintRight.addEventListener('click', () => {
              filterRow.scrollBy({ left: 140, behavior: 'smooth' });
            });
          }

          let isDown = false;
          let startX = 0;
          let startScrollLeft = 0;
          let hasDragged = false;

          filterRow.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            isDown = true;
            hasDragged = false;
            startX = e.pageX - filterRow.offsetLeft;
            startScrollLeft = filterRow.scrollLeft;
          });

          filterRow.addEventListener('mouseleave', () => {
            if (!isDown) return;
            isDown = false;
            filterRow.classList.remove('is-dragging');
          });

          filterRow.addEventListener('mouseup', () => {
            if (!isDown) return;
            isDown = false;
            filterRow.classList.remove('is-dragging');
            setTimeout(() => { hasDragged = false; }, 50);
          });

          filterRow.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            const currentX = e.pageX - filterRow.offsetLeft;
            const distance = currentX - startX;

            if (Math.abs(distance) > 5) {
              if (!hasDragged) {
                hasDragged = true;
                filterRow.classList.add('is-dragging');
              }
              e.preventDefault();
              filterRow.scrollLeft = startScrollLeft - distance * 1.4;
            }
          });

          filterRow.addEventListener('click', (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopPropagation();
            }
          }, true);
        }
      }

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initMapPage();
      } else {
        document.addEventListener('DOMContentLoaded', initMapPage);
      }
    </script>
</div>
