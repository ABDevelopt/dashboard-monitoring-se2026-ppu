    <script>
      window.switchGmapsTab = function(tabName) {
        const statsTab = document.getElementById('gmapsStatsTabContent');
        const legendTab = document.getElementById('gmapsLegendTabContent');
        const btnStats = document.getElementById('tabBtnStats');
        const btnLegend = document.getElementById('tabBtnLegend');
        
        if (tabName === 'stats') {
          if (statsTab) statsTab.style.display = 'block';
          if (legendTab) legendTab.style.display = 'none';
          if (btnStats) btnStats.classList.add('active');
          if (btnLegend) btnLegend.classList.remove('active');
        } else {
          if (statsTab) statsTab.style.display = 'none';
          if (legendTab) legendTab.style.display = 'block';
          if (btnStats) btnStats.classList.remove('active');
          if (btnLegend) btnLegend.classList.add('active');
        }
      };

      window.toggleGmapsDrawer = function() {
        const card = document.getElementById('gmapsDrawerCard');
        const icon = document.getElementById('drawerCollapseIcon');
        if (!card) return;
        card.classList.toggle('collapsed');
        if (icon) {
          if (card.classList.contains('collapsed')) {
            icon.className = 'bi bi-chevron-up';
          } else {
            icon.className = 'bi bi-chevron-down';
          }
        }
      };

      window.ensureGmapsDrawerOpen = function() {
        const card = document.getElementById('gmapsDrawerCard');
        const icon = document.getElementById('drawerCollapseIcon');
        if (card && card.classList.contains('collapsed')) {
          card.classList.remove('collapsed');
          if (icon) icon.className = 'bi bi-chevron-down';
        }
      };

      function initMapPage() {
        if (typeof L === 'undefined') {
          setTimeout(initMapPage, 50);
          return;
        }

        const mapContainerEl = document.getElementById('map');
        if (!mapContainerEl) return;

        // Initial setup
        const centerCoords = [-1.30, 116.65];
        const defaultZoom = 10;
        
        // Clean container state to ensure clean re-initialization on PJAX swaps
        if (mapContainerEl._leaflet_id) {
          mapContainerEl._leaflet_id = null;
        }

        const map = L.map('map', {
          zoomControl: false,
          maxZoom: 18,
          minZoom: 9
        }).setView(centerCoords, defaultZoom);

        L.control.zoom({ position: 'bottomright' }).addTo(map);

        let currentBasemapLayer = null;

        // Helper to force Leaflet to recalculate canvas size and redraw tiles
        const invalidateMapSize = () => {
          if (map && typeof map.invalidateSize === 'function') {
            map.invalidateSize({ animate: false });
          }
          if (currentBasemapLayer && typeof currentBasemapLayer.redraw === 'function') {
            currentBasemapLayer.redraw();
          }
        };

        // Staggered invalidations to guarantee tile grid recalculation after load & PJAX enter animation
        invalidateMapSize();
        [50, 150, 300, 450, 800, 1200].forEach(delay => {
          setTimeout(invalidateMapSize, delay);
        });

        // Extra invalidation on window load to handle late CSS/font rendering
        window.addEventListener('load', invalidateMapSize);

        // Use ResizeObserver for automatic sizing adjustment when sidebar or window container resizes
        if (window.ResizeObserver && mapContainerEl) {
          const ro = new ResizeObserver(() => {
            invalidateMapSize();
          });
          ro.observe(mapContainerEl);
          if (window._pjaxCleanups) {
            window._pjaxCleanups.push({ type: 'pjax:start', listener: () => ro.disconnect() });
          }
        }

        // Clean up map instance safely when navigating away via PJAX
        const onPjaxStart = () => {
          try {
            if (map) map.remove();
          } catch (_) {}
        };
        window.addEventListener('pjax:start', onPjaxStart, { once: true });

        // Robust tile creation helper with smart fallback & zoom scaling protection
        const createRobustTileLayer = (primaryUrl, options = {}, fallbackUrl = null, fallbackMaxNativeZoom = 16) => {
          const layer = L.tileLayer(primaryUrl, options);
          if (fallbackUrl) {
            layer.on('tileerror', (e) => {
              if (e.tile && !e.tile.dataset.fallbackTried) {
                e.tile.dataset.fallbackTried = 'true';
                const coords = e.coords;
                if (coords) {
                  let z = coords.z;
                  let x = coords.x;
                  let y = coords.y;
                  if (z > fallbackMaxNativeZoom) {
                    const factor = Math.pow(2, z - fallbackMaxNativeZoom);
                    x = Math.floor(x / factor);
                    y = Math.floor(y / factor);
                    z = fallbackMaxNativeZoom;
                  }
                  e.tile.src = fallbackUrl
                    .replace('{z}', z)
                    .replace('{x}', x)
                    .replace('{y}', y);
                }
              }
            });
          }
          return layer;
        };

        // Basemaps using CARTO CDN with high-DPI support, buffer protection, and OSM fallbacks
        const lightBasemap = createRobustTileLayer(
          'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
          {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 20,
            maxNativeZoom: 19,
            keepBuffer: 6,
            updateWhenIdle: false,
            updateWhenZooming: false,
            crossOrigin: true
          },
          'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          19
        );

        const darkBasemap = createRobustTileLayer(
          'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
          {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 20,
            maxNativeZoom: 19,
            keepBuffer: 6,
            updateWhenIdle: false,
            updateWhenZooming: false,
            crossOrigin: true
          },
          'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          19
        );

        const satelliteBasemap = createRobustTileLayer(
          'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
          {
            attribution: 'Tiles &copy; Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP',
            maxZoom: 20,
            maxNativeZoom: 18,
            keepBuffer: 6,
            updateWhenIdle: false,
            updateWhenZooming: false,
            crossOrigin: true
          }
        );

        const satelliteLabels = L.tileLayer(
          'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
          {
            maxZoom: 20,
            maxNativeZoom: 18,
            keepBuffer: 6,
            crossOrigin: true
          }
        );

        let currentBasemapType = 'default'; // 'default' or 'satellite'

        function updateBasemap() {
          const isLight = document.body.classList.contains('light-mode');
          let targetLayer = null;

          if (currentBasemapType === 'satellite') {
            targetLayer = satelliteBasemap;
            if (!map.hasLayer(satelliteLabels)) {
              satelliteLabels.addTo(map);
            }
          } else {
            if (map.hasLayer(satelliteLabels)) {
              map.removeLayer(satelliteLabels);
            }
            if (isLight) {
              targetLayer = lightBasemap;
            } else {
              targetLayer = darkBasemap;
            }
          }

          [lightBasemap, darkBasemap, satelliteBasemap].forEach(l => {
            if (l !== targetLayer && map.hasLayer(l)) {
              map.removeLayer(l);
            }
          });

          if (!map.hasLayer(targetLayer)) {
            targetLayer.addTo(map);
          }
          
          targetLayer.bringToBack();
          currentBasemapLayer = targetLayer;
          invalidateMapSize();
        }
        updateBasemap();

        // Listen for theme toggle events & register cleanup
        const onThemeChange = () => {
          updateBasemap();
          if (desaLayer) desaLayer.setStyle(desaStyle);
          if (slsLayer) slsLayer.setStyle(slsStyle);
        };
        window.addEventListener('themechange', onThemeChange);

        const onWindowResize = () => invalidateMapSize();
        const onOrientationChange = () => setTimeout(invalidateMapSize, 200);
        window.addEventListener('resize', onWindowResize);
        window.addEventListener('orientationchange', onOrientationChange);
        if (window.visualViewport) {
          window.visualViewport.addEventListener('resize', onWindowResize);
        }

        if (window._pjaxCleanups) {
          window._pjaxCleanups.push(
            { type: 'themechange', listener: onThemeChange },
            { type: 'resize', listener: onWindowResize },
            { type: 'orientationchange', listener: onOrientationChange },
            { type: 'pjax:start', listener: onPjaxStart }
          );
        }

        // Data holders
        const settings = (typeof globalSettings !== 'undefined' ? globalSettings : (typeof settings !== 'undefined' ? settings : {}));
        const isSakernasMap = (typeof window !== 'undefined' && window.activeSurveyId && window.activeSurveyId.startsWith('sakernas'));

        let kecGeoJson = null;
        let desaGeoJson = null;
        let slsGeoJson = null;
        let desaStats = [];
        let slsStats = [];
        let kecStats = [];
        
        let kecLayer = null;
        let desaLayer = null;
        let slsLayer = null;
        let isOutlineOnlyMode = false;
        let showProgressLabels = true;
        let activeLayerName = 'desa'; // 'desa', 'sls', or 'kec'
        let currentFilteredKec = '';
        let currentThematicMetric = 'fasih'; // 'fasih' | 'muatan' | 'reject'
        let currentStatusFilter = ''; // '' | 'done' | 'in_progress' | 'not_started'
        let userLocationMarker = null;
        let userAccuracyCircle = null;

        // UI Selectors
        const loadingOverlay = document.getElementById('mapLoading');
        const loadingText = document.getElementById('loadingStatusText');
        const kecFilter = document.getElementById('kecFilter');
        const mapSearchInput = document.getElementById('mapSearchInput');
        const btnResetView = document.getElementById('btnResetView');
        const btnLocateMe = document.getElementById('btnLocateMe');
        const btnFullscreenMap = document.getElementById('btnFullscreenMap');
        const btnMetricFasih = document.getElementById('btnMetricFasih');
        const btnMetricMuatan = document.getElementById('btnMetricMuatan');
        const btnMetricReject = document.getElementById('btnMetricReject');
        const btnLayerKec = document.getElementById('btnLayerKec');
        const btnLayerDesa = document.getElementById('btnLayerDesa');
        const btnLayerSls = document.getElementById('btnLayerSls');
        const btnBasemapDefault = document.getElementById('btnBasemapDefault');
        const btnBasemapSatellite = document.getElementById('btnBasemapSatellite');
        const btnOutlineOnly = document.getElementById('btnOutlineOnly');
        const btnToggleLabels = document.getElementById('btnToggleLabels');
        const legendKec = document.getElementById('legendKec');
        const legendDesa = document.getElementById('legendDesa');
        const legendSls = document.getElementById('legendSls');
        const sidebarStats = document.getElementById('mapSummaryStats');
        const mapContainerWrap = document.getElementById('mapContainerWrap');
        const btnMobileMapTab = document.getElementById('btnMobileMapTab');
        const btnMobileInfoTab = document.getElementById('btnMobileInfoTab');

        // Mobile View Toggle Logic
        if (btnMobileMapTab && btnMobileInfoTab && mapContainerWrap) {
          btnMobileMapTab.addEventListener('click', () => {
            btnMobileInfoTab.classList.remove('active');
            btnMobileMapTab.classList.add('active');
            mapContainerWrap.classList.remove('show-info-mobile');
            mapContainerWrap.classList.add('show-map-mobile');
            invalidateMapSize();
            setTimeout(invalidateMapSize, 150);
            setTimeout(invalidateMapSize, 400);
          });

          btnMobileInfoTab.addEventListener('click', () => {
            btnMobileMapTab.classList.remove('active');
            btnMobileInfoTab.classList.add('active');
            mapContainerWrap.classList.remove('show-map-mobile');
            mapContainerWrap.classList.add('show-info-mobile');
          });
        }

        // Styles
        function getBorderColor() {
          if (currentBasemapType === 'satellite') return '#ffffff';
          return document.body.classList.contains('light-mode') ? '#1e293b' : '#ffffff';
        }

        function getHoverBorderColor() {
          return 'var(--accent-cyan)';
        }

        function getFasihBadgeClass(pct) {
          if (pct >= 100) return 'status-100';
          if (pct >= 85) return 'status-85';
          if (pct >= 70) return 'status-70';
          if (pct >= 55) return 'status-55';
          if (pct >= 40) return 'status-40';
          if (pct >= 25) return 'status-25';
          if (pct > 0) return 'status-1';
          return 'status-0';
        }

        // Monochromatic / Thematic Color for Desa
        function getDesaColor(iddesa) {
          const stat = desaStats.find(s => s.iddesa === iddesa);
          if (!stat) return '#cbd5e1';

          if (currentThematicMetric === 'muatan') {
            const pct = stat.muatan_pct_str ? parseFloat(stat.muatan_pct_str) : 0;
            if (pct >= 100) return '#065f46';
            if (pct >= 85) return '#059669';
            if (pct >= 70) return '#10b981';
            if (pct >= 55) return '#0d9488';
            if (pct >= 40) return '#14b8a6';
            if (pct >= 25) return '#5eead4';
            if (pct > 0) return '#ccfbf1';
            return '#cbd5e1';
          } else if (currentThematicMetric === 'reject') {
            const rej = stat.rejected_total || 0;
            if (rej >= 20) return '#7f1d1d';
            if (rej >= 10) return '#dc2626';
            if (rej >= 5) return '#ea580c';
            if (rej > 0) return '#f59e0b';
            return '#059669';
          }

          // Default FASIH
          const pct = stat.target_fasih_total ? ((stat.submitted_total + stat.approved_total + stat.rejected_total) / stat.target_fasih_total) * 100 : 0;
          if (pct >= 100) return '#172554';
          if (pct >= 85) return '#1d4ed8';
          if (pct >= 70) return '#2563eb';
          if (pct >= 55) return '#0284c7';
          if (pct >= 40) return '#38bdf8';
          if (pct >= 25) return '#93c5fd';
          if (pct > 0) return '#e0f2fe';
          return '#cbd5e1';
        }

        // Thematic Color for SLS
        function getSlsColor(kode) {
          const stat = slsStats.find(s => s.kode === kode);
          if (!stat) return '#cbd5e1';

          if (currentThematicMetric === 'muatan') {
            const pct = parseFloat(stat.muatan_pct_str || 0);
            if (pct >= 100) return '#065f46';
            if (pct >= 85) return '#059669';
            if (pct >= 70) return '#10b981';
            if (pct >= 55) return '#0d9488';
            if (pct >= 40) return '#14b8a6';
            if (pct >= 25) return '#5eead4';
            if (pct > 0) return '#ccfbf1';
            return '#cbd5e1';
          } else if (currentThematicMetric === 'reject') {
            const rej = stat.rejected || 0;
            if (rej >= 10) return '#7f1d1d';
            if (rej >= 5) return '#dc2626';
            if (rej >= 2) return '#ea580c';
            if (rej > 0) return '#f59e0b';
            return '#059669';
          }

          // Default FASIH
          if (stat.selesai === 1) return '#10b981';

          let pct = parseFloat(stat.fasih_pct_str || 0);
          if (!pct && stat.target_fasih) {
            const real = (stat.submitted_by_pcl || 0) + (stat.approved || 0) + (stat.rejected || 0);
            pct = (real / stat.target_fasih) * 100;
          }

          if (pct >= 100) return '#172554';
          if (pct >= 85) return '#1d4ed8';
          if (pct >= 70) return '#2563eb';
          if (pct >= 55) return '#0284c7';
          if (pct >= 40) return '#38bdf8';
          if (pct >= 25) return '#93c5fd';
          if (pct > 0) return '#e0f2fe';
          return '#cbd5e1';
        }

        // Thematic Color for Kecamatan
        function getKecColor(nmkec) {
          const stat = kecStats.find(k => k.kecamatan && k.kecamatan.toUpperCase() === nmkec.toUpperCase());
          if (!stat) return '#cbd5e1';

          if (currentThematicMetric === 'muatan') {
            const pct = stat.muatan_pct_str ? parseFloat(stat.muatan_pct_str) : 0;
            if (pct >= 100) return '#065f46';
            if (pct >= 85) return '#059669';
            if (pct >= 70) return '#10b981';
            if (pct >= 55) return '#0d9488';
            if (pct >= 40) return '#14b8a6';
            if (pct >= 25) return '#5eead4';
            if (pct > 0) return '#ccfbf1';
            return '#cbd5e1';
          } else if (currentThematicMetric === 'reject') {
            const rej = stat.rejected_total || 0;
            if (rej >= 50) return '#7f1d1d';
            if (rej >= 25) return '#dc2626';
            if (rej >= 10) return '#ea580c';
            if (rej > 0) return '#f59e0b';
            return '#059669';
          }

          const pct = parseFloat(stat.fasih_pct_str || 0);
          if (pct >= 100) return '#172554';
          if (pct >= 85) return '#1d4ed8';
          if (pct >= 70) return '#2563eb';
          if (pct >= 55) return '#0284c7';
          if (pct >= 40) return '#38bdf8';
          if (pct >= 25) return '#93c5fd';
          if (pct > 0) return '#e0f2fe';
          return '#cbd5e1';
        }

        // Styles for layers with ultra-crisp reduced outline thickness & Outline Only mode
        function kecStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          if (isOutlineOnlyMode) {
            return {
              fillColor: 'transparent',
              weight: isSelectedKec ? 2.0 : 0.6,
              opacity: isSelectedKec ? 1 : 0.15,
              color: currentBasemapType === 'satellite' ? '#38bdf8' : 'var(--accent-blue)',
              fillOpacity: 0,
              fillRule: 'nonzero'
            };
          }
          return {
            fillColor: getKecColor(feature.properties.nmkec),
            weight: 1.5,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.50 : 0.42) : 0.02,
            fillRule: 'nonzero'
          };
        }

        function desaStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          if (isOutlineOnlyMode) {
            return {
              fillColor: 'transparent',
              weight: isSelectedKec ? 1.0 : 0.3,
              opacity: isSelectedKec ? 1 : 0.15,
              color: currentBasemapType === 'satellite' ? '#38bdf8' : 'var(--accent-blue)',
              fillOpacity: 0,
              fillRule: 'nonzero'
            };
          }
          return {
            fillColor: getDesaColor(feature.properties.iddesa),
            weight: 0.6,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.45 : 0.38) : 0.02,
            fillRule: 'nonzero'
          };
        }

        function slsStyle(feature) {
          const isSelectedKec = !currentFilteredKec || feature.properties.nmkec === currentFilteredKec;
          if (isOutlineOnlyMode) {
            return {
              fillColor: 'transparent',
              weight: isSelectedKec ? 0.7 : 0.2,
              opacity: isSelectedKec ? 1 : 0.15,
              color: currentBasemapType === 'satellite' ? '#a7f3d0' : '#059669',
              fillOpacity: 0,
              fillRule: 'nonzero'
            };
          }
          return {
            fillColor: getSlsColor(feature.properties.kode),
            weight: 0.35,
            opacity: isSelectedKec ? 1 : 0.08,
            color: getBorderColor(),
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.45 : 0.38) : 0.02,
            fillRule: 'nonzero'
          };
        }

        // Highlight features on hover with high-fidelity style preservation
        function highlightFeature(e) {
          const layer = e.target;
          if (!layer || !layer.feature) return;

          const isSelectedKec = !currentFilteredKec || layer.feature.properties.nmkec === currentFilteredKec;

          if (isOutlineOnlyMode) {
            layer.setStyle({
              weight: isSelectedKec ? 2.5 : 1.0,
              color: getHoverBorderColor(),
              fillOpacity: 0
            });
            return;
          }

          let baseColor = '#cbd5e1';
          if (activeLayerName === 'kec') {
            baseColor = getKecColor(layer.feature.properties.nmkec);
          } else if (activeLayerName === 'desa') {
            baseColor = getDesaColor(layer.feature.properties.iddesa);
          } else if (activeLayerName === 'sls') {
            baseColor = getSlsColor(layer.feature.properties.kode);
          }

          layer.setStyle({
            fillColor: baseColor,
            weight: isSelectedKec ? 2.2 : 1.0,
            color: getHoverBorderColor(),
            opacity: isSelectedKec ? 1 : 0.35,
            fillOpacity: isSelectedKec ? (currentBasemapType === 'satellite' ? 0.70 : 0.60) : 0.08
          });
        }

        function resetHighlightKec(e) {
          const layer = e.target;
          if (!layer || !layer.feature) return;
          if (mapSearchInput && mapSearchInput.value.trim().length > 0) {
            applySearchHighlightToLayer(layer, 'kec');
            return;
          }
          layer.setStyle(kecStyle(layer.feature));
        }

        function resetHighlightDesa(e) {
          const layer = e.target;
          if (!layer || !layer.feature) return;
          if (mapSearchInput && mapSearchInput.value.trim().length > 0) {
            applySearchHighlightToLayer(layer, 'desa');
            return;
          }
          layer.setStyle(desaStyle(layer.feature));
        }

        function resetHighlightSls(e) {
          const layer = e.target;
          if (!layer || !layer.feature) return;
          if (mapSearchInput && mapSearchInput.value.trim().length > 0) {
            applySearchHighlightToLayer(layer, 'sls');
            return;
          }
          layer.setStyle(slsStyle(layer.feature));
        }

        // Top Statistics Calculator (Informasi SLS Selesai & Filter Interaktif)
        function updateTopStats() {
          let activeSls = slsStats || [];
          if (currentFilteredKec) {
            activeSls = slsStats.filter(s => s.kecamatan && s.kecamatan.toUpperCase() === currentFilteredKec.toUpperCase());
          }

          const totalSls = activeSls.length;
          const selesaiCount = activeSls.filter(s => {
            const target = s.target_fasih || 0;
            const real = (s.submitted_by_pcl || 0) + (s.approved || 0) + (s.rejected || 0);
            return s.selesai === 1 || (target > 0 && real >= target);
          }).length;

          const inProgressCount = activeSls.filter(s => {
            const target = s.target_fasih || 0;
            const real = (s.submitted_by_pcl || 0) + (s.approved || 0) + (s.rejected || 0);
            const draft = s.draft || 0;
            const isDone = s.selesai === 1 || (target > 0 && real >= target);
            return !isDone && (real > 0 || draft > 0);
          }).length;

          const notStartedCount = Math.max(0, totalSls - selesaiCount - inProgressCount);
          const selesaiPct = totalSls ? ((selesaiCount / totalSls) * 100).toFixed(1) : '0.0';

          const kpiTotal = document.getElementById('kpiTotalSls');
          const kpiSelesai = document.getElementById('kpiSlsSelesai');
          const kpiBelum = document.getElementById('kpiSlsBelum');
          const kpiNotStarted = document.getElementById('kpiSlsNotStarted');

          if (kpiTotal) kpiTotal.textContent = `${totalSls.toLocaleString('id-ID')} SLS`;
          if (kpiSelesai) kpiSelesai.textContent = `${selesaiCount.toLocaleString('id-ID')} (${selesaiPct}%)`;
          if (kpiBelum) kpiBelum.textContent = `${inProgressCount.toLocaleString('id-ID')} SLS`;
          if (kpiNotStarted) kpiNotStarted.textContent = `${notStartedCount.toLocaleString('id-ID')} SLS`;
        }

        function filterByKpiStatus(statusKey) {
          currentStatusFilter = statusKey;

          document.querySelectorAll('.gmaps-kpi-pill').forEach(pill => {
            if (pill.getAttribute('data-status') === statusKey) {
              pill.classList.add('active-filter');
            } else {
              pill.classList.remove('active-filter');
            }
          });

          if (!statusKey) {
            updateActiveLayerStyles();
            return;
          }

          if (activeLayerName !== 'sls') {
            switchToSlsLayer();
          }

          setTimeout(() => {
            let foundBounds = L.latLngBounds();
            let hasMatch = false;

            if (slsLayer) {
              slsLayer.eachLayer(layer => {
                const stat = slsStats.find(s => s.kode === layer.feature.properties.kode);
                const targetFasih = stat ? stat.target_fasih : 0;
                const real = stat ? ((stat.submitted_by_pcl || 0) + (stat.approved || 0) + (stat.rejected || 0)) : 0;
                const draft = stat ? (stat.draft || 0) : 0;
                const isDone = stat && (stat.selesai === 1 || (targetFasih > 0 && real >= targetFasih));
                const isInProgress = !isDone && (real > 0 || draft > 0);
                const isNotStarted = !isDone && !isInProgress;

                let match = false;
                if (statusKey === 'done' && isDone) match = true;
                else if (statusKey === 'in_progress' && isInProgress) match = true;
                else if (statusKey === 'not_started' && isNotStarted) match = true;

                if (match) {
                  layer.setStyle({
                    weight: 2.5,
                    color: statusKey === 'done' ? '#10b981' : (statusKey === 'in_progress' ? '#f59e0b' : '#ef4444'),
                    opacity: 1,
                    fillOpacity: currentBasemapType === 'satellite' ? 0.70 : 0.60
                  });
                  if (layer.getBounds) foundBounds.extend(layer.getBounds());
                  hasMatch = true;
                } else {
                  layer.setStyle({
                    opacity: 0.10,
                    fillOpacity: 0.02
                  });
                }
              });
            }

            if (hasMatch && foundBounds.isValid()) {
              map.fitBounds(foundBounds, { padding: [40, 40] });
            }
          }, 100);
        }

        // Fit map bounds to filtered subdistrict
        function fitBoundsToKecamatan(kecName) {
          if (!kecName) {
            map.setView(centerCoords, defaultZoom);
            return;
          }

          const bounds = L.latLngBounds();
          const targetLayer = activeLayerName === 'kec' ? kecLayer : (activeLayerName === 'desa' ? desaLayer : slsLayer);
          
          if (targetLayer) {
            targetLayer.eachLayer(layer => {
              if (layer.feature.properties.nmkec === kecName) {
                if (layer.getBounds) {
                  bounds.extend(layer.getBounds());
                } else if (layer.getLatLng) {
                  bounds.extend(layer.getLatLng());
                }
              }
            });
            
            if (bounds.isValid()) {
              map.fitBounds(bounds, { padding: [30, 30] });
            }
          }
        }

        function showKecDetails(nmkec) {
          const stat = kecStats.find(k => k.kecamatan && k.kecamatan.toUpperCase() === nmkec.toUpperCase());
          if (!stat) return;

          const fasihPct = parseFloat(stat.fasih_pct_str || 0);
          const fasihColor = fasihPct >= 100 ? '#10b981' : (fasihPct < 40 ? '#ef4444' : '#3b82f6');
          const isComplete = fasihPct >= 100;
          const totalRealisasiFasih = (stat.submitted_total || 0) + (stat.approved_total || 0) + (stat.rejected_total || 0);
          const targetFasih = stat.target_fasih_total || 0;

          // Render list of Desas in this Kecamatan
          const kecDesaList = desaStats.filter(d => d.kecamatan && d.kecamatan.toUpperCase() === nmkec.toUpperCase());
          let desaListHtml = '';

          if (kecDesaList.length > 0) {
            desaListHtml = `
              <div style="margin-top: 14px; border-top: 1px solid var(--border); padding-top: 12px;">
                <div style="font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
                  <span><i class="bi bi-houses" style="color: var(--accent-blue);"></i> Rincian ${kecDesaList.length} Desa/Kelurahan</span>
                </div>
                <div style="max-height: 280px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding-right: 4px;" id="detailDesaList">
            `;

            kecDesaList.forEach(d => {
              const dReal = (d.submitted_total || 0) + (d.approved_total || 0) + (d.rejected_total || 0);
              const dTgt = d.target_fasih_total || 0;
              const dPct = parseFloat(d.fasih_pct_str || 0);
              const dColor = dPct >= 100 ? '#10b981' : (dPct < 40 ? '#ef4444' : '#3b82f6');

              desaListHtml += `
                <div class="desa-map-item" onclick="if (window.focusDesaOnMap) window.focusDesaOnMap('${d.iddesa}')" style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; cursor: pointer; transition: all 0.15s ease;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <strong style="font-size: 12px; color: var(--text-primary);">${d.desa}</strong>
                    <span class="badge ${dPct >= 100 ? 'badge-green' : 'badge-purple'}" style="font-size: 9px; padding: 1px 6px;">${dPct}% FASIH</span>
                  </div>
                  <div style="height: 4px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden; margin-bottom: 4px;">
                    <div style="width: ${dPct}%; height: 100%; background: ${dColor}; border-radius: 99px;"></div>
                  </div>
                  <div style="font-size: 10px; color: var(--text-muted); display: flex; justify-content: space-between;">
                    <span>SLS Selesai: <strong>${d.selesai} / ${d.total_subsls}</strong></span>
                    <span>Realisasi: <strong>${dReal.toLocaleString('id-ID')} / ${dTgt.toLocaleString('id-ID')}</strong></span>
                  </div>
                </div>
              `;
            });

            desaListHtml += `
                </div>
              </div>
            `;
          }

          sidebarStats.innerHTML = `
            <!-- Header Title Card -->
            <div style="background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2); padding: 10px 12px; border-radius: 10px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
              <div>
                <div style="font-size: 15px; font-weight: 800; color: var(--accent-blue); display: flex; align-items: center; gap: 6px;">
                  <i class="bi bi-diagram-3-fill"></i> Kecamatan ${nmkec}
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
                  Kabupaten Penajam Paser Utara
                </div>
              </div>
              <span class="badge ${isComplete ? 'badge-green' : 'badge-purple'}" style="font-size: 11px; padding: 4px 9px; flex-shrink: 0;">
                ${isComplete ? '<i class="bi bi-check-circle-fill"></i> 100% Selesai' : `${fasihPct}% FASIH`}
              </span>
            </div>

            <!-- Visual Progress Track -->
            <div style="background: var(--bg-secondary); padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border); margin-bottom: 12px;">
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 600; margin-bottom: 6px;">
                <span style="color: var(--text-primary);"><i class="bi bi-bar-chart-line" style="color: var(--accent-blue);"></i> Realisasi FASIH Kecamatan</span>
                <span style="color: ${fasihColor}; font-weight: 700;">${fasihPct}%</span>
              </div>
              <div class="progress-track-sm" style="height: 8px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden;">
                <div class="progress-bar ${fasihPct >= 100 ? 'green' : (fasihPct < 25 ? 'red' : 'purple')}" style="width: ${fasihPct}%; height: 100%; border-radius: 99px; transition: width 0.4s ease;"></div>
              </div>
              <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 6px; display: flex; justify-content: space-between;">
                <span>Realisasi: <strong style="color: var(--text-primary);">${totalRealisasiFasih.toLocaleString('id-ID')}</strong></span>
                <span>Target: <strong style="color: var(--text-primary);">${targetFasih.toLocaleString('id-ID')} Dok</strong></span>
              </div>
            </div>

            <!-- Metric Cards Grid -->
            <div class="map-card-stat-grid">
              <div class="map-card-stat-item">
                <span class="map-card-stat-label"><i class="bi bi-houses" style="color: var(--accent-blue);"></i> Total Desa</span>
                <span class="map-card-stat-value">${stat.total_desa || kecDesaList.length} Desa</span>
              </div>
              <div class="map-card-stat-item">
                <span class="map-card-stat-label"><i class="bi bi-box-seam" style="color: var(--accent-purple);"></i> Total SubSLS</span>
                <span class="map-card-stat-value">${stat.total_subsls || 0} SLS</span>
