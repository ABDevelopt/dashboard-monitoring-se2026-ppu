            <i class="bi bi-toggle-off toggle-indicator" id="iconOutlineToggle"></i>
          </button>
          <button id="btnToggleLabels" class="gmaps-toggle-btn" title="Aktifkan/Matikan Label Progres Pada Peta" type="button" aria-pressed="false" style="width: 100%;">
            <span style="display: inline-flex; align-items: center; gap: 5px;">
              <i class="bi bi-percent"></i> Label Progres
