    <!-- 4. FLOATING BASEMAP SWITCHER (POJOK KANAN BAWAH) -->
    <div class="gmaps-floating-basemap-pill">
      <button id="btnBasemapDefault" class="gmaps-pill-btn active" title="Peta Vektor" type="button"><i class="bi bi-map"></i> Vektor</button>
      <button id="btnBasemapSatellite" class="gmaps-pill-btn" title="Citra Satelit" type="button"><i class="bi bi-globe-americas"></i> Satelit</button>
    </div>

    <!-- 5. SMART PEEK / EXPANDED DRAWER (BOTTOM LEFT) -->
    <div class="gmaps-floating-drawer-card collapsed" id="gmapsDrawerCard">
      <div class="gmaps-drawer-header">
        <div class="gmaps-drawer-tabs">
          <button type="button" class="gmaps-tab-btn active" id="tabBtnStats" onclick="switchGmapsTab('stats')">
            <i class="bi bi-card-list"></i> Detail Wilayah
          </button>
          <button type="button" class="gmaps-tab-btn" id="tabBtnLegend" onclick="switchGmapsTab('legend')">
            <i class="bi bi-palette"></i> Legenda
