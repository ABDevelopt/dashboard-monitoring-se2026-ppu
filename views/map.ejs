        function populateDesaFilterList(selectedKec) {
          const desaSelect = document.getElementById('desaFilter');
          if (!desaSelect || !desaStats || !desaStats.length) return;
          const currentVal = desaSelect.value;
          
          let filteredDesas = desaStats;
          if (selectedKec) {
            filteredDesas = desaStats.filter(d => d.kecamatan && d.kecamatan.toUpperCase() === selectedKec.toUpperCase());
          }

          filteredDesas = [...filteredDesas].sort((a, b) => (a.desa || '').localeCompare(b.desa || ''));

          let optionsHtml = '<option value="">-- Semua Desa / Kel --</option>';
          filteredDesas.forEach(d => {
            const label = selectedKec ? d.desa : `${d.desa} (${d.kecamatan})`;
            optionsHtml += `<option value="${d.desa}">${label}</option>`;
          });
          desaSelect.innerHTML = optionsHtml;
          
          if (currentVal && filteredDesas.some(d => d.desa.toUpperCase() === currentVal.toUpperCase())) {
            desaSelect.value = currentVal;
