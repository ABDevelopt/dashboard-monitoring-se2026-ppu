            <tr style="border-bottom: 1px solid var(--border); text-align: left; color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
              <th style="padding: 10px 8px;">Petugas</th>
              <th style="padding: 10px 8px;">Kecamatan</th>
              <th style="padding: 10px 8px; text-align: center;">BS Selesai</th>
              <th style="padding: 10px 8px; text-align: right;">Keluarga</th>
              <th style="padding: 10px 8px; text-align: center;">Akurasi</th>
            </tr>
          </thead>
          <tbody>
            <% petugasStats.forEach((p, idx) => { %>
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04);">
                <td style="padding: 10px 8px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                  <span style="width: 20px; height: 20px; border-radius: 50%; background: <%= idx === 0 ? '#eab308' : idx === 1 ? '#94a3b8' : idx === 2 ? '#d97706' : 'rgba(255,255,255,0.06)' %>; color: <%= idx < 3 ? '#000' : 'var(--text-muted)' %>; font-size: 10px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center;">
                    <%= idx + 1 %>
                  </span>
                  <%= p.nama %>
                </td>
                <td style="padding: 10px 8px; color: var(--text-secondary);">
                  <%= p.kecamatan %>
                </td>
                <td style="padding: 10px 8px; text-align: center; font-weight: 700; color: var(--accent-cyan);">
                  <%= p.bs_selesai %> BS
                </td>
                <td style="padding: 10px 8px; text-align: right; color: var(--text-primary);">
                  <%= p.keluarga_listing %> KK
                </td>
                <td style="padding: 10px 8px; text-align: center; font-weight: 700; color: var(--accent-green);">
                  <%= p.skor_akurasi %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- SECTION: TREN HISTORIS LISTING HARIAN -->
  <div class="card" style="margin-top: 20px; padding: 22px; border-radius: var(--radius-lg); background: var(--bg-card); border: 1px solid var(--border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
      <div>
        <h3 style="font-size: 15px; font-weight: 800; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
          <i class="bi bi-graph-up-arrow text-cyan"></i> Tren Historis Penyelesaian Listing Harian
        </h3>
        <p style="font-size: 11.5px; color: var(--text-muted); margin: 2px 0 0 0;">
          Visualisasi progres harian muatan keluarga terdata dan penyelesaian blok sensus Sakernas
        </p>
      </div>
      <div style="display: flex; gap: 8px;">
        <span style="font-size: 11px; background: rgba(6, 182, 212, 0.12); color: var(--accent-cyan); padding: 4px 10px; border-radius: 6px; font-weight: 700;">
          <i class="bi bi-circle-fill" style="font-size: 7px;"></i> 1 s.d. 6 Agustus 2026
        </span>
      </div>
    </div>

    <!-- Chart Container -->
    <div style="height: 260px; position: relative; width: 100%;">
      <canvas id="sakernasTrendChart"></canvas>
    </div>
  </div>

</div>

<!-- INLINE SCRIPT FOR WEATHER, AI COLLAPSE, & CHART -->
<script>
  function toggleAiInsightsCollapse(e) {
    if (e) e.stopPropagation();
    const container = document.getElementById('aiInsightsCollapseContainer');
    const icon = document.getElementById('aiCollapseIcon');
    if (!container) return;
    if (container.style.display === 'none' || !container.style.display) {
      container.style.display = 'block';
      if (icon) icon.className = 'bi bi-chevron-up';
    } else {
      container.style.display = 'none';
      if (icon) icon.className = 'bi bi-chevron-down';
    }
  }

  function refreshAiInsightsSakernas(e) {
    if (e) e.stopPropagation();
    const icon = document.getElementById('aiRefreshIcon');
    if (icon) icon.classList.add('bi-spin');
    setTimeout(() => {
      if (icon) icon.classList.remove('bi-spin');
    }, 600);
  }

  // Render Chart when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    // Weather Time logic
    function updateLiveClock() {
      const timeElem = document.getElementById('overviewTime');
      const dateElem = document.getElementById('overviewDate');
      if (!timeElem || !dateElem) return;
      const now = new Date();
      // WITA is UTC+8
      const wita = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) + (8 * 3600000));
      const hours = String(wita.getHours()).padStart(2, '0');
      const mins = String(wita.getMinutes()).padStart(2, '0');
      const secs = String(wita.getSeconds()).padStart(2, '0');
      timeElem.innerText = `${hours}:${mins}:${secs}`;
      
      const days = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
      dateElem.innerText = `${days[wita.getDay()]}, ${wita.getDate()} ${months[wita.getMonth()]} ${wita.getFullYear()}`;
    }
    setInterval(updateLiveClock, 1000);
    updateLiveClock();

    // Chart.js init
    const ctx = document.getElementById('sakernasTrendChart');
    if (ctx && typeof Chart !== 'undefined') {
      const trenData = <%- tren %>;
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: trenData.map(d => d.tanggal.split('-').slice(1).join('/')),
          datasets: [
            {
              label: 'Keluarga Dimutakhirkan',
              data: trenData.map(d => d.keluarga_terdata),
              borderColor: '#06b6d4',
              backgroundColor: 'rgba(6, 182, 212, 0.12)',
              borderWidth: 3,
              fill: true,
              tension: 0.35,
              yAxisID: 'y'
            },
            {
              label: 'Blok Sensus Selesai (Kumulatif)',
              data: trenData.map(d => d.total_bs_selesai),
              borderColor: '#22c55e',
              backgroundColor: 'transparent',
              borderWidth: 2.5,
              borderDash: [4, 4],
              tension: 0.2,
              yAxisID: 'y1'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              position: 'top',
              labels: { color: '#94a3b8', font: { size: 11, family: 'Inter' }, boxWidth: 12 }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#94a3b8', font: { size: 11 } }
            },
            y: {
              type: 'linear',
              position: 'left',
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#06b6d4', font: { size: 11 } }
            },
            y1: {
              type: 'linear',
              position: 'right',
              grid: { drawOnChartArea: false },
              ticks: { color: '#22c55e', font: { size: 11 } }
            }
          }
        }
      });
    }
  });
</script>
