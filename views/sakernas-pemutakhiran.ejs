              <td style="padding: 12px 8px; text-align: center; color: var(--accent-cyan);">42 BS</td>
              <td style="padding: 12px 8px; text-align: right;">4.280</td>
              <td style="padding: 12px 8px; text-align: right; color: var(--accent-green);">420 RT</td>
              <td style="padding: 12px 8px; text-align: center; color: var(--accent-green);">100.0%</td>
