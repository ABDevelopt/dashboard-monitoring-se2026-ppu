    </style>



    <!-- PROGRES REALISASI UTAMA & ASSIGNMENT -->
    <% if (settings.overview_fasih === '1' || settings.overview_muatan === '1') { %>
    <%
      var totalPengerjaan = (summary.submitted_total || 0) + (summary.approved_total || 0) + (summary.rejected_total || 0);
      let fasihPct = summary.fasih_pct_str;
      
      var startSensusDate = new Date(settings.speedometer_start_date || '2026-06-15');
      var uploadDate = typeof latestUpload !== 'undefined' && latestUpload ? new Date(latestUpload.tanggal) : new Date();
      
      // Calculate diffDays (days since startSensusDate)
      var diffTime = uploadDate - startSensusDate;
      var diffDays = Math.max(1, Math.round(diffTime / (1000 * 60 * 60 * 24)) + 1);
      
      // Calculate daysRemaining (days until deadline) & totalDays
      var deadline = new Date(settings.speedometer_target_date || '2026-08-31');
      var totalDays = Math.max(1, Math.ceil((deadline - startSensusDate) / (1000 * 60 * 60 * 24)));
      var daysRemaining = Math.max(0, Math.ceil((deadline - uploadDate) / (1000 * 60 * 60 * 24)));

      var remainingFasih = Math.max(0, (summary.target_fasih_total || 0) - totalPengerjaan);
      var currentSpeed = diffDays > 0 ? (totalPengerjaan / diffDays) : 0;
      var currentSpeedText = currentSpeed.toFixed(2);
      var estDaysToFinish = currentSpeed > 0 ? (remainingFasih / currentSpeed) : null;
      var isOfftrack = (currentSpeed === 0 && remainingFasih > 0) || (estDaysToFinish !== null && estDaysToFinish > daysRemaining);
      var reqSpeed = daysRemaining > 0 ? (remainingFasih / daysRemaining) : remainingFasih;
      var projectedFinalVal = totalPengerjaan + (currentSpeed * daysRemaining);
      var projectedPctVal = (summary.target_fasih_total || 0) > 0 ? (projectedFinalVal / (summary.target_fasih_total || 0)) * 100 : 100;

      var totalPcl = summary.total_pcl || 1;
      var activePcl = summary.active_pcl || 1;
      var speedPerPcl = totalPcl > 0 ? (currentSpeed / totalPcl) : 0;
      var speedPerPclText = speedPerPcl.toFixed(2);
      var reqSpeedPerPcl = totalPcl > 0 ? (reqSpeed / totalPcl) : 0;
      var reqSpeedPerPclText = reqSpeedPerPcl.toFixed(2);

      var targetSpeedTotal = 0;
      var targetNormalPerPcl = 0;

      if (settings.speedometer_calc_mode === 'pcl_speed') {
        var targetSpeedPerPcl = parseFloat(settings.speedometer_target_speed_per_pcl || '13') || 13;
        targetSpeedTotal = targetSpeedPerPcl * totalPcl;
        targetNormalPerPcl = targetSpeedPerPcl;
      } else {
        // Mode Default: 'total_target' (Berbasis Total Target FASIH)
        targetSpeedTotal = totalDays > 0 ? ((summary.target_fasih_total || 0) / totalDays) : 0;
        targetNormalPerPcl = totalPcl > 0 ? (targetSpeedTotal / totalPcl) : 0;
      }
      var targetNormalPerPclText = targetNormalPerPcl.toFixed(1);

      // Hitung perkiraan selesai 40% dan 100%
      const target_40 = (summary.target_fasih_total || 0) * 0.4;
      let estDate40Text = 'Sudah tercapai';
      let estDate100Text = 'Tidak dapat diprediksi (stagnan)';
      
      const optionsDate = { day: 'numeric', month: 'short', year: 'numeric' };

      if (totalPengerjaan >= target_40) {
        estDate40Text = 'Sudah Tercapai';
      } else if (currentSpeed > 0) {
        const daysTo40 = (target_40 - totalPengerjaan) / currentSpeed;
        const date40 = new Date(uploadDate.getTime() + daysTo40 * 24 * 60 * 60 * 1000);
        estDate40Text = date40.toLocaleDateString('id-ID', optionsDate);
      } else {
        estDate40Text = 'Tidak dapat diprediksi (stagnan)';
      }

      if (remainingFasih <= 0) {
        estDate100Text = 'Sudah Selesai 100%';
      } else if (currentSpeed > 0) {
        const date100 = new Date(uploadDate.getTime() + estDaysToFinish * 24 * 60 * 60 * 1000);
