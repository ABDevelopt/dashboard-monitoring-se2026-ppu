          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; width: 100%;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <div style="width: 32px; height: 32px; border-radius: 10px; background: rgba(139, 92, 246, 0.12); color: var(--accent-purple); display: flex; align-items: center; justify-content: center; font-size: 16px;">
                <i class="bi bi-bar-chart-fill"></i>
              </div>
              <div>
                <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em;">
                  Analisis & Kekurangan Target Harian (Agregat Kabupaten)
                </h4>
                <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--text-muted);">
                  Monitoring defisit laju pengumpulan dokumen FASIH tingkat kabupaten se-PPU
                </p>
              </div>
            </div>
            <!-- Help Tooltip Icon in Corner -->
            <div class="help-tooltip-container">
              <i class="bi bi-question-circle help-tooltip-icon"></i>
              <div class="help-tooltip-box">
                <strong style="color: var(--text-primary); display: block; margin-bottom: 4px;">Panduan Analisis Target Harian Kabupaten:</strong>
                Blok ini menyajikan analisis laju pengumpulan dokumen FASIH dalam skala agregat (total se-kabupaten per hari). 
                <br><br>
                <strong>Realisasi Laju:</strong> Kecepatan nyata pengisian dokumen per hari secara kumulatif kabupaten.
                <br><br>
                <strong>Target Normal:</strong> Rata-rata laju harian berdasarkan opsi yang aktif di menu Pengaturan (misal: total target dibagi total hari alokasi pendataan).
                <br><br>
                <strong>Target Aktual (Laju Aman):</strong> Kecepatan minimal harian yang diperlukan untuk menyelesaikan sisa beban kerja tepat waktu sebelum deadline (menyesuaikan sisa beban dan hari tersisa).
                <br><br>
                <strong>Target Tetap:</strong> Standar rancangan kegiatan awal flat yaitu 13 dokumen per petugas (PCL) per hari secara kumulatif kabupaten (13 × <%= totalPcl %> PCL).
                <br><br>
                <strong>Defisit Laju:</strong> Angka kekurangan dokumen per hari terhadap target minimal agar pendataan tetap on-track.
              </div>
            </div>
          </div>
            
            <% 
              const targetTetap = 13 * totalPcl;
              const stdDeficit = Math.max(0, targetSpeedTotal - currentSpeed);
              const reqDeficit = Math.max(0, reqSpeed - currentSpeed);
              const isOfftrackHarian = stdDeficit > 0 || reqDeficit > 0;
              
              // Nilai-nilai laju harian
              const realisasiCount = currentSpeed;
              const targetNormal = targetSpeedTotal; // Berdasarkan kalkulasi mode terpilih
              const targetAktual = reqSpeed;          // Target Aktual / Laju Aman Deadline

              // Skala maksimum grafik agar semua titik (realisasi, target normal, target aktual, target tetap) muat dalam 100% track
              const maxScaleVal = Math.max(targetNormal, targetAktual, targetTetap, realisasiCount, 1) * 1.15;

              const realisasiBarPct = Math.min(100, (realisasiCount / maxScaleVal) * 100);
              const targetNormalPct = Math.min(100, (targetNormal / maxScaleVal) * 100);
              const targetAktualPct = Math.min(100, (targetAktual / maxScaleVal) * 100);
              const targetTetapPct = Math.min(100, (targetTetap / maxScaleVal) * 100);
            %>

            <div class="target-harian-flex-wrap">
              
              <!-- SISI KIRI: Diagram Batang Jumlah Realisasi & Line-Marks Target -->
              <div class="target-harian-left-panel">
                
                <!-- Label Header & Angka Realisasi Nyata -->
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 700;">
                  <span style="color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.03em;">Realisasi Laju Pendataan Harian</span>
                  <span style="color: <%= isOfftrackHarian ? 'var(--accent-cyan)' : 'var(--accent-green)' %>; font-size: 13px; font-weight: 800;">
                    <%= currentSpeed.toLocaleString('id-ID', {maximumFractionDigits: 1}) %> <span style="font-size: 10px; font-weight: 500; color: var(--text-muted);">dok/hari</span>
                  </span>
                </div>

                <!-- Progress Bar Container dengan Line-Marks (Target Normal, Target Aktual, Target Tetap) -->
                <div class="progress-timeline-container" style="position: relative; height: 28px; margin-top: 32px; margin-bottom: 32px; width: 100%;">
                  
                  <!-- Track & Progress Bar (Gaya FASIH Assignment) -->
                  <div style="background: var(--bg-progress-wrap); height: 28px; border-radius: 14px; overflow: hidden; position: relative; border: 1px solid var(--border); display: flex; align-items: center; padding: 0 4px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.15); width: 100%;">
                    
                    <!-- Realisasi Fill Bar -->
                    <div class="progress-bar" data-width="<%= realisasiBarPct.toFixed(1) %>" style="background: <%= isOfftrackHarian ? 'linear-gradient(90deg, #ef4444 0%, #f87171 100%)' : 'linear-gradient(90deg, #10b981 0%, #34d399 100%)' %>; height: 20px; width: 0%; border-radius: 10px; transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; justify-content: flex-end; padding-right: 12px; min-width: 24px; box-shadow: 0 2px 8px <%= isOfftrackHarian ? 'rgba(239, 68, 68, 0.25)' : 'rgba(16, 185, 129, 0.25)' %>;">
                      <span style="font-size: 11px; font-weight: 800; color: #ffffff; text-shadow: 0 1px 2px rgba(0,0,0,0.5); white-space: nowrap;">
                        <%= Math.round(realisasiCount).toLocaleString('id-ID') %> dok/hari
                      </span>
                    </div>

                  </div>

                  <!-- Marker Target Normal -->
                  <div class="target-marker" style="position: absolute; left: <%= targetNormalPct.toFixed(1) %>%; top: -3px; height: 34px; border-left: 2px dashed #60a5fa; z-index: 5; pointer-events: none;">
                    <span class="target-marker-text" style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); font-size: 8px; font-weight: 900; color: #60a5fa; white-space: nowrap;">Target Normal: <%= Math.round(targetNormal).toLocaleString('id-ID') %> dok/hari</span>
                  </div>

                  <!-- Marker Target Tetap (13 * Petugas) -->
                  <div class="target-marker" style="position: absolute; left: <%= targetTetapPct.toFixed(1) %>%; top: -13px; height: 44px; border-left: 2px dashed #f59e0b; z-index: 7; pointer-events: none;">
                    <span class="target-marker-text" style="position: absolute; top: -26px; left: 50%; transform: translateX(-50%); font-size: 8px; font-weight: 900; color: #f59e0b; white-space: nowrap;">Target Tetap: <%= Math.round(targetTetap).toLocaleString('id-ID') %> dok/hari</span>
                  </div>

                  <!-- Marker Target Aktual (Laju Aman Deadline) -->
                  <div class="target-marker" style="position: absolute; left: <%= targetAktualPct.toFixed(1) %>%; top: -3px; height: 34px; border-left: 2px dashed var(--accent-purple); z-index: 6; pointer-events: none;">
                    <span class="target-marker-text" style="position: absolute; bottom: -14px; left: 50%; transform: translateX(-50%); font-size: 8px; font-weight: 900; color: var(--accent-purple); white-space: nowrap;">Target Aktual: <%= Math.round(targetAktual).toLocaleString('id-ID') %> dok/hari</span>
                  </div>

                </div>

                <!-- Detail Legend (4 Kolom: Realisasi, Target Normal, Target Aktual, Target Tetap) -->
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 2px;">
                  <!-- Realisasi Laju -->
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-size: 9px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Realisasi Laju</span>
                    <span style="font-size: 13px; font-weight: 800; color: <%= isOfftrackHarian ? 'var(--accent-cyan)' : 'var(--accent-green)' %>;">
                      <%= currentSpeed.toLocaleString('id-ID', {maximumFractionDigits: 1}) %>
                      <span style="font-size: 10px; font-weight: 500; color: var(--text-muted);">dok/hari</span>
                    </span>
                  </div>
                  <!-- Target Normal -->
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-size: 9px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Target Normal</span>
                    <span style="font-size: 13px; font-weight: 800; color: #60a5fa;">
                      <%= Math.round(targetNormal).toLocaleString('id-ID') %>
                      <span style="font-size: 10px; font-weight: 500; color: var(--text-muted);">dok/hari</span>
                    </span>
                  </div>
                  <!-- Target Aktual -->
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-size: 9px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Target Aktual</span>
                    <span style="font-size: 13px; font-weight: 800; color: var(--accent-purple);">
                      <%= reqSpeed.toLocaleString('id-ID', {maximumFractionDigits: 1}) %>
                      <span style="font-size: 10px; font-weight: 500; color: var(--text-muted);">dok/hari</span>
                    </span>
                  </div>
                  <!-- Target Tetap -->
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-size: 9px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Target Tetap</span>
                    <span style="font-size: 13px; font-weight: 800; color: #f59e0b;">
                      <%= Math.round(targetTetap).toLocaleString('id-ID') %>
                      <span style="font-size: 10px; font-weight: 500; color: var(--text-muted);">dok/hari</span>
                    </span>
                  </div>
                </div>

              </div>

              <!-- SISI KANAN: Highlight Defisit Harian (Responsif Hero Card) -->
              <div class="target-harian-right-panel">
                
                <% 
                  const maxDeficit = Math.max(stdDeficit, reqDeficit);
                %>

                <!-- Highlight Defisit Kecepatan Harian (Hero Card) -->
                <div class="target-harian-hero-card" style="background: linear-gradient(135deg, <%= maxDeficit > 0 ? 'rgba(239, 68, 68, 0.12)' : 'rgba(34, 197, 94, 0.12)' %> 0%, <%= maxDeficit > 0 ? 'rgba(239, 68, 68, 0.03)' : 'rgba(34, 197, 94, 0.03)' %> 100%); border: 1px solid <%= maxDeficit > 0 ? 'rgba(239, 68, 68, 0.35)' : 'rgba(34, 197, 94, 0.35)' %>; box-shadow: 0 4px 16px <%= maxDeficit > 0 ? 'rgba(239, 68, 68, 0.12)' : 'rgba(34, 197, 94, 0.12)' %>;">
                  
                  <div style="font-size: 10px; font-weight: 800; color: <%= maxDeficit > 0 ? 'var(--accent-red)' : 'var(--accent-green)' %>; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;">
                    Defisit Laju Harian
                  </div>
                  
                  <div class="target-harian-hero-number" style="color: <%= maxDeficit > 0 ? 'var(--accent-red)' : 'var(--accent-green)' %>; display: flex; align-items: baseline; justify-content: center; gap: 4px;">
                    <%= maxDeficit > 0 ? '-' + Math.ceil(maxDeficit).toLocaleString('id-ID') : 'Terpenuhi' %>
                  </div>
                  
                  <% if (maxDeficit > 0) { %>
                    <div class="target-harian-hero-unit" style="color: var(--accent-red);">
                      dokumen / hari
                    </div>
                  <% } %>

                  <div class="target-harian-hero-desc">
                    Kekurangan laju pengumpulan harian se-kabupaten dari target minimal agar pendataan on-track.
                  </div>

                </div>

              </div>

            </div>

            <!-- BAR CHART: Tren Penambahan Harian -->
            <div class="county-increment-chart-panel" style="margin-top: 24px; padding-top: 20px; border-top: 1px dashed var(--border); width: 100%;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 6px;">
                  <span style="font-size: 11px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 6px;">
                    <i class="bi bi-bar-chart-fill" style="color: var(--accent-purple);"></i> Grafik Tren Penambahan Dokumen Harian FASIH
                  </span>
                  <span style="font-size: 10px; color: var(--text-muted);">Sesi Upload Terakhir</span>
                </div>
                <div style="height: 180px; position: relative; width: 100%;">
                  <canvas id="dailyCountyIncrementChartCanvas"></canvas>
                </div>
            </div>

      </div>
      <% } %>

      <!-- SEBARAN PERFORMA PENAMBAHAN DOKUMEN PETUGAS (TABEL) -->
      <% if (settings.overview_fasih === '1' && typeof distLast !== 'undefined' && distLast) { %>
      <div class="card" style="margin: 0; position: relative; overflow: hidden; background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 24px;">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 32px; height: 32px; border-radius: 10px; background: rgba(34, 197, 94, 0.12); color: var(--accent-green); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;">
              <i class="bi bi-table"></i>
            </div>
            <div>
              <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em;">
                Sebaran Penambahan Dokumen Petugas (<span id="distDateLabel">Update Ini</span>)
              </h4>
              <p style="margin: 2px 0 0 0; font-size: 11px; color: var(--text-muted);">
                Distribusi penambahan realisasi dokumen FASIH per petugas (PCL) pada tanggal <span id="distDateSub"><%= latestUpload ? formatIndonesianDate(latestUpload.tanggal) : 'sesi upload terbaru' %></span>
              </p>
            </div>
          </div>

          <!-- Date Navigator Controls -->
          <div style="display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border); border-radius: 8px; padding: 4px 6px;">
            <button id="btnDistPrev" onclick="navigateDistDate(-1)" class="btn-icon" style="background: transparent; border: none; color: var(--text-primary); cursor: pointer; padding: 6px 10px; font-size: 14px; border-radius: 6px; display: flex; align-items: center; justify-content: center; transition: var(--transition);" title="Sebelumnya" disabled>
              <i class="bi bi-chevron-left"></i>
            </button>
            
            <select id="distDateSelector" aria-label="Pilih Tanggal Sebaran" onchange="onDistDateSelectChange(this.value)" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; color: var(--text-primary); font-size: 12px; font-weight: 600; padding: 4px 28px 4px 8px; outline: none; cursor: pointer; -webkit-appearance: none; -moz-appearance: none; appearance: none; background-image: url(&quot;data:image/svg+xml;utf8,<svg fill='white' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/><path d='M0 0h24v24H0z' fill='none'/></svg>&quot;); background-repeat: no-repeat; background-position-x: 100%; background-position-y: 50%;">
              <% if (latestUpload) { %>
                <option value="<%= latestUpload.tanggal %>"><%= formatIndonesianDate(latestUpload.tanggal) %></option>
              <% } %>
            </select>
            
            <button id="btnDistNext" onclick="navigateDistDate(1)" class="btn-icon" style="background: transparent; border: none; color: var(--text-primary); cursor: pointer; padding: 6px 10px; font-size: 14px; border-radius: 6px; display: flex; align-items: center; justify-content: center; transition: var(--transition);" title="Berikutnya" disabled>
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>
        </div>

        <% 
          const totalDistPcl = (distLast.bucket_0 || 0) + (distLast.bucket_1_4 || 0) + (distLast.bucket_5_7 || 0) + (distLast.bucket_8_12 || 0) + (distLast.bucket_13_plus || 0) || 1;
          const rows = [
            { id: 'bucket_0', label: '0 Dokumen (Stagnan)', count: distLast.bucket_0 || 0, color: 'var(--accent-red)' },
            { id: 'bucket_1_4', label: '1 - 4 Dokumen (Rendah)', count: distLast.bucket_1_4 || 0, color: '#f59e0b' },
            { id: 'bucket_5_7', label: '5 - 7 Dokumen (Sedang)', count: distLast.bucket_5_7 || 0, color: 'var(--accent-cyan)' },
            { id: 'bucket_8_12', label: '8 - 12 Dokumen (Tinggi)', count: distLast.bucket_8_12 || 0, color: 'var(--accent-purple)' },
            { id: 'bucket_13_plus', label: '>= 13 Dokumen (Target)', count: distLast.bucket_13_plus || 0, color: 'var(--accent-green)' }
          ];
        %>

        <div id="distTableContainer" style="overflow-x: auto; transition: opacity 0.2s ease;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;">
            <thead>
              <tr style="border-bottom: 2px solid var(--border); color: var(--text-muted); font-weight: 700; text-transform: uppercase; font-size: 10px; letter-spacing: 0.05em;">
                <th style="padding: 10px 12px; font-weight: 700; width: 220px;">Kategori Penambahan</th>
                <th style="padding: 10px 12px; text-align: center; font-weight: 700; width: 120px;">Jumlah Petugas</th>
                <th style="padding: 10px 12px; text-align: center; font-weight: 700; width: 100px;">Persentase</th>
                <th style="padding: 10px 12px; font-weight: 700;">Rasio Distribusi</th>
              </tr>
            </thead>
            <tbody id="distTableBody">
              <% rows.forEach(row => { 
                const pct = ((row.count / totalDistPcl) * 100).toFixed(1);
              %>
                <tr onclick="showPclDistributionModal('<%= row.id %>', '<%= row.label %>', '<%= row.color %>')" style="border-bottom: 1px solid var(--border); transition: var(--transition); cursor: pointer;" class="hover-row" title="Klik untuk lihat daftar petugas kelompok ini">
                  <td style="padding: 12px; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: <%= row.color %>;"></span>
                    <%= row.label %>
                  </td>
                  <td style="padding: 12px; text-align: center; font-weight: 700; color: var(--text-primary); font-size: 13px;">
                    <%= row.count.toLocaleString('id-ID') %>
                  </td>
                  <td style="padding: 12px; text-align: center; font-weight: 700; color: <%= row.color %>;">
                    <%= pct %>%
                  </td>
                  <td style="padding: 12px;">
                    <div style="background: rgba(255, 255, 255, 0.03); height: 8px; border-radius: 4px; overflow: hidden; width: 100%; border: 1px solid var(--border);">
                      <div style="background: <%= row.color %>; width: <%= pct %>%; height: 100%; border-radius: 4px;"></div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr style="background: rgba(255, 255, 255, 0.01); font-weight: 700;">
                <td style="padding: 12px; font-weight: 700; color: var(--text-primary);">Total Petugas (PCL)</td>
                <td id="distTotalCount" style="padding: 12px; text-align: center; font-weight: 800; color: var(--text-primary); font-size: 13px;">
                  <%= totalDistPcl.toLocaleString('id-ID') %>
                </td>
                <td style="padding: 12px; text-align: center; font-weight: 700; color: var(--text-primary);">100%</td>
                <td style="padding: 12px;"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- Modal Detail Sebaran Petugas -->
      <div id="pclDistModal" style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; overflow: hidden; background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; padding: 16px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; width: 100%; max-width: 480px; max-height: 80vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4), 0 10px 10px -5px rgba(0, 0, 0, 0.4);">
          
          <!-- Modal Header -->
          <div style="padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: rgba(255, 255, 255, 0.01);">
            <div style="display: flex; align-items: center; gap: 8px; min-width: 0;">
              <span id="modalCategoryColor" style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;"></span>
              <h4 id="modalCategoryTitle" style="margin: 0; font-size: 13px; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"></h4>
            </div>
            <button onclick="closePclDistributionModal()" style="background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 16px; padding: 4px; display: flex; align-items: center; justify-content: center; transition: var(--transition);"><i class="bi bi-x-lg"></i></button>
          </div>

          <!-- Search & Info Bar -->
          <div style="padding: 12px 20px; border-bottom: 1px solid var(--border); background: rgba(255, 255, 255, 0.02); display: flex; gap: 10px; align-items: center;">
            <div style="position: relative; flex: 1;">
              <i class="bi bi-search" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 12px;"></i>
              <input type="text" id="modalSearchInput" placeholder="Cari nama petugas..." oninput="filterPclList()" style="width: 100%; padding: 6px 10px 6px 28px; font-size: 12px; background: rgba(0, 0, 0, 0.2); border: 1px solid var(--border); border-radius: 8px; color: var(--text-primary); outline: none; transition: var(--transition);">
            </div>
            <span id="modalPclCount" style="font-size: 11px; font-weight: 700; color: var(--text-primary); background: rgba(255, 255, 255, 0.04); padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border); white-space: nowrap;"></span>
          </div>

          <!-- Modal Body (List Table) -->
          <div style="flex: 1; overflow-y: auto; padding: 0;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;">
              <thead>
                <tr style="border-bottom: 1px solid var(--border); background: rgba(255, 255, 255, 0.01); color: var(--text-muted); font-weight: 700; font-size: 9px; letter-spacing: 0.05em; text-transform: uppercase;">
                  <th style="padding: 10px 20px;">Nama Petugas (PCL)</th>
                  <th style="padding: 10px 20px; text-align: right;">Penambahan</th>
                </tr>
              </thead>
              <tbody id="modalPclTableBody">
                <!-- Row will be injected by JS -->
              </tbody>
            </table>
          </div>

        </div>
      </div>
      <% } %>

      <!-- Progres Realisasi Pencacahan Muatan (Opsional) -->
      <% if (settings.overview_muatan === '1') { %>
      <div class="card muatan-col" style="margin: 0; position: relative; overflow: hidden; background: var(--bg-card); border: 1px solid var(--border); padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: rgba(6, 182, 212, 0.15); display: flex; align-items: center; justify-content: center; color: var(--accent-cyan); font-size: 20px; flex-shrink: 0;">
              <i class="bi bi-speedometer2"></i>
            </div>
            <div style="min-width: 0;">
              <h3 style="margin: 0; font-size: 14px; font-weight: 700; color: var(--text-primary);">Progres Realisasi Pencacahan Muatan</h3>
              <p style="margin: 2px 0 0 0; font-size: 10px; color: var(--text-muted); line-height: 1.2;">Realisasi Usaha Total vs Target Muatan <%= settings.target_muatan_mode === 'honor' ? 'Honor' : 'Prelist' %> (Indikator Opsional Monitoring)</p>
            </div>
          </div>
          <div style="text-align: right; flex-shrink: 0;">
            <% let totalPct = summary.muatan_pct_str; %>
            <div style="font-size: 22px; font-weight: 900; color: var(--accent-cyan);"><%= totalPct %>%</div>
            <div style="font-size: 10px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Capaian Muatan</div>
          </div>
        </div>

        <div class="progress-timeline-container" style="position: relative; height: 28px; margin-top: 22px; margin-bottom: 14px;">
          <!-- Track & Progress Bar -->
          <div style="background: var(--bg-progress-wrap); height: 28px; border-radius: 14px; overflow: hidden; position: absolute; top: 0; left: 0; right: 0; bottom: 0; border: 1px solid var(--border); display: flex; align-items: center; padding: 0 4px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.15);">
            <div class="progress-bar" data-width="<%= totalPct %>" style="background: linear-gradient(90deg, var(--accent-blue) 0%, var(--accent-cyan) 100%); height: 20px; width: 0%; border-radius: 10px; transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; justify-content: flex-end; padding-right: 12px; min-width: 24px; box-shadow: 0 2px 8px rgba(var(--accent-rgb), 0.25);">
              <% if (parseFloat(totalPct) >= 15) { %>
                <span style="font-size: 11px; font-weight: 800; color: #ffffff; text-shadow: 0 1px 2px rgba(0,0,0,0.5);"><%= totalPct %>%</span>
              <% } %>
            </div>
            <% if (parseFloat(totalPct) < 15) { %>
              <span style="margin-left: 12px; font-size: 11px; font-weight: 800; color: var(--text-primary); white-space: nowrap;"><%= totalPct %>%</span>
            <% } %>
          </div>

          <!-- Marker 25% (30 Juni) -->
          <div class="target-marker" style="position: absolute; left: 25%; top: -3px; height: 34px; border-left: 2px dashed <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--border)' %>; z-index: 2; pointer-events: none;">
            <span class="target-marker-text" style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); font-size: 8px; font-weight: 900; color: <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">Target 30 Jun: 25%</span>
          </div>

          <!-- Marker 40% (15 Juli) -->
          <div class="target-marker" style="position: absolute; left: 40%; top: -3px; height: 34px; border-left: 2px dashed <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--border)' %>; z-index: 2; pointer-events: none;">
            <span class="target-marker-text" style="position: absolute; bottom: -14px; left: 50%; transform: translateX(-50%); font-size: 8px; font-weight: 900; color: <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">Target 15 Jul: 40%</span>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border);">
          <div>
            <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Realisasi</div>
            <div style="font-size: 15px; font-weight: 800; color: var(--text-primary);"><%= summary.muatan_selesai.toLocaleString('id-ID') %></div>
          </div>
          <div>
            <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Target</div>
            <div style="font-size: 15px; font-weight: 800; color: var(--text-primary);"><%= summary.muatan_total.toLocaleString('id-ID') %></div>
          </div>
          <div>
            <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Sisa</div>
            <div style="font-size: 15px; font-weight: 800; color: var(--accent-yellow);"><%= (summary.muatan_total - summary.muatan_selesai).toLocaleString('id-ID') %></div>
          </div>
        </div>

        <!-- Rincian Tambahan Pencacahan Muatan (Dikelompokkan Usaha/Keluarga) -->
        <div style="border-top: 1px dashed var(--border); padding-top: 16px; margin-top: 16px;">
          <div style="font-size: 11px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.5px;"><i class="bi bi-info-circle-fill text-cyan"></i> Detail Perubahan & Temuan Lapangan</div>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px;">
            
            <!-- KELOMPOK USAHA -->
            <div style="background: var(--bg-summary); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px;">
              <div style="font-size: 11px; font-weight: 800; color: var(--accent-cyan); text-transform: uppercase; margin-bottom: 10px; letter-spacing: 0.5px;"><i class="bi bi-briefcase-fill"></i> Temuan Sektor Usaha</div>
              <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
                
                <!-- Usaha Baru -->
                <div style="background: rgba(16, 185, 129, 0.04); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: var(--radius-sm); padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <div>
                    <div style="font-size: 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">USAHA BARU</div>
                    <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.2;">Terdaftar baru</div>
                  </div>
                  <div style="font-size: 13px; font-weight: 800; color: var(--accent-green);">+<%= summary.usaha_baru.toLocaleString('id-ID') %></div>
                </div>

                <!-- Usaha Tutup -->
                <div style="background: rgba(239, 68, 68, 0.04); border: 1px solid rgba(239, 68, 68, 0.15); border-radius: var(--radius-sm); padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <div>
                    <div style="font-size: 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">USAHA TUTUP</div>
                    <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.2;">Tutup/Pindah</div>
                  </div>
                  <div style="font-size: 13px; font-weight: 800; color: var(--accent-red);"><%= summary.usaha_tutup.toLocaleString('id-ID') %></div>
                </div>

                <!-- Usaha Tidak Ditemukan -->
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <div>
                    <div style="font-size: 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">TDK DITEMUKAN</div>
                    <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.2;">Tidak ada fisik</div>
                  </div>
                  <div style="font-size: 13px; font-weight: 800; color: var(--text-primary);"><%= summary.usaha_tidak_ditemukan.toLocaleString('id-ID') %></div>
                </div>

                <!-- Usaha Ganda (Sinyal Kualitas Data) -->
                <div style="background: rgba(239, 68, 68, 0.04); border: 1px solid rgba(239, 68, 68, 0.15); border-radius: var(--radius-sm); padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <div>
                    <div style="font-size: 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">USAHA GANDA</div>
                    <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.2;">Teridentifikasi ganda</div>
                  </div>
                  <div style="font-size: 13px; font-weight: 800; color: var(--accent-red);"><%= (summary.usaha_ganda || 0).toLocaleString('id-ID') %></div>
                </div>

              </div>
            </div>

            <!-- KELOMPOK KELUARGA -->
            <div style="background: var(--bg-summary); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px;">
              <div style="font-size: 11px; font-weight: 800; color: var(--accent-purple); text-transform: uppercase; margin-bottom: 10px; letter-spacing: 0.5px;"><i class="bi bi-people-fill"></i> Temuan Sektor Keluarga</div>
              <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
                
                <!-- Total Keluarga Ditemukan -->
                <div style="background: rgba(168, 85, 247, 0.04); border: 1px solid rgba(168, 85, 247, 0.15); border-radius: var(--radius-sm); padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <div>
                    <div style="font-size: 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">KK DITEMUKAN</div>
                    <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.2;">Total ditemukan</div>
                  </div>
                  <div style="font-size: 13px; font-weight: 800; color: var(--accent-purple);"><%= summary.keluarga_total.toLocaleString('id-ID') %></div>
                </div>

                <!-- Keluarga Baru -->
                <div style="background: rgba(6, 182, 212, 0.04); border: 1px solid rgba(6, 182, 212, 0.15); border-radius: var(--radius-sm); padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <div>
                    <div style="font-size: 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">KELUARGA BARU</div>
                    <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.2;">Terdaftar baru</div>
                  </div>
                  <div style="font-size: 13px; font-weight: 800; color: var(--accent-cyan);">+<%= summary.keluarga_baru.toLocaleString('id-ID') %></div>
                </div>

                <!-- Meninggal -->
                <div style="background: rgba(245, 158, 11, 0.04); border: 1px solid rgba(245, 158, 11, 0.15); border-radius: var(--radius-sm); padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <div>
                    <div style="font-size: 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">MENINGGAL</div>
                    <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.2;">Anggota KK</div>
                  </div>
                  <div style="font-size: 13px; font-weight: 800; color: var(--accent-yellow);"><%= summary.meninggal.toLocaleString('id-ID') %></div>
                </div>

                <!-- Keluarga Tidak Ditemukan -->
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <div>
                    <div style="font-size: 8px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">TDK DITEMUKAN</div>
                    <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.2;">Tidak ditemukan</div>
                  </div>
                  <div style="font-size: 13px; font-weight: 800; color: var(--text-primary);"><%= summary.keluarga_tidak_ditemukan.toLocaleString('id-ID') %></div>
                </div>

              </div>
            </div>

          </div>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- TREN CHARTS & HEATMAP GRID -->
    <% if (settings.overview_heatmap === '1' || settings.overview_tren_muatan === '1' || settings.overview_tren_fasih === '1') { %>
    <div class="trend-charts-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 20px; margin-top: 24px;">
      
      <!-- HEATMAP AKTIVITAS HARIAN -->
      <% if (settings.overview_heatmap === '1') { %>
      <div class="card" style="margin: 0;">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding: 16px 20px;">
          <div class="card-title" style="font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 8px;"><i class="bi bi-grid-3x3-gap-fill text-cyan" style="font-size: 18px;"></i> Heatmap Aktivitas Harian</div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <select id="heatmapMetricSelect" aria-label="Pilih Metrik Heatmap" class="form-select form-select-sm" style="font-size: 12px; padding: 6px 12px; width: auto; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary); cursor: pointer; font-weight: 500;">
              <option value="fasih">Progres FASIH (Submit + Approve + Reject)</option>
              <option value="survey">Survei Terdata (Usaha + Keluarga)</option>
              <option value="sls">SLS Selesai</option>
            </select>
          </div>
        </div>
        <div class="card-body" style="padding: 20px 24px; overflow-x: auto;">
          <div class="heatmap-container" style="min-width: max-content; display: flex; flex-direction: column; gap: 12px;">
            <div id="heatmapGrid" style="display: flex; gap: 4px; position: relative;"></div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--text-muted); margin-top: 12px; padding: 0 4px;">
              <div id="heatmapDateRange" style="font-weight: 600; color: var(--text-secondary);">...</div>
              <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-weight: 500;">Kurang</span>
                <div class="heatmap-square" style="width: 15px; height: 15px; border-radius: 3px; background: var(--bg-progress-wrap); border: 1px solid var(--border-light);"></div>
                <div class="heatmap-square" style="width: 15px; height: 15px; border-radius: 3px; background: rgba(6, 182, 212, 0.25);"></div>
                <div class="heatmap-square" style="width: 15px; height: 15px; border-radius: 3px; background: rgba(6, 182, 212, 0.5);"></div>
                <div class="heatmap-square" style="width: 15px; height: 15px; border-radius: 3px; background: rgba(6, 182, 212, 0.75);"></div>
                <div class="heatmap-square" style="width: 15px; height: 15px; border-radius: 3px; background: rgb(6, 182, 212); box-shadow: 0 0 6px rgba(6, 182, 212, 0.4);"></div>
                <span style="font-weight: 500;">Lebih</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- TREN HARIAN MUATAN -->
      <% if (settings.overview_tren_muatan === '1') { %>
      <div class="card muatan-col" style="margin: 0;">
        <div class="card-header">
          <div class="card-title"><i class="bi bi-calendar3"></i> Tren Progres Pengumpulan Data (Muatan)</div>
        </div>
        <div style="height: 300px; position: relative;">
          <canvas id="trenChartCanvas"></canvas>
        </div>
      </div>
      <% } %>

      <!-- TREN HARIAN FASIH -->
      <% if (settings.overview_tren_fasih === '1') { %>
      <div class="card" style="margin: 0;">
        <div class="card-header">
          <div class="card-title"><i class="bi bi-phone"></i> Tren Progres Status Dokumen FASIH</div>
        </div>
        <div style="height: 300px; position: relative;">
          <canvas id="trenFasihChartCanvas"></canvas>
        </div>
      </div>

      <div class="card" style="margin: 0;">
        <div class="card-header">
          <div class="card-title"><i class="bi bi-bar-chart-steps"></i> Tren Penambahan Harian Status Dokumen FASIH</div>
        </div>
        <div style="height: 300px; position: relative; padding: 0 16px 16px 16px;">
          <canvas id="dailyFasihStatusChartCanvas"></canvas>
        </div>
      </div>
      <% } %>

    </div>
    <% } %>

    <!-- BOTTOM ROW: KECAMATAN DETAILS -->
    <% if (settings.overview_kecamatan === '1') { %>
    <div class="card mt-4">
      <div class="card-header">
        <div class="card-title"><i class="bi bi-geo-alt"></i> Ringkasan Progres per Kecamatan</div>
        <a href="/kecamatan" class="btn btn-secondary btn-sm">Rincian Kecamatan <i class="bi bi-arrow-right-short"></i></a>
      </div>

      <div class="search-wrap mb-4" style="margin-bottom: 16px;">
        <input type="search" id="kecOverviewSearch" placeholder="Cari kecamatan..." aria-label="Cari nama kecamatan" style="width: 100%; max-width: 280px;">
      </div>

      <div class="comparison-grid">
        
        <div class="table-wrap">
          <!-- Desktop Table (visible on desktop only) -->
          <table id="kecOverviewTable" class="hide-sm">
            <thead>
              <tr>
                <th rowspan="2" class="text-center th-no" scope="col">No</th>
                <th rowspan="2" scope="col">Kecamatan</th>
                <th rowspan="2" class="text-right bg-purple-soft" scope="col" style="min-width: 140px;">FASIH %</th>
                <th rowspan="2" class="text-right bg-cyan-soft muatan-col" scope="col" style="min-width: 140px;">Muatan %</th>
                <!-- <th colspan="2" class="text-center" scope="colgroup" style="border-bottom: 1px solid var(--border);">SubSLS</th> -->
                <th colspan="2" class="text-center bg-purple-soft" scope="colgroup" style="border-bottom: 1px solid var(--border);">Assignment FASIH</th>
                <th colspan="2" class="text-center bg-cyan-soft muatan-col" scope="colgroup" style="border-bottom: 1px solid var(--border);">Progres Muatan</th>
              </tr>
              <tr>
                <!-- <th scope="col" class="text-right">Total</th> -->
                <!-- <th scope="col" class="text-right">Selesai</th> -->
                <th scope="col" class="text-right bg-purple-soft">Approved</th>
                <th scope="col" class="text-right bg-purple-soft">Target</th>
                <th scope="col" class="text-right bg-cyan-soft muatan-col">Realisasi</th>
                <th scope="col" class="text-right bg-cyan-soft muatan-col">Target</th>
              </tr>
            </thead>
            <tbody>
              <% kecStats.forEach((k, index) => { %>
                <% let fasihPct = k.fasih_pct_str; %>
                <% let muatanPct = k.muatan_pct_str; %>
                <tr>
                  <td class="text-center td-index"><%= index + 1 %></td>
                  <td class="td-primary" scope="row"><a href="/kecamatan?kec=<%= encodeURIComponent(k.kecamatan) %>" class="link-plain"><i class="bi bi-geo-alt"></i> <%= k.kecamatan %></a></td>
                  <td class="bg-purple-soft" data-sort="<%= parseFloat(fasihPct) %>" style="min-width: 160px; padding: 6px 10px; vertical-align: middle;">
                    <%
                      const fReal = (k.submitted_total || 0) + (k.approved_total || 0) + (k.rejected_total || 0);
                      const fTgt = k.target_fasih_total || 0;
                      const fW = Math.min(parseFloat(fasihPct), 100);
                      const fColor = fW >= 100 ? 'var(--accent-green)' : (fW < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');
                    %>
                    <div class="bar-label" style="font-size:10px; margin-bottom:3px;">
                      <span style="font-weight:700; color:<%= fColor %>"><%= fasihPct %>%</span>
                      <span><%= fReal.toLocaleString('id-ID') %> / <%= fTgt.toLocaleString('id-ID') %></span>
                    </div>
                    <div class="progress-track-sm">
                      <div class="progress-bar <%= fW >= 100 ? 'green' : (fW < 40 ? 'red' : 'purple') %>" data-width="<%= fW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                    </div>
                  </td>
                  <td class="text-right bg-cyan-soft muatan-col" data-sort="<%= parseFloat(muatanPct) %>" style="min-width: 160px; padding: 6px 10px; vertical-align: middle;">
                    <% if (parseFloat(muatanPct) >= 100) { %>
                      <span class="badge badge-green">100%</span>
                    <% } else if (parseFloat(muatanPct) < 40) { %>
                      <span class="badge badge-red"><%= muatanPct %>%</span>
                    <% } else { %>
                      <span class="badge badge-blue"><%= muatanPct %>%</span>
                    <% } %>
                  </td>
                  <!-- <td class="text-right" data-sort="<%= k.total_subsls %>"><%= k.total_subsls %></td> -->
                  <!-- <td class="text-right fw-bold" data-sort="<%= k.selesai %>"><%= k.selesai %></td> -->
                  <td class="text-right bg-purple-soft" data-sort="<%= k.approved_total || 0 %>"><%= (k.approved_total || 0).toLocaleString('id-ID') %></td>
                  <td class="text-right bg-purple-soft" data-sort="<%= k.target_fasih_total || 0 %>"><%= (k.target_fasih_total || 0).toLocaleString('id-ID') %></td>
                  <td class="text-right fw-bold bg-cyan-soft muatan-col" data-sort="<%= k.muatan_selesai !== undefined ? k.muatan_selesai : (k.usaha_total + k.keluarga_total) %>"><%= (k.muatan_selesai !== undefined ? k.muatan_selesai : (k.usaha_total + k.keluarga_total)).toLocaleString('id-ID') %></td>
                  <td class="text-right bg-cyan-soft muatan-col" data-sort="<%= k.total_muatan %>"><%= k.total_muatan.toLocaleString('id-ID') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>


        </div>

        <div style="display: flex; flex-direction: column; gap: 20px; width: 100%; margin-top: 16px;">
          <div style="height: 280px; position: relative;">
            <canvas id="kecBarChartCanvas"></canvas>
          </div>
          <div style="height: 280px; position: relative; border-top: 1px dashed var(--border); padding-top: 16px;">
            <canvas id="kecFasihBarChartCanvas"></canvas>
          </div>
        </div>

      </div>
    </div>
    <% } %>

    <!-- DETAILS HOUSING / RUMAH -->
    <% if (settings.overview_bangunan === '1') { %>
    <div class="card mt-4">
      <div class="card-header">
        <div class="card-title"><i class="bi bi-house-door"></i> Klasifikasi Tipe Bangunan Tinggal</div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); gap: 12px;">

        <div class="bangunan-card">
          <div class="bangunan-img-wrap">
            <picture style="display: block;">
              <source srcset="/images/bangunan_tunggal.webp" type="image/webp">
              <img src="/images/bangunan_tunggal.png" alt="Rumah Tunggal" class="bangunan-img">
            </picture>
          </div>
          <div class="bangunan-label">Rumah Tunggal</div>
          <div class="bangunan-value"><%= (summary.rumah_tunggal || 0).toLocaleString('id-ID') %></div>
          <div class="bangunan-sub">Bangunan mandiri tunggal</div>
        </div>

        <div class="bangunan-card">
          <div class="bangunan-img-wrap">
            <picture style="display: block;">
              <source srcset="/images/bangunan_deret.webp" type="image/webp">
              <img src="/images/bangunan_deret.png" alt="Rumah Deret" class="bangunan-img">
            </picture>
          </div>
          <div class="bangunan-label">Rumah Deret</div>
          <div class="bangunan-value"><%= (summary.rumah_deret || 0).toLocaleString('id-ID') %></div>
          <div class="bangunan-sub">Bangunan gandeng/berbaris</div>
        </div>

        <div class="bangunan-card">
          <div class="bangunan-img-wrap">
            <picture style="display: block;">
              <source srcset="/images/bangunan_susun.webp" type="image/webp">
              <img src="/images/bangunan_susun.png" alt="Rumah Susun" class="bangunan-img">
            </picture>
          </div>
          <div class="bangunan-label">Rumah Susun</div>
          <div class="bangunan-value"><%= (summary.rumah_susun || 0).toLocaleString('id-ID') %></div>
          <div class="bangunan-sub">Rusun sederhana</div>
        </div>

        <div class="bangunan-card">
          <div class="bangunan-img-wrap">
            <picture style="display: block;">
              <source srcset="/images/bangunan_apartemen.webp" type="image/webp">
              <img src="/images/bangunan_apartemen.png" alt="Apartemen" class="bangunan-img">
            </picture>
          </div>
          <div class="bangunan-label">Apartemen</div>
          <div class="bangunan-value"><%= (summary.apartemen || 0).toLocaleString('id-ID') %></div>
          <div class="bangunan-sub">Kondominium / apartemen</div>
        </div>

        <div class="bangunan-card">
          <div class="bangunan-img-wrap">
            <picture style="display: block;">
              <source srcset="/images/bangunan_lainnya.webp" type="image/webp">
              <img src="/images/bangunan_lainnya.png" alt="Lainnya" class="bangunan-img">
            </picture>
          </div>
          <div class="bangunan-label">Lainnya</div>
          <div class="bangunan-value"><%= (summary.lainnya || 0).toLocaleString('id-ID') %></div>
          <div class="bangunan-sub">Ruko, mes, kontainer, dll.</div>
        </div>

      </div>
    </div>
    <% } %>

  <% } %>
</div>

<script>
  // AI Smart Insights Client Handler
  // Helper to parse simple markdown to HTML tags
  function parseSimpleMarkdown(text) {
    if (!text) return '';
    let html = text;
    // Bold: **text** or __text__ -> <b>text</b>
    html = html.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
    html = html.replace(/__(.*?)__/g, '<b>$1</b>');
    // Italic: *text* or _text_ -> <i>text</i>
    html = html.replace(/\*(.*?)\*/g, '<i>$1</i>');
    html = html.replace(/_(.*?)_/g, '<i>$1</i>');
    return html;
  }

  async function loadAiInsights(forceRefresh = false) {
    const contentEl = document.getElementById('aiInsightsContent');
    const refreshIcon = document.getElementById('aiRefreshIcon');
    if (!contentEl) return;

    if (refreshIcon) refreshIcon.classList.add('bi-spin');

    // Show skeleton loader
    contentEl.innerHTML = `
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <div class="ai-pulse-bar" style="width: 85%;"></div>
        <div class="ai-pulse-bar" style="width: 95%; animation-delay: 0.2s;"></div>
        <div class="ai-pulse-bar" style="width: 70%; animation-delay: 0.4s;"></div>
      </div>
    `;

    try {
      const url = `/api/ai-insights${forceRefresh ? '?refresh=true' : ''}`;
      const response = await fetch(url);
      const data = await response.json();

      if (data.success && data.insights) {
        contentEl.innerHTML = parseSimpleMarkdown(data.insights);
      } else {
        contentEl.innerHTML = `
          <div style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: center; gap: 8px; padding: 12px; background: rgba(239, 68, 68, 0.08); border: 1px dashed rgba(239, 68, 68, 0.2); border-radius: 8px;">
            <i class="bi bi-exclamation-triangle-fill" style="color: var(--accent-red); font-size: 16px;"></i>
            <span>Gagal memuat insight: ${data.error || 'Terjadi kesalahan sistem.'}</span>
          </div>
        `;
      }
    } catch (err) {
      console.error('Error fetching AI insights:', err);
      contentEl.innerHTML = `
        <div style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: center; gap: 8px; padding: 12px; background: rgba(239, 68, 68, 0.08); border: 1px dashed rgba(239, 68, 68, 0.2); border-radius: 8px;">
          <i class="bi bi-wifi-off" style="color: var(--accent-red); font-size: 16px;"></i>
          <span>Koneksi terputus. Gagal mengambil data AI insights.</span>
        </div>
      `;
    } finally {
      if (refreshIcon) refreshIcon.classList.remove('bi-spin');
    }
  }

  window.refreshAiInsights = function(e) {
    if (e) e.preventDefault();
    const container = document.getElementById('aiInsightsCollapseContainer');
    const icon = document.getElementById('aiCollapseIcon');
    if (container && icon) {
      container.style.display = 'block';
      icon.className = 'bi bi-chevron-up';
    }
    loadAiInsights(true);
  };

  window.toggleAiInsightsCollapse = function(e) {
    if (e) e.preventDefault();
    const container = document.getElementById('aiInsightsCollapseContainer');
    const icon = document.getElementById('aiCollapseIcon');
    if (!container || !icon) return;

    if (container.style.display === 'none') {
      container.style.display = 'block';
      icon.className = 'bi bi-chevron-up';
      const contentEl = document.getElementById('aiInsightsContent');
      if (contentEl && (contentEl.innerText.trim() === '' || contentEl.querySelector('.ai-pulse-bar'))) {
        loadAiInsights(false);
      }
    } else {
      container.style.display = 'none';
      icon.className = 'bi bi-chevron-down';
    }
  };

  // Heatmap rendering helpers
  function formatLocalDate(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  function renderHeatmap(trenData, metric = 'fasih') {
    const container = document.getElementById('heatmapGrid');
    if (!container || !trenData || !trenData.length) return;

    container.innerHTML = '';

    const finalStatusByDate = {};
    trenData.forEach(d => {
      finalStatusByDate[d.tanggal] = {
        subsls_selesai: d.subsls_selesai || 0,
        usaha_total: d.usaha_total || 0,
        keluarga_total: d.keluarga_total || 0,
        submitted_total: d.submitted_total || 0,
        approved_total: d.approved_total || 0,
        rejected_total: d.rejected_total || 0
      };
    });

    const gridStartDate = new Date('2026-06-01T00:00:00');
    const startDay = gridStartDate.getDay();
    gridStartDate.setDate(gridStartDate.getDate() - startDay);

    const gridEndDate = new Date('2026-09-30T00:00:00');
    const endDay = gridEndDate.getDay();
    gridEndDate.setDate(gridEndDate.getDate() + (6 - endDay));

    const dates = [];
    let curr = new Date(gridStartDate);
    
    let lastKnownState = { subsls_selesai: 0, usaha_total: 0, keluarga_total: 0, submitted_total: 0, approved_total: 0, rejected_total: 0 };
    for (let i = 0; i < trenData.length; i++) {
      const dDate = new Date(trenData[i].tanggal);
      if (dDate < gridStartDate) {
        lastKnownState = {
          subsls_selesai: trenData[i].subsls_selesai || 0,
          usaha_total: trenData[i].usaha_total || 0,
          keluarga_total: trenData[i].keluarga_total || 0,
          submitted_total: trenData[i].submitted_total || 0,
          approved_total: trenData[i].approved_total || 0,
          rejected_total: trenData[i].rejected_total || 0
        };
      } else {
        break;
      }
    }

    const dailyStates = {};
    let currentCumulative = { ...lastKnownState };

    while (curr <= gridEndDate) {
      const dateStr = formatLocalDate(curr);
      if (finalStatusByDate[dateStr]) {
        currentCumulative = finalStatusByDate[dateStr];
      }
      dailyStates[dateStr] = { ...currentCumulative };
      dates.push(dateStr);
      curr.setDate(curr.getDate() + 1);
    }

    const dailyIncrements = [];
    for (let i = 0; i < dates.length; i++) {
      const dateStr = dates[i];
      const current = dailyStates[dateStr];
      
      let prev = lastKnownState;
      if (i > 0) {
        prev = dailyStates[dates[i - 1]];
      }

      let increment = 0;
      let cumulative = 0;

      if (metric === 'fasih') {
        const currentVal = (current.submitted_total + current.approved_total + current.rejected_total);
        const prevVal = (prev.submitted_total + prev.approved_total + prev.rejected_total);
        increment = Math.max(0, currentVal - prevVal);
        cumulative = currentVal;
      } else if (metric === 'survey') {
        const currentVal = (current.usaha_total + current.keluarga_total);
        const prevVal = (prev.usaha_total + prev.keluarga_total);
        increment = Math.max(0, currentVal - prevVal);
        cumulative = currentVal;
      } else if (metric === 'sls') {
        increment = Math.max(0, current.subsls_selesai - prev.subsls_selesai);
        cumulative = current.subsls_selesai;
      }

      dailyIncrements.push({
        date: dateStr,
        value: increment,
        cumulative: cumulative
      });
    }

    const nonZero = dailyIncrements.map(d => d.value).filter(v => v > 0).sort((a, b) => a - b);
    const maxVal = nonZero.length ? nonZero[nonZero.length - 1] : 0;
    let q1 = maxVal * 0.15;
    let q2 = maxVal * 0.4;
    let q3 = maxVal * 0.7;

    if (nonZero.length >= 4) {
      q1 = nonZero[Math.floor(nonZero.length * 0.25)];
      q2 = nonZero[Math.floor(nonZero.length * 0.5)];
      q3 = nonZero[Math.floor(nonZero.length * 0.75)];
    }

    const dateRangeEl = document.getElementById('heatmapDateRange');
    if (dateRangeEl) {
      dateRangeEl.textContent = `1 Juni 2026 - 30 September 2026`;
    }

    const weekdayCol = document.createElement('div');
    weekdayCol.style.display = 'flex';
    weekdayCol.style.flexDirection = 'column';
    weekdayCol.style.justifyContent = 'space-between';
    weekdayCol.style.paddingRight = '10px';
    weekdayCol.style.fontSize = '11px';
    weekdayCol.style.fontWeight = '500';
    weekdayCol.style.color = 'var(--text-muted)';
    weekdayCol.style.height = '129px';
    weekdayCol.style.marginTop = '22px';
    weekdayCol.innerHTML = `
      <div>Min</div>
      <div>Sel</div>
      <div>Kam</div>
      <div>Sab</div>
    `;
    container.appendChild(weekdayCol);

    const weekCount = Math.floor(dates.length / 7);
    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agt', 'Sep', 'Okt', 'Nov', 'Des'];
    
    const columnsContainer = document.createElement('div');
    columnsContainer.style.display = 'flex';
    columnsContainer.style.gap = '4px';
    columnsContainer.style.marginTop = '22px';

    let currentMonthStr = '';

    for (let w = 0; w < weekCount; w++) {
      const weekCol = document.createElement('div');
      weekCol.style.display = 'flex';
      weekCol.style.flexDirection = 'column';
      weekCol.style.gap = '4px';
      weekCol.style.position = 'relative';

      const midOfWeekDate = new Date(dates[w * 7 + 3]);
      const monthStr = monthNames[midOfWeekDate.getMonth()];
      
      if (monthStr !== currentMonthStr) {
        const monthHeader = document.createElement('div');
        monthHeader.style.fontSize = '11px';
        monthHeader.style.fontWeight = '600';
        monthHeader.style.color = 'var(--text-muted)';
        monthHeader.style.position = 'absolute';
        monthHeader.style.top = '-20px';
        monthHeader.style.left = '0';
        monthHeader.style.whiteSpace = 'nowrap';
        monthHeader.textContent = monthStr;
        
        weekCol.appendChild(monthHeader);
        currentMonthStr = monthStr;
      }

      for (let d = 0; d < 7; d++) {
        const idx = w * 7 + d;
        const dayData = dailyIncrements[idx];
        const square = document.createElement('div');
        square.className = 'heatmap-square';
        square.style.width = '15px';
        square.style.height = '15px';
        square.style.borderRadius = '3px';
        square.style.cursor = 'pointer';

        let level = 0;
        if (dayData.value > 0) {
          if (dayData.value <= q1) level = 1;
          else if (dayData.value <= q2) level = 2;
          else if (dayData.value <= q3) level = 3;
          else level = 4;
        }
        
        if (level === 0) {
          square.style.background = 'var(--bg-progress-wrap)';
          square.style.border = '1px solid var(--border-light)';
        } else if (level === 1) {
          square.style.background = 'rgba(6, 182, 212, 0.25)';
        } else if (level === 2) {
          square.style.background = 'rgba(6, 182, 212, 0.5)';
        } else if (level === 3) {
          square.style.background = 'rgba(6, 182, 212, 0.75)';
        } else {
          square.style.background = 'rgb(6, 182, 212)';
          square.style.boxShadow = '0 0 6px rgba(6, 182, 212, 0.4)';
        }

        const dateObj = new Date(dayData.date);
        const formattedDate = dateObj.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        
        let tooltipText = '';
        if (metric === 'fasih') {
          tooltipText = `${formattedDate}\n- Penambahan: +${dayData.value.toLocaleString('id-ID')} Dokumen FASIH\n- Total Progress: ${dayData.cumulative.toLocaleString('id-ID')} Dokumen (Submit+Reject+Approve)`;
        } else if (metric === 'survey') {
          tooltipText = `${formattedDate}\n- Penambahan: +${dayData.value.toLocaleString('id-ID')} Survei\n- Total Terdata: ${dayData.cumulative.toLocaleString('id-ID')} (Usaha + Keluarga)`;
        } else {
          tooltipText = `${formattedDate}\n- Penambahan: +${dayData.value.toLocaleString('id-ID')} SLS Selesai\n- Total Selesai: ${dayData.cumulative.toLocaleString('id-ID')} SLS`;
        }
        
        square.title = tooltipText;
        
        square.addEventListener('mouseenter', () => {
          square.style.transform = 'scale(1.25)';
          square.style.zIndex = '10';
          square.style.transition = 'transform 0.1s ease';
        });
        square.addEventListener('mouseleave', () => {
          square.style.transform = 'scale(1)';
          square.style.zIndex = '1';
        });

        weekCol.appendChild(square);
      }
      columnsContainer.appendChild(weekCol);
    }
    container.appendChild(columnsContainer);
  }

  document.addEventListener('DOMContentLoaded', () => {
    <% if (summary) { %>
      const rawTrenData = <%- tren %>;

      // Filter rawTrenData to only keep the latest upload session for each unique date
      const dailyTrenData = [];
      const dateMap = new Map();
      rawTrenData.forEach(item => {
        dateMap.set(item.tanggal, item);
      });
      dateMap.forEach((value) => {
        dailyTrenData.push(value);
      });

      // Automatically render AI Smart Insights (deferred 1.2s to avoid blocking initial paint)
      setTimeout(() => loadAiInsights(false), 1200);

      // Initialize Heatmap
      <% if (settings.overview_heatmap === '1') { %>
      const heatmapSelect = document.getElementById('heatmapMetricSelect');
      if (heatmapSelect) {
        const _doRenderHeatmap = () => renderHeatmap(rawTrenData, heatmapSelect.value);
        // Defer heatmap build ke saat browser idle — hindari DOM thrashing saat initial load
        'requestIdleCallback' in window
          ? requestIdleCallback(_doRenderHeatmap, { timeout: 3000 })
          : setTimeout(_doRenderHeatmap, 800);
        heatmapSelect.addEventListener('change', () => {
          renderHeatmap(rawTrenData, heatmapSelect.value);
        });
      }
      <% } %>
      
      // Speedometer dynamic date navigator controls setup
      const sensorStartDateStr = '<%= settings.speedometer_start_date || "2026-06-15" %>';
      const sensorDeadlineDateStr = '<%= settings.speedometer_target_date || "2026-08-31" %>';
      const speedometerCalcMode = '<%= settings.speedometer_calc_mode %>';
      const targetSpeedPerPclSetting = parseFloat('<%= settings.speedometer_target_speed_per_pcl || "13" %>') || 13;

      function clientFormatIndonesianDate(dateStr) {
        if (!dateStr) return '';
        const date = new Date(dateStr);
        if (isNaN(date.getTime())) return dateStr;
        const months = [
          'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
          'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
        ];
        return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
      }

      function clientFormatIndonesianDateShort(dateStr) {
        if (!dateStr) return '';
        const date = new Date(dateStr);
        if (isNaN(date.getTime())) return dateStr;
        const months = [
          'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun',
          'Jul', 'Agt', 'Sep', 'Okt', 'Nov', 'Des'
        ];
        return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
      }

      window.updateSpeedometersForDate = function(targetDate) {
        const itemIdx = dailyTrenData.findIndex(d => d.tanggal === targetDate);
        if (itemIdx === -1) return;
        
        const current = dailyTrenData[itemIdx];
        
        // Find previous item to compute last update delta
        const prev = itemIdx > 0 ? dailyTrenData[itemIdx - 1] : null;
        
        const totalPengerjaan = (current.submitted_total || 0) + (current.approved_total || 0) + (current.rejected_total || 0);
        const prevPengerjaan = prev ? ((prev.submitted_total || 0) + (prev.approved_total || 0) + (prev.rejected_total || 0)) : 0;
        
        // diffTotal is the delta from the previous upload
        const diffTotal = Math.max(0, totalPengerjaan - prevPengerjaan);
        
        const startSensusDate = new Date(sensorStartDateStr);
        const uploadDate = new Date(current.tanggal);
        const deadline = new Date(sensorDeadlineDateStr);
        
        const diffTime = uploadDate - startSensusDate;
        const diffDays = Math.max(1, Math.round(diffTime / (1000 * 60 * 60 * 24)) + 1);
        
        const totalDays = Math.max(1, Math.ceil((deadline - startSensusDate) / (1000 * 60 * 60 * 24)));
        const daysRemaining = Math.max(0, Math.ceil((deadline - uploadDate) / (1000 * 60 * 60 * 24)));
        
        const target_fasih_total = current.target_fasih_total || 0;
        const remainingFasih = Math.max(0, target_fasih_total - totalPengerjaan);
        const currentSpeed = diffDays > 0 ? (totalPengerjaan / diffDays) : 0;
        
        const estDaysToFinish = currentSpeed > 0 ? (remainingFasih / currentSpeed) : null;
        const isOfftrack = (currentSpeed === 0 && remainingFasih > 0) || (estDaysToFinish !== null && estDaysToFinish > daysRemaining);
        const reqSpeed = daysRemaining > 0 ? (remainingFasih / daysRemaining) : remainingFasih;
        
        const totalPcl = current.total_pcl || 1;
        const speedPerPcl = totalPcl > 0 ? (currentSpeed / totalPcl) : 0;
        const reqSpeedPerPcl = totalPcl > 0 ? (reqSpeed / totalPcl) : 0;
        const latestUpdateSpeedPerPcl = totalPcl > 0 ? (diffTotal / totalPcl) : 0;
        
        let targetSpeedTotal = 0;
        let targetNormalPerPcl = 0;
        if (speedometerCalcMode === 'pcl_speed') {
          targetSpeedTotal = targetSpeedPerPclSetting * totalPcl;
          targetNormalPerPcl = targetSpeedPerPclSetting;
        } else {
          targetSpeedTotal = totalDays > 0 ? (target_fasih_total / totalDays) : 0;
          targetNormalPerPcl = totalPcl > 0 ? (targetSpeedTotal / totalPcl) : 0;
        }
        
        // Re-create Speedometer Gauge (Accumulative & Last Update)
        createSpeedometerChart('speedometerChartCanvas', speedPerPcl, targetNormalPerPcl, currentSpeed, targetSpeedTotal);
        createSpeedometerChart('speedometerLastUpdateCanvas', latestUpdateSpeedPerPcl, targetNormalPerPcl, diffTotal, targetSpeedTotal);
        
        // Update header sub-text fields
        const normalSpeedEl = document.getElementById('speedometerTargetNormalField');
        if (normalSpeedEl) normalSpeedEl.textContent = `${targetNormalPerPcl.toFixed(1)} dok/PCL/hari`;
        const reqSpeedEl = document.getElementById('speedometerReqSpeedField');
        if (reqSpeedEl) reqSpeedEl.textContent = `${reqSpeedPerPcl.toFixed(2)} dok/PCL/hari`;
        
        // Update Status Badge
        const statusField = document.getElementById('speedometerStatusField');
        if (statusField) {
          if (remainingFasih === 0) {
            statusField.innerHTML = '<span class="badge badge-green fs-caption py-1 px-2">Selesai 100%</span>';
          } else if (isOfftrack) {
            statusField.innerHTML = '<span class="badge badge-red fs-caption py-1 px-2"><i class="bi bi-exclamation-triangle-fill"></i> Off-Track</span>';
          } else {
            statusField.innerHTML = '<span class="badge badge-green fs-caption py-1 px-2"><i class="bi bi-check-circle-fill"></i> On-Track</span>';
          }
        }
        
        // Update Kecepatan Ideal Card
        const idealSpeedField = document.getElementById('speedometerIdealSpeedField');
        if (idealSpeedField) {
          idealSpeedField.textContent = `${reqSpeedPerPcl.toFixed(2)} dok/PCL/hari`;
        }
        
        // Update Est. Selesai 100% Card
        const est100Field = document.getElementById('speedometerEst100Field');
        if (est100Field) {
          if (remainingFasih === 0) {
            est100Field.textContent = 'Sudah tercapai';
          } else if (currentSpeed === 0) {
            est100Field.textContent = 'Tidak dapat diprediksi (stagnan)';
          } else {
            const finishDate = new Date(uploadDate);
            finishDate.setDate(finishDate.getDate() + Math.ceil(estDaysToFinish));
            est100Field.textContent = clientFormatIndonesianDateShort(finishDate);
          }
        }
        
        // Update Narrative Speed Analysis Text
        const analysisText = document.getElementById('speedometerAnalysisText');
        if (analysisText) {
          if (remainingFasih === 0) {
            analysisText.innerHTML = `Pendataan secara global telah menyelesaikan seluruh target pengisian dokumen FASIH sebanyak <strong>${target_fasih_total.toLocaleString('id-ID')}</strong> dokumen. Kinerja luar biasa!`;
          } else {
            let inner = `Hari berjalan pendataan: <strong>${diffDays} hari</strong> (sejak ${clientFormatIndonesianDate(sensorStartDateStr)}). Sisa hari menuju deadline (${clientFormatIndonesianDate(sensorDeadlineDateStr)}): <strong>${daysRemaining} hari</strong>.<br>
            Sisa beban kerja: <strong>${remainingFasih.toLocaleString('id-ID')} dokumen</strong>. 
            Dengan kecepatan rata-rata harian (<strong>${speedPerPcl.toFixed(2)} dok/PCL/hari</strong> atau <strong>${currentSpeed.toFixed(2)} dok/hari total</strong>), `;
            
            if (currentSpeed === 0) {
              inner += `pendataan belum merealisasikan dokumen FASIH sama sekali sehingga estimasi hari selesai tidak dapat diprediksi.`;
            } else {
              inner += `pendataan secara global diprediksi akan menyelesaikan sisa dokumen dalam waktu sekitar <strong>${Math.ceil(estDaysToFinish)} hari</strong>.`;
            }
            
            if (isOfftrack) {
              inner += `<div class="alert-danger-subtle mt-2 py-2 px-2-5 text-primary d-flex items-start gap-1-5">
                <i class="bi bi-exclamation-triangle-fill text-red fs-md mt-0-5"></i>
                <div><strong>Off-Track:</strong> Kecepatan saat ini (Laju Akumulatif ${speedPerPcl.toFixed(2)} dok/PCL/hari) di bawah target normal ${targetNormalPerPcl.toFixed(1)} dok/hari/petugas. Diperlukan peningkatan kecepatan kerja minimal menjadi <strong>${reqSpeedPerPcl.toFixed(2)} dok/PCL/hari</strong> (atau <strong>${reqSpeed.toFixed(2)} dok/hari total</strong>) agar selesai sesuai target pada ${clientFormatIndonesianDate(sensorDeadlineDateStr)}.</div>
              </div>`;
            } else {
              inner += `<div class="alert-success-subtle mt-2 py-2 px-2-5 text-primary d-flex items-start gap-1-5">
                <i class="bi bi-check-circle-fill text-green fs-md mt-0-5"></i>
                <div><strong>On-Track:</strong> Kecepatan kerja saat ini sudah memadai untuk menyelesaikan seluruh beban kerja sebelum deadline (estimasi selesai sebelum ${clientFormatIndonesianDate(sensorDeadlineDateStr)}).</div>
              </div>`;
            }
            analysisText.innerHTML = inner;
          }
        }

        // Disable/enable next/prev buttons
        const btnPrev = document.getElementById('btnSpeedometerPrev');
        const btnNext = document.getElementById('btnSpeedometerNext');
        if (btnPrev) {
          const isEarliest = (itemIdx === 0);
          btnPrev.disabled = isEarliest;
          btnPrev.style.opacity = isEarliest ? '0.3' : '1';
          btnPrev.style.cursor = isEarliest ? 'not-allowed' : 'pointer';
        }
        if (btnNext) {
          const isLatest = (itemIdx === dailyTrenData.length - 1);
          btnNext.disabled = isLatest;
          btnNext.style.opacity = isLatest ? '0.3' : '1';
          btnNext.style.cursor = isLatest ? 'not-allowed' : 'pointer';
        }
      };

      window.onSpeedometerDateSelectChange = function(selectedDate) {
        updateSpeedometersForDate(selectedDate);
      };

      window.navigateSpeedometerDate = function(direction) {
        const selector = document.getElementById('speedometerDateSelector');
        if (!selector) return;
        const index = selector.selectedIndex;
        const nextIndex = index - direction; // descending order: prev is index+1, next is index-1
        if (nextIndex >= 0 && nextIndex < selector.options.length) {
          selector.selectedIndex = nextIndex;
          updateSpeedometersForDate(selector.value);
        }
      };

      // Populate selector dropdown
      const speedometerSelector = document.getElementById('speedometerDateSelector');
      if (speedometerSelector) {
        speedometerSelector.innerHTML = '';
        // Sort descending for dropdown
        const sortedDesc = [...dailyTrenData].sort((a, b) => new Date(b.tanggal) - new Date(a.tanggal));
        sortedDesc.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item.tanggal;
          opt.textContent = clientFormatIndonesianDate(item.tanggal);
          speedometerSelector.appendChild(opt);
        });
        
        // Select latest date by default
        if (dailyTrenData.length > 0) {
          const latestDate = dailyTrenData[dailyTrenData.length - 1].tanggal;
          speedometerSelector.value = latestDate;
          updateSpeedometersForDate(latestDate);
        }
      }

      // === Lazy Chart Initializer via IntersectionObserver ===
      // Chart hanya diinisialisasi saat canvas masuk viewport DAN Chart.js sudah siap
      function onChartJsReady(fn) {
        if (typeof Chart !== 'undefined') {
          fn();
        } else {
          const checkChart = setInterval(() => {
            if (typeof Chart !== 'undefined') {
              clearInterval(checkChart);
              fn();
            }
          }, 50);
        }
      }

      function lazyInitChart(canvasId, initFn) {
        const el = document.getElementById(canvasId);
        if (!el) return;
        const obs = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            obs.disconnect();
            onChartJsReady(initFn);
          }
        }, { rootMargin: '120px' });
        obs.observe(el);
      }

      // Initialize Sports Daily Rate Line Chart
      const sportsDailyRates = [];
      const sportsDailyRateLabels = [];
      const totalPclCount = <%= totalPcl %>;
      for (let i = 0; i < dailyTrenData.length; i++) {
        const current = dailyTrenData[i];
        sportsDailyRateLabels.push(current.tanggal);
        const currentTotal = (current.submitted_total || 0) + (current.approved_total || 0) + (current.rejected_total || 0);
        let increment = 0;
        if (i === 0) {
          increment = currentTotal;
        } else {
          const prev = dailyTrenData[i - 1];
          const prevTotal = (prev.submitted_total || 0) + (prev.approved_total || 0) + (prev.rejected_total || 0);
          increment = Math.max(0, currentTotal - prevTotal);
        }
        const dailyRate = totalPclCount > 0 ? (increment / totalPclCount) : 0;
        sportsDailyRates.push(parseFloat(dailyRate.toFixed(2)));
      }
      lazyInitChart('dailyRateLineChartCanvas', () => {
        createSportsDailyRateLineChart('dailyRateLineChartCanvas', sportsDailyRateLabels, sportsDailyRates, <%= parseFloat(settings.speedometer_target_speed_per_pcl || '13') %>);
      });

      // Hitung penambahan harian total FASIH (Submitted + Approved + Rejected)
      const countyIncrementLabels = [];
      const countyIncrements = [];
      for (let i = 0; i < dailyTrenData.length; i++) {
        const current = dailyTrenData[i];
        countyIncrementLabels.push(current.tanggal);
        const currentTotal = (current.submitted_total || 0) + (current.approved_total || 0) + (current.rejected_total || 0);
        if (i === 0) {
          countyIncrements.push(currentTotal);
        } else {
          const prev = dailyTrenData[i - 1];
          const prevTotal = (prev.submitted_total || 0) + (prev.approved_total || 0) + (prev.rejected_total || 0);
          countyIncrements.push(Math.max(0, currentTotal - prevTotal));
        }
      }

      lazyInitChart('dailyCountyIncrementChartCanvas', () =>
        createDailyIncrementBarChart(
          'dailyCountyIncrementChartCanvas',
          countyIncrementLabels,
          countyIncrements,
          <%= targetSpeedTotal %>,
          <%= reqSpeed %>,
          dailyTrenData
        )
      );

      // Initialize tren line chart
      <% if (settings.overview_tren_muatan === '1') { %>
      lazyInitChart('trenChartCanvas', () => createTrenChart('trenChartCanvas', rawTrenData));
      <% } %>

      // Initialize FASIH assignment trend line chart
      <% if (settings.overview_tren_fasih === '1') { %>
      lazyInitChart('trenFasihChartCanvas', () => createFasihTrenChart('trenFasihChartCanvas', rawTrenData));

      // Hitung dan inisialisasi penambahan harian FASIH per status (Daily Increment per Status)
      const dailyIncrementLabels = [];
      const dailyIncrements = {
        draft: [],
        submitted: [],
        approved: [],
        rejected: []
      };

      for (let i = 0; i < dailyTrenData.length; i++) {
        const current = dailyTrenData[i];
        dailyIncrementLabels.push(current.tanggal);
        
        if (i === 0) {
          dailyIncrements.draft.push(current.draft_total || 0);
          dailyIncrements.submitted.push(current.submitted_total || 0);
          dailyIncrements.approved.push(current.approved_total || 0);
          dailyIncrements.rejected.push(current.rejected_total || 0);
        } else {
          const prev = dailyTrenData[i - 1];
          dailyIncrements.draft.push(Math.max(0, (current.draft_total || 0) - (prev.draft_total || 0)));
          dailyIncrements.submitted.push(Math.max(0, (current.submitted_total || 0) - (prev.submitted_total || 0)));
          dailyIncrements.approved.push(Math.max(0, (current.approved_total || 0) - (prev.approved_total || 0)));
          dailyIncrements.rejected.push(Math.max(0, (current.rejected_total || 0) - (prev.rejected_total || 0)));
        }
      }

      lazyInitChart('dailyFasihStatusChartCanvas', () =>
        createDailyFasihStatusChart('dailyFasihStatusChartCanvas', dailyIncrementLabels, dailyIncrements, '', dailyTrenData)
      );


      <% } %>

      // Initialize kecamatan comparison bar chart
      <% if (settings.overview_kecamatan === '1') { %>
      const kecLabels = [];
      const kecSelesai = [];
      const kecTotal = [];
      const kecFasihSelesai = [];
      const kecFasihTotal = [];
      <% kecStats.forEach(k => { %>
        kecLabels.push("<%= k.kecamatan %>");
        kecSelesai.push(<%= k.muatan_selesai %>);
        kecTotal.push(<%= k.total_muatan %>);
        kecFasihSelesai.push(<%= (k.submitted_total || 0) + (k.approved_total || 0) + (k.rejected_total || 0) %>);
        kecFasihTotal.push(<%= k.target_fasih_total || 0 %>);
      <% }) %>

      lazyInitChart('kecBarChartCanvas', () =>
        createBarChart('kecBarChartCanvas', kecLabels, kecSelesai, kecTotal, 'Progres Per Kecamatan (Muatan)')
      );
      lazyInitChart('kecFasihBarChartCanvas', () =>
        createKecFasihBarChart('kecFasihBarChartCanvas', kecLabels, kecFasihSelesai, kecFasihTotal, 'Progres Per Kecamatan (FASIH)')
      );
      // Initialize table sorting and searching
      makeTableSortable('kecOverviewTable');
      makeTableSearchable('kecOverviewSearch', 'kecOverviewTable');
      <% } %>

      // Modal Sebaran Petugas Detail Controller
      let allPclDeltas = <%- typeof pclDeltas !== 'undefined' ? pclDeltas : '[]' %>;
      let activePclBucket = [];

      // State for Sebaran Petugas Lintas Hari
      let distAvailableDates = []; // List of { id, tanggal }
      let distCurrentDateIdx = 0;

      // Client-side date formatter helper
      function formatIndonesianDateStr(dateStr) {
        if (!dateStr) return '';
        const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        const parts = dateStr.split('-');
        if (parts.length === 3) {
          const day = parseInt(parts[2], 10);
          const month = parseInt(parts[1], 10) - 1;
          const year = parseInt(parts[0], 10);
          return `${day} ${months[month]} ${year}`;
        }
        return dateStr;
      }

      function renderDistDateDropdown() {
        const selector = document.getElementById('distDateSelector');
        if (!selector) return;
        
        selector.innerHTML = '';
        
        // Show options from newest to oldest
        const displayDates = [...distAvailableDates].reverse();
        
        displayDates.forEach(d => {
          const option = document.createElement('option');
          option.value = d.tanggal;
          option.textContent = formatIndonesianDateStr(d.tanggal);
          selector.appendChild(option);
        });

        // Set the value to current date
        const currentObj = distAvailableDates[distCurrentDateIdx];
        if (currentObj) {
          selector.value = currentObj.tanggal;
        }
      }

      function updateNavigationButtons() {
        const btnPrev = document.getElementById('btnDistPrev');
        const btnNext = document.getElementById('btnDistNext');
        
        if (btnPrev) {
          btnPrev.disabled = (distCurrentDateIdx <= 0);
        }
        if (btnNext) {
          btnNext.disabled = (distCurrentDateIdx >= distAvailableDates.length - 1);
        }
      }

      async function fetchDistData(dateStr) {
        const container = document.getElementById('distTableContainer');
        if (container) container.style.opacity = '0.5';
        
        try {
          const basePath = window.location.pathname.split('/admin/')[0] || '';
          const cleanBasePath = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
          const res = await fetch(`${cleanBasePath}/api/pcl-distribution?date=${dateStr}`);
          const data = await res.json();
          if (data.success) {
            const formattedDate = formatIndonesianDateStr(data.selectedUpload.tanggal);
            const distDateLabel = document.getElementById('distDateLabel');
            const distDateSub = document.getElementById('distDateSub');
            
            const isLatest = (distCurrentDateIdx === distAvailableDates.length - 1);
            if (distDateLabel) {
              distDateLabel.textContent = isLatest ? 'Update Ini' : 'Arsip Harian';
            }
            if (distDateSub) {
              distDateSub.textContent = formattedDate;
            }

            allPclDeltas = data.pclDeltas || [];
            
            // Re-render table body
            const bucket_0 = data.dist.bucket_0 || 0;
            const bucket_1_4 = data.dist.bucket_1_4 || 0;
            const bucket_5_7 = data.dist.bucket_5_7 || 0;
            const bucket_8_12 = data.dist.bucket_8_12 || 0;
            const bucket_13_plus = data.dist.bucket_13_plus || 0;

            const total = bucket_0 + bucket_1_4 + bucket_5_7 + bucket_8_12 + bucket_13_plus || 1;
            
            const rowsConfig = [
              { id: 'bucket_0', label: '0 Dokumen (Stagnan)', count: bucket_0, color: 'var(--accent-red)' },
              { id: 'bucket_1_4', label: '1 - 4 Dokumen (Rendah)', count: bucket_1_4, color: '#f59e0b' },
              { id: 'bucket_5_7', label: '5 - 7 Dokumen (Sedang)', count: bucket_5_7, color: 'var(--accent-cyan)' },
              { id: 'bucket_8_12', label: '8 - 12 Dokumen (Tinggi)', count: bucket_8_12, color: 'var(--accent-purple)' },
              { id: 'bucket_13_plus', label: '>= 13 Dokumen (Target)', count: bucket_13_plus, color: 'var(--accent-green)' }
            ];

            const tbody = document.getElementById('distTableBody');
            if (tbody) {
              tbody.innerHTML = '';
              rowsConfig.forEach(row => {
                const pct = ((row.count / total) * 100).toFixed(1);
                const tr = document.createElement('tr');
                tr.className = 'hover-row';
                tr.style.borderBottom = '1px solid var(--border)';
                tr.style.transition = 'var(--transition)';
                tr.style.cursor = 'pointer';
                tr.title = 'Klik untuk lihat daftar petugas kelompok ini';
                tr.onclick = () => showPclDistributionModal(row.id, row.label, row.color);
                
                tr.innerHTML = `
                  <td style="padding: 12px; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: ${row.color};"></span>
                    ${row.label}
                  </td>
                  <td style="padding: 12px; text-align: center; font-weight: 700; color: var(--text-primary); font-size: 13px;">
                    ${row.count.toLocaleString('id-ID')}
                  </td>
                  <td style="padding: 12px; text-align: center; font-weight: 700; color: ${row.color};">
                    ${pct}%
                  </td>
                  <td style="padding: 12px;">
                    <div style="background: rgba(255, 255, 255, 0.03); height: 8px; border-radius: 4px; overflow: hidden; width: 100%; border: 1px solid var(--border);">
                      <div style="background: ${row.color}; width: ${pct}%; height: 100%; border-radius: 4px;"></div>
                    </div>
                  </td>
                `;
                tbody.appendChild(tr);
              });
            }

            const tfootTotalCount = document.getElementById('distTotalCount');
            if (tfootTotalCount) {
              tfootTotalCount.textContent = total.toLocaleString('id-ID');
            }

            updateNavigationButtons();
          }
        } catch (err) {
          console.error('Error fetching PCL distribution data:', err);
        } finally {
          if (container) container.style.opacity = '1';
        }
      }

      window.navigateDistDate = function(direction) {
        const newIdx = distCurrentDateIdx + direction;
        if (newIdx >= 0 && newIdx < distAvailableDates.length) {
          distCurrentDateIdx = newIdx;
          const selectedDateObj = distAvailableDates[distCurrentDateIdx];
          const selector = document.getElementById('distDateSelector');
          if (selector) selector.value = selectedDateObj.tanggal;
          fetchDistData(selectedDateObj.tanggal);
        }
      }

      window.onDistDateSelectChange = function(dateVal) {
        const idx = distAvailableDates.findIndex(d => d.tanggal === dateVal);
        if (idx !== -1) {
          distCurrentDateIdx = idx;
          fetchDistData(dateVal);
        }
      }

      async function initDistDateSelector() {
        try {
          const res = await fetch(`${window.location.origin}/api/pcl-distribution`);
          const data = await res.json();
          if (data.success) {
            distAvailableDates = data.availableDates || [];
            // Sort chronologically ASC: oldest first, newest last
            distAvailableDates.sort((a, b) => new Date(a.tanggal) - new Date(b.tanggal));
            
            const currentUploadDate = data.selectedUpload.tanggal;
            distCurrentDateIdx = distAvailableDates.findIndex(d => d.tanggal === currentUploadDate);
            if (distCurrentDateIdx === -1) {
              distCurrentDateIdx = distAvailableDates.length - 1;
            }

            renderDistDateDropdown();
            updateNavigationButtons();
          }
        } catch (err) {
          console.error('Error initializing date selector:', err);
        }
      }

      // Trigger initialization (deferred 600ms agar tidak berkompetisi dengan render awal)
      setTimeout(() => initDistDateSelector(), 600);

      window.showPclDistributionModal = function(bucketId, label, color) {
        const modal = document.getElementById('pclDistModal');
        if (!modal) return;

        // Filter the PCLs into the active bucket
        activePclBucket = allPclDeltas.filter(item => {
          const diff = item.diff || 0;
          if (bucketId === 'bucket_0') return diff <= 0;
          if (bucketId === 'bucket_1_4') return diff >= 1 && diff <= 4;
          if (bucketId === 'bucket_5_7') return diff >= 5 && diff <= 7;
          if (bucketId === 'bucket_8_12') return diff >= 8 && diff <= 12;
          if (bucketId === 'bucket_13_plus') return diff >= 13;
          return false;
        });

        // Set titles and styles
        document.getElementById('modalCategoryTitle').textContent = `Daftar Petugas: ${label}`;
        document.getElementById('modalCategoryColor').style.background = color;
        document.getElementById('modalSearchInput').value = '';

        // Display modal
        modal.style.display = 'flex';
        
        // Render PCL list
        window.renderPclList(activePclBucket);
      }

      window.closePclDistributionModal = function() {
        const modal = document.getElementById('pclDistModal');
        if (modal) modal.style.display = 'none';
      }

      // Close modal when clicking outside the content box
      window.addEventListener('click', (e) => {
        const modal = document.getElementById('pclDistModal');
        if (e.target === modal) {
          window.closePclDistributionModal();
        }
      });

      window.renderPclList = function(list) {
        const tbody = document.getElementById('modalPclTableBody');
        const countSpan = document.getElementById('modalPclCount');
        if (!tbody || !countSpan) return;

        tbody.innerHTML = '';
        countSpan.textContent = `${list.length} Orang`;

        if (list.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="2" style="padding: 24px; text-align: center; color: var(--text-muted); font-style: italic;">
                Tidak ada petugas di kelompok ini
              </td>
            </tr>
          `;
          return;
        }

        list.forEach(item => {
          const tr = document.createElement('tr');
          tr.style.borderBottom = '1px solid var(--border)';
          tr.style.transition = 'var(--transition)';
          tr.className = 'hover-row';

          const diffVal = item.diff || 0;
          let diffStr = `+${diffVal.toLocaleString('id-ID')}`;
          let color = 'var(--accent-green)';
          if (diffVal === 0) {
            diffStr = 'Stagnan (0)';
            color = 'var(--text-muted)';
          } else if (diffVal < 0) {
            diffStr = `${diffVal.toLocaleString('id-ID')}`;
            color = 'var(--accent-red)';
          }

          tr.innerHTML = `
            <td style="padding: 10px 20px; font-weight: 600; color: var(--text-primary); text-align: left;">${item.pcl}</td>
            <td style="padding: 10px 20px; text-align: right; font-weight: 700; color: ${color};">${diffStr}</td>
          `;
          tbody.appendChild(tr);
        });
      }

      window.filterPclList = function() {
        const query = document.getElementById('modalSearchInput').value.toLowerCase().trim();
        const filtered = activePclBucket.filter(item => item.pcl.toLowerCase().includes(query));
        window.renderPclList(filtered);
      }
    <% } %>
  });
</script>
