<%
  let activeTargetPct = 25;
  let targetMonthName = '30 Juni';
  const currentDate = typeof latestUpload !== 'undefined' && latestUpload ? new Date(latestUpload.tanggal) : new Date();
  if (currentDate >= new Date('2026-07-01')) {
    activeTargetPct = 40;
    targetMonthName = '15 Juli';
  }
%>
<div class="fade-in">
  <% if (!summary) { %>
    <!-- EMPTY STATE -->
    <div class="card empty-state text-center" style="padding: 80px 20px;">
      <img src="/logo-mark.png" alt="Emblem SE2026" class="logo-light" loading="eager" style="width: 80px; height: 80px; margin-bottom: 20px; opacity: 0.85; object-fit: contain;">
      <img src="/logo-mark-dark.png" alt="Emblem SE2026" class="logo-dark" fetchpriority="high" loading="eager" style="width: 80px; height: 80px; margin-bottom: 20px; opacity: 0.85; object-fit: contain;">
      <h2 class="empty-state-title" style="font-size: 22px; margin-bottom: 12px;">Selamat Datang di Dashboard SE2026 PPU</h2>
      <p class="empty-state-text" style="font-size: 14px; max-width: 540px; margin: 0 auto 24px; color: var(--text-secondary);">
        Dashboard monitoring progres Sensus Ekonomi 2026 Kabupaten Penajam Paser Utara belum terisi data. Silakan upload file Excel rekapitulasi harian pertama Anda untuk memulai visualisasi monitoring.
      </p>
      <a href="/admin/upload" class="btn btn-primary"><i class="bi bi-lightning-charge-fill"></i> Upload Data Rekap Pertama</a>
    </div>
  <% } else { %>
    <!-- BANNER PEMBERITAHUAN UPDATE (DISMISSIBLE) -->
    <div id="updateNotificationBanner" style="display: none; background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(124, 58, 237, 0.08) 100%); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 16px 20px; margin-top: 12px; margin-bottom: 12px; position: relative; backdrop-filter: blur(8px);">
      <button onclick="dismissUpdateBanner()" style="position: absolute; top: 12px; right: 16px; background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 18px; padding: 4px; display: flex; align-items: center; justify-content: center; transition: var(--transition);" title="Tutup">
        <i class="bi bi-x-lg"></i>
      </button>
      <div style="display: flex; gap: 14px; align-items: flex-start; padding-right: 24px;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-purple) 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 20px; flex-shrink: 0; box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);">
          <i class="bi bi-patch-check-fill"></i>
        </div>
        <div style="min-width: 0; flex: 1;">
          <h4 style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
            <span>Pembaruan Dashboard Sistem (v2.1)</span>
            <span style="font-size: 9px; font-weight: 700; background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%); color: white; padding: 2px 6px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.5px;">Baru</span>
          </h4>
          <div style="font-size: 11px; color: var(--text-secondary); line-height: 1.6;">
            Kami telah menambahkan beberapa fitur baru untuk mempermudah monitoring sensus Anda:
            <ul style="margin: 6px 0 0 0; padding-left: 18px; list-style-type: disc; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 4px 16px;">
              <li><strong>Target FASIH-SM</strong>: Model target baru dari kolom total pivot Excel.</li>
              <li><strong>Filter Kolom ala Excel</strong>: Live search &amp; filter langsung pada header tabel.</li>
              <li><strong>Grafik Tren Harian PML</strong>: Visualisasi historis progres tim pada detail PML.</li>
              <li><strong>Optimasi Mobile Viewport</strong>: Layout menu bottom-sheet &amp; transisi responsif.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <script>
      (function() {
        const dismissed = localStorage.getItem('dismissed_update_v2.1');
        if (!dismissed) {
          document.getElementById('updateNotificationBanner').style.display = 'block';
        }
      })();
      function dismissUpdateBanner() {
        localStorage.setItem('dismissed_update_v2.1', 'true');
        document.getElementById('updateNotificationBanner').style.opacity = '0';
        document.getElementById('updateNotificationBanner').style.transform = 'translateY(-10px)';
        document.getElementById('updateNotificationBanner').style.transition = 'all 0.3s ease';
        setTimeout(() => {
          document.getElementById('updateNotificationBanner').style.display = 'none';
        }, 300);
      }
    </script>

    <!-- HEADER GRID: WEATHER WIDGET -->
    <div class="overview-top-grid" style="margin-top: 12px; margin-bottom: 4px; align-items: start;">
 
      <!-- WEATHER & TIME WIDGET -->
      <div class="card weather-overview-card" style="margin: 0; background: linear-gradient(135deg, var(--bg-card) 0%, rgba(6, 182, 212, 0.02) 100%); border: 1px solid var(--border); padding: 12px 16px; display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; width: 100%;">
          <div class="weather-info-group" style="display: flex; align-items: center; gap: 12px;">
            <div id="overviewWeatherIcon" class="weather-icon-circle" style="font-size: 28px; width: 44px; height: 44px; border-radius: 50%; background: rgba(6, 182, 212, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i class="bi bi-cloud-sun-fill" style="color: var(--accent-yellow);"></i>
            </div>
            <div>
              <div class="weather-location-text" style="font-weight: 700; font-size: 13px; color: var(--text-primary); display: flex; align-items: center; gap: 6px;">
