            <div onclick="toggleAiInsightsCollapse(event)" class="ai-header-icon-box" style="cursor: pointer; width: 42px; height: 42px; border-radius: 10px; background: rgba(6, 182, 212, 0.15); display: flex; align-items: center; justify-content: center; color: var(--accent-cyan); font-size: 22px; flex-shrink: 0; box-shadow: 0 0 12px rgba(6, 182, 212, 0.2);" title="Klik untuk melihat/menyembunyikan Insight AI">
