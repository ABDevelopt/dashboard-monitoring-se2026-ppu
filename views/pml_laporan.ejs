<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Laporan Progres Pendataan Petugas PCL - Monitoring SE2026 PPU</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- CSS Styles -->
  <style>
    /* Theme Variables matching Dashboard design system */
    :root {
      --bg-body: #0d1117;
      --bg-card: #161b22;
      --border: #30363d;
      --text-primary: #c9d1d9;
      --text-secondary: #8b949e;
      --text-muted: #484f58;
      --accent-cyan: #58a6ff;
      --accent-blue: #1f6feb;
      --accent-green: #3fb950;
      --accent-purple: #bc8cff;
      --radius: 8px;
      --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    body {
      background-color: var(--bg-body);
      color: var(--text-primary);
      font-family: var(--font-family);
      margin: 0;
      padding: 0;
    }

    /* Control Panel Styles (Screen Only) */
    .control-panel {
      background-color: var(--bg-card);
      border-bottom: 1px solid var(--border);
      padding: 16px 24px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .control-panel-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 12px;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .form-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: flex-end;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 12px;
      color: var(--text-secondary);
      font-weight: 500;
    }

    .form-control {
      background-color: var(--bg-body);
      border: 1px solid var(--border);
      color: var(--text-primary);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 14px;
      outline: none;
      min-width: 180px;
    }

    .form-control:focus {
      border-color: var(--accent-cyan);
    }

    .dates-container {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      border: 1px solid var(--border);
      padding: 8px 12px;
      border-radius: 6px;
      background-color: var(--bg-body);
      max-height: 120px;
      overflow-y: auto;
    }

    .date-checkbox-label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--text-primary);
      cursor: pointer;
    }

    .date-checkbox-label input {
      cursor: pointer;
    }

    .btn {
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      transition: opacity 0.15s;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .btn-primary {
      background-color: var(--accent-blue);
      color: #fff;
    }

    .btn-success {
      background-color: var(--accent-green);
      color: #fff;
    }

    .btn-secondary {
      background-color: #30363d;
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    /* Print Area Styles */
    .print-container {
      max-width: 1000px;
      margin: 24px auto;
      padding: 0 24px;
    }

    .report-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .report-title {
      font-size: 20px;
      font-weight: 700;
      margin: 0 0 6px 0;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .report-subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      margin: 0;
    }

    .pml-section {
      margin-bottom: 32px;
    }

    .pml-header {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #fff;
      background-color: #21262d;
      padding: 8px 12px;
      border-radius: 4px;
      border-left: 4px solid var(--accent-purple);
      display: flex;
      justify-content: space-between;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 16px;
      font-size: 12px;
    }

    th, td {
      border: 1px solid var(--border);
      padding: 6px 10px;
      text-align: left;
      vertical-align: middle;
    }

    th {
      background-color: #1f242c;
      color: #fff;
      font-weight: 600;
      text-align: center;
    }

    .col-no {
      width: 30px;
      text-align: center;
    }

    .col-pcl {
      font-weight: 600;
      color: var(--accent-cyan);
    }

    .col-pml {
      color: var(--text-secondary);
    }

    .col-pct {
      text-align: right;
      width: 85px;
      font-weight: 500;
    }

    .empty-state {
      text-align: center;
      padding: 48px;
      color: var(--text-secondary);
      border: 1px dashed var(--border);
      border-radius: var(--radius);
    }

    /* Print styling rules */
    @media print {
      .no-print {
        display: none !important;
      }

      body {
        background-color: #fff !important;
        color: #000 !important;
      }

      .print-container {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .report-title {
        color: #000 !important;
        font-size: 18px !important;
      }

      .report-subtitle {
        color: #555 !important;
      }

      .pml-header {
        color: #000 !important;
        background-color: #f0f0f0 !important;
        border-left: 4px solid #000 !important;
        border-bottom: 1px solid #ccc !important;
      }

      table {
        page-break-inside: avoid;
      }

      th, td {
        border: 1px solid #000 !important;
        color: #000 !important;
      }

      th {
        background-color: #eaeaea !important;
      }

      .col-pcl {
        color: #000 !important;
      }

      .pml-section {
        page-break-inside: avoid;
      }
    }
  </style>
  
  <!-- Icon collection link -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

  <!-- Control Panel Form (No Print) -->
  <div class="control-panel no-print">
    <div class="control-panel-title">
      <i class="bi bi-file-earmark-pdf"></i> Pembuat Laporan Kinerja PML
    </div>
    <form action="/pml/laporan" method="GET" id="filterForm">
      <div class="form-row">
        
        <!-- PML Filter -->
        <div class="form-group">
          <label for="pmlSelect">Pilih PML (Pengawas):</label>
          <select name="pml" id="pmlSelect" class="form-control" onchange="this.form.submit()">
            <option value="">-- Semua PML --</option>
            <% pmlList.forEach(pml => { %>
              <option value="<%= pml %>" <%= filterPml === pml ? 'selected' : '' %>><%= pml %></option>
            <% }) %>
          </select>
        </div>

        <!-- Dates Multi-select Checkboxes -->
        <div class="form-group" style="flex: 1; min-width: 300px;">
          <label>Pilih Tanggal Laporan (Maksimal 6):</label>
          <div class="dates-container">
            <% allUploads.forEach(u => { %>
              <% const isChecked = selectedUploadIds.includes(u.id); %>
              <label class="date-checkbox-label">
                <input type="checkbox" name="uploadIds" value="<%= u.id %>" <%= isChecked ? 'checked' : '' %> onchange="onDateChange(this)">
                <%= formatDate(u.tanggal) %>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; gap: 8px;">
          <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i> Perbarui</button>
          <button type="button" class="btn btn-success" onclick="window.print()"><i class="bi bi-printer"></i> Cetak / Simpan PDF</button>
          <button type="button" class="btn btn-secondary" onclick="downloadExcel()"><i class="bi bi-file-earmark-excel"></i> Unduh Excel</button>
          <a href="/pml" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
        </div>

      </div>
    </form>
  </div>

  <!-- Print/Report Container -->
  <div class="print-container">
    
    <!-- Report Title Header -->
    <div class="report-header">
      <h1 class="report-title">Progres Pendataan Petugas PCL</h1>
      <% if (uploads && uploads.length > 0) { %>
        <% const latestDateStr = formatDate(uploads[uploads.length - 1].tanggal); %>
        <p class="report-subtitle">Membandingkan progres s/d tanggal <%= latestDateStr %></p>
      <% } else { %>
        <p class="report-subtitle">Belum ada data progres pendataan</p>
      <% } %>
    </div>

    <!-- Grouped Table Content -->
    <% const pmlKeys = Object.keys(groupedData); %>
    <% if (pmlKeys.length > 0) { %>
      
      <% pmlKeys.forEach(pml => { %>
        <div class="pml-section">
          
          <div class="pml-header">
            <span>PML: <%= pml %></span>
            <span style="font-size: 12px; font-weight: normal;" class="no-print">Tim PML: <%= groupedData[pml].length %> Petugas PCL</span>
          </div>

          <table>
            <thead>
              <tr>
                <th class="col-no" rowspan="2">No</th>
                <th rowspan="2">Nama Petugas PCL</th>
                <th rowspan="2" class="col-pml no-print">PML</th>
                <th rowspan="2">Wilayah Kerja Desa</th>
                <th colspan="<%= uploads.length %>" style="text-align: center;">Progres Harian (%)</th>
              </tr>
              <tr>
                <% uploads.forEach(u => { %>
                  <th style="width: 85px;"><%= formatDateShort(u.tanggal) %></th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
              <% groupedData[pml].forEach((row, idx) => { %>
                <tr>
                  <td class="col-no"><%= idx + 1 %></td>
                  <td class="col-pcl"><%= row.pcl %></td>
                  <td class="col-pml no-print"><%= row.pml %></td>
                  <td><%= row.wilayah || '-' %></td>
                  <% row.progress.forEach(prog => { %>
                    <td class="col-pct"><%= prog.pct %>%</td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>

        </div>
      <% }) %>

    <% } else { %>
      <div class="empty-state">
        <i class="bi bi-file-earmark-x" style="font-size: 40px; display: block; margin-bottom: 12px;"></i>
        Tidak ada data progres untuk PML dan tanggal yang dipilih.
      </div>
    <% } %>

  </div>

  <script>
    // Max 6 dates selector validation logic
    function onDateChange(checkbox) {
      const checkedBoxes = document.querySelectorAll('input[name="uploadIds"]:checked');
      if (checkedBoxes.length > 6) {
        alert('Anda hanya dapat memilih maksimal 6 tanggal untuk perbandingan progres harian.');
        checkbox.checked = false;
      }
    }

    // Build URL query string to trigger excel download
    function downloadExcel() {
      const pml = document.getElementById('pmlSelect').value;
      const checkedBoxes = document.querySelectorAll('input[name="uploadIds"]:checked');
      const uploadIds = Array.from(checkedBoxes).map(cb => cb.value).join(',');
      
      let url = `/pml/laporan/excel?pml=${encodeURIComponent(pml)}`;
      if (uploadIds) {
        url += `&uploadIds=${uploadIds}`;
      }
      
      window.location.href = url;
    }
  </script>
</body>
</html>
