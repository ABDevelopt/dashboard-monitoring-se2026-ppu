<%- contentFor('body') %>

<div class="page-header d-flex justify-between items-center flex-wrap gap-4 mb-6">
  <div>
    <h1 class="m-0 fs-xl fw-extrabold text-primary d-flex items-center gap-2-5">
      <i class="bi bi-envelope-at-fill text-blue"></i> Pengaturan Data Email Petugas
    </h1>
    <p class="m-0 mt-1 fs-sm text-muted">
      Kelola daftar akun email, Sobat ID, dan identitas petugas pencacah (PCL/PML/Korlap) SE2026.
    </p>
  </div>
  <div class="d-flex items-center gap-2-5 flex-wrap">
    <button onclick="openUploadRekapModal()" class="btn btn-secondary py-2 px-3-5 fs-13 fw-semibold rounded-10 d-flex items-center gap-1-5" title="Upload File rekap_petugas_wilayah_*.csv">
      <i class="bi bi-file-earmark-arrow-up-fill text-blue"></i> Upload Rekap Wilayah
    </button>
    <button onclick="openCreateModal()" class="btn btn-primary py-2 px-3-5 fs-13 fw-semibold rounded-10 d-flex items-center gap-1-5">
      <i class="bi bi-person-plus-fill"></i> Tambah Petugas
    </button>
    <form action="/admin/petugas-email/resync" method="POST" class="m-0">
      <button type="submit" class="btn btn-secondary py-2 px-3-5 fs-13 fw-semibold rounded-10 d-flex items-center gap-1-5" title="Cocokkan Ulang Email ke Master SubSLS">
        <i class="bi bi-arrow-repeat"></i> Sync Master
      </button>
    </form>
    <a href="/admin/petugas-email/export" class="btn btn-secondary py-2 px-3-5 fs-13 fw-semibold rounded-10 d-flex items-center gap-1-5">
      <i class="bi bi-download"></i> Unduh CSV
    </a>
  </div>
</div>

<!-- STATS SUMMARY CARDS -->
<div class="d-grid grid-fit-220 gap-4 mb-6">
  <div class="card p-4 rounded-14 d-flex items-center gap-4 bg-card border-default">
    <div class="w-11 h-11 rounded-md d-flex items-center justify-center text-blue flex-shrink-0 fs-xl" style="background: rgba(249, 115, 22, 0.12);">
      <i class="bi bi-people-fill"></i>
    </div>
    <div>
      <div class="fs-caption fw-semibold text-muted text-uppercase tracking-wide">Total Terdaftar</div>
      <div class="fs-xl fw-extrabold text-primary mt-0-5"><%= totalCount.toLocaleString('id-ID') %> <span class="fs-sm fw-medium text-muted">Akun</span></div>
    </div>
  </div>

  <div class="card p-4 rounded-14 d-flex items-center gap-4 bg-card border-default">
    <div class="w-11 h-11 rounded-md d-flex items-center justify-center text-cyan flex-shrink-0 fs-xl" style="background: rgba(6, 182, 212, 0.12);">
      <i class="bi bi-funnel-fill"></i>
    </div>
    <div>
      <div class="fs-caption fw-semibold text-muted text-uppercase tracking-wide">Hasil Filter / Cari</div>
      <div class="fs-xl fw-extrabold text-primary mt-0-5"><%= petugasList.length.toLocaleString('id-ID') %> <span class="fs-sm fw-medium text-muted">Data</span></div>
    </div>
  </div>
</div>

<!-- SEARCH BAR & DATA TABLE -->
<div class="card p-5 rounded-lg bg-card border-default">
  
  <form action="/admin/petugas-email" method="GET" class="mb-4-5 d-flex gap-2-5 flex-wrap">
    <div class="relative flex-1" style="min-width: 260px;">
      <i class="bi bi-search absolute left-3 top-1-2 translate-y-center text-muted fs-md"></i>
      <input type="text" name="q" value="<%= query %>" placeholder="Cari nama lengkap, email, atau Sobat ID..." class="w-full py-2 px-3.5 border-default rounded-10 bg-body text-primary fs-13 outline-none" style="padding-left: 38px;">
    </div>
    <button type="submit" class="btn btn-secondary py-2 px-4 fs-13 fw-semibold rounded-10">
      Cari
    </button>
    <% if (query) { %>
      <a href="/admin/petugas-email" class="btn btn-secondary py-2 px-3-5 fs-13 rounded-10 text-red">
        Reset Filter
      </a>
    <% } %>
  </form>

  <div style="overflow-x: auto;">
    <table class="table w-full table-separate border-spacing-0 fs-13">
      <thead>
        <tr class="bg-secondary text-left">
          <th class="py-3 px-3-5 border-b-default rounded-tl-10 text-center" style="width: 50px;">#</th>
          <th class="py-3 px-3-5 border-b-default">Sobat ID</th>
          <th class="py-3 px-3-5 border-b-default">Nama Lengkap</th>
          <th class="py-3 px-3-5 border-b-default">Alamat Email</th>
          <th class="py-3 px-3-5 border-b-default text-center">JK</th>
          <th class="py-3 px-3-5 border-b-default rounded-tr-10 text-center">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (petugasList.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center p-6 text-muted">
              <i class="bi bi-inbox fs-2xl d-block mb-2"></i>
              Tidak ada data petugas yang cocok.
            </td>
          </tr>
        <% } else { %>
          <% petugasList.forEach((p, idx) => { %>
            <tr class="border-b-default">
              <td class="text-center py-2-5 px-3-5 text-muted fs-sm"><%= idx + 1 %></td>
              <td class="py-2-5 px-3-5 fw-bold text-primary" style="font-family: monospace;">
                <%= p.sobat_id || '-' %>
              </td>
              <td class="py-2-5 px-3-5 fw-bold text-primary">
                <i class="bi bi-person-circle text-blue mr-1-5"></i><%= p.nama_lengkap %>
              </td>
              <td class="py-2-5 px-3-5">
                <a href="mailto:<%= p.email %>" class="text-blue" style="text-decoration: none;" title="Kirim Email">
                  <i class="bi bi-envelope mr-1"></i><%= p.email %>
                </a>
              </td>
              <td class="text-center py-2-5 px-3-5">
                <% if (p.jenis_kelamin === 'Lk') { %>
                  <span class="badge fs-caption" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.25);">Lk</span>
                <% } else if (p.jenis_kelamin === 'Pr') { %>
                  <span class="badge fs-caption" style="background: rgba(236, 72, 153, 0.12); color: #ec4899; border: 1px solid rgba(236, 72, 153, 0.25);">Pr</span>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td class="text-center py-2-5 px-3-5">
                <div class="d-flex items-center justify-center gap-1-5">
                  <button onclick="openEditModal(<%= JSON.stringify(p) %>)" class="btn btn-secondary btn-xs py-1 px-2 fs-caption rounded-xs" title="Edit Data">
                    <i class="bi bi-pencil"></i> Edit
                  </button>
                  <button onclick="openDeleteModal(<%= p.id %>, '<%= p.nama_lengkap.replace(/'/g, "\\'") %>')" class="btn btn-secondary btn-xs py-1 px-2 fs-caption rounded-xs text-red" title="Hapus Data">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- MODAL TAMBAH PETUGAS -->
<div id="modalCreate" class="fixed inset-0 backdrop-blur d-flex items-center justify-center p-4" style="display: none; background: rgba(0,0,0,0.6); z-index: 9999;">
  <div class="bg-card border-default rounded-18 w-full p-6" style="max-width: 480px; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
    <div class="d-flex justify-between items-center mb-4-5">
      <h3 class="m-0 fs-lg fw-bold text-primary">
        <i class="bi bi-person-plus-fill text-blue mr-1-5"></i> Tambah Email Petugas Baru
      </h3>
      <button onclick="closeCreateModal()" class="bg-none border-0 text-muted fs-title-md cursor-pointer">&times;</button>
    </div>
    
    <form action="/admin/petugas-email/create" method="POST">
      <div class="mb-3-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1 text-uppercase">Nama Lengkap *</label>
        <input type="text" name="nama_lengkap" required placeholder="Contoh: Aco Fitriadi" class="w-full py-2-5 px-3 rounded-10 border-default bg-body text-primary fs-13 outline-none">
      </div>

      <div class="mb-3-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1 text-uppercase">Alamat Email *</label>
        <input type="email" name="email" required placeholder="contoh@gmail.com" class="w-full py-2-5 px-3 rounded-10 border-default bg-body text-primary fs-13 outline-none">
      </div>

      <div class="mb-3-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1 text-uppercase">Sobat ID (Opsional)</label>
        <input type="text" name="sobat_id" placeholder="6409xxxxxxxx" class="w-full py-2-5 px-3 rounded-10 border-default bg-body text-primary fs-13 outline-none">
      </div>

      <div class="mb-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1 text-uppercase">Jenis Kelamin</label>
        <select name="jenis_kelamin" class="w-full py-2-5 px-3 rounded-10 border-default bg-body text-primary fs-13 outline-none">
          <option value="Pr">Perempuan (Pr)</option>
          <option value="Lk">Laki-laki (Lk)</option>
        </select>
      </div>

      <div class="d-flex justify-end gap-2-5">
        <button type="button" onclick="closeCreateModal()" class="btn btn-secondary py-2 px-4 fs-13 rounded-sm">Batal</button>
        <button type="submit" class="btn btn-primary py-2 px-4-5 fs-13 fw-semibold rounded-sm">Simpan Data</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL EDIT PETUGAS -->
<div id="modalEdit" class="fixed inset-0 backdrop-blur d-flex items-center justify-center p-4" style="display: none; background: rgba(0,0,0,0.6); z-index: 9999;">
  <div class="bg-card border-default rounded-18 w-full p-6" style="max-width: 480px; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
    <div class="d-flex justify-between items-center mb-4-5">
      <h3 class="m-0 fs-lg fw-bold text-primary">
        <i class="bi bi-pencil-square text-blue mr-1-5"></i> Edit Data Email Petugas
      </h3>
      <button onclick="closeEditModal()" class="bg-none border-0 text-muted fs-title-md cursor-pointer">&times;</button>
    </div>
    
    <form id="editForm" method="POST">
      <div class="mb-3-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1 text-uppercase">Nama Lengkap *</label>
        <input type="text" id="editNama" name="nama_lengkap" required class="w-full py-2-5 px-3 rounded-10 border-default bg-body text-primary fs-13 outline-none">
      </div>

      <div class="mb-3-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1 text-uppercase">Alamat Email *</label>
        <input type="email" id="editEmail" name="email" required class="w-full py-2-5 px-3 rounded-10 border-default bg-body text-primary fs-13 outline-none">
      </div>

      <div class="mb-3-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1 text-uppercase">Sobat ID (Opsional)</label>
        <input type="text" id="editSobatId" name="sobat_id" class="w-full py-2-5 px-3 rounded-10 border-default bg-body text-primary fs-13 outline-none">
      </div>

      <div class="mb-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1 text-uppercase">Jenis Kelamin</label>
        <select id="editJk" name="jenis_kelamin" class="w-full py-2-5 px-3 rounded-10 border-default bg-body text-primary fs-13 outline-none">
          <option value="Pr">Perempuan (Pr)</option>
          <option value="Lk">Laki-laki (Lk)</option>
        </select>
      </div>

      <div class="d-flex justify-end gap-2-5">
        <button type="button" onclick="closeEditModal()" class="btn btn-secondary py-2 px-4 fs-13 rounded-sm">Batal</button>
        <button type="submit" class="btn btn-primary py-2 px-4-5 fs-13 fw-semibold rounded-sm">Update Data</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL HAPUS PETUGAS -->
<div id="modalDelete" class="fixed inset-0 backdrop-blur d-flex items-center justify-center p-4" style="display: none; background: rgba(0,0,0,0.6); z-index: 9999;">
  <div class="bg-card border-default rounded-18 w-full p-6 text-center" style="max-width: 420px; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
    <div class="w-12 h-12 rounded-full d-flex items-center justify-center text-red m-0 mb-3-5 mx-auto fs-2xl" style="background: rgba(248, 113, 113, 0.12);">
      <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <h3 class="m-0 mb-1-5 fs-lg fw-bold text-primary">Konfirmasi Hapus Data</h3>
    <p class="m-0 mb-5 fs-sm text-muted">
      Apakah Anda yakin ingin menghapus data email petugas <strong id="deleteNama" class="text-primary"></strong>?
    </p>

    <form id="deleteForm" method="POST">
      <div class="d-flex justify-center gap-2-5">
        <button type="button" onclick="closeDeleteModal()" class="btn btn-secondary py-2 px-4 fs-13 rounded-sm">Batal</button>
        <button type="submit" class="btn btn-primary py-2 px-4-5 fs-13 fw-semibold rounded-sm" style="background: var(--accent-red); border-color: var(--accent-red);">Ya, Hapus Data</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL UPLOAD REKAP PETUGAS WILAYAH -->
<div id="modalUploadRekap" class="fixed inset-0 backdrop-blur d-flex items-center justify-center p-4" style="display: none; background: rgba(0,0,0,0.6); z-index: 9999;">
  <div class="bg-card border-default rounded-18 w-full p-6" style="max-width: 480px; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
    <div class="d-flex justify-between items-center mb-4-5">
      <h3 class="m-0 fs-lg fw-bold text-primary">
        <i class="bi bi-file-earmark-arrow-up-fill text-blue mr-1-5"></i> Upload Rekap Petugas Wilayah
      </h3>
      <button onclick="closeUploadRekapModal()" class="bg-none border-0 text-muted fs-title-md cursor-pointer">&times;</button>
    </div>
    
    <form action="/admin/petugas-email/upload-rekap" method="POST" enctype="multipart/form-data">
      <p class="fs-xs text-muted mb-4 lh-base">
        Upload file <code>rekap_petugas_wilayah_*.csv</code> atau <code>.xlsx</code> untuk secara otomatis mengaitkan alamat email petugas dengan kode wilayah SubSLS pada master data.
      </p>

      <div class="mb-5">
        <label class="d-block fs-caption fw-semibold text-muted mb-1-5 text-uppercase">Pilih File (.csv / .xlsx) *</label>
        <input type="file" name="rekap_file" accept=".csv, .xlsx, .xls" required class="w-full p-2.5 rounded-10 border-default bg-body text-primary fs-13">
      </div>

      <div class="d-flex justify-end gap-2-5">
        <button type="button" onclick="closeUploadRekapModal()" class="btn btn-secondary py-2 px-4 fs-13 rounded-sm">Batal</button>
        <button type="submit" class="btn btn-primary py-2 px-4-5 fs-13 fw-semibold rounded-sm">Upload &amp; Proses</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openUploadRekapModal() {
    document.getElementById('modalUploadRekap').style.display = 'flex';
  }
  function closeUploadRekapModal() {
    document.getElementById('modalUploadRekap').style.display = 'none';
  }

  function openCreateModal() {
    document.getElementById('modalCreate').style.display = 'flex';
  }
  function closeCreateModal() {
    document.getElementById('modalCreate').style.display = 'none';
  }

  function openEditModal(p) {
    document.getElementById('editForm').action = `/admin/petugas-email/edit/${p.id}`;
    document.getElementById('editNama').value = p.nama_lengkap || '';
    document.getElementById('editEmail').value = p.email || '';
    document.getElementById('editSobatId').value = p.sobat_id || '';
    document.getElementById('editJk').value = p.jenis_kelamin || 'Pr';
    document.getElementById('modalEdit').style.display = 'flex';
  }
  function closeEditModal() {
    document.getElementById('modalEdit').style.display = 'none';
  }

  function openDeleteModal(id, nama) {
    document.getElementById('deleteForm').action = `/admin/petugas-email/delete/${id}`;
    document.getElementById('deleteNama').textContent = nama;
    document.getElementById('modalDelete').style.display = 'flex';
  }
  function closeDeleteModal() {
    document.getElementById('modalDelete').style.display = 'none';
  }
</script>
