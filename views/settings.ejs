<div class="fade-in">
  <style>
    /* Premium switch styling */
    .settings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }
    .settings-group {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow);
    }
    .settings-group-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .settings-group-title i {
      color: var(--accent-blue);
    }
    
    .switch-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: rgba(255, 255, 255, 0.015);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      margin-bottom: 10px;
      transition: var(--transition);
    }
    body.light-mode .switch-item {
      background: rgba(0, 0, 0, 0.01);
    }
    .switch-item:hover {
      background: rgba(255, 255, 255, 0.035);
      border-color: var(--border-light);
    }
    body.light-mode .switch-item:hover {
      background: rgba(0, 0, 0, 0.02);
    }
    
    .switch-info {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    .switch-icon {
      font-size: 18px;
      color: var(--accent-cyan);
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }
    .switch-label-text {
      font-weight: 600;
      font-size: 13px;
      color: var(--text-primary);
      cursor: pointer;
    }
    .switch-desc {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    
    /* Toggle switch checkbox design */
    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
      flex-shrink: 0;
    }
    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: var(--border-light);
      transition: .3s;
      border-radius: 24px;
    }
    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: var(--text-primary);
      transition: .3s;
      border-radius: 50%;
    }
    .toggle-switch input:checked + .toggle-slider {
      background-color: var(--accent-blue);
    }
    .toggle-switch input:checked + .toggle-slider:before {
      transform: translateX(20px);
    }
    .settings-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 12px;
    }
    .settings-field label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
    }
    .settings-field input,
    .settings-field select {
      width: 100%;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      color: var(--text-primary);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      font-size: 13px;
      outline: none;
      transition: var(--transition);
    }
    .settings-field input:focus,
    .settings-field select:focus {
      border-color: var(--accent-blue);
      box-shadow: 0 0 0 2px rgba(var(--accent-rgb), 0.14);
    }
    .settings-hint {
      font-size: 11px;
      color: var(--text-muted);
      line-height: 1.45;
    }
    
    /* Premium radio-card styling */
    .radio-card {
      position: relative;
      display: flex;
      align-items: flex-start;
      padding: 14px 16px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: var(--transition);
      background: rgba(255, 255, 255, 0.015);
    }
    body.light-mode .radio-card {
      background: rgba(0, 0, 0, 0.01);
    }
    .radio-card:hover {
      background: rgba(255, 255, 255, 0.035);
      border-color: var(--border-light);
    }
    body.light-mode .radio-card:hover {
      background: rgba(0, 0, 0, 0.025);
    }
    .radio-card input[type="radio"]:checked + div strong {
      color: var(--accent-blue) !important;
    }
    .radio-card:has(input[type="radio"]:checked) {
      border-color: var(--accent-blue) !important;
      background: rgba(30, 144, 255, 0.08) !important;
    }
    
    /* Sticky Action Bar */
    .sticky-action-bar {
      position: sticky;
      bottom: 20px;
      background: rgba(30, 41, 59, 0.85); /* Semitransparent card color */
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px 24px;
      margin-top: 30px;
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      z-index: 100;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    
    @media (max-width: 768px) {
      .floating-save-btn {
        position: static !important;
        width: 100% !important;
        justify-content: center !important;
        margin-top: 16px !important;
        border-radius: 50px !important;
        padding: 12px 24px !important;
        font-size: 13.5px !important;
        transform: none !important;
        box-shadow: 0 4px 14px rgba(13, 110, 253, 0.25) !important;
      }
    }
  </style>

  <!-- HERO TITLE -->
  <div style="background: linear-gradient(135deg, rgba(var(--accent-rgb),0.12) 0%, rgba(var(--accent-rgb),0.03) 100%); border: 1px solid rgba(var(--accent-rgb),0.2); border-radius: 16px; padding: 32px 28px; margin-bottom: 24px; position: relative; overflow: hidden;">
    <div style="position: absolute; right: -20px; top: -20px; font-size: 120px; opacity: 0.04; line-height: 1; pointer-events: none;">
      <i class="bi bi-sliders"></i>
    </div>
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
      <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(var(--accent-rgb),0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <i class="bi bi-sliders" style="font-size: 26px; color: var(--accent-blue);"></i>
      </div>
      <div>
        <h1 style="font-size: 22px; font-weight: 800; color: var(--text-primary); margin: 0 0 4px 0;">Pengaturan Tampilan</h1>
        <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">Atur visibilitas halaman navigasi, widget overview, dan formula target realisasi</p>
      </div>
    </div>
  </div>

  <div class="card">
    <form action="/admin/settings" method="POST">
      <div class="settings-grid">
        
        <!-- GROUP 1: MENU NAVIGASI & FITUR -->
        <div class="settings-group">
          <div class="settings-group-title">
            <i class="bi bi-layout-sidebar-inset"></i> Menu Navigasi &amp; Halaman
          </div>
          
          <!-- Peta Progres -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-map"></i></span>
              <div style="min-width: 0;">
                <label for="page_map" class="switch-label-text">Peta Progres</label>
                <div class="switch-desc">Halaman visualisasi peta wilayah</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_map" name="page_map" value="1" <%= settings.page_map === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Early Warning -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-exclamation-octagon"></i></span>
              <div style="min-width: 0;">
                <label for="page_earlywarning" class="switch-label-text">Early Warning</label>
                <div class="switch-desc">Halaman peringatan dini pencapaian</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_earlywarning" name="page_earlywarning" value="1" <%= settings.page_earlywarning === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Deteksi Anomali -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-shield-exclamation"></i></span>
              <div style="min-width: 0;">
                <label for="page_deteksianomali" class="switch-label-text">Deteksi Anomali</label>
                <div class="switch-desc">Halaman kualitas dan anomali data</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_deteksianomali" name="page_deteksianomali" value="1" <%= settings.page_deteksianomali === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Performa Terbaik (Leaderboard) -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-trophy"></i></span>
              <div style="min-width: 0;">
                <label for="page_leaderboard" class="switch-label-text">Performa Terbaik</label>
                <div class="switch-desc">Leaderboard pencapaian tertinggi</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_leaderboard" name="page_leaderboard" value="1" <%= settings.page_leaderboard === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Performa Terendah -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-graph-down"></i></span>
              <div style="min-width: 0;">
                <label for="page_performatrendah" class="switch-label-text">Performa Terendah</label>
                <div class="switch-desc">Analisis petugas performa rendah</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_performatrendah" name="page_performatrendah" value="1" <%= settings.page_performatrendah === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Performa Petugas -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-speedometer2"></i></span>
              <div style="min-width: 0;">
                <label for="page_performa" class="switch-label-text">Performa Petugas</label>
                <div class="switch-desc">Dashboard gabungan performa terbaik & terendah (Rekomendasi)</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_performa" name="page_performa" value="1" <%= settings.page_performa === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Kecamatan -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-geo-alt"></i></span>
              <div style="min-width: 0;">
                <label for="page_kecamatan" class="switch-label-text">Kecamatan</label>
                <div class="switch-desc">Drilldown wilayah kecamatan</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_kecamatan" name="page_kecamatan" value="1" <%= settings.page_kecamatan === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Subsls -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-box-seam"></i></span>
              <div style="min-width: 0;">
                <label for="page_subsls" class="switch-label-text">Subsls</label>
                <div class="switch-desc">Rincian status per satuan lokal</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_subsls" name="page_subsls" value="1" <%= settings.page_subsls === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Per Korlap -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-person-workspace"></i></span>
              <div style="min-width: 0;">
                <label for="page_korlap" class="switch-label-text">Korlap</label>
                <div class="switch-desc">Drilldown Koordinator Lapangan</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_korlap" name="page_korlap" value="1" <%= settings.page_korlap === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Per PML -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-clipboard2-data"></i></span>
              <div style="min-width: 0;">
                <label for="page_pml" class="switch-label-text">PML</label>
                <div class="switch-desc">Drilldown Pengawas Lapangan PML</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_pml" name="page_pml" value="1" <%= settings.page_pml === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Per PCL -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-person-gear"></i></span>
              <div style="min-width: 0;">
                <label for="page_pcl" class="switch-label-text">PCL</label>
                <div class="switch-desc">Drilldown Petugas Pencacah PCL</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_pcl" name="page_pcl" value="1" <%= settings.page_pcl === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Export CSV -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-download"></i></span>
              <div style="min-width: 0;">
                <label for="page_export" class="switch-label-text">Export CSV</label>
                <div class="switch-desc">Ekspor data ke format CSV</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_export" name="page_export" value="1" <%= settings.page_export === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Asisten AI Chat -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-robot"></i></span>
              <div style="min-width: 0;">
                <label for="page_aiagent" class="switch-label-text">Asisten AI Chat</label>
                <div class="switch-desc">Fitur analisis &amp; tanya jawab AI</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="page_aiagent" name="page_aiagent" value="1" <%= settings.page_aiagent === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

        </div>



        <!-- GROUP 2: VISIBILITAS DATA GLOBAL -->
        <div class="settings-group">
          <div class="settings-group-title">
            <i class="bi bi-eye-slash-fill"></i> Visibilitas Data Global
          </div>

          <!-- Tampilkan Data Progres Muatan -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-cyan);"><i class="bi bi-box-seam"></i></span>
              <div style="min-width: 0;">
                <label for="show_progres_muatan" class="switch-label-text">Tampilkan Data Progres Muatan</label>
                <div class="switch-desc">Menampilkan atau menyembunyikan kolom, grafik, serta detail rincian petugas (PCL/PML) terkait Beban Muatan di seluruh halaman</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="show_progres_muatan" name="show_progres_muatan" value="1" <%= settings.show_progres_muatan === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>

        <!-- GROUP: INTEGRASI GOOGLE SPREADSHEET ANOMALI -->
        <div class="settings-group">
          <div class="settings-group-title">
            <i class="bi bi-file-earmark-spreadsheet-fill" style="color: var(--accent-yellow);"></i> Integrasi Google Spreadsheet Anomali
          </div>
          <div class="settings-field" style="margin-top: 8px;">
            <label for="google_sheets_anomaly_url" style="font-weight: 600;">URL Google Spreadsheet (Publikasi Web / Read-Only)</label>
            <input type="url" id="google_sheets_anomaly_url" name="google_sheets_anomaly_url" value="<%= settings.google_sheets_anomaly_url || '' %>" placeholder="https://docs.google.com/spreadsheets/d/e/.../pubhtml">
            <div class="settings-hint" style="margin-top: 4px;">Link Spreadsheet pengawasan yang dipublikasikan ke web (File > Share > Publish to web) untuk menampilkan data Anomali di halaman Deteksi Anomali.</div>
          </div>

          <div class="settings-field" style="margin-top: 14px;">
            <label for="google_sheets_apps_script_url" style="font-weight: 600;">URL Apps Script Web App (2-Way Sync / Edit Write-Back)</label>
            <input type="url" id="google_sheets_apps_script_url" name="google_sheets_apps_script_url" value="<%= settings.google_sheets_apps_script_url || '' %>" placeholder="https://script.google.com/macros/s/.../exec">
            <div class="settings-hint" style="margin-top: 4px;">URL Web App dari Google Apps Script untuk mengirimkan pembaruan status &amp; catatan tindak lanjut dari website kembali ke Google Spreadsheet.</div>
          </div>
        </div>

        <!-- GROUP 2B: METODE TARGET FASIH -->
        <div class="settings-group">
          <div class="settings-group-title">
            <i class="bi bi-bullseye"></i> Metode Target FASIH
          </div>
          <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 8px;">
            <label class="radio-card">
              <input type="radio" name="target_fasih_mode" value="static" <%= settings.target_fasih_mode === 'static' || !settings.target_fasih_mode ? 'checked' : '' %> style="margin-top: 4px; margin-right: 12px;">
              <div style="min-width: 0;">
                <strong style="display: block; font-size: 13px; margin-bottom: 3px; color: var(--text-primary); transition: color 0.2s;">Model 1: Target Alokasi Statis (Sesuai Dashboard Pimpinan)</strong>
                <span style="display: block; font-size: 11px; color: var(--text-muted); line-height: 1.4;">Target dikunci mutlak berdasarkan alokasi rancangan awal. Target tidak akan pernah berubah, namun progres petugas bisa melebihi 100% jika ada temuan baru.</span>
              </div>
            </label>

            <label class="radio-card">
              <input type="radio" name="target_fasih_mode" value="fasih-sm" <%= settings.target_fasih_mode === 'fasih-sm' ? 'checked' : '' %> style="margin-top: 4px; margin-right: 12px;">
              <div style="min-width: 0;">
                <strong style="display: block; font-size: 13px; margin-bottom: 3px; color: var(--text-primary); transition: color 0.2s;">Model 3: Target FASIH-SM (Sesuai Dashboard FASIH-SM)</strong>
                <span style="display: block; font-size: 11px; color: var(--text-muted); line-height: 1.4;">Target dihitung menggunakan kolom "total" yang ada di file excel progres (sheet Rekap Pivot) yang diupload.</span>
              </div>
            </label>
          </div>
        </div>

        <!-- GROUP 2C: METODE TARGET MUATAN -->
        <div class="settings-group">
          <div class="settings-group-title">
            <i class="bi bi-box-seam"></i> Metode Target Muatan
          </div>
          <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 8px;">
            <label class="radio-card">
              <input type="radio" name="target_muatan_mode" value="prelist" <%= settings.target_muatan_mode === 'prelist' || !settings.target_muatan_mode ? 'checked' : '' %> style="margin-top: 4px; margin-right: 12px;">
              <div style="min-width: 0;">
                <strong style="display: block; font-size: 13px; margin-bottom: 3px; color: var(--text-primary); transition: color 0.2s;">Model 1: Target Muatan Prelist (Original)</strong>
                <span style="display: block; font-size: 11px; color: var(--text-muted); line-height: 1.4;">Target muatan menggunakan alokasi prelist awal yang diimpor dari file JSON atau Master data.</span>
              </div>
            </label>

            <label class="radio-card">
              <input type="radio" name="target_muatan_mode" value="honor" <%= settings.target_muatan_mode === 'honor' ? 'checked' : '' %> style="margin-top: 4px; margin-right: 12px;">
              <div style="min-width: 0;">
                <strong style="display: block; font-size: 13px; margin-bottom: 3px; color: var(--text-primary); transition: color 0.2s;">Model 2: Target Honor</strong>
                <span style="display: block; font-size: 11px; color: var(--text-muted); line-height: 1.4;">Target muatan menggunakan jumlah pembayaran honor yang diambil dari kolom Y (keluarga) + Z (jml_utp_subsektor) + AA (Total_usaha_SBR) pada file muatan_sls_pembayaran_honor.xlsx.</span>
              </div>
            </label>
          </div>
        </div>

        <!-- GROUP 2D: PARAMETER TARGET & SPEEDOMETER -->
        <div class="settings-group">
          <div class="settings-group-title">
            <i class="bi bi-clock-history"></i> Parameter Target &amp; Speedometer
          </div>
          <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 8px;">
            
            <div class="settings-field">
              <label style="font-weight: 600; margin-bottom: 6px; display: block;">Metode Perhitungan Target Normal Harian</label>
              <div style="display: flex; flex-direction: column; gap: 8px;">
                <label class="radio-card">
                  <input type="radio" name="speedometer_calc_mode" value="total_target" <%= settings.speedometer_calc_mode === 'total_target' || !settings.speedometer_calc_mode ? 'checked' : '' %> style="margin-top: 4px; margin-right: 10px;">
                  <div style="min-width: 0;">
                    <strong style="display: block; font-size: 13px; color: var(--text-primary);">Model 1: Berbasis Total Target FASIH (Rekomendasi)</strong>
                    <span style="display: block; font-size: 11px; color: var(--text-muted); line-height: 1.35;">Target normal dihitung dari Total Target FASIH Kabupaten dibagi Total Alokasi Hari Pendataan (misal 68.618 / 77 hari = 891 dok/hari se-kabupaten).</span>
                  </div>
                </label>

                <label class="radio-card">
                  <input type="radio" name="speedometer_calc_mode" value="pcl_speed" <%= settings.speedometer_calc_mode === 'pcl_speed' ? 'checked' : '' %> style="margin-top: 4px; margin-right: 10px;">
                  <div style="min-width: 0;">
                    <strong style="display: block; font-size: 13px; color: var(--text-primary);">Model 2: Berbasis Target Flat Petugas (13 dok/PCL/hari)</strong>
                    <span style="display: block; font-size: 11px; color: var(--text-muted); line-height: 1.35;">Target normal dihitung dari perkalian standar flat per petugas (13 dok/hari x 165 PCL = 2.145 dok/hari se-kabupaten).</span>
                  </div>
                </label>
              </div>
            </div>

            <div class="settings-field">
              <label for="speedometer_start_date" style="font-weight: 600;">Tanggal Mulai Pendataan (Start Date)</label>
              <input type="date" id="speedometer_start_date" name="speedometer_start_date" value="<%= settings.speedometer_start_date || '2026-06-15' %>" required>
              <div class="settings-hint">Tanggal dimulainya pendataan lapangan (Default: 15 Juni 2026).</div>
            </div>

            <div class="settings-field">
              <label for="speedometer_target_date" style="font-weight: 600;">Tanggal Target Selesai (Deadline)</label>
              <input type="date" id="speedometer_target_date" name="speedometer_target_date" value="<%= settings.speedometer_target_date || '2026-08-31' %>" required>
              <div class="settings-hint">Tanggal deadline target penyelesaian 100% pendataan (Default: 31 Agustus 2026).</div>
            </div>

            <div class="settings-field">
              <label for="speedometer_target_speed_per_pcl" style="font-weight: 600;">Target Kecepatan Harian PCL (Khusus Model 2)</label>
              <input type="number" id="speedometer_target_speed_per_pcl" name="speedometer_target_speed_per_pcl" min="1" max="100" value="<%= settings.speedometer_target_speed_per_pcl || '13' %>" required>
              <div class="settings-hint">Target standar pengisian dokumen per petugas per hari jika menggunakan Model 2 (Default: 13).</div>
            </div>
          </div>
        </div>

        <!-- GROUP 2E: VISIBILITAS STATUS ASSIGNMENT FASIH -->
        <div class="settings-group">
          <div class="settings-group-title">
            <i class="bi bi-eye"></i> Visibilitas Status Assignment FASIH
          </div>
          <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px; margin-bottom: 10px;">Pilih status mana saja yang ingin ditampilkan di kartu ringkasan dan tabel data (Overview, PCL, SubSLS):</p>
          
          <!-- Status OPEN -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: #f97316;"><i class="bi bi-circle"></i></span>
              <div style="min-width: 0;">
                <label for="show_status_open" class="switch-label-text">Status OPEN (Belum Diisi)</label>
                <div class="switch-desc">Tampilkan status dokumen yang belum mulai diisi</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="show_status_open" name="show_status_open" value="1" <%= settings.show_status_open === '1' || settings.show_status_open === undefined ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Status DRAFT -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-yellow);"><i class="bi bi-pencil-square"></i></span>
              <div style="min-width: 0;">
                <label for="show_status_draft" class="switch-label-text">Status DRAFT (Sedang Diisi)</label>
                <div class="switch-desc">Tampilkan status dokumen yang masih dalam draf</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="show_status_draft" name="show_status_draft" value="1" <%= settings.show_status_draft === '1' || settings.show_status_draft === undefined ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Status SUBMITTED -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-blue);"><i class="bi bi-send-check"></i></span>
              <div style="min-width: 0;">
                <label for="show_status_submitted" class="switch-label-text">Status SUBMITTED (Oleh PCL)</label>
                <div class="switch-desc">Tampilkan status dokumen yang sudah disubmit oleh PCL</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="show_status_submitted" name="show_status_submitted" value="1" <%= settings.show_status_submitted === '1' || settings.show_status_submitted === undefined ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Status APPROVED -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-green);"><i class="bi bi-check-circle"></i></span>
              <div style="min-width: 0;">
                <label for="show_status_approved" class="switch-label-text">Status APPROVED (Disetujui PML/Korlap)</label>
                <div class="switch-desc">Tampilkan status dokumen yang sudah disetujui</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="show_status_approved" name="show_status_approved" value="1" <%= settings.show_status_approved === '1' || settings.show_status_approved === undefined ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Status REJECTED -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-red);"><i class="bi bi-x-circle"></i></span>
              <div style="min-width: 0;">
                <label for="show_status_rejected" class="switch-label-text">Status REJECTED (Ditolak)</label>
                <div class="switch-desc">Tampilkan status dokumen yang ditolak / dikembalikan</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="show_status_rejected" name="show_status_rejected" value="1" <%= settings.show_status_rejected === '1' || settings.show_status_rejected === undefined ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>

        <!-- GROUP 3: KONTEN OVERVIEW -->
        <div class="settings-group">
          <div class="settings-group-title">
            <i class="bi bi-speedometer2"></i> Konten Dashboard Overview
          </div>

          <!-- Card Assignment FASIH -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-purple);"><i class="bi bi-phone"></i></span>
              <div style="min-width: 0;">
                <label for="overview_fasih" class="switch-label-text">Widget Assignment FASIH</label>
                <div class="switch-desc">Realisasi Approved vs Target FASIH</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="overview_fasih" name="overview_fasih" value="1" <%= settings.overview_fasih === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Card Progres Realisasi Pencacahan Muatan -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-cyan);"><i class="bi bi-speedometer2"></i></span>
              <div style="min-width: 0;">
                <label for="overview_muatan" class="switch-label-text">Widget Realisasi Muatan</label>
                <div class="switch-desc">Realisasi Usaha vs Target Muatan</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="overview_muatan" name="overview_muatan" value="1" <%= settings.overview_muatan === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Tren Harian Muatan -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-graph-up-arrow"></i></span>
              <div style="min-width: 0;">
                <label for="overview_tren_muatan" class="switch-label-text">Grafik Tren Muatan</label>
                <div class="switch-desc">Garis tren pengumpulan data muatan</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="overview_tren_muatan" name="overview_tren_muatan" value="1" <%= settings.overview_tren_muatan === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Tren Harian FASIH -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-purple);"><i class="bi bi-graph-up"></i></span>
              <div style="min-width: 0;">
                <label for="overview_tren_fasih" class="switch-label-text">Grafik Tren FASIH</label>
                <div class="switch-desc">Garis tren progres status FASIH</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="overview_tren_fasih" name="overview_tren_fasih" value="1" <%= settings.overview_tren_fasih === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Heatmap Aktivitas Harian -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon" style="color: var(--accent-cyan);"><i class="bi bi-grid-3x3-gap-fill"></i></span>
              <div style="min-width: 0;">
                <label for="overview_heatmap" class="switch-label-text">Heatmap Aktivitas Harian</label>
                <div class="switch-desc">Kalender heatmap progres harian FASIH</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="overview_heatmap" name="overview_heatmap" value="1" <%= settings.overview_heatmap === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Ringkasan Progres per Kecamatan -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-geo-alt"></i></span>
              <div style="min-width: 0;">
                <label for="overview_kecamatan" class="switch-label-text">Ringkasan per Kecamatan</label>
                <div class="switch-desc">Tabel ringkasan &amp; chart kecamatan</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="overview_kecamatan" name="overview_kecamatan" value="1" <%= settings.overview_kecamatan === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Klasifikasi Tipe Bangunan Tinggal -->
          <div class="switch-item">
            <div class="switch-info">
              <span class="switch-icon"><i class="bi bi-house-door"></i></span>
              <div style="min-width: 0;">
                <label for="overview_bangunan" class="switch-label-text">Klasifikasi Tipe Bangunan</label>
                <div class="switch-desc">Klasifikasi bangunan tinggal lapangan</div>
              </div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="overview_bangunan" name="overview_bangunan" value="1" <%= settings.overview_bangunan === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

        </div>

      </div>

      <div class="sticky-action-bar">
        <button type="submit" class="btn btn-primary" style="padding: 12px 28px; font-weight: 700; border-radius: 10px; display: flex; align-items: center; gap: 8px;">
          <i class="bi bi-save-fill"></i> Simpan Pengaturan
        </button>
      </div>
    </form>
  </div>
</div>
