<%
  let activeTargetPct = 25;
  let targetMonthName = '30 Juni';
  const currentDate = typeof latestUpload !== 'undefined' && latestUpload ? new Date(latestUpload.tanggal) : new Date();
  if (currentDate >= new Date('2026-07-01')) {
    activeTargetPct = 40;
    targetMonthName = '15 Juli';
  }
%>
<div class="fade-in">
  <% if (!uploadId) { %>
    <div class="card empty-state">
      <div class="empty-state-icon"><i class="bi bi-map"></i></div>
      <div class="empty-state-title">Belum Ada Data Kecamatan</div>
      <div class="empty-state-text">Upload file Excel untuk mulai memantau progres pendataan per kecamatan di wilayah PPU.</div>
      <a href="<%= navPrefix %>/admin/upload" class="empty-state-action"><i class="bi bi-cloud-arrow-up-fill"></i> Upload Data Sekarang</a>
    </div>
  <% } else { %>

    <!-- KECAMATAN CARDS GRID -->
    <div class="kec-grid">
      <% kecStats.forEach(k => { %>
        <a href="/kecamatan?kec=<%= encodeURIComponent(k.kecamatan) %>" class="kec-card <%= filterKec === k.kecamatan ? 'active' : '' %>">
          <div class="kec-name"><i class="bi bi-geo-alt"></i> Kec. <%= k.kecamatan %></div>
          
          <% if (typeof settings !== 'undefined' && settings.show_progres_muatan === '1') { %>
            <!-- DUAL PROGRESS VIEW: FASIH + MUATAN -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; margin-bottom: 8px;">
              <!-- FASIH BLOCK -->
              <div style="background: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.25); border-radius: 8px; padding: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                  <span style="font-size: 11px; font-weight: 700; color: var(--accent-purple); text-transform: uppercase;"><i class="bi bi-file-earmark-check"></i> FASIH</span>
                  <span style="font-size: 15px; font-weight: 800; color: var(--accent-purple);"><%= k.fasih_pct_str %>%</span>
                </div>
                <div style="height: 5px; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden; margin-bottom: 6px;">
                  <div class="progress-bar <%= parseFloat(k.fasih_pct_str) >= 100 ? 'green' : (parseFloat(k.fasih_pct_str) < 40 ? 'red' : 'purple') %>" data-width="<%= k.fasih_pct_str %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); line-height: 1.4;">
                  Appr/Subm: <strong><%= ((k.approved_total || 0) + (k.submitted_total || 0)).toLocaleString('id-ID') %></strong><br>
                  Target: <strong><%= (k.target_fasih_total || 0).toLocaleString('id-ID') %></strong>
                </div>
              </div>

              <!-- MUATAN BLOCK -->
              <div style="background: rgba(6, 182, 212, 0.08); border: 1px solid rgba(6, 182, 212, 0.25); border-radius: 8px; padding: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                  <span style="font-size: 11px; font-weight: 700; color: var(--accent-cyan); text-transform: uppercase;"><i class="bi bi-box-seam"></i> Muatan</span>
                  <span style="font-size: 15px; font-weight: 800; color: var(--accent-cyan);"><%= k.muatan_pct_str %>%</span>
                </div>
                <div style="height: 5px; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden; margin-bottom: 6px;">
                  <div class="progress-bar <%= parseFloat(k.muatan_pct_str) >= 100 ? 'green' : (parseFloat(k.muatan_pct_str) < 40 ? 'red' : 'blue') %>" data-width="<%= k.muatan_pct_str %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); line-height: 1.4;">
                  Realisasi: <strong><%= (k.muatan_selesai !== undefined ? k.muatan_selesai : (k.usaha_total + k.keluarga_total)).toLocaleString('id-ID') %></strong><br>
                  Target: <strong><%= (k.total_muatan || 0).toLocaleString('id-ID') %></strong>
                </div>
              </div>
            </div>
          <% else { %>
            <!-- SINGLE PROGRESS VIEW: FASIH ONLY -->
            <div class="kec-pct"><%= k.fasih_pct_str %>%</div>
            <div class="progress-bar-target-wrap" style="position: relative; height: 6px; margin-top: 16px; margin-bottom: 8px;">
              <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                <div class="progress-bar <%= parseFloat(k.fasih_pct_str) >= 100 ? 'green' : (parseFloat(k.fasih_pct_str) < 40 ? 'red' : 'blue') %>" data-width="<%= k.fasih_pct_str %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
              </div>
              
              <!-- Marker 25% (30 Juni) -->
              <div style="position: absolute; left: 25%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 25 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 25 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">30 Jun: 25%</span>
              </div>

              <!-- Marker 40% (15 Juli) -->
              <div style="position: absolute; left: 40%; top: -3px; height: 12px; border-left: 1px dashed <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; opacity: <%= activeTargetPct === 40 ? '1' : '0.5' %>; z-index: 2; pointer-events: none;">
                <span style="position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 800; color: <%= activeTargetPct === 40 ? 'var(--accent-cyan)' : 'var(--text-muted)' %>; white-space: nowrap;">15 Jul: 40%</span>
              </div>
            </div>
            
            <div class="kec-detail">
              <%= settings.target_fasih_mode === 'fasih-sm' ? 'Target FASIH-SM' : 'Target Statis' %>: <strong><%= k.target_fasih_total.toLocaleString('id-ID') %></strong><br>
              Approved: <strong><%= k.approved_total.toLocaleString('id-ID') %></strong> · Rejected: <strong><%= k.rejected_total.toLocaleString('id-ID') %></strong><br>
              Submitted: <strong><%= k.submitted_total.toLocaleString('id-ID') %></strong> · Draft: <strong><%= k.draft_total.toLocaleString('id-ID') %></strong>
            </div>
          <% } %>
        </a>
      <% }) %>
    </div>

    <!-- DETAIL TABLE OF DESAS FOR CHOSEN KECAMATAN -->
    <div id="kecDetailContainer" style="min-width: 0 !important; max-width: 100% !important; width: 100% !important; box-sizing: border-box !important;">
      <% if (filterKec) { %>
      <div class="card mt-4" style="min-width: 0 !important; max-width: 100% !important; width: 100% !important; box-sizing: border-box !important; overflow: hidden !important;">
        <div class="card-header" style="display: flex !important; flex-wrap: nowrap !important; align-items: center !important; justify-content: space-between !important; gap: 8px !important; min-width: 0 !important; width: 100% !important;">
          <div class="card-title" style="white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; flex: 1 1 auto !important; min-width: 0 !important; max-width: calc(100% - 44px) !important;"><i class="bi bi-houses"></i> Rincian Progres Per Desa/Kelurahan di Kecamatan <%= filterKec %></div>
          <a href="/kecamatan" class="btn btn-secondary btn-xs btn-close-detail" title="Tutup Rincian" aria-label="Tutup Rincian" style="flex-shrink: 0 !important;"><i class="bi bi-x-lg"></i><span class="hide-sm ms-1"> Tutup Rincian</span></a>
        </div>

        <div class="search-wrap mb-4">
          <input type="search" id="desaSearch" placeholder="Cari nama desa/kelurahan..." aria-label="Cari nama desa atau kelurahan" style="width: 100%; max-width: 300px;">
        </div>

        <% if (desaStats && desaStats.length > 0) { %>
          <div class="table-wrap" style="width: 100% !important; max-width: 100% !important; min-width: 0 !important; overflow-x: auto !important; -webkit-overflow-scrolling: touch !important; touch-action: pan-x pan-y !important; box-sizing: border-box !important;">
            <table id="desaTable" style="width: 100%; min-width: max-content !important; border-collapse: collapse;">
              <thead>
                <tr>
                  <th rowspan="2" class="text-center" style="font-weight: 600; width: 40px; white-space: nowrap;">No</th>
                  <th rowspan="2" style="min-width: 120px; white-space: nowrap;">Nama Desa/Kelurahan</th>
                  <th rowspan="2" class="text-right bg-purple-soft" style="min-width: 130px; white-space: nowrap;">FASIH %</th>
                  <th rowspan="2" class="text-center bg-cyan-soft muatan-col" style="min-width: 95px; white-space: nowrap;">Muatan %</th>
                  <th colspan="5" class="text-center bg-purple-soft" style="border-bottom: 1px solid var(--border); white-space: nowrap;">Assignment FASIH</th>
                  <th colspan="2" class="text-center bg-cyan-soft muatan-col" style="border-bottom: 1px solid var(--border); white-space: nowrap;">Progres Muatan</th>
                </tr>
                <tr>
                  <th class="text-right bg-yellow-soft" style="min-width: 70px; white-space: nowrap;">Draft</th>
                  <th class="text-right bg-blue-soft" style="min-width: 75px; white-space: nowrap;">Submitted</th>
                  <th class="text-right bg-red-soft" style="min-width: 75px; white-space: nowrap;">Rejected</th>
                  <th class="text-right bg-green-soft" style="min-width: 75px; white-space: nowrap;">Approved</th>
                  <th class="text-right bg-purple-soft" style="min-width: 85px; white-space: nowrap;"><%= settings.target_fasih_mode === 'fasih-sm' ? 'Tgt FASIH-SM' : 'Tgt Statis' %></th>
                  
                  <th class="text-right bg-cyan-soft muatan-col" style="min-width: 75px; white-space: nowrap;">Realisasi</th>
                  <th class="text-right bg-cyan-soft muatan-col" style="min-width: 75px; white-space: nowrap;">Target</th>
                </tr>
              </thead>
              <tbody>
                <% desaStats.forEach((d, index) => { %>
                  <% let fasihPct = d.fasih_pct_str; %>
                  <% let muatanPct = d.muatan_pct_str; %>
                  <tr>
                    <td class="text-center" style="font-weight: 600; background: var(--bg-subtle); white-space: nowrap;"><%= index + 1 %></td>
                    <td class="td-primary" style="white-space: nowrap;"><a href="/subsls?kec=<%= encodeURIComponent(filterKec) %>&desa=<%= encodeURIComponent(d.desa) %>" style="color: inherit; text-decoration: none;"><i class="bi bi-pin-map"></i> <%= d.desa %></a></td>
                    
                    <td class="bg-purple-soft" data-sort="<%= parseFloat(fasihPct) %>" style="min-width: 130px; padding: 6px 10px; vertical-align: middle;">
                       <%
                        const fReal = (d.submitted_total || 0) + (d.approved_total || 0) + (d.rejected_total || 0);
                        const fTgt = d.target_fasih_total || 0;
                        const fW = Math.min(parseFloat(fasihPct), 100);
                        const fColor = fW >= 100 ? 'var(--accent-green)' : (fW < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');
                      %>
                      <div style="display:flex; justify-content:space-between; font-size:10px; color:var(--text-secondary); margin-bottom:3px; white-space: nowrap;">
                        <span style="font-weight:700; color:<%= fColor %>"><%= fasihPct %>%</span>
                        <span><%= fReal.toLocaleString('id-ID') %> / <%= fTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div style="height:5px; background:var(--bg-progress-wrap); border-radius:99px; overflow:hidden;">
                        <div class="progress-bar <%= fW >= 100 ? 'green' : (fW < 40 ? 'red' : 'purple') %>" data-width="<%= fW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    <td class="text-center bg-cyan-soft muatan-col" data-sort="<%= parseFloat(muatanPct) %>" style="min-width: 90px; padding: 6px 10px; vertical-align: middle; white-space: nowrap;">
                      <% if (parseFloat(muatanPct) >= 100) { %>
                        <span class="badge badge-green">100%</span>
                      <% } else if (parseFloat(muatanPct) < 40) { %>
                        <span class="badge badge-red"><%= muatanPct %>%</span>
                      <% } else { %>
                        <span class="badge badge-blue"><%= muatanPct %>%</span>
                      <% } %>
                    </td>

                    <td class="text-right bg-yellow-soft status-draft-text" data-sort="<%= d.draft_total %>" style="white-space: nowrap;"><%= (d.draft_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-blue-soft status-submit-text" data-sort="<%= d.submitted_total %>" style="white-space: nowrap;"><%= (d.submitted_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-red-soft status-reject-text" data-sort="<%= d.rejected_total %>" style="font-weight: 600; white-space: nowrap;"><%= (d.rejected_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-green-soft status-approve-text" data-sort="<%= d.approved_total %>" style="font-weight: 600; white-space: nowrap;"><%= (d.approved_total || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-purple-soft" data-sort="<%= d.target_fasih_total %>" style="white-space: nowrap;"><%= (d.target_fasih_total || 0).toLocaleString('id-ID') %></td>
                    
                    <td class="text-right fw-bold bg-cyan-soft muatan-col" data-sort="<%= d.muatan_selesai !== undefined ? d.muatan_selesai : (d.usaha_total + d.keluarga_total) %>" style="white-space: nowrap;"><%= (d.muatan_selesai !== undefined ? d.muatan_selesai : (d.usaha_total + d.keluarga_total)).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-cyan-soft muatan-col" data-sort="<%= d.total_muatan %>" style="white-space: nowrap;"><%= d.total_muatan.toLocaleString('id-ID') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="no-data">Tidak ada rincian data desa/kelurahan.</div>
        <% } %>
      </div>
    <% } else { %>
      <div class="card empty-state text-center" style="border-style: dashed; border-width: 2px;">
        <div class="empty-state-icon"><i class="bi bi-arrow-up-circle"></i></div>
        <div class="empty-state-title">Pilih Kecamatan</div>
        <div class="empty-state-text">Klik salah satu kartu kecamatan di atas untuk melihat rincian progres per desa/kelurahan.</div>
      </div>
    <% } %>
    </div>

  <% } %>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    makeTableSortable('desaTable');
    makeTableSearchable('desaSearch', 'desaTable');

    // Animate progress bars already rendered on initial page load (SSR + kec cards)
    if (window.initProgressBars) window.initProgressBars(document);

    const detailContainer = document.getElementById('kecDetailContainer');
    const cardsGrid = document.querySelector('.kec-grid');

    if (cardsGrid && detailContainer) {

      // --- MOBILE INLINE DETAIL INJECTION ---
      // On mobile (< 768px): move detail container inside .kec-grid right after the active card
      // On desktop: keep detail container in its original position (after .kec-grid)

      // Create a sentinel placeholder to track original DOM position
      const detailPlaceholder = document.createElement('div');
      detailPlaceholder.id = 'kecDetailPlaceholder';
      detailPlaceholder.style.display = 'none';
      detailContainer.parentNode.insertBefore(detailPlaceholder, detailContainer);

      function isMobile() {
        return window.innerWidth < 992 || window.innerHeight < 500;
      }

      function placeDetailAfterCard(activeCard) {
        if (!isMobile() || !activeCard) {
          restoreDetailOriginalPosition();
          return;
        }
        // Move into grid right after active card (grid-column: 1/-1 via CSS spans all cols)
        activeCard.parentNode.insertBefore(detailContainer, activeCard.nextSibling);
        detailContainer.classList.add('kec-detail-inline-mobile');
      }

      function restoreDetailOriginalPosition() {
        if (detailContainer.parentNode !== detailPlaceholder.parentNode) {
          detailPlaceholder.parentNode.insertBefore(detailContainer, detailPlaceholder.nextSibling);
        }
        detailContainer.classList.remove('kec-detail-inline-mobile');
      }

      // Reposition on screen resize (e.g. orientation change)
      window.addEventListener('resize', () => {
        const activeCard = cardsGrid.querySelector('a.kec-card.active');
        if (activeCard && detailContainer.querySelector('.card')) {
          placeDetailAfterCard(activeCard);
        } else {
          restoreDetailOriginalPosition();
        }
      });

      // Intercept card clicks
      cardsGrid.addEventListener('click', (e) => {
        const link = e.target.closest('a.kec-card');
        if (!link) return;

        e.preventDefault();
        const url = link.getAttribute('href');

        // Update active class on cards
        cardsGrid.querySelectorAll('a.kec-card').forEach(c => {
          c.classList.remove('active');
        });
        link.classList.add('active');

        // Opacity transition
        detailContainer.style.opacity = '0.5';

        fetch(url)
          .then(res => res.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newDetail = doc.getElementById('kecDetailContainer');
            if (newDetail) {
              detailContainer.innerHTML = newDetail.innerHTML;
              detailContainer.style.opacity = '1';
              detailContainer.classList.remove('smooth-detail-animate');
              void detailContainer.offsetWidth;
              detailContainer.classList.add('smooth-detail-animate');

              // Update URL path without refresh
              window.history.pushState(null, '', url);

              // Re-bind sort and search utilities
              makeTableSortable('desaTable');
              makeTableSearchable('desaSearch', 'desaTable');

              // Animate new progress bars injected via PJAX
              if (window.initProgressBars) window.initProgressBars(detailContainer);

              // Re-bind close handler
              bindCloseDetail();

              // Place detail below active card on mobile
              placeDetailAfterCard(link);

              // Scroll to detail smoothly on mobile
              if (isMobile()) {
                setTimeout(() => {
                  detailContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 50);
              }
            }
          })
          .catch(err => {
            console.error(err);
            detailContainer.style.opacity = '1';
          });
      });

      // AJAX Tutup Detail handler
      function bindCloseDetail() {
        const closeBtn = detailContainer.querySelector('a[href*="/kecamatan"]');
        if (closeBtn) {
          closeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const url = closeBtn.getAttribute('href') || '/kecamatan';

            // Reset active cards
            cardsGrid.querySelectorAll('a.kec-card').forEach(c => {
              c.classList.remove('active');
            });

            // Restore position before fetching
            restoreDetailOriginalPosition();

            detailContainer.style.opacity = '0.5';
            fetch(url)
              .then(res => res.text())
              .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newDetail = doc.getElementById('kecDetailContainer');
                if (newDetail) {
                  detailContainer.innerHTML = newDetail.innerHTML;
                  detailContainer.style.opacity = '1';
                  detailContainer.classList.remove('smooth-detail-animate');
                  void detailContainer.offsetWidth;
                  detailContainer.classList.add('smooth-detail-animate');
                  window.history.pushState(null, '', url);

                  // Animate progress bars after closing detail (back to list state)
                  if (window.initProgressBars) window.initProgressBars(detailContainer);
                  bindCloseDetail();
                }
              })
              .catch(err => {
                console.error(err);
                detailContainer.style.opacity = '1';
              });
          });
        }
      }

      bindCloseDetail();

    } // end if (cardsGrid && detailContainer)
  });
</script>
