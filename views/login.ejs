<style>
  /* =====================================================================
     LOGIN PAGE — Full viewport, zero scroll (horizontal & vertical)
     body.page-login locks both axes; inner card scales to fit the screen.
     ===================================================================== */

  /* Lock entire viewport — no scroll at all */
  html.page-login,
  body.page-login {
    overflow: hidden !important;
    height: 100dvh !important;
    width: 100vw !important;
  }

  /* page-content fills exactly the viewport minus the topbar */
  body.page-login .page-content {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;
    padding: 16px !important;
    height: calc(100dvh - var(--header-height)) !important;
    box-sizing: border-box !important;
  }

  /* Fade-in wrapper */
  .login-page-wrapper {
    width: 100%;
    max-width: 720px;
  }

  /* Card container — Premium Glassmorphic Design */
  .login-container-card {
    display: flex;
    flex-direction: row;
    border-radius: 20px;
    overflow: hidden;
    padding: 0 !important;
    border: 1px solid var(--border);
    background: var(--bg-card);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.16), 0 0 0 1px rgba(255, 255, 255, 0.05);
    max-height: calc(100dvh - var(--header-height) - 32px);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* LEFT: Logo & Branding column */
  .login-logo-col {
    flex: 0 0 240px;
    background: linear-gradient(180deg, rgba(249, 115, 22, 0.08) 0%, rgba(194, 65, 12, 0.04) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
    border-right: 1px solid var(--border);
    gap: 12px;
    position: relative;
  }

  .login-logo-col img {
    width: clamp(100px, 11vw, 135px);
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.25));
  }

  .login-logo-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.4;
  }

  /* RIGHT: Form column */
  .login-form-col {
    flex: 1;
    padding: 32px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
    min-width: 0;
  }

  .login-form-col h2 {
    font-size: 20px;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 4px;
    text-align: center;
    letter-spacing: -0.01em;
  }

  .login-form-col .login-subtitle {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 18px;
    text-align: center;
  }

  /* Icon-embedded Input Fields */
  .login-field {
    margin-bottom: 14px;
    text-align: left;
  }

  .login-field label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .login-input-group {
    position: relative;
    display: flex;
    align-items: center;
  }

  .login-input-icon {
    position: absolute;
    left: 12px;
    color: var(--text-muted);
    font-size: 14px;
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .login-input-group input {
    width: 100%;
    padding: 10px 38px 10px 36px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 13px;
    background: var(--bg-body);
    color: var(--text-primary);
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .login-input-group input:focus {
    outline: none;
    border-color: var(--accent-blue, #f97316);
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.2);
    background: var(--bg-card);
  }

  .login-input-group input:focus ~ .login-input-icon {
    color: var(--accent-blue, #f97316);
  }

  .login-toggle-pwd {
    position: absolute;
    right: 10px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 14px;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.2s ease;
  }

  .login-toggle-pwd:hover {
    color: var(--text-primary);
  }

  .login-remember {
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .login-remember input[type="checkbox"] {
    width: 15px;
    height: 15px;
    accent-color: var(--accent-blue, #f97316);
    cursor: pointer;
    flex-shrink: 0;
    border-radius: 4px;
  }

  .login-remember label {
    font-size: 12px;
    color: var(--text-secondary);
    cursor: pointer;
    user-select: none;
  }

  /* Submit & Action Buttons */
  .login-submit-btn {
    width: 100%;
    justify-content: center;
    padding: 11px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 10px;
    background: var(--survey-gradient, linear-gradient(135deg, var(--accent-blue, #f97316) 0%, var(--accent-orange, #c2410c) 100%));
    border: none;
    color: #ffffff;
    box-shadow: var(--survey-glow, 0 4px 14px rgba(249, 115, 22, 0.35));
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .login-submit-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.12);
  }

  .login-alt-btn {
    width: 100%;
    justify-content: center;
    padding: 9px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 10px;
  }

  .login-back-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 12px;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .login-back-link:hover {
    color: var(--text-primary);
  }

  /* Avatar for saved account */
  .login-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--survey-gradient, linear-gradient(135deg, var(--accent-blue, #f97316) 0%, var(--accent-orange, #c2410c) 100%));
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px auto;
    box-shadow: var(--survey-glow, 0 6px 18px rgba(249, 115, 22, 0.35));
    border: 3px solid var(--border);
  }

  .login-avatar span {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
  }

  .login-danger-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 10px;
    font-size: 11px;
    color: var(--accent-red);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .login-danger-link:hover {
    opacity: 0.8;
  }

  /* Responsive Adjustments for Mobile Viewports */
  @media (max-width: 620px) {
    .login-container-card {
      flex-direction: column !important;
      max-height: calc(100dvh - var(--header-height) - 20px);
    }

    .login-logo-col {
      flex: none !important;
      padding: 14px 16px !important;
      border-right: none !important;
      border-bottom: 1px solid var(--border) !important;
      flex-direction: row !important;
      gap: 10px !important;
      justify-content: center !important;
    }

    .login-logo-col img { width: 44px !important; }
    .login-logo-badge { display: none !important; }
    .login-logo-label { font-size: 11px; text-align: left; }

    .login-form-col { padding: 18px 20px !important; }
    .login-form-col h2 { font-size: 17px; }
    .login-form-col .login-subtitle { margin-bottom: 14px; }
    .login-field { margin-bottom: 10px; }
    .login-input-group input { padding: 8px 34px 8px 34px; font-size: 12.5px; }
    .login-remember { margin-bottom: 14px; }
    .login-submit-btn { padding: 9px; }
  }

  @media (max-width: 400px) {
    body.page-login .page-content { padding: 8px !important; }
    .login-logo-col { padding: 10px !important; }
    .login-form-col { padding: 14px 14px !important; }
    .login-avatar { width: 52px; height: 52px; }
    .login-avatar span { font-size: 18px; }
  }
</style>

<div class="login-page-wrapper fade-in">
  <div class="card login-container-card">

    <!-- LEFT: Logo Column -->
    <div class="login-logo-col">
      <% if (typeof activeSurvey !== 'undefined' && activeSurvey === 'se2026') { %>
      <img src="/logo-vertical.png"      alt="Logo SE2026" class="logo-light" loading="eager">
      <img src="/logo-vertical-dark.png" alt="Logo SE2026" class="logo-dark"  fetchpriority="high" loading="eager">
      <div class="login-logo-label">Monitoring SE2026<br>Penajam Paser Utara</div>
      <% } else { %>
      <%
        let _lLogo = '/images/logo-pananyo-taka-flow.svg';
        if (typeof activeSurvey !== 'undefined') {
          if (activeSurvey === 'sakernas-pemutakhiran') _lLogo = '/images/logo-sakernas-pemutakhiran.svg';
          else if (activeSurvey === 'sakernas-pendataan') _lLogo = '/images/logo-sakernas-pendataan.svg';
          else if (activeSurvey.startsWith('sakernas')) _lLogo = '/images/logo-sakernas-mark.svg';
        }
      %>
      <div style="margin-bottom: 10px; display: flex; align-items: center; justify-content: center;">
        <img src="<%= _lLogo %>" alt="Logo <%= (typeof surveyConfig !== 'undefined' ? surveyConfig.shortName : 'Survei') %>" width="64" height="64" style="object-fit: contain; filter: drop-shadow(0 4px 14px rgba(var(--accent-rgb), 0.35));">
      </div>
      <div class="login-logo-label">Monitoring <%= (typeof surveyConfig !== 'undefined' ? surveyConfig.shortName : 'Survei') %><br>Penajam Paser Utara</div>
      <% } %>
    </div>

    <!-- RIGHT: Form Column -->
    <div class="login-form-col">

      <% if (typeof savedAccount !== 'undefined' && savedAccount) { %>

        <!-- PANEL A: Saved Account -->
        <div id="saved-account-panel" class="fade-in">
          <div class="login-avatar">
            <span><%= savedAccount.username.substring(0, 2) %></span>
          </div>
          <h2><%= savedAccount.username %></h2>
          <p class="login-subtitle"><i class="bi bi-shield-check" style="color: var(--accent-green);"></i> Sesi <%= savedAccount.role %></p>

          <form action="/login/token" method="POST">
            <button type="submit" class="btn btn-primary login-submit-btn">
              <i class="bi bi-unlock-fill"></i> Masuk sebagai <%= savedAccount.username %>
            </button>
          </form>

          <button onclick="switchToNormalForm()" class="btn btn-secondary login-alt-btn" style="margin-top:8px;">
            <i class="bi bi-person-gear"></i> Gunakan Akun Lain
          </button>

          <a href="/login/clear-saved" class="login-danger-link">
            <i class="bi bi-trash3"></i> Hapus Sesi Tersimpan
          </a>
        </div>

        <!-- PANEL B: Normal Login (hidden by default) -->
        <div id="normal-login-panel" style="display:none;" class="fade-in">
          <h2>Login Pengguna</h2>
          <p class="login-subtitle">Masukkan kredensial akun Anda.</p>

          <form action="/login" method="POST">
            <div class="login-field">
              <label for="username2">Username</label>
              <div class="login-input-group">
                <i class="bi bi-person login-input-icon"></i>
                <input type="text" id="username2" name="username" required placeholder="Masukkan username">
              </div>
            </div>
            <div class="login-field">
              <label for="password2">Password</label>
              <div class="login-input-group">
                <i class="bi bi-key login-input-icon"></i>
                <input type="password" id="password2" name="password" required placeholder="••••••••">
                <button type="button" class="login-toggle-pwd" onclick="togglePasswordVisibility('password2', this)" title="Tampilkan Password">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>
            <div class="login-remember">
              <input type="checkbox" id="remember2" name="remember">
              <label for="remember2">Simpan info login di browser ini</label>
            </div>
            <button type="submit" class="btn btn-primary login-submit-btn">
              <i class="bi bi-box-arrow-in-right"></i> Masuk ke Sistem
            </button>
          </form>

          <button onclick="switchToSavedAccount()" class="btn btn-secondary login-alt-btn" style="margin-top:8px;">
            <i class="bi bi-arrow-left"></i> Kembali ke Akun Tersimpan
          </button>
        </div>

      <% } else { %>

        <!-- PANEL C: Default Normal Login -->
        <div id="normal-login-panel">
          <h2>Login Pengguna</h2>
          <p class="login-subtitle">Masukkan username dan password Anda untuk masuk.</p>

          <form action="/login" method="POST">
            <div class="login-field">
              <label for="username">Username</label>
              <div class="login-input-group">
                <i class="bi bi-person login-input-icon"></i>
                <input type="text" id="username" name="username" required placeholder="Masukkan username" autofocus>
              </div>
            </div>
            <div class="login-field">
              <label for="password">Password</label>
              <div class="login-input-group">
                <i class="bi bi-key login-input-icon"></i>
                <input type="password" id="password" name="password" required placeholder="••••••••">
                <button type="button" class="login-toggle-pwd" onclick="togglePasswordVisibility('password', this)" title="Tampilkan Password">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>
            <div class="login-remember">
              <input type="checkbox" id="remember" name="remember">
              <label for="remember">Simpan info login di browser ini</label>
            </div>
            <button type="submit" class="btn btn-primary login-submit-btn">
              <i class="bi bi-box-arrow-in-right"></i> Masuk ke Sistem
            </button>
          </form>
        </div>

      <% } %>

      <a href="<%= (typeof navPrefix !== 'undefined' && navPrefix) ? navPrefix + '/' : '/' %>" class="login-back-link">
        <i class="bi bi-arrow-left"></i> Halaman Utama Dashboard
      </a>
    </div>

  </div>
</div>

<script>
  // Apply page-login class to html element (for zero-scroll viewport lock)
  document.documentElement.classList.add('page-login');

  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'bi bi-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'bi bi-eye';
    }
  }

  function switchToNormalForm() {
    document.getElementById('saved-account-panel').style.display = 'none';
    document.getElementById('normal-login-panel').style.display = 'block';
  }
  function switchToSavedAccount() {
    document.getElementById('normal-login-panel').style.display = 'none';
    document.getElementById('saved-account-panel').style.display = 'block';
  }
</script>
