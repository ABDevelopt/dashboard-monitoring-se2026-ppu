<style>
  .login-container-card {
    display: flex;
    flex-direction: row;
    border-radius: 16px;
    overflow: hidden;
    padding: 0 !important;
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }
  .login-logo-col {
    flex: 1;
    background: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    border-right: 1px solid var(--border);
    min-width: 260px;
  }
  .login-form-col {
    flex: 1.2;
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 320px;
  }
  @media (max-width: 680px) {
    .login-container-card {
      flex-direction: column !important;
    }
    .login-logo-col {
      padding: 30px !important;
      border-right: none !important;
      border-bottom: 1px solid var(--border) !important;
      min-width: 100% !important;
    }
    .login-form-col {
      padding: 30px 24px !important;
      min-width: 100% !important;
    }
  }
</style>

<div class="fade-in" style="max-width: 740px; margin: 60px auto; width: 90%;">
  <div class="card login-container-card">
    
    <!-- LEFT SIDE: LOGO COLUMN -->
    <div class="login-logo-col">
      <img src="/logo-vertical.png" alt="Logo SE2026" class="logo-light" loading="eager" style="width: 150px; object-fit: contain;">
      <img src="/logo-vertical-dark.png" alt="Logo SE2026" class="logo-dark" fetchpriority="high" loading="eager" style="width: 150px; object-fit: contain;">
      <div style="margin-top: 16px; text-align: center; color: var(--text-muted); font-size: 13px; font-weight: 600;">
        Monitoring SE2026 PPU
      </div>
    </div>
    
    <!-- RIGHT SIDE: FORM COLUMN -->
    <div class="login-form-col">
      <% if (typeof savedAccount !== 'undefined' && savedAccount) { %>
        
        <!-- PANEL A: Saved Account Card (Instagram style) -->
        <div id="saved-account-panel" class="fade-in">
          <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(45deg, #f97316, #ec4899, #8b5cf6); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; box-shadow: 0 4px 15px rgba(249, 115, 22, 0.25); border: 3px solid var(--border);">
            <span style="font-size: 28px; font-weight: 700; color: white; text-transform: uppercase;">
              <%= savedAccount.username.substring(0, 2) %>
            </span>
          </div>
          
          <h2 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; text-align: center;"><%= savedAccount.username %></h2>
          <p style="font-size: 12px; color: var(--text-muted); text-transform: capitalize; margin-bottom: 24px; text-align: center;"><i class="bi bi-shield-check"></i> <%= savedAccount.role %></p>
          
          <form action="/login/token" method="POST">
            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; font-size: 14px; font-weight: 600; margin-bottom: 12px;">
              <i class="bi bi-unlock-fill"></i> Masuk sebagai <%= savedAccount.username %>
            </button>
          </form>

          <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px; align-items: center;">
            <button onclick="switchToNormalForm()" class="btn btn-secondary" style="width: 100%; justify-content: center; padding: 10px; font-size: 13px;">
              <i class="bi bi-people"></i> Gunakan Akun Lain
            </button>
            
            <a href="/login/clear-saved" style="font-size: 12px; color: var(--accent-red); text-decoration: none; font-weight: 500; transition: opacity 0.2s; margin-top: 8px;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">
              <i class="bi bi-trash3"></i> Hapus Info Login dari Browser Ini
            </a>
          </div>
        </div>

        <!-- PANEL B: Normal Login Form (hidden by default) -->
        <div id="normal-login-panel" style="display: none;" class="fade-in">
          <h2 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-align: center;">Login Pengguna</h2>
          <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 24px; text-align: center;">Masukkan username dan password Anda.</p>

          <form action="/login" method="POST">
            <div style="margin-bottom: 16px; text-align: left;">
              <label for="username" style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Username</label>
              <input type="text" id="username" name="username" required style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 14px; background: var(--bg-body); color: var(--text-primary);" placeholder="Masukkan username">
            </div>
            <div style="margin-bottom: 16px; text-align: left;">
              <label for="password" style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Password</label>
              <input type="password" id="password" name="password" required style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 14px; background: var(--bg-body); color: var(--text-primary);" placeholder="••••••••">
            </div>
            
            <div style="margin-bottom: 24px; display: flex; align-items: center; text-align: left; gap: 8px;">
              <input type="checkbox" id="remember" name="remember" style="width: 16px; height: 16px; accent-color: var(--accent-blue); cursor: pointer;">
              <label for="remember" style="font-size: 13px; color: var(--text-secondary); cursor: pointer; user-select: none;">Simpan info login di browser ini</label>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; font-size: 14px; margin-bottom: 16px;"><i class="bi bi-box-arrow-in-right"></i> Masuk ke Sistem</button>
          </form>

          <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px;">
            <button onclick="switchToSavedAccount()" class="btn btn-secondary" style="width: 100%; justify-content: center; padding: 10px; font-size: 13px;">
              <i class="bi bi-arrow-left"></i> Kembali ke Akun Tersimpan
            </button>
          </div>
        </div>

      <% } else { %>
        
        <!-- PANEL C: Default Normal Login Form -->
        <div id="normal-login-panel">
          <h2 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; text-align: center;">Login Pengguna</h2>
          <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 24px; text-align: center;">Masukkan username dan password Anda untuk masuk.</p>

          <form action="/login" method="POST">
            <div style="margin-bottom: 16px; text-align: left;">
              <label for="username" style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Username</label>
              <input type="text" id="username" name="username" required style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 14px; background: var(--bg-body); color: var(--text-primary);" placeholder="Masukkan username">
            </div>
            <div style="margin-bottom: 16px; text-align: left;">
              <label for="password" style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Password</label>
              <input type="password" id="password" name="password" required style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 14px; background: var(--bg-body); color: var(--text-primary);" placeholder="••••••••">
            </div>

            <div style="margin-bottom: 24px; display: flex; align-items: center; text-align: left; gap: 8px;">
              <input type="checkbox" id="remember" name="remember" style="width: 16px; height: 16px; accent-color: var(--accent-blue); cursor: pointer;">
              <label for="remember" style="font-size: 13px; color: var(--text-secondary); cursor: pointer; user-select: none;">Simpan info login di browser ini</label>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; font-size: 14px;"><i class="bi bi-box-arrow-in-right"></i> Masuk ke Sistem</button>
          </form>
        </div>

      <% } %>
      
      <div style="margin-top: 24px; text-align: center;">
        <a href="/" style="font-size: 13px; color: var(--text-muted); text-decoration: none;"><i class="bi bi-arrow-left"></i> Kembali ke Halaman Publik</a>
      </div>
    </div>
    
  </div>
</div>

<script>
  function switchToNormalForm() {
    document.getElementById('saved-account-panel').style.display = 'none';
    document.getElementById('normal-login-panel').style.display = 'block';
  }
  function switchToSavedAccount() {
    document.getElementById('normal-login-panel').style.display = 'none';
    document.getElementById('saved-account-panel').style.display = 'block';
  }
</script>
