<div class="fade-in agent-table-page" style="padding-bottom: 40px;">
  <style>
    /* Scoped styles for AI Data Table Explorer */
    .agent-table-page {
      max-width: 100%;
      margin: 0 auto;
      color: var(--text-primary);
    }
    .at-header-banner {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px 20px;
      margin-bottom: 20px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    }
    .at-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }
    .at-search-box {
      position: relative;
      flex: 1;
      min-width: 240px;
      max-width: 450px;
    }
    .at-search-box input {
      width: 100%;
      padding: 8px 12px 8px 34px;
      font-size: 13px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-subtle);
      color: var(--text-primary);
      outline: none;
      transition: all 0.2s;
    }
    .at-search-box input:focus {
      border-color: #3b82f6;
      background: var(--bg-card);
      box-shadow: 0 0 0 3px rgba(59,130,246,0.2);
    }
    .at-search-box i {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 13px;
    }
    .at-select {
      padding: 6px 10px;
      font-size: 12px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--bg-subtle);
      color: var(--text-primary);
      outline: none;
    }
    .at-select:focus {
      border-color: #3b82f6;
    }
    .at-actions-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }
    .at-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      font-size: 12.5px;
      font-weight: 600;
      border-radius: 8px;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.15s ease-in-out;
    }
    .at-btn-primary {
      background: #2563eb;
      color: #ffffff;
      border-color: #2563eb;
    }
    .at-btn-primary:hover {
      background: #1d4ed8;
      color: #ffffff;
    }
    .at-btn-success {
      background: #10b981;
      color: #ffffff;
      border-color: #10b981;
    }
    .at-btn-success:hover {
      background: #059669;
      color: #ffffff;
    }
    .at-btn-outline {
      background: var(--bg-card);
      color: var(--text-primary);
      border-color: var(--border);
    }
    .at-btn-outline:hover {
      background: var(--bg-subtle);
      border-color: var(--text-muted);
      color: var(--text-primary);
    }
    .at-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.12);
      overflow: hidden;
    }
    .at-table-container {
      width: 100%;
      overflow-x: auto;
      max-height: 680px;
    }
    .at-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }
    .at-table th {
      background: var(--bg-subtle);
      color: var(--text-secondary);
      font-weight: 700;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 10;
      user-select: none;
    }
    .at-table th.sortable {
      cursor: pointer;
    }
    .at-table th.sortable:hover {
      background: rgba(59,130,246,0.12);
      color: var(--text-primary);
    }
    .at-table td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      color: var(--text-primary);
      white-space: nowrap;
    }
    .at-table tr:hover td {
      background: rgba(255,255,255,0.04);
    }
    body.light-mode .at-table tr:hover td {
      background: rgba(0,0,0,0.03);
    }
    .at-badge {
      display: inline-block;
      padding: 2px 8px;
      font-size: 11px;
      font-weight: 600;
      border-radius: 12px;
    }
    .at-badge-blue { background: rgba(59,130,246,0.18); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); }
    .at-badge-green { background: rgba(34,197,94,0.18); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
    .at-badge-orange { background: rgba(249,115,22,0.18); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
    .at-badge-purple { background: rgba(168,85,247,0.18); color: #c084fc; border: 1px solid rgba(168,85,247,0.3); }
    .at-badge-gray { background: rgba(148,163,184,0.18); color: #cbd5e1; border: 1px solid rgba(148,163,184,0.3); }
    
    body.light-mode .at-badge-blue { background: rgba(37,99,235,0.12); color: #2563eb; border: 1px solid rgba(37,99,235,0.25); }
    body.light-mode .at-badge-green { background: rgba(16,185,129,0.12); color: #059669; border: 1px solid rgba(16,185,129,0.25); }
    body.light-mode .at-badge-orange { background: rgba(234,88,12,0.12); color: #c2410c; border: 1px solid rgba(234,88,12,0.25); }
    body.light-mode .at-badge-purple { background: rgba(147,51,234,0.12); color: #7e22ce; border: 1px solid rgba(147,51,234,0.25); }
    body.light-mode .at-badge-gray { background: rgba(100,116,139,0.12); color: #475569; border: 1px solid rgba(100,116,139,0.25); }
    
    .at-pagination-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 18px;
      background: var(--bg-subtle);
      border-top: 1px solid var(--border);
      font-size: 12.5px;
      color: var(--text-muted);
    }
    .at-pagination-btns {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .at-page-btn {
      min-width: 32px;
      height: 32px;
      padding: 0 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg-card);
      color: var(--text-primary);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s;
    }
    .at-page-btn:hover:not(.disabled):not(.active) {
      background: var(--bg-subtle);
      border-color: var(--text-muted);
    }
    .at-page-btn.active {
      background: #2563eb;
      color: #ffffff;
      border-color: #2563eb;
    }
    .at-page-btn.disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    
    /* Modal dialog */
    .at-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.65);
      backdrop-filter: blur(3px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 16px;
    }
    .at-modal-backdrop.hidden {
      display: none;
    }
    .at-modal {
      background: var(--bg-card);
      border-radius: 12px;
      max-width: 750px;
      width: 100%;
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
      overflow: hidden;
      border: 1px solid var(--border);
      color: var(--text-primary);
    }
    .at-modal-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .at-modal-body {
      padding: 20px;
      max-height: 480px;
      overflow-y: auto;
    }
    .at-modal-footer {
      padding: 12px 20px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: flex-end;
      background: var(--bg-subtle);
    }
    .at-sql-box {
      background: var(--bg-primary, #0f172a);
      color: var(--text-primary, #f8fafc);
      border: 1px solid var(--border);
      padding: 14px;
      border-radius: 8px;
      font-size: 12px;
      line-height: 1.5;
      overflow-x: auto;
      margin: 0;
      font-family: monospace;
    }
    .at-analysis-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent-blue, #2563eb);
      border-radius: 12px;
      margin-bottom: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .at-analysis-body p { margin-bottom: 8px; }
    .at-analysis-body p:last-child { margin-bottom: 0; }
    .at-analysis-body ul, .at-analysis-body ol { margin: 6px 0 10px 20px; padding: 0; }
    .at-analysis-body li { margin-bottom: 4px; }
    .at-analysis-body h3, .at-analysis-body h4 { font-size: 14px; font-weight: 700; margin: 12px 0 6px 0; color: var(--text-primary); }
    .at-analysis-body strong { color: var(--text-primary); font-weight: 700; }
    .at-analysis-body blockquote { border-left: 3px solid var(--accent-blue, #2563eb); margin: 6px 0; padding: 4px 10px; color: var(--text-muted); background: var(--bg-subtle, rgba(0,0,0,0.02)); border-radius: 0 4px 4px 0; }
    .at-analysis-body a { color: var(--accent-blue, #2563eb); text-decoration: none; font-weight: 500; }
    .at-analysis-body a:hover { text-decoration: underline; }
  </style>

  <!-- ── UNIFIED COMPACT HEADER BANNER ── -->
  <div class="at-header-banner" style="padding: 14px 18px; margin-bottom: 16px;">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px;">
      <div style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 260px;">
        <a href="<%= typeof navPrefix !== 'undefined' ? navPrefix : '' %>/agent" class="at-btn at-btn-outline" style="border-radius: 20px; padding: 5px 12px; font-size: 12px;" title="Kembali ke AI Chat">
          <i class="bi bi-arrow-left"></i> Kembali ke AI Chat
        </a>
        <h1 style="font-size: 15.5px; font-weight: 700; color: var(--text-primary); margin: 0; line-height: 1.35;">
          &ldquo;<%= query.prompt || 'Eksplorasi Data Tabel AI' %>&rdquo;
        </h1>
      </div>

      <div class="at-actions-group">
        <a href="<%= typeof navPrefix !== 'undefined' ? navPrefix : '' %>/agent/export-query/<%= queryId %>?format=xlsx" class="at-btn at-btn-success" style="padding: 6px 12px; font-size: 12px;" title="Download Excel (.xlsx)">
          <i class="bi bi-file-earmark-excel-fill"></i> Export Excel
        </a>
        <a href="<%= typeof navPrefix !== 'undefined' ? navPrefix : '' %>/agent/export-query/<%= queryId %>?format=csv" class="at-btn at-btn-outline" style="padding: 6px 12px; font-size: 12px;" title="Download CSV">
          <i class="bi bi-filetype-csv"></i> Export CSV
        </a>
        <button type="button" class="at-btn at-btn-outline" style="padding: 6px 12px; font-size: 12px;" onclick="document.getElementById('sqlModal').classList.remove('hidden')">
          <i class="bi bi-code-slash"></i> SQL Query
        </button>
      </div>
    </div>

    <!-- Sub-baris Metadata Ringkas -->
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; font-size: 12px; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 9px;">
      <span class="at-badge at-badge-purple" style="font-size: 11px;"><i class="bi bi-robot"></i> <%= query.tool_name || 'query_data' %></span>
      <span><strong>Total:</strong> <span class="at-badge at-badge-green" id="totalRowsBadge" style="font-size: 11px;"><%= rows.length %> baris</span></span>
      <% if (typeof latestUpload !== 'undefined' && latestUpload) { %>
        <span><strong>Data Update:</strong> <%= latestUpload.tanggal %> (Upload ID: <%= latestUpload.id %>)</span>
      <% } %>
      <% if (query.created_at) { %>
        <span><i class="bi bi-clock"></i> <%= new Date(query.created_at).toLocaleString('id-ID') %></span>
      <% } %>
    </div>
  </div>

  <% if (query.analysis_text && query.analysis_text.trim()) { %>
    <!-- ── AI ANALYSIS & CONTEXT CARD ── -->
    <div class="at-analysis-card">
      <div style="padding: 11px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 8px; background: var(--bg-subtle);">
        <div style="font-weight: 700; font-size: 13px; color: var(--text-primary); display: flex; align-items: center; gap: 7px;">
          <i class="bi bi-robot" style="color: var(--accent-blue, #2563eb);"></i>
          <span>Konteks &amp; Analisis Asisten AI</span>
        </div>
        <button type="button" id="atCopyAnalysisBtn" class="at-btn at-btn-outline" style="padding: 3px 10px; font-size: 11px;">
          <i class="bi bi-clipboard"></i> Salin Analisis
        </button>
      </div>
      <div id="atAnalysisContent" class="at-analysis-body" style="padding: 14px 18px; font-size: 13px; line-height: 1.6; color: var(--text-primary);">
        <!-- Rendered by JavaScript -->
      </div>
    </div>
  <% } %>

  <!-- ── TABLE CONTROLS & DATA TABLE ── -->
  <div class="at-card">
    <div style="padding: 14px 18px; border-bottom: 1px solid var(--border);">
      <div class="at-toolbar" style="margin-bottom: 0;">
        <div class="at-search-box">
          <i class="bi bi-search"></i>
          <input type="text" id="atSearchInput" placeholder="Cari di seluruh kolom data..." autocomplete="off">
        </div>

        <div class="at-actions-group">
          <div style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-muted);">
            <span>Tampilkan:</span>
            <select id="atPageSizeSelect" class="at-select">
              <option value="10">10 baris</option>
              <option value="25" selected>25 baris</option>
              <option value="50">50 baris</option>
              <option value="100">100 baris</option>
              <option value="all">Semua</option>
            </select>
          </div>
          <button id="atCopyBtn" class="at-btn at-btn-outline" style="padding: 6px 12px;">
            <i class="bi bi-clipboard"></i> Salin Tabel
          </button>
        </div>
      </div>
    </div>

    <div class="at-table-container">
      <% if (!rows || rows.length === 0) { %>
        <div style="padding: 50px 20px; text-align: center; color: var(--text-muted);">
          <i class="bi bi-inbox" style="font-size: 36px; display: block; margin-bottom: 8px; opacity: 0.5;"></i>
          Tidak ada data yang tersedia untuk kueri ini.
        </div>
      <% } else { %>
        <% const columns = Object.keys(rows[0]); %>
        <table class="at-table" id="atMainTable">
          <thead>
            <tr>
              <th style="width: 48px; text-align: center;">No</th>
              <% columns.forEach(col => { %>
                <th class="sortable" data-col="<%= col %>">
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                    <span><%= col.replace(/_/g, ' ') %></span>
                    <span class="sort-icon" style="font-size: 11px; opacity: 0.5;"><i class="bi bi-arrow-down-up"></i></span>
                  </div>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody id="atTableBody">
            <!-- Rendered by client script -->
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="at-pagination-bar">
      <div id="atPaginationInfo">Menampilkan data...</div>
      <div class="at-pagination-btns" id="atPaginationBtns"></div>
    </div>
  </div>
</div>

<!-- ── SQL QUERY MODAL ── -->
<div id="sqlModal" class="at-modal-backdrop hidden" onclick="if(event.target === this) this.classList.add('hidden')">
  <div class="at-modal">
    <div class="at-modal-header">
      <div style="font-weight: 700; font-size: 15px; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
        <i class="bi bi-database-check" style="color: var(--accent-blue, #2563eb);"></i> SQL Query Rekap Data
      </div>
      <button type="button" class="at-btn at-btn-outline" style="padding: 2px 8px;" onclick="document.getElementById('sqlModal').classList.add('hidden')">&times;</button>
    </div>
    <div class="at-modal-body">
      <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">Kueri SQL yang dieksekusi secara aman (Read-Only) pada database SQLite:</div>
      <pre class="at-sql-box"><code><%= query.query_sql || '-- Query tidak tersedia' %></code></pre>
      <% if (query.query_params && query.query_params !== '{}') { %>
        <div style="margin-top: 12px;">
          <div style="font-size: 12px; font-weight: 600; margin-bottom: 4px; color: var(--text-primary);">Parameter Binding:</div>
          <pre class="at-sql-box" style="padding: 8px 12px; font-size: 11.5px;"><code><%= query.query_params %></code></pre>
        </div>
      <% } %>
    </div>
    <div class="at-modal-footer">
      <button type="button" class="at-btn at-btn-primary" onclick="document.getElementById('sqlModal').classList.add('hidden')">Tutup</button>
    </div>
  </div>
</div>

<!-- ── CLIENT SCRIPT FOR DYNAMIC DATA TABLE ── -->
<script>
  (function() {
    var rawData = <%- JSON.stringify(rows || []) %>;
    var columns = rawData.length > 0 ? Object.keys(rawData[0]) : [];

    var filteredData = rawData.slice();
    var sortColumn = null;
    var sortAsc = true;
    var currentPage = 1;
    var pageSize = 25;

    var searchInput = document.getElementById('atSearchInput');
    var pageSizeSelect = document.getElementById('atPageSizeSelect');
    var tbody = document.getElementById('atTableBody');
    var paginationInfo = document.getElementById('atPaginationInfo');
    var paginationBtns = document.getElementById('atPaginationBtns');
    var copyBtn = document.getElementById('atCopyBtn');

    function isNumeric(val) {
      if (typeof val === 'number') return true;
      if (typeof val !== 'string') return false;
      return !isNaN(val) && !isNaN(parseFloat(val));
    }

    function formatCell(key, val) {
      if (val === null || val === undefined) return '<span style="color: #94a3b8;">-</span>';
      
      var lowerKey = key.toLowerCase();
      if (typeof val === 'number') {
        if (lowerKey.includes('pct') || lowerKey.includes('persen') || lowerKey.includes('percent')) {
          var badgeClass = val >= 100 ? 'at-badge-green' : (val >= 70 ? 'at-badge-blue' : (val >= 40 ? 'at-badge-orange' : 'at-badge-orange'));
          return '<span class="at-badge ' + badgeClass + '">' + val.toLocaleString('id-ID') + '%</span>';
        }
        return val.toLocaleString('id-ID');
      }

      if (typeof val === 'string' && (val.endsWith('%') || (!isNaN(parseFloat(val)) && lowerKey.includes('persen')))) {
        var num = parseFloat(val);
        var badgeClass2 = num >= 100 ? 'at-badge-green' : (num >= 70 ? 'at-badge-blue' : (num >= 40 ? 'at-badge-orange' : 'at-badge-orange'));
        return '<span class="at-badge ' + badgeClass2 + '">' + val + '</span>';
      }

      return escapeHtml(String(val));
    }

    function escapeHtml(str) {
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function applyFilter() {
      var q = (searchInput && searchInput.value ? searchInput.value : '').toLowerCase().trim();
      if (!q) {
        filteredData = rawData.slice();
      } else {
        filteredData = rawData.filter(function(row) {
          return columns.some(function(col) {
            var val = row[col];
            return val !== null && val !== undefined && String(val).toLowerCase().includes(q);
          });
        });
      }
      currentPage = 1;
      applySortAndRender();
    }

    function applySortAndRender() {
      if (sortColumn) {
        filteredData.sort(function(a, b) {
          var valA = a[sortColumn];
          var valB = b[sortColumn];

          if (valA === null || valA === undefined) return 1;
          if (valB === null || valB === undefined) return -1;

          if (isNumeric(valA) && isNumeric(valB)) {
            valA = Number(valA);
            valB = Number(valB);
          } else {
            valA = String(valA).toLowerCase();
            valB = String(valB).toLowerCase();
          }

          if (valA < valB) return sortAsc ? -1 : 1;
          if (valA > valB) return sortAsc ? 1 : -1;
          return 0;
        });
      }

      renderTable();
    }

    function renderTable() {
      if (!tbody) return;

      var total = filteredData.length;
      var effectivePageSize = pageSize === 'all' ? total : parseInt(pageSize, 10);
      var totalPages = Math.ceil(total / effectivePageSize) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      var startIdx = (currentPage - 1) * effectivePageSize;
      var endIdx = pageSize === 'all' ? total : Math.min(startIdx + effectivePageSize, total);
      var pageRows = filteredData.slice(startIdx, endIdx);

      if (pageRows.length === 0) {
        tbody.innerHTML = '<tr><td colspan="' + (columns.length + 1) + '" style="text-align: center; padding: 30px; color: var(--text-muted, #64748b);">Tidak ada baris data yang cocok dengan filter pencarian.</td></tr>';
      } else {
        tbody.innerHTML = pageRows.map(function(row, idx) {
          var rowNum = startIdx + idx + 1;
          var cells = columns.map(function(col) {
            var val = row[col];
            var isNum = typeof val === 'number' || (isNumeric(val) && !col.toLowerCase().includes('kode') && !col.toLowerCase().includes('id') && !col.toLowerCase().includes('telepon') && !col.toLowerCase().includes('phone'));
            var alignStyle = isNum ? 'text-align: right;' : 'text-align: left;';
            return '<td style="' + alignStyle + '">' + formatCell(col, val) + '</td>';
          }).join('');
          return '<tr><td style="text-align: center; color: var(--text-muted, #94a3b8); font-size: 11.5px;">' + rowNum + '</td>' + cells + '</tr>';
        }).join('');
      }

      // Update Pagination Info
      if (paginationInfo) {
        if (total === 0) {
          paginationInfo.textContent = 'Menampilkan 0 data';
        } else {
          paginationInfo.textContent = 'Menampilkan ' + (startIdx + 1) + ' - ' + endIdx + ' dari total ' + total + ' data';
        }
      }

      renderPagination(totalPages);
    }

    function renderPagination(totalPages) {
      if (!paginationBtns) return;
      if (totalPages <= 1) {
        paginationBtns.innerHTML = '';
        return;
      }

      var html = '';
      html += '<button type="button" class="at-page-btn ' + (currentPage === 1 ? 'disabled' : '') + '" data-page="' + (currentPage - 1) + '">&laquo;</button>';

      var maxBtns = 5;
      var startPage = Math.max(1, currentPage - 2);
      var endPage = Math.min(totalPages, startPage + maxBtns - 1);

      if (endPage - startPage < maxBtns - 1) {
        startPage = Math.max(1, endPage - maxBtns + 1);
      }

      for (var p = startPage; p <= endPage; p++) {
        html += '<button type="button" class="at-page-btn ' + (p === currentPage ? 'active' : '') + '" data-page="' + p + '">' + p + '</button>';
      }

      html += '<button type="button" class="at-page-btn ' + (currentPage === totalPages ? 'disabled' : '') + '" data-page="' + (currentPage + 1) + '">&raquo;</button>';

      paginationBtns.innerHTML = html;
    }

    // Event Listeners
    if (searchInput) {
      searchInput.addEventListener('input', function() { applyFilter(); });
    }

    if (pageSizeSelect) {
      pageSizeSelect.addEventListener('change', function(e) {
        pageSize = e.target.value;
        currentPage = 1;
        renderTable();
      });
    }

    if (paginationBtns) {
      paginationBtns.addEventListener('click', function(e) {
        var btn = e.target.closest('.at-page-btn');
        if (!btn || btn.classList.contains('disabled') || btn.classList.contains('active')) return;
        var page = parseInt(btn.getAttribute('data-page'), 10);
        if (page && page !== currentPage) {
          currentPage = page;
          renderTable();
          var tableEl = document.getElementById('atMainTable');
          if (tableEl) {
            window.scrollTo({ top: tableEl.offsetTop - 80, behavior: 'smooth' });
          }
        }
      });
    }

    // Sort column headers
    document.querySelectorAll('.at-table th.sortable').forEach(function(th) {
      th.addEventListener('click', function() {
        var col = th.getAttribute('data-col');
        if (sortColumn === col) {
          sortAsc = !sortAsc;
        } else {
          sortColumn = col;
          sortAsc = true;
        }

        document.querySelectorAll('.at-table th.sortable .sort-icon').forEach(function(icon) {
          icon.innerHTML = '<i class="bi bi-arrow-down-up"></i>';
          icon.style.opacity = '0.5';
        });

        var currentIcon = th.querySelector('.sort-icon');
        if (currentIcon) {
          currentIcon.innerHTML = sortAsc ? '<i class="bi bi-arrow-up" style="color: #2563eb;"></i>' : '<i class="bi bi-arrow-down" style="color: #2563eb;"></i>';
          currentIcon.style.opacity = '1';
        }

        applySortAndRender();
      });
    });

    // Copy Table to Clipboard
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        if (!filteredData || filteredData.length === 0) return;
        var headers = columns.join('\t');
        var rowsText = filteredData.map(function(r) { return columns.map(function(c) { return r[c] !== null && r[c] !== undefined ? r[c] : ''; }).join('\t'); }).join('\n');
        var fullText = headers + '\n' + rowsText;

        navigator.clipboard.writeText(fullText).then(function() {
          var orig = copyBtn.innerHTML;
          copyBtn.innerHTML = '<i class="bi bi-check-lg" style="color: #10b981;"></i> Tersalin!';
          setTimeout(function() { copyBtn.innerHTML = orig; }, 2000);
        });
      });
    }

    // ── RENDER AI ANALYSIS & CONTEXT ──
    function formatInlineMarkdown(text) {
      if (!text) return '';
      return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/(\*\*|__)(.*?)\1/g, '<strong>$2</strong>')
        .replace(/(\*|_)(.*?)\1/g, '<em>$2</em>')
        .replace(/`([^`]+)`/g, '<code style="background:var(--bg-subtle);padding:2px 4px;border-radius:4px;font-size:90%;">$1</code>')
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
    }

    function renderMarkdownAnalysis(text) {
      if (!text) return '';
      // Remove raw markdown tables from analysis text if any to avoid redundancy with the interactive data table
      var cleaned = text.replace(/^\s*\|.+\|\s*$/gm, '');
      var lines = cleaned.split(/\r?\n/);
      var html = [];
      var inList = false;
      var listType = 'ul';

      for (var i = 0; i < lines.length; i++) {
        var line = lines[i].trim();
        if (!line) {
          if (inList) { html.push('</' + listType + '>'); inList = false; }
          continue;
        }

        // Headers
        if (/^###\s+(.+)$/.test(line)) {
          if (inList) { html.push('</' + listType + '>'); inList = false; }
          html.push('<h4>' + formatInlineMarkdown(line.replace(/^###\s+/, '')) + '</h4>');
          continue;
        }
        if (/^##\s+(.+)$/.test(line)) {
          if (inList) { html.push('</' + listType + '>'); inList = false; }
          html.push('<h3>' + formatInlineMarkdown(line.replace(/^##\s+/, '')) + '</h3>');
          continue;
        }

        // Bullet lists
        if (/^[-*•]\s+(.+)$/.test(line)) {
          if (!inList || listType !== 'ul') {
            if (inList) html.push('</' + listType + '>');
            html.push('<ul>');
            inList = true;
            listType = 'ul';
          }
          html.push('<li>' + formatInlineMarkdown(line.replace(/^[-*•]\s+/, '')) + '</li>');
          continue;
        }

        // Numbered lists
        if (/^\d+\.\s+(.+)$/.test(line)) {
          if (!inList || listType !== 'ol') {
            if (inList) html.push('</' + listType + '>');
            html.push('<ol>');
            inList = true;
            listType = 'ol';
          }
          html.push('<li>' + formatInlineMarkdown(line.replace(/^\d+\.\s+/, '')) + '</li>');
          continue;
        }

        if (inList) { html.push('</' + listType + '>'); inList = false; }
        html.push('<p>' + formatInlineMarkdown(line) + '</p>');
      }

      if (inList) { html.push('</' + listType + '>'); }
      return html.join('');
    }

    var rawAnalysis = <%- JSON.stringify(query.analysis_text || '') %>;
    var analysisEl = document.getElementById('atAnalysisContent');
    if (analysisEl && rawAnalysis) {
      analysisEl.innerHTML = renderMarkdownAnalysis(rawAnalysis);
    }

    var copyAnalysisBtn = document.getElementById('atCopyAnalysisBtn');
    if (copyAnalysisBtn && rawAnalysis) {
      copyAnalysisBtn.addEventListener('click', function() {
        navigator.clipboard.writeText(rawAnalysis).then(function() {
          var orig = copyAnalysisBtn.innerHTML;
          copyAnalysisBtn.innerHTML = '<i class="bi bi-check-lg" style="color: #10b981;"></i> Tersalin!';
          setTimeout(function() { copyAnalysisBtn.innerHTML = orig; }, 2000);
        });
      });
    }

    // Initial render
    renderTable();
  })();
</script>
