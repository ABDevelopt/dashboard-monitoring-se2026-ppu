    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 110px;
    pointer-events: none;
  }

  .hero-content-layer * {
    pointer-events: auto;
  }

  /* Clean Static Sculptural Headline */
  .hero-portal-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 6.5vw, 72px);
    font-weight: 900;
    letter-spacing: 0.08em;
