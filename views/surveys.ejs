      0 1px 4px rgba(0, 0, 0, 0.8);
    -webkit-text-stroke: 0.5px rgba(249, 115, 22, 0.25);
  }

  html.light-mode .hero-portal-title {
    text-shadow:
      0 0 30px rgba(249, 115, 22, 0.3),
