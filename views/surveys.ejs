            <i class="bi bi-search"></i>
          </div>
          <input
            type="text"
            id="surveySearchInput"
            placeholder="Cari kegiatan sensus atau survei BPS..."
            oninput="handleSearch(this.value)"
            autocomplete="off"
            aria-label="Cari kegiatan sensus atau survei"
          >
          <div class="portal-search-actions">
            <button
              type="button"
              id="surveySearchClear"
              class="portal-search-clear-btn"
              onclick="clearSurveySearch()"
              title="Hapus kata kunci pencarian"
              aria-label="Hapus kata kunci pencarian"
              style="display: none;"
            >
              <i class="bi bi-x-circle-fill"></i>
            </button>
            <kbd class="portal-search-kbd" title="Tekan '/' untuk mencari">/</kbd>
          </div>
        </div>

        <div class="portal-toolbar-actions">
          <button type="button" id="btnSyncCatalog" onclick="triggerCatalogSync()" class="btn-sync-catalog" title="Tarik kegiatan baru dari FASIH-SM Cloud dan generate dasbor otomatis">
            <i class="bi bi-cloud-arrow-down-fill"></i>
            <span id="lblSyncCatalog">Sinkron Katalog</span>
          </button>
          <button type="button" id="btnSyncAllProgress" onclick="triggerAllProgressSync()" class="btn-sync-catalog btn-sync-all-progress" title="Tarik pembaruan progres seluruh kegiatan dari FASIH-SM Cloud via API">
            <i class="bi bi-arrow-repeat"></i>
            <span id="lblSyncAllProgress">Tarik Semua Progres</span>
          </button>
        </div>
      </div>

      <!-- Baris 2: Filter Kategori, Status Jumlah Hasil, Sort & Mode Tampilan -->
      <div class="portal-toolbar-row-bottom">
        <div class="portal-filter-tabs" role="tablist">
          <button type="button" class="portal-filter-tab active" data-filter="" onclick="filterCategory(this, '')">
            <i class="bi bi-grid-fill"></i>
            <span>Semua Kegiatan</span>
            <span class="tab-count" id="countAll"><%= (typeof categoryCounts !== 'undefined' && categoryCounts.all) ? categoryCounts.all : _list.length %></span>
          </button>
          <button type="button" class="portal-filter-tab" data-filter="pencacahan" onclick="filterCategory(this, 'pencacahan')">
            <i class="bi bi-clipboard-data-fill" style="color: #06b6d4;"></i>
            <span>Pencacahan</span>
            <span class="tab-count" id="countPencacahan"><%= (typeof categoryCounts !== 'undefined' && categoryCounts.pencacahan) ? categoryCounts.pencacahan : 0 %></span>
          </button>
          <button type="button" class="portal-filter-tab" data-filter="pelatihan" onclick="filterCategory(this, 'pelatihan')">
            <i class="bi bi-mortarboard-fill" style="color: #10b981;"></i>
            <span>Pelatihan</span>
            <span class="tab-count" id="countPelatihan"><%= (typeof categoryCounts !== 'undefined' && categoryCounts.pelatihan) ? categoryCounts.pelatihan : 0 %></span>
          </button>
          <button type="button" class="portal-filter-tab" data-filter="ujicoba" onclick="filterCategory(this, 'ujicoba')">
            <i class="bi bi-cpu-fill" style="color: #6366f1;"></i>
            <span>Ujicoba</span>
            <span class="tab-count" id="countUjicoba"><%= (typeof categoryCounts !== 'undefined' && categoryCounts.ujicoba) ? categoryCounts.ujicoba : 0 %></span>
          </button>
          <button type="button" class="portal-filter-tab" data-filter="sensus" onclick="filterCategory(this, 'sensus')">
            <i class="bi bi-globe2" style="color: #f97316;"></i>
            <span>Sensus</span>
            <span class="tab-count" id="countSensus"><%= (typeof categoryCounts !== 'undefined' && categoryCounts.sensus) ? categoryCounts.sensus : 0 %></span>
          </button>
        </div>

        <div class="portal-toolbar-right">
          <span id="searchResultCount" class="portal-result-count">
            Menampilkan <%= _list.length %> kegiatan
          </span>

          <!-- Kontrol Pengurutan / Sort -->
          <div class="portal-sort-wrap" title="Urutkan daftar kegiatan">
            <i class="bi bi-arrow-down-up portal-sort-icon"></i>
            <select id="surveySortSelect" class="portal-sort-select" onchange="handleSortChange(this.value)" aria-label="Urutkan kegiatan">
              <option value="default">Urutan Bawaan</option>
              <option value="progress-desc">Progres Tertinggi</option>
              <option value="progress-asc">Progres Terendah</option>
              <option value="name-asc">Nama (A - Z)</option>
              <option value="name-desc">Nama (Z - A)</option>
              <option value="target-desc">Target Terbanyak</option>
              <option value="realisasi-desc">Realisasi Terbanyak</option>
            </select>
          </div>

          <!-- Pilihan Tampilan Grid / List / Timeline -->
          <div class="portal-view-toggle" role="group" aria-label="Mode Tampilan">
            <button type="button" class="btn-portal-view active" id="btnViewGrid" onclick="setPortalViewMode('grid')" title="Tampilan Kartu / Grid">
              <i class="bi bi-grid-fill"></i>
            </button>
            <button type="button" class="btn-portal-view" id="btnViewList" onclick="setPortalViewMode('list')" title="Tampilan Daftar / List">
              <i class="bi bi-view-list"></i>
            </button>
            <button type="button" class="btn-portal-view" id="btnViewTimeline" onclick="setPortalViewMode('timeline')" title="Tampilan Kalender & Timeline Rentang Waktu">
              <i class="bi bi-calendar-range-fill"></i>
            </button>
          </div>
        </div>
      </div>
      </div>
    </section>

  <!-- ══════════════════════════════════════════════════════
       SURVEY CARDS GRID: PEMBEDAAN SENSUS VS SURVEI
       ══════════════════════════════════════════════════════ -->
  <main class="portal-cards-grid" id="portalCardsGrid">
    <% _list.forEach((s, index) => { %>
      <article
        class="survey-card theme-<%= s.theme %> card-category-<%= s.category || 'survei' %>"
        data-category="<%= s.category || 'survei' %>"
        data-name="<%= (s.name || '').toLowerCase() %>"
        data-shortname="<%= (s.shortName || '').toLowerCase() %>"
        data-tagline="<%= (s.tagline || '').toLowerCase() %>"
        data-persen="<%= s.persen || 0 %>"
        data-realisasi="<%= s.realisasi || 0 %>"
        data-target="<%= s.target || 0 %>"
        data-default-index="<%= index %>"
        style="border-top-color: <%= s.themeColor %>; --card-accent: <%= s.themeColor %>;"
      >
        <div class="survey-card-body">
          <!-- Corner Badge Pojok Kanan Mentok (Category Type) -->
          <span class="card-corner-badge badge-<%= s.category || 'survei' %>">
            <i class="bi <%= s.categoryIcon || (s.category === 'sensus' ? 'bi-globe2' : 'bi-pie-chart-fill') %>"></i>
            <%= s.categoryBadge || (s.category === 'sensus' ? 'Sensus' : 'Survei') %>
          </span>

          <div class="survey-title-group">
            <!-- Nama Survei / Sensus (Fokus Utama) -->
            <h2 class="survey-name"><%= s.name %></h2>
            <div class="survey-tagline">
              <%= s.tagline || (s.id === 'se2026' ? 'Cakupan 54 Desa/Kelurahan se-PPU &amp; IKN Nusantara' : (s.id === 'sakernas-pemutakhiran' ? 'Tahap 1: Pemutakhiran Muatan Blok Sensus' : 'Tahap 2: Pencacahan Sampel Rumahtangga (CAPI)')) %>
            </div>
          </div>

          <!-- Progress Ringkas -->
          <div class="survey-progress-box">
            <div class="progress-head">
              <span class="progress-label"><i class="bi bi-activity"></i> Progres Lapangan</span>
              <span class="persen-val" style="color: <%= s.themeColor %>;"><%= s.persen %>%</span>
            </div>
            <div class="progress-bar-track">
              <div class="progress-bar-fill" style="background: linear-gradient(90deg, <%= s.themeColor %>, <%= s.themeSecondary || '#facc15' %>); width: <%= Math.min(100, Math.max(0, s.persen)) %>%;"></div>
            </div>
            <div class="progress-foot">
              <span>Realisasi: <strong><%= s.realisasi.toLocaleString('id-ID') %></strong> <%= s.unitName %></span>
              <span>Target: <strong><%= s.target.toLocaleString('id-ID') %></strong></span>
            </div>
          </div>
        </div>

        <!-- Tombol Aksi Dasbor & Sinkron Cepat -->
        <div class="survey-card-actions" style="display: flex; gap: 8px; align-items: center;">
          <a
            href="<%= s.route %>"
            class="btn-open-dashboard btn-theme-<%= s.theme %>"
            style="flex: 1; min-width: 0; <%= s.themeGradient ? 'background: ' + s.themeGradient + ';' : '' %>"
            title="Buka Dasbor Monitoring <%= s.shortName %>"
          >
            <i class="bi bi-speedometer2"></i>
            <span>Buka Dasbor</span>
          </a>
          <button
            type="button"
            class="btn-quick-sync"
            id="syncBtn_<%= s.id %>"
            onclick="triggerCardProgressSync(event, '<%= s.id %>', '<%= (s.shortName || s.name || s.id).replace(/'/g, '') %>')"
            title="Tarik data progres mutakhir untuk <%= s.shortName %> dari Cloud API"
            aria-label="Tarik data progres <%= s.shortName %>"
            style="width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--card-inner-bg); border: 1px solid var(--card-inner-border); color: <%= s.themeColor %>; cursor: pointer; transition: all 0.2s ease; flex-shrink: 0;"
          >
            <i class="bi bi-cloud-arrow-down-fill" style="font-size: 16px;"></i>
          </button>
        </div>
      </article>
    <% }) %>

    <div id="emptySearchState" class="portal-empty-search" style="display: none;">
      <i class="bi bi-search" style="font-size: 32px; opacity: 0.5;"></i>
      <div style="font-weight: 700; font-size: 16px; margin-top: 10px; color: var(--card-val);">Tidak Ada Kegiatan Ditemukan</div>
      <div style="font-size: 13px; margin-top: 4px; color: var(--card-tagline);">Coba gunakan kata kunci lain atau pilih tab kategori berbeda.</div>
    </div>
  </main>

  <!-- ══════════════════════════════════════════════════════
       PORTAL TIMELINE VIEW: GANTT RANGE BAR CHART SEBARAN WAKTU BPS
       ══════════════════════════════════════════════════════ -->
  <section class="portal-timeline-view" id="portalTimelineView" style="display: none;" aria-label="Kalender & Timeline Rentang Waktu Sensus Survei BPS">
    <% if (typeof timelineData !== 'undefined' && timelineData && timelineData.items) { %>
      
      <!-- 1. Timeline Top Toolbar Strip -->
      <div class="tl-toolbar-strip">
        <div class="tl-controls-left">
          <!-- Filter Tahun -->
          <div class="tl-btn-group" role="group" aria-label="Pilih Tahun Jadwal">
            <button type="button" class="tl-btn-year active" id="tlYear2026" onclick="setTimelineYear(2026)">
              Tahun 2026 (<%= timelineData.summary.count2026 %>)
            </button>
            <button type="button" class="tl-btn-year" id="tlYear2025" onclick="setTimelineYear(2025)">
              Tahun 2025 (<%= timelineData.summary.count2025 %>)
            </button>
            <button type="button" class="tl-btn-year" id="tlYearAll" onclick="setTimelineYear('all')">
              Semua Tahun (<%= timelineData.summary.totalCount %>)
            </button>
          </div>

          <!-- Filter Status -->
          <select id="tlStatusFilter" class="tl-select" onchange="handleTimelineStatusFilter(this.value)" aria-label="Saring Status Pelaksanaan">
            <option value="all">Semua Status Pelaksanaan</option>
            <option value="aktif">Sedang Berjalan (Aktif)</option>
            <option value="selesai">Selesai / Terlaksana</option>
            <option value="akan_datang">Akan Datang</option>
          </select>
        </div>

        <!-- Legenda Kategori -->
        <div class="tl-legend-wrap">
          <span class="tl-legend-item"><span class="tl-legend-dot dot-sensus"></span> Sensus</span>
          <span class="tl-legend-item"><span class="tl-legend-dot dot-survei"></span> Survei</span>
          <span class="tl-legend-item"><span class="tl-legend-dot dot-pelatihan"></span> Pelatihan</span>
          <span class="tl-legend-item"><span class="tl-legend-dot dot-today"></span> Penunjuk Hari Ini</span>
        </div>
      </div>

      <!-- 2. Executive Macro KPIs Strip -->
      <div class="tl-kpi-grid">
        <div class="tl-kpi-card" style="--accent-border: #06b6d4;">
          <div class="tl-kpi-val" style="color: #38bdf8;">
            <i class="bi bi-calendar-check-fill" style="font-size: 18px;"></i>
            <span id="tlKpiTotal"><%= timelineData.summary.count2026 %></span> Kegiatan
          </div>
          <div class="tl-kpi-lbl">
            <i class="bi bi-card-checklist"></i> Terdaftar di Kalender BPS
          </div>
        </div>

        <div class="tl-kpi-card" style="--accent-border: #10b981;">
          <div class="tl-kpi-val" style="color: #10b981;">
            <i class="bi bi-activity" style="font-size: 18px;"></i>
            <span id="tlKpiActive"><%= timelineData.summary.countActive %></span> Kegiatan
          </div>
          <div class="tl-kpi-lbl">
            <i class="bi bi-broadcast"></i> Sedang Berjalan Lapangan Hari Ini
          </div>
        </div>

        <div class="tl-kpi-card" style="--accent-border: #f97316;">
          <div class="tl-kpi-val" style="color: #f97316; font-size: 16px;">
            <i class="bi bi-graph-up-arrow" style="font-size: 18px;"></i>
            <span><%= timelineData.summary.peakSeason %></span>
          </div>
          <div class="tl-kpi-lbl">
            <i class="bi bi-fire"></i> Puncak Beban Lapangan (Peak Season)
          </div>
        </div>

        <div class="tl-kpi-card" style="--accent-border: #8b5cf6;">
          <div class="tl-kpi-val" style="color: #a78bfa;">
            <i class="bi bi-stopwatch-fill" style="font-size: 18px;"></i>
            <span><%= timelineData.summary.avgDuration %> Hari</span>
          </div>
          <div class="tl-kpi-lbl">
            <i class="bi bi-hourglass-split"></i> Rata-rata Durasi Pelaksanaan
          </div>
        </div>
      </div>

      <!-- 3. Monthly Workload Density Chart -->
      <div class="tl-density-card">
        <div class="tl-density-head">
          <div style="display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-bar-chart-fill" style="color: #38bdf8;"></i>
            <span>Sebaran Kepadatan Beban Kerja Bulanan (Monthly Workload Density 2026)</span>
            <span id="tlActiveMonthBadge" style="display: none; font-size: 11px; background: rgba(56, 189, 248, 0.2); color: #38bdf8; padding: 2px 8px; border-radius: 999px; margin-left: 6px;"></span>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <button type="button" id="btnResetMonthFilter" onclick="resetTimelineMonthFilter()" style="display: none; background: transparent; border: 1px solid var(--border-portal); color: var(--text-portal-2); font-size: 11px; padding: 3px 10px; border-radius: 6px; cursor: pointer;">
              <i class="bi bi-x-circle"></i> Reset Filter Bulan
            </button>
            <span class="tl-density-badge">
              <i class="bi bi-arrow-up-right"></i> Puncak: <%= timelineData.summary.peakSeason %>
            </span>
          </div>
        </div>

        <div class="tl-density-bars-wrap">
          <% (timelineData.density2026 || []).forEach((m) => { 
             const heightPct = Math.max(8, Math.round((m.count / (timelineData.maxDensity || 1)) * 100));
             const isPeak = (m.count === timelineData.maxDensity);
          %>
            <div
              class="tl-density-col <%= isPeak ? 'is-peak' : '' %>"
              id="densityCol_<%= m.monthNum %>"
              onclick="filterTimelineByMonth('<%= m.monthNum %>', '<%= m.monthName %>')"
              title="<%= m.monthName %> 2026: <%= m.count %> kegiatan aktif. Klik untuk menyaring jadwal."
            >
              <span class="tl-density-count"><%= m.count %></span>
              <div class="tl-density-bar-body" style="height: <%= heightPct %>%;"></div>
            </div>
          <% }) %>
        </div>

        <div class="tl-density-months-row">
          <% (timelineData.density2026 || []).forEach((m) => { %>
            <div class="tl-density-month-lbl"><%= m.monthCode %></div>
          <% }) %>
        </div>
      </div>

      <!-- 4. The Master Gantt / Timeline Range Bar Matrix -->
      <div class="tl-matrix-card">
        <div class="tl-matrix-scroller">
          <div class="tl-matrix-table">
            
            <!-- Table Header Scale -->
            <div class="tl-header-row">
              <div class="tl-header-col-name">
                <span><i class="bi bi-list-task"></i> Kegiatan Sensus & Survei</span>
                <span style="font-size: 11px; color: var(--text-portal-3); font-weight: normal;" id="tlVisibleCount">
                  Menampilkan <%= timelineData.items.length %> baris
                </span>
              </div>
              <div class="tl-header-scale">
                <!-- Today Marker on Header -->
                <div class="tl-today-line-header" id="tlTodayHeader" style="left: <%= timelineData.summary.todayPercent2026 %>%;">
                  <div class="tl-today-badge">HARI INI (<%= timelineData.summary.todayFormatted || 'Hari Ini' %>)</div>
                </div>

                <!-- Row 1: Quarters -->
                <div class="tl-header-quarters">
                  <div class="tl-header-quarter-cell">Triwulan I (Q1: Jan — Mar)</div>
                  <div class="tl-header-quarter-cell">Triwulan II (Q2: Apr — Jun)</div>
                  <div class="tl-header-quarter-cell">Triwulan III (Q3: Jul — Sep)</div>
                  <div class="tl-header-quarter-cell">Triwulan IV (Q4: Okt — Des)</div>
                </div>
                <!-- Row 2: 12 Months -->
                <div class="tl-header-months">
                  <div class="tl-header-month-cell">Jan</div>
                  <div class="tl-header-month-cell">Feb</div>
                  <div class="tl-header-month-cell">Mar</div>
                  <div class="tl-header-month-cell">Apr</div>
                  <div class="tl-header-month-cell">Mei</div>
                  <div class="tl-header-month-cell">Jun</div>
                  <div class="tl-header-month-cell">Jul</div>
                  <div class="tl-header-month-cell">Ags</div>
                  <div class="tl-header-month-cell">Sep</div>
                  <div class="tl-header-month-cell">Okt</div>
                  <div class="tl-header-month-cell">Nov</div>
                  <div class="tl-header-month-cell">Des</div>
                </div>
              </div>
            </div>

            <!-- Table Body Rows -->
            <div class="tl-body" id="tlBodyContainer">
              <% timelineData.items.forEach((item, rIdx) => { %>
                <div
                  class="tl-row"
                  id="tlRow_<%= item.id %>"
                  data-id="<%= item.id %>"
                  data-name="<%= item.name.toLowerCase() %>"
                  data-shortname="<%= (item.shortName || '').toLowerCase() %>"
                  data-category="<%= item.category %>"
                  data-year="<%= item.year %>"
                  data-status="<%= item.status %>"
                  data-months="<%= (item.activeMonths || []).map(m => m.split('-')[1]).join(',') %>"
                >
                  <!-- Sticky Left Info Column -->
                  <div class="tl-cell-info">
                    <div class="tl-info-top">
                      <span class="tl-badge-cat cat-<%= item.category %>">
                        <%= item.categoryBadge || (item.category === 'sensus' ? 'Sensus' : 'Survei') %>
                      </span>
                      <span class="tl-duration-pill">
                        <i class="bi bi-clock"></i> <%= item.durationDays %> hari
                      </span>
                      <span class="tl-progress-tag" style="color: <%= item.themeColor %>; margin-left: auto;">
                        <%= item.persen %>%
                      </span>
                    </div>
                    <a href="<%= item.route %>" class="tl-item-title" title="<%= item.name %>">
                      <%= item.shortName || item.name %>
                    </a>
                    <div class="tl-info-meta">
                      <span><%= item.stage || item.tagline %></span>
                    </div>
                  </div>

                  <!-- Right Track & Range Bar Area -->
                  <div class="tl-cell-track">
                    <!-- Column Guides (12 Months) -->
                    <div class="tl-grid-guides">
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                      <div class="tl-guide-col"></div>
                    </div>

                    <!-- Today Marker Line -->
                    <div class="tl-today-line" style="left: <%= timelineData.summary.todayPercent2026 %>%;"></div>

                    <!-- Floating Range Bar -->
                    <a
                      href="<%= item.route %>"
                      class="tl-range-bar"
                      style="left: <%= item.leftPercent %>%; width: <%= item.widthPercent %>%; background: <%= item.themeGradient %>; box-shadow: <%= item.themeGlow %>;"
                    >
                      <!-- Progress Fill Bar -->
                      <div class="tl-bar-fill-progress" style="width: <%= Math.min(100, item.persen) %>%;"></div>

                      <!-- Inner Label -->
                      <span class="tl-bar-inner-text">
                        <i class="bi <%= item.themeIcon %>"></i>
                        <span><%= item.shortName || item.name %></span>
                        <span style="opacity: 0.85; font-size: 10px; margin-left: 2px;">(<%= item.durationDays %>h)</span>
                      </span>

                      <!-- Rich Hover Tooltip Popover -->
                      <div class="tl-tooltip-popover">
                        <div class="tl-popover-title"><%= item.name %></div>
                        <div class="tl-popover-dates">
                          <i class="bi bi-calendar3"></i> <%= item.startDateFormatted %> &rarr; <%= item.endDateFormatted %>
                        </div>
                        <div class="tl-popover-meta">
                          <div>
                            <span>Durasi:</span><br>
                            <strong><%= item.durationDays %> Hari</strong>
                          </div>
                          <div>
                            <span>Status:</span><br>
                            <strong style="color: <%= item.status === 'aktif' ? '#10b981' : (item.persen >= 100 ? '#38bdf8' : '#cbd5e1') %>;">
                              <%= item.statusLabel %>
                            </strong>
                          </div>
                          <div>
                            <span>Realisasi:</span><br>
                            <strong><%= (item.realisasi || 0).toLocaleString('id-ID') %> <%= item.unitName %></strong>
                          </div>
                          <div>
                            <span>Capaian:</span><br>
                            <strong style="color: <%= item.themeColor %>;"><%= item.persen %>%</strong>
                          </div>
                        </div>
                        <div class="tl-popover-link">
                          Buka Dasbor Monitoring <i class="bi bi-arrow-right"></i>
                        </div>
                      </div>
                    </a>
                  </div>
                </div>
              <% }) %>

              <!-- Empty State Timeline -->
              <div id="tlEmptySearch" class="portal-empty-search" style="display: none; padding: 40px 20px; text-align: center;">
                <i class="bi bi-calendar-x" style="font-size: 36px; opacity: 0.5;"></i>
                <div style="font-weight: 700; font-size: 16px; margin-top: 10px; color: var(--text-portal-1);">Tidak Ada Jadwal Kegiatan Sesuai Filter</div>
                <div style="font-size: 13px; margin-top: 4px; color: var(--text-portal-3);">Silakan sesuaikan pilihan tahun, kategori, atau kata kunci pencarian.</div>
              </div>
            </div>

          </div>
        </div>
      </div>

    <% } else { %>
      <div style="padding: 40px; text-align: center; color: var(--text-portal-3);">
        Data jadwal belum tersedia.
      </div>
    <% } %>
  </section>

</div>

<!-- Clean up tower spotlight rig & Client Interaction Scripts -->
<script>
  (function() {
    const spotRig = document.getElementById('towerSpotlightRig');
    if (spotRig) {
      setTimeout(() => {
        if (spotRig && spotRig.parentNode) {
          spotRig.remove();
        }
      }, 2300);
    }
  })();

  // State
  let currentCategoryFilter = '';
  let currentSearchQuery = '';
  let currentSortOption = 'default';

  function filterCategory(btn, cat) {
    currentCategoryFilter = (cat || '').toLowerCase().trim();
    document.querySelectorAll('.portal-filter-tab').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    applySortingAndFilters();
  }

  function handleSearch(query) {
    currentSearchQuery = (query || '').toLowerCase().trim();
    const clearBtn = document.getElementById('surveySearchClear');
    if (clearBtn) {
      clearBtn.style.display = currentSearchQuery ? 'inline-flex' : 'none';
    }
    applySortingAndFilters();
  }

  function clearSurveySearch() {
    const input = document.getElementById('surveySearchInput');
    if (input) {
      input.value = '';
      input.focus();
    }
    handleSearch('');
  }

  function handleSortChange(sortVal) {
    currentSortOption = sortVal || 'default';
    try {
      localStorage.setItem('portal_surveys_sort_mode', currentSortOption);
    } catch (_) {}
    applySortingAndFilters();
  }

  function applySortingAndFilters() {
    const gridEl = document.getElementById('portalCardsGrid');
    if (!gridEl) return;

    const cards = Array.from(gridEl.querySelectorAll('article.survey-card'));
    const emptyEl = document.getElementById('emptySearchState');
    const countEl = document.getElementById('searchResultCount');

    // 1. Sort cards
    cards.sort((a, b) => {
      const idxA = parseInt(a.getAttribute('data-default-index'), 10) || 0;
      const idxB = parseInt(b.getAttribute('data-default-index'), 10) || 0;

      if (currentSortOption === 'progress-desc') {
        const pA = parseFloat(a.getAttribute('data-persen')) || 0;
        const pB = parseFloat(b.getAttribute('data-persen')) || 0;
        if (pB !== pA) return pB - pA;
        const rA = parseInt(a.getAttribute('data-realisasi'), 10) || 0;
        const rB = parseInt(b.getAttribute('data-realisasi'), 10) || 0;
        if (rB !== rA) return rB - rA;
        return idxA - idxB;
      }

      if (currentSortOption === 'progress-asc') {
        const pA = parseFloat(a.getAttribute('data-persen')) || 0;
        const pB = parseFloat(b.getAttribute('data-persen')) || 0;
        if (pA !== pB) return pA - pB;
        const rA = parseInt(a.getAttribute('data-realisasi'), 10) || 0;
        const rB = parseInt(b.getAttribute('data-realisasi'), 10) || 0;
        if (rA !== rB) return rA - rB;
        return idxA - idxB;
      }

      if (currentSortOption === 'name-asc') {
        const nA = (a.getAttribute('data-name') || '').trim();
        const nB = (b.getAttribute('data-name') || '').trim();
        const cmp = nA.localeCompare(nB, 'id-ID');
        if (cmp !== 0) return cmp;
        return idxA - idxB;
      }

      if (currentSortOption === 'name-desc') {
        const nA = (a.getAttribute('data-name') || '').trim();
        const nB = (b.getAttribute('data-name') || '').trim();
        const cmp = nB.localeCompare(nA, 'id-ID');
        if (cmp !== 0) return cmp;
        return idxA - idxB;
      }

      if (currentSortOption === 'target-desc') {
        const tA = parseInt(a.getAttribute('data-target'), 10) || 0;
        const tB = parseInt(b.getAttribute('data-target'), 10) || 0;
        if (tB !== tA) return tB - tA;
        return idxA - idxB;
      }

      if (currentSortOption === 'realisasi-desc') {
        const rA = parseInt(a.getAttribute('data-realisasi'), 10) || 0;
        const rB = parseInt(b.getAttribute('data-realisasi'), 10) || 0;
        if (rB !== rA) return rB - rA;
        return idxA - idxB;
      }

      // Default: Initial natural order
      return idxA - idxB;
    });

    // 2. Re-insert sorted cards in DOM order before the empty state message
    cards.forEach(card => {
      if (emptyEl) {
        gridEl.insertBefore(card, emptyEl);
      } else {
        gridEl.appendChild(card);
      }
    });

    // 3. Filter by category tab and search query
    let visibleCount = 0;
    cards.forEach(card => {
      const cat = card.getAttribute('data-category') || '';
      const name = card.getAttribute('data-name') || '';
      const shortName = card.getAttribute('data-shortname') || '';
      const tagline = card.getAttribute('data-tagline') || '';

      // Category match
      let matchCat = true;
      if (currentCategoryFilter) {
        if (currentCategoryFilter === 'pencacahan') {
          matchCat = (cat !== 'pelatihan' && cat !== 'ujicoba');
        } else {
          matchCat = (cat === currentCategoryFilter);
        }
      }

      // Search match
      let matchQuery = true;
      if (currentSearchQuery) {
        matchQuery = name.includes(currentSearchQuery) ||
                     shortName.includes(currentSearchQuery) ||
                     tagline.includes(currentSearchQuery);
      }

      if (matchCat && matchQuery) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyEl) {
      emptyEl.style.display = (visibleCount === 0) ? 'block' : 'none';
    }
    if (countEl) {
      countEl.innerText = `Menampilkan ${visibleCount} kegiatan`;
    }
    applyTimelineFilters();
  }

  function applyFilters() {
    applySortingAndFilters();
  }

  // Portal View Mode (Grid vs List vs Timeline)
  let currentTimelineYear = 2026;
  let currentTimelineStatus = 'all';
  let currentTimelineMonth = null;

  function setPortalViewMode(mode) {
    const gridEl = document.getElementById('portalCardsGrid');
    const timelineEl = document.getElementById('portalTimelineView');
    const btnGrid = document.getElementById('btnViewGrid');
    const btnList = document.getElementById('btnViewList');
    const btnTimeline = document.getElementById('btnViewTimeline');
    if (!gridEl) return;

    if (mode === 'timeline') {
      gridEl.style.display = 'none';
      if (timelineEl) timelineEl.style.display = 'flex';
      if (btnGrid) btnGrid.classList.remove('active');
      if (btnList) btnList.classList.remove('active');
      if (btnTimeline) btnTimeline.classList.add('active');
      try {
        localStorage.setItem('portal_surveys_view_mode', 'timeline');
      } catch (_) {}
      applyTimelineFilters();
    } else if (mode === 'list') {
      if (timelineEl) timelineEl.style.display = 'none';
      gridEl.style.display = '';
      gridEl.classList.add('is-list-view');
      if (btnGrid) btnGrid.classList.remove('active');
      if (btnList) btnList.classList.add('active');
      if (btnTimeline) btnTimeline.classList.remove('active');
      try {
        localStorage.setItem('portal_surveys_view_mode', 'list');
      } catch (_) {}
    } else {
      if (timelineEl) timelineEl.style.display = 'none';
      gridEl.style.display = '';
      gridEl.classList.remove('is-list-view');
      if (btnGrid) btnGrid.classList.add('active');
      if (btnList) btnList.classList.remove('active');
      if (btnTimeline) btnTimeline.classList.remove('active');
      try {
        localStorage.setItem('portal_surveys_view_mode', 'grid');
      } catch (_) {}
    }
  }

  function setTimelineYear(year) {
    currentTimelineYear = year;
    const btn2026 = document.getElementById('tlYear2026');
    const btn2025 = document.getElementById('tlYear2025');
    const btnAll = document.getElementById('tlYearAll');

    if (btn2026) btn2026.classList.toggle('active', year === 2026);
    if (btn2025) btn2025.classList.toggle('active', year === 2025);
    if (btnAll) btnAll.classList.toggle('active', year === 'all');

    // Toggle today marker
    const todayHdr = document.getElementById('tlTodayHeader');
    if (todayHdr) todayHdr.style.display = (year === 2025) ? 'none' : '';
    document.querySelectorAll('.tl-today-line').forEach(el => {
      el.style.display = (year === 2025) ? 'none' : '';
    });

    applyTimelineFilters();
  }

  function handleTimelineStatusFilter(statusVal) {
    currentTimelineStatus = statusVal || 'all';
    applyTimelineFilters();
  }

  function filterTimelineByMonth(monthNum, monthName) {
    if (currentTimelineMonth === monthNum) {
      resetTimelineMonthFilter();
      return;
    }
    currentTimelineMonth = monthNum;
    
    document.querySelectorAll('.tl-density-col').forEach(c => c.classList.remove('is-active-filter'));
    const activeCol = document.getElementById('densityCol_' + monthNum);
    if (activeCol) activeCol.classList.add('is-active-filter');

    const badge = document.getElementById('tlActiveMonthBadge');
    if (badge) {
      badge.innerText = `Bulan: ${monthName}`;
      badge.style.display = 'inline-block';
    }
    const resetBtn = document.getElementById('btnResetMonthFilter');
    if (resetBtn) resetBtn.style.display = 'inline-block';

    applyTimelineFilters();
  }

  function resetTimelineMonthFilter() {
    currentTimelineMonth = null;
    document.querySelectorAll('.tl-density-col').forEach(c => c.classList.remove('is-active-filter'));
    const badge = document.getElementById('tlActiveMonthBadge');
    if (badge) badge.style.display = 'none';
    const resetBtn = document.getElementById('btnResetMonthFilter');
    if (resetBtn) resetBtn.style.display = 'none';
    applyTimelineFilters();
  }

  function applyTimelineFilters() {
    const rows = Array.from(document.querySelectorAll('.tl-row'));
    if (!rows.length) return;

    let visibleCount = 0;
    let activeCount = 0;
    let completedCount = 0;

    rows.forEach(r => {
      const year = r.getAttribute('data-year');
      const cat = (r.getAttribute('data-category') || '').toLowerCase();
      const status = r.getAttribute('data-status');
      const months = (r.getAttribute('data-months') || '').split(',');
      const name = r.getAttribute('data-name') || '';
      const shortName = r.getAttribute('data-shortname') || '';

      // 1. Year Match
      let matchYear = true;
      if (currentTimelineYear !== 'all') {
        matchYear = (String(year) === String(currentTimelineYear));
      }

      // 2. Category Match (Sync dengan filter tabs utama)
      let matchCat = true;
      if (currentCategoryFilter) {
        if (currentCategoryFilter === 'pencacahan') {
          matchCat = (cat !== 'pelatihan' && cat !== 'ujicoba');
        } else {
          matchCat = (cat === currentCategoryFilter);
        }
      }

      // 3. Status Match
      let matchStatus = true;
      if (currentTimelineStatus !== 'all') {
        matchStatus = (status === currentTimelineStatus);
      }

      // 4. Month Match
      let matchMonth = true;
      if (currentTimelineMonth) {
        matchMonth = months.includes(currentTimelineMonth);
      }

      // 5. Search Query Match
      let matchSearch = true;
      if (currentSearchQuery) {
        matchSearch = name.includes(currentSearchQuery) || shortName.includes(currentSearchQuery);
      }

      const isMatch = matchYear && matchCat && matchStatus && matchMonth && matchSearch;
      r.style.display = isMatch ? 'flex' : 'none';

      if (isMatch) {
        visibleCount++;
        if (status === 'aktif') activeCount++;
        if (status === 'selesai') completedCount++;
      }
    });

    const visCountEl = document.getElementById('tlVisibleCount');
    if (visCountEl) {
      visCountEl.innerText = `Menampilkan ${visibleCount} baris`;
    }

    const emptyEl = document.getElementById('tlEmptySearch');
    if (emptyEl) {
      emptyEl.style.display = (visibleCount === 0) ? 'block' : 'none';
    }

    const kpiTotal = document.getElementById('tlKpiTotal');
    if (kpiTotal) {
      kpiTotal.innerText = visibleCount;
    }

    const kpiActive = document.getElementById('tlKpiActive');
    if (kpiActive && (currentTimelineYear === 2026 || currentTimelineYear === 'all')) {
      kpiActive.innerText = activeCount;
    }
  }

  // Restore saved view mode & sort mode immediately
  (function initPortalPreferences() {
    try {
      const savedMode = localStorage.getItem('portal_surveys_view_mode');
      if (savedMode === 'timeline') {
        setPortalViewMode('timeline');
      } else if (savedMode === 'list') {
        setPortalViewMode('list');
      }
      const savedSort = localStorage.getItem('portal_surveys_sort_mode');
      if (savedSort) {
        currentSortOption = savedSort;
        const sortSel = document.getElementById('surveySortSelect');
        if (sortSel) sortSel.value = savedSort;
      }
      applySortingAndFilters();
      applyTimelineFilters();
    } catch (_) {}
  })();

  async function triggerCatalogSync() {
    const btn = document.getElementById('btnSyncCatalog');
    const lbl = document.getElementById('lblSyncCatalog');
    if (!confirm('Tarik daftar seluruh kegiatan survei dan sensus terbaru dari FASIH-SM Cloud via API?\n\nSistem akan secara otomatis me-refresh dan men-generate dasbor untuk setiap kegiatan.')) {
      return;
    }

    try {
      if (btn) btn.disabled = true;
      if (lbl) lbl.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Menyinkronkan kegiatan...';

      const res = await fetch('/surveys/sync-catalog', {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': '<%= csrfToken %>'
        },
        body: JSON.stringify({ _csrf: '<%= csrfToken %>' })
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Gagal menyinkronkan katalog kegiatan');
      }

      alert(`Sinkronisasi Berhasil!\n${data.message || 'Katalog kegiatan berhasil diperbarui.'}\nMemuat ulang portal...`);
      window.location.reload();
    } catch (err) {
      alert(`Gagal Sinkronisasi Katalog: ${err.message}`);
    } finally {
      if (btn) btn.disabled = false;
      if (lbl) lbl.innerHTML = 'Sinkron Katalog';
    }
  }

  async function triggerCardProgressSync(e, surveyId, name) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    const btn = document.getElementById('syncBtn_' + surveyId);
    if (!btn || btn.disabled) return;

    btn.disabled = true;
    const origHtml = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i>';

    try {
      const res = await fetch('/surveys/sync-progress/' + encodeURIComponent(surveyId), {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': '<%= csrfToken %>'
        },
        body: JSON.stringify({ forceRefresh: true, _csrf: '<%= csrfToken %>' })
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Gagal menyinkronkan data progres.');
      }

      btn.innerHTML = '<i class="bi bi-check-lg" style="color: #10b981; font-weight: bold;"></i>';
      btn.title = `Berhasil disinkronkan (${data.totalSls || 0} unit wilayah)!`;
      setTimeout(() => {
        window.location.reload();
      }, 1000);
    } catch (err) {
      alert(`Gagal Sinkronisasi Progres [${name}]: ${err.message}`);
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  async function triggerAllProgressSync() {
    const btn = document.getElementById('btnSyncAllProgress');
    const lbl = document.getElementById('lblSyncAllProgress');

    if (!confirm('Tarik data progres mutakhir untuk seluruh kegiatan survei dan sensus dari FASIH-SM Cloud via API?\n\nProses akan berjalan secara berurutan di latar belakang.')) {
      return;
    }

    try {
      if (btn) btn.disabled = true;
      if (lbl) lbl.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Menarik seluruh progres...';

      const res = await fetch('/surveys/sync-progress-all', {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'X-CSRF-TOKEN': '<%= csrfToken %>'
        },
        body: JSON.stringify({ _csrf: '<%= csrfToken %>' })
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Gagal menyinkronkan seluruh data progres');
      }

      alert(`Sinkronisasi Massal Selesai!\n- Berhasil: ${data.synced} kegiatan\n- Tidak Berubah: ${data.skipped} kegiatan\n- Gagal: ${data.failed} kegiatan\n\nMemuat ulang portal...`);
      window.location.reload();
    } catch (err) {
      alert(`Gagal Sinkronisasi Massal: ${err.message}`);
    } finally {
      if (btn) btn.disabled = false;
      if (lbl) lbl.innerHTML = 'Tarik Semua Progres';
    }
  }

  // Quick background health check for Cloud API catalog status
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const res = await fetch('/surveys/catalog-status');
      if (!res.ok) return;
      const data = await res.json();
      if (data.ok && data.status === 'online') {
        const btnSync = document.getElementById('btnSyncCatalog');
        if (btnSync && data.latencyMs) {
          btnSync.title = `Latency Cloud: ${data.latencyMs}ms | Terdaftar: ${data.totalRegistered || '--'} dasbor kegiatan`;
        }
      }
    } catch (_) {}
  });

  // Global keyboard shortcut: Press '/' or 'Ctrl+K' to focus the primary search bar
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
      const activeEl = document.activeElement;
      const isInput = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.isContentEditable);
      if (!isInput) {
        e.preventDefault();
        const searchInput = document.getElementById('surveySearchInput');
        if (searchInput) {
          searchInput.focus();
          searchInput.select();
        }
      }
    } else if (e.key === 'Escape') {
      const searchInput = document.getElementById('surveySearchInput');
      if (document.activeElement === searchInput && searchInput.value) {
        clearSurveySearch();
      }
    }
  });
</script>
