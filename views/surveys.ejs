<style>
  /* =========================================================================
     PORTAL PANANYO TAKA — THEME-AWARE MODERN ROUNDED CARDS (DARK & LIGHT)
     WITH DISTINCT CENSUS VS SURVEY CATEGORY IDENTIFIERS & LIGHTWEIGHT SHADOWS
     ========================================================================= */
  
  :root {
    --card-bg: #0f172a;
    --card-border: #334155;
    --card-inner-bg: #1e293b;
    --card-inner-border: #334155;
    --card-track-bg: #0f172a;
    --card-title: #ffffff;
    --card-tagline: #94a3b8;
    --card-label: #cbd5e1;
    --card-val: #f8fafc;
    --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.15);
    --card-icon-border: rgba(255, 255, 255, 0.12);

    /* Timeline & Gantt Chart Tokens (Dark Mode) */
    --bg-portal: #080c14;
    --bg-portal-card: #0f172a;
    --bg-portal-card-hover: #1e293b;
    --bg-portal-glass: rgba(15, 23, 42, 0.95);
    --border-portal: #334155;
    --border-portal-hover: #475569;
    --text-portal-1: #f8fafc;
    --text-portal-2: #cbd5e1;
    --text-portal-3: #94a3b8;
    --accent-orange: #f97316;
    --accent-cyan: #06b6d4;
    --accent-purple: #8b5cf6;
    --accent-green: #10b981;

    --hero-glow: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(249, 115, 22, 0.07), transparent 75%);
    
    /* High-Contrast PPU Illustration Tokens (Dark Mode) */
    --ppu-stroke: #f97316;
    --ppu-accent: #facc15;
    --ppu-fill: rgba(249, 115, 22, 0.12);
    --ppu-beam: #38bdf8;
    --ppu-bridge: #06b6d4;
    --ppu-nature: #10b981;
    --ppu-shadow: none;

    /* Giant Full-Page Spotlight Beam (Origin at Tower Apex) */
    --spotlight-giant-gradient: linear-gradient(180deg, rgba(250, 204, 21, 0.6) 0%, rgba(249, 115, 22, 0.35) 25%, rgba(56, 189, 248, 0.15) 65%, transparent 100%);
    --spotlight-halo-bg: radial-gradient(circle, rgba(250, 204, 21, 0.7) 0%, rgba(249, 115, 22, 0.35) 30%, transparent 70%);
  }

  html.light-mode {
    --card-bg: #ffffff;
    --card-border: #e2e8f0;
    --card-inner-bg: #f8fafc;
    --card-inner-border: #e2e8f0;
    --card-track-bg: #e2e8f0;
    --card-title: #0f172a;
    --card-tagline: #475569;
    --card-label: #334155;
    --card-val: #0f172a;
    --card-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    --card-icon-border: rgba(0, 0, 0, 0.08);

    /* Timeline & Gantt Chart Tokens (Light Mode) */
    --bg-portal: #f8fafc;
    --bg-portal-card: #ffffff;
    --bg-portal-card-hover: #f1f5f9;
    --bg-portal-glass: rgba(255, 255, 255, 0.96);
    --border-portal: #e2e8f0;
    --border-portal-hover: #cbd5e1;
    --text-portal-1: #0f172a;
    --text-portal-2: #334155;
    --text-portal-3: #64748b;
    --accent-orange: #ea580c;
    --accent-cyan: #0284c7;
    --accent-purple: #7c3aed;
    --accent-green: #059669;

    --hero-glow: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(249, 115, 22, 0.05), transparent 75%);
    
    /* High-Contrast PPU Illustration Tokens (Light Mode) */
    --ppu-stroke: #1e293b;
    --ppu-accent: #ea580c;
    --ppu-fill: rgba(249, 115, 22, 0.06);
    --ppu-beam: #0284c7;
    --ppu-bridge: #0891b2;
    --ppu-nature: #059669;
    --ppu-shadow: none;

    --spotlight-giant-gradient: linear-gradient(180deg, rgba(249, 115, 22, 0.35) 0%, rgba(250, 204, 21, 0.18) 25%, rgba(6, 182, 212, 0.08) 65%, transparent 100%);
    --spotlight-halo-bg: radial-gradient(circle, rgba(249, 115, 22, 0.45) 0%, rgba(250, 204, 21, 0.2) 30%, transparent 70%);
  }

  /* ══════════════════════════════════════════════════════
     GIANT FULL-PAGE TOWER-APEX VOLUMETRIC SPOTLIGHT RIG
     (Titik pusat di ujung puncak menara, menjangkau seluruh halaman)
     ══════════════════════════════════════════════════════ */
  .tower-apex-spotlight-rig {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
    overflow: hidden;
    mix-blend-mode: screen;
    animation: spotlightRigFadeOut 2.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  html.light-mode .tower-apex-spotlight-rig {
    mix-blend-mode: hard-light;
  }

  @keyframes spotlightRigFadeOut {
    0% { opacity: 1; visibility: visible; }
    85% { opacity: 0.9; }
    100% { opacity: 0; visibility: hidden; pointer-events: none; }
  }

  /* Anchor pivot position directly aligned with Tower Beacon Peak */
  .tower-apex-pivot {
    position: absolute;
    top: max(40px, 12vh);
    left: 50%;
    transform: translate(-50%, 0);
    width: 0;
    height: 0;
  }

  /* Giant Volumetric Cone Sweeping Across the Entire Screen with Rounded Semicircle Apex */
  .giant-spotlight-beam {
    position: absolute;
    top: 0;
    left: 50%;
    width: 260vw;
    height: 240vh;
    background: var(--spotlight-giant-gradient);
    clip-path: polygon(
      0% 100%,
      47.2% 50px,
      47.8% 32px,
      48.5% 18px,
      49.2% 7px,
      50.0% 0%,
      50.8% 7px,
      51.5% 18px,
      52.2% 32px,
      52.8% 50px,
      100% 100%
    );
    transform-origin: 50% 0%;
    filter: blur(18px);
    opacity: 0;
    animation: towerApexSweepAll 2.0s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    will-change: transform, opacity;
  }

  .giant-spotlight-beam::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 60px;
    border-radius: 60px 60px 0 0;
    background: var(--spotlight-giant-gradient);
    filter: blur(6px);
  }

  /* Optical Beacon Flare at the Tower Apex Pivot Point */
  .beacon-apex-flare {
    position: absolute;
    top: 0;
    left: 50%;
    width: 140px;
    height: 140px;
    transform: translate(-50%, -50%);
    background: var(--spotlight-halo-bg);
    border-radius: 50%;
    filter: blur(14px);
    opacity: 0;
    animation: beaconFlarePulseOnce 2.0s ease-out forwards;
  }

  @keyframes towerApexSweepAll {
    0% {
      transform: translate(-50%, 0) rotate(-85deg) scale(0.9);
      opacity: 0;
    }
    18% {
      opacity: 0.95;
    }
    50% {
      transform: translate(-50%, 0) rotate(0deg) scale(1.15);
      opacity: 1;
    }
    82% {
      transform: translate(-50%, 0) rotate(80deg) scale(0.95);
      opacity: 0.4;
    }
    100% {
      transform: translate(-50%, 0) rotate(90deg) scale(0.9);
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes beaconFlarePulseOnce {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
    25% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); }
    75% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(0.8); visibility: hidden; }
  }

  .portal-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px 20px 48px;
    position: relative;
    z-index: 10;
  }

  /* ── HERO HEADER WITH PPU LANDMARKS & MONITORING TOWER ── */
  .artistic-hero-wrap {
    position: relative;
    text-align: center;
    padding: 48px 20px 0;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 280px;
    z-index: 1;
  }

  /* Gradient fade di tepi bawah hero — jembatan visual halus ke toolbar & kartu */
  .artistic-hero-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent 0%, var(--card-bg) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* Background Ambient Orbital Glow — subtle */
  .hero-orbital-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 880px;
    height: 500px;
    background: var(--hero-glow);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
    opacity: 0.6;
  }

  /* High-Contrast Panoramic PPU Landscape Illustration */
  .hero-ppu-panoramic-vector {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(100vw, 920px);
    height: 380px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.7;
    transition: opacity 0.3s ease;
