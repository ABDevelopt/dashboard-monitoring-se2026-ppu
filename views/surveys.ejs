<%
  const _stats = (typeof locals !== 'undefined' && typeof locals.statsAggregate !== 'undefined') ? locals.statsAggregate : ((typeof statsAggregate !== 'undefined') ? statsAggregate : { totalModules: 3, totalActive: 3, totalRealisasi: 0, totalTarget: 0, aggregatePct: 0 });
  const _list = (typeof locals !== 'undefined' && typeof locals.surveysList !== 'undefined') ? locals.surveysList : ((typeof surveysList !== 'undefined') ? surveysList : []);
%>
<style>
  /* ── HERO BANNER ── */
  .portal-hero-wrap {
    padding: 16px 0 32px;
    text-align: center;
    position: relative;
  }

  .portal-hero-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--text-portal-1);
    margin-bottom: 10px;
  }

  .portal-hero-title .gradient-text {
    background: linear-gradient(135deg, #f97316 0%, #fb923c 45%, #facc15 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .portal-hero-desc {
    font-size: 14px;
    color: var(--text-portal-2);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── KPI HIGHLIGHTS STRIP ── */
  .portal-kpi-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin-bottom: 36px;
  }

  .portal-kpi-item {
    background: var(--bg-portal-card);
    border: 1px solid var(--border-portal);
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .portal-kpi-item:hover {
    transform: translateY(-2px);
    border-color: var(--border-portal-hover);
  }

  .portal-kpi-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .portal-kpi-num {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    color: var(--text-portal-1);
    line-height: 1.1;
  }

  .portal-kpi-label {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-portal-3);
    margin-top: 2px;
  }

  /* ── CARDS GRID ── */
  .portal-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 370px), 1fr));
    gap: 24px;
    margin-bottom: 48px;
  }

  .survey-card {
    position: relative;
    background: var(--bg-portal-card);
    border: 1px solid var(--border-portal);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .survey-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.4);
  }

  /* Color identity accents */
  .survey-card.theme-orange {
    border-color: rgba(249, 115, 22, 0.3);
  }
  .survey-card.theme-orange:hover {
    border-color: #f97316;
    box-shadow: var(--glow-orange);
  }

  .survey-card.theme-cyan {
    border-color: rgba(6, 182, 212, 0.3);
  }
  .survey-card.theme-cyan:hover {
    border-color: #06b6d4;
    box-shadow: var(--glow-cyan);
  }

  .survey-card.theme-purple {
    border-color: rgba(139, 92, 246, 0.3);
  }
  .survey-card.theme-purple:hover {
    border-color: #8b5cf6;
    box-shadow: var(--glow-purple);
  }

  .survey-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .survey-icon-badge {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
  }

  .survey-tags {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .survey-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    letter-spacing: 0.2px;
  }

  .survey-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 800;
    color: var(--text-portal-1);
    letter-spacing: -0.3px;
    line-height: 1.25;
    margin: 0 0 4px 0;
  }

  .survey-subtitle {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-portal-3);
    margin-bottom: 12px;
  }

  .survey-desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-portal-2);
    margin-bottom: 20px;
  }

  /* ── PROGRESS SECTION ── */
  .survey-progress-box {
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 18px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-portal);
  }

  .survey-progress-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .survey-progress-lbl {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-portal-2);
  }

  .survey-progress-val {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
  }

  .survey-progress-bar {
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .survey-progress-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .survey-progress-foot {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--text-portal-3);
    font-weight: 500;
  }
  .survey-progress-foot strong {
    color: var(--text-portal-1);
  }

  /* ── METADATA LIST ── */
  .survey-meta-list {
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid var(--border-portal);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 12px;
  }

  .survey-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .survey-meta-lbl {
    color: var(--text-portal-3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .survey-meta-val {
    color: var(--text-portal-1);
    font-weight: 600;
    text-align: right;
  }

  /* ── ACTION CTA BUTTON ── */
  .survey-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 13px 20px;
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 700;
    border-radius: 12px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }
  .survey-cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }
  .survey-cta i {
    transition: transform 0.2s ease;
  }
  .survey-cta:hover i {
    transform: translateX(4px);
  }

  .survey-cta-orange {
    background: linear-gradient(135deg, #f97316, #ea580c);
    color: #ffffff;
    box-shadow: 0 4px 18px rgba(249, 115, 22, 0.35);
  }
  .survey-cta-cyan {
    background: linear-gradient(135deg, #06b6d4, #0284c7);
    color: #ffffff;
    box-shadow: 0 4px 18px rgba(6, 182, 212, 0.35);
  }
  .survey-cta-purple {
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    color: #ffffff;
    box-shadow: 0 4px 18px rgba(139, 92, 246, 0.35);
  }

  /* ── FEATURE HIGHLIGHTS ── */
  .portal-features-box {
    background: var(--bg-portal-card);
    border: 1px solid var(--border-portal);
    border-radius: 20px;
    padding: 28px 32px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .portal-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .portal-feature-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .portal-feature-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .portal-feature-title {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-portal-1);
    margin-bottom: 3px;
  }

  .portal-feature-text {
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-portal-3);
  }
</style>

<!-- ══════════════════════════════════════════════════════
     HERO SECTION
     ══════════════════════════════════════════════════════ -->
<section class="portal-hero-wrap">
  <h1 class="portal-hero-title">
    Katalog Dasbor <span class="gradient-text">Sensus &amp; Survei</span>
  </h1>
  <p class="portal-hero-desc">
    Portal pemantauan real-time terintegrasi untuk seluruh kegiatan lapangan sensus dan survei Badan Pusat Statistik Kabupaten Penajam Paser Utara.
  </p>
</section>

<!-- ══════════════════════════════════════════════════════
     KPI STRIP BANNER
     ══════════════════════════════════════════════════════ -->
<div class="portal-kpi-strip">
  <div class="portal-kpi-item">
    <div class="portal-kpi-icon" style="background: rgba(249,115,22,0.12); color: #f97316;">
      <i class="bi bi-collection-fill"></i>
    </div>
    <div>
      <div class="portal-kpi-num"><%= _stats.totalModules %></div>
      <div class="portal-kpi-label">Modul Terdaftar</div>
    </div>
  </div>

  <div class="portal-kpi-item">
    <div class="portal-kpi-icon" style="background: rgba(6,182,212,0.12); color: #06b6d4;">
      <i class="bi bi-geo-alt-fill"></i>
    </div>
    <div>
      <div class="portal-kpi-num">54 + IKN</div>
      <div class="portal-kpi-label">Desa / Kelurahan se-PPU</div>
    </div>
  </div>

  <div class="portal-kpi-item">
    <div class="portal-kpi-icon" style="background: rgba(16,185,129,0.12); color: #10b981;">
      <i class="bi bi-check-circle-fill"></i>
    </div>
    <div>
      <div class="portal-kpi-num"><%= _stats.totalRealisasi.toLocaleString('id-ID') %></div>
      <div class="portal-kpi-label">Dokumen / Sampel Selesai</div>
    </div>
  </div>

  <div class="portal-kpi-item">
    <div class="portal-kpi-icon" style="background: rgba(139,92,246,0.12); color: #8b5cf6;">
      <i class="bi bi-speedometer2"></i>
    </div>
    <div>
      <div class="portal-kpi-num"><%= _stats.aggregatePct %>%</div>
      <div class="portal-kpi-label">Rata-rata Realisasi</div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     SURVEY CARDS GRID
     ══════════════════════════════════════════════════════ -->
<div class="portal-cards-grid">
  <% _list.forEach(s => { %>
    <div class="survey-card theme-<%= s.theme %>">
      <div>
        <div class="survey-card-top">
          <div class="survey-icon-badge" style="background: rgba(<%= s.themeRgb %>, 0.15); color: <%= s.themeColor %>; border: 1px solid rgba(<%= s.themeRgb %>, 0.3);">
            <% if (s.id === 'se2026') { %>
              <i class="bi bi-shop"></i>
            <% } else if (s.id === 'sakernas-pemutakhiran') { %>
              <i class="bi bi-clipboard-check-fill"></i>
            <% } else { %>
              <i class="bi bi-people-fill"></i>
            <% } %>
          </div>

          <div class="survey-tags">
            <% if (s.id === 'se2026') { %>
              <span class="survey-pill" style="background: rgba(249,115,22,0.12); color: #f97316; border: 1px solid rgba(249,115,22,0.3);"><i class="bi bi-star-fill"></i> Sensus Utama</span>
            <% } else if (s.id === 'sakernas-pemutakhiran') { %>
              <span class="survey-pill" style="background: rgba(6,182,212,0.12); color: #06b6d4; border: 1px solid rgba(6,182,212,0.3);"><i class="bi bi-list-check"></i> Tahap 1: Listing</span>
            <% } else { %>
              <span class="survey-pill" style="background: rgba(139,92,246,0.12); color: #8b5cf6; border: 1px solid rgba(139,92,246,0.3);"><i class="bi bi-journal-text"></i> Tahap 2: CAPI</span>
            <% } %>

            <span class="survey-pill" style="background: rgba(16,185,129,0.12); color: #10b981; border: 1px solid rgba(16,185,129,0.3);">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
              <%= s.status %>
            </span>
          </div>
        </div>

        <div style="margin-top: 16px;">
          <h2 class="survey-title"><%= s.name %></h2>
          <div class="survey-subtitle">
            <% if (s.id === 'se2026') { %>
              SE2026 PPU &bull; Cakupan 54 Desa &amp; IKN Nusantara
            <% } else if (s.id === 'sakernas-pemutakhiran') { %>
              Pemutakhiran Muatan Blok Sensus &amp; Rumahtangga
            <% } else { %>
              Pencacahan Sampel RT Ketenagakerjaan (CAPI)
            <% } %>
          </div>

          <p class="survey-desc">
            <% if (s.id === 'se2026') { %>
              Pemantauan pendataan seluruh unit usaha ekonomi (UTP &amp; UMB/UMK) di seluruh wilayah Kabupaten Penajam Paser Utara &amp; IKN.
            <% } else if (s.id === 'sakernas-pemutakhiran') { %>
              Pemutakhiran muatan keluarga/rumah tangga dalam blok sensus sampel terpilih dan verifikasi keberadaan sampel secara akurat.
            <% } else { %>
              Wawancara sampel rumah tangga terpilih untuk menghitung indikator ketenagakerjaan daerah, pengangguran (TPK), dan jam kerja.
            <% } %>
          </p>
        </div>

        <!-- Progress Box -->
        <div class="survey-progress-box" style="background: rgba(<%= s.themeRgb %>, 0.05); border-color: rgba(<%= s.themeRgb %>, 0.2);">
          <div class="survey-progress-row">
            <span class="survey-progress-lbl">Progres Pendataan Lapangan</span>
            <span class="survey-progress-val" style="color: <%= s.themeColor %>;"><%= s.persen %>%</span>
          </div>
          <div class="survey-progress-bar">
            <div class="survey-progress-fill" style="background: linear-gradient(90deg, <%= s.themeColor %>, #facc15); width: <%= Math.min(100, Math.max(0, s.persen)) %>%;"></div>
          </div>
          <div class="survey-progress-foot">
            <span>Realisasi: <strong><%= s.realisasi.toLocaleString('id-ID') %></strong> <%= s.unitName %></span>
            <span>Target: <strong><%= s.target.toLocaleString('id-ID') %></strong> <%= s.unitName %></span>
          </div>
        </div>

        <!-- Metadata List -->
        <div class="survey-meta-list">
          <div class="survey-meta-row">
            <span class="survey-meta-lbl"><i class="bi bi-geo-alt-fill" style="color: <%= s.themeColor %>;"></i> Cakupan Wilayah</span>
            <span class="survey-meta-val"><%= s.id === 'se2026' ? '54 Desa/Kelurahan & IKN' : 'Blok Sensus Sampel PPU' %></span>
          </div>
          <div class="survey-meta-row">
            <span class="survey-meta-lbl"><i class="bi bi-laptop-fill" style="color: <%= s.themeColor %>;"></i> Metode &amp; Sistem</span>
            <span class="survey-meta-val"><%= s.id === 'se2026' ? 'FASIH CAPI + Muatan Prelist' : (s.id === 'sakernas-pemutakhiran' ? 'Listing BS PAPI / FASIH' : 'CAPI FASIH Mobile') %></span>
          </div>
          <div class="survey-meta-row">
            <span class="survey-meta-lbl"><i class="bi bi-clock-history" style="color: <%= s.themeColor %>;"></i> Update Terakhir</span>
            <span class="survey-meta-val"><%= s.latestUploadDate ? new Date(s.latestUploadDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Hari Ini' %></span>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div>
        <a href="<%= s.route %>" class="survey-cta survey-cta-<%= s.theme %>">
          <span>Buka Dasbor <%= s.shortName %></span>
          <i class="bi bi-arrow-right-short" style="font-size: 20px;"></i>
        </a>
      </div>
    </div>
  <% }) %>
</div>

<!-- ══════════════════════════════════════════════════════
     SYSTEM HIGHLIGHTS BOX
     ══════════════════════════════════════════════════════ -->
<div class="portal-features-box">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--border-portal);">
    <div style="display: flex; align-items: center; gap: 10px;">
      <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(249, 115, 22, 0.15); color: #f97316; display: flex; align-items: center; justify-content: center; font-size: 16px;">
        <i class="bi bi-stars"></i>
      </div>
      <div>
        <h3 style="font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--text-portal-1); margin: 0;">Keunggulan &amp; Fitur Terpadu Pananyo Taka</h3>
        <p style="font-size: 11.5px; color: var(--text-portal-3); margin: 2px 0 0 0;">Standar arsitektur pemantauan modern BPS Kabupaten Penajam Paser Utara</p>
      </div>
    </div>
    <span style="font-size: 11px; font-weight: 700; color: var(--accent-orange); background: rgba(249, 115, 22, 0.1); border: 1px solid rgba(249, 115, 22, 0.3); padding: 4px 10px; border-radius: 6px;">Enterprise Grade</span>
  </div>

  <div class="portal-features-grid">
    <div class="portal-feature-item">
      <div class="portal-feature-icon" style="background: rgba(249, 115, 22, 0.12); color: #f97316;">
        <i class="bi bi-map-fill"></i>
      </div>
      <div>
        <div class="portal-feature-title">GIS Spasial &amp; Poligon</div>
        <div class="portal-feature-text">Visualisasi pemetaan sebaran SLS dan titik usaha di atas peta interaktif.</div>
      </div>
    </div>

    <div class="portal-feature-item">
      <div class="portal-feature-icon" style="background: rgba(6, 182, 212, 0.12); color: #06b6d4;">
        <i class="bi bi-shield-check"></i>
      </div>
      <div>
        <div class="portal-feature-title">Deteksi Anomali 2-Arah</div>
        <div class="portal-feature-text">Validasi otomatis data ganda, tutup, dan anomali lapangan terintegrasi Google Sheets.</div>
      </div>
    </div>

    <div class="portal-feature-item">
      <div class="portal-feature-icon" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
        <i class="bi bi-whatsapp"></i>
      </div>
      <div>
        <div class="portal-feature-title">Notifikasi WhatsApp Bot</div>
        <div class="portal-feature-text">Distribusi rekap harian otomatis ke grup pengawasan petugas dan pimpinan.</div>
      </div>
    </div>

    <div class="portal-feature-item">
      <div class="portal-feature-icon" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
        <i class="bi bi-robot"></i>
      </div>
      <div>
        <div class="portal-feature-title">Asisten AI Cerdas</div>
        <div class="portal-feature-text">Tanya jawab data dan analisis tren kinerja berbasis Natural Language Query.</div>
      </div>
    </div>
  </div>
</div>
