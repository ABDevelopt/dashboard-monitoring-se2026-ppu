      <path d="M390 370 L438 130 L482 130 L530 370 Z" fill="var(--ppu-fill)" stroke="var(--ppu-stroke)" stroke-width="2.4" />
      
      <!-- Tower Cross-Bracing -->
      <line x1="402" y1="320" x2="518" y2="320" stroke="var(--ppu-stroke)" stroke-width="1.8" />
      <line x1="390" y1="370" x2="518" y2="320" stroke="var(--ppu-stroke)" stroke-width="1.4" stroke-dasharray="4 4" />
      <line x1="530" y1="370" x2="402" y2="320" stroke="var(--ppu-stroke)" stroke-width="1.4" stroke-dasharray="4 4" />

      <line x1="416" y1="260" x2="504" y2="260" stroke="var(--ppu-stroke)" stroke-width="1.8" />
      <line x1="402" y1="320" x2="504" y2="260" stroke="var(--ppu-stroke)" stroke-width="1.4" stroke-dasharray="4 4" />
      <line x1="518" y1="320" x2="416" y2="260" stroke="var(--ppu-stroke)" stroke-width="1.4" stroke-dasharray="4 4" />

      <line x1="428" y1="190" x2="492" y2="190" stroke="var(--ppu-stroke)" stroke-width="1.8" />
      <line x1="416" y1="260" x2="492" y2="190" stroke="var(--ppu-stroke)" stroke-width="1.4" stroke-dasharray="4 4" />
      <line x1="504" y1="260" x2="428" y2="190" stroke="var(--ppu-stroke)" stroke-width="1.4" stroke-dasharray="4 4" />

      <!-- Mid Observation Balcony -->
      <rect x="412" y="256" width="96" height="8" rx="2" fill="var(--card-bg)" stroke="var(--ppu-accent)" stroke-width="2" />
      <line x1="408" y1="252" x2="512" y2="252" stroke="var(--ppu-accent)" stroke-width="1.5" />

      <!-- Top Observation & Telemetry Deck -->
      <path d="M424 130 L406 95 L514 95 L496 130 Z" fill="var(--card-bg)" stroke="var(--ppu-accent)" stroke-width="2.2" />
      <line x1="416" y1="110" x2="504" y2="110" stroke="var(--ppu-beam)" stroke-width="3.5" stroke-linecap="round" />
      <rect x="416" y="88" width="88" height="7" rx="1" fill="none" stroke="var(--ppu-stroke)" stroke-width="1.6" />

      <!-- Parabolic Radar Dish Antenna -->
      <path d="M430 88 Q445 66 460 66 Q475 66 490 88" fill="none" stroke="var(--ppu-accent)" stroke-width="2.2" />
      <line x1="460" y1="66" x2="460" y2="56" stroke="var(--ppu-accent)" stroke-width="2" />

      <!-- Spire Mast & Antenna -->
      <line x1="460" y1="95" x2="460" y2="35" stroke="var(--ppu-accent)" stroke-width="2.8" />
      <line x1="450" y1="52" x2="470" y2="52" stroke="var(--ppu-stroke)" stroke-width="1.6" />
      <line x1="453" y1="44" x2="467" y2="44" stroke="var(--ppu-stroke)" stroke-width="1.6" />

      <!-- Active Pulsing Beacon Orb on Tower Peak -->
      <circle cx="460" cy="35" r="6" fill="#f97316" class="tower-beacon-blink" />
      <circle cx="460" cy="35" r="12" stroke="#f97316" stroke-width="1.5" opacity="0.8" />
    </svg>

    <!-- Foreground Content Layer -->
    <div class="hero-content-layer">
      <!-- Clean Static Title -->
      <h1 class="hero-portal-title">PANANYO TAKA</h1>

      <!-- Subtitle & Separated BPS PPU Highlight -->
      <div class="hero-sub-wrap">
        <p class="hero-meaning-sub">Portal Pemantauan Sensus dan Survei Lapangan</p>
        <div class="hero-satker-highlight">
          <span class="bps-pill-tag">BPS</span>
          <span class="ppu-pill-name">Kabupaten Penajam Paser Utara</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ══════════════════════════════════════════════════════
       SURVEY CARDS GRID: PEMBEDAAN SENSUS VS SURVEI
       ══════════════════════════════════════════════════════ -->
  <main class="portal-cards-grid">
    <% _list.forEach(s => { %>
      <article class="survey-card theme-<%= s.theme %> card-category-<%= s.category || 'survei' %>">
        <div>
          <!-- Corner Badge Pojok Kanan Mentok (Category Type) -->
          <span class="card-corner-badge badge-<%= s.category || 'survei' %>">
            <i class="bi <%= s.categoryIcon || (s.category === 'sensus' ? 'bi-globe2' : 'bi-pie-chart-fill') %>"></i>
            <%= s.categoryBadge || (s.category === 'sensus' ? 'Sensus Lengkap' : 'Survei Sampel') %>
          </span>



          <!-- Nama Survei / Sensus (Fokus Utama) -->
          <h2 class="survey-name"><%= s.name %></h2>
          <div class="survey-tagline">
            <%= s.tagline || (s.id === 'se2026' ? 'Cakupan 54 Desa/Kelurahan se-PPU &amp; IKN Nusantara' : (s.id === 'sakernas-pemutakhiran' ? 'Tahap 1: Pemutakhiran Muatan Blok Sensus' : 'Tahap 2: Pencacahan Sampel Rumahtangga (CAPI)')) %>
          </div>

          <!-- Progress Ringkas -->
          <div class="survey-progress-box">
            <div class="progress-head">
              <span>Progres Lapangan</span>
              <span class="persen-val" style="color: <%= s.themeColor %>;"><%= s.persen %>%</span>
            </div>
            <div class="progress-bar-track">
              <div class="progress-bar-fill" style="background: linear-gradient(90deg, <%= s.themeColor %>, <%= s.themeSecondary || '#facc15' %>); width: <%= Math.min(100, Math.max(0, s.persen)) %>%;"></div>
            </div>
            <div class="progress-foot">
              <span>Realisasi: <strong><%= s.realisasi.toLocaleString('id-ID') %></strong> <%= s.unitName %></span>
              <span>Target: <strong><%= s.target.toLocaleString('id-ID') %></strong></span>
            </div>
          </div>
        </div>

        <!-- Tombol Buka Dasbor (Fokus Utama) -->
        <div>
          <a href="<%= s.route %>" class="btn-open-dashboard btn-theme-<%= s.theme %>">
            <span>Buka Dasbor <%= s.shortName %></span>
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </article>
    <% }) %>
  </main>



</div>

<!-- Clean up tower spotlight rig after animation completes (Sekali saja) -->
<script>
  (function() {
    const spotRig = document.getElementById('towerSpotlightRig');
    if (spotRig) {
      setTimeout(() => {
        if (spotRig && spotRig.parentNode) {
          spotRig.remove();
        }
      }, 2300);
    }
  })();
</script>
