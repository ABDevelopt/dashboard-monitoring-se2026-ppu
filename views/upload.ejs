<%
  const hideMuatanUpload = (typeof hideMuatanGlobal !== 'undefined' && hideMuatanGlobal) || (typeof activeSurvey !== 'undefined' && activeSurvey !== 'se2026');
  let uploadType = activeTab || 'fasih';
  if (hideMuatanUpload && uploadType === 'muatan') uploadType = 'fasih';
  const mUploads = typeof muatanUploads !== 'undefined' ? muatanUploads : [];
  const fUploads = typeof fasihUploads !== 'undefined' ? fasihUploads : [];
  const uploads = uploadType === 'muatan' ? mUploads : (uploadType === 'fasih' ? fUploads : []);
%>
<div class="fade-in">
  <!-- TAB NAVIGATION (Hanya tampil jika SE2026 yang memiliki opsi upload multi-tipe) -->
  <% if (!hideMuatanUpload) { %>
  <div style="display: flex; gap: 10px; margin-bottom: 24px; border-bottom: 1px solid var(--border); padding-bottom: 12px; flex-wrap: wrap;">
    <a href="<%= navPrefix %>/admin/upload?tab=fasih" class="btn <%= uploadType === 'fasih' ? 'btn-primary' : 'btn-secondary' %>" style="border-radius: 24px; padding: 8px 20px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; transition: all 0.2s;">
      <i class="bi bi-file-earmark-code-fill <%= uploadType === 'fasih' ? '' : 'text-purple' %>"></i> Status FASIH
    </a>
    <a href="<%= navPrefix %>/admin/upload?tab=muatan" class="btn <%= uploadType === 'muatan' ? 'btn-primary' : 'btn-secondary' %>" style="border-radius: 24px; padding: 8px 20px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; transition: all 0.2s;">
      <i class="bi bi-people-fill <%= uploadType === 'muatan' ? '' : 'text-cyan' %>"></i> Progres Muatan
    </a>
    <a href="<%= navPrefix %>/admin/upload?tab=ujipetik" class="btn <%= uploadType === 'ujipetik' ? 'btn-primary' : 'btn-secondary' %>" style="border-radius: 24px; padding: 8px 20px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; transition: all 0.2s;">
      <i class="bi bi-pin-map-fill <%= uploadType === 'ujipetik' ? '' : 'text-amber' %>"></i> Titik Uji Petik
    </a>
  </div>
  <% } %>

  <% if (uploadType === 'ujipetik') { %>
    <!-- TITIK UJI PETIK UPLOAD INTERFACE -->

    <!-- FASIH-SM CLOUD AUTOMATED SPATIAL API SYNC CARD -->
    <div class="card mb-4" style="border: 1px solid rgba(245, 158, 11, 0.35); box-shadow: 0 4px 20px rgba(245, 158, 11, 0.08);">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-bottom: 1px solid rgba(245, 158, 11, 0.2); background: rgba(245, 158, 11, 0.05); padding: 12px 18px;">
        <div class="card-title" style="display: flex; align-items: center; gap: 8px;">
          <i class="bi bi-cloud-arrow-down-fill text-amber" style="font-size: 18px;"></i>
          <span style="font-weight: 700; color: var(--text-primary);">⚡ Sinkronisasi Titik Spasial Otomatis via API (FASIH-SM Cloud)</span>
        </div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <span id="spatialApiStatusBadge" class="badge" style="background: rgba(148, 163, 184, 0.15); color: var(--text-muted); border: 1px solid rgba(148, 163, 184, 0.3); font-size: 11px; padding: 5px 10px; display: inline-flex; align-items: center; gap: 6px;">
            <i class="bi bi-arrow-repeat spin"></i> Memeriksa server...
          </span>
          <button type="button" id="btnRefreshSpatialStatus" class="btn btn-secondary btn-sm" style="padding: 4px 8px; font-size: 11px;" title="Cek Ulang Koneksi API">
            <i class="bi bi-arrow-clockwise"></i>
          </button>
        </div>
      </div>

      <div style="padding: 20px;">
        <p style="font-size: 12.5px; color: var(--text-secondary); margin-bottom: 16px; line-height: 1.5;">
          Tarik data koordinat geotagging dan status bangunan (75.467 titik PPU) langsung dari server <strong>FASIH-SM Cloud</strong> secara otomatis tanpa perlu mengunggah berkas Excel/CSV secara manual.
        </p>

        <form action="<%= navPrefix %>/admin/upload/api-sync-spatial" method="POST" id="spatialApiSyncForm">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; margin-bottom: 16px;">
            <div>
              <label style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary); font-weight: 600;">
                <i class="bi bi-gear-fill text-amber"></i> Mode Sinkronisasi
              </label>
              <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12.5px; color: var(--text-primary); background: var(--bg-secondary); padding: 10px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border);">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                  <input type="radio" name="mode" value="replace" checked>
                  <span><strong>Gantikan data lama (Replace)</strong> <span style="font-size: 11px; color: var(--text-muted);">(Disarankan: 75.467 titik mutakhir)</span></span>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                  <input type="radio" name="mode" value="append">
                  <span><strong>Tambahkan (Append)</strong> <span style="font-size: 11px; color: var(--text-muted);">(Sisipkan titik baru tanpa hapus yang lama)</span></span>
                </label>
              </div>
            </div>

            <div>
              <label style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary); font-weight: 600;">
                <i class="bi bi-info-circle-fill text-cyan"></i> Informasi Dataset Cloud
              </label>
              <div style="background: var(--bg-secondary); padding: 10px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border); font-size: 12px; color: var(--text-secondary); height: 68px; display: flex; flex-direction: column; justify-content: center; gap: 4px;">
                <div id="spatialInfoSummary">
                  <span class="text-muted"><i class="bi bi-hourglass-split"></i> Memuat informasi titik dari server...</span>
                </div>
              </div>
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; padding-top: 12px; border-top: 1px solid var(--border);">
            <a href="<%= navPrefix %>/map-ujipetik" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 600;">
              <i class="bi bi-map text-cyan"></i> Buka Peta Spasial Uji Petik
            </a>

            <button type="submit" id="btnSyncSpatialSubmit" class="btn btn-primary" style="background: #f59e0b; border-color: #f59e0b; color: #000; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; padding: 9px 20px;">
              <i class="bi bi-lightning-charge-fill"></i>
              <span>Tarik Titik Spasial Sekarang</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px; margin-bottom: 24px;">
      
      <!-- Upload Card -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <span><i class="bi bi-pin-map-fill text-amber"></i> Upload Data Titik Uji Petik (Excel / CSV)</span>
          </div>
        </div>
        
        <form action="<%= navPrefix %>/admin/upload/ujipetik" method="POST" enctype="multipart/form-data" id="ujipetikForm">
          <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px;">
            Unggah file Excel (.xlsx/.xls) atau CSV hasil geotagging titik uji petik bangunan sensus. Data ini akan dipetakan langsung pada <strong>Peta Titik Uji Petik Spasial</strong>.
          </p>

          <div style="margin-bottom: 16px;">
            <label for="ujipetikFile" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);">
              <i class="bi bi-file-earmark-excel text-amber"></i> File Excel atau CSV Titik Uji Petik
            </label>
            <div class="upload-zone" id="uploadZoneUjipetik" style="height: 140px; padding: 10px; border-color: rgba(245, 158, 11, 0.4);">
              <div class="upload-zone-icon" style="font-size: 24px; margin-bottom: 4px; color: #f59e0b;"><i class="bi bi-cloud-arrow-up"></i></div>
              <div class="upload-zone-title" style="font-size: 12px; font-weight: 600; color: #f59e0b;">Titik Uji Petik (Excel / CSV)</div>
              <div class="upload-zone-sub" style="font-size: 10px;">atau seret file ke sini (.xlsx, .xls, .csv)</div>
              <input type="file" id="ujipetikFile" name="ujipetikFile" accept=".xlsx, .xls, .csv" required style="display: none;">
            </div>
          </div>

          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);">
              <i class="bi bi-gear-fill"></i> Mode Pemrosesan Data
            </label>
            <div style="display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--text-secondary);">
              <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="radio" name="mode" value="replace" checked>
                <span><strong>Gantikan data lama</strong> (Hapus data sebelumnya &amp; gunakan data baru ini)</span>
              </label>
              <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="radio" name="mode" value="append">
                <span><strong>Tambahkan</strong> (Sisipkan titik baru ke database tanpa menghapus data lama)</span>
              </label>
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end;">
            <button type="submit" class="btn btn-primary" style="background: #f59e0b; border-color: #f59e0b; color: #000; font-weight: 700;">
              <i class="bi bi-lightning-charge-fill"></i> Mulai Impor Titik Uji Petik
            </button>
          </div>
        </form>
      </div>

      <!-- Current Database Status & Actions -->
      <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
          <div class="card-title">
            <span><i class="bi bi-database-check text-cyan"></i> Status Data Titik Saat Ini</span>
          </div>
          <span class="badge badge-amber"><%= (typeof ujipetikStats !== 'undefined' && ujipetikStats) ? ujipetikStats.total.toLocaleString('id-ID') : 0 %> Titik</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 18px;">
          <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 10px; padding: 12px;">
            <span style="font-size: 11px; font-weight: 600; color: #f59e0b; display: block; text-transform: uppercase;">Total Titik</span>
            <strong style="font-size: 22px; color: var(--text-primary);"><%= (typeof ujipetikStats !== 'undefined' && ujipetikStats) ? ujipetikStats.total.toLocaleString('id-ID') : 0 %></strong>
          </div>
          <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 10px; padding: 12px;">
            <span style="font-size: 11px; font-weight: 600; color: #10b981; display: block; text-transform: uppercase;">Berpenghuni / Berisi</span>
            <strong style="font-size: 22px; color: #10b981;"><%= (typeof ujipetikStats !== 'undefined' && ujipetikStats) ? ujipetikStats.isi.toLocaleString('id-ID') : 0 %></strong>
          </div>
          <div style="background: rgba(100, 116, 139, 0.1); border: 1px solid rgba(100, 116, 139, 0.25); border-radius: 10px; padding: 12px;">
            <span style="font-size: 11px; font-weight: 600; color: #94a3b8; display: block; text-transform: uppercase;">Bangunan Kosong</span>
            <strong style="font-size: 22px; color: #94a3b8;"><%= (typeof ujipetikStats !== 'undefined' && ujipetikStats) ? ujipetikStats.kosong.toLocaleString('id-ID') : 0 %></strong>
          </div>
          <div style="background: rgba(2, 132, 199, 0.1); border: 1px solid rgba(2, 132, 199, 0.25); border-radius: 10px; padding: 12px;">
            <span style="font-size: 11px; font-weight: 600; color: #0284c7; display: block; text-transform: uppercase;">Petugas PCL</span>
            <strong style="font-size: 22px; color: #0284c7;"><%= (typeof ujipetikStats !== 'undefined' && ujipetikStats && ujipetikStats.pcls) ? ujipetikStats.pcls.length : 0 %></strong>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: auto;">
          <a href="<%= navPrefix %>/map-ujipetik" class="btn btn-primary" style="display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 600; padding: 9px;">
            <i class="bi bi-map-fill"></i> Buka Peta Titik Uji Petik Spasial
          </a>

          <% if (typeof ujipetikStats !== 'undefined' && ujipetikStats && ujipetikStats.total > 0) { %>
          <form action="<%= navPrefix %>/admin/upload/ujipetik/clear" method="POST" onsubmit="return confirm('PERINGATAN: Apakah Anda yakin ingin MENGHAPUS SEMUA DATA TITIK UJI PETIK? Seluruh titik pada peta akan dikosongkan.');" style="margin: 0;">
            <button type="submit" class="btn btn-danger" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px; font-size: 12px; font-weight: 600; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #ef4444;">
              <i class="bi bi-trash3-fill"></i> Kosongkan Seluruh Data Titik Uji Petik
            </button>
          </form>
          <% } %>
        </div>
      </div>
    </div>

    <!-- RIWAYAT UPLOAD TITIK UJI PETIK -->
    <div class="card mt-4">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <div class="card-title">
          <span><i class="bi bi-clock-history text-amber"></i> Riwayat Upload &amp; Histori Titik Uji Petik</span>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
          <% if (typeof ujipetikUploads !== 'undefined' && ujipetikUploads && ujipetikUploads.length > 0) { %>
            <% const latestUjipetik = ujipetikUploads[0]; %>
            <form action="<%= navPrefix %>/admin/upload/ujipetik/delete/<%= latestUjipetik.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin membatalkan/rollback upload terakhir (<%= latestUjipetik.filename || 'ID: ' + latestUjipetik.id %>)? Data titik pada upload ini akan dihapus/dikembalikan ke kondisi sebelumnya.');" style="margin: 0;">
              <button type="submit" class="btn btn-danger btn-sm" style="background: var(--accent-red); border-color: var(--accent-red); color: white; display: flex; align-items: center; gap: 6px; padding: 4px 10px; font-size: 12px; font-weight: 600; border-radius: 6px; transition: var(--transition);">
                <i class="bi bi-arrow-counterclockwise"></i> Rollback ke Data Sebelumnya
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <% if (typeof ujipetikUploads !== 'undefined' && ujipetikUploads && ujipetikUploads.length > 0) { %>
        <!-- Filter Search Box -->
        <div style="margin-bottom: 12px; display: flex; justify-content: flex-end;">
          <div style="position: relative; width: 100%; max-width: 260px;">
            <i class="bi bi-search" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 12px;"></i>
            <input type="text" id="ujipetikUploadsSearch" placeholder="Cari nama file / tanggal..." style="width: 100%; padding: 6px 10px 6px 30px; font-size: 12px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary);">
          </div>
        </div>

        <div class="table-wrap">
          <table id="ujipetikUploadsTable">
            <thead>
              <tr>
                <th style="width: 40px;" class="text-center">#</th>
                <th style="width: 60px;" class="hide-md">ID</th>
                <th>Nama File Titik</th>
                <th style="width: 120px;">Mode Impor</th>
                <th style="width: 140px;" class="text-right">Total Titik</th>
                <th style="width: 160px;" class="hide-md">Waktu Upload</th>
                <th style="width: 100px;" class="text-center">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% ujipetikUploads.forEach((u, index) => { %>
                <tr class="<%= index >= 5 ? 'ujipetik-row-more' : '' %>" style="<%= index >= 5 ? 'display: none;' : '' %>">
                  <td class="text-center" style="font-weight: 600; background: var(--bg-subtle);"><%= index + 1 %></td>
                  <td class="td-code hide-md"><%= u.id %></td>
                  <td class="td-primary">
                    <% const isXls = u.filename.toLowerCase().endsWith('.xlsx') || u.filename.toLowerCase().endsWith('.xls'); %>
                    <div>
                      <i class="bi <%= isXls ? 'bi-file-earmark-excel text-amber' : 'bi-filetype-csv text-amber' %>" style="margin-right: 4px;"></i>
                      <strong><%= u.filename %></strong>
                    </div>
                  </td>
                  <td>
                    <% if (u.mode === 'append') { %>
                      <span class="badge" style="background: rgba(14, 165, 233, 0.15); color: #0ea5e9; border: 1px solid rgba(14, 165, 233, 0.3);">Tambahkan</span>
                    <% } else { %>
                      <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">Gantikan</span>
                    <% } %>
                  </td>
                  <td class="text-right fw-bold td-primary">
                    <%= (u.total_titik || 0).toLocaleString('id-ID') %>
                    <div style="font-size: 11px; font-weight: normal; color: var(--text-muted);">
                      <span class="text-green"><%= (u.total_isi || 0).toLocaleString('id-ID') %> isi</span> &bull; 
                      <span class="text-muted"><%= (u.total_kosong || 0).toLocaleString('id-ID') %> kosong</span>
                    </div>
                  </td>
                  <td class="hide-md"><%= formatWitaShort(u.created_at) %> WITA</td>
                  <td class="text-center" style="display: flex; gap: 4px; justify-content: center; align-items: center;">
                    <% if (u.stored_filename) { %>
                      <a href="<%= navPrefix %>/admin/upload/ujipetik/download/<%= u.id %>" download class="btn btn-secondary" style="padding: 4px 8px;" title="Download File Titik Uji Petik" aria-label="Unduh File <%= u.filename %>"><i class="bi bi-download"></i></a>
                    <% } %>
                    <form action="<%= navPrefix %>/admin/upload/ujipetik/delete/<%= u.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus data riwayat upload titik uji petik ID <%= u.id %> (<%= u.filename %>)?');" style="margin: 0;">
                      <button type="submit" class="btn btn-secondary text-red" style="padding: 4px 8px;" title="Hapus / Batalkan Upload Ini" aria-label="Hapus Upload ID <%= u.id %>"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (ujipetikUploads.length > 5) { %>
          <div style="text-align: center; margin-top: 14px;" id="moreUjipetikContainer">
            <button type="button" id="btnToggleUjipetik" class="btn btn-secondary" style="font-size: 12.5px; font-weight: 600; padding: 7px 20px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; transition: all 0.2s ease;">
              <i class="bi bi-chevron-down" id="toggleUjipetikIcon"></i>
              <span id="toggleUjipetikText">Lihat Selengkapnya (<%= ujipetikUploads.length - 5 %> Upload Lainnya)</span>
            </button>
          </div>
        <% } %>
      <% } else { %>
        <div class="empty-state" style="padding: 30px; text-align: center; color: var(--text-muted);">
          <i class="bi bi-inbox" style="font-size: 32px; display: block; margin-bottom: 8px;"></i>
          <p style="font-size: 13px; margin: 0;">Belum ada riwayat upload titik uji petik. Silakan unggah berkas Excel atau CSV di atas.</p>
        </div>
      <% } %>
    </div>

    <!-- Petunjuk Format File Excel / CSV -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <span><i class="bi bi-info-circle-fill text-cyan"></i> Format Kolom File yang Didukung (Excel .xlsx / .xls &amp; CSV .csv)</span>
        </div>
      </div>
      <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px;">
        Sistem secara otomatis mendeteksi kolom berdasarkan nama baris <em>header</em> (tidak terikat pada urutan kolom tertentu). Format kolom berikut dapat digunakan:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Nama Kolom (Variasi Header)</th>
              <th>Contoh Nilai</th>
              <th>Keterangan</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><code>level_6_full_code</code> / <code>kode_sls</code></td><td>6409010008000502</td><td>Kode SLS / Wilayah 16 Digit (Wajib)</td></tr>
            <tr><td><code>Label</code> / <code>label</code></td><td>Kios Kelontong / Rumah Bpk Ahmad</td><td>Label / Nama Usaha / Keterangan Bangunan</td></tr>
            <tr><td><code>no_bang</code></td><td>001 / 012B</td><td>Nomor Bangunan Fisik</td></tr>
            <tr><td><code>kode_bang_label</code> / <code>kategori</code></td><td>1. Bangunan Khusus Usaha</td><td>Klasifikasi Kategori Bangunan</td></tr>
            <tr><td><code>geotag_latitude</code> / <code>latitude</code></td><td>-1.314562</td><td>Koordinat Latitude (Wajib)</td></tr>
            <tr><td><code>geotag_longitude</code> / <code>longitude</code></td><td>116.654321</td><td>Koordinat Longitude (Wajib)</td></tr>
            <tr><td><code>Kosong</code> / <code>is_kosong</code></td><td>0 atau 1</td><td>1 = Bangunan Kosong, 0 = Berpenghuni (Opsional, otomatis dideteksi dari teks label jika kolom ini tidak ada)</td></tr>
            <tr><td><code>PCL</code> / <code>pcl</code></td><td>Nama Petugas PCL</td><td>Petugas Lapangan</td></tr>
            <tr><td><code>PML</code> / <code>pml</code></td><td>Nama Pengawas PML</td><td>Pengawas Lapangan</td></tr>
            <tr><td><code>KORLAP</code> / <code>korlap</code></td><td>Nama Koordinator Lapangan</td><td>Koordinator Lapangan</td></tr>
          </tbody>
        </table>
      </div>
    </div>

  <% } else { %>
    <!-- NON-UJIPETIK UPLOADS INTERFACE (FASIH / MUATAN) -->
    <% if (uploadType === 'fasih') { %>
      <!-- FASIH-SM CLOUD AUTOMATED API SYNC CARD -->
      <div class="card mb-4" style="border: 1px solid rgba(139, 92, 246, 0.35); box-shadow: 0 4px 20px rgba(139, 92, 246, 0.08);">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-bottom: 1px solid rgba(139, 92, 246, 0.2); background: rgba(139, 92, 246, 0.05); padding: 12px 18px;">
          <div class="card-title" style="display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-cloud-arrow-down-fill text-purple" style="font-size: 18px;"></i>
            <span style="font-weight: 700; color: var(--text-primary);">⚡ Sinkronisasi Otomatis via API (FASIH-SM Cloud)</span>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <span id="apiStatusBadge" class="badge" style="background: rgba(148, 163, 184, 0.15); color: var(--text-muted); border: 1px solid rgba(148, 163, 184, 0.3); font-size: 11px; padding: 5px 10px; display: inline-flex; align-items: center; gap: 6px;">
              <i class="bi bi-arrow-repeat spin"></i> Memeriksa server...
            </span>
            <button type="button" id="btnRefreshStatus" class="btn btn-secondary btn-sm" style="padding: 4px 8px; font-size: 11px;" title="Cek Ulang Koneksi API">
              <i class="bi bi-arrow-clockwise"></i>
            </button>
          </div>
        </div>

        <div style="padding: 20px;">
          <p style="font-size: 12.5px; color: var(--text-secondary); margin-bottom: 16px; line-height: 1.5;">
            Tarik data progres dan rekap status seluruh SLS (<%= (typeof activeSurvey !== 'undefined' && activeSurvey === 'se2026') ? '1.042 SLS PPU' : 'seluruh SLS' %>) langsung dari server <strong>FASIH-SM Cloud BPS</strong> secara otomatis tanpa perlu mengunduh file spreadsheet secara manual.
          </p>

          <form action="<%= navPrefix %>/admin/upload/api-sync" method="POST" id="apiSyncForm">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; margin-bottom: 16px;">
              <div>
                <label for="apiDate" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary); font-weight: 600;">
                  <i class="bi bi-calendar3 text-purple"></i> Tanggal Data Rekap
                </label>
                <input type="date" id="apiDate" name="date" required style="width: 100%; padding: 10px 12px; font-size: 13px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary);" value="<%= new Date().toISOString().slice(0, 10) %>">
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Pilih tanggal data yang ingin ditarik ke dalam sistem monitoring.</p>
              </div>

              <div>
                <label style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary); font-weight: 600;">
                  <i class="bi bi-broadcast text-green"></i> Notifikasi Progres
                </label>
                <label style="display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-secondary); cursor: pointer; height: 42px;">
                  <input type="checkbox" name="trigger_wa" value="1" id="cbTriggerWa">
                  <span style="font-size: 12.5px; color: var(--text-primary);"><i class="bi bi-whatsapp text-green"></i> Kirim Notifikasi WhatsApp Otomatis</span>
                </label>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Kirim pesan rekapitulasi progres harian ke nomor admin/grup terdaftar.</p>
              </div>
            </div>

            <!-- COLLAPSIBLE API CONFIG -->
            <details style="margin-bottom: 18px; border: 1px dashed var(--border); border-radius: var(--radius-sm); padding: 10px 14px; background: var(--bg-secondary);">
              <summary style="font-size: 12px; font-weight: 600; color: var(--text-secondary); cursor: pointer; display: flex; align-items: center; gap: 6px;">
                <i class="bi bi-sliders text-cyan"></i> Konfigurasi Sambungan API (URL Endpoint &amp; Token)
              </summary>
              <div style="margin-top: 12px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 12px;">
                <div>
                  <label for="apiUrlInput" style="display: block; font-size: 11.5px; color: var(--text-muted); margin-bottom: 4px;">Endpoint API FASIH Cloud</label>
                  <input type="text" id="apiUrlInput" name="apiUrl" value="<%= (typeof fasihApiConfig !== 'undefined' && fasihApiConfig.apiUrl) ? fasihApiConfig.apiUrl : 'http://43.163.98.53/api/sync/monitoring-data' %>" style="width: 100%; padding: 8px 10px; font-size: 12px; font-family: monospace; border-radius: 4px; border: 1px solid var(--border); background: var(--bg-primary); color: var(--text-primary);">
                </div>
                <div>
                  <label for="apiKeyInput" style="display: block; font-size: 11.5px; color: var(--text-muted); margin-bottom: 4px;">Token Rahasia (X-FASIH-API-KEY)</label>
                  <div style="position: relative;">
                    <input type="password" id="apiKeyInput" name="apiKey" value="<%= (typeof fasihApiConfig !== 'undefined' && fasihApiConfig.apiKey) ? fasihApiConfig.apiKey : 'fasih_ppu_sync_secret_token_2026' %>" style="width: 100%; padding: 8px 36px 8px 10px; font-size: 12px; font-family: monospace; border-radius: 4px; border: 1px solid var(--border); background: var(--bg-primary); color: var(--text-primary);">
                    <button type="button" id="btnToggleApiKey" style="position: absolute; right: 6px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 4px;">
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                </div>
              </div>
              <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <label style="display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--text-secondary); cursor: pointer;">
                  <input type="checkbox" name="saveConfig" value="1">
                  <span>Simpan konfigurasi URL &amp; Token ke database</span>
                </label>
                <button type="button" id="btnTestConn" class="btn btn-secondary btn-sm" style="font-size: 11.5px; padding: 4px 12px;">
                  <i class="bi bi-reception-4"></i> Test Sambungan Sekarang
                </button>
              </div>
            </details>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
              <div style="font-size: 11.5px; color: var(--text-muted);">
                <i class="bi bi-shield-check text-green"></i> Terproteksi X-FASIH-API-KEY &bull; Parsing otomatis 100% format smallcode BPS
              </div>
              <button type="submit" id="btnSubmitSync" class="btn btn-primary" style="background: linear-gradient(135deg, #8b5cf6, #6366f1); border: none; font-weight: 700; padding: 10px 24px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(139, 92, 246, 0.35); cursor: pointer; transition: all 0.2s;">
                <i class="bi bi-lightning-charge-fill text-amber"></i> Tarik &amp; Perbarui Data Sekarang
              </button>
            </div>
          </form>
        </div>
      </div>
    <% } %>

    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <span><i class="bi bi-upload"></i> <%= uploadType === 'fasih' ? 'Upload Berkas Status FASIH Manual (Excel / CSV / JSON)' : 'Upload File Progres Muatan Baru' %></span>
        </div>
      </div>
      
      <form action="<%= navPrefix %>/admin/upload/<%= uploadType %>" method="POST" enctype="multipart/form-data" id="uploadForm">
        <div class="mb-4">
          <label for="tanggal" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);"><i class="bi bi-calendar3"></i> Tanggal Data Rekap</label>
          <input type="date" id="tanggal" name="tanggal" required style="width: 100%; max-width: 300px; padding: 10px; font-size: 13px;" value="<%= new Date().toISOString().slice(0, 10) %>">
          <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Pilih tanggal pelaksanaan pendataan/sensus yang diwakili oleh data ini (biasanya tanggal hari ini atau kemarin).</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; margin-bottom: 20px;">
          <% if (uploadType === 'muatan' && !hideMuatanUpload) { %>
            <div>
              <label for="keluargaFile" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);"><i class="bi bi-people-fill text-cyan"></i> File Progres Keluarga (Opsional)</label>
              <div class="upload-zone" id="uploadZoneKeluarga" style="height: 140px; padding: 10px;">
                <div class="upload-zone-icon" style="font-size: 24px; margin-bottom: 4px;"><i class="bi bi-cloud-arrow-up"></i></div>
                <div class="upload-zone-title" style="font-size: 12px; font-weight: 600;">Progres Keluarga (Excel/CSV)</div>
                <div class="upload-zone-sub" style="font-size: 10px;">atau seret ke sini (.xlsx, .xls, .csv)</div>
                <input type="file" id="keluargaFile" name="keluargaFile" accept=".xlsx, .xls, .csv" style="display: none;">
              </div>
            </div>

            <div>
              <label for="usahaFile" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);"><i class="bi bi-briefcase-fill text-orange"></i> File Progres Usaha (Opsional)</label>
              <div class="upload-zone" id="uploadZoneUsaha" style="height: 140px; padding: 10px; border-color: rgba(249, 115, 22, 0.4);">
                <div class="upload-zone-icon" style="font-size: 24px; margin-bottom: 4px; color: #f97316;"><i class="bi bi-cloud-arrow-up"></i></div>
                <div class="upload-zone-title" style="font-size: 12px; font-weight: 600; color: #f97316;">Progres Usaha (Excel/CSV)</div>
                <div class="upload-zone-sub" style="font-size: 10px;">atau seret ke sini (.xlsx, .xls, .csv)</div>
                <input type="file" id="usahaFile" name="usahaFile" accept=".xlsx, .xls, .csv" style="display: none;">
              </div>
            </div>
          <% } else { %>
            <div>
              <label for="statusFile" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);"><i class="bi bi-file-earmark-code-fill text-purple"></i> File Status FASIH / Rekap Petugas</label>
              <div class="upload-zone" id="uploadZoneStatus" style="height: 140px; padding: 10px; border-color: rgba(139, 92, 246, 0.4);">
                <div class="upload-zone-icon" style="font-size: 24px; margin-bottom: 4px; color: var(--accent-purple);"><i class="bi bi-cloud-arrow-up"></i></div>
                <div class="upload-zone-title" style="font-size: 12px; font-weight: 600; color: var(--accent-purple);">Status FASIH (Excel/CSV/JSON)</div>
                <div class="upload-zone-sub" style="font-size: 10px;">atau seret ke sini (.xlsx, .xls, .csv, .json)</div>
                <input type="file" id="statusFile" name="statusFile" accept=".xlsx, .xls, .csv, .json" required style="display: none;">
              </div>
            </div>
          <% } %>
        </div>

        <div style="display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-primary"><i class="bi bi-lightning-charge-fill"></i> Mulai Proses Upload</button>
        </div>
      </form>
    </div>

    <% if (uploadType === 'muatan' && !hideMuatanUpload) { %>
      <!-- GOOGLE SPREADSHEET SYNC CARD -->
      <div class="card mt-4">
        <div class="card-header">
          <div class="card-title">
            <span><i class="bi bi-file-earmark-spreadsheet-fill text-cyan"></i> Sinkronisasi Langsung dari Google Spreadsheet</span>
          </div>
        </div>
        
        <form action="<%= navPrefix %>/admin/upload/google-sheets" method="POST" id="g-sheets-form">
          <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 14px;">
            Masukkan URL Google Spreadsheet yang dipublikasikan (contoh: <code>/pubhtml</code> atau link ekspor CSV) untuk mengimpor data secara langsung tanpa perlu mengunduh file Excel secara manual.
          </p>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 16px; margin-bottom: 16px;">
            <div style="grid-column: span 2;">
              <label for="sheetUrl" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);"><i class="bi bi-link-45deg"></i> URL Google Spreadsheet</label>
              <input type="url" id="sheetUrl" name="sheetUrl" required placeholder="https://docs.google.com/spreadsheets/d/e/.../pubhtml" style="width: 100%; padding: 10px 12px; font-size: 13px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary);" value="https://docs.google.com/spreadsheets/d/e/2PACX-1vT2cciIGMfpN1IJpezUhI8d1m6XX7MAX7lE1G9XsSIFgeOMxLVOEuKJWvDtjiLdkdButQU95_7WoP9S/pubhtml">
            </div>

            <div>
              <label for="gDate" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);"><i class="bi bi-calendar3"></i> Tanggal Data Rekap</label>
              <input type="date" id="gDate" name="date" required style="width: 100%; padding: 10px; font-size: 13px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary);" value="<%= new Date().toISOString().slice(0, 10) %>">
            </div>

            <div>
              <label for="dataType" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);"><i class="bi bi-layers"></i> Tipe Data Spreadsheet</label>
              <select id="dataType" name="dataType" style="width: 100%; padding: 10px 12px; font-size: 13px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary);">
                <option value="excel">Progres Sensus Rekap Utama (Pivot/SLS)</option>
                <option value="keluarga">Progres Keluarga Only</option>
                <option value="usaha">Progres Usaha Only</option>
                <option value="status">Status FASIH Only</option>
              </select>
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end;">
            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--accent-cyan), #0284c7); border: none;"><i class="bi bi-arrow-repeat"></i> Sinkronkan Google Sheets</button>
          </div>
        </form>
      </div>

      <!-- TARGET HONOR CARD -->
      <div class="card mt-4">
        <div class="card-header">
          <div class="card-title">
            <span><i class="bi bi-file-earmark-excel-fill text-success"></i> Upload File Target Honor</span>
          </div>
        </div>
        
        <form action="<%= navPrefix %>/admin/upload/honor" method="POST" enctype="multipart/form-data" id="honorUploadForm">
          <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px; padding: 0 4px;">
            Upload file Excel <code>muatan_sls_pembayaran_honor.xlsx</code> untuk memperbarui target honor SLS. File ini akan diproses untuk memperbarui kolom <code>target_honor</code> di database.
          </p>
          
          <div style="margin-bottom: 20px;">
            <label for="honorFile" style="display: block; font-size: 13px; margin-bottom: 6px; color: var(--text-secondary);"><i class="bi bi-cloud-arrow-up-fill text-success"></i> File muatan_sls_pembayaran_honor.xlsx</label>
            <div class="upload-zone" id="uploadZoneHonor" style="height: 150px; padding: 15px; border-color: rgba(34, 197, 94, 0.4);">
              <div class="upload-zone-icon" style="font-size: 28px; margin-bottom: 6px; color: #22c55e;"><i class="bi bi-cloud-arrow-up"></i></div>
              <div class="upload-zone-title" style="font-size: 13px; font-weight: 600; color: #22c55e;">Pilih File Excel Target Honor</div>
              <div class="upload-zone-sub" style="font-size: 11px;">atau seret ke sini (.xlsx, .xls, .csv)</div>
              <input type="file" id="honorFile" name="honorFile" accept=".xlsx, .xls, .csv" required style="display: none;">
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end;">
            <button type="submit" class="btn btn-primary" style="background: #22c55e; border-color: #22c55e;"><i class="bi bi-lightning-charge-fill"></i> Proses Target Honor</button>
          </div>
        </form>
      </div>
    <% } %>

    <!-- RIWAYAT UPLOAD -->
    <div class="card mt-4">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <div class="card-title">
          <span><i class="bi bi-clock-history"></i> Riwayat Upload & Histori <%= uploadType === 'muatan' ? 'Progres Muatan' : 'Status FASIH' %></span>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
          <% if (uploads && uploads.length > 0) { %>
            <% const latestUpload = uploads[0]; %>
            <form action="<%= navPrefix %>/admin/upload/delete/<%= latestUpload.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin membatalkan/rollback upload terakhir (<%= latestUpload.filename || latestUpload.status_filename || 'ID: ' + latestUpload.id %>)? Data progres pada tanggal <%= latestUpload.tanggal %> akan dihapus secara permanen.');" style="margin: 0;">
              <button type="submit" class="btn btn-danger btn-sm" style="background: var(--accent-red); border-color: var(--accent-red); color: white; display: flex; align-items: center; gap: 6px; padding: 4px 10px; font-size: 12px; font-weight: 600; border-radius: 6px; transition: var(--transition);">
                <i class="bi bi-arrow-counterclockwise"></i> Rollback ke Data Sebelumnya
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <% if (uploads && uploads.length > 0) { %>
        <!-- Filter Search Box -->
        <div style="margin-bottom: 12px; display: flex; justify-content: flex-end;">
          <div style="position: relative; width: 100%; max-width: 260px;">
            <i class="bi bi-search" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 12px;"></i>
            <input type="text" id="uploadsSearch" placeholder="Cari tanggal / nama file..." style="width: 100%; padding: 6px 10px 6px 30px; font-size: 12px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary);">
          </div>
        </div>

        <div class="table-wrap">
          <table id="uploadsTable">
            <thead>
              <tr>
                <th style="width: 40px;" class="text-center">#</th>
                <th style="width: 60px;" class="hide-md">ID</th>
                <th>Nama File Rekap</th>
                <th style="width: 110px;">Tanggal Data</th>
                <th style="width: 110px;" class="text-right">Wilayah Terisi</th>
                <th style="width: 160px;" class="hide-md">Waktu Upload</th>
                <th style="width: 90px;" class="text-center">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% uploads.forEach((u, index) => { %>
                <tr class="<%= index >= 5 ? 'upload-row-more' : '' %>" style="<%= index >= 5 ? 'display: none;' : '' %>">
                  <td class="text-center" style="font-weight: 600; background: var(--bg-subtle);"><%= index + 1 %></td>
                  <td class="td-code hide-md"><%= u.id %></td>
                  <td class="td-primary">
                    <% if (uploadType === 'muatan') { %>
                      <div><i class="bi bi-file-earmark-excel text-cyan" style="margin-right: 4px;"></i> <%= u.filename %></div>
                    <% } else { %>
                      <div>
                        <% const isApiSync = (u.filename && u.filename.startsWith('API_FASIH_')) || (u.stored_filename && u.stored_filename.startsWith('api_sync_')); %>
                        <% if (isApiSync) { %>
                          <span style="display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                            <i class="bi bi-cloud-arrow-down-fill text-purple"></i>
                            <strong><%= u.status_filename || u.filename %></strong>
                            <span class="badge" style="font-size: 10px; background: rgba(139, 92, 246, 0.15); color: #a855f7; border: 1px solid rgba(139, 92, 246, 0.3); padding: 2px 6px;">
                              <i class="bi bi-lightning-charge-fill text-amber"></i> API Sync
                            </span>
                          </span>
                        <% } else { %>
                          <i class="bi bi-file-earmark-code text-purple" style="margin-right: 4px;"></i> <%= u.status_filename %>
                        <% } %>
                      </div>
                    <% } %>
                  </td>
                  <td><span class="badge badge-gray"><%= u.tanggal %></span></td>
                  <td class="text-right fw-bold td-primary"><%= u.total_subsls_terisi.toLocaleString('id-ID') %></td>
                  <td class="hide-md"><%= formatWitaShort(u.created_at) %> WITA</td>
                  <td class="text-center" style="display: flex; gap: 4px; justify-content: center; align-items: center;">
                    <% if (uploadType === 'muatan' && u.stored_filename) { %>
                      <a href="<%= navPrefix %>/admin/upload/download/<%= u.id %>" download class="btn btn-secondary" style="padding: 4px 8px;" title="Download File Excel Progres" aria-label="Unduh Excel Progres <%= u.filename %>"><i class="bi bi-download"></i></a>
                    <% } else if (u.status_filename) { %>
                      <a href="<%= navPrefix %>/admin/upload/download-status/<%= u.id %>" download class="btn btn-secondary" style="padding: 4px 8px; color: var(--accent-purple); border-color: rgba(139, 92, 246, 0.3);" title="Download File Status" aria-label="Unduh File Status <%= u.status_filename %>"><i class="bi bi-download"></i></a>
                    <% } %>
                    <form action="<%= navPrefix %>/admin/upload/delete/<%= u.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus data rekap ini?');" style="margin: 0;">
                      <button type="submit" class="btn btn-secondary text-red" style="padding: 4px 8px;" title="Hapus" aria-label="Hapus Rekap Progres ID <%= u.id %>"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (uploads.length > 5) { %>
          <div style="text-align: center; margin-top: 14px;" id="moreUploadsContainer">
            <button type="button" id="btnToggleUploads" class="btn btn-secondary" style="font-size: 12.5px; font-weight: 600; padding: 7px 20px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; transition: all 0.2s ease;">
              <i class="bi bi-chevron-down" id="toggleUploadsIcon"></i>
              <span id="toggleUploadsText">Lihat Selengkapnya (<%= uploads.length - 5 %> Upload Lainnya)</span>
            </button>
          </div>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i class="bi bi-folder-x"></i></div>
          <div class="empty-state-title">Belum Ada Data</div>
          <div class="empty-state-text">Silakan upload file rekap harian pertama Anda untuk mengaktifkan dashboard monitoring.</div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<script>
  // ===== UPLOAD DRAG & DROP ZONE INITIALIZER =====
  function initUploadZone(zoneId, inputId) {
    const zone = document.getElementById(zoneId);
    const input = document.getElementById(inputId);
    if (!zone || !input) return;

    zone.setAttribute('role', 'button');
    zone.setAttribute('tabindex', '0');

    zone.addEventListener('click', () => input.click());
    zone.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        input.click();
      }
    });
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
    zone.addEventListener('drop', e => {
      e.preventDefault();
      zone.classList.remove('drag-over');
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        input.files = files;
        if (files.length > 1) {
          const sub = zone.querySelector('.upload-zone-sub');
          if (sub) sub.textContent = `${files.length} file terpilih`;
        } else {
          const sub = zone.querySelector('.upload-zone-sub');
          if (sub) sub.textContent = `${files[0].name} (${(files[0].size/1024/1024).toFixed(1)} MB)`;
        }
        input.dispatchEvent(new Event('change'));
      }
    });
    input.addEventListener('change', () => {
      if (input.files.length > 0) {
        if (input.files.length > 1) {
          const sub = zone.querySelector('.upload-zone-sub');
          if (sub) sub.textContent = `${input.files.length} file terpilih`;
        } else {
          const sub = zone.querySelector('.upload-zone-sub');
          if (sub) sub.textContent = `${input.files[0].name}`;
        }
        zone.style.borderColor = 'var(--accent-green)';
      }
    });
  }

  function extractDateFromFilename(filename) {
    if (!filename) return null;
    const name = filename.toLowerCase();

    // Pattern 1: YYYY-MM-DD
    const ymd = name.match(/(?<!\d)(20\d{2})[-/._](0[1-9]|1[0-2])[-/._](0[1-9]|[12]\d|3[01])(?!\d)/);
    if (ymd) {
      return `${ymd[1]}-${ymd[2]}-${ymd[3]}`;
    }

    // Pattern 2: DD-MM-YYYY
    const dmy = name.match(/(?<!\d)(0[1-9]|[12]\d|3[01])[-/._](0[1-9]|1[0-2])[-/._](20\d{2})(?!\d)/);
    if (dmy) {
      return `${dmy[3]}-${dmy[2]}-${dmy[1]}`;
    }

    // Pattern 3: Textual Month (e.g. "19 juni" or "19 juni 2026")
    const months = {
      jan: '01', januari: '01', january: '01',
      feb: '02', februari: '02', february: '02',
      mar: '03', maret: '03', march: '03',
      apr: '04', april: '04',
      mei: '05', may: '05',
      jun: '06', juni: '06', june: '06',
      jul: '07', juli: '07', july: '07',
      agu: '08', agustus: '08', august: '08',
      sep: '09', september: '09',
      okt: '10', oktober: '10', october: '10',
      nov: '11', november: '11',
      des: '12', desember: '12', december: '12'
    };

    const monthKeys = Object.keys(months).sort((a,b) => b.length - a.length);
    const monthRegex = monthKeys.join('|');
    const txtDatePattern = new RegExp(`(?<!\\d)(0?[1-9]|[12]\\d|3[01])[-_\\s]+(${monthRegex})([-_\\s]+(20\\d{2}))?(?!\\d)`, 'i');
    const txtMatch = name.match(txtDatePattern);
    if (txtMatch) {
      const day = txtMatch[1].padStart(2, '0');
      const month = months[txtMatch[2].toLowerCase()];
      const year = txtMatch[4] || new Date().getFullYear().toString();
      return `${year}-${month}-${day}`;
    }

    return null;
  }

  document.addEventListener('DOMContentLoaded', () => {
    initUploadZone('uploadZoneKeluarga', 'keluargaFile');
    initUploadZone('uploadZoneUsaha', 'usahaFile');
    initUploadZone('uploadZoneStatus', 'statusFile');
    initUploadZone('uploadZoneHonor', 'honorFile');
    initUploadZone('uploadZoneUjipetik', 'ujipetikFile');
    if (typeof makeTableSortable === 'function') makeTableSortable('uploadsTable');
    if (typeof makeTableSortable === 'function') makeTableSortable('ujipetikUploadsTable');

    // Handle toggle "Lihat Selengkapnya" for Uploads History
    const btnToggleUploads = document.getElementById('btnToggleUploads');
    const uploadsSearch = document.getElementById('uploadsSearch');
    let isUploadsExpanded = false;

    if (btnToggleUploads) {
      btnToggleUploads.addEventListener('click', function () {
        isUploadsExpanded = !isUploadsExpanded;
        const extraRows = document.querySelectorAll('.upload-row-more');
        extraRows.forEach(row => {
          row.style.display = isUploadsExpanded ? '' : 'none';
        });

        const icon = document.getElementById('toggleUploadsIcon');
        const text = document.getElementById('toggleUploadsText');
        if (icon && text) {
          if (isUploadsExpanded) {
            icon.className = 'bi bi-chevron-up';
            text.textContent = 'Sembunyikan (Hanya Tampilkan 5 Terbaru)';
          } else {
            icon.className = 'bi bi-chevron-down';
            text.textContent = 'Lihat Selengkapnya (<%= uploads ? Math.max(0, uploads.length - 5) : 0 %> Upload Lainnya)';
          }
        }
      });
    }

    if (uploadsSearch) {
      uploadsSearch.addEventListener('input', function () {
        const query = this.value.trim().toLowerCase();
        const moreContainer = document.getElementById('moreUploadsContainer');
        const allRows = document.querySelectorAll('#uploadsTable tbody tr');

        if (query) {
          if (moreContainer) moreContainer.style.display = 'none';
          allRows.forEach(row => {
            const match = row.textContent.toLowerCase().includes(query);
            row.style.display = match ? '' : 'none';
          });
        } else {
          if (moreContainer) moreContainer.style.display = '';
          allRows.forEach((row, idx) => {
            if (idx < 5 || isUploadsExpanded) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });
        }
      });
    }

    // Handle toggle & search for Uji Petik Uploads History
    const btnToggleUjipetik = document.getElementById('btnToggleUjipetik');
    const ujipetikUploadsSearch = document.getElementById('ujipetikUploadsSearch');
    let isUjipetikExpanded = false;

    if (btnToggleUjipetik) {
      btnToggleUjipetik.addEventListener('click', function () {
        isUjipetikExpanded = !isUjipetikExpanded;
        const extraRows = document.querySelectorAll('.ujipetik-row-more');
        extraRows.forEach(row => {
          row.style.display = isUjipetikExpanded ? '' : 'none';
        });

        const icon = document.getElementById('toggleUjipetikIcon');
        const text = document.getElementById('toggleUjipetikText');
        if (icon && text) {
          if (isUjipetikExpanded) {
            icon.className = 'bi bi-chevron-up';
            text.textContent = 'Sembunyikan (Hanya Tampilkan 5 Terbaru)';
          } else {
            icon.className = 'bi bi-chevron-down';
            text.textContent = 'Lihat Selengkapnya (<%= typeof ujipetikUploads !== "undefined" && ujipetikUploads ? Math.max(0, ujipetikUploads.length - 5) : 0 %> Upload Lainnya)';
          }
        }
      });
    }

    if (ujipetikUploadsSearch) {
      ujipetikUploadsSearch.addEventListener('input', function () {
        const query = this.value.trim().toLowerCase();
        const moreContainer = document.getElementById('moreUjipetikContainer');
        const allRows = document.querySelectorAll('#ujipetikUploadsTable tbody tr');

        if (query) {
          if (moreContainer) moreContainer.style.display = 'none';
          allRows.forEach(row => {
            const match = row.textContent.toLowerCase().includes(query);
            row.style.display = match ? '' : 'none';
          });
        } else {
          if (moreContainer) moreContainer.style.display = '';
          allRows.forEach((row, idx) => {
            if (idx < 5 || isUjipetikExpanded) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });
        }
      });
    }

    const keluargaInput = document.getElementById('keluargaFile');
    const usahaInput = document.getElementById('usahaFile');
    const statusInput = document.getElementById('statusFile');
    const tanggalInput = document.getElementById('tanggal');

    function handleFileSelect(file) {
      if (!file || !tanggalInput) return;
      const detectedDate = extractDateFromFilename(file.name);
      if (detectedDate) {
        tanggalInput.value = detectedDate;
      }
    }

    if (keluargaInput) keluargaInput.addEventListener('change', () => { if (keluargaInput.files[0]) handleFileSelect(keluargaInput.files[0]); });
    if (usahaInput) usahaInput.addEventListener('change', () => { if (usahaInput.files[0]) handleFileSelect(usahaInput.files[0]); });
    if (statusInput) statusInput.addEventListener('change', () => { if (statusInput.files[0]) handleFileSelect(statusInput.files[0]); });

    const uploadForm = document.getElementById('uploadForm');
    if (uploadForm) {
      uploadForm.addEventListener('submit', (e) => {
        const uploadType = '<%= uploadType %>';
        if (uploadType === 'muatan') {
          const keluarga = document.getElementById('keluargaFile');
          const usaha = document.getElementById('usahaFile');
          if ((!keluarga || !keluarga.files[0]) && (!usaha || !usaha.files[0])) {
            e.preventDefault();
            alert('Silakan pilih setidaknya satu file progres muatan (Keluarga atau Usaha) untuk diupload.');
          }
        } else {
          const status = document.getElementById('statusFile');
          if (!status || !status.files[0]) {
            e.preventDefault();
            alert('Silakan pilih file status FASIH untuk diupload.');
          }
        }
      });
    }

    // ==========================================
    // FASIH-SM CLOUD API SYNC CLIENT CONTROLS
    // ==========================================
    const apiStatusBadge = document.getElementById('apiStatusBadge');
    const btnRefreshStatus = document.getElementById('btnRefreshStatus');
    const btnTestConn = document.getElementById('btnTestConn');
    const btnToggleApiKey = document.getElementById('btnToggleApiKey');
    const apiKeyInput = document.getElementById('apiKeyInput');
    const apiUrlInput = document.getElementById('apiUrlInput');
    const apiSyncForm = document.getElementById('apiSyncForm');
    const btnSubmitSync = document.getElementById('btnSubmitSync');

    async function checkApiConnection(customUrl = null, customKey = null, isManualTest = false) {
      if (!apiStatusBadge) return;
      apiStatusBadge.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Memeriksa server...';
      apiStatusBadge.style.background = 'rgba(148, 163, 184, 0.15)';
      apiStatusBadge.style.color = 'var(--text-muted)';
      apiStatusBadge.style.borderColor = 'rgba(148, 163, 184, 0.3)';

      try {
        const navPref = '<%= navPrefix %>';
        const targetEndpoint = `${navPref}/admin/upload/api-sync/status`;
        const url = new URL(targetEndpoint, window.location.origin);
        if (customUrl) url.searchParams.set('url', customUrl);
        if (customKey) url.searchParams.set('key', customKey);

        const res = await fetch(url.toString());
        const data = await res.json();

        if (data.ok && data.status === 'online') {
          apiStatusBadge.innerHTML = `<span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #10b981;"></span> Online (${data.latencyMs || 0}ms)`;
          apiStatusBadge.style.background = 'rgba(16, 185, 129, 0.15)';
          apiStatusBadge.style.color = '#10b981';
          apiStatusBadge.style.borderColor = 'rgba(16, 185, 129, 0.3)';
          if (isManualTest) {
            alert(`✅ Sambungan Berhasil!\nServer: ${data.service || 'FASIH-SM Cloud'}\nWaktu Respon: ${data.latencyMs} ms\nStatus: Online`);
          }
        } else {
          apiStatusBadge.innerHTML = `<span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #ef4444;"></span> Offline / Error`;
          apiStatusBadge.style.background = 'rgba(239, 68, 68, 0.15)';
          apiStatusBadge.style.color = '#ef4444';
          apiStatusBadge.style.borderColor = 'rgba(239, 68, 68, 0.3)';
          if (isManualTest) {
            alert(`❌ Sambungan Gagal!\n${data.error || 'Tidak dapat terhubung ke server API FASIH'}`);
          }
        }
      } catch (err) {
        apiStatusBadge.innerHTML = `<span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #ef4444;"></span> Unreachable`;
        apiStatusBadge.style.background = 'rgba(239, 68, 68, 0.15)';
        apiStatusBadge.style.color = '#ef4444';
        apiStatusBadge.style.borderColor = 'rgba(239, 68, 68, 0.3)';
        if (isManualTest) {
          alert(`❌ Sambungan Gagal: ${err.message}`);
        }
      }
    }

    if (apiStatusBadge) {
      // Auto-check on page load
      checkApiConnection();
    }

    if (btnRefreshStatus) {
      btnRefreshStatus.addEventListener('click', () => {
        checkApiConnection();
      });
    }

    if (btnTestConn) {
      btnTestConn.addEventListener('click', () => {
        const u = apiUrlInput ? apiUrlInput.value.trim() : null;
        const k = apiKeyInput ? apiKeyInput.value.trim() : null;
        checkApiConnection(u, k, true);
      });
    }

    if (btnToggleApiKey && apiKeyInput) {
      btnToggleApiKey.addEventListener('click', () => {
        if (apiKeyInput.type === 'password') {
          apiKeyInput.type = 'text';
          btnToggleApiKey.innerHTML = '<i class="bi bi-eye-slash"></i>';
        } else {
          apiKeyInput.type = 'password';
          btnToggleApiKey.innerHTML = '<i class="bi bi-eye"></i>';
        }
      });
    }

    if (apiSyncForm && btnSubmitSync) {
      apiSyncForm.addEventListener('submit', function (e) {
        btnSubmitSync.disabled = true;
        btnSubmitSync.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Sedang Menghubungi Cloud &amp; Menyinkronkan Data...';
        btnSubmitSync.style.opacity = '0.75';
      });
    }

    // ==========================================
    // SPATIAL POINTS API AUTO-CHECKER & HANDLER
    // ==========================================
    const spatialApiStatusBadge = document.getElementById('spatialApiStatusBadge');
    const btnRefreshSpatialStatus = document.getElementById('btnRefreshSpatialStatus');
    const spatialInfoSummary = document.getElementById('spatialInfoSummary');
    const spatialApiSyncForm = document.getElementById('spatialApiSyncForm');
    const btnSyncSpatialSubmit = document.getElementById('btnSyncSpatialSubmit');

    async function checkSpatialApiConnection() {
      if (!spatialApiStatusBadge) return;
      try {
        spatialApiStatusBadge.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Memeriksa server...';
        spatialApiStatusBadge.style.background = 'rgba(148, 163, 184, 0.15)';
        spatialApiStatusBadge.style.color = 'var(--text-muted)';
        spatialApiStatusBadge.style.borderColor = 'rgba(148, 163, 184, 0.3)';

        const navPref = '<%= navPrefix %>';
        const targetEndpoint = `${navPref}/admin/upload/api-sync-spatial/status`;
        const res = await fetch(targetEndpoint);
        const data = await res.json();

        if (data.ok && data.status === 'online') {
          spatialApiStatusBadge.innerHTML = `<span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #10b981;"></span> Online (${data.latencyMs || 0}ms)`;
          spatialApiStatusBadge.style.background = 'rgba(16, 185, 129, 0.15)';
          spatialApiStatusBadge.style.color = '#10b981';
          spatialApiStatusBadge.style.borderColor = 'rgba(16, 185, 129, 0.3)';

          if (spatialInfoSummary) {
            const tot = (data.totalPoints || 0).toLocaleString('id-ID');
            const isi = (data.totalIsi || 0).toLocaleString('id-ID');
            const ksg = (data.totalKosong || 0).toLocaleString('id-ID');
            spatialInfoSummary.innerHTML = `
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <span>Total di Cloud: <strong style="color: var(--text-primary);">${tot} Titik</strong></span>
                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; font-size: 10px;">Siap Tarik</span>
              </div>
              <div style="font-size: 11px; color: var(--text-muted); display: flex; gap: 10px;">
                <span><i class="bi bi-check-circle text-emerald-500"></i> ${isi} Isi</span>
                <span><i class="bi bi-dash-circle text-slate-400"></i> ${ksg} Kosong</span>
              </div>
            `;
          }
        } else {
          spatialApiStatusBadge.innerHTML = `<span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #ef4444;"></span> Offline / Error`;
          spatialApiStatusBadge.style.background = 'rgba(239, 68, 68, 0.15)';
          spatialApiStatusBadge.style.color = '#ef4444';
          spatialApiStatusBadge.style.borderColor = 'rgba(239, 68, 68, 0.3)';
          if (spatialInfoSummary) {
            spatialInfoSummary.innerHTML = `<span style="color: #ef4444;"><i class="bi bi-exclamation-triangle-fill"></i> ${data.error || 'Server spasial offline'}</span>`;
          }
        }
      } catch (err) {
        spatialApiStatusBadge.innerHTML = `<span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #ef4444;"></span> Unreachable`;
        spatialApiStatusBadge.style.background = 'rgba(239, 68, 68, 0.15)';
        spatialApiStatusBadge.style.color = '#ef4444';
        spatialApiStatusBadge.style.borderColor = 'rgba(239, 68, 68, 0.3)';
        if (spatialInfoSummary) {
          spatialInfoSummary.innerHTML = `<span style="color: #ef4444;"><i class="bi bi-exclamation-triangle-fill"></i> Gagal terhubung ke server</span>`;
        }
      }
    }

    if (spatialApiStatusBadge) {
      checkSpatialApiConnection();
    }

    if (btnRefreshSpatialStatus) {
      btnRefreshSpatialStatus.addEventListener('click', () => {
        checkSpatialApiConnection();
      });
    }

    if (spatialApiSyncForm && btnSyncSpatialSubmit) {
      spatialApiSyncForm.addEventListener('submit', function (e) {
        btnSyncSpatialSubmit.disabled = true;
        btnSyncSpatialSubmit.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Menarik 75.467 Titik dari Cloud...';
        btnSyncSpatialSubmit.style.opacity = '0.75';
      });
    }
  });
</script>
