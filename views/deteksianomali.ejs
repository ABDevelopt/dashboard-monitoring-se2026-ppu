<div class="fade-in">
  <!-- COMPACT ENTERPRISE HEADER -->
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
    <div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
          <i class="bi bi-shield-exclamation text-yellow"></i> Deteksi &amp; Audit Anomali Data
        </h1>
        <span class="badge badge-green" style="font-size: 10px; padding: 3px 8px;">
          <i class="bi bi-arrow-repeat"></i> Auto-Sync
        </span>
      </div>
      <p style="font-size: 12px; color: var(--text-muted); margin: 4px 0 0 0;">
        Audit kualitas data &amp; pemantauan status tindak lanjut Google Spreadsheet.
      </p>
    </div>
    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
      <% const isSe2026 = (typeof surveyConfig === 'undefined' || surveyConfig.id === 'se2026'); %>
      <% const defaultUrl = isSe2026 ? 'https://docs.google.com/spreadsheets/d/e/2PACX-1vT2cciIGMfpN1IJpezUhI8d1m6XX7MAX7lE1G9XsSIFgeOMxLVOEuKJWvDtjiLdkdButQU95_7WoP9S/pubhtml' : ''; %>
      <% const sheetsUrlLink = (typeof settings !== 'undefined' && settings.google_sheets_anomaly_url) ? settings.google_sheets_anomaly_url : defaultUrl; %>
      <% if (sheetsUrlLink) { %>
      <a href="<%= sheetsUrlLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="color: var(--accent-green);" title="Buka Google Spreadsheet Anomali">
        <i class="bi bi-file-earmark-excel-fill"></i> Buka Spreadsheet
      </a>
      <% } else { %>
      <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/admin/spreadsheet" class="btn btn-secondary btn-sm" style="color: var(--accent-yellow);" title="Konfigurasi Spreadsheet Anomali">
        <i class="bi bi-gear-fill"></i> Atur Spreadsheet
      </a>
      <% } %>
      <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/deteksi-anomali?refresh=true&tab=<%= activeTab %>&kec=<%= encodeURIComponent(filterKec) %>&korlap=<%= encodeURIComponent(filterKorlap) %>&status=<%= encodeURIComponent(filterStatus) %>" onclick="this.innerHTML='<i class=\'bi bi-arrow-clockwise bi-spin\'></i> Syncing...'; this.style.pointerEvents='none';" class="btn btn-primary btn-sm" title="Segarkan Data dari Google Spreadsheet">
        <i class="bi bi-arrow-clockwise"></i> Sync Data
      </a>
    </div>
  </div>

  <!-- STATS OVERVIEW CARDS -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 16px; margin-bottom: 24px;">
    <!-- Card 1: Total Anomali -->
    <div class="card" style="margin: 0; padding: 18px; background: var(--bg-card); border: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Total Anomali</div>
          <div style="font-size: 26px; font-weight: 800; color: var(--text-primary);"><%= (sheetsData.summary.total_anomali || 0).toLocaleString('id-ID') %></div>
          <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Usaha + Keluarga</div>
        </div>
        <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(245, 158, 11, 0.12); color: var(--accent-yellow); display: flex; align-items: center; justify-content: center; font-size: 20px;">
          <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
      </div>
    </div>

    <!-- Card 2: Anomali Usaha -->
    <div class="card" style="margin: 0; padding: 18px; background: var(--bg-card); border: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Anomali Usaha (UTP)</div>
          <div style="font-size: 26px; font-weight: 800; color: var(--accent-cyan);"><%= (sheetsData.summary.total_usaha || 0).toLocaleString('id-ID') %></div>
          <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Sheet Usaha</div>
        </div>
        <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(6, 182, 212, 0.12); color: var(--accent-cyan); display: flex; align-items: center; justify-content: center; font-size: 20px;">
          <i class="bi bi-shop"></i>
        </div>
      </div>
    </div>

    <!-- Card 3: Anomali Keluarga -->
    <div class="card" style="margin: 0; padding: 18px; background: var(--bg-card); border: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Anomali Keluarga (KK)</div>
          <div style="font-size: 26px; font-weight: 800; color: var(--accent-purple);"><%= (sheetsData.summary.total_keluarga || 0).toLocaleString('id-ID') %></div>
          <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Sheet Keluarga</div>
        </div>
        <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(139, 92, 246, 0.12); color: var(--accent-purple); display: flex; align-items: center; justify-content: center; font-size: 20px;">
          <i class="bi bi-house-door-fill"></i>
        </div>
      </div>
    </div>

    <!-- Card 4: Sudah Ditindaklanjuti -->
    <div class="card" style="margin: 0; padding: 18px; background: var(--bg-card); border: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Sudah Ditindaklanjuti</div>
          <div style="font-size: 26px; font-weight: 800; color: var(--accent-green);" id="statTotalSudah"><%= (sheetsData.summary.total_sudah || 0).toLocaleString('id-ID') %></div>
          <div style="font-size: 11px; color: var(--accent-green); font-weight: 600; margin-top: 4px;" id="statPctSudah"><%= sheetsData.summary.pct_sudah %>% terselesaikan</div>
        </div>
        <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(16, 185, 129, 0.12); color: var(--accent-green); display: flex; align-items: center; justify-content: center; font-size: 20px;">
          <i class="bi bi-check-circle-fill"></i>
        </div>
      </div>
    </div>

    <!-- Card 5: Belum Ditindaklanjuti -->
    <div class="card" style="margin: 0; padding: 18px; background: var(--bg-card); border: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Belum Ditindaklanjuti</div>
          <div style="font-size: 26px; font-weight: 800; color: var(--accent-red);" id="statTotalBelum"><%= (sheetsData.summary.total_belum || 0).toLocaleString('id-ID') %></div>
          <div style="font-size: 11px; color: var(--accent-red); font-weight: 600; margin-top: 4px;">Perlu Pengawasan</div>
        </div>
        <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(239, 68, 68, 0.12); color: var(--accent-red); display: flex; align-items: center; justify-content: center; font-size: 20px;">
          <i class="bi bi-x-circle-fill"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- FILTER & SEARCH BAR -->
  <div class="card" style="margin-bottom: 20px;">
    <div class="card-header" style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
      <div class="card-title" style="font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
        <i class="bi bi-funnel-fill text-cyan"></i> Filter &amp; Pencarian Anomali
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <small style="font-size: 11px; color: var(--text-muted);">Terakhir disinkronkan: <strong><%= sheetsData.lastUpdated %></strong></small>
        <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/deteksi-anomali?tab=<%= activeTab %>" class="btn btn-secondary btn-xs"><i class="bi bi-arrow-repeat"></i> Reset Filter</a>
      </div>
    </div>
    
    <form action="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/deteksi-anomali" method="GET" id="filterForm">
      <input type="hidden" name="tab" value="<%= activeTab %>">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 14px; align-items: end;">
        
        <div>
          <label for="filterKec" style="display:block; font-size:12px; font-weight:600; margin-bottom:6px; color:var(--text-secondary);">Kecamatan</label>
          <select id="filterKec" name="kec" onchange="this.form.submit();" style="width:100%; padding: 8px 12px; font-size: 13px; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary);">
            <option value="">-- Semua Kecamatan --</option>
            <% kecList.forEach(k => { %>
              <option value="<%= k.kecamatan %>" <%= filterKec === k.kecamatan ? 'selected' : '' %>><%= k.kecamatan %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="filterKorlap" style="display:block; font-size:12px; font-weight:600; margin-bottom:6px; color:var(--text-secondary);">Koordinator Lapangan (Korlap)</label>
          <select id="filterKorlap" name="korlap" onchange="this.form.submit();" style="width:100%; padding: 8px 12px; font-size: 13px; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary);">
            <option value="">-- Semua Korlap --</option>
            <% korlapList.forEach(k => { %>
              <option value="<%= k.korlap %>" <%= filterKorlap === k.korlap ? 'selected' : '' %>><%= k.korlap %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="filterStatus" style="display:block; font-size:12px; font-weight:600; margin-bottom:6px; color:var(--text-secondary);">Status Tindak Lanjut</label>
          <select id="filterStatus" name="status" onchange="this.form.submit();" style="width:100%; padding: 8px 12px; font-size: 13px; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary);">
            <option value="">-- Semua Status --</option>
            <option value="belum" <%= filterStatus === 'belum' ? 'selected' : '' %>>❌ Belum Ditindaklanjuti</option>
            <option value="sudah" <%= filterStatus === 'sudah' ? 'selected' : '' %>>✅ Sudah Ditindaklanjuti</option>
          </select>
        </div>

        <div>
          <label for="searchQuery" style="display:block; font-size:12px; font-weight:600; margin-bottom:6px; color:var(--text-secondary);">Cari Kata Kunci</label>
          <div style="position: relative;">
            <input type="search" id="searchQuery" name="q" value="<%= searchQuery %>" placeholder="Cari nama usaha, KK, PCL, anomali..." style="width: 100%; padding: 8px 12px 8px 34px; font-size: 13px; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary);">
            <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 13px;"></i>
          </div>
        </div>

      </div>
    </form>
  </div>

  <!-- PARTIAL PJAX TAB CONTAINER -->
  <div id="anomalyTabContainer" style="transition: opacity 0.15s ease;">
    <!-- TAB NAVIGATION -->
  <div style="display: flex; gap: 8px; margin-bottom: 16px; border-bottom: 2px solid var(--border); padding-bottom: 2px; flex-wrap: wrap;">
    <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/deteksi-anomali?tab=usaha&kec=<%= encodeURIComponent(filterKec) %>&korlap=<%= encodeURIComponent(filterKorlap) %>&status=<%= encodeURIComponent(filterStatus) %>&q=<%= encodeURIComponent(searchQuery) %>" class="btn" style="padding: 10px 18px; font-size: 13px; font-weight: 700; border-radius: 10px 10px 0 0; background: <%= activeTab === 'usaha' ? 'var(--accent-blue)' : 'transparent' %>; color: <%= activeTab === 'usaha' ? '#fff' : 'var(--text-secondary)' %>; border: none; display: flex; align-items: center; gap: 8px;">
      <i class="bi bi-shop"></i> Anomali Usaha (UTP)
      <span class="badge" style="background: <%= activeTab === 'usaha' ? 'rgba(255,255,255,0.25)' : 'var(--bg-subtle)' %>; color: <%= activeTab === 'usaha' ? '#fff' : 'var(--text-primary)' %>;"><%= totalRecordsUsaha %></span>
    </a>

    <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/deteksi-anomali?tab=keluarga&kec=<%= encodeURIComponent(filterKec) %>&korlap=<%= encodeURIComponent(filterKorlap) %>&status=<%= encodeURIComponent(filterStatus) %>&q=<%= encodeURIComponent(searchQuery) %>" class="btn" style="padding: 10px 18px; font-size: 13px; font-weight: 700; border-radius: 10px 10px 0 0; background: <%= activeTab === 'keluarga' ? 'var(--accent-purple)' : 'transparent' %>; color: <%= activeTab === 'keluarga' ? '#fff' : 'var(--text-secondary)' %>; border: none; display: flex; align-items: center; gap: 8px;">
      <i class="bi bi-house-door-fill"></i> Anomali Keluarga (KK)
      <span class="badge" style="background: <%= activeTab === 'keluarga' ? 'rgba(255,255,255,0.25)' : 'var(--bg-subtle)' %>; color: <%= activeTab === 'keluarga' ? '#fff' : 'var(--text-primary)' %>;"><%= totalRecordsKeluarga %></span>
    </a>

    <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/deteksi-anomali?tab=pcl&kec=<%= encodeURIComponent(filterKec) %>&korlap=<%= encodeURIComponent(filterKorlap) %>&status=<%= encodeURIComponent(filterStatus) %>&q=<%= encodeURIComponent(searchQuery) %>" class="btn" style="padding: 10px 18px; font-size: 13px; font-weight: 700; border-radius: 10px 10px 0 0; background: <%= activeTab === 'pcl' ? 'var(--accent-yellow)' : 'transparent' %>; color: <%= activeTab === 'pcl' ? '#000' : 'var(--text-secondary)' %>; border: none; display: flex; align-items: center; gap: 8px;">
      <i class="bi bi-people-fill"></i> Rekap per Petugas (PCL)
      <span class="badge" style="background: <%= activeTab === 'pcl' ? 'rgba(0,0,0,0.15)' : 'var(--bg-subtle)' %>; color: <%= activeTab === 'pcl' ? '#000' : 'var(--text-primary)' %>;"><%= totalRecordsPcl %></span>
    </a>
  </div>

  <!-- HELPER PAGINATION MAKER -->
  <%
    function getPageUrl(p, l) {
      const params = [];
      params.push('tab=' + encodeURIComponent(activeTab));
      if (filterKec) params.push('kec=' + encodeURIComponent(filterKec));
      if (filterKorlap) params.push('korlap=' + encodeURIComponent(filterKorlap));
      if (filterStatus) params.push('status=' + encodeURIComponent(filterStatus));
      if (searchQuery) params.push('q=' + encodeURIComponent(searchQuery));
      params.push('page=' + p);
      params.push('limit=' + (l || pageSize));
      return (typeof navPrefix !== 'undefined' ? navPrefix : '') + '/deteksi-anomali?' + params.join('&');
    }
  %>

  <!-- TAB CONTENTS -->
  
  <!-- TAB 1: ANOMALI USAHA (UTP) -->
  <% if (activeTab === 'usaha') { %>
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div class="card-title"><i class="bi bi-shop text-cyan"></i> Daftar Temuan Anomali Usaha (UTP)</div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="badge badge-cyan"><%= totalRecordsUsaha %> Total Records</span>
          <span class="badge badge-subtle">Halaman <%= currentPage %> / <%= totalPagesUsaha %></span>
        </div>
      </div>

      <% if (paginatedUsaha && paginatedUsaha.length > 0) { %>
        <div class="table-wrap" style="max-height: 650px; overflow-y: auto; overflow-x: auto;">
          <table id="usahaTable">
            <thead>
              <tr>
                <th class="text-center" style="width: 45px;">No</th>
                <th>Nama Usaha</th>
                <th>PCL (Petugas)</th>
                <th class="hide-md">Korlap</th>
                <th>Kecamatan</th>
                <th>Desa / SLS</th>
                <th>Detail Anomali</th>
                <th class="text-center">Status Tindak Lanjut</th>
                <th class="text-center" style="width: 80px;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% paginatedUsaha.forEach((item, idx) => { %>
                <tr id="row-<%= item.id %>">
                  <td class="text-center fw-bold" style="background: var(--bg-subtle);"><%= (currentPage - 1) * pageSize + idx + 1 %></td>
                  <td class="td-primary">
                    <strong style="color: var(--text-primary); font-size: 13.5px;" class="item-name"><%= item.nama_usaha %></strong>
                    <div class="item-penjelasan" style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                      <% if (item.penjelasan) { %>💬 <i><%= item.penjelasan %></i><% } %>
                    </div>
                  </td>
                  <td>
                    <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/pcl?pcl=<%= encodeURIComponent(item.petugas) %>" style="color: inherit; text-decoration: none; font-weight: 600;" class="item-pcl">
                      <i class="bi bi-person text-cyan"></i> <%= item.petugas %>
                    </a>
                  </td>
                  <td class="hide-md"><%= item.korlap %></td>
                  <td><%= item.kecamatan %></td>
                  <td><%= item.desa %> (SLS: <%= item.kode_sls %>)</td>
                  <td style="max-width: 300px; font-size: 12px; line-height: 1.4;">
                    <span class="badge badge-yellow" style="white-space: normal; text-align: left; line-height: 1.35; padding: 6px 10px; font-weight: 500;">
                      <%= item.nama_anomali %>
                    </span>
                  </td>
                  <td class="text-center item-status-td">
                    <% if (item.is_done) { %>
                      <span class="badge badge-green" style="font-size: 11px; padding: 6px 10px; display: inline-flex; align-items: center; gap: 4px;"><i class="bi bi-check-circle-fill"></i> <%= item.tindak_lanjut %></span>
                    <% } else { %>
                      <span class="badge badge-red" style="font-size: 11px; padding: 6px 10px; display: inline-flex; align-items: center; gap: 4px;"><i class="bi bi-exclamation-triangle-fill"></i> <%= item.tindak_lanjut %></span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (item.link_fasih) { %>
                      <a href="<%= item.link_fasih %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-xs" title="Buka Detail di Aplikasi FASIH">
                        <i class="bi bi-box-arrow-up-right text-blue"></i> FASIH
                      </a>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 11px;">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION BAR -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 12px; background: var(--bg-card-hover);">
          <div style="font-size: 12px; color: var(--text-muted);">
            Menampilkan <strong><%= (currentPage - 1) * pageSize + 1 %></strong> - <strong><%= Math.min(currentPage * pageSize, totalRecordsUsaha) %></strong> dari <strong><%= totalRecordsUsaha %></strong> data
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <% if (currentPage > 1) { %>
              <a href="<%= getPageUrl(1) %>" class="btn btn-secondary btn-xs" title="Halaman Pertama"><i class="bi bi-chevron-double-left"></i></a>
              <a href="<%= getPageUrl(currentPage - 1) %>" class="btn btn-secondary btn-xs"><i class="bi bi-chevron-left"></i> Sblm</a>
            <% } %>
            
            <span style="font-size: 12px; font-weight: 700; padding: 4px 10px; background: var(--bg-subtle); border-radius: 6px; color: var(--text-primary);">
              Hal <%= currentPage %> / <%= totalPagesUsaha %>
            </span>

            <% if (currentPage < totalPagesUsaha) { %>
              <a href="<%= getPageUrl(currentPage + 1) %>" class="btn btn-secondary btn-xs">Slnjt <i class="bi bi-chevron-right"></i></a>
              <a href="<%= getPageUrl(totalPagesUsaha) %>" class="btn btn-secondary btn-xs" title="Halaman Terakhir"><i class="bi bi-chevron-double-right"></i></a>
            <% } %>

            <!-- Limit selector -->
            <select onchange="location = getPageUrl(1, this.value);" style="font-size: 11px; padding: 3px 6px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary); margin-left: 8px;">
              <option value="25" <%= pageSize === 25 ? 'selected' : '' %>>25 / Hal</option>
              <option value="50" <%= pageSize === 50 ? 'selected' : '' %>>50 / Hal</option>
              <option value="100" <%= pageSize === 100 ? 'selected' : '' %>>100 / Hal</option>
              <option value="200" <%= pageSize === 200 ? 'selected' : '' %>>200 / Hal</option>
            </select>
          </div>
        </div>

      <% } else { %>
        <div style="padding: 40px; text-align: center; color: var(--text-muted);">
          <i class="bi bi-search" style="font-size: 44px; opacity: 0.5;"></i>
          <p style="margin-top: 12px; font-size: 14px; font-weight: 600;">Data Anomali Usaha Tidak Ditemukan</p>
          <p style="font-size: 12px; color: var(--text-muted);">Coba ubah kriteria filter pencarian atau reset filter.</p>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- TAB 2: ANOMALI KELUARGA (KK) -->
  <% if (activeTab === 'keluarga') { %>
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div class="card-title"><i class="bi bi-house-door-fill text-purple"></i> Daftar Temuan Anomali Keluarga (KK)</div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="badge badge-purple"><%= totalRecordsKeluarga %> Total Records</span>
          <span class="badge badge-subtle">Halaman <%= currentPage %> / <%= totalPagesKeluarga %></span>
        </div>
      </div>

      <% if (paginatedKeluarga && paginatedKeluarga.length > 0) { %>
        <div class="table-wrap" style="max-height: 650px; overflow-y: auto; overflow-x: auto;">
          <table id="keluargaTable">
            <thead>
              <tr>
                <th class="text-center" style="width: 45px;">No</th>
                <th>Nama Kepala Keluarga (KK)</th>
                <th>PCL (Petugas)</th>
                <th class="hide-md">Korlap</th>
                <th>Kecamatan</th>
                <th>Desa / SLS</th>
                <th>Detail Anomali</th>
                <th class="text-center">Status Tindak Lanjut</th>
                <th class="text-center" style="width: 80px;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% paginatedKeluarga.forEach((item, idx) => { %>
                <tr id="row-<%= item.id %>">
                  <td class="text-center fw-bold" style="background: var(--bg-subtle);"><%= (currentPage - 1) * pageSize + idx + 1 %></td>
                  <td class="td-primary">
                    <strong style="color: var(--text-primary); font-size: 13.5px;" class="item-name"><%= item.nama_kk %></strong>
                    <div class="item-penjelasan" style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                      <% if (item.penjelasan) { %>💬 <i><%= item.penjelasan %></i><% } %>
                    </div>
                  </td>
                  <td>
                    <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/pcl?pcl=<%= encodeURIComponent(item.petugas) %>" style="color: inherit; text-decoration: none; font-weight: 600;" class="item-pcl">
                      <i class="bi bi-person text-purple"></i> <%= item.petugas %>
                    </a>
                  </td>
                  <td class="hide-md"><%= item.korlap %></td>
                  <td><%= item.kecamatan %></td>
                  <td><%= item.desa %> (SLS: <%= item.kode_sls %>)</td>
                  <td style="max-width: 300px; font-size: 12px; line-height: 1.4;">
                    <span class="badge badge-yellow" style="white-space: normal; text-align: left; line-height: 1.35; padding: 6px 10px; font-weight: 500;">
                      <%= item.nama_anomali %>
                    </span>
                  </td>
                  <td class="text-center item-status-td">
                    <% if (item.is_done) { %>
                      <span class="badge badge-green" style="font-size: 11px; padding: 6px 10px; display: inline-flex; align-items: center; gap: 4px;"><i class="bi bi-check-circle-fill"></i> <%= item.tindak_lanjut %></span>
                    <% } else { %>
                      <span class="badge badge-red" style="font-size: 11px; padding: 6px 10px; display: inline-flex; align-items: center; gap: 4px;"><i class="bi bi-exclamation-triangle-fill"></i> <%= item.tindak_lanjut %></span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (item.link_fasih) { %>
                      <a href="<%= item.link_fasih %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-xs" title="Buka Detail di Aplikasi FASIH">
                        <i class="bi bi-box-arrow-up-right text-blue"></i> FASIH
                      </a>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 11px;">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION BAR -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 12px; background: var(--bg-card-hover);">
          <div style="font-size: 12px; color: var(--text-muted);">
            Menampilkan <strong><%= (currentPage - 1) * pageSize + 1 %></strong> - <strong><%= Math.min(currentPage * pageSize, totalRecordsKeluarga) %></strong> dari <strong><%= totalRecordsKeluarga %></strong> data
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <% if (currentPage > 1) { %>
              <a href="<%= getPageUrl(1) %>" class="btn btn-secondary btn-xs" title="Halaman Pertama"><i class="bi bi-chevron-double-left"></i></a>
              <a href="<%= getPageUrl(currentPage - 1) %>" class="btn btn-secondary btn-xs"><i class="bi bi-chevron-left"></i> Sblm</a>
            <% } %>
            
            <span style="font-size: 12px; font-weight: 700; padding: 4px 10px; background: var(--bg-subtle); border-radius: 6px; color: var(--text-primary);">
              Hal <%= currentPage %> / <%= totalPagesKeluarga %>
            </span>

            <% if (currentPage < totalPagesKeluarga) { %>
              <a href="<%= getPageUrl(currentPage + 1) %>" class="btn btn-secondary btn-xs">Slnjt <i class="bi bi-chevron-right"></i></a>
              <a href="<%= getPageUrl(totalPagesKeluarga) %>" class="btn btn-secondary btn-xs" title="Halaman Terakhir"><i class="bi bi-chevron-double-right"></i></a>
            <% } %>

            <!-- Limit selector -->
            <select onchange="location = getPageUrl(1, this.value);" style="font-size: 11px; padding: 3px 6px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary); margin-left: 8px;">
              <option value="25" <%= pageSize === 25 ? 'selected' : '' %>>25 / Hal</option>
              <option value="50" <%= pageSize === 50 ? 'selected' : '' %>>50 / Hal</option>
              <option value="100" <%= pageSize === 100 ? 'selected' : '' %>>100 / Hal</option>
              <option value="200" <%= pageSize === 200 ? 'selected' : '' %>>200 / Hal</option>
            </select>
          </div>
        </div>

      <% } else { %>
        <div style="padding: 40px; text-align: center; color: var(--text-muted);">
          <i class="bi bi-search" style="font-size: 44px; opacity: 0.5;"></i>
          <p style="margin-top: 12px; font-size: 14px; font-weight: 600;">Data Anomali Keluarga Tidak Ditemukan</p>
          <p style="font-size: 12px; color: var(--text-muted);">Coba ubah kriteria filter pencarian atau reset filter.</p>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- TAB 3: REKAP PER PETUGAS (PCL) -->
  <% if (activeTab === 'pcl') { %>
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div class="card-title"><i class="bi bi-people-fill text-yellow"></i> Rekap Penanganan Anomali per Petugas (PCL)</div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="badge badge-yellow"><%= totalRecordsPcl %> Petugas</span>
          <span class="badge badge-subtle">Halaman <%= currentPage %> / <%= totalPagesPcl %></span>
        </div>
      </div>

      <% if (paginatedPcl && paginatedPcl.length > 0) { %>
        <div class="table-wrap" style="max-height: 650px; overflow-y: auto; overflow-x: auto;">
          <table id="pclAnomalyTable">
            <thead>
              <tr>
                <th class="text-center" style="width: 45px;">No</th>
                <th>Nama Petugas (PCL)</th>
                <th>Korlap</th>
                <th>Kecamatan</th>
                <th class="text-right text-cyan">Anomali Usaha</th>
                <th class="text-right text-purple">Anomali Keluarga</th>
                <th class="text-right text-yellow">Total Anomali</th>
                <th class="text-right text-green">Sudah TL</th>
                <th class="text-right text-red">Belum TL</th>
                <th class="text-right" style="width: 140px;">Progres TL</th>
              </tr>
            </thead>
            <tbody>
              <% paginatedPcl.forEach((item, idx) => { %>
                <% const pct = item.total_anomali ? Number(((item.sudah_ditindaklanjuti / item.total_anomali) * 100).toFixed(1)) : 0; %>
                <tr>
                  <td class="text-center fw-bold" style="background: var(--bg-subtle);"><%= (currentPage - 1) * pageSize + idx + 1 %></td>
                  <td class="td-primary">
                    <a href="<%= (typeof navPrefix !== 'undefined' ? navPrefix : '') %>/pcl?pcl=<%= encodeURIComponent(item.petugas) %>" style="color: inherit; text-decoration: none; font-weight: 700;">
                      <i class="bi bi-person-badge text-yellow"></i> <%= item.petugas %>
                    </a>
                  </td>
                  <td><%= item.korlap %></td>
                  <td><%= item.kecamatan %></td>
                  <td class="text-right fw-bold text-cyan" data-sort="<%= item.anomali_usaha %>"><%= item.anomali_usaha.toLocaleString('id-ID') %></td>
                  <td class="text-right fw-bold text-purple" data-sort="<%= item.anomali_keluarga %>"><%= item.anomali_keluarga.toLocaleString('id-ID') %></td>
                  <td class="text-right fw-bold text-yellow" data-sort="<%= item.total_anomali %>"><%= item.total_anomali.toLocaleString('id-ID') %></td>
                  <td class="text-right fw-bold text-green" data-sort="<%= item.sudah_ditindaklanjuti %>"><%= item.sudah_ditindaklanjuti.toLocaleString('id-ID') %></td>
                  <td class="text-right fw-bold text-red" data-sort="<%= item.belum_ditindaklanjuti %>"><%= item.belum_ditindaklanjuti.toLocaleString('id-ID') %></td>
                  <td class="text-right fw-bold" data-sort="<%= pct %>">
                    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                      <div style="flex: 1; max-width: 60px; height: 6px; background: var(--bg-progress-wrap); border-radius: 99px; overflow: hidden;">
                        <div style="width: <%= Math.min(100, pct) %>%; height: 100%; background: <%= pct >= 80 ? 'var(--accent-green)' : (pct >= 40 ? 'var(--accent-yellow)' : 'var(--accent-red)') %>; border-radius: 99px;"></div>
                      </div>
                      <span style="font-size: 12px; color: <%= pct >= 80 ? 'var(--accent-green)' : (pct >= 40 ? 'var(--accent-yellow)' : 'var(--accent-red)') %>;"><%= pct %>%</span>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION BAR -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 12px; background: var(--bg-card-hover);">
          <div style="font-size: 12px; color: var(--text-muted);">
            Menampilkan <strong><%= (currentPage - 1) * pageSize + 1 %></strong> - <strong><%= Math.min(currentPage * pageSize, totalRecordsPcl) %></strong> dari <strong><%= totalRecordsPcl %></strong> data
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <% if (currentPage > 1) { %>
              <a href="<%= getPageUrl(1) %>" class="btn btn-secondary btn-xs" title="Halaman Pertama"><i class="bi bi-chevron-double-left"></i></a>
              <a href="<%= getPageUrl(currentPage - 1) %>" class="btn btn-secondary btn-xs"><i class="bi bi-chevron-left"></i> Sblm</a>
            <% } %>
            
            <span style="font-size: 12px; font-weight: 700; padding: 4px 10px; background: var(--bg-subtle); border-radius: 6px; color: var(--text-primary);">
              Hal <%= currentPage %> / <%= totalPagesPcl %>
            </span>

            <% if (currentPage < totalPagesPcl) { %>
              <a href="<%= getPageUrl(currentPage + 1) %>" class="btn btn-secondary btn-xs">Slnjt <i class="bi bi-chevron-right"></i></a>
              <a href="<%= getPageUrl(totalPagesPcl) %>" class="btn btn-secondary btn-xs" title="Halaman Terakhir"><i class="bi bi-chevron-double-right"></i></a>
            <% } %>

            <!-- Limit selector -->
            <select onchange="location = getPageUrl(1, this.value);" style="font-size: 11px; padding: 3px 6px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary); margin-left: 8px;">
              <option value="25" <%= pageSize === 25 ? 'selected' : '' %>>25 / Hal</option>
              <option value="50" <%= pageSize === 50 ? 'selected' : '' %>>50 / Hal</option>
              <option value="100" <%= pageSize === 100 ? 'selected' : '' %>>100 / Hal</option>
              <option value="200" <%= pageSize === 200 ? 'selected' : '' %>>200 / Hal</option>
            </select>
          </div>
        </div>
      <% } else { %>
        <div style="padding: 40px; text-align: center; color: var(--text-muted);">
          <i class="bi bi-people" style="font-size: 44px; opacity: 0.5;"></i>
          <p style="margin-top: 12px; font-size: 14px; font-weight: 600;">Data Rekap Petugas Tidak Ditemukan</p>
          <p style="font-size: 12px; color: var(--text-muted);">Coba ubah kriteria filter pencarian atau reset filter.</p>
        </div>
      <% } %>
    </div>
  <% } %>
  </div> <!-- END PARTIAL PJAX TAB CONTAINER -->

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  if (typeof makeTableSortable === 'function') {
    makeTableSortable('usahaTable');
    makeTableSortable('keluargaTable');
    makeTableSortable('pclAnomalyTable');
  }
});

// PARTIAL PJAX TAB & PAGINATION SWITCHER (NO FULL PAGE FLICKER)
(function() {
  document.addEventListener('click', function(e) {
    const link = e.target.closest('#anomalyTabContainer a');
    if (!link) return;

    const href = link.getAttribute('href');
    if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

    if (href.includes('/deteksi-anomali')) {
      e.preventDefault();
      loadAnomalyPartial(href);
    }
  });

  window.loadAnomalyPartial = async function(url) {
    const container = document.getElementById('anomalyTabContainer');
    if (!container) {
      location.href = url;
      return;
    }

    container.style.opacity = '0.4';
    container.style.pointerEvents = 'none';

    try {
      const res = await fetch(url, { headers: { 'X-PJAX-Partial': 'true' } });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const html = await res.text();

      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const newContainer = doc.getElementById('anomalyTabContainer');

      if (newContainer) {
        container.innerHTML = newContainer.innerHTML;
        history.pushState(null, '', url);
      } else {
        location.href = url;
      }
    } catch (err) {
      console.warn('Partial PJAX error:', err.message);
      location.href = url;
    } finally {
      if (container) {
        container.style.opacity = '1';
        container.style.pointerEvents = 'auto';
      }
    }
  };

  // Support browser Back / Forward buttons
  window.addEventListener('popstate', function() {
    if (location.pathname.includes('/deteksi-anomali')) {
      window.loadAnomalyPartial(location.href);
    }
  });
})();
</script>
