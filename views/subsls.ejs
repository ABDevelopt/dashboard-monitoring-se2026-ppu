<%
  const isSakernas = typeof surveyConfig !== 'undefined' && surveyConfig.id && surveyConfig.id.startsWith('sakernas');
  const officerLabel = isSakernas ? 'PPL' : 'PCL';

  let activeSubslsStatusCols = 1;
  if (settings.show_status_open === '1' || settings.show_status_open === undefined) activeSubslsStatusCols++;
  if (settings.show_status_draft === '1' || settings.show_status_draft === undefined) activeSubslsStatusCols++;
  if (settings.show_status_submitted === '1' || settings.show_status_submitted === undefined) activeSubslsStatusCols++;
  if (settings.show_status_approved === '1' || settings.show_status_approved === undefined) activeSubslsStatusCols++;
  if (settings.show_status_rejected === '1' || settings.show_status_rejected === undefined) activeSubslsStatusCols++;
%>
<div class="fade-in">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" integrity="sha384-e6nUZLBkQ86NJ6TVVKAeSaK8jWa3NhkYWZFomE39AvDbQWeie9PlQqM3pmYW5d1g" crossorigin="anonymous"></script>
  <% if (!uploadId) { %>
    <div class="card empty-state">
      <div class="empty-state-icon"><i class="bi bi-geo-alt"></i></div>
      <div class="empty-state-title">Belum Ada Data Sub-SLS</div>
      <div class="empty-state-text">Upload file data untuk mulai memantau progres pendataan per satuan lingkungan setempat (SLS) di seluruh wilayah.</div>
      <a href="<%= navPrefix %>/admin/upload" class="empty-state-action"><i class="bi bi-cloud-arrow-up-fill"></i> Upload Data Sekarang</a>
    </div>
  <% } else { %>
    <div id="ajax-container">
    
    <!-- FILTER BAR -->
    <div class="card">
      <form method="GET" action="<%= navPrefix %>/subsls" id="filterForm">
        <div class="filter-grid">
          <div>
            <label for="filterKec" class="ui-label">Kecamatan</label>
            <select id="filterKec" name="kec" onchange="this.form.submit()" class="w-full">
              <option value="">-- Semua Kecamatan --</option>
              <% kecList.forEach(k => { %>
                <option value="<%= k.kecamatan %>" <%= (filterKec && filterKec.toUpperCase() === k.kecamatan.toUpperCase()) ? 'selected' : '' %>><%= k.kecamatan %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="filterDesa" class="ui-label">Desa/Kelurahan</label>
            <select id="filterDesa" name="desa"  class="w-full" <%= !filterKec ? 'disabled' : '' %>>
              <option value="">-- Semua Desa --</option>
              <% desaList.forEach(d => { %>
                <option value="<%= d.desa %>" <%= (filterDesa && filterDesa.toUpperCase() === d.desa.toUpperCase()) ? 'selected' : '' %>><%= d.desa %></option>
              <% }) %>
            </select>
          </div>

          <% if (!isSakernas) { %>
          <div>
            <label for="filterKorlap" class="ui-label">Koordinator Lapangan</label>
            <select id="filterKorlap" name="korlap"  class="w-full">
              <option value="">-- Semua Korlap --</option>
              <% korlapList.forEach(k => { %>
                <option value="<%= k.korlap %>" <%= (filterKorlap && filterKorlap.toUpperCase() === k.korlap.toUpperCase()) ? 'selected' : '' %>><%= k.korlap %></option>
              <% }) %>
            </select>
          </div>
          <% } %>

          <div>
            <label for="filterPml" class="ui-label">PML (Pengawas)</label>
            <select id="filterPml" name="pml"  class="w-full">
              <option value="">-- Semua PML --</option>
              <% pmlList.forEach(p => { %>
                <option value="<%= p.pml %>" <%= (filterPml && filterPml.toUpperCase() === p.pml.toUpperCase()) ? 'selected' : '' %>><%= p.pml %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="filterPcl" class="ui-label"><%= officerLabel %> (<%= isSakernas ? 'Petugas Pendataan' : 'Pencacah' %>)</label>
            <select id="filterPcl" name="pcl"  class="w-full">
              <option value="">-- Semua <%= officerLabel %> --</option>
              <% pclList.forEach(p => { %>
                <option value="<%= p.pcl %>" <%= (filterPcl && filterPcl.toUpperCase() === p.pcl.toUpperCase()) ? 'selected' : '' %>><%= p.pcl %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label id="statusLabel" for="filterStatus" class="ui-label">
              Status Progres
              <span title="Kriteria Status:&#10;- Belum Mulai: belum mulai mengisi dokumen&#10;- Sedang Didata: sedang dalam proses pengisian dokumen&#10;- Memenuhi Target: progres dokumen >= target, belum dinyatakan selesai resmi&#10;- Selesai: SLS/Sub-SLS dinyatakan selesai resmi dari berkas status BPS" style="cursor: help; margin-left: 4px;"><i class="bi bi-info-circle"></i></span>
            </label>
            <select id="filterStatus" name="status" class="w-full">
              <option value="">-- Semua Status --</option>
              <option value="belum_mulai" <%= filterStatus === 'belum_mulai' ? 'selected' : '' %>>Belum Mulai</option>
              <option value="sedang_didata" <%= filterStatus === 'sedang_didata' ? 'selected' : '' %>>Sedang Didata</option>
              <option value="memenuhi_target" <%= filterStatus === 'memenuhi_target' ? 'selected' : '' %>>Memenuhi Target</option>
              <option value="selesai" <%= filterStatus === 'selesai' ? 'selected' : '' %>>Selesai</option>
            </select>
          </div>

        </div>
      </form>
    </div>

    <!-- TWO-COLUMN GRID FOR DRILLDOWN -->
    <div class="drilldown-grid <%= filterKode ? 'has-selection' : 'no-selection' %> mt-4">

      <!-- MAIN DATA TABLE -->
      <div class="card" id="subslsTableContainer" style="margin-bottom: 0;">
        <div class="card-header flex-between" style="gap: 8px;">
          <div class="card-title" style="margin-bottom: 0;">
            <i class="bi bi-box-seam"></i> Daftar Rincian SubSLS (Blok Sensus)
            <span style="font-size:11px; color:var(--text-muted); font-weight: 600; margin-left: 4px;">
              (<%= data.length %> / <%= total.toLocaleString('id-ID') %> SubSLS)
              <% if (filterQ) { %>
                <span class="badge badge-purple" style="font-size: 10px; margin-left: 4px;">"<%= filterQ %>"</span>
              <% } %>
            </span>
          </div>
          <div class="card-actions flex-start" style="gap: 6px;">
            <a href="<%= navPrefix %>/subsls/export?<%= new URLSearchParams({ kec: filterKec, desa: filterDesa, korlap: filterKorlap, pml: filterPml, pcl: filterPcl, status: filterStatus, kode: filterKode, q: filterQ }).toString() %>" class="btn btn-xs" style="background: #22c55e; color: white; border: none; font-size: 11px; padding: 4px 8px; border-radius: 6px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;" download title="Unduh Data SubSLS (CSV)"><i class="bi bi-file-earmark-excel"></i><span class="btn-text-desktop"> Export CSV</span></a>
          </div>
        </div>

        <div class="search-wrap mb-4" style="max-width: 350px; position: relative;">
          <input type="search" id="tableSearch" placeholder="Cari dari seluruh data SubSLS..." value="<%= filterQ %>" aria-label="Cari SLS dari seluruh data" style="width: 100%; padding-right: 30px;">
          <% if (filterQ) { %>
            <button type="button" id="clearSearchBtn" title="Hapus Pencarian" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 0; font-size: 14px;">
              <i class="bi bi-x-circle-fill"></i>
            </button>
          <% } %>
        </div>

        <% if (data && data.length > 0) { %>
          <div class="table-wrap" style="max-height: 800px; overflow-y: auto;">
            <table id="subslsTable">
              <thead>
                <tr>
                  <th rowspan="2" class="text-center" style="font-weight: 600; width: 40px;">No</th>
                  <th rowspan="2" class="hide-md">Kode SLS</th>
                  <th rowspan="2">Nama SLS</th>

                  <th rowspan="2">Wilayah</th>
                  <th rowspan="2">Petugas (<%= isSakernas ? 'PPL/PML' : 'PCL/PML/Korlap' %>)</th>
                  <th rowspan="2" class="text-center">Status</th>
                  <th rowspan="2" class="text-right bg-purple-soft" style="min-width: 130px; white-space: nowrap;">FASIH %</th>
                  <th rowspan="2" class="text-center bg-cyan-soft muatan-col" style="min-width: 110px; white-space: nowrap;">Muatan %</th>
                  <th colspan="<%= activeSubslsStatusCols %>" class="text-center bg-purple-soft" style="border-bottom: 1px solid var(--border);">Assignment FASIH</th>
                  <th colspan="3" class="text-center bg-cyan-soft muatan-col" style="border-bottom: 1px solid var(--border);">Progres Muatan</th>
                </tr>
                <tr>
                  <% if (settings.show_status_open === '1' || settings.show_status_open === undefined) { %>
                    <th class="text-right bg-orange-soft">Open</th>
                  <% } %>
                  <% if (settings.show_status_draft === '1' || settings.show_status_draft === undefined) { %>
                    <th class="text-right bg-yellow-soft">Draft</th>
                  <% } %>
                  <% if (settings.show_status_submitted === '1' || settings.show_status_submitted === undefined) { %>
                    <th class="text-right bg-blue-soft">Submitted</th>
                  <% } %>
                  <% if (settings.show_status_approved === '1' || settings.show_status_approved === undefined) { %>
                    <th class="text-right bg-green-soft">Approved</th>
                  <% } %>
                  <% if (settings.show_status_rejected === '1' || settings.show_status_rejected === undefined) { %>
                    <th class="text-right bg-red-soft">Rejected</th>
                  <% } %>
                  <th class="text-right bg-purple-soft">Target</th>
                  
                  <th class="text-right bg-cyan-soft muatan-col">Realisasi</th>
                  <th class="text-right bg-cyan-soft muatan-col">Target</th>
                  <th class="text-right bg-cyan-soft muatan-col">Usaha Baru</th>
                </tr>
              </thead>
              <tbody>
                <% data.forEach((row, index) => { %>
                  <% 
                    const fReal = (row.submitted_by_pcl || 0) + (row.approved || 0) + (row.rejected || 0);
                    const fTgt = Math.round(row.target_fasih || 0);
                    const fPctVal = fTgt > 0 ? ((100 * fReal) / fTgt).toFixed(2) : '0.00';
                    const fW = Math.min(parseFloat(fPctVal), 100);
                    const fColor = fW >= 100 ? 'var(--accent-green)' : (fW < 40 ? 'var(--accent-red)' : 'var(--accent-purple)');

                    const mReal = row.muatan_selesai || 0;
                    const mTgt = Math.round(row.muatan || 0);
                    const mPctVal = mTgt > 0 ? ((100 * mReal) / mTgt).toFixed(2) : '0.00';
                    const mW = Math.min(parseFloat(mPctVal), 100);
                  %>
                  <tr class="<%= filterKode === row.kode ? 'active' : '' %>" style="<%= filterKode === row.kode ? 'background: var(--bg-card-hover); font-weight: 500;' : '' %>">
                    <td class="text-center" style="font-weight: 600; background: var(--bg-subtle);"><%= index + 1 %></td>
                    <td class="td-code hide-md"><%= row.kode %></td>
                    <td class="td-primary" style="font-weight: 600;">
                      <div style="display: inline-flex; align-items: center; gap: 6px; width: 100%;">
                        <a href="<%= navPrefix %>/subsls?kode=<%= row.kode %>&kec=<%= filterKec %>&desa=<%= filterDesa %>&korlap=<%= filterKorlap %>&pml=<%= filterPml %>&pcl=<%= filterPcl %>&status=<%= filterStatus %>&q=<%= encodeURIComponent(filterQ) %>" style="color: inherit; text-decoration: none; display: inline-block;">
                          <%= row.nama_sls %>
                        </a>
                        <button class="pin-btn" data-type="sls" data-name="<%= row.nama_sls %> (<%= row.desa %>)" data-href="<%= navPrefix %>/subsls?kode=<%= row.kode %>" title="Sematkan SLS ke Favorit" style="font-size: 11px; padding: 2px;">
                          <i class="bi bi-star"></i>
                        </button>
                      </div>
                    </td>
                    <td>
                      <div style="font-weight: 600; font-size: 12px;"><%= row.kecamatan %></div>
                      <div style="font-size: 11px; color: var(--text-muted);"><%= row.desa %></div>
                    </td>
                    <td>
                      <div style="font-weight: 500; font-size: 12px;" class="td-primary">
                        <% if (row.pcl) { %>
                          <a href="<%= navPrefix %>/pcl?pcl=<%= encodeURIComponent(row.pcl) %>" style="color: inherit; text-decoration: none;"><%= row.pcl %></a>
                          <% if (kippPcls.includes(row.pcl.toUpperCase())) { %>
                            <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 2px;">KIPP</span>
                          <% } %>
                        <% } else { %>
                          -
                        <% } %>
                      </div>
                      <div style="font-size: 11px; color: var(--text-muted);" class="hide-md">
                        PML: <%= row.pml %>
                        <% if (row.pml && kippPmls.includes(row.pml.toUpperCase())) { %>
                          <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 1px;">KIPP</span>
                        <% } %>
                        <% if (!isSakernas) { %>
                        · Krl: <%= row.korlap %>
                        <% if (row.korlap && kippKorlaps.includes(row.korlap.toUpperCase())) { %>
                          <span class="badge badge-orange" style="padding: 1px 4px; font-size: 8px; vertical-align: middle; margin-left: 1px;">KIPP</span>
                        <% } %>
                        <% } %>
                      </div>

                    </td>
                    <td class="text-center" data-sort="<%= row.sudah_diisi %>">
                      <% if (row.sudah_diisi === 'belum_mulai') { %>
                        <span class="badge badge-gray">Belum Mulai</span>
                      <% } else if (row.sudah_diisi === 'sedang_didata') { %>
                        <span class="badge badge-orange">Sedang Didata</span>
                      <% } else if (row.sudah_diisi === 'memenuhi_target') { %>
                        <span class="badge badge-purple">Memenuhi Target</span>
                      <% } else if (row.sudah_diisi === 'selesai') { %>
                        <span class="badge badge-green">Selesai</span>
                      <% } else { %>
                        <span class="badge badge-gray">-</span>
                      <% } %>
                    </td>

                    <!-- FASIH % Column with Progress Bar -->
                    <td class="bg-purple-soft" data-sort="<%= parseFloat(fPctVal) %>" style="min-width: 130px; padding: 6px 10px; vertical-align: middle;">
                      <div style="display:flex; justify-content:space-between; font-size:10px; color:var(--text-secondary); margin-bottom:3px; white-space: nowrap;">
                        <span style="font-weight:700; color:<%= fColor %>"><%= fPctVal %>%</span>
                        <span><%= fReal.toLocaleString('id-ID') %> / <%= fTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div style="height:5px; background:var(--bg-progress-wrap); border-radius:99px; overflow:hidden;">
                        <div class="progress-bar <%= fW >= 100 ? 'green' : (fW < 40 ? 'red' : 'purple') %>" data-width="<%= fW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>

                    <!-- Muatan % Column with Progress Bar -->
                    <td class="bg-cyan-soft muatan-col" data-sort="<%= parseFloat(mPctVal) %>" style="min-width: 110px; padding: 6px 10px; vertical-align: middle; white-space: nowrap;">
                      <div style="display:flex; justify-content:space-between; font-size:10px; color:var(--text-secondary); margin-bottom:3px; white-space: nowrap;">
                        <span style="font-weight:700; color:var(--accent-cyan)"><%= mPctVal %>%</span>
                        <span><%= mReal.toLocaleString('id-ID') %> / <%= mTgt.toLocaleString('id-ID') %></span>
                      </div>
                      <div style="height:5px; background:var(--bg-progress-wrap); border-radius:99px; overflow:hidden;">
                        <div class="progress-bar <%= mW >= 100 ? 'green' : (mW < 40 ? 'red' : 'blue') %>" data-width="<%= mW %>" style="width:0%; height:100%; border-radius:99px;"></div>
                      </div>
                    </td>
                    
                    <% if (settings.show_status_open === '1' || settings.show_status_open === undefined) { %>
                      <td class="text-right bg-orange-soft status-open-text" data-sort="<%= row.open %>"><%= (row.open || 0).toLocaleString('id-ID') %></td>
                    <% } %>
                    <% if (settings.show_status_draft === '1' || settings.show_status_draft === undefined) { %>
                      <td class="text-right bg-yellow-soft status-draft-text" data-sort="<%= row.draft %>"><%= (row.draft || 0).toLocaleString('id-ID') %></td>
                    <% } %>
                    <% if (settings.show_status_submitted === '1' || settings.show_status_submitted === undefined) { %>
                      <td class="text-right bg-blue-soft status-submit-text" data-sort="<%= row.submitted_by_pcl %>"><%= (row.submitted_by_pcl || 0).toLocaleString('id-ID') %></td>
                    <% } %>
                    <% if (settings.show_status_approved === '1' || settings.show_status_approved === undefined) { %>
                      <td class="text-right bg-green-soft status-approve-text fw-bold" data-sort="<%= row.approved %>"><%= (row.approved || 0).toLocaleString('id-ID') %></td>
                    <% } %>
                    <% if (settings.show_status_rejected === '1' || settings.show_status_rejected === undefined) { %>
                      <td class="text-right bg-red-soft status-reject-text" data-sort="<%= row.rejected %>" style="font-weight: 600;"><%= (row.rejected || 0).toLocaleString('id-ID') %></td>
                    <% } %>
                    <td class="text-right bg-purple-soft" data-sort="<%= row.target_fasih %>"><%= Math.round(row.target_fasih || 0).toLocaleString('id-ID') %></td>
                    
                    <td class="text-right fw-bold bg-cyan-soft muatan-col" data-sort="<%= row.muatan_selesai %>"><%= (row.muatan_selesai || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-cyan-soft muatan-col" data-sort="<%= row.muatan %>"><%= Math.round(row.muatan || 0).toLocaleString('id-ID') %></td>
                    <td class="text-right bg-cyan-soft text-green muatan-col" data-sort="<%= row.usaha_baru %>">+<%= (row.usaha_baru || 0).toLocaleString('id-ID') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- BOTTOM BAR (ROW INFO & LIMIT SELECTOR & PAGINATION) -->
          <% if (typeof total !== 'undefined' && total > 0) { %>
            <div class="table-pagination-bar flex-between" style="padding: 10px 16px; border-top: 1px solid var(--border); background: var(--bg-secondary); border-radius: 0 0 var(--radius-sm) var(--radius-sm); font-size: 12px; flex-wrap: wrap; gap: 8px; align-items: center;">
              <div style="color: var(--text-muted);">
                <% if (limit === 'all' || limit >= total) { %>
                  Menampilkan <strong>Semua <%= total.toLocaleString('id-ID') %></strong> SubSLS
                <% } else { %>
                  Menampilkan <strong><%= Math.min((page - 1) * limit + 1, total).toLocaleString('id-ID') %> - <%= Math.min(page * limit, total).toLocaleString('id-ID') %></strong> dari <strong><%= total.toLocaleString('id-ID') %></strong> SubSLS
                <% } %>
                <% if (filterQ) { %>
                  <span style="margin-left: 4px; color: var(--accent-purple); font-weight: 500;">(pencarian: "<%= filterQ %>")</span>
                <% } %>
              </div>

              <% if (totalPages > 1 && limit !== 'all') { %>
                <div class="flex-start" style="gap: 6px; align-items: center;">
                  <% if (page > 1) { %>
                    <a href="<%= getPageUrl(page - 1) %>" class="btn btn-secondary btn-xs" title="Halaman Sebelumnya"><i class="bi bi-chevron-left"></i> Prev</a>
                  <% } %>
                  <span style="font-weight: 600; padding: 2px 8px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 4px; font-size: 11px;">
                    Hal <%= page %> / <%= totalPages %>
                  </span>
                  <% if (page < totalPages) { %>
                    <a href="<%= getPageUrl(page + 1) %>" class="btn btn-secondary btn-xs" title="Halaman Berikutnya">Next <i class="bi bi-chevron-right"></i></a>
                  <% } %>
                </div>
              <% } %>

              <div class="flex-start" style="gap: 6px; align-items: center; font-size: 11px; color: var(--text-muted);">
                <span><i class="bi bi-list-task"></i> Tampilkan:</span>
                <select onchange="window.location.href=this.value" aria-label="Pilih jumlah baris yang ditampilkan" style="padding: 3px 8px; font-size: 11px; border-radius: 6px; background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border); cursor: pointer; font-weight: 600;">
                  <option value="<%= getPageUrl(1, '100') %>" <%= limit === 100 ? 'selected' : '' %>>100 Baris</option>
                  <option value="<%= getPageUrl(1, '200') %>" <%= limit === 200 ? 'selected' : '' %>>200 Baris</option>
                  <option value="<%= getPageUrl(1, '500') %>" <%= limit === 500 ? 'selected' : '' %>>500 Baris</option>
                  <option value="<%= getPageUrl(1, 'all') %>" <%= limit === 'all' || limit >= total ? 'selected' : '' %>>Semua Baris (<%= total.toLocaleString('id-ID') %>)</option>
                </select>
              </div>
            </div>
          <% } %>
        <% } else { %>
          <div class="no-data">
            <i class="bi bi-slash-circle-fill text-red" style="font-size: 18px; margin-right: 6px;"></i> Tidak ditemukan data SubSLS yang sesuai dengan kriteria filter Anda.
          </div>
        <% } %>
      </div>

      <!-- SUBSLS DETAIL SIDEBAR -->
      <div id="subslsDetailContainer" style="transition: all 0.25s ease;">
        <% if (selectedSubsls) { %>
          <% 
            let fasihDone = (selectedSubsls.submitted_by_pcl || 0) + (selectedSubsls.approved || 0) + (selectedSubsls.rejected || 0);
            let fasihTgt = Math.round(selectedSubsls.target_fasih || 0);
            let fasihPct = fasihTgt > 0 ? ((fasihDone / fasihTgt) * 100).toFixed(2) : '0.00';
            
            let muatanDone = selectedSubsls.muatan_selesai || 0;
            let muatanTgt = Math.round(selectedSubsls.muatan || 0);
            let muatanPct = muatanTgt > 0 ? ((muatanDone / muatanTgt) * 100).toFixed(2) : '0.00';
            let muatanColor = parseFloat(muatanPct) >= 100 ? 'var(--accent-green)' : (parseFloat(muatanPct) < 40 ? 'var(--accent-red)' : 'var(--accent-cyan)');
          %>
          <div class="card" id="subslsDetailCard" style="border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); padding: 20px; position: sticky; top: 80px; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
            <!-- Close & Action Buttons -->
            <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
              <div>
                <span class="badge badge-purple" style="font-size: 9px; padding: 2px 6px; text-transform: uppercase; font-weight: 700; margin-bottom: 4px; display: inline-block;">Rincian SubSLS</span>
                <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.nama_sls %></h3>
                <code style="font-size: 11px; color: var(--text-muted); display: block; margin-top: 2px;"><%= selectedSubsls.kode %></code>
              </div>
              <div class="flex-start" style="gap: 6px; margin-left: auto;">
                <button onclick="window.shareElementAsImage('subslsDetailCard', event)" class="btn btn-secondary btn-xs" title="Bagikan gambar detail card"><i class="bi bi-share"></i><span class="btn-text-desktop"> Bagikan</span></button>
                <button onclick="window.copyElementAsImage('subslsDetailCard', event)" class="btn btn-secondary btn-xs" title="Salin gambar detail card ke clipboard"><i class="bi bi-copy"></i><span class="btn-text-desktop"> Salin</span></button>
                <a href="<%= navPrefix %>/subsls?kec=<%= filterKec %>&desa=<%= filterDesa %>&korlap=<%= filterKorlap %>&pml=<%= filterPml %>&pcl=<%= filterPcl %>&status=<%= filterStatus %>" class="btn btn-secondary btn-xs" title="Tutup detail card"><i class="bi bi-x-lg"></i><span class="btn-text-desktop"> Tutup</span></a>
              </div>
            </div>

            <!-- Identitas Wilayah & Petugas -->
            <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin-bottom: 16px;">
              <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; font-size: 11px; margin-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 8px;">
                <div>
                  <div style="color: var(--text-muted);">Kecamatan</div>
                  <strong style="color: var(--text-primary);"><%= selectedSubsls.kecamatan %></strong>
                </div>
                <div>
                  <div style="color: var(--text-muted);">Desa/Kelurahan</div>
                  <strong style="color: var(--text-primary);"><%= selectedSubsls.desa %></strong>
                </div>
              </div>
              
              <div style="display: flex; flex-direction: column; gap: 6px; font-size: 11px;">
                <div class="flex-between" style="align-items: unset;">
                  <span style="color: var(--text-muted);"><i class="bi bi-person-badge"></i> <%= officerLabel %> (<%= isSakernas ? 'Petugas Pendataan' : 'Pencacah' %>)</span>
                  <strong style="color: var(--text-primary);"><%= selectedSubsls.pcl || '-' %></strong>
                </div>
                <div class="flex-between" style="align-items: unset;">
                  <span style="color: var(--text-muted);"><i class="bi bi-person-check"></i> Pengawas (PML)</span>
                  <strong style="color: var(--text-primary);"><%= selectedSubsls.pml || '-' %></strong>
                </div>
                <% if (!isSakernas) { %>
                <div class="flex-between" style="align-items: unset;">
                  <span style="color: var(--text-muted);"><i class="bi bi-person-gear"></i> Korlap</span>
                  <strong style="color: var(--text-primary);"><%= selectedSubsls.korlap || '-' %></strong>
                </div>
                <% } %>
              </div>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
              <span style="font-size: 12px; color: var(--text-secondary); font-weight: 500;">Status Progres SLS:</span>
              <% if (selectedSubsls.sudah_diisi === 'belum_mulai') { %>
                <span class="badge badge-gray" style="padding: 4px 10px; font-size: 10px;">Belum Mulai</span>
              <% } else if (selectedSubsls.sudah_diisi === 'sedang_didata') { %>
                <span class="badge badge-orange" style="padding: 4px 10px; font-size: 10px;">Sedang Didata</span>
              <% } else { %>
                <span class="badge badge-green" style="padding: 4px 10px; font-size: 10px;">Selesai</span>
              <% } %>
            </div>

            <!-- PROGRESS CARDS -->
            <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 20px;">
              <!-- FASIH CARD -->
              <div style="background: rgba(167,139,250,0.03); border: 1px solid rgba(167,139,250,0.15); border-radius: 12px; padding: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <span style="font-size: 11px; font-weight: 700; color: var(--accent-purple); text-transform: uppercase;"><i class="bi bi-file-earmark-text"></i> Assignment FASIH</span>
                  <span style="font-size: 13px; font-weight: 700; color: var(--accent-purple);"><%= fasihPct %>%</span>
                </div>
                <div class="bar-label" style="margin-bottom: 6px;">
                  <span>Capaian Dokumen</span>
                  <strong><%= fasihDone %> / <%= fasihTgt %></strong>
                </div>
                <div style="height: 6px; background: rgba(167,139,250,0.1); border-radius: 99px; overflow: hidden; margin-bottom: 12px;">
                  <div class="progress-bar purple" data-width="<%= Math.min(parseFloat(fasihPct), 100) %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(<%= activeSubslsStatusCols - 1 %>, 1fr); gap: 4px; text-align: center; font-size: 10px;">
                  <% if (settings.show_status_open === '1' || settings.show_status_open === undefined) { %>
                    <div style="background: rgba(249,115,22,0.06); border: 1px solid rgba(249,115,22,0.15); padding: 4px; border-radius: 6px;">
                      <div style="color: #f97316; font-size: 8px; font-weight: bold; text-transform: uppercase;">Open</div>
                      <div style="font-size: 12px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.open || 0 %></div>
                    </div>
                  <% } %>
                  <% if (settings.show_status_draft === '1' || settings.show_status_draft === undefined) { %>
                    <div style="background: rgba(251,191,36,0.06); border: 1px solid rgba(251,191,36,0.15); padding: 4px; border-radius: 6px;">
                      <div style="color: var(--accent-yellow); font-size: 8px; font-weight: bold; text-transform: uppercase;">Draft</div>
                      <div style="font-size: 12px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.draft %></div>
                    </div>
                  <% } %>
                  <% if (settings.show_status_submitted === '1' || settings.show_status_submitted === undefined) { %>
                    <div style="background: rgba(59,130,246,0.06); border: 1px solid rgba(59,130,246,0.15); padding: 4px; border-radius: 6px;">
                      <div style="color: var(--accent-blue); font-size: 8px; font-weight: bold; text-transform: uppercase;">Submit</div>
                      <div style="font-size: 12px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.submitted_by_pcl %></div>
                    </div>
                  <% } %>
                  <% if (settings.show_status_approved === '1' || settings.show_status_approved === undefined) { %>
                    <div style="background: rgba(34,197,94,0.06); border: 1px solid rgba(34,197,94,0.15); padding: 4px; border-radius: 6px;">
                      <div style="color: var(--accent-green); font-size: 8px; font-weight: bold; text-transform: uppercase;">Appr</div>
                      <div style="font-size: 12px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.approved %></div>
                    </div>
                  <% } %>
                  <% if (settings.show_status_rejected === '1' || settings.show_status_rejected === undefined) { %>
                    <div style="background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.15); padding: 4px; border-radius: 6px;">
                      <div style="color: var(--accent-red); font-size: 8px; font-weight: bold; text-transform: uppercase;">Rejc</div>
                      <div style="font-size: 12px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.rejected %></div>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- MUATAN CARD (SENSUS ONLY) -->
              <% if (!isSakernas && (typeof settings === 'undefined' || settings.show_progres_muatan !== '0')) { %>
              <div class="muatan-col" style="background: rgba(6,182,212,0.03); border: 1px solid rgba(6,182,212,0.15); border-radius: 12px; padding: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <span style="font-size: 11px; font-weight: 700; color: var(--accent-cyan); text-transform: uppercase;"><i class="bi bi-box-seam"></i> Progres Muatan</span>
                  <span style="font-size: 13px; font-weight: 700; color: <%= muatanColor %>;"><%= muatanPct %>%</span>
                </div>
                <div class="bar-label" style="margin-bottom: 6px;">
                  <span>Realisasi / Target</span>
                  <strong><%= muatanDone %> / <%= muatanTgt %></strong>
                </div>
                <div style="height: 6px; background: rgba(6,182,212,0.1); border-radius: 99px; overflow: hidden; margin-bottom: 12px;">
                  <div class="progress-bar <%= parseFloat(muatanPct) >= 100 ? 'green' : (parseFloat(muatanPct) < 40 ? 'red' : 'blue') %>" data-width="<%= Math.min(parseFloat(muatanPct), 100) %>" style="width: 0%; height: 100%; border-radius: 99px;"></div>
                </div>
                
                <!-- Temuan Keberadaan Usaha -->
                <div style="font-size: 10px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 6px; display: flex; align-items: center; gap: 4px;">
                  <i class="bi bi-shop"></i> Temuan Keberadaan Usaha
                </div>
                <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; text-align: center; font-size: 9px; margin-bottom: 12px;">
                  <div style="background: rgba(34,197,94,0.06); padding: 4px 2px; border-radius: 4px; border: 1px solid rgba(34,197,94,0.1);">
                    <div style="color: var(--accent-green); font-size: 7px; font-weight: bold; text-transform: uppercase; overflow: hidden; white-space: nowrap;">Ada</div>
                    <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.usaha_ditemukan %></div>
                  </div>
                  <div style="background: rgba(59,130,246,0.06); padding: 4px 2px; border-radius: 4px; border: 1px solid rgba(59,130,246,0.1);">
                    <div style="color: var(--accent-blue); font-size: 7px; font-weight: bold; text-transform: uppercase; overflow: hidden; white-space: nowrap;">Baru</div>
                    <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.usaha_baru %></div>
                  </div>
                  <div style="background: rgba(239,68,68,0.06); padding: 4px 2px; border-radius: 4px; border: 1px solid rgba(239,68,68,0.1);">
                    <div style="color: var(--accent-red); font-size: 7px; font-weight: bold; text-transform: uppercase; overflow: hidden; white-space: nowrap;">Tdk Ada</div>
                    <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.usaha_tidak_ditemukan %></div>
                  </div>
                  <div style="background: rgba(251,191,36,0.06); padding: 4px 2px; border-radius: 4px; border: 1px solid rgba(251,191,36,0.1);">
                    <div style="color: var(--accent-yellow); font-size: 7px; font-weight: bold; text-transform: uppercase; overflow: hidden; white-space: nowrap;">Tutup</div>
                    <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.usaha_tutup %></div>
                  </div>
                  <div style="background: rgba(167,139,250,0.06); padding: 4px 2px; border-radius: 4px; border: 1px solid rgba(167,139,250,0.1);">
                    <div style="color: var(--accent-purple); font-size: 7px; font-weight: bold; text-transform: uppercase; overflow: hidden; white-space: nowrap;">Ganda</div>
                    <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.usaha_ganda %></div>
                  </div>
                </div>

                <!-- Temuan Keberadaan Keluarga -->
                <div style="font-size: 10px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 6px; display: flex; align-items: center; gap: 4px;">
                  <i class="bi bi-people"></i> Temuan Keberadaan Keluarga
                </div>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; text-align: center; font-size: 9px;">
                  <div style="background: rgba(34,197,94,0.06); padding: 4px 2px; border-radius: 4px; border: 1px solid rgba(34,197,94,0.1);">
                    <div style="color: var(--accent-green); font-size: 7px; font-weight: bold; text-transform: uppercase;">Ditemukan</div>
                    <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.ditemukan %></div>
                  </div>
                  <div style="background: rgba(59,130,246,0.06); padding: 4px 2px; border-radius: 4px; border: 1px solid rgba(59,130,246,0.1);">
                    <div style="color: var(--accent-blue); font-size: 7px; font-weight: bold; text-transform: uppercase;">Klg Baru</div>
                    <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.keluarga_baru %></div>
                  </div>
                  <div style="background: rgba(239,68,68,0.06); padding: 4px 2px; border-radius: 4px; border: 1px solid rgba(239,68,68,0.1);">
                    <div style="color: var(--accent-red); font-size: 7px; font-weight: bold; text-transform: uppercase;">Tdk Ada</div>
                    <div style="font-size: 11px; font-weight: 700; color: var(--text-primary);"><%= selectedSubsls.tidak_ditemukan %></div>
                  </div>
                </div>
              </div>
              <% } %>
            </div>

            <!-- Analisis Kecepatan & Estimasi Pendataan -->
            <%
              let remainingFasih = Math.max(0, fasihTgt - fasihDone);
              let currentSpeed = fasihDone / diffDays; // dokumen per hari
              let currentSpeedText = currentSpeed.toFixed(2);
              
              let estDaysToFinish = currentSpeed > 0 ? (remainingFasih / currentSpeed) : null;
              let isOfftrack = (currentSpeed === 0 && remainingFasih > 0) || (estDaysToFinish !== null && estDaysToFinish > daysRemaining);
              
              let reqSpeed = daysRemaining > 0 ? (remainingFasih / daysRemaining) : remainingFasih;
            %>
            <div style="margin-top: 18px; padding: 14px; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px;">
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-cyan); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                <i class="bi bi-speedometer2" style="font-size: 14px;"></i> Analisis Kecepatan & Sisa Waktu
              </div>
              
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 8px; text-align: center;">
                  <div style="font-size: 10px; color: var(--text-muted); font-weight: 500;">Kecepatan Saat Ini</div>
                  <div style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-top: 2px;"><%= currentSpeedText %> <span style="font-size: 10px; font-weight: 500; color: var(--text-muted);">dok/hari</span></div>
                </div>
                <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 8px; text-align: center;">
                  <div style="font-size: 10px; color: var(--text-muted); font-weight: 500;">Status Target</div>
                  <div style="font-size: 12px; font-weight: 700; margin-top: 4px;">
                    <% if (remainingFasih === 0) { %>
                      <span class="badge badge-green" style="font-size: 10px; padding: 3px 8px;">Selesai 100%</span>
                    <% } else if (isOfftrack) { %>
                      <span class="badge badge-red" style="font-size: 10px; padding: 3px 8px;"><i class="bi bi-exclamation-triangle-fill"></i> Off-Track</span>
                    <% } else { %>
                      <span class="badge badge-green" style="font-size: 10px; padding: 3px 8px;"><i class="bi bi-check-circle-fill"></i> On-Track</span>
                    <% } %>
                  </div>
                </div>
              </div>
              
              <div style="font-size: 11px; line-height: 1.5; color: var(--text-secondary);">
                <% if (remainingFasih === 0) { %>
                  Seluruh target pengisian dokumen FASIH sebanyak <strong><%= fasihTgt %></strong> dokumen pada SubSLS ini telah diselesaikan. Kinerja luar biasa!
                <% } else { %>
                  Hari berjalan pendataan: <strong><%= diffDays %> hari</strong> (sejak <%= formatIndonesianDate(settings.speedometer_start_date || '2026-06-15') %>). Sisa hari menuju deadline (<%= formatIndonesianDate(settings.speedometer_target_date || '2026-08-31') %>): <strong><%= daysRemaining %> hari</strong>.<br>
                  Sisa beban kerja: <strong><%= remainingFasih %> dokumen</strong>. 
                  Dengan kecepatan saat ini (<strong><%= currentSpeedText %> dok/hari</strong>), 
                  <% if (currentSpeed === 0) { %>
                    progres belum berjalan sehingga estimasi hari selesai tidak dapat diprediksi.
                  <% } else { %>
                    beban kerja diprediksi akan selesai dalam waktu sekitar <strong><%= Math.ceil(estDaysToFinish) %> hari</strong>.
                  <% } %>
                  
                  <% if (isOfftrack) { %>
                    <div style="margin-top: 8px; padding: 8px; background: rgba(239, 68, 68, 0.08); border-left: 3px solid var(--accent-red); border-radius: 4px; color: var(--text-primary); display: flex; align-items: flex-start; gap: 6px;">
                      <i class="bi bi-exclamation-triangle-fill" style="color: var(--accent-red); font-size: 13px; margin-top: 1px;"></i>
                      <div><strong>Off-Track:</strong> Progres diprediksi terlambat/tidak selesai tepat waktu. Diperlukan peningkatan kecepatan kerja minimal menjadi <strong><%= reqSpeed.toFixed(2) %> dok/hari</strong> agar selesai sesuai target pada <%= formatIndonesianDate(settings.speedometer_target_date || '2026-08-31') %>.</div>
                    </div>
                  <% } else { %>
                    <div style="margin-top: 8px; padding: 8px; background: rgba(34, 197, 94, 0.08); border-left: 3px solid var(--accent-green); border-radius: 4px; color: var(--text-primary); display: flex; align-items: flex-start; gap: 6px;">
                      <i class="bi bi-check-circle-fill" style="color: var(--accent-green); font-size: 13px; margin-top: 1px;"></i>
                      <div><strong>On-Track:</strong> Kecepatan progres sudah memadai untuk menyelesaikan seluruh beban kerja sebelum deadline (estimasi selesai sebelum <%= formatIndonesianDate(settings.speedometer_target_date || '2026-08-31') %>).</div>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </div>

            <!-- Daily Progress Chart -->
            <div style="margin-top: 20px; border-top: 1px solid var(--border); padding-top: 16px; margin-left: -20px; margin-right: -20px;">
              <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 8px; padding-left: 20px; padding-right: 20px;">
                <i class="bi bi-graph-up"></i> Tren Progres Harian (FASIH)
              </div>
              <div style="height: 180px; position: relative; width: 100%; padding-left: 10px; padding-right: 10px;">
                <canvas id="subslsHistoryChartCanvas"></canvas>
              </div>
            </div>

            <!-- JSON data script tag -->
            <script id="subslsHistoryData" type="application/json">
              <%- JSON.stringify(subslsHistory) %>
            </script>

          </div>
        <% } else { %>
          <div class="card empty-state text-center" style="height: 100%; min-height: 300px; display: flex; flex-direction: column; justify-content: center; border-style: dashed;">
            <div class="empty-state-icon"><i class="bi bi-arrow-left-circle"></i></div>
            <div class="empty-state-title">Pilih SubSLS</div>
            <div class="empty-state-text">Klik nama SubSLS di tabel sebelah kiri untuk melihat rincian progres tugas, temuan muatan, dan detail lainnya secara lengkap.</div>
          </div>
        <% } %>
      </div>

    </div>
    </div>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('ajax-container');
  if (!container) return;

  function attachListeners() {
    // Initialize expand buttons for AJAX loaded content
    if (window.initExpandButtons) {
      window.initExpandButtons(container);
    }
    // 1. Re-initialize sorting, progress bars, and chart
    makeTableSortable('subslsTable');
    if (window.initProgressBars) window.initProgressBars(container);
    initSubslsHistoryChart();

    // 2. Filter form & search input listeners
    const filterForm = document.getElementById('filterForm');
    const tableSearch = document.getElementById('tableSearch');
    const filterSearch = document.getElementById('filterSearch');
    const clearSearchBtn = document.getElementById('clearSearchBtn');

    let searchTimeout = null;
    function triggerSearch(val) {
      if (filterSearch && filterSearch.value !== val) filterSearch.value = val;
      if (tableSearch && tableSearch.value !== val) tableSearch.value = val;
      if (filterForm) {
        const formData = new FormData(filterForm);
        formData.set('q', val);
        formData.set('page', '1');
        const queryString = new URLSearchParams(formData).toString();
        fetchAndReplace(queryString, false);
      }
    }

    if (tableSearch) {
      tableSearch.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          triggerSearch(e.target.value);
        }, 250);
      });
      tableSearch.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          clearTimeout(searchTimeout);
          triggerSearch(tableSearch.value);
        }
      });
    }

    if (filterSearch) {
      filterSearch.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          triggerSearch(e.target.value);
        }, 250);
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', (e) => {
        e.preventDefault();
        clearTimeout(searchTimeout);
        triggerSearch('');
      });
    }

    if (filterForm) {
      const selects = filterForm.querySelectorAll('select');
      selects.forEach(sel => {
        sel.addEventListener('change', () => {
          const isKecChange = sel.name === 'kec';
          const formData = new FormData(filterForm);
          if (tableSearch) formData.set('q', tableSearch.value);
          const queryString = new URLSearchParams(formData).toString();
          fetchAndReplace(queryString, isKecChange);
        });
      });
      
      const resetBtn = container.querySelector('a[href*="/subsls"]');
      if (resetBtn) {
        resetBtn.addEventListener('click', (e) => {
          e.preventDefault();
          fetchAndReplace('', true);
        });
      }
    }

    // 3. AJAX Drilldown logic for SubSLS details (updates only the detail segment with Caching & Loading Spinner)
    const detailContainer = document.getElementById('subslsDetailContainer');
    const table = document.getElementById('subslsTable');

    function renderDetail(html, url) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const newDetail = doc.getElementById('subslsDetailContainer');
      if (newDetail) {
        detailContainer.innerHTML = newDetail.innerHTML;
        detailContainer.style.opacity = '1';

        // Toggle grid selection classes
        const grid = document.querySelector('.drilldown-grid');
        if (grid) {
          grid.classList.remove('no-selection');
          grid.classList.add('has-selection');
        }

        // Update URL path without refresh
        window.history.pushState(null, '', url);

        // Re-bind close handler
        bindCloseDetail();
        if (window.initProgressBars) window.initProgressBars(detailContainer);
        initSubslsHistoryChart();
      }
    }

    function bindCloseDetail() {
      if (!detailContainer) return;
      const closeBtn = detailContainer.querySelector('.btn-close-detail');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const url = closeBtn.getAttribute('href');

          // Reset active rows
          if (table) {
            table.querySelectorAll('tbody tr').forEach(r => {
              r.classList.remove('active');
              r.style.background = '';
              r.style.fontWeight = '';
            });
          }

          if (window.detailHtmlCache && window.detailHtmlCache[url]) {
            renderDetail(window.detailHtmlCache[url], url);
            const grid = document.querySelector('.drilldown-grid');
            if (grid) {
              grid.classList.remove('has-selection');
              grid.classList.add('no-selection');
            }
          } else {
            detailContainer.innerHTML = `
              <div class="card skeleton-card" style="border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); padding: 20px; position: sticky; top: 80px; display: flex; flex-direction: column; gap: 16px; min-height: 350px;">
                <div class="flex-between">
                  <div class="skeleton-block" style="height: 18px; width: 60%; border-radius: 6px;"></div>
                  <div class="skeleton-block" style="height: 20px; width: 20px; border-radius: 50%;"></div>
                </div>
                <div class="skeleton-block" style="height: 12px; width: 40%; border-radius: 4px; margin-top: -4px;"></div>
                
                <div style="border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-top: 10px; display: flex; flex-direction: column; gap: 10px;">
                  <div class="flex-between">
                    <div class="skeleton-block" style="height: 12px; width: 50%; border-radius: 4px;"></div>
                    <div class="skeleton-block" style="height: 12px; width: 25%; border-radius: 4px;"></div>
                  </div>
                  <div class="skeleton-block" class="progress-track"></div>
                  
                  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-top: 4px;">
                    <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                    <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                    <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                    <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                  </div>
                </div>

                <div style="border: 1px solid var(--border); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
                  <div class="flex-between">
                    <div class="skeleton-block" style="height: 12px; width: 40%; border-radius: 4px;"></div>
                    <div class="skeleton-block" style="height: 12px; width: 20%; border-radius: 4px;"></div>
                  </div>
                  <div class="skeleton-block" class="progress-track"></div>
                </div>

                <div style="border-top: 1px solid var(--border); padding-top: 16px; display: flex; flex-direction: column; gap: 10px;">
                  <div class="skeleton-block" style="height: 12px; width: 50%; border-radius: 4px;"></div>
                  <div class="skeleton-block" style="height: 120px; width: 100%; border-radius: 8px;"></div>
                </div>
              </div>
            `;
            detailContainer.style.opacity = '1';

            fetch(url)
              .then(res => res.text())
              .then(html => {
                if (!window.detailHtmlCache) window.detailHtmlCache = {};
                window.detailHtmlCache[url] = html;
                renderDetail(html, url);
                const grid = document.querySelector('.drilldown-grid');
                if (grid) {
                  grid.classList.remove('has-selection');
                  grid.classList.add('no-selection');
                }
              })
              .catch(err => {
                console.error(err);
                detailContainer.style.opacity = '1';
              });
          }
        });
      }
    }

    if (table && detailContainer) {
      table.querySelector('tbody').addEventListener('click', (e) => {
        const link = e.target.closest('td.td-primary a');
        if (!link) return;

        e.preventDefault();
        const url = link.getAttribute('href');
        const row = link.closest('tr');

        // Update active row visual indicator
        table.querySelectorAll('tbody tr').forEach(r => {
          r.classList.remove('active');
          r.style.background = '';
          r.style.fontWeight = '';
        });
        row.classList.add('active');
        row.style.background = 'var(--bg-card-hover)';
        row.style.fontWeight = '500';

        if (window.detailHtmlCache && window.detailHtmlCache[url]) {
          renderDetail(window.detailHtmlCache[url], url);
        } else {
          // Loading spinner animation card
          detailContainer.innerHTML = `
            <div class="card skeleton-card" style="border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); padding: 20px; position: sticky; top: 80px; display: flex; flex-direction: column; gap: 16px; min-height: 350px;">
              <div class="flex-between">
                <div class="skeleton-block" style="height: 18px; width: 60%; border-radius: 6px;"></div>
                <div class="skeleton-block" style="height: 20px; width: 20px; border-radius: 50%;"></div>
              </div>
              <div class="skeleton-block" style="height: 12px; width: 40%; border-radius: 4px; margin-top: -4px;"></div>
              
              <div style="border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-top: 10px; display: flex; flex-direction: column; gap: 10px;">
                <div class="flex-between">
                  <div class="skeleton-block" style="height: 12px; width: 50%; border-radius: 4px;"></div>
                  <div class="skeleton-block" style="height: 12px; width: 25%; border-radius: 4px;"></div>
                </div>
                <div class="skeleton-block" class="progress-track"></div>
                
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-top: 4px;">
                  <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                  <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                  <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                  <div class="skeleton-block" style="height: 38px; border-radius: 6px;"></div>
                </div>
              </div>

              <div style="border: 1px solid var(--border); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
                <div class="flex-between">
                  <div class="skeleton-block" style="height: 12px; width: 40%; border-radius: 4px;"></div>
                  <div class="skeleton-block" style="height: 12px; width: 20%; border-radius: 4px;"></div>
                </div>
                <div class="skeleton-block" class="progress-track"></div>
              </div>

              <div style="border-top: 1px solid var(--border); padding-top: 16px; display: flex; flex-direction: column; gap: 10px;">
                <div class="skeleton-block" style="height: 12px; width: 50%; border-radius: 4px;"></div>
                <div class="skeleton-block" style="height: 120px; width: 100%; border-radius: 8px;"></div>
              </div>
            </div>
          `;
          detailContainer.style.opacity = '1';

          fetch(url)
            .then(res => res.text())
            .then(html => {
              if (!window.detailHtmlCache) window.detailHtmlCache = {};
              window.detailHtmlCache[url] = html;
              renderDetail(html, url);
            })
            .catch(err => {
              console.error(err);
              detailContainer.style.opacity = '1';
            });
        }
      });
    }

    bindCloseDetail();
  }

  let currentFetchController = null;

  function fetchAndReplace(queryString, refreshAll) {
    if (window.detailHtmlCache) {
      for (let key in window.detailHtmlCache) delete window.detailHtmlCache[key];
    }

    if (currentFetchController) {
      currentFetchController.abort();
    }
    currentFetchController = new AbortController();

    const url = '<%= navPrefix %>/subsls' + (queryString ? (queryString.startsWith('?') ? queryString : '?' + queryString) : '');
    
    // Save active element focus and selection state
    const activeEl = document.activeElement;
    const activeId = (activeEl && (activeEl.id === 'tableSearch' || activeEl.id === 'filterSearch')) ? activeEl.id : null;
    const activeValue = activeEl ? activeEl.value : '';
    const selStart = (activeEl && activeEl.selectionStart !== undefined) ? activeEl.selectionStart : null;
    const selEnd = (activeEl && activeEl.selectionEnd !== undefined) ? activeEl.selectionEnd : null;

    // Fading indicator only on table body, never on search inputs
    const tbody = document.querySelector('#subslsTable tbody');
    if (tbody) tbody.style.opacity = '0.4';
    
    fetch(url, { signal: currentFetchController.signal })
      .then(res => res.text())
      .then(html => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        
        if (refreshAll) {
          const targetElement = document.getElementById('ajax-container');
          const newElement = doc.getElementById('ajax-container');
          if (targetElement && newElement) {
            targetElement.innerHTML = newElement.innerHTML;
            history.pushState(null, '', url);
            attachListeners();
          }
        } else {
          // Partial table update (keeps search input elements alive in DOM)
          const currentContainer = document.getElementById('subslsTableContainer');
          const newContainer = doc.getElementById('subslsTableContainer');
          
          if (currentContainer && newContainer) {
            // Update Card Header (Summary & Export link)
            const currentHeader = currentContainer.querySelector('.card-header');
            const newHeader = newContainer.querySelector('.card-header');
            if (currentHeader && newHeader) {
              currentHeader.innerHTML = newHeader.innerHTML;
            }

            // Update Table Content / No-data state
            const currentWrap = currentContainer.querySelector('.table-wrap');
            const newWrap = newContainer.querySelector('.table-wrap');
            const currentNoData = currentContainer.querySelector('.no-data');
            const newNoData = newContainer.querySelector('.no-data');

            if (currentWrap && newWrap) {
              currentWrap.innerHTML = newWrap.innerHTML;
            } else if (currentWrap && newNoData) {
              currentWrap.outerHTML = newNoData.outerHTML;
            } else if (currentNoData && newWrap) {
              currentNoData.outerHTML = newWrap.outerHTML;
            } else if (currentNoData && newNoData) {
              currentNoData.innerHTML = newNoData.innerHTML;
            }

            // Update Pagination Bar
            const currentPag = currentContainer.querySelector('.table-pagination-bar');
            const newPag = newContainer.querySelector('.table-pagination-bar');
            if (currentPag && newPag) {
              currentPag.innerHTML = newPag.innerHTML;
            } else if (!currentPag && newPag) {
              currentContainer.appendChild(newPag);
            } else if (currentPag && !newPag) {
              currentPag.remove();
            }

            history.pushState(null, '', url);
            attachListeners();
          }
        }

        // Restore focus & cursor selection position if active element lost focus
        if (activeId) {
          const restoredEl = document.getElementById(activeId);
          if (restoredEl) {
            if (document.activeElement !== restoredEl) {
              restoredEl.focus();
            }
            if (activeValue.length > restoredEl.value.length) {
              restoredEl.value = activeValue;
            }
            if (selStart !== null && selEnd !== null) {
              try { restoredEl.setSelectionRange(selStart, selEnd); } catch (e) {}
            }
          }
        }
      })
      .catch(err => {
        if (err.name !== 'AbortError') console.error(err);
      })
      .finally(() => {
        const updatedTbody = document.querySelector('#subslsTable tbody');
        if (updatedTbody) updatedTbody.style.opacity = '1';
      });
  }

  function initSubslsHistoryChart() {
    const dataEl = document.getElementById('subslsHistoryData');
    if (!dataEl) return;
    try {
      const data = JSON.parse(dataEl.textContent);
      if (data && data.length) {
        if (typeof Chart !== 'undefined') {
          const existingChart = Chart.getChart("subslsHistoryChartCanvas");
          if (existingChart) {
            existingChart.destroy();
          }
        }
        if (typeof createPclHistoryChart === 'function') {
          createPclHistoryChart('subslsHistoryChartCanvas', data);
        }
      }
    } catch (e) {
      console.error('Failed to init SubSLS history chart:', e);
    }
  }

  attachListeners();
  
  window.addEventListener('popstate', () => {
    fetchAndReplace(window.location.search, true);
  });
});
</script>
