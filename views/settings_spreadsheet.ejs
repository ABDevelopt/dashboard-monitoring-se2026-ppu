<%- contentFor('body') %>

<div class="fade-in">
  <!-- HERO BANNER -->
  <div style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, rgba(6, 182, 212, 0.04) 100%); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 16px; padding: 28px; margin-bottom: 24px; position: relative; overflow: hidden;">
    <div style="position: absolute; right: -15px; top: -15px; font-size: 110px; opacity: 0.04; line-height: 1; pointer-events: none; color: var(--accent-yellow);">
      <i class="bi bi-file-earmark-spreadsheet-fill"></i>
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; position: relative; z-index: 2;">
      <div style="display: flex; gap: 16px; align-items: center;">
        <div style="width: 54px; height: 54px; border-radius: 14px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: var(--accent-yellow); font-size: 26px; flex-shrink: 0; box-shadow: 0 0 16px rgba(245, 158, 11, 0.2);">
          <i class="bi bi-file-earmark-spreadsheet-fill"></i>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <h1 style="font-size: 20px; font-weight: 800; color: var(--text-primary); margin: 0;">Pengelolaan Sinkronisasi Spreadsheet</h1>
            <span class="badge badge-green" style="font-size: 10px; padding: 4px 8px; display: flex; align-items: center; gap: 4px;">
              <i class="bi bi-broadcast"></i> Live Sync Active
            </span>
          </div>
          <p style="font-size: 13px; color: var(--text-secondary); margin: 0; max-width: 720px; line-height: 1.5;">
            Pusat kendali integrasi data anomali sensus 2-arah antara Dashboard Monitoring SE2026 PPU dan Google Spreadsheet Pengawasan.
          </p>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="/admin" class="btn btn-secondary" style="padding: 9px 14px; font-size: 12px; border-radius: 8px;">
          <i class="bi bi-arrow-left"></i> Kembali ke Admin
        </a>
      </div>
    </div>
  </div>

  <!-- STATUS SUMMARY CARDS -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 16px; margin-bottom: 24px;">
    <div class="card" style="margin: 0; padding: 18px;">
      <div style="font-size: 12px; color: var(--text-muted); font-weight: 600;">Status Data Stream (Read)</div>
      <div style="font-size: 20px; font-weight: 800; margin-top: 4px; color: <%= syncError ? 'var(--accent-red)' : 'var(--accent-green)' %>;">
        <%= syncError ? '❌ Error Fetch' : '✅ Terhubung' %>
      </div>
      <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Spreadsheet PubHTML</div>
    </div>

    <div class="card" style="margin: 0; padding: 18px;">
      <div style="font-size: 12px; color: var(--text-muted); font-weight: 600;">Status Webhook (Write-Back)</div>
      <div style="font-size: 20px; font-weight: 800; margin-top: 4px; color: var(--accent-yellow);">
        ⚡ Ready (2-Way)
      </div>
      <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Google Apps Script Web App</div>
    </div>

    <div class="card" style="margin: 0; padding: 18px;">
      <div style="font-size: 12px; color: var(--text-muted); font-weight: 600;">Total Record Anomali</div>
      <div style="font-size: 20px; font-weight: 800; margin-top: 4px; color: var(--accent-cyan);">
        <%= sheetsData ? sheetsData.summary.total_anomali.toLocaleString('id-ID') : 0 %>
      </div>
      <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Usaha: <%= sheetsData ? sheetsData.summary.total_usaha : 0 %> | KK: <%= sheetsData ? sheetsData.summary.total_keluarga : 0 %></div>
    </div>

    <div class="card" style="margin: 0; padding: 18px;">
      <div style="font-size: 12px; color: var(--text-muted); font-weight: 600;">Penyelesaian Tindak Lanjut</div>
      <div style="font-size: 20px; font-weight: 800; margin-top: 4px; color: var(--accent-green);">
        <%= sheetsData ? sheetsData.summary.pct_sudah : 0 %>%
      </div>
      <div style="font-size: 11px; color: var(--accent-green); margin-top: 4px;"><%= sheetsData ? sheetsData.summary.total_sudah : 0 %> dari <%= sheetsData ? sheetsData.summary.total_anomali : 0 %> terselesaikan</div>
    </div>
  </div>

  <!-- CONFIGURATION FORM CARD -->
  <div class="card" style="margin-bottom: 24px;">
    <div class="card-header" style="padding-bottom: 12px; border-bottom: 1px solid var(--border);">
      <div class="card-title" style="font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
        <i class="bi bi-gear-fill text-yellow"></i> Konfigurasi URL Google Spreadsheet
      </div>
    </div>

    <form action="/admin/spreadsheet/save" method="POST" style="margin-top: 16px;">
      
      <!-- Field 1: Read-Only PubHTML URL -->
      <div style="margin-bottom: 20px;">
        <label for="google_sheets_anomaly_url" style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: var(--text-primary);">
          1. URL Google Spreadsheet (Publikasi Web / Read Stream)
        </label>
        <input type="url" id="google_sheets_anomaly_url" name="google_sheets_anomaly_url" required value="<%= settings.google_sheets_anomaly_url || '' %>" placeholder="https://docs.google.com/spreadsheets/d/e/.../pubhtml" style="width: 100%; padding: 10px 14px; font-size: 13px; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary); font-family: monospace;">
        <div style="font-size: 11.5px; color: var(--text-secondary); margin-top: 6px; line-height: 1.4;">
          URL publikasi web dari Google Spreadsheet yang berisi sheet <strong>Anomali Usaha (UTP)</strong> dan <strong>Anomali Keluarga (KK)</strong>.
          <br><small style="color: var(--text-muted);">Cara Dapatkan: Di Google Sheets ➔ Klik <code>File</code> ➔ <code>Share</code> ➔ <code>Publish to web</code> ➔ Salin Link Web Page/HTML.</small>
        </div>
      </div>

      <!-- Field 2: Apps Script Web App URL -->
      <div style="margin-bottom: 24px;">
        <label for="google_sheets_apps_script_url" style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: var(--text-primary);">
          2. URL Google Apps Script Web App (2-Way Sync / Write-Back)
        </label>
        <input type="url" id="google_sheets_apps_script_url" name="google_sheets_apps_script_url" required value="<%= settings.google_sheets_apps_script_url || '' %>" placeholder="https://script.google.com/macros/s/.../exec" style="width: 100%; padding: 10px 14px; font-size: 13px; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary); font-family: monospace;">
        <div style="font-size: 11.5px; color: var(--text-secondary); margin-top: 6px; line-height: 1.4;">
          URL Web App Apps Script untuk menerima update status tindak lanjut &amp; penjelasan yang di-edit oleh pengawas di website dasbor.
          <br><small style="color: var(--text-muted);">Cara Dapatkan: Di Apps Script ➔ Klik <code>Deploy</code> ➔ <code>New deployment</code> ➔ Pilih <code>Web app</code> ➔ Set <code>Execute as: Me</code> &amp; <code>Access: Anyone</code>.</small>
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-between; align-items: center; padding-top: 16px; border-top: 1px solid var(--border);">
        <button type="submit" class="btn btn-primary" style="padding: 10px 20px; font-size: 13px; font-weight: 700; border-radius: 8px; background: linear-gradient(135deg, var(--accent-yellow), #d97706); color: #000; border: none; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);">
          <i class="bi bi-save-fill"></i> Simpan Konfigurasi
        </button>

        <div style="display: flex; gap: 10px;">
          <form action="/admin/spreadsheet/sync-now" method="POST" style="margin: 0; display: inline;">
            <button type="submit" class="btn btn-secondary" style="padding: 10px 16px; font-size: 12px; font-weight: 600; border-radius: 8px;" title="Menghapus cache dan mengambil data terbaru dari Google Spreadsheet">
              <i class="bi bi-arrow-clockwise"></i> Paksa Sync Data Sekarang
            </button>
          </form>

          <form action="/admin/spreadsheet/test-webhook" method="POST" style="margin: 0; display: inline;">
            <button type="submit" class="btn btn-secondary" style="padding: 10px 16px; font-size: 12px; font-weight: 600; border-radius: 8px; color: var(--accent-cyan);" title="Kirim paket data uji coba ke URL Apps Script Web App">
              <i class="bi bi-send-fill"></i> Tes Webhook (Ping)
            </button>
          </form>
        </div>
      </div>

    </form>
  </div>

  <!-- APPS SCRIPT CODE & GUIDE CARD -->
  <div class="card">
    <div class="card-header" style="padding-bottom: 12px; border-bottom: 1px solid var(--border);">
      <div class="card-title" style="font-size: 15px; font-weight: 700; display: flex; align-items: center; justify-content: space-between; width: 100%;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <i class="bi bi-code-slash text-cyan"></i> Kode Google Apps Script (Siap Copy)
        </div>
        <button type="button" onclick="copyAppsScriptCode()" class="btn btn-secondary btn-xs" style="font-size: 11px; padding: 4px 10px; border-radius: 6px;">
          <i class="bi bi-clipboard"></i> Salin Kode Script
        </button>
      </div>
    </div>

    <div style="margin-top: 14px;">
      <p style="font-size: 12.5px; color: var(--text-secondary); margin-bottom: 12px;">
        Pasang kode Apps Script berikut di Google Spreadsheet Anda (<strong>Extensions</strong> ➔ <strong>Apps Script</strong>) agar perubahan status dari dasbor tersimpan ke spreadsheet:
      </p>

      <pre id="appsScriptCode" style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 16px; font-family: monospace; font-size: 12px; color: var(--text-primary); overflow-x: auto; max-height: 360px; line-height: 1.5;">
function doPost(e) {
  try {
    var contents = JSON.parse(e.postData.contents);
    var assignmentId = contents.assignment_id;
    var statusTL = contents.tindak_lanjut;
    var penjelasan = contents.penjelasan || '';
    var sheetIndex = contents.type === 'keluarga' ? 3 : 0; // Index Sheet Keluarga atau Usaha

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheets = ss.getSheets();
    var sheet = sheets[sheetIndex] || ss.getSheets()[0];
    
    var data = sheet.getDataRange().getValues();
    var updated = false;

    // Cari baris berdasarkan Assignment ID (Kolom P / Index 15)
    for (var i = 1; i < data.length; i++) {
      var rowAssignmentId = String(data[i][15]).trim();
      if (rowAssignmentId && rowAssignmentId === String(assignmentId).trim()) {
        // Kolom R (Index 18): Status Tindak Lanjut
        sheet.getRange(i + 1, 18).setValue(statusTL);
        
        // Kolom V (Index 22): Penjelasan / Catatan
        if (penjelasan) {
          sheet.getRange(i + 1, 22).setValue(penjelasan);
        }
        updated = true;
        break;
      }
    }

    return ContentService.createTextOutput(JSON.stringify({
      success: updated,
      message: updated ? 'Berhasil mengupdate Google Sheet' : 'Assignment ID tidak ditemukan'
    })).setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({
      success: false,
      error: err.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  }
}</pre>
    </div>
  </div>

</div>

<script>
function copyAppsScriptCode() {
  const code = document.getElementById('appsScriptCode').innerText;
  navigator.clipboard.writeText(code).then(() => {
    alert('Kode Apps Script berhasil disalin ke clipboard!');
  }).catch(err => {
    console.error('Gagal menyalin:', err);
  });
}
</script>
