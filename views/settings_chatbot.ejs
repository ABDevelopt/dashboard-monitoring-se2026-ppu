<div class="fade-in">
  <style>
    .settings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }
    .settings-group {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow);
    }
    .settings-group-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .settings-group-title i {
      color: var(--accent-blue);
    }
    
    .settings-field {
      margin-bottom: 16px;
    }
    .settings-field:last-child {
      margin-bottom: 0;
    }
    .settings-field label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 6px;
    }
    .settings-field select,
    .settings-field input[type="text"],
    .settings-field input[type="password"],
    .settings-field textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--bg-secondary);
      color: var(--text-primary);
      font-size: 13px;
      font-family: inherit;
      transition: var(--transition);
      resize: vertical;
    }
    .settings-field select:focus,
    .settings-field input[type="text"]:focus,
    .settings-field input[type="password"]:focus,
    .settings-field textarea:focus {
      border-color: var(--accent-blue);
      outline: none;
      box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.15);
    }
    .settings-hint {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 4px;
      line-height: 1.4;
    }

    /* Toggle switch design */
    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
      flex-shrink: 0;
    }
    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: var(--border-light);
      transition: .3s;
      border-radius: 24px;
    }
    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: var(--text-primary);
      transition: .3s;
      border-radius: 50%;
    }
    .toggle-switch input:checked + .toggle-slider {
      background-color: var(--accent-blue);
    }
    .toggle-switch input:checked + .toggle-slider:before {
      transform: translateX(20px);
    }
    
    /* Sticky Action Bar */
    .sticky-action-bar {
      position: sticky;
      bottom: 20px;
      background: rgba(30, 41, 59, 0.85); /* Semitransparent card color */
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px 24px;
      margin-top: 30px;
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      z-index: 100;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    
    @media (max-width: 768px) {
      .settings-grid {
        grid-template-columns: 1fr !important;
        gap: 14px !important;
      }
      .settings-group {
        grid-column: 1 / -1 !important;
        padding: 16px !important;
      }
      .floating-save-btn {
        position: static !important;
        width: 100% !important;
        justify-content: center !important;
        margin-top: 0 !important;
        border-radius: 50px !important;
        padding: 12px 24px !important;
        font-size: 13.5px !important;
        transform: none !important;
        box-shadow: 0 4px 14px rgba(13, 110, 253, 0.25) !important;
      }
      .save-btn-container {
        width: 100% !important;
        margin-top: 16px !important;
        padding-top: 16px !important;
      }
      #agent_provider {
        min-width: 100% !important;
        width: 100% !important;
      }
    }
  </style>

  <!-- HERO TITLE -->
  <div style="background: linear-gradient(135deg, rgba(var(--accent-rgb),0.12) 0%, rgba(var(--accent-rgb),0.03) 100%); border: 1px solid rgba(var(--accent-rgb),0.2); border-radius: 16px; padding: 32px 28px; margin-bottom: 24px; position: relative; overflow: hidden;">
    <div style="position: absolute; right: -20px; top: -20px; font-size: 120px; opacity: 0.04; line-height: 1; pointer-events: none;">
      <i class="bi bi-chat-left-dots-fill"></i>
    </div>
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
      <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(var(--accent-rgb),0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <i class="bi bi-chat-left-dots-fill" style="font-size: 26px; color: var(--accent-blue);"></i>
      </div>
      <div>
        <h1 style="font-size: 22px; font-weight: 800; color: var(--text-primary); margin: 0 0 4px 0;">Pengaturan Chatbot AI</h1>
        <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">Konfigurasikan API Key, pilihan model cadangan, dan fitur smart-switch chatbot</p>
      </div>
    </div>
  </div>



  <div class="card-body">
    <form action="/admin/settings/chatbot" method="POST">
      <div class="settings-grid">
        
        <!-- CARD 1: GLOBAL CONFIG & PROVIDER -->
        <div class="settings-group" style="grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between;">
          <div style="flex: 1; min-width: 280px;">
            <div class="settings-group-title" style="border: none; margin-bottom: 0; padding-bottom: 0;">
              <i class="bi bi-cpu"></i> Provider Aktif Utama
            </div>
            <p class="settings-hint" style="margin-top: 4px;">Pilih provider AI utama yang diaktifkan secara bawaan saat membuka halaman chat.</p>
          </div>
          <div class="settings-field" style="margin-bottom: 0;">
            <select id="agent_provider" name="agent_provider" style="min-width: 260px;">
              <option value="gemini" <%= settings.agent_provider === 'gemini' ? 'selected' : '' %>>Google Gemini</option>
              <option value="openai" <%= settings.agent_provider === 'openai' ? 'selected' : '' %>>OpenAI</option>
              <option value="openrouter" <%= settings.agent_provider === 'openrouter' ? 'selected' : '' %>>OpenRouter (Model Open-Source)</option>
            </select>
          </div>
        </div>

        <!-- CARD 1B: SMART SWITCH CONFIG -->
        <div class="settings-group" style="grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; margin-top: -10px;">
          <div style="flex: 1; min-width: 280px;">
            <div style="font-size: 14px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
              <i class="bi bi-shuffle" style="color: var(--accent-blue);"></i> Fitur Smart Switch AI
            </div>
            <p class="settings-hint" style="margin-top: 4px;">Saat model utama mengalami error kuota habis/rate-limit (HTTP 429/403/503), sistem akan otomatis beralih mencari model gratis alternatif dari daftar model tersimpan sebelum akhirnya menggunakan model berbayar (OpenAI) atau beralih ke Mode Simulasi.</p>
          </div>
          <div style="margin-bottom: 0;">
            <label class="toggle-switch">
              <input type="checkbox" id="chatbot_smart_switch" name="chatbot_smart_switch" value="1" <%= settings.chatbot_smart_switch === '1' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>

        <!-- CARD 2: GOOGLE GEMINI -->
        <div class="settings-group">
          <div class="settings-group-title" style="border-bottom-color: rgba(13, 110, 253, 0.2);">
            <i class="bi bi-google" style="color: #4285F4;"></i> Google Gemini
          </div>
          <div class="settings-field">
            <label for="gemini_api_key">Gemini API Key Utama</label>
            <input type="password" id="gemini_api_key" name="gemini_api_key" value="<%= settings.gemini_api_key || '' %>" autocomplete="off" placeholder="Masukkan Gemini API key">
          </div>
          <%
            let backupKeys = [];
            try {
              if (settings.gemini_backup_api_keys) {
                backupKeys = JSON.parse(settings.gemini_backup_api_keys);
              }
            } catch (e) {
              if (settings.gemini_backup_api_keys) {
                backupKeys = settings.gemini_backup_api_keys.split(',').map(k => k.trim());
              }
            }
          %>
          <div class="settings-field">
            <label>Gemini API Key Cadangan (Backup)</label>
            <div id="gemini-backup-keys-container" style="display: flex; flex-direction: column; gap: 8px;">
              <% if (backupKeys.length === 0) { %>
                <div class="backup-key-row" style="display: flex; gap: 8px; align-items: center;">
                  <input type="password" name="gemini_backup_keys" placeholder="Masukkan Backup API key" style="flex: 1; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-secondary); color: var(--text-primary); font-size: 13px;">
                  <button type="button" class="btn btn-danger btn-xs remove-key-btn" onclick="removeBackupKey(this)" style="padding: 10px 14px; border-radius: var(--radius-sm); height: 38px; display: inline-flex; align-items: center; justify-content: center;"><i class="bi bi-trash"></i></button>
                </div>
              <% } else { %>
                <% backupKeys.forEach((key, idx) => { %>
                  <div class="backup-key-row" style="display: flex; gap: 8px; align-items: center; margin-top: <%= idx > 0 ? '8px' : '0' %>;">
                    <input type="password" name="gemini_backup_keys" value="<%= key %>" placeholder="Masukkan Backup API key" style="flex: 1; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-secondary); color: var(--text-primary); font-size: 13px;">
                    <button type="button" class="btn btn-danger btn-xs remove-key-btn" onclick="removeBackupKey(this)" style="padding: 10px 14px; border-radius: var(--radius-sm); height: 38px; display: inline-flex; align-items: center; justify-content: center;"><i class="bi bi-trash"></i></button>
                  </div>
                <% }) %>
              <% } %>
            </div>
            <button type="button" class="btn btn-secondary btn-xs" onclick="addBackupKey()" style="font-size: 11px; padding: 6px 12px; margin-top: 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;">
              <i class="bi bi-plus-lg"></i> Tambah Backup Key
            </button>
            <p class="settings-hint" style="margin-top: 6px;">Kunci cadangan akan digunakan secara bergilir jika API Key utama mengalami error atau tidak memberikan respons.</p>
          </div>
          <div class="settings-field">
            <label for="gemini_model">Default Gemini Model</label>
            <input type="text" id="gemini_model" name="gemini_model" value="<%= settings.gemini_model || 'gemini-2.5-flash' %>" placeholder="gemini-2.5-flash">
          </div>
          <div class="settings-field">
            <label for="gemini_models_list">Daftar Pilihan Model Gemini</label>
            <textarea id="gemini_models_list" name="gemini_models_list" rows="3" placeholder="gemini-2.5-flash, gemini-2.5-flash-lite, gemini-3.5-flash"><%= settings.gemini_models_list || '' %></textarea>
            <p class="settings-hint">Pisahkan nama model dengan tanda koma (,).</p>
          </div>
        </div>

        <!-- CARD 3: OPENAI -->
        <div class="settings-group">
          <div class="settings-group-title" style="border-bottom-color: rgba(25, 135, 84, 0.2);">
            <i class="bi bi-lightning-charge-fill" style="color: #198754;"></i> OpenAI
          </div>
          <div class="settings-field">
            <label for="openai_api_key">OpenAI API Key</label>
            <input type="password" id="openai_api_key" name="openai_api_key" value="<%= settings.openai_api_key || '' %>" autocomplete="off" placeholder="Masukkan OpenAI API key">
          </div>
          <div class="settings-field">
            <label for="openai_model">Default OpenAI Model</label>
            <input type="text" id="openai_model" name="openai_model" value="<%= settings.openai_model || 'gpt-5.5' %>" placeholder="gpt-5.5">
          </div>
          <div class="settings-field">
            <label for="openai_models_list">Daftar Pilihan Model OpenAI</label>
            <textarea id="openai_models_list" name="openai_models_list" rows="3" placeholder="gpt-5.5, gpt-4o"><%= settings.openai_models_list || '' %></textarea>
            <p class="settings-hint">Pisahkan nama model dengan tanda koma (,).</p>
          </div>
        </div>

        <!-- CARD 4: OPENROUTER -->
        <div class="settings-group" style="grid-column: span 2;">
          <div class="settings-group-title" style="border-bottom-color: rgba(111, 66, 193, 0.2);">
            <i class="bi bi-layers-half" style="color: #6f42c1;"></i> OpenRouter (Open-Source &amp; Kimi)
          </div>
          <div class="settings-field" style="max-width: 600px;">
            <label for="openrouter_api_key">OpenRouter API Key</label>
            <input type="password" id="openrouter_api_key" name="openrouter_api_key" value="<%= settings.openrouter_api_key || '' %>" autocomplete="off" placeholder="Masukkan OpenRouter API key">
          </div>
          <div class="settings-field" style="max-width: 600px;">
            <label for="openrouter_model">Default OpenRouter Model</label>
            <input type="text" id="openrouter_model" name="openrouter_model" value="<%= settings.openrouter_model || 'meta-llama/llama-3.3-70b-instruct:free' %>" placeholder="meta-llama/llama-3.3-70b-instruct:free">
          </div>
          <div class="settings-field">
            <label for="openrouter_models_list">Daftar Pilihan Model OpenRouter (Termasuk Kimi)</label>
            <textarea id="openrouter_models_list" name="openrouter_models_list" rows="4" placeholder="meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free, qwen/qwen-2.5-coder-32b-instruct:free, moonshotai/moonshot-v1-8k"><%= settings.openrouter_models_list || '' %></textarea>
            <p class="settings-hint">Pisahkan nama model dengan tanda koma (,). Gunakan format OpenRouter resmi (seperti `moonshotai/moonshot-v1-8k` untuk model Kimi).</p>
          </div>
        </div>

      </div>

      <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--border); padding-top: 20px; margin-top: 20px;">
        <button type="submit" class="btn btn-primary floating-save-btn">
          <i class="bi bi-save-fill"></i> Simpan Pengaturan Chatbot
        </button>
      </div>
    </form>
  </div>

  <script>
    function addBackupKey() {
      const container = document.getElementById('gemini-backup-keys-container');
      const row = document.createElement('div');
      row.className = 'backup-key-row';
      row.style.display = 'flex';
      row.style.gap = '8px';
      row.style.alignItems = 'center';
      row.style.marginTop = '8px';
      row.innerHTML = `
        <input type="password" name="gemini_backup_keys" placeholder="Masukkan Backup API key" style="flex: 1; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-secondary); color: var(--text-primary); font-size: 13px;">
        <button type="button" class="btn btn-danger btn-xs remove-key-btn" onclick="removeBackupKey(this)" style="padding: 10px 14px; border-radius: var(--radius-sm); height: 38px; display: inline-flex; align-items: center; justify-content: center;"><i class="bi bi-trash"></i></button>
      `;
      container.appendChild(row);
    }
    
    function removeBackupKey(button) {
      const row = button.closest('.backup-key-row');
      const container = document.getElementById('gemini-backup-keys-container');
      if (container.querySelectorAll('.backup-key-row').length > 1) {
        row.remove();
      } else {
        // If it's the last one, just clear the input value instead of removing the row
        row.querySelector('input').value = '';
      }
    }
  </script>
</div>
