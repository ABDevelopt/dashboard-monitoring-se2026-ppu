        <mxCell id="m0_card_se2026" value="&lt;b&gt;1. DASBOR SENSUS EKONOMI 2026 (SE2026 PPU)&lt;/b&gt;  &lt;font color='#f97316'&gt;&lt;b&gt;[PRIORITAS 1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='2' color='#94a3b8'&gt;Pemantauan Pendataan Lengkap Bangunan &amp; Usaha Ekonomi di 54 Desa/Kelurahan PPU &amp; IKN Nusantara.&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Status Operasional:&lt;/b&gt; &lt;font color='#4ade80'&gt;[AKTIF BERJALAN]&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Muatan Scope:&lt;/b&gt; Pemutakhiran Bangunan, Usaha UTP, Usaha UMB/UMK.&lt;br&gt;• &lt;b&gt;Fitur Utama:&lt;/b&gt; Executive Overview, Speedometer, Peta GIS, Drilldown Korlap/PML/PCL, Live Audit.&lt;br&gt;• &lt;b&gt;Target Milestone:&lt;/b&gt; Target 100% Selesai Tepat Waktu." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f97316;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=20;spacingTop=12;verticalAlign=top;" parent="1" vertex="1">
