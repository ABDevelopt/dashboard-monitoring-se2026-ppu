        <mxCell id="m0_hero_box" value="&lt;b&gt;PORTAL INTEGRASI PEMANTAUAN SENSUS DAN SURVEI BPS KABUPATEN PENAJAM PASER UTARA&lt;/b&gt;&lt;br&gt;&lt;font size='2' color='#94a3b8'&gt;Pusat Kendali Satu Pintu Pemantauan Progres Pendataan Lapangan di Wilayah Kabupaten Penajam Paser Utara &amp; Ibu Kota Nusantara (IKN)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font size='2' color='#38bdf8'&gt;[MODUL AKTIF: SE2026 PPU &amp; SAKERNAS AGUSTUS 2026] &amp;nbsp;|&amp;nbsp; [INTEGRASI SISTEM: FASIH-SM &amp; LIVE GOOGLE SPREADSHEET AUDIT]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;align=center;" parent="1" vertex="1">
