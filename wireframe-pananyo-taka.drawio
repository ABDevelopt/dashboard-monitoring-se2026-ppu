          <mxGeometry height="200" width="1100" x="260" y="860" as="geometry" />
        </mxCell>
        <mxCell id="t1-defisit-metrics" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;fontColor=#ffffff;fontSize=11;spacing=10;align=left;" value="REALISASI LAJU PENDATAAN HARIAN: &lt;b&gt;1.403,6 dok/hari&lt;/b&gt;&lt;br&gt; Target Normal: 2.145 dok/hari &amp;nbsp;|&amp;nbsp; Target Aktual: 3.596,8 dok/hari &amp;nbsp;|&amp;nbsp; Target Tetap: 2.145 dok/hari" vertex="1">
